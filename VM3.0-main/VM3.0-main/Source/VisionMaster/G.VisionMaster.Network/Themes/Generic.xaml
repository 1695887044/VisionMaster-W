<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:h="https://github.com/G"
                    xmlns:local="clr-namespace:G.VisionMaster.Network">

    <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary Source="pack://application:,,,/G.VisionMaster.Network;component/OpenCV.xaml" />
        <ResourceDictionary Source="pack://application:,,,/G.VisionMaster.Network;component/NodeDatas/If/OpenCVPropertyConditionsPrensenter.xaml" />-->
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate DataType="{x:Type local:IoTClientReadableNodeData}">
        <Border MinWidth="120"
                Height="35"
                Margin="2"
                BorderThickness="1"
                CornerRadius="2"
                TextBlock.Foreground="Black">
            <Border.Style>
                <Style BasedOn="{StaticResource {x:Static h:DiagramKeys.StateBorder}}" TargetType="Border">
                    <Setter Property="Background" Value="White" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static h:BrushKeys.Foreground}}" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static h:BrushKeys.LightGray}}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static h:BrushKeys.Orange}}" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static h:BrushKeys.LightGray}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="#DFF0D8" />
                            <Setter Property="BorderBrush" Value="#3C763D" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Grid>
                    <FontIconTextBlock Margin="5,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding Icon}" />
                </Grid>
                <TextBlock Margin="0,0,5,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:IoTClientWritableNodeData}">
        <Border MinWidth="120"
                Height="35"
                Margin="2"
                BorderThickness="1"
                CornerRadius="2"
                TextBlock.Foreground="Black">
            <Border.Style>
                <Style BasedOn="{StaticResource {x:Static h:DiagramKeys.StateBorder}}" TargetType="Border">
                    <Setter Property="Background" Value="White" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static h:BrushKeys.Foreground}}" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static h:BrushKeys.LightGray}}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static h:BrushKeys.Orange}}" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static h:BrushKeys.LightGray}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter Property="Background" Value="#DFF0D8" />
                            <Setter Property="BorderBrush" Value="#3C763D" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Grid>
                    <FontIconTextBlock Margin="5,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding Icon}" />
                </Grid>
                <TextBlock Margin="0,0,5,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
