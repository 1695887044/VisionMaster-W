<Project Sdk="Microsoft.NET.Sdk">
  <!-- Extra observation G: a dependency that ONLY the module has (not in host TPA). -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AssemblyName>Probe.ExtraDep</AssemblyName>
    <RootNamespace>Probe.ExtraDep</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <OutputPath>$(MSBuildThisFileDirectory)..\out\_extra\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
