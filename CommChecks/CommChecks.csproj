<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- 断言工程只做逻辑校验，不参与产品发布；Debug/Release 都可直接 dotnet run -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用主程序即可拿到 Core / Core.Interfaces / Communication 的全部 public 面 -->
    <ProjectReference Include="..\VisionMaster\VisionMaster.csproj" />
  </ItemGroup>

</Project>
