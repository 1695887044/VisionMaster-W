      "Steps": [
        {
          "$type": "VisionMaster.Models.ActionStep, VM.Core",
          "StepID": "442c564b-1174-44fc-a16a-e3a8b58d1e9d",
          "Icon": "\uf1c5",
          "PluginName": "图像采集",
          "PluginTypeName": "Plugin.ImageAcquisition.ImageAcquisitionPlugin, Plugin.ImageAcquisition, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
          "StepName": "图像采集_0",
          "Description": "图像采集",
          "SortId": 0,
          "IsDisEnable": false,
          "State": 0,
          "InputValues": {
            "Mode": 0,
            "FilePath": "E:\\VM\\VisionMaster-W-master\\Image\\颜色\\cable1.png",
            "FolderPath": "",
            "DisplayViewIndex": 1
          },
          "LinkedSources": {},
