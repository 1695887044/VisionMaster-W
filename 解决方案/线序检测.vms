        },
        {
          "$type": "VisionMaster.Models.ActionStep, VM.Core",
          "StepID": "bd587803-8503-4e74-ac6f-3795922d930e",
          "Icon": "\uf0ac",
          "PluginName": "C#脚本",
          "PluginTypeName": "Plugin.CSharpScript.CSharpScriptPlugin, Plugin.CSharpScript, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
          "StepName": "比对",
          "Description": "C#脚本",
          "SortId": 0,
          "IsDisEnable": false,
          "State": 0,
          "InputValues": {
            "ScriptText": "// =====================================================================\n// 线序检测 · 第二步：比对\n//\n//   期望序列（配方）由上游的条件分支按芯数选好，放在运行时变量 Expected 里。\n//   本步只做一件事：逐位比，并把「第几位不对」说清楚 ——\n//   产线上最需要的不是\"不合格\"，而是\"第 7 位错了\"。\n// =====================================================================\n\nvar image = Context.GetInput<HImage>(\"Image\");\n\nstring seq = Context.GetVar<string>(\"Sequence\") ?? \"\";\nstring exp = Context.GetVar<string>(\"Expected\") ?? \"\";\nstring rws = Context.GetVar<string>(\"Rows\") ?? \"\";\nint sampleX = Context.GetVar<int>(\"SampleX\");\n\nvar actual = seq.Length == 0 ? new string[0] : seq.Split(',');\nvar want = exp.Length == 0 ? new string[0] : exp.Split(',');\n\nbool ok;\nstring detail;\n\nif (want.Length == 0)\n{\n    // 配方的 Else 分支就是\"未知产品\"，这里必须明确说出来，不能含糊成\"线数不符\"\n    ok = false;\n    detail = $\"未知产品：{actual.Length} 芯没有对应配方（上游条件分支走到了 Else）\";\n}\nelse if (actual.Length != want.Length)\n{\n    ok = false;\n    detail = $\"线数不符：实测 {actual.Length} 芯 [{seq}]，配方 {want.Length} 芯 [{exp}]\";\n}\nelse\n{\n    int bad = -1;\n    for (int i = 0; i < want.Length; i++) if (actual[i] != want[i]) { bad = i; break; }\n    ok = bad < 0;\n    detail = ok\n        ? $\"线序正确，{actual.Length} 芯：{seq}\"\n        : $\"第 {bad + 1} 位不符：实测「{actual[bad]}」，应为「{want[bad]}」 ｜ 实测 [{seq}] 配方 [{exp}]\";\n}\n\nContext.SetOutput(\"Result\", ok);\nContext.SetOutput(\"Detail\", detail);\nContext.SetVar(\"Result\", ok);                 // 供下游条件分支判真假\nif (ok) Context.Success(detail); else Context.Warn(detail);\n\n// 把结论标到画面上：现场不翻日志，一眼看到合格与否 + 是第几位错\nif (image != null && image.IsInitialized())\n{\n    image.GetImageSize(out int w, out int h);\n    var marks = Context.NewMarks();\n    marks.Add(Context.MarkLine(0, sampleX, h - 1, sampleX, \"green\"));\n\n    var rows = rws.Split(',');\n    for (int i = 0; i < rows.Length; i++)\n    {\n        int y;\n        if (!int.TryParse(rows[i], out y)) continue;\n        string nm = i < actual.Length ? actual[i] : \"?\";\n        marks.Add(Context.MarkText(y, sampleX + 10, $\"{i + 1}.{nm}\", \"green\"));\n    }\n\n    marks.Add(Context.MarkText(4, 6, detail, ok ? \"green\" : \"red\"));\n    Context.ShowImage(image, 1, marks);\n}\n",
            "InputVars": {
