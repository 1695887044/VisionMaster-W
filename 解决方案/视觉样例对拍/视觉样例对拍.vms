            "TemplateIndex": -1,
            "TemplateRevision": 0,
            "TypeKey": "Hmi.Text",
            "X": 65.0,
            "Y": 758.0,
            "Width": 1750.0,
            "Height": 144.0,
            "Rotation": 0.0,
            "ZIndex": 10,
            "IsLocked": false,
            "Properties": {
              "Text": "· 系统-未就绪（严重）：SystemReady 为假 —— 未执行 Home 或被 End 复位。处置：手动控制页点「置就绪」或运行 Home。\n· 质量-良率过低（严重）：YieldRate < 90% —— 批量不良或阈值过严。处置：查看结果统计与各工位判定说明。\n· 质量-累计不良超限（警告）：NgCount > 20 —— 连续 NG 或工艺漂移。处置：查看运行日志账本与各工位分数。\n报警历史按天落 CSV（方案 Alarms\\ 目录）；确认只清当前态，不清历史。",
              "Foreground": "#FF6B7280",
              "FontSize": "14",
              "FontWeight": "Normal",
              "TextAlignment": "Left",
              "VerticalContentAlignment": "Top"
            },
            "Bindings": [],
            "EventHooks": [],
            "Animations": []
          },
