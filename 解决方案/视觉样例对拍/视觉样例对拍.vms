        {
          "$type": "VisionMaster.Models.ActionStep, VM.Core",
          "StepID": "169c7fa0-bc64-911d-1e76-c206b4d5a549",
          "Icon": "",
          "PluginName": "调用流程",
          "Category": "流程控制",
          "PluginTypeName": "VisionMaster.Plugins.RunFlow.RunFlowPlugin, Plugin.RunFlow, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
          "StepName": "调用工位_DefPlanar",
          "Description": "调用流程",
          "SortId": 0,
          "IsDisEnable": false,
          "State": 0,
          "InputValues": {
            "FlowName": "形变匹配_平面透视",
            "TimeoutMs": 180000
          },
          "LinkedSources": {},
          "OutputPortDefinitions": []
        },
        {
          "$type": "VisionMaster.Models.ActionStep, VM.Core",
          "StepID": "488e06e0-377b-58db-e3f1-68cfb61f4b93",
          "Icon": "",
          "PluginName": "C#脚本",
          "Category": "逻辑控制",
          "PluginTypeName": "Plugin.CSharpScript.CSharpScriptPlugin, Plugin.CSharpScript, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
          "StepName": "统计与良率",
          "Description": "C#脚本",
          "SortId": 0,
          "IsDisEnable": false,
          "State": 0,
          "InputValues": {
            "ScriptText": "// ============================================================\r\n// 主流程统计脚本（每轮七工位全部跑完后执行一次）\r\n// 数据来源：各工位流程末尾的「变量赋值」把判定写进全局变量；\r\n// 本脚本汇总累计检测数 / 良品数 / 不良数，并计算实时良率（%）。\r\n// ============================================================\r\nint total = Context.GetGlobal<int>(\"TotalCount\");\r\nint ok    = Context.GetGlobal<int>(\"OkCount\");\r\nint ng    = Context.GetGlobal<int>(\"NgCount\");\r\n\r\n// 七工位判定结果（true = 该工位通过）\r\nbool r_Ncc = Context.GetGlobal<bool>(\"Ncc_Result\");\r\nbool r_Pcb = Context.GetGlobal<bool>(\"Pcb_Result\");\r\nbool r_Label = Context.GetGlobal<bool>(\"Label_Result\");\r\nbool r_Code128 = Context.GetGlobal<bool>(\"Code128_Result\");\r\nbool r_Qr = Context.GetGlobal<bool>(\"Qr_Result\");\r\nbool r_DefLocal = Context.GetGlobal<bool>(\"DefLocal_Result\");\r\nbool r_DefPlanar = Context.GetGlobal<bool>(\"DefPlanar_Result\");\r\n\r\n// 全部通过才算本件 OK\r\nbool allOk = r_Ncc && r_Pcb && r_Label && r_Code128 && r_Qr && r_DefLocal && r_DefPlanar;\r\n\r\ntotal++;\r\nif (allOk) ok++; else ng++;\r\ndouble yield = total > 0 ? ok * 100.0 / total : 100.0;\r\n\r\nContext.SetGlobal(\"TotalCount\", total);\r\nContext.SetGlobal(\"OkCount\", ok);\r\nContext.SetGlobal(\"NgCount\", ng);\r\nContext.SetGlobal(\"YieldRate\", yield);\r\nContext.SetGlobal(\"CurrentResult\", allOk);\r\n\r\n// ---- 生产账本（CSV）：直接落方案 History\\，供「运行日志」页历史表格与报表读取 ----\r\n// 为什么不靠「CSV记录」插件：该步骤在真机运行链中未被调度（已实测零日志零落盘），\r\n// 而账本是「输出」环节的硬要求，故在此直接写盘，保证输出闭环。\r\ntry\r\n{\r\n    string root = Context.GetGlobal<string>(\"SolutionRoot\");\r\n    Context.Info(\"账本根目录=\" + root);\r\n    string dir  = System.IO.Path.Combine(root, \"History\", \"Main.CSV记录\", DateTime.Now.ToString(\"yyyy-MM\"));\r\n    System.IO.Directory.CreateDirectory(dir);\r\n    string file = System.IO.Path.Combine(dir, DateTime.Now.ToString(\"yyyy-MM-dd\") + \".csv\");\r\n    Context.Info(\"账本文件=\" + file);\r\n    bool needHeader = !System.IO.File.Exists(file) || new System.IO.FileInfo(file).Length == 0;\r\n    var sb = new System.Text.StringBuilder();\r\n    if (needHeader)\r\n        sb.AppendLine(\"时间,序号,综合结果,NCC,PCB,标签,条码,二维码,局部形变,平面形变,良率\");\r\n    sb.AppendLine(string.Join(\",\", new object[] {\r\n        DateTime.Now.ToString(\"yyyy-MM-dd HH:mm:ss.fff\"), total, allOk,\r\n        r_Ncc, r_Pcb, r_Label, r_Code128, r_Qr, r_DefLocal, r_DefPlanar,\r\n        yield.ToString(\"F1\", System.Globalization.CultureInfo.InvariantCulture) }));\r\n    System.IO.File.AppendAllText(file, sb.ToString(), System.Text.Encoding.UTF8);\r\n}\r\ncatch (System.Exception ex)\r\n{\r\n    Context.Info(\"账本写入失败：\" + ex.Message);\r\n}\r\nContext.Info($\"统计完成：总数={total}，OK={ok}，NG={ng}，良率={yield:F1}%\");\r\n",
            "InputVars": [],
            "OutputVars": [],
            "SharedVars": [
              {
                "VariableId": "57651a74-6222-8268-ba10-75a057acc97b",
                "Name": "Ncc_Result",
                "Alias": "Ncc_Result",
                "Access": 0,
                "Remark": "工位判定结果",
                "TypeName": "System.Boolean",
                "IsSystem": false
              },
              {
                "VariableId": "a16c5971-65ba-e209-2675-338f331b98b5",
                "Name": "Pcb_Result",
                "Alias": "Pcb_Result",
                "Access": 0,
                "Remark": "工位判定结果",
                "TypeName": "System.Boolean",
                "IsSystem": false
              },
              {
                "VariableId": "ec517bb2-fb45-baf2-28ed-6a76082a3776",
                "Name": "Label_Result",
                "Alias": "Label_Result",
                "Access": 0,
                "Remark": "工位判定结果",
                "TypeName": "System.Boolean",
                "IsSystem": false
              },
              {
                "VariableId": "47af53ad-0bd9-9f0d-41d1-e4874b9a645e",
                "Name": "Code128_Result",
                "Alias": "Code128_Result",
                "Access": 0,
                "Remark": "工位判定结果",
                "TypeName": "System.Boolean",
                "IsSystem": false
              },
              {
                "VariableId": "ab184f9e-2157-da99-2e1a-85a1ad64a457",
                "Name": "Qr_Result",
                "Alias": "Qr_Result",
                "Access": 0,
                "Remark": "工位判定结果",
