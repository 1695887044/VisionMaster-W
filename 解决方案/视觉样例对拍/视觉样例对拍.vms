            "TemplateRevision": 0,
            "TypeKey": "Hmi.Text",
            "X": 65.0,
            "Y": 700.0,
            "Width": 1750.0,
            "Height": 140.0,
            "Rotation": 0.0,
            "ZIndex": 10,
            "IsLocked": false,
            "Properties": {
              "Text": "· 单跑只执行该工位流程，判定结果写入全局变量 XXX_Result / XXX_Score / XXX_Reason。\n· 每轮循环末尾有 200ms 延时（让每张图的标注结果都看得见），单跑时同样生效。\n· PCB 工位样例图 121 张，单跑约需 25~30 秒（含延时），属正常。\n· 要改阈值：在流程栏右键对应算法步骤改 MinScore / MaxDefectCount / MaxSingleArea。",
              "Foreground": "#FF6B7280",
              "FontSize": "14",
              "FontWeight": "Normal",
              "TextAlignment": "Left",
              "VerticalContentAlignment": "Top"
            },
            "Bindings": [],
            "EventHooks": [],
            "Animations": []
