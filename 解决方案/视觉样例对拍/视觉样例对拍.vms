          {
            "ElementId": "d749bcda-654d-b50b-72d7-b8d6537bc366",
            "Name": "监控说明文",
            "LayerId": "b9e79f39-9e17-2ab8-c677-f273ed252cb5",
            "GroupId": "00000000-0000-0000-0000-000000000000",
            "ParentId": "00000000-0000-0000-0000-000000000000",
            "TemplateId": "00000000-0000-0000-0000-000000000000",
            "TemplateIndex": -1,
            "TemplateRevision": 0,
            "TypeKey": "Hmi.Text",
            "X": 65.0,
            "Y": 794.0,
            "Width": 1750.0,
            "Height": 106.0,
            "Rotation": 0.0,
            "ZIndex": 10,
            "IsLocked": false,
            "Properties": {
              "Text": "· 良率 = 良品数 / 累计检测数 × 100%，由主流程「统计与良率」C# 脚本每轮计算一次。\n· 累计检测数含本轮；「本件」判定 = 七个工位全部 OK。\n· 良率低于 90% 触发「质量-良率过低」报警；累计不良超过 20 触发「累计不良超限」报警。",
              "Foreground": "#FF6B7280",
              "FontSize": "14",
              "FontWeight": "Normal",
              "TextAlignment": "Left",
              "VerticalContentAlignment": "Top"
            },
            "Bindings": [],
            "EventHooks": [],
            "Animations": []
          },
