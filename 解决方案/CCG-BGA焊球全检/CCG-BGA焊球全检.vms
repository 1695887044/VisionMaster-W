          {
            "ElementId": "238f1355-72e2-a161-11d6-08ae2c709ea3",
            "Name": "阈值说明",
            "LayerId": "1b0c31b9-546e-3609-109d-0a48811a52b5",
            "GroupId": "00000000-0000-0000-0000-000000000000",
            "ParentId": "00000000-0000-0000-0000-000000000000",
            "TemplateId": "00000000-0000-0000-0000-000000000000",
            "TemplateIndex": -1,
            "TemplateRevision": 0,
            "TypeKey": "Hmi.Text",
            "X": 1010.0,
            "Y": 248.0,
            "Width": 820.0,
            "Height": 200.0,
            "Rotation": 0.0,
            "ZIndex": 6,
            "IsLocked": false,
            "Properties": {
              "Text": "• 差分阈值 Threshold = 30（灰度差）\n• 最小差异面积 MinArea = 8 px\n• 定位分数下限 MinScore = 0.60\n• 分级：0 片 → OK；1~3 片 → 复检；> 3 片 → NG\n\n上述参数落在「Bga_Inspect」流程的步骤配置里，\n本页只做运行期查看，避免与流程配置出现两份事实源。",
              "Foreground": "#FFCBD5E1",
              "FontSize": "14",
              "TextAlignment": "Left",
              "VerticalContentAlignment": "Top"
            },
            "Bindings": [],
            "EventHooks": [],
            "Animations": []
          },
          {
            "ElementId": "dc3a078c-2a21-b81e-53c5-974a2bc723e6",
