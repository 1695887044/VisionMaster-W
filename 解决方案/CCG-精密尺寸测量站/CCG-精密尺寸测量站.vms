                {
                  "$type": "VisionMaster.Models.ActionStep, VM.Core",
                  "StepID": "83cc7d05-9146-7cf1-f523-e785ad759d3d",
                  "Icon": "",
                  "PluginName": "变量赋值",
                  "Category": "变量操作",
                  "PluginTypeName": "VisionMaster.Plugins.Util.VariableAssignmentPlugin, Plugin.Util, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
                  "StepName": "SN序号+1写回",
                  "Description": "变量赋值",
                  "SortId": 0,
                  "IsDisEnable": false,
                  "State": 0,
                  "InputValues": {
                    "Name": "MsrSnSeq",
                    "CreateIfNotExists": false,
                    "Scope": "Global"
                  },
                  "LinkedSources": {
                    "Value": {
                      "Kind": 1,
                      "TargetStepId": "d2588cea-d540-c70b-0331-5d64c87c20ae",
                      "TargetPortName": "Result",
