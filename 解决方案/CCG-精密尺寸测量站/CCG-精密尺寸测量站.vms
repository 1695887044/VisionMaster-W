          },
          {
            "ElementId": "e6614b12-7b67-34b9-0f2f-eaf985a342a3",
            "Name": "口径正文",
            "LayerId": "b9751712-a9b7-b79d-0b9a-4a95bd2317b9",
            "GroupId": "00000000-0000-0000-0000-000000000000",
            "ParentId": "00000000-0000-0000-0000-000000000000",
            "TemplateId": "00000000-0000-0000-0000-000000000000",
            "TemplateIndex": -1,
            "TemplateRevision": 0,
            "TypeKey": "Hmi.Text",
            "X": 664.0,
            "Y": 800.0,
            "Width": 1190.0,
            "Height": 110.0,
            "Rotation": 0.0,
            "ZIndex": 11,
            "IsLocked": false,
            "Properties": {
              "Text": "1) 四路尺寸并列而不是堆成子行：一件一行的表最好扫，超差件整行一眼看出哪一路红。\n2) 标定当量入表：换班次/换镜头后当量会变，离开当量的尺寸值没法追溯，所以每行都记。\n3) 时间是标定时间而非测量时间（标定时间戳由 M_Calib 写），用来圈定「这批数据用的是哪套当量」。",
              "Foreground": "#FFE2E8F0",
              "FontSize": "13",
              "TextAlignment": "Left",
              "VerticalContentAlignment": "Top",
              "TextWrapping": "Wrap"
            },
            "Bindings": [],
            "EventHooks": [],
            "Animations": []
          },
