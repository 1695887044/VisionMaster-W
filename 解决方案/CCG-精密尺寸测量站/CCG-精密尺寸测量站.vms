                    }
                  },
                  "OutputPortDefinitions": []
                },
                {
                  "$type": "VisionMaster.Models.ActionStep, VM.Core",
                  "StepID": "ffe07fb2-3a58-6c89-5b89-c2376d740bb9",
                  "Icon": "",
                  "PluginName": "C# 脚本",
                  "Category": "变量操作",
                  "PluginTypeName": "Plugin.CSharpScript.CSharpScriptPlugin, Plugin.CSharpScript, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null",
                  "StepName": "生成工件SN",
                  "Description": "C# 脚本",
                  "SortId": 0,
                  "IsDisEnable": false,
                  "State": 0,
                  "InputValues": {
                    "Script": "// 逐件工件 SN：MSR-<六位序号>-<时间戳尾四位>-<两位校验>\n// 序号取自 MsrSnSeq，时间戳尾号取自系统时间，校验位是前两段的 SHA1 前两字节，\n// 这样同一件无论重跑多少次都会得到同一个 SN（复检可对齐），不同件不会撞号。\nvar seq = (int)(Variables.Get(\"MsrSnSeq\") ?? 0);\nvar seed = (int)(Variables.Get(\"MsrSeed\") ?? 0);\nvar stamp = (int)(DateTime.Now.Ticks / 10000L % 10000);\nvar body = \"MSR-\" + seq.ToString(\"D6\") + \"-\" + stamp.ToString(\"D4\");\nusing (var sha = System.Security.Cryptography.SHA1.Create())\n{\n    var bytes = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(body + \"|\" + seed));\n    var check = ((bytes[0] << 8) | bytes[1]) & 0xFFFF;\n    Variables.Set(\"MsrProductSn\", body + \"-\" + check.ToString(\"X4\"));\n}\nreturn true;"
                  },
                  "LinkedSources": {},
                  "OutputPortDefinitions": []
                },
                {
