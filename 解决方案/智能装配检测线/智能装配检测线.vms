          {
            "ElementId": "3b741a4e-f779-4a22-b53b-659aede39751",
            "Name": "正文",
            "LayerId": "45d37f93-9c57-bb8b-e04a-54d57c08f548",
            "GroupId": "00000000-0000-0000-0000-000000000000",
            "ParentId": "00000000-0000-0000-0000-000000000000",
            "TemplateId": "00000000-0000-0000-0000-000000000000",
            "TemplateIndex": -1,
            "TemplateRevision": 0,
            "TypeKey": "Hmi.Text",
            "X": 40.0,
            "Y": 88.0,
            "Width": 640.0,
            "Height": 300.0,
            "Rotation": 0.0,
            "ZIndex": 10,
            "IsLocked": false,
            "Properties": {
              "Text": "1. 总览页「产线启停」控制运行状态，模式旋钮切换手动/自动/检修。\n2. 「运行主流程」会依次调用 6 个工位流程并写入 CSV/MES/Excel。\n3. 工位页可单独重跑当前工位，便于调试。\n4. 报警中心「确认全部」清除已确认报警；「报警复位流程」清故障与轴停止。\n5. 设备诊断页可做 Modbus/S7 写读回环与四轴手动操作。\n6. 生产报表按时间范围查询 History\\ 下的 CSV 账本，可导出 Excel/打印。",
              "Foreground": "#FFCBD5E1",
              "FontSize": "14",
              "FontWeight": "Normal",
              "TextAlignment": "Left",
              "VerticalContentAlignment": "Center"
            },
            "Bindings": [],
            "EventHooks": [],
            "Animations": []
          },
