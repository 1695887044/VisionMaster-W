          "Description": "C# 脚本",
          "SortId": 0,
          "IsDisEnable": false,
          "State": 0,
          "InputValues": {
            "ScriptText": "var ok = Context.GetGlobal<int>(\"OKCount\");\nvar ng = Context.GetGlobal<int>(\"NGCount\");\nvar total = ok + ng;\nContext.SetGlobal(\"TotalCount\", total);\nContext.SetGlobal(\"YieldRate\", total > 0 ? ok * 100.0 / total : 100.0);\nContext.SetGlobal(\"OEE\", total > 0 ? Math.Min(99.0, ok * 100.0 / total) : 0.0);\nContext.Info($\"统计刷新 OK={ok} NG={ng} 良率={(total > 0 ? ok * 100.0 / total : 100.0):F2}%\");",
            "InputVars": [],
            "OutputVars": [],
