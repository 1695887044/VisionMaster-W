          {
            "ElementId": "432e15ce-9c0e-7f41-91d6-9c271982b674",
            "Name": "说明正文",
            "LayerId": "6f239b08-1779-3392-c222-28d47171f029",
            "GroupId": "00000000-0000-0000-0000-000000000000",
            "ParentId": "00000000-0000-0000-0000-000000000000",
            "TemplateId": "00000000-0000-0000-0000-000000000000",
            "TemplateIndex": -1,
            "TemplateRevision": 0,
            "TypeKey": "Hmi.Text",
            "X": 804.0,
            "Y": 236.0,
            "Width": 1050.0,
            "Height": 220.0,
            "Rotation": 0.0,
            "ZIndex": 11,
            "IsLocked": false,
            "Properties": {
              "Text": "1) 三工位串行，任一工位 NG 即整件 NG，故障码落 PkgFaultCode 并停 X 轴。\n2) 逐件 SN 由 Main 流程用 C# 脚本生成（SYN-6位序号-2位校验），写入 PkgSn 后参与表格采样。\n3) 阈值类参数走配方变量，不写死在流程里；改完点「应用配方」写 PkgRecipeApplied。",
              "Foreground": "#FFE2E8F0",
              "FontSize": "14",
              "TextAlignment": "Left",
              "VerticalContentAlignment": "Top",
              "TextWrapping": "Wrap"
            },
            "Bindings": [],
            "EventHooks": [],
            "Animations": []
          },
