            "Rotation": 0.0,
            "ZIndex": 5,
            "IsLocked": false,
            "Properties": {
              "Text": "VPLC532R 的 0~5 轴为 Step Encoder；若「回零」失败，见方案说明文档的运动卡章节。\n方案加载后会自动连接 ZMotion_Virtual；若仍显示未连接，再到「系统 → 硬件设置 → 运动卡」手动连接。",
              "Foreground": "#FFF59E0B",
              "FontSize": "13",
              "FontWeight": "Normal",
              "TextAlignment": "Left",
              "VerticalContentAlignment": "Center"
            },
            "Bindings": [],
            "EventHooks": [],
            "Animations": []
          }
        ],
