<UserControl
    x:Class="Core.Controls.LinkableValueEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="30"
    d:DesignWidth="320"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  图标按钮：透明背景，悬停微亮  -->
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                            <ContentPresenter x:Name="PART_Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22888888" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33888888" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            左侧标签（Label 为空时隐藏）。
            固定宽 + 右对齐：多行参数时标签要"贴着输入框"排成一列，
            左对齐 + 宽度随文字伸缩会让每一行的输入框起点各不相同，扫视时很难对齐读数
            （规格里那 112px 也是为这件事）。
        -->
        <TextBlock
            x:Name="PART_Label"
            Grid.Column="0"
            Width="112"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Foreground="#64748B"
            FontSize="12"
            TextAlignment="Right"
            TextTrimming="CharacterEllipsis"
            Visibility="Collapsed" />

        <!--  中间输入区：固定值 / 链接地址 / 不可输入占位 三态覆盖  -->
        <Grid Grid.Column="1">
            <!--  可文本输入：固定值编辑框  -->
            <TextBox
                x:Name="PART_ValueBox"
                Height="36"
                Padding="10,0"
                VerticalContentAlignment="Center"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Foreground="#1E293B"
                Text="{Binding PortValue, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}">
                <!--  圆角必须走模板：TextBox 自身没有 CornerRadius 属性  -->
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  聚焦：描边变主色（#0EA5E9）——鼠标正在编辑哪一行要能一眼看出  -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TextBox.Template>
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <!--  已链接：隐藏固定值框  -->
                            <DataTrigger Binding="{Binding IsLinked, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!--  不可文本输入（如 HImage）：隐藏固定值框  -->
                            <DataTrigger Binding="{Binding IsTextEditable, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!--  「只能选」的端口（枚举/方案候选）：改用下拉，互斥否则会叠在一起  -->
                            <DataTrigger Binding="{Binding IsOptionPort, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!--
                枚举端口：下拉选择，候选即枚举成员。

                模板必须自己写：ComboBox 的默认模板是系统样式（灰色渐变按钮 + 方角），
                放在这一列圆角输入框中间会显得像"另一个软件里的控件"。
                这里照输入框的形状来：白底、圆角 8、浅灰描边、聚焦/悬停变主色。

                注意本文件在 Core.Controls 里，**引用不到 UI 库的主题令牌**，
                所以色值只能内联 —— 与输入框保持同一组字面量即可。
            -->
            <ComboBox
                x:Name="PART_EnumBox"
                Height="36"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                Background="White"
                BorderThickness="0"
                OverridesDefaultStyle="True"
                DisplayMemberPath="Display"
                SelectedValuePath="Value"
                ItemsSource="{Binding EnumOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                SelectedValue="{Binding PortValue, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--  整个控件就是一个按钮：点哪儿都能展开，不用去瞄右边那个小箭头  -->
                            <!--
                                Style={x:Null}：主程序主题里有隐式的 ToggleButton 样式，
                                它会顺着模板树给这里的 ToggleButton 追加属性 —— 这里要的是"完全听我模板的"。
                                OverridesDefaultStyle 同理，把主题样式也挡在外面。
                            -->
                            <ToggleButton
                                Focusable="False"
                                ClickMode="Press"
                                OverridesDefaultStyle="True"
                                Style="{x:Null}"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="Bd"
                                            Background="White"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Path
                                                Margin="0,0,12,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L4.5,4.5 L9,0"
                                                Stroke="#94A3B8"
                                                StrokeThickness="1.6" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0EA5E9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--
                                选中项的显示。这里必须用 Binding 而不是 TemplateBinding：
                                DisplayMemberPath 生成的 SelectionBoxItemTemplate 是在"第一次选中"时才有值的，
                                TemplateBinding 在模板应用那一刻就取值（当时是 null）且不跟随变化 ——
                                结果就是收起状态下直接调 StepConfigOption.ToString()，显示成类型全名。
                            -->
                            <ContentPresenter
                                Margin="10,0,28,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                Placement="Bottom"
                                PopupAnimation="Fade">
                                <Border
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="240"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer Margin="0,4" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Foreground" Value="#1E293B" />
                        <Setter Property="FontSize" Value="12" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!--  仅在"只能选且未链接"时显示：已链接时应显示链接地址，让位给下面的只读框  -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOptionPort, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                    <Condition Binding="{Binding IsLinked, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <!--  不可文本输入且未链接：占位提示  -->
            <TextBlock
                x:Name="PART_Placeholder"
                Padding="2,2"
                VerticalAlignment="Center"
                Foreground="#999999"
                Text="需链接变量"
                Visibility="Collapsed" />

            <!--  已链接：只读链接地址  -->
            <TextBox
                x:Name="PART_LinkBox"
                Padding="2,2"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderBrush="#4FC3F7"
                BorderThickness="0,0,0,1"
                Foreground="#4FC3F7"
                IsReadOnly="True"
                Text="{Binding LinkAddress, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                ToolTip="已链接变量，运行时将从上游取值">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLinked, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Grid>

        <!--  🔗 链接/改链按钮  -->
        <Button
            x:Name="PART_LinkBtn"
            Grid.Column="2"
            Click="LinkBtn_Click"
            Style="{StaticResource IconBtnStyle}"
            ToolTip="链接变量">
            <!--  Material Design link 图标  -->
            <Path
                Width="15"
                Height="15"
                Data="M3.9,12 C3.9,10.29 5.29,8.9 7,8.9 L11,8.9 11,7 7,7 C4.24,7 2,9.24 2,12 C2,14.76 4.24,17 7,17 L11,17 11,15.1 7,15.1 C5.29,15.1 3.9,13.71 3.9,12 Z M8,13 L16,13 16,11 8,11 8,13 Z M17,7 L13,7 13,8.9 17,8.9 C18.71,8.9 20.1,10.29 20.1,12 C20.1,13.71 18.71,15.1 17,15.1 L13,15.1 13,17 17,17 C19.76,17 22,14.76 22,12 C22,9.24 19.76,7 17,7 Z"
                Fill="#CCCCCC"
                Stretch="Uniform" />
        </Button>

        <!--  ✕ 清除/解除按钮（不可文本输入且未链接时隐藏）  -->
        <Button
            x:Name="PART_UnlinkBtn"
            Grid.Column="3"
            Click="UnlinkBtn_Click"
            Style="{StaticResource IconBtnStyle}"
            ToolTip="已链接时解除链接；未链接时清空输入">
            <!--  Material Design close 图标  -->
            <Path
                Width="13"
                Height="13"
                Data="M19,6.41 L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12 Z"
                Fill="#CCCCCC"
                Stretch="Uniform" />
        </Button>
    </Grid>
</UserControl>
