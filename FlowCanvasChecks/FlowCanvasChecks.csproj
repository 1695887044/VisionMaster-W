<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- 断言工程只做逻辑校验，不参与产品发布；Debug/Release 都可直接 dotnet run -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用主程序即可拿到 Core / Engine / Core.Interfaces 的全部 public 面 -->
    <ProjectReference Include="..\VisionMaster\VisionMaster.csproj" />
    <!--
      直接引用 OCR 插件工程（而不是像生产那样从 Modules\ 反射加载）：
      本文件要断言的是「分割 + 识别」这一步算法对不对，直接调类才能拿到编译期检查与可读的失败信息。
      副作用是顺带把插件工程拉进构建图，Plugin.Ocr.dll 与它的 Assets 会被投递到位（见该工程 csproj）。
    -->
    <ProjectReference Include="..\Plugins\Plugin.Ocr\Plugin.Ocr.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.CodeReader\Plugin.CodeReader.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.Yolo\Plugin.Yolo.csproj" />
    <!--
      深度学习分类：直接引用插件工程（不走 Modules\ 反射加载），
      断言"缩放几何 / 布局嗅探 / softmax 归一化 / TopK"这层纯函数 ——
      归一化写错的后果是"结果全错但不报错"，只能靠受控数据钉住。
      引用它也让构建顺带把 Plugin.DlClassify.dll 与 ONNX Runtime 原生库投递到位。
    -->
    <ProjectReference Include="..\Plugins\Plugin.DlClassify\Plugin.DlClassify.csproj" />
    <!--
      Blob 缺陷检测：直接引用插件工程（而不是从 Modules\ 反射加载），
      这样"触边排除 / 长宽比 / 合并 / 填孔 / 排序 / 像素当量 / 位深底图"这些契约
      能在编译期就拿到类型检查，失败信息也更好读。
    -->
    <ProjectReference Include="..\Plugins\Plugin.BlobDetect\Plugin.BlobDetect.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.Matching\Plugin.Matching.csproj" />
    <!--
      胶路检测：直接引用（不走 Modules\ 反射加载）。
      断言方案说明书 §7.2 本批子集（1~9、13、14、15）：路径生成 / bead 模型 / 7 图真值表（P4）
      / NG 语义 / 单位换算 / 端口面 / 模型缓存（计数器）/ 树直径合并（P6）/ TargetWidth 下限（P10）
      / 提取路径贴合度（P11）。真样图在 Image\bead\。
    -->
    <ProjectReference Include="..\Plugins\Plugin.BeadInspect\Plugin.BeadInspect.csproj" />
    <!--
      创建ROI：直接引用插件工程（同上，不走 Modules\ 反射加载），
      断言三形状区域构建 / 掩膜 / 涂擦合并 / 动态端口与重名防御 / 运行端到端契约。
    -->
    <ProjectReference Include="..\Plugins\Plugin.CreateRoi\Plugin.CreateRoi.csproj" />
    <!--
      海康相机驱动：直接引用（不走 Modules\ 反射加载），
      断言 Modules 发现契约 / (CameraDescriptor) 构造 / 缺 SDK 时的优雅降级 / 像素格式分类。
    -->
    <ProjectReference Include="..\Plugins\Plugin.Camera.Hikvision\Plugin.Camera.Hikvision.csproj" />
    <!--
      运动控制：直接引用"虚拟运动卡驱动"与"运动步骤插件"两个工程。
      虚拟卡让运动内核（命令队列 / 异步语义 / 急停打断 / 看门狗 / 报警门禁）
      在没有硬件的情况下也能被断言 —— 这些恰恰是最容易错、也最难在现场发现的一层。
    -->
    <ProjectReference Include="..\Plugins\Plugin.Motion.Virtual\Plugin.Motion.Virtual.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.Motion.Steps\Plugin.Motion.Steps.csproj" />
    <!--
      正运动驱动：只引用它的**纯逻辑**（回零模式码表 / 机型能力表 / 状态位域解析 / 故障分级）。
      冒烟里不会调用任何 ZAux_* P/Invoke，所以进程不会去加载 zauxdll.dll ——
      也就是说"没有真卡也能验"这批断言成立的前提，是它们只碰纯函数。
    -->
    <ProjectReference Include="..\Plugins\Plugin.Motion.ZMotion\Plugin.Motion.ZMotion.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.Utility\Plugin.Util.csproj" />
    <!--
      通讯立刻读/写：直接引用（不走 Modules\ 反射加载），断言插件面
      （元数据 / 端口候选 / 成功失败路径 / 发起前短路）。
    -->
    <ProjectReference Include="..\Plugins\Plugin.Comm\Plugin.Comm.csproj" />
    <!--
      图像采集：直接引用（不走 Modules\ 反射加载）。
      断言端口面（FrameId/ReceivedCount 新口 / 旧口不改名）、原始像素→HImage 的通道顺序与入口守卫、
      文件夹枚举的自然序——这三类都是"改坏了却很难被发现"的面；
      引用它也让构建顺带把 Plugin.ImageAcquisition.dll 刷新到 Modules（见 Directory.Build.targets）。
    -->
    <ProjectReference Include="..\Plugins\Plugin.ImageAcquisition\Plugin.ImageAcquisition.csproj" />
    <!--
      图像预处理：直接引用（不走 Modules\ 反射加载）。
      断言新增算子的注册表口径、像素级结果（顶帽/黑帽/边缘图）、参数收敛与存盘往返，
      以及"快照 → 活链 → 真执行"的端到端链路。引用它也让构建顺带把
      Plugin.PreProcessing.dll 刷新到 Modules。
    -->
    <ProjectReference Include="..\Plugins\Plugin.PreProcessing\Plugin.PreProcessing.csproj" />
    <!--
      标定：直接引用（不走 Modules\ 反射加载）。
      断言两层——纯托管算法（CalibrationMath：合成已知仿射 → 精度/互逆/共线守卫/径向带诊断）
      与插件级执行语义（真 RunAlgorithm：质量闸门、半填行指名、端口面不改名）。
      引用它也让构建顺带把 Plugin.Calibration.dll 刷新到 Modules。
    -->
    <ProjectReference Include="..\Plugins\Plugin.Calibration\Plugin.Calibration.csproj" />
    <!--
      卡尺测量：直接引用（不走 Modules\ 反射加载）。
      断言"像素当量直连"：MmPerPixel 输入端口三态（未接=手填 / 已接=以连线为准 / 失效=明确失败）
      + 真实链路（合成标定 → 真标定插件 → 真连到卡尺 → 真测合成亮带宽度）。
      引用它也让构建顺带把 Plugin.CaliperMeasure.dll 刷新到 Modules。
    -->
    <ProjectReference Include="..\Plugins\Plugin.CaliperMeasure\Plugin.CaliperMeasure.csproj" />
    <!--
      坐标变换：直接引用（不走 Modules\ 反射加载）。
      断言两层——纯托管数学（PoseTransformMath：正反变换/角度映射/三类失配，手算常量钉方向）
      与 HALCON 真算子（PoseTransformHalcon：位姿跟随/模板态自洽/对齐图方向）。
      引用它也让构建顺带把 Plugin.PoseTransform.dll 刷新到 Modules。
    -->
    <ProjectReference Include="..\Plugins\Plugin.PoseTransform\Plugin.PoseTransform.csproj" />
    <!--
      几何工具：直接引用（不走 Modules\ 反射加载）。
      断言 GeometryMath 纯托管几何（距离/求交/垂足/三点构圆/夹角 [0,90]）与 GeometryParam 契约
      （不可变工厂 / JSON 往返 / Phi 归一化）。引用它也让构建顺带把两个几何 DLL 刷新到 Modules。
    -->
    <ProjectReference Include="..\Plugins\Plugin.GeometryRelation\Plugin.GeometryRelation.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.GeometryFinder\Plugin.GeometryFinder.csproj" />
    <!--
      结果显示：直接引用插件工程（不走 Modules\ 反射加载）。
      断言"结果项 → BakePlan"的确定性映射（行主口径 / 判型顺序 / 钳制与元素上限 / 配置往返 / 试运行污染防御）
      与"真的烧进像素"（产物像素采样、缩略图带标注、导出 PNG 带标注、端到端 .vms）。
      引用它也让构建顺带把 Plugin.ResultDisplay.dll 刷新到 Modules。
    -->
    <ProjectReference Include="..\Plugins\Plugin.ResultDisplay\Plugin.ResultDisplay.csproj" />
    <!-- 两个脚本插件：枚举中文闸门要读它们 ScriptVarType 上的 [Display]，
         必须让编译期拿到类型、运行时程序集在 AppDomain 里（不走 Modules\\ 反射加载）。 -->
    <ProjectReference Include="..\Plugins\Plugin.CSharpScript\Plugin.CSharpScript.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.ImageScript\Plugin.ImageScript.csproj" />
    <!--
      数据链路三件套（P0-B）：直接引用插件工程（不走 Modules\ 反射加载）。
      断言的是"结果落地"这一层——字段表类型保真、CSV 转义、断网续传、Excel 超链接。
      引用它们也让构建顺带把三个 DLL 刷新到 Modules。
    -->
    <ProjectReference Include="..\Plugins\Plugin.ResultUpload\Plugin.ResultUpload.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.DataRecord\Plugin.DataRecord.csproj" />
    <ProjectReference Include="..\Plugins\Plugin.ExcelExport\Plugin.ExcelExport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 断言 Excel 报表要读回 xlsx；与插件用同一版本，避免"自己写 XML 自己读"的同源假绿 -->
    <PackageReference Include="MiniExcel" Version="1.46.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 显式引用 Halcon：halcondotnet 在 deps.json 里是 type:reference，不会随 ProjectReference
         传递到本工程的编译引用集。线序检测的投射断言要命名 ImageDisplayEvent<HImage>，
         故这里照插件工程的做法直接引一份。 -->
    <Reference Include="halcondotnet">
      <HintPath>..\DLL\Halcon\halcondotnet.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
