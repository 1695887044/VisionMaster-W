<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- 压测工程只在本机跑，自带 HSL 虚拟服务器当靶子，不参与产品发布 -->
    <IsPackable>false</IsPackable>
    <RootNamespace>CommStress</RootNamespace>
    <AssemblyName>CommStress</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用主程序即可拿到 Core / Communication / DLL(HslCommunication) 的全部 public 面 -->
    <ProjectReference Include="..\VisionMaster\VisionMaster.csproj" />
  </ItemGroup>

</Project>
