<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SCADA 图元控件库（S2）。

    依赖方向：VM.Scada（画面领域层）→ VM.Scada.Controls（本工程）。
    本工程是"把属性袋里的字符串翻译成画面"的唯一地方：
      · 领域层只知道 TypeKey 与 key/value 字符串；
      · 本工程用 ElementDescriptor 声明每个键是什么、默认值多少、对应控件上哪个依赖属性；
      · 颜色（"#AARRGGBB"）→ Brush 的转换只在这里发生，一处解释、一处使用。

    刻意不引用 UI 工程：本库要能在纯净宿主（无主题、无 UI 程序集）里单独加载，
    自带 Themes/Generic.xaml 提供全部默认外观（ThemeInfo 声明了 SourceAssembly）。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>VisionMaster.Scada.Controls</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      文字图标库内置：把 VM 已有的 Font Awesome 6 Pro Solid 以链接方式编进本程序集。
      为什么不用 UI 的 FA.Solid 键：本库刻意不引用 UI（见文件头），而 StaticResource
      在无 Application 的断言宿主里跨程序集查不到；链接进来后 ScadaIconFont 是本册自带资源，
      纯宿主也能解析。文件不复制，只链接。
    -->
    <Resource Include="..\UI\Controls\Asserts\FontFamilys\Font Awesome 6 Pro-Solid-900.otf"
              Link="Assets\FontAwesomeSolid.otf" />
  </ItemGroup>

  <ItemGroup>
    <!-- 二维码 / 条码编码器：不自己造码制（Reed-Solomon / 校验位写错会得到“看起来像码、扫不出来”的图）。
         ZXing.Net 同时给 WPF 与 Web 宿主用，保证两端编码结果一致。 -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- 画面领域层：图元模型（ScadaElement / ScadaBinding / ScadaPage） -->
    <ProjectReference Include="..\Scada\VM.Scada.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [ScadaProperty] 源生成器。Analyzer + ReferenceOutputAssembly=false：
         生成器只在编译期跑，不进本工程输出、不进任何交付包（与插件侧同一纪律，见 AGENTS.md R17）。
         本工程不在 Plugins\ 下，所以 Plugins\Directory.Build.props 那条目录级挂接覆盖不到它，
         必须在这里单独挂一次。 -->
    <ProjectReference Include="..\Shard\Core.ScadaGenerators\Core.ScadaGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
