<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        多档旋钮图元的外观（Hmi.SelectorSwitch）。

        视觉来自设计基线 design.html 推荐开发页签的 .hmi-selector：
        外层是一块带 1px 描边、3px 内衬的深色轨道（surface-2），里面并排 2~4 个圆角分段。
        选中档 = 「填充色」底 + 「文字颜色」；未选档 = 「未选中底色」+ 次级字色。

        三条本仓纪律：
        ① 档位显隐 / 文字 / 选中底色全部由控件代码写（SelectorSwitchElement.UpdateVisualState），
           模板里不给 PART_OptN / PART_OptTextN 写 Visibility 初值，也不写 DataTrigger 翻显隐
           ——本环境下 ControlTemplate.Triggers 里的 DataTrigger 一律不触发（见 ScadaElementBase.SetPartVisible）。
        ② 悬停提亮用一层独立的白色覆盖 Border（Opacity 0 → 0.08），不去改控件代码写下的 Background：
           选中色是用户配的「填充色」，覆盖层只在其上叠亮度，不抢语义。
        ③ 颜色一律走 ScadaTokens.xaml（本文件 hex=0，R140）；本分册就地合并令牌（R30）。
        ④ 五态里的「按下」由控件写值后选中档立即换色承担：本控件是 ContentControl 派生，
           没有 IsPressed（那是 ButtonBase 的属性），不做假的按压动画——避免"看着按下了、其实没写进去"。

        布局为什么是 12 列而不是 4 列：
        2/3/4 档要各自等分整个控件宽度（2 档各 1/2、3 档各 1/3、4 档各 1/4）。
        四列 Grid 在 2 档时被 Collapsed 的第 3/4 档仍占着列宽，前两档只拿到一半宽度
        （离屏图抓到「本...」「远...」被截断）。12 是 2/3/4 的最小公倍数：
        每档按 EffectiveOptionCount 换 Column/ColumnSpan，纯 XAML 就能等分，且不依赖代码改列宽。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  分段文字：10.5px 是设计基线的标签档；超长省略而不是撑破分段  -->
    <Style x:Key="SelectorOptionTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  分段底板：圆角 6（设计基线 .hmi-selector .opt）；背景由控件代码按选中态写  -->
    <Style x:Key="SelectorOptionBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        四个分段各自一套列位：12 列网格上按档位数换 Column/ColumnSpan。
        默认（4 档）：0/3/6/9，各 3 列；3 档：0/4/8，各 4 列；2 档：0/6，各 6 列。
    -->
    <Style
        x:Key="SelectorOption0Style"
        BasedOn="{StaticResource SelectorOptionBorderStyle}"
        TargetType="Border">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding EffectiveOptionCount, RelativeSource={RelativeSource TemplatedParent}}" Value="3">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EffectiveOptionCount, RelativeSource={RelativeSource TemplatedParent}}" Value="2">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="SelectorOption1Style"
        BasedOn="{StaticResource SelectorOptionBorderStyle}"
        TargetType="Border">
        <Setter Property="Grid.Column" Value="3" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding EffectiveOptionCount, RelativeSource={RelativeSource TemplatedParent}}" Value="3">
                <Setter Property="Grid.Column" Value="4" />
                <Setter Property="Grid.ColumnSpan" Value="4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding EffectiveOptionCount, RelativeSource={RelativeSource TemplatedParent}}" Value="2">
                <Setter Property="Grid.Column" Value="6" />
                <Setter Property="Grid.ColumnSpan" Value="6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="SelectorOption2Style"
        BasedOn="{StaticResource SelectorOptionBorderStyle}"
        TargetType="Border">
        <Setter Property="Grid.Column" Value="6" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding EffectiveOptionCount, RelativeSource={RelativeSource TemplatedParent}}" Value="3">
                <Setter Property="Grid.Column" Value="8" />
                <Setter Property="Grid.ColumnSpan" Value="4" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="SelectorOption3Style"
        BasedOn="{StaticResource SelectorOptionBorderStyle}"
        TargetType="Border">
        <Setter Property="Grid.Column" Value="9" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
    </Style>

    <Style TargetType="{x:Type local:SelectorSwitchElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Fill" Value="{StaticResource HmiSuccessFillBrush}" />
        <Setter Property="TrackColor" Value="{StaticResource HmiTrackBrush}" />
        <Setter Property="Stroke" Value="{StaticResource HmiBorderStrongBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HmiFocusVisual}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SelectorSwitchElement}">
                    <!--
                        轨道：surface-2 + 1px 描边 + 3px 内衬（.hmi-selector）。
                        圆角走 DoubleToCornerRadius —— Border.CornerRadius 是 CornerRadius 类型，
                        直接 TemplateBinding 图元的 double 会静默落到 0（Phase 1 的坑）。
                    -->
                    <Border
                        x:Name="PART_Track"
                        Padding="3"
                        Background="{StaticResource HmiSurfaceRaisedBrush}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  第 1 档  -->
                            <Border x:Name="PART_Opt0" Style="{StaticResource SelectorOption0Style}">
                                <Grid>
                                    <Border
                                        x:Name="PART_OptHover0"
                                        Background="{StaticResource HmiTextBrush}"
                                        CornerRadius="6"
                                        IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Opacity" Value="0.08" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock x:Name="PART_OptText0" Style="{StaticResource SelectorOptionTextStyle}" Text="{TemplateBinding Option0Text}" />
                                </Grid>
                            </Border>

                            <!--  第 2 档  -->
                            <Border x:Name="PART_Opt1" Style="{StaticResource SelectorOption1Style}">
                                <Grid>
                                    <Border
                                        x:Name="PART_OptHover1"
                                        Background="{StaticResource HmiTextBrush}"
                                        CornerRadius="6"
                                        IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Opacity" Value="0.08" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock x:Name="PART_OptText1" Style="{StaticResource SelectorOptionTextStyle}" Text="{TemplateBinding Option1Text}" />
                                </Grid>
                            </Border>

                            <!--  第 3 档  -->
                            <Border x:Name="PART_Opt2" Style="{StaticResource SelectorOption2Style}">
                                <Grid>
                                    <Border
                                        x:Name="PART_OptHover2"
                                        Background="{StaticResource HmiTextBrush}"
                                        CornerRadius="6"
                                        IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Opacity" Value="0.08" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock x:Name="PART_OptText2" Style="{StaticResource SelectorOptionTextStyle}" Text="{TemplateBinding Option2Text}" />
                                </Grid>
                            </Border>

                            <!--  第 4 档  -->
                            <Border x:Name="PART_Opt3" Style="{StaticResource SelectorOption3Style}">
                                <Grid>
                                    <Border
                                        x:Name="PART_OptHover3"
                                        Background="{StaticResource HmiTextBrush}"
                                        CornerRadius="6"
                                        IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Opacity" Value="0.08" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock x:Name="PART_OptText3" Style="{StaticResource SelectorOptionTextStyle}" Text="{TemplateBinding Option3Text}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--
                            禁用态：整体降透明度 + 箭头光标（设计基线 .is-disabled 的 .42 档）。
                            这里只用属性触发器（Trigger Property=），不用 DataTrigger —— 后者在本环境不触发。
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!--  不可写时不再给手型光标：看得见但点不动，不该假装能点  -->
            <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
