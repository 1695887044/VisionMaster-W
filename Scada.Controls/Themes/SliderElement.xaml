<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        模拟量滑块：轨道 + 填充 + 拇指 + 数值文字。
        轨道/填充/拇指的尺寸与对齐由 SliderElement.UpdateVisuals 按走向计算（本环境 ControlTemplate.Triggers
        里的 DataTrigger 不触发，Setter.Value 里嵌绑定也走不通，所以不把比例写进模板）。
    -->
    <Style TargetType="{x:Type local:SliderElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HmiFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <!--  触摸命中区下限（2026-10-25 评审 Q4）：视觉拇指 20px，控件本身至少 44px 高才好按  -->
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Fill" Value="{StaticResource HmiAccentStrongBrush}" />
        <Setter Property="Stroke" Value="{StaticResource HmiBorderStrongBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="TrackColor" Value="{StaticResource HmiTrackBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SliderElement}">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            数值气泡（2026-10-25 评审 Q3）：跟手走——贴到拇指正上方。
                            位置由 SliderElement.UpdateVisuals 按拇指偏移算（模板里写不出比例）。
                            纵向时退回右上角：轨道跨两行，没有"拇指上方"可以跟。
                        -->
                        <Border
                            x:Name="PART_ValuePlate"
                            Grid.Row="0"
                            Margin="0,0,0,2"
                            Padding="6,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource HmiSurfaceRaisedBrush}"
                            CornerRadius="6">
                            <TextBlock
                                x:Name="PART_ValueText"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Grid x:Name="PART_TrackHost" Grid.Row="1" Margin="10,0">
                            <Border
                                x:Name="PART_Track"
                                Background="{TemplateBinding TrackColor}"
                                BorderBrush="{TemplateBinding Stroke}"
                                BorderThickness="{TemplateBinding StrokeThickness}"
                                CornerRadius="4" />
                            <Border
                                x:Name="PART_Fill"
                                Background="{TemplateBinding Fill}"
                                CornerRadius="4" />
                            <Border
                                x:Name="PART_Thumb"
                                Background="{StaticResource HmiTextBrush}"
                                BorderBrush="{StaticResource HmiCanvasBackgroundBrush}"
                                BorderThickness="1"
                                CornerRadius="10" />
                        </Grid>

                        <!--
                            量程标注（2026-10-25 评审 §5）：两端小字给下限/上限。
                            没有它，操作员不知道这条轨道是 0~100 还是 0~250。
                        -->
                        <Grid Grid.Row="2" Margin="10,2,10,0">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="10"
                                Foreground="{StaticResource HmiTextMutedBrush}"
                                Text="{TemplateBinding Minimum}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="10"
                                Foreground="{StaticResource HmiTextMutedBrush}"
                                Text="{TemplateBinding Maximum}" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  禁用态：轨道/填充/拇指一起降饱和（否则看起来照样能拖）  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Background" Value="{StaticResource ScadaSliderDisabledTrackBrush}" />
                            <Setter TargetName="PART_Fill" Property="Background" Value="{StaticResource ScadaSliderDisabledFillBrush}" />
                            <Setter TargetName="PART_Thumb" Property="Background" Value="{StaticResource ScadaSliderDisabledThumbBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
