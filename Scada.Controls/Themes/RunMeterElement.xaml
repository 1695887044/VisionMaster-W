<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        运行计时 / 计数器：标签 + 大号等宽数值 + 副行（计时中/已暂停、目标与百分比）。
        数值用等宽字体与 tabular-nums，避免秒数跳动时整行左右抖。
    -->
    <Style TargetType="{x:Type local:RunMeterElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RunMeterElement}">
                    <Border
                        Padding="12"
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                FontSize="11.5"
                                Foreground="{StaticResource HmiTextSecondaryBrush}"
                                Text="{TemplateBinding Label}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                x:Name="MeterValue"
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Mono,Consolas,Microsoft YaHei UI"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="SemiBold"
                                Foreground="{TemplateBinding Foreground}"
                                Text="00:00:00"
                                TextOptions.TextFormattingMode="Ideal" />

                            <TextBlock
                                x:Name="MeterSub"
                                Grid.Row="2"
                                FontSize="11"
                                Foreground="{StaticResource HmiTextMutedBrush}"
                                Text="已暂停"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
