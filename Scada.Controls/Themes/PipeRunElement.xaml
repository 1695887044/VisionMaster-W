<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        管道连线（Hmi.PipeRun）：一条按路由器现算的折线 + 沿线的标签。

        几何在控件里算（本地坐标），模板只放一个 Path + 一个 TextBlock：
        标签用 Canvas 定位（Left/Top 由控件按 LabelAt 算好），宽度固定 160 让字居中在落点上。
        "端点丢失"时画虚线提示，不画一根乱指的线。
    -->
    <Style TargetType="{x:Type local:PipeRunElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PipeRunElement}">
                    <Canvas Background="Transparent">
                        <!--  连线本体（几何为空时什么也不画）  -->
                        <Path
                            x:Name="PipePath"
                            Data="{Binding PipeGeometry, RelativeSource={RelativeSource TemplatedParent}}"
                            Fill="Transparent"
                            Stroke="{TemplateBinding Stroke}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{TemplateBinding StrokeThickness}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <!--  端点没解析到：虚线 + 半透明，提示"这根管子断头了"  -->
                                        <DataTrigger Binding="{Binding IsLinked, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                            <Setter Property="StrokeDashArray" Value="4 3" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>

                        <!--  命中区：细线也要能点中（点中才能选中/删除）  -->
                        <Path
                            Data="{Binding PipeGeometry, RelativeSource={RelativeSource TemplatedParent}}"
                            Fill="Transparent"
                            Stroke="Transparent"
                            StrokeThickness="14" />

                        <!--  标签  -->
                        <TextBlock
                            x:Name="PipeLabel"
                            Width="{Binding LabelBoxWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            Canvas.Left="{Binding LabelLeft, RelativeSource={RelativeSource TemplatedParent}}"
                            Canvas.Top="{Binding LabelTop, RelativeSource={RelativeSource TemplatedParent}}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Text}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding LabelVisibility, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
