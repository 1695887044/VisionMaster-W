<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        本地图片图元：底框 + 图像本体 + 未设置/缺失时的占位。

        图像源由控件代码按注入的解析器写入（见 PictureElement.ApplyImage），模板里<b>不绑 Source</b>：
        路径是相对方案的，模板不知道方案目录；绑定一个相对路径给 Image.Source 只会得到空图。

        两块互斥显示也不写 Visibility 初值：本环境下 ControlTemplate.Triggers 里的 DataTrigger
        不触发（见 ImageViewElement 的同一条注释），初值会压过代码设置。
    -->
    <Style TargetType="{x:Type local:PictureElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PictureElement}">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Fill}"
                            BorderBrush="{TemplateBinding Stroke}"
                            BorderThickness="{TemplateBinding StrokeThickness}"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}" />

                        <Image
                            x:Name="ImageHost"
                            Margin="{TemplateBinding Padding}"
                            Stretch="{TemplateBinding Stretch}" />

                        <!--
                            未设置/缺失时的占位：浅色文字 + 一圈描边。
                            只写一个深色 TextBlock 在深色画布上等于看不见（实测渲染图里几乎读不出字）。
                            Border 就是 PartPlaceholder，代码按“有没有图”整体显隐。
                        -->
                        <Border
                            x:Name="Placeholder"
                            Margin="4"
                            Padding="8"
                            Background="{StaticResource HmiSurfaceBrush}"
                            BorderBrush="{StaticResource HmiBorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{StaticResource HmiTextMutedBrush}"
                                Text="{TemplateBinding PlaceholderText}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
