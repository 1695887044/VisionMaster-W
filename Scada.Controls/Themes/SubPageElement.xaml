<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        画中画 / 嵌入页图元（Hmi.SubPage，P1a）的默认外观。
        中间是 Viewbox 包住的嵌套 ScadaCanvas；缺页/无权/未选/嵌套过深时用占位盖住。
        令牌就地合并（R30），本文件 hex=0（R140）。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="SubPageBoolToVisibility" />

    <Style TargetType="{x:Type local:SubPageElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SubPageElement}">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Viewbox
                                x:Name="PART_Viewbox"
                                Stretch="Uniform"
                                StretchDirection="Both"
                                Visibility="{Binding ShowCanvas, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SubPageBoolToVisibility}}">
                                <Border
                                    x:Name="PART_CanvasHost" />
                            </Viewbox>

                            <Border
                                x:Name="PART_Placeholder"
                                Margin="1"
                                Background="{StaticResource HmiSurfaceBrush}"
                                BorderBrush="{StaticResource HmiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding ShowPlaceholder, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SubPageBoolToVisibility}}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="320"
                                    Margin="16">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource HmiTextBrush}"
                                        Text="{TemplateBinding PlaceholderTitle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource HmiTextMutedBrush}"
                                        Text="{TemplateBinding PlaceholderText}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="6"
                                Padding="6,2"
                                Background="{StaticResource HmiSurfaceRaisedBrush}"
                                BorderBrush="{StaticResource HmiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                IsHitTestVisible="False">
                                <TextBlock
                                    FontSize="9.5"
                                    Foreground="{StaticResource HmiTextMutedBrush}"
                                    Text="{TemplateBinding StatusText}" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
