<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        轴面板的外观（参考 web-70060145 的轴调试台：近黑卡片、珊瑚红强调、等宽数字、状态灯）。

        三条本仓纪律：
        ① 不写 ControlTemplate.Triggers 里的 DataTrigger —— 本环境下不触发（见 AlarmBannerElement 的注释）。
           显隐一律由控件算好的 Visibility 依赖属性直接绑（SelectorVisibility / SingleAxisVisibility / EmptyVisibility）。
        ② 颜色/圆角/字号走 TemplateBinding，属性面板改得动；模板里的十六进制只是"没配时"的兜底。
        ③ 不依赖 Application 级资源（ScadaChecks 直接 new 控件、没有 Application），
           所以这里自带 ComboBox 的最小模板，不去合并主程序的主题字典。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="AxisPanelComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HmiBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HmiBorderStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  轴选择器：自带模板，避开应用级 Fluent 隐式 ComboBox 样式（白底渐变在深色卡片上很刺眼）  -->
    <Style x:Key="AxisPanelCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Background" Value="{StaticResource HmiSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AxisPanelComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            ClickMode="Press"
                            Focusable="False"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter
                                                Grid.Column="0"
                                                Margin="8,0,4,0"
                                                VerticalAlignment="Center"
                                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Path
                                                Grid.Column="1"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L4,4 L8,0"
                                                Stroke="{TemplateBinding Foreground}"
                                                StrokeEndLineCap="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.4" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Slide">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="220"
                                Background="{StaticResource HmiSurfaceRaisedBrush}"
                                BorderBrush="{StaticResource HmiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  操作按钮：自带模板，避开应用级 Fluent 的隐式 Button 样式（浅色底 + 大内边距）  -->
    <Style x:Key="AxisCommandButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Background" Value="{StaticResource HmiSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="29" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HmiFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource HmiBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource HmiBorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="AxisCommandDangerButton"
        BasedOn="{StaticResource AxisCommandButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HmiDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiDangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  点位行的小按钮：比操作按钮更窄，一行里要塞下「示教 / 定位」两颗  -->
    <!--  内边距/边距在 2026-10-19 收窄 2px：280 宽的窄面板下，原来的 64+52+两颗按钮
          会把右边缘切掉（离屏图 scada-axis-console-280.png 抓到）。 -->
    <Style
        x:Key="PointRowButton"
        BasedOn="{StaticResource AxisCommandButton}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="PointCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  点动模式胶囊：连续 / 单步 两颗。
          选中态只靠 IsChecked 的真实值，由代码算好（IsContinuousJog / IsStepJog），模板里不写 DataTrigger——
          本环境的 DataTrigger 不触发，写了等于没写。  -->
    <Style x:Key="AxisJogModeToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource HmiFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Chip"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  IsChecked 的触发器是本环境能用的（普通 Trigger 而非 DataTrigger） -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource HmiSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HmiAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:AxisPanelElement}">        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AxisPanelElement}">
                    <Border
                        x:Name="AxisFrame"
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        ClipToBounds="True"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}">
                        <Grid x:Name="RootGrid" Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  表头：标题 + 轴选择器（多轴下拉 / 单轴静态名 / 未配置提示）  -->
                            <Grid Grid.Row="0" Margin="12,10,12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Text}"
                                    TextTrimming="CharacterEllipsis" />

                                <ComboBox
                                    x:Name="AxisCombo"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    DisplayMemberPath="DisplayName"
                                    Foreground="{TemplateBinding Foreground}"
                                    ItemsSource="{TemplateBinding AxisItems}"
                                    SelectedItem="{Binding SelectedAxisItem, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource AxisPanelCombo}"
                                    ToolTip="{Binding SelectedAxisName, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="{TemplateBinding SelectorVisibility}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{TemplateBinding MutedColor}"
                                    Text="{TemplateBinding SelectedAxisName}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{TemplateBinding SingleAxisVisibility}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{TemplateBinding MutedColor}"
                                    Text="未配置轴"
                                    Visibility="{TemplateBinding EmptyVisibility}" />
                            </Grid>

                            <!--  位置大字 + 运动中指示 + 单位  -->
                            <Grid Grid.Row="1" Margin="12,0,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Fill="{TemplateBinding MovingLampBrush}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding PositionText}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="6,0,0,4"
                                    VerticalAlignment="Bottom"
                                    FontSize="11"
                                    Foreground="{TemplateBinding MutedColor}"
                                    Text="mm" />
                            </Grid>

                            <!--  状态灯：两行四列，灯亮用强调色/告警色，灯灭用熄灭色  -->
                            <UniformGrid
                                Grid.Row="2"
                                Margin="12,0,12,6"
                                Columns="4"
                                Rows="2">
                                <StackPanel
                                    Margin="0,2,6,2"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding EnableLampBrush}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="使能" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,2,6,2"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding InPositionLampBrush}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="到位" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,2,6,2"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding MovingLampBrush}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="运动" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,2,6,2"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding OriginLampBrush}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="原点" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,2,6,2"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding AlarmLampBrush}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="报警" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,2,6,2"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding PosLimitLampBrush}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="正限位" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,2,6,2"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding NegLimitLampBrush}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="反限位" />
                                </StackPanel>
                                <StackPanel
                                    Margin="0,2,6,2"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding EmergencyStopLampBrush}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="急停" />
                                </StackPanel>
                            </UniformGrid>

                            <!--  速度 + 状态一句话  -->
                            <StackPanel Grid.Row="3" Margin="12,0,12,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="速度" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="11"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding VelocityText}" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        FontSize="11"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="mm/s" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Foreground="{TemplateBinding MutedColor}"
                                    Text="{TemplateBinding StatusText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{TemplateBinding StatusText}" />
                            </StackPanel>

                            <!--  点动模式行（连续 / 单步 + 步长输入）。
                                  ShowCommands=false 时一并收起：纯监视面板不该出现任何会动机构的入口。
                                  连续档下步长框只读、显示"—"：它这时候不生效，可编辑反而误导。  -->
                            <StackPanel
                                Grid.Row="4"
                                Margin="12,0,12,6"
                                Visibility="{TemplateBinding CommandsVisibility}">
                                <!--  运动中：只给一行提示，机构的指令还在跑，这时候再发点动会抢轴  -->
                                <Border
                                    Margin="0,0,0,4"
                                    Padding="6,2"
                                    Background="{StaticResource HmiWarningBannerBrush}"
                                    CornerRadius="4"
                                    Visibility="{TemplateBinding MovingBannerVisibility}">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{StaticResource HmiWarningBrush}"
                                        Text="运动中 · 点动已锁（到位或停止后自动放开）"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="停止 / 清报警 / 失能 / 回零不受影响" />
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="点动" />

                                    <!--  模式胶囊：两颗 ToggleButton 自绘，点击交给代码（不用 Trigger）  -->
                                    <Border
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource HmiTrackBrush}"
                                        CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton
                                                x:Name="BtnJogContinuous"
                                                Padding="7,2"
                                                FontSize="10"
                                                Foreground="{TemplateBinding Foreground}"
                                                IsChecked="{Binding IsContinuousJog, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource AxisJogModeToggle}"
                                                ToolTip="按住点动键连续走，松手停"
                                                Content="连续" />
                                            <ToggleButton
                                                x:Name="BtnJogStep"
                                                Padding="7,2"
                                                FontSize="10"
                                                Foreground="{TemplateBinding Foreground}"
                                                IsChecked="{Binding IsStepJog, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                Style="{StaticResource AxisJogModeToggle}"
                                                ToolTip="按一下走一个步长（当前位置 ± 步长），不连走"
                                                Content="单步" />
                                        </StackPanel>
                                    </Border>

                                    <!--  步长：手填只产文本，代码里再按 0~50 / 0.1 一档解析（宽进严出）  -->
                                    <StackPanel
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <TextBox
                                            x:Name="JogStepBox"
                                            Width="46"
                                            Padding="4,1"
                                            VerticalContentAlignment="Center"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="10"
                                            Foreground="{TemplateBinding Foreground}"
                                            IsEnabled="{TemplateBinding IsStepFieldEditable}"
                                            Background="{StaticResource HmiSurfaceRaisedBrush}"
                                            BorderBrush="{StaticResource HmiBorderBrush}"
                                            BorderThickness="1"
                                            Text="{Binding JogStepText, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            TextAlignment="Right"
                                            ToolTip="单步点动的步长：0 ~ 50 mm，精度 0.1 mm" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{TemplateBinding MutedColor}"
                                            Text="mm" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!--  操作按钮（ShowCommands=false 时整块收起）。
                                  容器绑 CanOperate：没有命令出口/没选轴/权限不够时一起灰掉，比"按下去没反应"诚实。
                                  两颗点动键另外单独绑 CanJog（= CanOperate && !IsMoving）：
                                  运动中必须拦住点动，但停止/清报警/失能/回零不能跟着灰——那是安全动作。  -->
                            <StackPanel
                                Grid.Row="5"
                                Margin="12,0,12,10"
                                Visibility="{TemplateBinding CommandsVisibility}">
                                <Grid IsEnabled="{TemplateBinding CanOperate}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Button
                                        x:Name="BtnEnable"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,5,4"
                                        Content="{TemplateBinding EnableButtonText}"
                                        Style="{StaticResource AxisCommandButton}" />

                                    <Button
                                        x:Name="BtnJogReverse"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,5,4"
                                        Content="◀ 点动"
                                        IsEnabled="{TemplateBinding CanJog}"
                                        Style="{StaticResource AxisCommandButton}" />

                                    <Button
                                        x:Name="BtnJogForward"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,0,4"
                                        Content="点动 ▶"
                                        IsEnabled="{TemplateBinding CanJog}"
                                        Style="{StaticResource AxisCommandButton}" />

                                    <Button
                                        x:Name="BtnHome"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,5,0"
                                        Content="回零"
                                        Style="{StaticResource AxisCommandButton}"
                                        ToolTip="长按 0.5 秒才触发（防误触）" />

                                    <Button
                                        x:Name="BtnStop"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,0,5,0"
                                        Content="停止"
                                        Style="{StaticResource AxisCommandDangerButton}" />

                                    <Button
                                        x:Name="BtnClearAlarm"
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Content="清报警"
                                        Style="{StaticResource AxisCommandButton}" />
                                </Grid>

                                <!--  上一次操作的结果：成功为空串（零高度），失败给可上屏的原因  -->
                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="10"
                                    Foreground="{TemplateBinding AlarmColor}"
                                    Text="{TemplateBinding CommandMessage}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{TemplateBinding CommandMessage}" />
                            </StackPanel>

                            <!--  点位区：与运动共用同一个 SelectedAxisId（合并控件的核心）。
                                  ShowPoints=false 时整块收起（轴面板的紧凑预设）。  -->
                            <StackPanel
                                x:Name="PointsPanel"
                                Grid.Row="6"
                                Margin="12,0,12,10"
                                Visibility="{TemplateBinding PointsVisibility}">
                                <Grid
                                    x:Name="PointsHeader"
                                    Margin="4,0,4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="Auto" MinWidth="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="点位"
                                        ToolTip="示教 = 把当前轴位置写进该行；定位 = 让轴走到该行位置与速度" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="位置(mm)" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,0,2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="速度(mm/s)" />
                                    <TextBlock
                                        Grid.Column="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{TemplateBinding MutedColor}"
                                        Text="操作" />
                                </Grid>

                                <Border
                                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                    Background="{StaticResource HmiSurfaceBrush}"
                                    BorderBrush="{TemplateBinding Stroke}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="4">
                                    <ScrollViewer
                                        x:Name="PointsScroll"
                                        MaxHeight="{TemplateBinding PointsHeight}"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl
                                            x:Name="PointsList"
                                            HorizontalContentAlignment="Stretch"
                                            ItemsSource="{TemplateBinding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="26" Margin="4,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Style="{StaticResource PointCellText}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:AxisPanelElement}}"
                                                            Text="{Binding Caption}"
                                                            ToolTip="{Binding Caption}" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            Style="{StaticResource PointCellText}"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:AxisPanelElement}}"
                                                            Text="{Binding PositionText}" />

                                                        <TextBox
                                                            Grid.Column="2"
                                                            Margin="2,0,0,0"
                                                            Padding="2,0"
                                                            HorizontalContentAlignment="Right"
                                                            Background="{StaticResource HmiSurfaceBrush}"
                                                            BorderBrush="{StaticResource HmiBorderBrush}"
                                                            BorderThickness="1"
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="10"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:AxisPanelElement}}"
                                                            IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType=local:AxisPanelElement}}"
                                                            Text="{Binding SpeedText, UpdateSourceTrigger=LostFocus}" />

                                                        <StackPanel
                                                            Grid.Column="3"
                                                            Margin="4,0,0,0"
                                                            Orientation="Horizontal">
                                                            <Button
                                                                Command="{Binding TeachCommand, RelativeSource={RelativeSource AncestorType=local:AxisPanelElement}}"
                                                                CommandParameter="{Binding}"
                                                                Content="示教"
                                                                Style="{StaticResource PointRowButton}"
                                                                Visibility="{Binding CommandsVisibility, RelativeSource={RelativeSource AncestorType=local:AxisPanelElement}}" />
                                                            <Button
                                                                Command="{Binding LocateCommand, RelativeSource={RelativeSource AncestorType=local:AxisPanelElement}}"
                                                                CommandParameter="{Binding}"
                                                                Content="定位"
                                                                Style="{StaticResource PointRowButton}"
                                                                Visibility="{Binding CommandsVisibility, RelativeSource={RelativeSource AncestorType=local:AxisPanelElement}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
