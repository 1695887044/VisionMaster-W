<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        时钟图元的外观：上面一行时间（占满剩余高度）+ 下面一行可选标签。

        模板里没有任何取时间的动作：它只绑只读的 DisplayText，而 DisplayText 由控件自己的节拍源
        每隔一段时间重算（见 ClockElement 类注释）。于是"时间怎么来"与"时间怎么显示"彻底分开，
        这个文件不必知道有没有定时器、节拍是多少。

        标签行用 Auto 高度：Text 为空时 TextBlock 量出来的高度是 0，整行自然塌掉，
        不必再加一个"显不显示标签"的开关属性。

        标签行沿用同一套 Foreground/FontFamily（没有第二个颜色属性）：时钟一般一屏一两个，
        真要"时间白、标签灰"这种效果，用户另放一个文本图元比多两个属性更省事。
    -->
    <Style TargetType="{x:Type local:ClockElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ClockElement}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="{TemplateBinding DisplayText}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            TextAlignment="{TemplateBinding TextAlignment}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Row="1"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
