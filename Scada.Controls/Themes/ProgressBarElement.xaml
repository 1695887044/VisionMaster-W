<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        棒图图元的外观：一条空槽（Track）+ 一条填充块（FillBar）+ 可选的数值文字。

        模板里<b>没有</b>任何"值 / 量程 / 比例"的算术：填充块的长度绑的是只读依赖属性 FillLength，
        算长度这件事在控件代码里（见 ProgressBarElement.UpdateFill）。模板只管把它贴到 Width/Height 上，
        与指示灯把 LampBrush 算好再交给模板是同一套路子。

        为什么用 Border 而不是 Rectangle：
        Border 的描边画在<b>自己的布局框内</b>（Rectangle 的描边骑在边界线上，所以矩形图元得靠
        ApplyStrokeInset 把半线宽转成 Padding 内缩）。用 Border 就不需要这层补偿，
        UpdateFill 里"可用长度 = 实际尺寸 − Padding − 2×描边"与实际像素一一对应。

        走向用 DataTrigger 切换：横向时填充块靠左、拉满高度；纵向时靠底、拉满宽度。
        用 Binding 而不是 TemplateBinding——TemplateBinding 只能出现在元素的属性上，
        不能出现在触发器的 Binding 位置（指示灯换形状时踩过同一个坑）。
    -->
    <Style TargetType="{x:Type local:ProgressBarElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProgressBarElement}">
                    <Border
                        x:Name="Track"
                        Margin="{TemplateBinding Padding}"
                        Background="{TemplateBinding TrackColor}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid>
                            <!-- 默认横向：靠左、拉满高度，长度由 FillLength 定 -->
                            <Border
                                x:Name="FillBar"
                                Width="{TemplateBinding FillLength}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding Fill}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                            <TextBlock
                                x:Name="ValueLabel"
                                Text="{TemplateBinding ValueText}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="2,0" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 纵向：改成靠底、拉满宽度。Width 置 Auto 才能让 HorizontalAlignment=Stretch 生效。 -->
                        <DataTrigger
                            Binding="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}}"
                            Value="Vertical">
                            <Setter TargetName="FillBar" Property="Width" Value="Auto" />
                            <Setter TargetName="FillBar" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="FillBar" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="FillBar" Property="Height"
                                    Value="{Binding FillLength, RelativeSource={RelativeSource TemplatedParent}}" />
                        </DataTrigger>

                        <DataTrigger
                            Binding="{Binding ShowValue, RelativeSource={RelativeSource TemplatedParent}}"
                            Value="False">
                            <Setter TargetName="ValueLabel" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
