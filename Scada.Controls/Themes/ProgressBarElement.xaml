<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        棒图图元的外观：一条空槽（Track）+ 一条填充块（FillBar）+ 可选的数值文字。

        模板里<b>没有</b>任何"值 / 量程 / 比例"的算术：填充块的长度绑的是只读依赖属性 FillLength，
        算长度这件事在控件代码里（见 ProgressBarElement.UpdateFill）。模板只管把它贴到 Width/Height 上，
        与指示灯把 LampBrush 算好再交给模板是同一套路子。

        为什么用 Border 而不是 Rectangle：
        Border 的描边画在<b>自己的布局框内</b>（Rectangle 的描边骑在边界线上，所以矩形图元得靠
        ApplyStrokeInset 把半线宽转成 Padding 内缩）。用 Border 就不需要这层补偿，
        UpdateFill 里"可用长度 = 实际尺寸 − Padding − 2×描边"与实际像素一一对应。

        走向与"显不显数值"都由控件代码处理（见 ProgressBarElement.UpdateBarLayout）：
        横向时填充块靠左、拉满高度、长度落在 Width 上；纵向时靠底、拉满宽度、长度落在 Height 上。
        不写成模板里的 DataTrigger——本环境下 ControlTemplate.Triggers 里的 DataTrigger 不触发，
        写了也是死代码（纵向棒图与 ShowValue=False 两个开关以前都没生效）；而且 Setter.Value 里嵌的
        绑定也一样走不通，所以填充块在这里连 Width/Height/对齐都不写，全部交给代码摆。
    -->
    <Style TargetType="{x:Type local:ProgressBarElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProgressBarElement}">
                    <Border
                        x:Name="Track"
                        Margin="{TemplateBinding Padding}"
                        Background="{TemplateBinding TrackColor}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                        <Grid>
                            <!-- 填充块：长度与对齐由控件代码按走向摆（见 UpdateBarLayout） -->
                            <Border
                                x:Name="FillBar"
                                Background="{TemplateBinding Fill}"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                            <TextBlock
                                x:Name="ValueLabel"
                                Text="{TemplateBinding ValueText}"
                                Foreground="{TemplateBinding Foreground}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="2,0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
