<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        枚举型下拉选择器图元的外观（Hmi.ComboBox）。

        为什么自带一套 ComboBox 模板：主程序把 .NET 9 Fluent 主题并进了应用级资源，
        它的 ComboBox 是浅色底 + 渐变，放在深色 SCADA 画面上就是一块白卡；而本库
        刻意不引用 UI 工程（纯净宿主也要能单独加载），所以这里自带深色模板。

        绑定契约（与 hmi 侧逐字一致）：
          · ItemsSource      = OptionList（ChoiceOption 集合）
          · DisplayMemberPath = Display（给人看的名字）
          · SelectedValuePath = Value（写进变量的整数）
          · SelectedValue     = 图元 Value 的 TwoWay 绑定
          · IsEnabled         = IsEditable（没有写通道 / 没绑变量 / 没权限时整体禁用）
          · PART_Combo        = ComboBox 本体（控件代码在它上面挂 DropDownClosed 写变量）

        未知值（映射表里没有的整数）不能让框里空着：ComboBox 自身找不到项时 SelectionBoxItem
        为 null，所以闭合态的文字改绑图元的 SelectedText（找不到映射时它给出「#值」），
        右侧再以等宽小字显示原始整数——「显示名 + 值」两维都看得见。

        颜色一律走 ScadaTokens.xaml（本文件 hex=0，R140）；本分册就地合并令牌（R30）。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  下拉选项行：hover 提亮、选中用强描边色，禁用降透明度  -->
    <Style x:Key="HmiComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="ItemChrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource HmiBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource HmiBorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  深色下拉框：闭合态 = surface 底 + 1px 描边 + chevron；展开 = 浮起表面 + 圆角弹层  -->
    <Style x:Key="HmiComboBoxStyle" TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource HmiComboBoxItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="ToggleButton"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!--
                                        圆角取外层图元的 CornerRadius（设计基线 .hmi-combo = 6；
                                        属性面板改「圆角」时这里跟着变，不写死）。
                                    -->
                                    <Border
                                        x:Name="Chrome"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:ComboBoxElement}}, Converter={StaticResource DoubleToCornerRadius}}"
                                        SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  闭合态显示 SelectedText（未知值 = #n），不是 SelectionBoxItem  -->
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="10,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!--  原始整数：等宽小字，设计基线 .hmi-combo 的右侧值  -->
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="10"
                                                Foreground="{StaticResource HmiTextMutedBrush}"
                                                Text="{Binding Value, RelativeSource={RelativeSource AncestorType={x:Type local:ComboBoxElement}}}"
                                                Typography.NumeralAlignment="Tabular" />

                                            <!--  chevron：10×6 的折线，线宽 1.4、圆头（设计基线 SVG 同形）  -->
                                            <Path
                                                Grid.Column="2"
                                                Width="10"
                                                Height="6"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L5,5 L10,0"
                                                Stretch="None"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.4" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HmiAccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="220"
                                Margin="0,4,0,0"
                                Padding="4"
                                Background="{StaticResource HmiSurfaceRaisedBrush}"
                                BorderBrush="{StaticResource HmiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ComboBoxElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Fill" Value="{StaticResource HmiSurfaceBrush}" />
        <Setter Property="Stroke" Value="{StaticResource HmiBorderStrongBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ComboBoxElement}">
                    <ComboBox
                        x:Name="PART_Combo"
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        DisplayMemberPath="Display"
                        FocusVisualStyle="{StaticResource HmiFocusVisual}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontSize="{TemplateBinding FontSize}"
                        FontWeight="{TemplateBinding FontWeight}"
                        Foreground="{TemplateBinding Foreground}"
                        IsEnabled="{TemplateBinding IsEditable}"
                        ItemsSource="{TemplateBinding OptionList}"
                        SelectedValue="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        Style="{StaticResource HmiComboBoxStyle}"
                        Tag="{TemplateBinding SelectedText}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
