<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        数据表格图元（Hmi.DataGrid）。

        与设计基线 docs/UI设计基线/scada-datagrid/design.html §04 对应：
        标题条 30 / 列头 26 / 行高 28（可配）/ 脚注 24。

        为什么不用 WPF 的 DataGrid：它自带编辑、排序、虚拟化一整套，样式在 Fluent 下更难压，
        而这里只要"只读展示最近 N 行"。用 ItemsControl + 每格定宽（宽度在 GridCellView 里算好），
        零转换器、零列定义协调。

        资源顺序：StaticResource 只认"已经读到的"键，所以格子/行模板必须排在使用它们的样式之前。
    -->
    <ResourceDictionary.MergedDictionaries>
        <!--  R30：兄弟分册互相看不见，令牌必须就地合并  -->
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  一格：宽度、对齐、等宽、错误色都来自 GridCellView（见 DataGridElement）  -->
    <DataTemplate x:Key="DataGridCell">
        <TextBlock
            Width="{Binding Width}"
            Margin="0,0,6,0"
            Text="{Binding Text}"
            TextAlignment="{Binding Align}"
            TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="11.5" />
                    <!--  正文色走图元的 Foreground（浅色主题下由属性包写深色字）；
                          没配时回落令牌色 = 深色主题原样（零回归）。  -->
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiTextSecondaryBrush}}" />
                    <Style.Triggers>
                        <!--  等宽 + 主文字色：数字/时间/SN 列扫起来才成一条竖线  -->
                        <DataTrigger Binding="{Binding Monospace}" Value="True">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiTextBrush}}" />
                        </DataTrigger>
                        <!--  这一列没取到值（变量不存在/读取失败）：如实标红，不显示空白冒充 0  -->
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource HmiDangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!--  列头格：同一份格子数据，换一套字色与字号  -->
    <DataTemplate x:Key="DataGridHeaderCell">
        <TextBlock
            Width="{Binding Width}"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            FontSize="10.5"
            FontWeight="SemiBold"
            Foreground="{Binding HeaderForeground, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiTextMutedBrush}}"
            Text="{Binding Text}"
            TextAlignment="{Binding Align}"
            TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <!--
        行模板：横向排一串格 + 斑马纹。
        斑马纹走 AlternationCount：容器上带着 AlternationIndex，模板按它换底色，
        图元不必自己算"这是第几行"。
    -->
    <DataTemplate x:Key="DataGridRow">
        <Border x:Name="RowBorder" Background="Transparent">
            <ItemsControl
                Height="{Binding RowHeight, RelativeSource={RelativeSource AncestorType=local:DataGridElement}}"
                Margin="10,0"
                ItemTemplate="{StaticResource DataGridCell}"
                ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>
        <DataTemplate.Triggers>
            <!--  斑马纹：奇偶 + 图元上的「斑马纹」开关（关掉就整表一个底色）  -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition
                        Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                        Value="1" />
                    <Condition
                        Binding="{Binding Zebra, RelativeSource={RelativeSource AncestorType=local:DataGridElement}}"
                        Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="RowBorder" Property="Background" Value="{Binding ZebraBackground, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiZebraBrush}}" />
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
        历史工具栏按钮：22 高、显式 Padding（R68：写了 Height 的按钮必须挂 Style 或 Padding，
        否则吃 Fluent 隐式样式的 11,5,11,6，文字被模板里的 Border 切掉）。
    -->
    <Style x:Key="DataGridToolButton" TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="FontSize" Value="10.5" />
        <!--  三个颜色都从外层图元取（浅色主题下由属性包/Header* 覆盖），
              没配时回落令牌色 = 深色主题原样。此样式只在本文件内使用。  -->
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiTextSecondaryBrush}}" />
        <Setter Property="Background" Value="{Binding HeaderBackground, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiSurfaceBrush}}" />
        <Setter Property="BorderBrush" Value="{Binding Stroke, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiBorderStrongBrush}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Stroke, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiSurfaceRaisedBrush}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{Binding Stroke, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiSurfaceRaisedBrush}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        主操作按钮（「查询」）：一屏只许一个实心主色按钮，其余仍是幽灵按钮。
        基于 DataGridToolButton 派生，只换三处颜色——模板与内边距不复制一份（R120）。
    -->
    <Style x:Key="DataGridPrimaryButton" TargetType="Button" BasedOn="{StaticResource DataGridToolButton}">
        <Setter Property="Foreground" Value="{StaticResource HmiPrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource HmiPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HmiPrimaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HmiPrimaryHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:DataGridElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <!--
            主题默认值（深色 HMI）走 Style 而不是模板里写死：属性包（.vms 的 Fill/Stroke/Foreground）
            写的是本地值，本地值压 Style setter，于是"浅色主题只改属性、模板零分支"。
            不配这三个属性的存量画面拿到的仍是原来那三个令牌色（零回归）。
        -->
        <Setter Property="Fill" Value="{StaticResource HmiSurfaceBrush}" />
        <Setter Property="Stroke" Value="{StaticResource HmiBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DataGridElement}">
                    <Border
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题条（PART_HeaderBar：可选配色由 HeaderBackground 覆盖）  -->
                            <Border
                                x:Name="PART_HeaderBar"
                                Grid.Row="0"
                                Height="30"
                                Background="{StaticResource HmiSurfaceRaisedBrush}"
                                BorderBrush="{Binding Stroke, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="7,7,0,0">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  标题走基类的 Text 属性（与其它图元同一套"文字"配置）
                                          Foreground 走可选 HeaderForeground：null 时 TargetNullValue 回落令牌色（零回归）  -->
                                    <TextBlock
                                        x:Name="PART_HeaderText"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding HeaderForeground, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={StaticResource HmiTextBrush}}"
                                        Text="{TemplateBinding Text}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        x:Name="PART_HeaderCount"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10.5"
                                        Foreground="{Binding HeaderForeground, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={StaticResource HmiTextMutedBrush}}"
                                        Text="{Binding TitleCountText, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>
                            </Border>

                            <!--  历史工具栏：只在 Source=History 时出现（实时模式的采集配置在属性面板里）  -->
                            <Border
                                x:Name="PART_HistoryToolbar"
                                Grid.Row="1"
                                Height="34"
                                Background="{StaticResource HmiSurfaceRaisedBrush}"
                                BorderBrush="{Binding Stroke, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="0,0,0,1"
                                Visibility="{Binding HistoryToolbarVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid Margin="8,0">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <!--  范围用循环按钮而不是下拉：ComboBox 的弹出层由应用级主题决定，
                                              深色 HMI 画面上会突然出现一块白底下拉，且跨主题难以压住。
                                              按钮上的文字就是当前范围，点一次切下一档。  -->
                                        <Button
                                            Margin="0"
                                            Command="{Binding CycleHistoryRangeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            Content="{Binding HistoryRangeLabel, RelativeSource={RelativeSource TemplatedParent}}"
                                            Style="{StaticResource DataGridToolButton}"
                                            ToolTip="点击切换时间范围：今天 → 昨天 → 最近 7 天 → 最近 30 天（切换后立即查询）" />

                                        <Button
                                            Command="{Binding QueryHistoryCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            Content="查询"
                                            Style="{StaticResource DataGridPrimaryButton}"
                                            ToolTip="按当前范围查询第一页" />

                                        <Button
                                            Margin="12,0,0,0"
                                            Command="{Binding PreviousHistoryPageCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            Content="上一页"
                                            Style="{StaticResource DataGridToolButton}" />

                                        <TextBlock
                                            Margin="8,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={StaticResource HmiTextMutedBrush}}"
                                            Text="{Binding HistoryPageText, RelativeSource={RelativeSource TemplatedParent}}" />

                                        <Button
                                            Margin="0"
                                            Command="{Binding NextHistoryPageCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            Content="下一页"
                                            Style="{StaticResource DataGridToolButton}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  列头（没有列定义时整行收起：空表头比空白更让人以为坏了）  -->
                            <Border
                                x:Name="PART_ColumnHeader"
                                Grid.Row="2"
                                Height="26"
                                BorderBrush="{Binding Stroke, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource HmiSurfaceRaisedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeaderCells.Count, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ItemsControl
                                    Margin="10,0"
                                    ItemTemplate="{StaticResource DataGridHeaderCell}"
                                    ItemsSource="{Binding HeaderCells, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>

                            <!--  行区  -->
                            <Grid Grid.Row="3">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl
                                        AlternationCount="2"
                                        ItemTemplate="{StaticResource DataGridRow}"
                                        ItemsSource="{Binding Rows, RelativeSource={RelativeSource TemplatedParent}}" />
                                </ScrollViewer>

                                <!--  查询中骨架：不盖转圈遮罩，也不清空旧行——
                                      骨架层是整块不透明底，视觉上就是"这一页正在换"，不会让人以为表坏了。  -->
                                <Border
                                    Background="{TemplateBinding Fill}"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HistoryBusyVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                    <StackPanel Margin="14,12" VerticalAlignment="Top">
                                        <Border
                                            Height="10"
                                            Margin="0,0,60,12"
                                            Background="{Binding Stroke, RelativeSource={RelativeSource TemplatedParent}}"
                                            CornerRadius="3"
                                            Opacity="0.45" />
                                        <Border
                                            Height="10"
                                            Margin="0,0,30,12"
                                            Background="{Binding Stroke, RelativeSource={RelativeSource TemplatedParent}}"
                                            CornerRadius="3"
                                            Opacity="0.35" />
                                        <Border
                                            Height="10"
                                            Margin="0,0,90,12"
                                            Background="{Binding Stroke, RelativeSource={RelativeSource TemplatedParent}}"
                                            CornerRadius="3"
                                            Opacity="0.25" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="10"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                            Text="正在查询历史记录…" />
                                    </StackPanel>
                                </Border>

                                <!--  空态：两种成因分开说（没配采集 / 配了但还没来第一行）  -->
                                <StackPanel
                                    Margin="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding EmptyVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                        Text="{Binding EmptyTitle, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        MaxWidth="260"
                                        FontSize="10.5"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                        Opacity="0.8"
                                        Text="{Binding EmptyHint, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  查询失败横幅：压在本页顶部，不遮住下面的旧行
                                      （设计基线：不可用要保留上一次结果）。重试与查询同一条命令。  -->
                                <Border
                                    Margin="8,8,8,0"
                                    Padding="10,6"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource HmiWarningBannerBrush}"
                                    BorderBrush="{StaticResource HmiWarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{Binding HistoryBannerVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource HmiTextBrush}"
                                            Text="{Binding HistoryBannerText, RelativeSource={RelativeSource TemplatedParent}}"
                                            TextTrimming="CharacterEllipsis" />

                                        <Button
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Command="{Binding QueryHistoryCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            Content="重试"
                                            Style="{StaticResource DataGridToolButton}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--  脚注：坏列 / 确认写入失败 / 空 = 正常  -->
                            <Border
                                x:Name="PART_FooterBar"
                                Grid.Row="4"
                                Height="24"
                                BorderBrush="{Binding Stroke, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,7,7">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  实时模式的红字是"坏列/写失败"；历史模式的脚注是正常读数（共 N 条·来源），
                                          用红字会让每一次查询都像出了错。  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource HmiDangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHistoryMode, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:DataGridElement}, TargetNullValue={StaticResource HmiTextMutedBrush}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                        Opacity="0.75"
                                        Text="{Binding RowHeight, RelativeSource={RelativeSource TemplatedParent}, StringFormat='行高 {0:0} px'}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
