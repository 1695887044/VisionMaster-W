<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        指示灯图元的外观：灯体（圆/方两种，同一时刻只显示一个）+ 下方一行标签。

        灯色绑的是只读的 LampBrush（= IsOn ? OnColor : OffColor），
        所以模板里完全不关心"点没点亮"这件事——切换逻辑在控件代码里，模板只管画。
        换形状同理：圆/方两块灯体叠在同一格，由控件代码按 Shape 翻显隐
        （见 IndicatorElement.UpdateShapeVisibility）。不写成模板里的 DataTrigger——
        本环境下 ControlTemplate.Triggers 里的 DataTrigger 不触发，写了也是死代码。

        灯的描边框用基类的 Stroke/StrokeThickness：给灯加一圈暗边框，
        深色画面上的绿灯边缘才不会糊成一片。
    -->
    <Style TargetType="{x:Type local:IndicatorElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IndicatorElement}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="{TemplateBinding Padding}">
                            <Ellipse
                                x:Name="LampCircle"
                                Fill="{TemplateBinding LampBrush}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="{TemplateBinding StrokeThickness}" />

                            <!-- 方形灯：由控件代码按 Shape 换过来 -->
                            <Rectangle
                                x:Name="LampSquare"
                                RadiusX="3"
                                RadiusY="3"
                                Fill="{TemplateBinding LampBrush}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="{TemplateBinding StrokeThickness}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
