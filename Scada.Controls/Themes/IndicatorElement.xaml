<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        指示灯图元的外观：灯体（圆/方两种，同一时刻只显示一个）+ 下方一行标签。

        灯色绑的是只读的 LampBrush（= IsOn ? OnColor : OffColor），
        所以模板里完全不关心"点没点亮"这件事——切换逻辑在控件代码里，模板只管画。
        换形状才用 DataTrigger：它改的是"哪个形状可见"，属于纯模板层的选择。

        灯的描边框用基类的 Stroke/StrokeThickness：给灯加一圈暗边框，
        深色画面上的绿灯边缘才不会糊成一片。
    -->
    <Style TargetType="{x:Type local:IndicatorElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IndicatorElement}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="{TemplateBinding Padding}">
                            <Ellipse
                                x:Name="LampCircle"
                                Fill="{TemplateBinding LampBrush}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="{TemplateBinding StrokeThickness}" />

                            <!-- 方形灯默认隐藏，由 Shape 触发器换过来 -->
                            <Rectangle
                                x:Name="LampSquare"
                                Visibility="Collapsed"
                                RadiusX="3"
                                RadiusY="3"
                                Fill="{TemplateBinding LampBrush}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="{TemplateBinding StrokeThickness}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 用 Binding 而不是 TemplateBinding：TemplateBinding 只能用在
                             元素的属性上，不能出现在触发器的 Binding 位置。 -->
                        <DataTrigger
                            Binding="{Binding Shape, RelativeSource={RelativeSource TemplatedParent}}"
                            Value="Square">
                            <Setter TargetName="LampCircle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LampSquare" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
