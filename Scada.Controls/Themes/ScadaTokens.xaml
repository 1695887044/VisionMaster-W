<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--  按钮四态令牌（2026-10-25 按钮审查：悬停边框 / 危险变体 / 禁用蒙版与文字 / 焦点环）  -->
    <SolidColorBrush x:Key="ScadaButtonHoverStrokeBrush" Color="#FF3F5570" />
    <SolidColorBrush x:Key="ScadaButtonDangerTintBrush" Color="#FFB03A2E" />
    <SolidColorBrush x:Key="ScadaButtonDangerTextBrush" Color="#FFFFD9D4" />
    <SolidColorBrush x:Key="ScadaButtonDisabledVeilBrush" Color="#FF0F172A" />
    <SolidColorBrush x:Key="ScadaButtonDisabledTextBrush" Color="#FFB6C2D1" />
    <SolidColorBrush x:Key="ScadaButtonFocusRingBrush" Color="#FF38BDF8" />

    <!--  滑块禁用态令牌（2026-10-25 评审：禁用时轨道/填充/拇指一起降饱和）  -->
    <SolidColorBrush x:Key="ScadaSliderDisabledTrackBrush" Color="#FF1E2833" />
    <SolidColorBrush x:Key="ScadaSliderDisabledFillBrush" Color="#FF334155" />
    <SolidColorBrush x:Key="ScadaSliderDisabledThumbBrush" Color="#FF64748B" />

    <!--
        状态色令牌（2026-10-26 样式审查）：**同一语义只有这一个取值**。
        以前"运行"至少有四个绿/蓝（#34C759 / #22C55E / #2D7DD2 / #0EA5E9），
        同一屏两台设备都在运行却颜色不同，操作员会怀疑"是不是不同意思"。
        图元的颜色属性仍然可改（局部覆盖），这五个只是默认值与参照。
    -->
    <SolidColorBrush x:Key="HmiStateRunningBrush" Color="#FF22C55E" />
    <SolidColorBrush x:Key="HmiStateStoppedBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="HmiStateWarningBrush" Color="#FFFFB020" />
    <SolidColorBrush x:Key="HmiStateFaultBrush" Color="#FFE03A2B" />
    <SolidColorBrush x:Key="HmiStateUnknownBrush" Color="#FF4B5563" />

    <!--
        运行画面（深色）令牌 —— 设计基线 v1 §03 / §12。

        为什么落在本程序集而不是 UI\Controls\Themes\Colors.xaml：
        VM.Scada.Controls 刻意不引用 UI 工程（纯净宿主也要能单独加载），
        跨工程 StaticResource 在断言宿主里根本解析不到。两处同名同值、各管一段：
          · 本文件：Scada.Controls / Scada.Controls.Charts 的图元主题；
          · UI\Controls\Themes\Colors.xaml：宿主编辑器与弹窗（本批不动）。
        禁止把本文件的键改成 DynamicResource 去跨程序集取，也禁止合并 UI 工程的字典。

        取值与 docs/UI设计基线/scada-controls/design.html §03 逐项一致。
        新增键必须先全仓查重（R146）；本文件是唯一允许出现十六进制色的主题文件（R140）。
    -->

    <!--  double → CornerRadius（Border.CornerRadius 是 CornerRadius 类型，不能直接 TemplateBinding double）  -->
    <local:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadius" />
    <local:DoubleToCornerRadiusTopConverter x:Key="DoubleToCornerRadiusTop" />

    <!--  画面与表面  -->
    <SolidColorBrush x:Key="HmiCanvasBackgroundBrush" Color="#0E1318" />
    <SolidColorBrush x:Key="HmiSurfaceBrush" Color="#151C23" />
    <SolidColorBrush x:Key="HmiSurfaceRaisedBrush" Color="#1B242D" />
    <!--  二维码/条码的码面：扫描要求固定白底，深色主题下也不反色（本批新增令牌）  -->
    <SolidColorBrush x:Key="HmiCodeSurfaceBrush" Color="#FFFFFF" />

    <!--  描边  -->
    <SolidColorBrush x:Key="HmiBorderBrush" Color="#2A3745" />
    <SolidColorBrush x:Key="HmiBorderStrongBrush" Color="#3A4A5C" />
    <!--  只读字段的底边线：与 IOField 只读态的默认 Stroke 同色（#7A7A7A）  -->
    <SolidColorBrush x:Key="HmiFieldUnderlineBrush" Color="#7A7A7A" />

    <!--  文字  -->
    <SolidColorBrush x:Key="HmiTextBrush" Color="#E6EEF7" />
    <SolidColorBrush x:Key="HmiTextSecondaryBrush" Color="#A9B7C6" />
    <SolidColorBrush x:Key="HmiTextMutedBrush" Color="#7C8A99" />

    <!--  交互 / 语义色  -->
    <SolidColorBrush x:Key="HmiAccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="HmiAccentStrongBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="HmiSuccessBrush" Color="#22C55E" />
    <!--  成功态实心填充（白字对比足够）：选中档/确认态用，不另造第二套语义  -->
    <SolidColorBrush x:Key="HmiSuccessFillBrush" Color="#15803D" />
    <SolidColorBrush x:Key="HmiWarningBrush" Color="#F59E0B" />
    <!--  警告横幅底：不透明深琥珀，盖在行上时文字才读得清  -->
    <SolidColorBrush x:Key="HmiWarningBannerBrush" Color="#3B2A12" />
    <SolidColorBrush x:Key="HmiDangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="HmiInfoBrush" Color="#3B82F6" />
    <!--
        主操作色（"一屏一个实心主按钮"）：表格/报表工具栏的「查询」用它。
        浅色主题下是 Web 惯用的 #2563EB；深色主题沿用同一支，白字对比足够。
    -->
    <SolidColorBrush x:Key="HmiPrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="HmiPrimaryHoverBrush" Color="#1D4ED8" />
    <!--  主操作按钮上的文字：白字（与 HmiPrimaryBrush 配对，视图里不再写 #FFFFFFFF）  -->
    <SolidColorBrush x:Key="HmiPrimaryTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HmiOffBrush" Color="#64748B" />

    <!--  轨道 / 选中 / 锁定 / 诊断  -->
    <SolidColorBrush x:Key="HmiTrackBrush" Color="#26313D" />
    <!--  表格斑马纹：隔行浅底（深色画面上是"提亮一点"，不是"换一层灰"）  -->
    <SolidColorBrush x:Key="HmiZebraBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="HmiSelectionBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="HmiLockedBrush" Color="#E3A51B" />
    <SolidColorBrush x:Key="HmiDiagnosticWarningBrush" Color="#E88B1A" />
    <SolidColorBrush x:Key="HmiDiagnosticErrorBrush" Color="#E03A2B" />

    <!--
        焦点视觉（R135）：2px accent + 2px offset。
        运行态控件在深色画面上用这一份；弹窗族仍用 DialogFocusVisual。
    -->
    <Style x:Key="HmiFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="2"
                        BorderBrush="{StaticResource HmiAccentBrush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
