<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        图像显示图元的外观：一层底框 + 图像本体 + 无图时的占位提示。

        底框用基类的 Fill/Stroke/StrokeThickness/CornerRadius，
        与矩形等图元共用同一套外观词汇——给图加一圈边框和底色，深色画面上的图像才不会与背景糊在一起。

        图像本体与占位提示<b>不写 Visibility 初值</b>：两者互斥显示，
        由控件代码按 Source 是否为空翻显隐（见 ImageViewElement.UpdatePlaceholderVisibility）。
        本环境下 ControlTemplate.Triggers 里的 DataTrigger 不触发，写了也是死代码；
        而模板里写死的 Visibility 初值又会压过代码的设置，所以这里一律留空。

        缩放方式绑 Stretch（复用 WPF 自带枚举），默认 Uniform：
        图像按比例缩放到框内且不变形，是"看结果图"最稳妥的默认。
    -->
    <Style TargetType="{x:Type local:ImageViewElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageViewElement}">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Fill}"
                            BorderBrush="{TemplateBinding Stroke}"
                            BorderThickness="{TemplateBinding StrokeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />

                        <Image
                            x:Name="ImageHost"
                            Margin="{TemplateBinding Padding}"
                            Source="{TemplateBinding Source}"
                            Stretch="{TemplateBinding Stretch}" />

                        <TextBlock
                            x:Name="Placeholder"
                            Margin="{TemplateBinding Padding}"
                            Text="{TemplateBinding PlaceholderText}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
