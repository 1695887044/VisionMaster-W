<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        圆形进度条图元的外观：卡片底（Border）+ 一块自绘面（CircularProgressArc）+ 圆心的数值/单位。

        为什么环画在子元素上、不画在本控件的 OnRender 里：
        WPF 里<b>模板子元素画在控件自身 OnRender 之上</b>（实测：控件 OnRender 里铺满的矩形
        被模板 Border 的不透明底色整个盖住）。卡片底必须留在模板里（Fill / Stroke / 圆角与
        其余图元同一口径），所以"纯 OnRender 画弧"落在 Border 里面的那块绘制面上，
        与 XY 曲线（XYChartElement + XYChartSurface）、多曲线趋势（MultiTrendElement + TrendSurface）
        是同一条做法。

        模板里<b>一个算术都没有</b>：半径、环宽、起止角、大弧标志全在 CircularProgressElement.PaintArc
        里按实时尺寸算；数值那行绑只读的 ValueText（格式串写坏时由控件回落到 F0）。

        刻意不写 ControlTemplate.Triggers 的 DataTrigger：本环境下它不触发（写了是死代码），
        「显示数值」这个开关由控件代码翻（见 CircularProgressElement.UpdateVisual），
        所以两个 TextBlock 在这里都不写 Visibility 初值。

        单位字用 LayoutTransform 缩到 0.7 倍，而不是另给一个字号属性：
        它天然跟着 FontSize 一起变，不必再为"小一号"造第二个可配属性。
    -->
    <Style TargetType="{x:Type local:CircularProgressElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CircularProgressElement}">
                    <Border
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}">
                        <Grid>
                            <!--  环与进度弧：几何全由控件代码按实时尺寸算（见 PaintArc）  -->
                            <local:CircularProgressArc x:Name="ArcLayer" IsHitTestVisible="False" />

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <!--  圆心读数：显隐由控件代码翻（ShowValue）  -->
                                <TextBlock
                                    x:Name="ValueLabel"
                                    Text="{TemplateBinding ValueText}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Center" />

                                <!--  单位/说明（基类 Text，可空）：小一号压在读数下方  -->
                                <TextBlock
                                    x:Name="CaptionLabel"
                                    Text="{TemplateBinding Text}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
