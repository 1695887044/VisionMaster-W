<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        配方只读面板的外观（Hmi.RecipePanel）。

        结构：一张卡片 —— 标题行（可空）/ 主行（配方名 · 版本 + 状态胶囊）/ 明细列表 / 空态提示。
        状态色只认四个键（ok / warn / danger / muted），由控件算好写进 StatusKey，
        模板用 DataTrigger 判等挑颜色——不在模板里做"文案包含偏离"这类字符串判断。

        颜色一律走 ScadaTokens.xaml（本文件 hex=0，R140）；分册就地合并令牌（R30）。
        注意：本文件里的资源顺序即模板可见的顺序（R173：模板只认它之前定义的键）。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  标题：空串时整行收起  -->
    <Style x:Key="RecipeTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  主行：配方名 · 版本  -->
    <Style x:Key="RecipeHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        状态胶囊：默认（muted）灰、ok 绿、warn 橙、danger 红。
        颜色直接写 Border 的 Background/BorderBrush，文字色由内层 TextBlock 单独取——
        胶囊底色用低饱和（同一支色 + Opacity），文字用本色，深浅底上都读得清。
    -->
    <Style x:Key="RecipeStatusPillStyle" TargetType="Border">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiBorderStrongBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKey, RelativeSource={RelativeSource TemplatedParent}}" Value="ok">
                <Setter Property="BorderBrush" Value="{StaticResource HmiSuccessBrush}" />
                <Setter Property="Background" Value="{StaticResource HmiSuccessFillBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey, RelativeSource={RelativeSource TemplatedParent}}" Value="warn">
                <Setter Property="BorderBrush" Value="{StaticResource HmiWarningBrush}" />
                <Setter Property="Background" Value="{StaticResource HmiWarningBannerBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey, RelativeSource={RelativeSource TemplatedParent}}" Value="danger">
                <Setter Property="BorderBrush" Value="{StaticResource HmiDangerBrush}" />
                <Setter Property="Background" Value="{StaticResource HmiSurfaceRaisedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RecipeStatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKey, RelativeSource={RelativeSource TemplatedParent}}" Value="ok">
                <Setter Property="Foreground" Value="{StaticResource HmiSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey, RelativeSource={RelativeSource TemplatedParent}}" Value="warn">
                <Setter Property="Foreground" Value="{StaticResource HmiWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKey, RelativeSource={RelativeSource TemplatedParent}}" Value="danger">
                <Setter Property="Foreground" Value="{StaticResource HmiDangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  明细行：等宽字体（参数值是数字/枚举，等宽才好逐行比对）；汇总行弱化  -->
    <DataTemplate x:Key="RecipeLineTemplate">
        <TextBlock
            FontFamily="Cascadia Mono, Consolas"
            FontSize="11.5"
            Foreground="{StaticResource HmiTextSecondaryBrush}"
            Text="{Binding Text}"
            TextTrimming="CharacterEllipsis">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTruncated}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource HmiTextMutedBrush}" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!--  空态提示：弱化色一行字，没有内容时才有  -->
    <Style x:Key="RecipeHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:RecipePanelElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="Fill" Value="{StaticResource HmiSurfaceBrush}" />
        <Setter Property="Stroke" Value="{StaticResource HmiBorderBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RecipePanelElement}">
                    <Border
                        x:Name="Frame"
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}">
                        <Grid Margin="12,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题（留空整行收起）  -->
                            <TextBlock
                                Grid.Row="0"
                                Margin="0,0,0,4"
                                Style="{StaticResource RecipeTitleStyle}"
                                Text="{TemplateBinding Title}" />

                            <!--  主行：配方名 · 版本 + 状态胶囊  -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RecipeHeaderStyle}"
                                    Text="{TemplateBinding HeaderText}"
                                    ToolTip="{TemplateBinding HeaderText}" />

                                <Border Grid.Column="1" Style="{StaticResource RecipeStatusPillStyle}">
                                    <TextBlock
                                        Style="{StaticResource RecipeStatusTextStyle}"
                                        Text="{TemplateBinding StatusText}" />
                                </Border>
                            </Grid>

                            <!--  明细列表：滚动条只在真的放不下时出现  -->
                            <ScrollViewer
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    x:Name="DetailList"
                                    ItemTemplate="{StaticResource RecipeLineTemplate}"
                                    ItemsSource="{TemplateBinding Rows}">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,0,2" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </ScrollViewer>

                            <!--  空态 / 未接入提示（空串时收起）  -->
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,6,0,0"
                                Style="{StaticResource RecipeHintStyle}"
                                Text="{TemplateBinding EmptyHint}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
