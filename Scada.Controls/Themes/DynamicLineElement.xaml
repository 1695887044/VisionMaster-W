<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        动态画线：长度/角度/段数都由控件现算成折线，模板只描边。
        Grid 的 Background=Transparent 让整个图元框可命中（线本身只有 2px 宽）。
    -->
    <Style TargetType="{x:Type local:DynamicLineElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DynamicLineElement}">
                    <Grid Background="Transparent">
                        <Path
                            x:Name="DynamicPath"
                            Data="{TemplateBinding DynamicGeometry}"
                            Fill="Transparent"
                            Stroke="{TemplateBinding Stroke}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{TemplateBinding StrokeThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
