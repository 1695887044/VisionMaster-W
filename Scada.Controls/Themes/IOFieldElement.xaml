<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        数值域图元的外观（D9：只读 / 可写 / 编辑中 / 校验失败四态）。

        模板只负责摆放，状态由控件已经算好的只读属性驱动：
          · ValueText     —— 数值 + 单位的最终串（换算在 IOFieldElement.UpdateDisplay）；
          · DisplayBrush  —— 越限/正常时的数值颜色；
          · DisplayStroke —— 校验失败时是 ErrorBrush，否则是用户配的 Stroke；
          · IsEditable    —— 此刻能不能点进输入（模式 + 写通道 + 变量绑定 + 权限）；
          · IsEditing     —— 正在就地编辑。

        四态怎么画（不新增任何契约属性）：
          只读：BorderThickness 0,0,0,1 + 透明底 —— 像表格里的读数；
          可写：1px 边框 + surface 底 + hover 铅笔（铅笔只做提示，不抢命中）；
          编辑：accent 外环（1px 边框 + 3px 焦点环）+ 输入框；
          失败：DisplayStroke 已经变成红色，边框自然变红；红色优先于编辑外环（外环在框外）。

        为什么用 Border 而不是 Rectangle：Border 的描边画在布局框内，视觉外沿等于标注尺寸。
        编辑框与显示块叠在同一格，只翻 Visibility，字体/对齐不会在进入编辑时跳一下。
        显隐仍由控件代码翻（本环境 ControlTemplate.Triggers 里的 DataTrigger 不触发），
        模板里不写 Visibility 初值。

        颜色一律走 ScadaTokens.xaml（本文件 hex=0，R140）；本分册就地合并令牌，
        不依赖 Generic.xaml 的合并顺序（R30：兄弟分册互相看不见）。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="IOFieldBoolToVisibility" />

    <Style TargetType="{x:Type local:IOFieldElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <!-- 只读态：透明底 + 一条底边线 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IOFieldElement}">
                    <Grid>
                        <!-- 编辑中的 3px 焦点环（画在框外，不占内容区） -->
                        <Border
                            x:Name="EditFocusRing"
                            Margin="-4"
                            BorderBrush="{StaticResource HmiAccentBrush}"
                            BorderThickness="3"
                            CornerRadius="9"
                            IsHitTestVisible="False"
                            Opacity="0.28"
                            Visibility="{Binding IsEditing, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IOFieldBoolToVisibility}}" />

                        <!-- 编辑中的 accent 边框 -->
                        <Border
                            x:Name="EditAccentRing"
                            Margin="-1"
                            BorderBrush="{StaticResource HmiAccentBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsEditing, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IOFieldBoolToVisibility}}" />

                        <Border
                            x:Name="FieldFrame"
                            Background="{TemplateBinding Fill}"
                            BorderBrush="{TemplateBinding DisplayStroke}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}"
                            ToolTip="{TemplateBinding EditError}">
                            <Grid Margin="6,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Name="LabelText"
                                    Grid.Column="0"
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Text}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    x:Name="ValueDisplay"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding DisplayBrush}"
                                    Text="{TemplateBinding ValueText}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextTrimming="CharacterEllipsis" />

                                <!--
                                    编辑框：字体/对齐与上面的 TextBlock 逐项对齐，进编辑态字不跳。
                                    Background 用浮起表面（不写半透明十六进制），边框由外层 FieldFrame 提供。
                                -->
                                <TextBox
                                    x:Name="PART_Editor"
                                    Grid.Column="1"
                                    Padding="0"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="{StaticResource HmiSurfaceRaisedBrush}"
                                    BorderThickness="0"
                                    CaretBrush="{TemplateBinding Foreground}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FocusVisualStyle="{StaticResource HmiFocusVisual}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{Binding EditText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="{TemplateBinding TextAlignment}" />
                            </Grid>
                        </Border>

                        <!--
                            可写提示：hover 才出现的铅笔。纯 XAML 矢量图标（不赌字体），
                            不参与命中（IsHitTestVisible=False），因此不会抢走“点框进入编辑”的点击。
                        -->
                        <Border
                            x:Name="PencilPlate"
                            Width="16"
                            Height="16"
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{StaticResource HmiSurfaceRaisedBrush}"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Visibility="{Binding IsEditable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IOFieldBoolToVisibility}}">
                            <Path
                                Width="10"
                                Height="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M3 17h3l8.5-8.5-3-3L3 14z M15.5 3.5l2 2"
                                Stretch="Uniform"
                                Stroke="{StaticResource HmiAccentBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.6" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 可写提示只在鼠标悬停时出现；进入编辑后铅笔退场（输入框要让出焦点） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PencilPlate" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="PencilPlate" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- 可写态：完整 1px 边框 + 6px 圆角（底色仍由用户配置的 Fill 决定，不偷换属性语义） -->
            <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </DataTrigger>

            <!-- 编辑态：完整边框 + 6px 圆角；输入框自己是浮起表面 -->
            <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </DataTrigger>

            <!-- 能改的时候把指针换成文本光标（保留原有语义：只读域不提示可输入） -->
            <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Cursor" Value="IBeam" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
