<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        多态灯图元的外观：灯体（圆/方两种，同一时刻只显示一个）+ 下方一行标签。

        与指示灯模板是同一副骨架，差别只在于灯色从哪来：这里绑的仍是只读的 LampBrush，
        而 LampBrush = State 从四个颜色里挑一个。模板依旧完全不关心状态，
        所以将来状态从 4 个扩到 8 个，这个文件一行都不用改。

        换形状：圆/方两块灯体叠在同一格，由控件代码按 Shape 翻显隐（见 LampElement.UpdateShapeVisibility）。
        不写成模板里的 DataTrigger——本环境下 ControlTemplate.Triggers 里的 DataTrigger 不触发，
        写了也是死代码；同理模板里也不写 Visibility 初值（它的优先级高过触发器 setter）。
    -->
    <Style TargetType="{x:Type local:LampElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LampElement}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="{TemplateBinding Padding}">
                            <Ellipse
                                x:Name="LampCircle"
                                Fill="{TemplateBinding LampBrush}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="{TemplateBinding StrokeThickness}" />

                            <!-- 方形灯：由控件代码按 Shape 换过来 -->
                            <Rectangle
                                x:Name="LampSquare"
                                RadiusX="3"
                                RadiusY="3"
                                Fill="{TemplateBinding LampBrush}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="{TemplateBinding StrokeThickness}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
