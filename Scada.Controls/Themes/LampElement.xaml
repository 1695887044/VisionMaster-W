<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        多态灯图元的外观：灯体（圆/方两种，同一时刻只显示一个）+ 下方一行标签。

        与指示灯模板是同一副骨架，差别只在于灯色从哪来：这里绑的仍是只读的 LampBrush，
        而 LampBrush = State 从四个颜色里挑一个。模板依旧完全不关心状态，
        所以将来状态从 4 个扩到 8 个，这个文件一行都不用改。

        换形状用 DataTrigger（纯模板层的选择，与"什么状态"无关）；
        用 Binding 而不是 TemplateBinding——TemplateBinding 不能出现在触发器的 Binding 位置。
    -->
    <Style TargetType="{x:Type local:LampElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LampElement}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="{TemplateBinding Padding}">
                            <Ellipse
                                x:Name="LampCircle"
                                Fill="{TemplateBinding LampBrush}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="{TemplateBinding StrokeThickness}" />

                            <!-- 方形灯默认隐藏，由 Shape 触发器换过来 -->
                            <Rectangle
                                x:Name="LampSquare"
                                Visibility="Collapsed"
                                RadiusX="3"
                                RadiusY="3"
                                Fill="{TemplateBinding LampBrush}"
                                Stroke="{TemplateBinding Stroke}"
                                StrokeThickness="{TemplateBinding StrokeThickness}" />
                        </Grid>

                        <TextBlock
                            Grid.Row="1"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger
                            Binding="{Binding Shape, RelativeSource={RelativeSource TemplatedParent}}"
                            Value="Square">
                            <Setter TargetName="LampCircle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LampSquare" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
