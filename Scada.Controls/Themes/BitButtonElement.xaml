<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        位按钮图元的外观：带圆角的矩形 + 居中文字 + 悬停提亮层 + 按下压暗层。

        与「按钮」（ButtonElement.xaml）结构相同，只有三处差别，都源于"位按钮是变量的化身"：

        ① 填充/文字/文字色绑的是<b>只读</b>的 DisplayFill / DisplayText / DisplayForeground，
           不是基类的 Fill / Text / Foreground。这三个只读属性是控件代码算出来的
           （= 状态 ? OnFill : OffFill 等），所以模板里一条 DataTrigger 都不用写：
           "怎么算状态"这件事只存在于 C# 一处，XAML 只管把它画出来。

        ② 文字回退：状态文本（状态1/状态0 文字）留空时控件会回落到「文字」，
           这个回退也在 C# 里做完（见 BitButtonElement.PickStateText），模板拿到的就是最终串。

        ③ 多一层按下反馈：IsPressed 是本控件自己的只读依赖属性（不是 ButtonBase 的），
           控件在隧道事件里维护它。这里用"黑色覆盖层压暗"而不是"换填充色"，
           理由和悬停层一样：填充色是用户配的（还可能来自变量绑定），
           我们要的是在它<b>之上</b>叠一层明暗，不去动用户的颜色。

        悬停提亮 0.12 + 按下压暗 0.16 是两条独立触发器，可以同时命中：
        按住不放时两层叠加，视觉上"最暗"，一眼能看出"现在按着的就是它"。
    -->
    <Style TargetType="{x:Type local:BitButtonElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BitButtonElement}">
                    <Grid>
                        <Rectangle
                            Margin="{TemplateBinding Padding}"
                            Fill="{TemplateBinding DisplayFill}"
                            Stroke="{TemplateBinding Stroke}"
                            StrokeThickness="{TemplateBinding StrokeThickness}"
                            RadiusX="{TemplateBinding CornerRadius}"
                            RadiusY="{TemplateBinding CornerRadius}" />

                        <Rectangle
                            x:Name="HoverLayer"
                            Margin="{TemplateBinding Padding}"
                            Fill="White"
                            Opacity="0"
                            RadiusX="{TemplateBinding CornerRadius}"
                            RadiusY="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />

                        <Rectangle
                            x:Name="PressLayer"
                            Margin="{TemplateBinding Padding}"
                            Fill="Black"
                            Opacity="0"
                            RadiusX="{TemplateBinding CornerRadius}"
                            RadiusY="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />

                        <TextBlock
                            Margin="{TemplateBinding Padding}"
                            Text="{TemplateBinding DisplayText}"
                            Foreground="{TemplateBinding DisplayForeground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.12" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressLayer" Property="Opacity" Value="0.16" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
