<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        贝塞尔曲线：四个控制点（0~1 相对坐标）现算成一段三次贝塞尔，模板只描边不填充。
        Grid 的 Background=Transparent 让整个图元框可命中（曲线本身只有 2px 宽）。
    -->
    <Style TargetType="{x:Type local:BezierElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BezierElement}">
                    <Grid Background="Transparent">
                        <Path
                            x:Name="BezierPath"
                            Data="{TemplateBinding BezierGeometry}"
                            Fill="Transparent"
                            Stroke="{TemplateBinding Stroke}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="{TemplateBinding StrokeThickness}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
