<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        实时报警条图元的外观（D10：深色卡片 + 两行式行模板 + 44px 行高）。

        三件事在模板里刻意不做：
        1) 不挑颜色。哪一行该用哪个色由 AlarmBannerElement.RebuildRows() 算好（AlarmBannerRow.ChipBrush），
           模板只管画；模板里挑色就得用转换器 + 跨层 RelativeSource，出错时是“静默显示成默认色”。
        2) 不排序。引擎已按“严重度降序、同级按激活时间降序”排好，这里只负责从上往下画。
        3) 不闪自己。相位是控件从全画面共享节拍源算出的只读属性 BlinkOn；模板不碰它，
           “色条此刻该多亮”由控件代码直接改 AccentBar 的 Opacity（见 UpdateBannerLayout）。

        行模板是两行式：第一行报警名，第二行条件/触发值；右侧时间与状态靠右。
        严重度胶囊用“描边 + 同色文字”（不用实心底 + 白字）：严重度色配浅时白字会糊成一片。

        颜色一律走 ScadaTokens.xaml（本文件 hex=0，R140）；本分册就地合并令牌（R30）。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="AlarmEmptyStateStyle" TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasAlarms, RelativeSource={RelativeSource AncestorType=local:AlarmBannerElement}}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:AlarmBannerElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AlarmBannerElement}">
                    <Grid>
                        <!-- 深色卡片底：Fill 未配置时（直接 new 控件）也能得到运行画面的表面色 -->
                        <Border
                            Background="{StaticResource HmiSurfaceBrush}"
                            BorderBrush="{StaticResource HmiBorderBrush}"
                            BorderThickness="{TemplateBinding StrokeThickness}"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}" />

                        <!-- 用户配置的 Fill/Stroke 叠在令牌底之上：不改变既有属性语义 -->
                        <Border
                            x:Name="BannerFrame"
                            Background="{TemplateBinding Fill}"
                            BorderBrush="{TemplateBinding Stroke}"
                            BorderThickness="{TemplateBinding StrokeThickness}"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}" />

                        <!-- 左侧严重度色条：3px，圆角跟底框走；闪烁就是这一层的 Opacity 在 1/0.25 间切换 -->
                        <Border
                            x:Name="AccentBar"
                            BorderBrush="{TemplateBinding AccentBrush}"
                            BorderThickness="3,0,0,0"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}"
                            IsHitTestVisible="False" />

                        <Border
                            Margin="{TemplateBinding Padding}"
                            Padding="12,10,10,10"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 表头：标题 + 未确认计数 -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Text="{TemplateBinding Text}"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource HmiTextMutedBrush}"
                                        Text="{TemplateBinding SummaryText}" />
                                </Grid>

                                <Rectangle
                                    Grid.Row="1"
                                    Height="1"
                                    Margin="0,0,0,6"
                                    Fill="{StaticResource HmiBorderBrush}" />

                                <Grid Grid.Row="2">
                                    <ScrollViewer
                                        x:Name="ListScroll"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto"
                                        Focusable="False">
                                        <ItemsControl
                                            HorizontalContentAlignment="Stretch"
                                            ItemsSource="{TemplateBinding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 一行 = 44px 卡片；两行文字，右侧时间/状态靠右 -->
                                                    <Border
                                                        x:Name="RowRoot"
                                                        Height="44"
                                                        Margin="0,0,0,3"
                                                        Padding="6,2"
                                                        Background="{StaticResource HmiSurfaceRaisedBrush}"
                                                        CornerRadius="4"
                                                        ToolTip="{Binding HelpText}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 严重度胶囊：描边 + 同色文字，任何严重度色都读得清 -->
                                                            <Border
                                                                Grid.Column="0"
                                                                Margin="0,4,8,0"
                                                                Padding="6,1"
                                                                VerticalAlignment="Top"
                                                                BorderBrush="{Binding ChipBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="9">
                                                                <TextBlock
                                                                    FontSize="10.5"
                                                                    Foreground="{Binding ChipBrush}"
                                                                    Text="{Binding SeverityText}" />
                                                            </Border>

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                Margin="0,1,8,0"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:AlarmBannerElement}}"
                                                                    FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=local:AlarmBannerElement}}"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <!-- 条件 + 触发值：现场看到报警名后第一句追问永远是“报的时候是多少” -->
                                                                <TextBlock
                                                                    Margin="0,1,0,0"
                                                                    FontSize="11.5"
                                                                    FontWeight="Normal"
                                                                    Foreground="{StaticResource HmiTextSecondaryBrush}"
                                                                    Text="{Binding Detail}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <StackPanel
                                                                Grid.Column="2"
                                                                Margin="0,3,0,0"
                                                                HorizontalAlignment="Right">
                                                                <TextBlock
                                                                    HorizontalAlignment="Right"
                                                                    FontFamily="Consolas, Cascadia Mono"
                                                                    FontSize="10.5"
                                                                    Foreground="{StaticResource HmiTextMutedBrush}"
                                                                    Text="{Binding TimeText}" />
                                                                <TextBlock
                                                                    Margin="0,1,0,0"
                                                                    HorizontalAlignment="Right"
                                                                    FontSize="10.5"
                                                                    Foreground="{StaticResource HmiTextSecondaryBrush}"
                                                                    Text="{Binding StateText}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <DataTemplate.Triggers>
                                                        <!-- 已确认行淡化：报警还在，只是有人认领了 -->
                                                        <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                                            <Setter TargetName="RowRoot" Property="Opacity" Value="0.5" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HelpText}" Value="">
                                                            <Setter TargetName="RowRoot" Property="ToolTip" Value="{x:Null}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- 空态：设计期预览与“一切正常”时显示；列表与空态由 HasAlarms 互斥 -->
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Style="{StaticResource AlarmEmptyStateStyle}">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Data="M2 8l4 4 8-8"
                                            Stretch="Uniform"
                                            Stroke="{StaticResource HmiSuccessBrush}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="2" />
                                        <TextBlock
                                            x:Name="EmptyHint"
                                            VerticalAlignment="Center"
                                            FontSize="12.5"
                                            Foreground="{StaticResource HmiTextSecondaryBrush}"
                                            Text="{TemplateBinding EmptyText}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
