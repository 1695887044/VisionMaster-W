<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        状态显示 / 状态操作图元（Hmi.StateView）的默认外观。
        一个模板覆盖三个预设：Text（字指示灯）、Image（图形 IO）、Both（图文）；
        Interaction 只影响代码里的可点击判定，不改变模板结构。
        令牌就地合并（R30），颜色全部走 ScadaTokens（本文件 hex=0，R140）。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="StateViewBoolToVisibility" />

    <Style TargetType="{x:Type local:StateViewElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StateViewElement}">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}"
                        SnapsToDevicePixels="True"
                        ToolTip="{TemplateBinding WriteError}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <StackPanel
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Orientation="Horizontal">

                                <Grid
                                    x:Name="ImageHost"
                                    Width="44"
                                    Height="44"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding ShowImage, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateViewBoolToVisibility}}">
                                    <Image
                                        Source="{TemplateBinding CurrentImage}"
                                        Stretch="{TemplateBinding CurrentStretch}"
                                        SnapsToDevicePixels="True" />
                                    <Border
                                        x:Name="ImagePlaceholder"
                                        Background="{StaticResource HmiTrackBrush}"
                                        BorderBrush="{StaticResource HmiBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding ImageMissing, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateViewBoolToVisibility}}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{StaticResource HmiTextMutedBrush}"
                                            Text="无图" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    x:Name="Label"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding CurrentColor}"
                                    Text="{TemplateBinding CurrentText}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding ShowText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StateViewBoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="StateListMissing" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HmiWarningBrush}" />
                        </Trigger>
                        <Trigger Property="CanOperate" Value="True">
                            <Setter TargetName="Chrome" Property="Cursor" Value="Hand" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HmiAccentBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
