<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        KPI 看板图元的外观（Hmi.KpiBoard）。

        四格“数值 + 标签 + 单位”用 UniformGrid 排：
          · Columns 绑 EffectiveColumns（控件已把 2~4 收敛好；模板不直接绑原始 Columns）；
          · 2 列 → 2×2；3 列 → 3+1；4 列 → 4×1，四格始终等宽等高。
        数值 20 / 标签 11.5 / 单位 10.5，数字用等宽字体（tabular 的视觉等价物）。

        颜色一律走 ScadaTokens.xaml（本文件 hex=0，R140）；本分册就地合并令牌（R30）。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="KpiTitleStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="KpiCellStyle" TargetType="Border">
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{StaticResource HmiSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HmiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style TargetType="{x:Type local:KpiBoardElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource HmiTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei" />
        <Setter Property="FontSize" Value="12" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:KpiBoardElement}">
                    <Border
                        x:Name="KpiFrame"
                        Background="{TemplateBinding Fill}"
                        BorderBrush="{TemplateBinding Stroke}"
                        BorderThickness="{TemplateBinding StrokeThickness}"
                        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="12,8,12,0"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{TemplateBinding Foreground}"
                                Style="{StaticResource KpiTitleStyle}"
                                Text="{TemplateBinding Text}"
                                TextTrimming="CharacterEllipsis" />

                            <UniformGrid
                                Grid.Row="1"
                                Margin="4"
                                Columns="{TemplateBinding EffectiveColumns}"
                                Rows="0">

                            <!--  第 1 格  -->
                            <Border Style="{StaticResource KpiCellStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{StaticResource HmiTextMutedBrush}"
                                        Text="{TemplateBinding Label1}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            StretchDirection="DownOnly">
                                            <TextBlock
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="{TemplateBinding Value1}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Viewbox>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="4,0,0,2"
                                            VerticalAlignment="Bottom"
                                            FontSize="10.5"
                                            Foreground="{StaticResource HmiTextMutedBrush}"
                                            Text="{TemplateBinding Unit1}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  第 2 格  -->
                            <Border Style="{StaticResource KpiCellStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{StaticResource HmiTextMutedBrush}"
                                        Text="{TemplateBinding Label2}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            StretchDirection="DownOnly">
                                            <TextBlock
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="{TemplateBinding Value2}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Viewbox>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="4,0,0,2"
                                            VerticalAlignment="Bottom"
                                            FontSize="10.5"
                                            Foreground="{StaticResource HmiTextMutedBrush}"
                                            Text="{TemplateBinding Unit2}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  第 3 格  -->
                            <Border Style="{StaticResource KpiCellStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{StaticResource HmiTextMutedBrush}"
                                        Text="{TemplateBinding Label3}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            StretchDirection="DownOnly">
                                            <TextBlock
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="{TemplateBinding Value3}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Viewbox>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="4,0,0,2"
                                            VerticalAlignment="Bottom"
                                            FontSize="10.5"
                                            Foreground="{StaticResource HmiTextMutedBrush}"
                                            Text="{TemplateBinding Unit3}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  第 4 格  -->
                            <Border Style="{StaticResource KpiCellStyle}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{StaticResource HmiTextMutedBrush}"
                                        Text="{TemplateBinding Label4}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform"
                                            StretchDirection="DownOnly">
                                            <TextBlock
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{TemplateBinding Foreground}"
                                                Text="{TemplateBinding Value4}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Viewbox>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="4,0,0,2"
                                            VerticalAlignment="Bottom"
                                            FontSize="10.5"
                                            Foreground="{StaticResource HmiTextMutedBrush}"
                                            Text="{TemplateBinding Unit4}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
