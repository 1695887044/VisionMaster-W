<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <!--
        泵图元的外观：泵壳（内接圆）+ 叶轮（尖角朝右的内接等边三角形）+ 底下一行位号。

        模板里<b>一个算术都没有</b>：
          · 泵壳 Data 绑只读几何 BodyGeometry；
          · 叶轮 Data 绑只读几何 ImpellerGeometry，颜色绑只读的 StateBrush（由状态从三个颜色里挑一个）；
          · 位号绑基类的 Text。
        所有"圆心、半径、三角顶点、内缩量"的换算都在控件代码里（见 PumpElement.UpdatePump）——
        与阀门绑 ValveGeometry、表盘绑 NeedleGeometry、棒图绑 FillLength 是同一条纪律：
        外观由输入推导，推导只写一遍，模板只负责摆放。

        为什么叶轮不是 Ellipse / Polygon 这类形状元素直接拼：
        两个几何量都随控件缩放，且"外沿要落在标注尺寸上"要求内缩半个线宽——
        内缩量在 StrokeThickness 变化时也要跟着变（见 OnElementRefreshed）。
        算在代码里就只有一份半径账，模板永远不需要知道线宽是多少。

        图层次序（同一个 Grid 里从下往上）：泵壳 → 叶轮 → 位号。
        泵壳这一条 Path 同时担了"填充"和"描边"两件事（Fill 是壳底色，Stroke 是壳轮廓）：
        圆是凸形、叶轮整个含在圆里，不存在阀门那种"填充按矩形裁、边缘压在轮廓线上"的问题，
        所以不必像阀门那样再单独拉一条 Outline 出来画描边。

        为什么位号贴在底边而不是压在圆里：
        泵壳是整圆，圆的下缘只剩一条越来越窄的缝，文字压上去会"骑"在圆弧上。
        控件代码预留了底下四分之一当标签行（见 PumpElement.LabelRatio），模板这边只管贴底摆。
        文字用 CharacterEllipsis 收尾：位号超长时截断，而不是把图形顶变形。
    -->
    <Style TargetType="{x:Type local:PumpElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PumpElement}">
                    <Grid>
                        <!-- 泵壳：Fill 是壳底色，Stroke 是壳轮廓。几何量已按半线宽内缩，外沿落在标注尺寸上 -->
                        <Path
                            x:Name="Body"
                            Data="{TemplateBinding BodyGeometry}"
                            Fill="{TemplateBinding TrackColor}"
                            Stroke="{TemplateBinding Stroke}"
                            StrokeThickness="{TemplateBinding StrokeThickness}" />

                        <!-- 叶轮：颜色由状态推导（StateBrush），模板完全不关心状态有几个值 -->
                        <Path
                            x:Name="Impeller"
                            Data="{TemplateBinding ImpellerGeometry}"
                            Fill="{TemplateBinding StateBrush}" />

                        <!-- 位号：贴在预留的底边上，与泵壳不重叠 -->
                        <TextBlock
                            x:Name="TagLabel"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
