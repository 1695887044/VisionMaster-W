<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Scada.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/VM.Scada.Controls;component/Themes/ScadaTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        GIF 动图图元：底框 + 图像本体 + 未设置/缺失时的占位。

        与 PictureElement 同一版式（占位框也同一套令牌），差别只有一处：
        图像源由控件按帧序写入（见 GifElement.ShowCurrentFrame），模板里不绑 Source。
    -->
    <Style TargetType="{x:Type local:GifElement}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:GifElement}">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Fill}"
                            BorderBrush="{TemplateBinding Stroke}"
                            BorderThickness="{TemplateBinding StrokeThickness}"
                            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToCornerRadius}}" />

                        <Image
                            x:Name="ImageHost"
                            Margin="{TemplateBinding Padding}"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Stretch="{TemplateBinding Stretch}" />

                        <Border
                            x:Name="Placeholder"
                            Margin="4"
                            Padding="8"
                            Background="{StaticResource HmiSurfaceBrush}"
                            BorderBrush="{StaticResource HmiBorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{StaticResource HmiTextMutedBrush}"
                                Text="{TemplateBinding PlaceholderText}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
