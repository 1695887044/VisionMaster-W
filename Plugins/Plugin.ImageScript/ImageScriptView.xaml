<UserControl
    x:Class="Plugin.ImageScript.ImageScriptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.ImageScript"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="620"
    d:DesignWidth="1080"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:InputPortConverter x:Key="InputPortConv" />

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E5E5E5" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect
                            BlurRadius="12"
                            Direction="270"
                            Opacity="0.05"
                            ShadowDepth="2"
                            Color="Black" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#1F1F1F" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#888888" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左列：过程管理 + 变量声明 + 输入连线  -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,8,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  卡片：过程管理  -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="脚本过程" />

                        <TextBlock
                            Margin="0,8,0,2"
                            Style="{StaticResource HintText}"
                            Text="编辑目标（修改其过程体）" />
                        <ComboBox
                            x:Name="EditProcCombo"
                            Height="26"
                            HorizontalContentAlignment="Center"
                            SelectionChanged="EditProcCombo_SelectionChanged" />

                        <TextBlock
                            Margin="0,8,0,2"
                            Style="{StaticResource HintText}"
                            Text="运行过程（执行时调用的过程）" />
                        <ComboBox
                            x:Name="RunProcCombo"
                            Height="26"
                            HorizontalContentAlignment="Center"
                            SelectionChanged="RunProcCombo_SelectionChanged" />

                        <WrapPanel Margin="0,10,0,0">
                            <Button
                                MinWidth="60"
                                Margin="0,0,6,6"
                                Click="NewProc_Click"
                                Content="新建过程" />
                            <Button
                                MinWidth="60"
                                Margin="0,0,6,6"
                                Click="DeleteProc_Click"
                                Content="删除过程" />
                            <Button
                                MinWidth="60"
                                Margin="0,0,6,6"
                                Click="Import_Click"
                                Content="导入.hdev" />
                            <Button
                                MinWidth="60"
                                Margin="0,0,6,6"
                                Click="Export_Click"
                                Content="导出.hdev" />
                            <Button
                                MinWidth="60"
                                Margin="0,0,6,6"
                                Click="SyncVars_Click"
                                Content="同步接口变量" />
                            <Button
                                MinWidth="60"
                                Margin="0,0,6,6"
                                Click="RestoreDefault_Click"
                                Content="恢复默认脚本"
                                ToolTip="用插件自带的默认脚本（1 个图像进 → 1 个图像出 + OK/NG 结论）替换当前全部过程" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!--  卡片：输入变量（声明类型 + 连线/手填）  -->
                <Border
                    Margin="0,8,0,0"
                    Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="输入变量" />
                        <TextBlock
                            Margin="0,2,0,6"
                            Style="{StaticResource HintText}"
                            Text="类型决定运行时传参方式；连线取上游值，未连线时按类型手填" />
                        <ItemsControl x:Name="InputList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Name}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Height="24"
                                            Margin="6,0"
                                            VerticalContentAlignment="Center"
                                            ItemStringFormat="{}{0}"
                                            ItemsSource="{Binding DataContext.ScriptVarTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            SelectedItem="{Binding Type}"
                                            ToolTip="声明类型" />
                                        <cv:LinkableValueEditor
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            StepData="{Binding DataContext.StepData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <cv:LinkableValueEditor.Port>
                                                <MultiBinding Converter="{StaticResource InputPortConv}">
                                                    <Binding Path="Name" />
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <!--  PortsVersion：端口重建锚点，插件 Rebuild 端口后经此通知自动重取新端口  -->
                                                    <Binding
                                                        Path="DataContext.PortsVersion"
                                                        RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </cv:LinkableValueEditor.Port>
                                        </cv:LinkableValueEditor>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="InputEmptyHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource HintText}"
                            Text="（无输入变量：导入脚本或点“同步接口变量”）" />
                    </StackPanel>
                </Border>

                <!--  卡片：输出变量  -->
                <Border
                    Margin="0,8,0,0"
                    Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="输出变量" />
                        <TextBlock
                            Margin="0,2,0,6"
                            Style="{StaticResource HintText}"
                            Text="输出端口供下游步骤连线；类型须与脚本产出一致" />
                        <ItemsControl x:Name="OutputList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Name}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Height="24"
                                            Margin="4,0"
                                            VerticalContentAlignment="Center"
                                            ItemsSource="{Binding DataContext.ScriptVarTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            SelectedItem="{Binding Type}"
                                            ToolTip="声明类型" />
                                        <!--  图形类输出（HImage/HRegion/HXld/HObject）都有"显示到窗口"下拉  -->
                                        <ComboBox
                                            Grid.Column="2"
                                            Height="24"
                                            VerticalContentAlignment="Center"
                                            SelectedIndex="{Binding DisplayWindow}"
                                            ToolTip="把该图形结果显示到主界面第几号视图窗口（Region/轮廓叠加画在输入图像上）">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIconic}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                            <ComboBoxItem Content="不显示" />
                                            <ComboBoxItem Content="窗口1" />
                                            <ComboBoxItem Content="窗口2" />
                                            <ComboBoxItem Content="窗口3" />
                                            <ComboBoxItem Content="窗口4" />
                                            <ComboBoxItem Content="窗口5" />
                                            <ComboBoxItem Content="窗口6" />
                                            <ComboBoxItem Content="窗口7" />
                                            <ComboBoxItem Content="窗口8" />
                                            <ComboBoxItem Content="窗口9" />
                                        </ComboBox>
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#888888"
                                            Text="{Binding Remark}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="OutputEmptyHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource HintText}"
                            Text="（无输出变量）" />
                    </StackPanel>
                </Border>

                <!--  结果显示：已改为每个 HImage 输出行旁的"窗口N"下拉（逐输出控制）  -->
            </StackPanel>
        </ScrollViewer>

        <!--  右列：Halcon 脚本编辑器  -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
            <DockPanel>
                <TextBlock
                    x:Name="EditorTitle"
                    DockPanel.Dock="Top"
                    Margin="2,0,0,8"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#666666"
                    Text="（未选择过程）" />
                <TextBlock
                    x:Name="ValidateResultText"
                    DockPanel.Dock="Bottom"
                    Margin="2,8,0,0"
                    FontSize="12"
                    Text="{Binding ValidationResult}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    ToolTip="编辑器右键菜单「编译」的结果" />
                <avalon:TextEditor
                    x:Name="Editor"
                    FontFamily="Consolas"
                    FontSize="14"
                    ShowLineNumbers="True"
                    TextChanged="Editor_TextChanged" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
