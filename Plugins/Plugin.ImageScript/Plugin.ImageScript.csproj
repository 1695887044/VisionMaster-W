<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>Plugin.ImageScript</RootNamespace>
    <AssemblyName>Plugin.ImageScript</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      插件自带帮助手册：编进本程序集（宿主 HelpCatalogService 按 "<程序集名>.Help." 前缀约定发现，
      文件名顺序即手册页序，页标题取正文第一个一级标题）。
      为什么走内嵌资源而不是随目录投放：插件 DLL 由构建约定统一投递到 Modules\，
      手册跟着 DLL 走就不会出现"换了台机器手册没拷过去"。
      改手册 = 重建本插件工程（与原代码改动同一口径）。
    -->
    <EmbeddedResource Include="Help\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Services\Core.Halcon\Core.Halcon.csproj" />
    <ProjectReference Include="..\..\Shard\Core.Controls\Core.Controls.csproj" />
    <ProjectReference Include="..\..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
    <ProjectReference Include="..\..\UI\Controls\UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>..\..\DLL\Halcon\halcondotnet.dll</HintPath>
    </Reference>
    <Reference Include="hdevenginedotnet">
      <HintPath>..\..\DLL\Halcon\hdevenginedotnet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- 插件私有依赖与运行期资源投递（插件自身 DLL 的投递已由 Plugins\Directory.Build.targets 统一处理） -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!-- 仅部署插件专属依赖 hdevenginedotnet（主程序目录无此件）；halcondotnet 由主程序目录提供，勿拷入 Modules 以免类型标识冲突 -->
    <Exec Command="copy $(TargetDir)hdevenginedotnet.dll $(ModulesDir)hdevenginedotnet.dll /Y" />
    <!-- 示例代码资源（Halcon 官方例程图片+OCR模型+自定义过程）→ 宿主运行目录，供"插入示例代码"直接引用 -->
    <!-- 目标必须是 $(Configuration) 而非写死 Debug：images 尚有 HALCON 自带资源目录兜底，
         而 procedures\publish_preview.hdvp 没有兜底——漏拷会表现为"unresolved procedure call"，极难定位 -->
    <Exec Command="xcopy &quot;$(ProjectDir)ScriptAssets&quot; &quot;$(HostBinDir)ScriptAssets\&quot; /E /I /Y /Q" />
  </Target>
</Project>
