<UserControl
    x:Class="Plugin.Yolo.YoloView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.Yolo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="560"
    MinHeight="280"
    d:DesignHeight="620"
    d:DesignWidth="980"
    mc:Ignorable="d">

    <!--
        YOLO 目标检测的配置视图（Web 化 v1）。

        两栏：左侧配置轨（图像输入 → 检测模型 → 检测参数 → 高级参数 → 试算），右侧只读预览工作区。
        本节点检测整幅图、不吃 ROI，所以预览用只读的 ImageReadOnly，不给框选能力。

        契约保留：
          · DataContext = YoloPlugin（宿主靠它取 IPluginConfigView.OnConfirm）；
          · LinkableValueEditor：Image 端口的 Port / StepData；
          · ImageReadOnly：DisplayImage（ContentControl + DataTemplate，有图才创建）；
          · ModelPath 与 6 个 [StepConfig] 检测参数绑定；
          · Hint / ResultSummary / ModelSummary 原样消费。
        本插件没有 Mode / SelectedItem / StatusLevel，本视图不伪造这些属性。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:ModelFileNameConverter x:Key="ModelFileNameConverter" />

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="InfoCardStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            </Style>

            <Style x:Key="InfoHeadStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
            </Style>

            <Style x:Key="MonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <Style x:Key="NumericBoxStyle" BasedOn="{StaticResource DialogInput}" TargetType="TextBox">
                <Setter Property="Width" Value="118" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <Style x:Key="ResultCardStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,9,0,0" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static local:YoloPreviewState.Error}">
                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static local:YoloPreviewState.Empty}">
                        <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResultTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static local:YoloPreviewState.Error}">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static local:YoloPreviewState.Empty}">
                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,0,13" />
                <Setter Property="Background" Value="{StaticResource PluginPreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PluginPreviewBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateSubStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="MaxWidth" Value="340" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static local:YoloPreviewState.Error}">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusPathStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左配置轨（1*，300~356）+ 右预览工作区（1.6*）。
        960 宿主内容区约 920 → 左 354 / 右 550；640 宿主内容区约 600 → 左 300 / 右 284。
        所有颜色走 UI 公共令牌，视图内不写十六进制。
    -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="356" />
            <ColumnDefinition Width="1.6*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：配置轨 ================= -->
        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="14"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                        <!--  ── 图像输入：配置窗口内直接链接上游，不必回画布拖线  ──  -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="图像输入" />
                        <TextBlock
                            Margin="0,9,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="输入图像" />
                        <cv:LinkableValueEditor
                            Label=""
                            Port="{Binding Image}"
                            StepData="{Binding StepData}" />
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="在配置窗口内点 🔗 绑定上游端口或变量；也可点宿主「执行」把上游图带进来。本节点检测整幅图，不需要 ROI。" />

                        <!--  ── 检测模型 ──  -->
                        <TextBlock
                            Margin="0,16,0,0"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="检测模型" />
                        <TextBlock
                            Margin="0,9,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="模型路径" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Height="36"
                                FontFamily="Consolas"
                                FontSize="11.5"
                                Style="{StaticResource DialogInput}"
                                Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="支持绝对路径或相对宿主程序目录的路径；只支持 .onnx 目标检测模型" />
                                </TextBox.ToolTip>
                            </TextBox>
                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource LocalButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="13"
                                        Text="&#xf07c;" />
                                    <TextBlock VerticalAlignment="Center" Text="浏览" />
                                </StackPanel>
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="选择 ONNX 检测模型" />
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="支持相对路径（相对宿主程序目录），换机器部署时不用改配置。" />

                        <Border Style="{StaticResource InfoCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="&#xf2db;" />
                                    <TextBlock Style="{StaticResource InfoHeadStyle}" Text="模型信息（只读）" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource MonoTextStyle}"
                                    Text="{Binding ModelSummary}" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="只支持「目标检测」模型。分割 / 姿态 / 分类模型的输出格式不同，会被明确拒绝（不会拿错格式硬算）。" />

                        <!--  ── 检测参数 ──  -->
                        <TextBlock
                            Margin="0,16,0,0"
                            Style="{StaticResource SectionHeaderStyle}"
                            Text="检测参数" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="置信度阈值（0~1）" />
                            <TextBox
                                Grid.Column="1"
                                Style="{StaticResource NumericBoxStyle}"
                                Text="{Binding ConfidenceThreshold}">
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="低于它的候选直接丢弃。调高会减少误检、调低会减少漏检。默认 0.25。" />
                                </TextBox.ToolTip>
                            </TextBox>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="低于它的候选直接丢弃。调高会减少误检、调低会减少漏检。默认 0.25。" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="NMS 重叠阈值（0~1）" />
                            <TextBox
                                Grid.Column="1"
                                Style="{StaticResource NumericBoxStyle}"
                                Text="{Binding NmsIoU}">
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="同类框重叠超过它就只留置信度高的那个。默认 0.45；按类别分别做。" />
                                </TextBox.ToolTip>
                            </TextBox>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="同类框重叠超过它就只留置信度高的那个。默认 0.45；按类别分别做，异类重叠不会被压制。" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="最多保留目标数（0 = 不限）" />
                            <TextBox
                                Grid.Column="1"
                                Style="{StaticResource NumericBoxStyle}"
                                Text="{Binding MaxDetections}">
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="按置信度排序后截断，避免异常图上刷出成千上万个框。0 = 不限。" />
                                </TextBox.ToolTip>
                            </TextBox>
                        </Grid>
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="按置信度排序后截断，避免异常图上刷出成千上万个框。0 = 不限。" />

                        <!--  ── 高级参数（折叠）  ──  -->
                        <Border
                            Margin="0,16,0,0"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PluginCardCornerRadius}">
                            <Expander
                                Padding="10"
                                Header="高级参数（多数场景不用动）"
                                IsExpanded="False">
                                <StackPanel Margin="0,2,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="输入尺寸（0 = 模型自带）" />
                                        <TextBox
                                            Grid.Column="1"
                                            Style="{StaticResource NumericBoxStyle}"
                                            Text="{Binding InputSize}">
                                            <TextBox.ToolTip>
                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="letterbox 的目标边长。模型元数据里有静态尺寸时留 0 即可；动态形状才需要手填（常见 640）。" />
                                            </TextBox.ToolTip>
                                        </TextBox>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="letterbox 的目标边长。模型元数据里有静态尺寸时留 0 即可；动态形状才需要手填（常见 640）。" />

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="类别过滤（如 0,2；留空 = 全部）" />
                                    <TextBox
                                        Height="36"
                                        Style="{StaticResource DialogInput}"
                                        Text="{Binding ClassFilterText}">
                                        <TextBox.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="只保留指定类别索引的目标；填错会明确报错，不会静默当成不过滤。" />
                                        </TextBox.ToolTip>
                                    </TextBox>
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="只保留指定类别索引的目标。填错会明确报错，不会静默当成不过滤。" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="裁剪边距（像素）" />
                                        <TextBox
                                            Grid.Column="1"
                                            Style="{StaticResource NumericBoxStyle}"
                                            Text="{Binding CropMargin}">
                                            <TextBox.ToolTip>
                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="「最佳目标裁剪图」向外扩张的边距。0 = 用检测框原样裁剪。" />
                                            </TextBox.ToolTip>
                                        </TextBox>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="「最佳目标裁剪图」向外扩张的边距。下游要做精细测量时给几像素余量，避免把目标边缘切掉。" />
                                </StackPanel>
                            </Expander>
                        </Border>
                        <!-- 试算：随左栏滚动，避免固定卡占掉表单可视高度 -->
                        <Border
                            Margin="0,16,0,0"
                            Padding="0,12,0,0"
                    BorderBrush="{StaticResource DialogBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="试算" />
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="图像来自上方「图像输入」：链接上游输出、或手动指定一张图；绑定后点「执行」跑一遍，图会自动显示进来。" />
                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding TryDetectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource LocalPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="12"
                                    Text="&#xf04b;" />
                                <TextBlock VerticalAlignment="Center" Text="试算一下" />
                            </StackPanel>
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="用当前图像跑一遍检测，把结论写到下方结果卡；与运行期共用同一套检测逻辑" />
                            </Button.ToolTip>
                        </Button>
                        <Border MaxHeight="120" Style="{StaticResource ResultCardStyle}">
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock Style="{StaticResource ResultTextStyle}" Text="{Binding ResultSummary}" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= 右：预览工作区 ================= -->
        <Border
            Grid.Column="1"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!-- 预览头：模型文件名 + 只读标签 + 工具条 -->
                <Grid Grid.Row="0" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="&#xf1c5;" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        MaxWidth="150"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding ModelPath, Converter={StaticResource ModelFileNameConverter}}"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.ToolTip>
                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding ModelPath}" />
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="上游图像 · 只读" />
                    <StackPanel
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="FitWindow_Click"
                            Content="&#xf065;">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="适应窗口" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Margin="2,0,0,0"
                            Style="{StaticResource ToolbarTextButtonStyle}"
                            Click="FitImage_Click"
                            Content="1:1">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="实际像素 1:1" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 画布：ImageReadOnly 保留；无图时显示空态/错误态 -->
                <Border Grid.Row="1" Background="{StaticResource PluginPreviewCanvasBrush}">
                    <Grid>
                        <!--
                            有图才创建 ImageReadOnly：控件在“无图”时根本不在可视树里，
                            避免“折叠状态下收到 HImage、再显示不重绘”的时序问题（打开图片不刷新）。
                            控件类型、HImage 绑定与 HALCON 交互都保留，只是由 ContentTemplate 承载。
                        -->
                        <ContentControl
                            x:Name="PreviewHost"
                            Focusable="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding DisplayImage}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <h:ImageReadOnly
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HImage="{Binding Mode=OneWay}" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- 只读角标：有图时显示 -->
                        <Border
                            Margin="10"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{StaticResource DialogTextPrimaryBrush}"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <!-- 没有图 / 模型失败 / 预览失败时都不该出现"只读预览"角标 -->
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ModelState}" Value="{x:Static local:YoloModelState.Failed}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static local:YoloPreviewState.Error}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogSurfaceBrush}"
                                Text="只读预览" />
                        </Border>

                        <!-- 空态：无图且没有模型级/预览级错误 -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ModelState}" Value="{x:Static local:YoloModelState.Failed}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static local:YoloPreviewState.Error}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid
                                MaxWidth="430"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Rectangle
                                    Fill="{StaticResource PluginPreviewSurfaceBrush}"
                                    Opacity="0.55"
                                    RadiusX="14"
                                    RadiusY="14"
                                    Stroke="{StaticResource PluginPreviewBorderBrush}"
                                    StrokeDashArray="3,3" />
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource EmptyStateIconStyle}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="20"
                                            Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                            Text="&#xf03e;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="等待图像输入" />
                                    <TextBlock Style="{StaticResource EmptyStateSubStyle}" Text="在左侧「图像输入」点 🔗 绑定上游端口或变量；也可以点宿主底部的「执行」把上游图带进来。本节点检测整幅图，不需要 ROI。" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 错误态：模型加载失败，或最近一次试算失败（状态契约，不看中文文案） -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModelState}" Value="{x:Static local:YoloModelState.Failed}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewState}" Value="{x:Static local:YoloPreviewState.Error}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel
                                MaxWidth="430"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border
                                    Width="46"
                                    Height="46"
                                    Margin="0,0,0,13"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource DialogDangerSubtleBrush}"
                                    BorderBrush="{StaticResource DialogDangerBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="20"
                                        Foreground="{StaticResource DialogDangerBrush}"
                                        Text="&#xf071;" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogDangerBrush}"
                                    Text="无法加载预览" />
                                <TextBlock
                                    MaxWidth="360"
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                    Text="请检查左侧「检测模型」的路径与任务类型（只支持 detect）。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    MaxWidth="360"
                                    Style="{StaticResource MonoTextStyle}"
                                    Text="{Binding ModelSummary}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 状态栏：Hint 原文（本插件没有 StatusLevel，不伪造档位） -->
                <Border
                    Grid.Row="2"
                    Padding="12,0"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="&#xf05a;" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource StatusTextStyle}"
                            Text="{Binding Hint}">
                            <TextBlock.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding Hint}" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock
                            Grid.Column="2"
                            MaxWidth="160"
                            Margin="12,0,0,0"
                            Style="{StaticResource StatusPathStyle}"
                            Text="{Binding ModelPath}">
                            <TextBlock.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding ModelPath}" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
