<UserControl
    x:Class="Plugin.DataRecord.DataRecordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.DataRecord"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.UI.com/ui"
    d:DesignHeight="680"
    d:DesignWidth="960"
    MinWidth="560"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:InputPortConverter x:Key="InputPortConv" />
            <local:CnEnumLabelConverter x:Key="CnEnum" />
            <local:SourceToVisibilityConverter x:Key="SourceVis" />
            <local:NotOffToVisibilityConverter x:Key="NotOffVis" />
            <local:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
            <local:TestResultStateConverter x:Key="TestResultState" />
            <local:TestResultDisplayConverter x:Key="TestResultDisplay" />
            <local:TestResultIconConverter x:Key="TestResultIcon" />

            <!--
                列行内的端口编辑器：只有 Source=Port 时才由 ContentControl 实例化。
                为什么按需创建而不是常驻 + Visibility：
                非端口行没有动态端口（GetInputPort 返回 null），常驻会让 LinkableValueEditor.Port 为 null，
                批量冒烟与运行期都会留下一个“空端口编辑器”；
                端口对象由 RebuildDynamicInputs 重建后，靠 PortsVersion 这个 MultiBinding 锚点重新取。
            -->
            <DataTemplate x:Key="ColumnPortEditorTemplate">
                <cv:LinkableValueEditor
                    VerticalAlignment="Center"
                    Label=""
                    StepData="{Binding DataContext.StepData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <cv:LinkableValueEditor.Port>
                        <MultiBinding Converter="{StaticResource InputPortConv}">
                            <Binding Path="Name" />
                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="DataContext.PortsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </cv:LinkableValueEditor.Port>
                </cv:LinkableValueEditor>
            </DataTemplate>

            <!--
                图片源端口编辑器：只有 ImageSaveMode != Off 时才创建。
                “图片”端口由 RebuildDynamicInputs 按记录方式增删，PortsVersion 是重取锚点。
            -->
            <DataTemplate x:Key="ImagePortEditorTemplate">
                <cv:LinkableValueEditor
                    VerticalAlignment="Center"
                    Label=""
                    StepData="{Binding StepData}">
                    <cv:LinkableValueEditor.Port>
                        <MultiBinding Converter="{StaticResource InputPortConv}">
                            <Binding Path="ImagePortNameValue" />
                            <Binding Path="." />
                            <Binding Path="PortsVersion" />
                        </MultiBinding>
                    </cv:LinkableValueEditor.Port>
                </cv:LinkableValueEditor>
            </DataTemplate>

            <!--  ==================== 本视图局部样式（只改外观） ====================  -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentDarkBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentDarkBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentDarkBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  R68：30×30 图标按钮必须显式 Padding=0，避免吃 Fluent 隐式内边距切字  -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  图片记录方式卡片：IsChecked 仍由 ui:EnumConverter 写回 ImageSaveMode  -->
            <Style x:Key="ModeCardStyle" TargetType="RadioButton">
                <Setter Property="GroupName" Value="DataRecordImageSaveMode" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Card"
                                MinHeight="48"
                                Padding="8,7"
                                Background="{StaticResource DialogSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModeTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="ModeSubtitleStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="FontSize" Value="9.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!--  本地复选框：16×16 圆角框 + 主色选中态，避免 Fluent 隐式样式的蓝与本视图不一致  -->
            <Style x:Key="LocalCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DialogSurfaceBrush}"
                                    BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        x:Name="Check"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="9"
                                        Foreground="{StaticResource DialogSurfaceBrush}"
                                        Text="&#xf00c;"
                                        Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource DialogAccentBrush}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                原「变量名」可编辑下拉专用样式。方案 B 之后那个下拉已经删掉，
                这里保留一个空注释位（不留死样式）——需要可手填 ComboBox 时按下面三条来：
                共享的 DialogCombo 与 UI 库的隐式 ComboBox 样式都**没有** PART_EditableTextBox，
                在它们下面 IsEditable=True 是静默无效的；要本地套一个"只设尺寸、不设 Template"的样式，
                显式样式挡掉隐式样式，Template 回落到含 PART_EditableTextBox 的框架默认模板。
            -->

            <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TableRowStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TestResultBannerStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="9,8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TestResult, Converter={StaticResource TestResultState}}" Value="ok">
                        <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TestResult, Converter={StaticResource TestResultState}}" Value="error">
                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TestResultIconBubbleStyle" TargetType="Border">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TestResult, Converter={StaticResource TestResultState}}" Value="ok">
                        <Setter Property="Background" Value="{StaticResource DialogSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TestResult, Converter={StaticResource TestResultState}}" Value="error">
                        <Setter Property="Background" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TestResultIconStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TestResult, Converter={StaticResource TestResultState}}" Value="ok">
                        <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TestResult, Converter={StaticResource TestResultState}}" Value="error">
                        <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TestResultTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TestResult, Converter={StaticResource TestResultState}}" Value="ok">
                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TestResult, Converter={StaticResource TestResultState}}" Value="error">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左配置轨（300~356）+ 右列定义工作区（自适应）。
        960 宿主内容区约 920 → 左 354 / 右 550；640 宿主内容区约 600 → 左 300 / 右 284。
        所有颜色/字号走 UI 公共令牌，视图内不写十六进制。
    -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="356" />
            <ColumnDefinition Width="1.6*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：配置轨 ================= -->
        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="14"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 账本文件 -->
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="账本文件" />
                    <TextBlock
                        Margin="0,4,0,10"
                        Style="{StaticResource HelpTextStyle}"
                        Text="目录 / 文件名支持 {StepName} {yyyy} {yyyy-MM} {yyyy-MM-dd}；UTF-8 带 BOM，Excel 双击直接打开不乱码。" />

                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="记录目录" />
                    <TextBox
                        Style="{StaticResource DialogInput}"
                        Tag="例：D:\Records\{StepName}\{yyyy-MM}\"
                        Text="{Binding DirectoryTemplate, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="目录模板；跨月会自动建新目录" />

                    <TextBlock Margin="0,11,0,5" Style="{StaticResource FieldLabelStyle}" Text="文件名" />
                    <TextBox
                        Style="{StaticResource DialogInput}"
                        Tag="例：{yyyy-MM-dd}.csv（按天滚动）"
                        Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="文件名模板；默认按天滚动" />

                    <TextBlock Margin="0,11,0,5" Style="{StaticResource FieldLabelStyle}" Text="保留天数" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Style="{StaticResource DialogInput}"
                            Text="{Binding KeepDays, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="0 = 永不清理（追溯数据的删除必须显式决定）"
                            Typography.NumeralAlignment="Tabular" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource HelpTextStyle}"
                            Text="0 = 永久保留；&gt;0 每天自动删一次过期文件" />
                    </Grid>

                    <StackPanel Margin="0,10,0,0">
                        <CheckBox
                            Content="新文件写表头"
                            IsChecked="{Binding WriteHeader}"
                            Style="{StaticResource LocalCheckBoxStyle}"
                            ToolTip="新建文件时先写一行列名" />
                        <CheckBox
                            Margin="0,2,0,0"
                            Content="每行立即落盘"
                            IsChecked="{Binding FlushEveryRow}"
                            Style="{StaticResource LocalCheckBoxStyle}"
                            ToolTip="断电保真，牺牲节拍；默认 500 毫秒批量写" />
                        <CheckBox
                            Margin="0,2,0,0"
                            Content="写入失败阻断流程"
                            IsChecked="{Binding BlockOnFailure}"
                            Style="{StaticResource LocalCheckBoxStyle}"
                            ToolTip="宁停线不丢账：队列满/被拒时让本步骤失败" />
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,14,0,14"
                        Background="{StaticResource DialogBorderBrush}" />

                    <!-- 图片记录 -->
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="图片记录（可选）" />
                    <TextBlock
                        Margin="0,4,0,9"
                        Style="{StaticResource HelpTextStyle}"
                        Text="图片不进 CSV：账本里记的是路径，相册靠路径列关联。" />

                    <UniformGrid Margin="-3,0" Columns="3">
                        <RadioButton
                            Margin="3,0"
                            IsChecked="{Binding ImageSaveMode, Converter={ui:EnumConverter}, ConverterParameter={x:Static local:ImageSaveMode.Off}}"
                            Style="{StaticResource ModeCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ModeTitleStyle}" Text="不存图" />
                                <TextBlock Style="{StaticResource ModeSubtitleStyle}" Text="忽略图片端口" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            Margin="3,0"
                            IsChecked="{Binding ImageSaveMode, Converter={ui:EnumConverter}, ConverterParameter={x:Static local:ImageSaveMode.OnlyNG}}"
                            Style="{StaticResource ModeCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ModeTitleStyle}" Text="仅NG存图" />
                                <TextBlock Style="{StaticResource ModeSubtitleStyle}" Text="结果=NG 才存" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            Margin="3,0"
                            IsChecked="{Binding ImageSaveMode, Converter={ui:EnumConverter}, ConverterParameter={x:Static local:ImageSaveMode.Every}}"
                            Style="{StaticResource ModeCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ModeTitleStyle}" Text="每件存图" />
                                <TextBlock Style="{StaticResource ModeSubtitleStyle}" Text="每次执行都存" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <StackPanel
                        Margin="0,11,0,0"
                        Visibility="{Binding ImageSaveMode, Converter={StaticResource NotOffVis}}">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="图片源" />
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Content="{Binding}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImageSaveMode}" Value="{x:Static local:ImageSaveMode.OnlyNG}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="ContentTemplate" Value="{StaticResource ImagePortEditorTemplate}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ImageSaveMode}" Value="{x:Static local:ImageSaveMode.Every}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="ContentTemplate" Value="{StaticResource ImagePortEditorTemplate}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="端口给 HImage=存副本（后台落盘不占节拍）；给文本=只记现成路径；未连线不报错。" />

                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="结果列" />
                                <TextBox
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding ResultColumn, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="用哪个列判断 NG（填列名）" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="NG值" />
                                <TextBox
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding NgValue, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="结果列的值等于它就存图" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="92" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="命名模板" />
                                <TextBox
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding ImageNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="可用 {序号} 与任意列名占位符，如 {序号}_{结果}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="格式" />
                                <ComboBox
                                    Style="{StaticResource DialogCombo}"
                                    SelectedValuePath="Content"
                                    SelectedValue="{Binding ImageFormat}">
                                    <ComboBoxItem Content="png" />
                                    <ComboBoxItem Content="jpg" />
                                    <ComboBoxItem Content="bmp" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,11,0,5" Style="{StaticResource FieldLabelStyle}" Text="图片子目录" />
                        <TextBox
                            Style="{StaticResource DialogInput}"
                            Text="{Binding ImageDirName, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="记录目录下的子文件夹名，默认 img" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= 右：列定义工作区 ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 列定义卡 -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Padding="14"
                Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PluginCardCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="列定义" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Typography.NumeralAlignment="Tabular">
                                <Run Text="一行 = 一次执行 · " />
                                <Run Text="{Binding Columns.Count, Mode=OneWay, StringFormat={}{0} 列}" />
                            </TextBlock>
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding AddColumnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="+ 添加列"
                            Style="{StaticResource LocalPrimaryButtonStyle}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="新增一列，列名自动取不重名的「列N」" />
                            </Button.ToolTip>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,2,0,10">
                        <TextBlock
                            Margin="0"
                            Style="{StaticResource HelpTextStyle}"
                            Text="来源=取值（绑定）：列名即输入端口名，在那一格点 🔗 可绑全局变量 / 系统变量 / 运行时变量 / 上游端口（绑定后显示路径）；内置：时间/序号/步骤名/耗时/图片路径。" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Style="{StaticResource HelpTextStyle}"
                            Text="{Binding DataContext.LegacyVariableNotice, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel MinWidth="430">
                            <!-- 表头 -->
                            <Border
                                Height="30"
                                Background="{StaticResource DialogRowAlternateBrush}"
                                BorderBrush="{StaticResource DialogBorderLightBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeaderTextStyle}" Text="用" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="列名" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="来源" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}" Text="取值（连线 / 变量名 / 内置项）" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderTextStyle}" Text="格式" />
                                </Grid>
                            </Border>

                            <!-- 行 -->
                            <ItemsControl ItemsSource="{Binding Columns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TableRowStyle}">
                                            <Grid Height="42" Margin="8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding Enabled}"
                                                    Style="{StaticResource LocalCheckBoxStyle}"
                                                    ToolTip="启用该列" />

                                                <TextBox
                                                    Grid.Column="1"
                                                    Height="32"
                                                    Padding="8,0"
                                                    VerticalContentAlignment="Center"
                                                    Style="{StaticResource DialogInput}"
                                                    Tag="列名"
                                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip="列名 = CSV 表头；来源=端口时亦为端口名（勿含空格/逗号）" />

                                                <ComboBox
                                                    Grid.Column="2"
                                                    Height="32"
                                                    Padding="8,0,24,0"
                                                    Style="{StaticResource DialogCombo}"
                                                    ItemsSource="{Binding DataContext.ColumnSources, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedItem="{Binding Source}"
                                                    ToolTip="取值来源：取值（绑定）=点 🔗 绑全局变量/系统变量/运行时变量/上游端口（绑定后显示路径） / 内置=自动供给">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource CnEnum}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!--
                                                    取值三态：
                                                    · 端口 → ContentControl 按需创建 LinkableValueEditor；
                                                    · 变量 → 变量名输入；
                                                    · 内置 → 字段下拉。
                                                -->
                                                <Grid Grid.Column="3" Margin="0,0,4,0">
                                                    <ContentControl
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                        Content="{Binding}">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="ContentTemplate" Value="{x:Null}" />
                                                                <Style.Triggers>
                                                                    <!--  只有「启用 + 来源=端口」才创建编辑器：停用列时端口已被 RebuildDynamicInputs 移除  -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Source}" Value="{x:Static local:ColumnSource.Port}" />
                                                                            <Condition Binding="{Binding Enabled}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="ContentTemplate" Value="{StaticResource ColumnPortEditorTemplate}" />
                                                                    </MultiDataTrigger>
                                                                    <!--  DR1：列名为空时端口名也是空串，不能创建 Port=null 的编辑器；放在最后以覆盖上面的 Visible  -->
                                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>

                                                    <!--
                                                        旧配置兜底（方案 B）：「变量」档已下线，但旧 .vms 打开时仍可能是这一档。
                                                        这里显示只读提示 + 原变量名（不给已经不能用的输入框），
                                                        明确告诉用户改选「取值（绑定）」；运行期仍按旧口径取值。
                                                    -->
                                                    <Border
                                                        Padding="8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource DialogRowAlternateBrush}"
                                                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding Source, Converter={StaticResource SourceVis}, ConverterParameter=Variable}">
                                                        <TextBlock
                                                            Style="{StaticResource HelpTextStyle}"
                                                            Text="{Binding VariableName, StringFormat=旧配置：{0}（已弃用，请改选「取值（绑定）」）}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="「变量」档已下线：取值统一走「取值（绑定）」——在那一格点 🔗 直接绑全局变量 / 系统变量 / 运行时变量 / 上游端口。本行保留旧变量名仅供对照，运行期仍按旧口径取值。" />
                                                    </Border>

                                                    <ComboBox
                                                        Height="32"
                                                        Padding="8,0,24,0"
                                                        Style="{StaticResource DialogCombo}"
                                                        ItemsSource="{Binding DataContext.BuiltInFields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedItem="{Binding BuiltIn}"
                                                        ToolTip="内置字段"
                                                        Visibility="{Binding Source, Converter={StaticResource SourceVis}, ConverterParameter=BuiltIn}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource CnEnum}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>

                                                <TextBox
                                                    Grid.Column="4"
                                                    Height="32"
                                                    Padding="8,0"
                                                    VerticalContentAlignment="Center"
                                                    Style="{StaticResource DialogInput}"
                                                    Tag="默认"
                                                    Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip=".NET 格式串：F2 / 0.000 / HH:mm 等；空 = 默认"
                                                    Typography.NumeralAlignment="Tabular" />

                                                <Button
                                                    Grid.Column="5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DeleteColumnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xf00d;"
                                                    Style="{StaticResource IconButtonStyle}">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="删除该列（不影响已连线的其它列）" />
                                                    </Button.ToolTip>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 空列边界态 -->
                            <Border
                                Padding="20"
                                Background="{StaticResource DialogSurfaceBrush}"
                                Visibility="{Binding Columns.Count, Converter={StaticResource ZeroToVisibility}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border
                                        Width="38"
                                        Height="38"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource DialogRowHoverBrush}"
                                        BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="15"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="&#xf067;" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="还没有列" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="至少启用一列才能记录。点击右上角「添加列」开始。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 试写卡 -->
            <Border
                Grid.Row="1"
                Padding="14"
                Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PluginCardCornerRadius}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="试写一行验证配置" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="绕过队列，立即追加一行样例" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding TestWriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="测试写一行"
                            Style="{StaticResource LocalButtonStyle}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="绕过队列，立即向当前配置的目标文件追加一行样例" />
                            </Button.ToolTip>
                        </Button>
                    </Grid>
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource HelpTextStyle}"
                        Text="写一行后到记录目录打开 CSV，确认表头、列宽与编码；结果只反映本次试写。" />

                    <Border Margin="0,10,0,0" Style="{StaticResource TestResultBannerStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource TestResultIconBubbleStyle}">
                                <TextBlock
                                    Style="{StaticResource TestResultIconStyle}"
                                    Text="{Binding TestResult, Converter={StaticResource TestResultIcon}}" />
                            </Border>
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource TestResultTextStyle}"
                                Text="{Binding TestResult, Converter={StaticResource TestResultDisplay}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
