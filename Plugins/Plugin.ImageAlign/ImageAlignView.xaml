<UserControl
    x:Class="Plugin.ImageAlign.ImageAlignView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!--  画布：只读 + 取点；不提供“打开图片”，避免配置态误换预览  -->
        <Border
            Grid.Column="0"
            BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="8">
            <h:ImageReadOnly
                x:Name="Canvas"
                HImage="{Binding DisplayImage, Mode=OneWay}"
                ImagePicked="OnImagePicked"
                IsPickMode="{Binding IsPicking, Mode=TwoWay}"
                ToolTip="左键在图上点一下取点；滑轮缩放；右键可适应图片。取点前先点右侧「取参考点 / 取当前点」。" />
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,6"
                FontWeight="SemiBold"
                Text="点对（参考 R/C → 当前 R/C）" />

            <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                <Button
                    Margin="0,0,6,6"
                    Click="PickReference_Click"
                    Content="取参考点"
                    Padding="8,4" />
                <Button
                    Margin="0,0,6,6"
                    Click="PickCurrent_Click"
                    Content="取当前点"
                    Padding="8,4" />
                <Button
                    Margin="0,0,6,6"
                    Click="DeleteSelected_Click"
                    Content="删除选中"
                    Padding="8,4" />
                <Button
                    Margin="0,0,6,6"
                    Click="Clear_Click"
                    Content="清空"
                    Padding="8,4" />
                <Button
                    Margin="0,0,6,6"
                    Click="Parameters_Click"
                    Content="参数…"
                    Padding="8,4" />
                <CheckBox
                    Margin="0,0,0,6"
                    VerticalAlignment="Center"
                    Content="显示基准图"
                    IsChecked="{Binding ShowReferenceImage, Mode=TwoWay}"
                    IsEnabled="{Binding HasReferenceImage}" />
            </WrapPanel>

            <Grid Grid.Row="2" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" FontSize="11" Opacity="0.7" Text="参考 R" />
                <TextBlock Grid.Column="2" FontSize="11" Opacity="0.7" Text="参考 C" />
                <TextBlock Grid.Column="3" FontSize="11" Opacity="0.7" Text="当前 R" />
                <TextBlock Grid.Column="4" FontSize="11" Opacity="0.7" Text="当前 C" />
            </Grid>

            <ListBox
                Grid.Row="3"
                MinHeight="180"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding PointRows}"
                SelectedItem="{Binding SelectedPointRow, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding Index}" />
                            <TextBox
                                Grid.Column="1"
                                Margin="2,0"
                                Text="{Binding RefRow, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                ToolTip="参考点 Row" />
                            <TextBox
                                Grid.Column="2"
                                Margin="2,0"
                                Text="{Binding RefCol, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                ToolTip="参考点 Column" />
                            <TextBox
                                Grid.Column="3"
                                Margin="2,0"
                                Text="{Binding CurRow, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                ToolTip="当前点 Row" />
                            <TextBox
                                Grid.Column="4"
                                Margin="2,0"
                                Text="{Binding CurCol, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                ToolTip="当前点 Column" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="12"
                    Text="验证点（refR,refC,curR,curC；4 点透视建议填）" />
                <TextBox Text="{Binding ValidationPointText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBlock
                Grid.Row="5"
                Margin="0,8,0,0"
                Opacity="0.8"
                Text="{Binding ViewStatus}"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>
