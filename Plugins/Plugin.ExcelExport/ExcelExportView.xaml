<UserControl
    x:Class="Plugin.ExcelExport.ExcelExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.ExcelExport"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="520"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:ExportPolicyLabelConverter x:Key="PolicyLabel" />
            <local:EnumEqualsToVisibilityConverter x:Key="EnumEqualsVis" />
            <local:InverseBoolConverter x:Key="NotBool" />

            <!--
                本视图不再定义卡片/标题/提示/预览/字段标签/输入框/按钮/下拉样式，
                一律取自 UI 库 Plugin* 公共键（PluginConfigStyles.xaml）。

                唯一保留的本地派生：Card。公共 PluginCard 的内边距是 14（Blob/Caliper/CreateRoi 一派），
                本视图（连同 ResultUpload/DataRecord/CSharpScript/ImageScript 五家）抄写源是 12 ——
                按"零视觉变化"铁律收编时用 BasedOn 挂靠公共结构、只覆盖 Padding=12；
                待确认五家是否归一到 14 后，删掉这个样式、引用改回 PluginCard 即可（一行的事）。
            -->
            <Style x:Key="Card" BasedOn="{StaticResource PluginCard}" TargetType="Border">
                <Setter Property="Padding" Value="12" />
            </Style>

            <!--
                枚举下拉：结构与条目容器走公共 PluginModernComboBase/PluginModernComboItem，
                只有"条目显示中文标签"的转换器（ExportPolicyLabelConverter）是本视图专属，留本地。
            -->
            <Style
                x:Key="EnumCombo"
                BasedOn="{StaticResource PluginModernComboBase}"
                TargetType="ComboBox">
                <Setter Property="ItemContainerStyle" Value="{StaticResource PluginModernComboItem}" />
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PolicyLabel}}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!--  卡片1：报表来源（CSV 账本）  -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PluginCardTitle}" Text="① 报表来源（CSV 账本）" />
                    <TextBlock
                        Margin="0,2,0,6"
                        Style="{StaticResource PluginHintText}"
                        Text="指向上游『CSV 记录』步骤写出的账本。占位符：{源步骤} {StepName} {yyyy} {yyyy-MM} {yyyy-MM-dd}" />
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="源步骤名" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding SourceStepName, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="上游 CSV 记录步骤的名字（要和它写账本的目录名一致）。留空 = 用本步骤名" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="账本路径" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding SourcePathTemplate, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="例：D:\Records\{源步骤}\{yyyy-MM}\{yyyy-MM-dd}.csv" />
                    </Grid>
                    <Border
                        Margin="{StaticResource PluginFieldRowMargin}"
                        Padding="8,5"
                        Background="#F5F9FE"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PluginHintText}" Text="实际读取 →" />
                            <TextBlock Style="{StaticResource PluginPreviewText}" Text="{Binding SourcePathPreview}" />
                            <TextBlock
                                x:Name="SourceExistsText"
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="#2E7D32"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  卡片2：报表输出  -->
            <Border
                Margin="{StaticResource PluginSectionMargin}"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PluginCardTitle}" Text="② 报表输出" />
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="输出目录" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding OutputDirectoryTemplate, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="例：D:\Records\{StepName}\{yyyy-MM}\报表\" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="报表文件名" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding ReportFileNamePattern, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="例：{yyyy-MM-dd}_报表.xlsx" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="图片走这里" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding LinkColumn, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="哪一列做成可点击的图片链接，默认『图片路径』（与 CSV 记录的图片列同名）" />
                    </Grid>
                    <Border
                        Margin="{StaticResource PluginFieldRowMargin}"
                        Padding="8,5"
                        Background="#F5F9FE"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PluginHintText}" Text="实际写出 →" />
                            <TextBlock Style="{StaticResource PluginPreviewText}" Text="{Binding OutputPathPreview}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  卡片3：报表选项  -->
            <Border
                Margin="{StaticResource PluginSectionMargin}"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PluginCardTitle}" Text="③ 报表选项" />
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="导出方式" />
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource EnumCombo}"
                            ItemsSource="{Binding ExportPolicies}"
                            SelectedItem="{Binding ExportPolicy}"
                            ToolTip="手动=只点按钮导；触发端口=收工信号来了才导；每次执行=每跑一次都导（高频流程慎用）" />
                    </Grid>

                    <!--  导出方式=触发端口 时出现：直接在面板里把上游信号连给"导出触发"端口  -->
                    <Grid
                        Margin="0,2"
                        Visibility="{Binding ExportPolicy, Converter={StaticResource EnumEqualsVis}, ConverterParameter=OnTrigger}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="触发信号" />
                        <cv:LinkableValueEditor
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            StepData="{Binding StepData}"
                            Port="{Binding TriggerPort}" />
                    </Grid>

                    <TextBlock
                        Margin="{StaticResource PluginFieldRowMargin}"
                        Style="{StaticResource PluginHintText}"
                        Text="表头冻结 / 自动筛选：打开 Excel 就能按结果列筛 NG、滚动时表头不跑" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,14,0"
                            Content="冻结首行"
                            IsChecked="{Binding FreezeHeader}" />
                        <CheckBox
                            Margin="0,0,14,0"
                            Content="自动筛选"
                            IsChecked="{Binding AutoFilter}" />
                        <CheckBox
                            Content="只导有图的行"
                            IsChecked="{Binding OnlyRowsWithImage}"
                            ToolTip="抽检看 NG 图时用：图片列没有有效路径的行不写进报表" />
                    </StackPanel>
                    <StackPanel Margin="{StaticResource PluginFieldRowMargin}" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,14,0"
                            Content="导出后打开报表"
                            IsChecked="{Binding OpenAfterExport}" />
                        <CheckBox
                            Content="导出失败阻断流程"
                            IsChecked="{Binding BlockOnFailure}"
                            ToolTip="默认不勾：报表是给人看的附属产物，导不出来也别停线" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  卡片4：立即导出  -->
            <Border
                Margin="{StaticResource PluginSectionMargin}"
                Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PluginCardTitle}" Text="④ 立即导出" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource PluginHintText}"
                                Text="按上面的配置马上导一份，不用跑流程" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Content="立即导出"
                            IsEnabled="{Binding IsExporting, Converter={StaticResource NotBool}}"
                            Click="ExportNow_Click"
                            Style="{StaticResource PluginPrimaryButton}"
                            ToolTip="后台线程导出，几万行也不会卡界面" />
                    </Grid>
                    <TextBlock
                        x:Name="ResultText"
                        Margin="{StaticResource PluginFieldRowMargin}"
                        FontSize="12"
                        Text="{Binding LastResult}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
