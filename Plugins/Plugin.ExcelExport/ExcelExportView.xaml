<UserControl
    x:Class="Plugin.ExcelExport.ExcelExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.ExcelExport"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="520"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:ExportPolicyLabelConverter x:Key="PolicyLabel" />
            <local:EnumEqualsToVisibilityConverter x:Key="EnumEqualsVis" />
            <local:InverseBoolConverter x:Key="NotBool" />

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E5E5E5" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect
                            BlurRadius="12"
                            Direction="270"
                            Opacity="0.05"
                            ShadowDepth="2"
                            Color="Black" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#1F1F1F" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#888888" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!--  预览路径：等宽字体 + 浅蓝底，一眼分清"配置文本"和"实际算出来的路径"  -->
            <Style x:Key="PreviewText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei" />
                <Setter Property="Foreground" Value="#1565C0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#444444" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="72" />
            </Style>
            <Style x:Key="FieldBox" TargetType="TextBox">
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Padding" Value="16,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <!--  现代下拉基础样式：自绘圆角边框 + 悬停/聚焦高亮 + 自绘箭头（宿主默认 ComboBox 模板放在本视图外层作用域会失效，故完整自绘）  -->
            <Style x:Key="ModernComboBase" TargetType="ComboBox">
                <Setter Property="Height" Value="24" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#1F1F1F" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D5D5D5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton
                                    x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    ClickMode="Press"
                                    Cursor="Hand"
                                    Focusable="False"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <Path
                                                    x:Name="Arrow"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,9,0"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"
                                                    Fill="#8A8A8A" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3" />
                                                    <Setter TargetName="Arrow" Property="Fill" Value="#2196F3" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter
                                    Margin="8,0,24,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    IsHitTestVisible="False" />
                                <Popup
                                    AllowsTransparency="True"
                                    Placement="Bottom"
                                    PopupAnimation="Fade"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    StaysOpen="False">
                                    <Border
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="White"
                                        BorderBrush="#D5D5D5"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="10"
                                                Direction="270"
                                                Opacity="0.15"
                                                ShadowDepth="2"
                                                Color="Black" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="2">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  条目容器：圆角、悬停浅灰、选中浅蓝（系统蓝色高亮模板一并替换）  -->
            <Style x:Key="ModernComboItem" TargetType="ComboBoxItem">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#1F1F1F" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="3">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F0F4F8" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E3F0FB" />
                                    <Setter Property="Foreground" Value="#1565C0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  枚举下拉：条目显示中文标签（转换器），SelectedItem 仍是枚举本身  -->
            <Style
                x:Key="EnumCombo"
                BasedOn="{StaticResource ModernComboBase}"
                TargetType="ComboBox">
                <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboItem}" />
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PolicyLabel}}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!--  卡片1：报表来源（CSV 账本）  -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="① 报表来源（CSV 账本）" />
                    <TextBlock
                        Margin="0,2,0,6"
                        Style="{StaticResource HintText}"
                        Text="指向上游『CSV 记录』步骤写出的账本。占位符：{源步骤} {StepName} {yyyy} {yyyy-MM} {yyyy-MM-dd}" />
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="源步骤名" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource FieldBox}"
                            Text="{Binding SourceStepName, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="上游 CSV 记录步骤的名字（要和它写账本的目录名一致）。留空 = 用本步骤名" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="账本路径" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource FieldBox}"
                            Text="{Binding SourcePathTemplate, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="例：D:\Records\{源步骤}\{yyyy-MM}\{yyyy-MM-dd}.csv" />
                    </Grid>
                    <Border
                        Margin="0,6,0,0"
                        Padding="8,5"
                        Background="#F5F9FE"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Text="实际读取 →" />
                            <TextBlock Style="{StaticResource PreviewText}" Text="{Binding SourcePathPreview}" />
                            <TextBlock
                                x:Name="SourceExistsText"
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="#2E7D32"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  卡片2：报表输出  -->
            <Border
                Margin="0,8,0,0"
                Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="② 报表输出" />
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="输出目录" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource FieldBox}"
                            Text="{Binding OutputDirectoryTemplate, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="例：D:\Records\{StepName}\{yyyy-MM}\报表\" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="报表文件名" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource FieldBox}"
                            Text="{Binding ReportFileNamePattern, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="例：{yyyy-MM-dd}_报表.xlsx" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="图片走这里" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource FieldBox}"
                            Text="{Binding LinkColumn, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="哪一列做成可点击的图片链接，默认『图片路径』（与 CSV 记录的图片列同名）" />
                    </Grid>
                    <Border
                        Margin="0,6,0,0"
                        Padding="8,5"
                        Background="#F5F9FE"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Text="实际写出 →" />
                            <TextBlock Style="{StaticResource PreviewText}" Text="{Binding OutputPathPreview}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  卡片3：报表选项  -->
            <Border
                Margin="0,8,0,0"
                Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="③ 报表选项" />
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="导出方式" />
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource EnumCombo}"
                            ItemsSource="{Binding ExportPolicies}"
                            SelectedItem="{Binding ExportPolicy}"
                            ToolTip="手动=只点按钮导；触发端口=收工信号来了才导；每次执行=每跑一次都导（高频流程慎用）" />
                    </Grid>

                    <!--  导出方式=触发端口 时出现：直接在面板里把上游信号连给"导出触发"端口  -->
                    <Grid
                        Margin="0,2"
                        Visibility="{Binding ExportPolicy, Converter={StaticResource EnumEqualsVis}, ConverterParameter=OnTrigger}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="触发信号" />
                        <cv:LinkableValueEditor
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            StepData="{Binding StepData}"
                            Port="{Binding TriggerPort}" />
                    </Grid>

                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource HintText}"
                        Text="表头冻结 / 自动筛选：打开 Excel 就能按结果列筛 NG、滚动时表头不跑" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,14,0"
                            Content="冻结首行"
                            IsChecked="{Binding FreezeHeader}" />
                        <CheckBox
                            Margin="0,0,14,0"
                            Content="自动筛选"
                            IsChecked="{Binding AutoFilter}" />
                        <CheckBox
                            Content="只导有图的行"
                            IsChecked="{Binding OnlyRowsWithImage}"
                            ToolTip="抽检看 NG 图时用：图片列没有有效路径的行不写进报表" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,14,0"
                            Content="导出后打开报表"
                            IsChecked="{Binding OpenAfterExport}" />
                        <CheckBox
                            Content="导出失败阻断流程"
                            IsChecked="{Binding BlockOnFailure}"
                            ToolTip="默认不勾：报表是给人看的附属产物，导不出来也别停线" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  卡片4：立即导出  -->
            <Border
                Margin="0,8,0,0"
                Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource CardTitle}" Text="④ 立即导出" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource HintText}"
                                Text="按上面的配置马上导一份，不用跑流程" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Content="立即导出"
                            IsEnabled="{Binding IsExporting, Converter={StaticResource NotBool}}"
                            Click="ExportNow_Click"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="后台线程导出，几万行也不会卡界面" />
                    </Grid>
                    <TextBlock
                        x:Name="ResultText"
                        Margin="0,6,0,0"
                        FontSize="12"
                        Text="{Binding LastResult}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
