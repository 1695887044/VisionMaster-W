<UserControl
    x:Class="Plugin.CSharpScript.CSharpScriptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.CSharpScript"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="620"
    d:DesignWidth="1080"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:InputPortConverter x:Key="InputPortConv" />

            <!--
                卡片/标题/提示文字已收编进 UI 库 Plugin* 键。
                本地只留两样（理由）：
                · Card：五家视图抄写源内边距 12 ≠ 公共 PluginCard 的 14，BasedOn 覆盖保住原视觉，
                  归一待确认后删掉这个样式即可；
                · VarRowInput：不能 BasedOn 任何带 Height 的公共样式 —— 写死 24px 时输入框比右边
                  下拉框（主题给 ComboBox 的 MinHeight=32）矮一截，整行是歪的；用 MinHeight 兜底是刻意的。
            -->
            <Style x:Key="Card" BasedOn="{StaticResource PluginCard}" TargetType="Border">
                <Setter Property="Padding" Value="12" />
            </Style>

            <!--  变量表行内的输入框样式。两件事：
                  ① 不写死高度 —— 写死 24px 时，输入框比右边的下拉框（主题给 ComboBox 的 MinHeight=32）矮一截，整行是歪的；
                  ② 用 MinHeight 兜底 —— 以后谁再手滑加一个 Height，也不会把行压矮。
                  离屏渲染实测：行内输入框 120×32 / 112×32 / 备注 178×32，与下拉框齐平。  -->
            <Style x:Key="VarRowInput" TargetType="TextBox">
                <Setter Property="FontSize" Value="{StaticResource PluginLabelFontSize}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PluginViewMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" MinWidth="420" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!--  左列：输入变量（声明类型 + 连线/手填） + 输出变量（供下游连线 / 逐路显示）  -->
        <!--  横向 Disabled 是刻意的：一旦允许横向滚动，ScrollViewer 会用「无限宽」测量内容，
             里面的 TextWrapping 就失效——提示文字撑成一条长线，把卡片顶宽，右边的
             「显示窗口 / 备注 / 删除」整列被推出视口，表现就是「输入输出变量显示不全」。
             所以这里必须锁死横向，靠列宽自己塞得下。  -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,8,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  卡片：输入变量  -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource PluginCardTitle}"
                                Text="输入变量（脚本里 Context.GetInput）" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="AddInput_Click"
                                Content="+ 新增" />
                        </Grid>
                        <TextBlock
                            Margin="0,2,0,6"
                            Style="{StaticResource PluginHintText}"
                            Text="每项生成一个动态输入端口；连线取上游值，未连线时按类型手填。脚本用 Context.GetInput&lt;T&gt;(&quot;名字&quot;) 读取" />
                        <ItemsControl x:Name="InputList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Style="{StaticResource VarRowInput}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="变量名 = 端口名（字母开头，勿含空格）" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Margin="6,0"
                                            VerticalContentAlignment="Center"
                                            ItemsSource="{Binding DataContext.ScriptVarTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            SelectedItem="{Binding Type}"
                                            ToolTip="声明类型" />
                                        <cv:LinkableValueEditor
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            StepData="{Binding DataContext.StepData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <cv:LinkableValueEditor.Port>
                                                <MultiBinding Converter="{StaticResource InputPortConv}">
                                                    <Binding Path="Name" />
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    <!--  PortsVersion：端口重建锚点，插件 Rebuild 端口后经此通知自动重取新端口  -->
                                                    <Binding
                                                        Path="DataContext.PortsVersion"
                                                        RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </cv:LinkableValueEditor.Port>
                                        </cv:LinkableValueEditor>
                                        <Button
                                            Grid.Column="3"
                                            Width="24"
                                            Height="24"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            Click="DelInput_Click"
                                            Content="✕"
                                            Tag="{Binding}"
                                            ToolTip="删除该输入变量" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="InputEmptyHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource PluginHintText}"
                            Text="（无输入变量：点右上「+ 新增」）" />
                    </StackPanel>
                </Border>

                <!--  卡片：输出变量  -->
                <Border
                    Margin="{StaticResource PluginSectionMargin}"
                    Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource PluginCardTitle}"
                                Text="输出变量（脚本里 Context.SetOutput）" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="AddOutput_Click"
                                Content="+ 新增" />
                        </Grid>
                        <TextBlock
                            Margin="0,2,0,6"
                            Style="{StaticResource PluginHintText}"
                            Text="每项生成一个动态输出端口，供下游步骤连线；把端口连到全局变量即为「改全局变量」。图形输出可指定显示到第几号视图窗口" />
                        <ItemsControl x:Name="OutputList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="100" />
                                            <!--  Auto：这一列只有图形输出（HImage/HRegion…）才显示，
                                                  非图形时控件是 Collapsed，Auto 让它连宽度一起收掉，
                                                  省下的宽度留给右边的「备注」，不必挤在一起  -->
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                            <ColumnDefinition Width="30" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Style="{StaticResource VarRowInput}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="变量名 = 端口名" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Margin="4,0"
                                            VerticalContentAlignment="Center"
                                            ItemsSource="{Binding DataContext.ScriptVarTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            SelectedItem="{Binding Type}"
                                            ToolTip="声明类型（须与脚本产出一致）" />
                                        <!--  图形类输出（HImage/HRegion/HXld/HObject）才有"显示到窗口"下拉  -->
                                        <ComboBox
                                            Grid.Column="2"
                                            VerticalContentAlignment="Center"
                                            SelectedIndex="{Binding DisplayWindow}"
                                            ToolTip="把该图形结果显示到主界面第几号视图窗口">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIconic}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                            <ComboBoxItem Content="不显示" />
                                            <ComboBoxItem Content="窗口1" />
                                            <ComboBoxItem Content="窗口2" />
                                            <ComboBoxItem Content="窗口3" />
                                            <ComboBoxItem Content="窗口4" />
                                            <ComboBoxItem Content="窗口5" />
                                            <ComboBoxItem Content="窗口6" />
                                            <ComboBoxItem Content="窗口7" />
                                            <ComboBoxItem Content="窗口8" />
                                            <ComboBoxItem Content="窗口9" />
                                        </ComboBox>
                                        <TextBox
                                            Grid.Column="3"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource VarRowInput}"
                                            Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="备注（可选）" />
                                        <Button
                                            Grid.Column="4"
                                            Width="24"
                                            Height="24"
                                            Margin="4,0,0,0"
                                            Padding="0"
                                            Click="DelOutput_Click"
                                            Content="✕"
                                            Tag="{Binding}"
                                            ToolTip="删除该输出变量" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="OutputEmptyHint"
                            Margin="0,4,0,0"
                            Style="{StaticResource PluginHintText}"
                            Text="（无输出变量）" />
                    </StackPanel>
                </Border>

                <!--  卡片：可用自定义函数速查  -->
                <Border
                    Margin="{StaticResource PluginSectionMargin}"
                    Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="Context 自定义函数速查" />
                        <TextBlock
                            Margin="{StaticResource PluginFieldRowMargin}"
                            FontFamily="Consolas"
                            FontSize="11.5"
                            Foreground="{StaticResource PluginLabelTextBrush}"
                            TextWrapping="Wrap"><Run Text="Context.GetInput&lt;T&gt;(&quot;名&quot;)  取上游输入" /><LineBreak /><Run Text="Context.SetOutput(&quot;名&quot;, 值)   写输出端口" /><LineBreak /><Run Text="Context.GetVar&lt;T&gt;(&quot;名&quot;)      读运行期变量" /><LineBreak /><Run Text="Context.SetVar(&quot;名&quot;, 值)     写运行期变量" /><LineBreak /><Run Text="Context.Info/Warn/Error/Success(文本)" /><LineBreak /><Run Text="Context.ShowImage(img, 窗口号)" /><LineBreak /><Run Text="Context.ShowImage(img, 窗口号, 标注)  把结果画在图上" /><LineBreak /><Run Text="Context.NewMarks()           建标注层" /><LineBreak /><Run Text="Context.MarkText(行, 列, 文本, 色)  文本标注" /><LineBreak /><Run Text="Context.MarkLine(行1,列1,行2,列2,色)  线标注" /><LineBreak /><Run Text="Context.Fail(&quot;原因&quot;)         主动判失败" /></TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  右列：C# 脚本编辑器  -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel
                    Margin="2,0,0,8"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="{StaticResource PluginLabelFontSize}"
                        Foreground="#666666"
                        Text="C# 脚本（顶层语句 · 可用 class / 方法 / LINQ / using）" />
                    <Button
                        Margin="16,0,0,0"
                        Padding="10,2"
                        Click="Validate_Click"
                        Content="校验脚本"
                        ToolTip="强制重新编译（不执行），标出编译错误行列" />
                </StackPanel>
                <TextBlock
                    x:Name="ValidateResultText"
                    Margin="2,8,0,0"
                    DockPanel.Dock="Bottom"
                    FontSize="{StaticResource PluginLabelFontSize}"
                    Text="{Binding ValidationResult}"
                    TextWrapping="Wrap"
                    ToolTip="「校验脚本」按钮的结果" />
                <avalon:TextEditor
                    x:Name="Editor"
                    FontFamily="Consolas"
                    FontSize="14"
                    ShowLineNumbers="True"
                    TextChanged="Editor_TextChanged" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
