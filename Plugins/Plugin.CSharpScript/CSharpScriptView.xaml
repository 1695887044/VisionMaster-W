<UserControl
    x:Class="Plugin.CSharpScript.CSharpScriptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.CSharpScript"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="620"
    d:DesignWidth="1080"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:InputPortConverter x:Key="InputPortConv" />
            <local:ValidationStateConverter x:Key="ValidationStateConv" />
            <local:ValidationTextConverter x:Key="ValidationTextConv" />

            <!--
                本视图只做外观重排：
                · 输入变量行的 LinkableValueEditor 仍是唯一链接入口（Port / StepData / PortsVersion 原绑定）；
                · 输出变量的 DisplayWindow 仍绑 int，仍用原来 0~9 的 ComboBoxItem；
                · AvalonEdit 控件、语法高亮、智能提示、右键菜单、错误行标红全部保留。
            -->
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            </Style>

            <Style x:Key="CardHeaderTitleStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="CardHeaderHintStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CountChipBorderStyle" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="11" />
            </Style>

            <Style x:Key="CountChipTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="AddButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="FontSize" Value="11.5" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DeleteIconButtonStyle" BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogDangerBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RowInputStyle" BasedOn="{StaticResource DialogInput}" TargetType="TextBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowComboStyle" BasedOn="{StaticResource DialogCombo}" TargetType="ComboBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="4,0,20,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="VarRowStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="InputEmptyStateStyle" TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding InputVars.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OutputEmptyStateStyle" TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OutputVars.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EmptyStateRectangleStyle" TargetType="Rectangle">
                <Setter Property="Stroke" Value="{StaticResource DialogBorderStrongBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeDashArray" Value="4 3" />
                <Setter Property="RadiusX" Value="8" />
                <Setter Property="RadiusY" Value="8" />
                <Setter Property="Fill" Value="{StaticResource DialogRowAlternateBrush}" />
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="EmptyStateHintStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
            </Style>

            <Style x:Key="CodeBlockStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,9,0,0" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            </Style>

            <Style x:Key="ValidationStatusBarStyle" TargetType="Border">
                <Setter Property="Height" Value="40" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ValidationResult, Converter={StaticResource ValidationStateConv}}" Value="Ok">
                        <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ValidationResult, Converter={StaticResource ValidationStateConv}}" Value="Error">
                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ValidationDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="7" />
                <Setter Property="Height" Value="7" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ValidationResult, Converter={StaticResource ValidationStateConv}}" Value="Ok">
                        <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ValidationResult, Converter={StaticResource ValidationStateConv}}" Value="Error">
                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ValidationMessageStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ValidationResult, Converter={StaticResource ValidationStateConv}}" Value="Ok">
                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ValidationResult, Converter={StaticResource ValidationStateConv}}" Value="Error">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  CS1：视图内所有 ToolTip 统一走公共样式（与其它插件同族）  -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource DialogToolTipStyle}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左接口变量轨（280~380），右脚本编辑器工作区（自适应）。
        960 宿主内容区约 920 → 左 332 / 右 564；640 宿主内容区约 600 → 左 280 / 右 284。
        所有颜色走 UI 公共令牌，视图内不写十六进制。
    -->
    <Grid Margin="{StaticResource PluginViewMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="280" MaxWidth="380" />
            <ColumnDefinition Width="1.7*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：接口变量轨 ================= -->
        <Border
            Grid.Column="0"
            Margin="0,0,12,0"
            Padding="14"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 轨标题 + 计数 -->
                    <Grid Margin="1,0,1,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="接口变量" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Margin="0,0,6,0" Style="{StaticResource CountChipBorderStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="6"
                                        Height="6"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource DialogAccentBrush}" />
                                    <TextBlock Style="{StaticResource CountChipTextStyle}" Text="{Binding InputVars.Count}" />
                                    <TextBlock Margin="3,0,0,0" Style="{StaticResource CountChipTextStyle}" Text="输入" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CountChipBorderStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="6"
                                        Height="6"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource DialogSuccessBrush}" />
                                    <TextBlock Style="{StaticResource CountChipTextStyle}" Text="{Binding OutputVars.Count}" />
                                    <TextBlock Margin="3,0,0,0" Style="{StaticResource CountChipTextStyle}" Text="输出" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 输入变量 -->
                    <Border Margin="0,0,0,12" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="24"
                                    Height="24"
                                    Background="{StaticResource DialogAccentLightBrush}"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                        Text="&#xf090;" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource CardHeaderTitleStyle}"
                                    Text="输入变量" />
                                <Button
                                    Grid.Column="2"
                                    Click="AddInput_Click"
                                    Style="{StaticResource AddButtonStyle}"
                                    ToolTip="新增一个动态输入端口">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="10"
                                            Text="&#xf067;" />
                                        <TextBlock VerticalAlignment="Center" Text="新增" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="每项生成一个动态输入端口；连线取上游值，未连线时按类型手填。脚本用 Context.GetInput&lt;T&gt;(&quot;名字&quot;) 读取。全局/系统变量请在下方「共享变量」表声明，不要绑在输入上。" />

                            <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding InputVars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource VarRowStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="108" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--  LostFocus：改名要迁移连线键并按新名字重建端口，逐字符提交会在
                                                          "中间名恰好与另一行重名"时把绑定判成冲突（且每键都重建端口/高亮）  -->
                                                    <TextBox
                                                        Grid.Column="0"
                                                        Margin="0,0,4,0"
                                                        Style="{StaticResource RowInputStyle}"
                                                        Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                        ToolTip="变量名 = 端口名（字母开头，勿含空格）" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        Margin="0,0,4,0"
                                                        DisplayMemberPath="Display"
                                                        ItemsSource="{Binding DataContext.ScriptVarTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedValue="{Binding Type}"
                                                        SelectedValuePath="Value"
                                                        Style="{StaticResource RowComboStyle}"
                                                        ToolTip="声明类型" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="DelInput_Click"
                                                        Content="&#xf00d;"
                                                        Style="{StaticResource DeleteIconButtonStyle}"
                                                        Tag="{Binding}"
                                                        ToolTip="删除该输入变量" />
                                                </Grid>
                                                <cv:LinkableValueEditor
                                                    Margin="0,7,0,0"
                                                    AllowGlobals="False"
                                                    Label=""
                                                    StepData="{Binding DataContext.StepData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <cv:LinkableValueEditor.Port>
                                                        <MultiBinding Converter="{StaticResource InputPortConv}">
                                                            <Binding Path="Name" />
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            <!--  PortsVersion：端口重建锚点，插件 Rebuild 端口后经此通知自动重取新端口  -->
                                                            <Binding Path="DataContext.PortsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </cv:LinkableValueEditor.Port>
                                                </cv:LinkableValueEditor>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 空态：InputVars.Count == 0 时显示；不新增按钮，新增入口在卡片右上 -->
                            <Grid Margin="0,8,0,0" Style="{StaticResource InputEmptyStateStyle}">
                                <Rectangle Style="{StaticResource EmptyStateRectangleStyle}" />
                                <StackPanel Margin="12,14" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource EmptyStateIconStyle}" Text="&#xf01c;" />
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="还没有输入变量" />
                                    <TextBlock Style="{StaticResource EmptyStateHintStyle}" Text="点右上「新增」创建第一个动态输入端口" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 输出变量 -->
                    <Border Margin="0,0,0,12" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="24"
                                    Height="24"
                                    Background="{StaticResource DialogSuccessSubtleBrush}"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogSuccessTextBrush}"
                                        Text="&#xf08b;" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource CardHeaderTitleStyle}"
                                    Text="输出变量" />
                                <Button
                                    Grid.Column="2"
                                    Click="AddOutput_Click"
                                    Style="{StaticResource AddButtonStyle}"
                                    ToolTip="新增一个动态输出端口">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="10"
                                            Text="&#xf067;" />
                                        <TextBlock VerticalAlignment="Center" Text="新增" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="每项生成一个动态输出端口，供下游步骤连线；脚本里用 Context.SetOutput 写它。要落全局变量，请在下游接「变量赋值」（作用域=全局变量）并把「值」连到这里。图形输出可指定显示到第几号视图窗口。" />

                            <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding OutputVars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource VarRowStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="108" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--  LostFocus：同输入行——改名只在一次提交时重建端口，不逐字符抖  -->
                                                    <TextBox
                                                        Grid.Column="0"
                                                        Margin="0,0,4,0"
                                                        Style="{StaticResource RowInputStyle}"
                                                        Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                        ToolTip="变量名 = 端口名" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        Margin="0,0,4,0"
                                                        DisplayMemberPath="Display"
                                                        ItemsSource="{Binding DataContext.ScriptVarTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedValue="{Binding Type}"
                                                        SelectedValuePath="Value"
                                                        Style="{StaticResource RowComboStyle}"
                                                        ToolTip="声明类型（须与脚本产出一致）" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="DelOutput_Click"
                                                        Content="&#xf00d;"
                                                        Style="{StaticResource DeleteIconButtonStyle}"
                                                        Tag="{Binding}"
                                                        ToolTip="删除该输出变量" />
                                                </Grid>

                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 只有 HImage 输出才有「显示窗口」：预览通道只收 HImage -->
                                                    <StackPanel
                                                        Grid.Column="0"
                                                        Margin="0,0,6,0"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowsDisplayWindow}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock
                                                            Margin="0,0,6,0"
                                                            Style="{StaticResource FieldLabelStyle}"
                                                            Text="显示窗口" />
                                                        <ComboBox
                                                            Width="96"
                                                            SelectedIndex="{Binding DisplayWindow}"
                                                            Style="{StaticResource RowComboStyle}"
                                                            ToolTip="把该图像结果显示到主界面第几号视图窗口（仅 HImage 输出会推送）">
                                                            <ComboBoxItem Content="不显示" />
                                                            <ComboBoxItem Content="窗口1" />
                                                            <ComboBoxItem Content="窗口2" />
                                                            <ComboBoxItem Content="窗口3" />
                                                            <ComboBoxItem Content="窗口4" />
                                                            <ComboBoxItem Content="窗口5" />
                                                            <ComboBoxItem Content="窗口6" />
                                                            <ComboBoxItem Content="窗口7" />
                                                            <ComboBoxItem Content="窗口8" />
                                                            <ComboBoxItem Content="窗口9" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <TextBox
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource RowInputStyle}"
                                                        Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="备注（可选）" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 空态：OutputVars.Count == 0 时显示 -->
                            <Grid Margin="0,8,0,0" Style="{StaticResource OutputEmptyStateStyle}">
                                <Rectangle Style="{StaticResource EmptyStateRectangleStyle}" />
                                <StackPanel Margin="12,14" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource EmptyStateIconStyle}" Text="&#xf01c;" />
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="还没有输出变量" />
                                    <TextBlock Style="{StaticResource EmptyStateHintStyle}" Text="点右上「新增」创建第一个动态输出端口" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 共享变量（全局 / 系统）：按变量 Id 声明，不占输入端口 -->
                    <Border Margin="0,0,0,12" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="24"
                                    Height="24"
                                    Background="{StaticResource DialogRowHoverBrush}"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="&#xf0ac;" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource CardHeaderTitleStyle}"
                                    Text="共享变量" />
                                <Button
                                    Grid.Column="2"
                                    Click="AddShared_Click"
                                    Style="{StaticResource AddButtonStyle}"
                                    ToolTip="新增一条共享变量声明">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="10"
                                            Text="&#xf067;" />
                                        <TextBlock VerticalAlignment="Center" Text="新增" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="全局/系统变量按变量 Id 声明，不占用输入端口；脚本用 Context.GetGlobal(&quot;别名&quot;) 读取。系统变量只读。" />

                            <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding SharedVars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource VarRowStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        Grid.Column="0"
                                                        Margin="0,0,4,0"
                                                        DisplayMemberPath="Caption"
                                                        ItemsSource="{Binding DataContext.SharedVarCandidates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedValue="{Binding VariableId, Mode=TwoWay}"
                                                        SelectedValuePath="VariableId"
                                                        SelectionChanged="SharedVar_SelectionChanged"
                                                        Style="{StaticResource RowComboStyle}"
                                                        ToolTip="从变量管理（全局 / 系统变量）里选" />
                                                    <ComboBox
                                                        Grid.Column="1"
                                                        Margin="0,0,4,0"
                                                        DisplayMemberPath="Display"
                                                        IsEnabled="{Binding AccessSelectable}"
                                                        ItemsSource="{Binding DataContext.SharedAccessOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedValue="{Binding Access}"
                                                        SelectedValuePath="Value"
                                                        Style="{StaticResource RowComboStyle}"
                                                        ToolTip="只读 / 读写（系统变量恒只读）" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="DelShared_Click"
                                                        Content="&#xf00d;"
                                                        Style="{StaticResource DeleteIconButtonStyle}"
                                                        Tag="{Binding}"
                                                        ToolTip="删除该声明" />
                                                </Grid>
                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Margin="0,0,6,0"
                                                        Style="{StaticResource FieldLabelStyle}"
                                                        Text="别名" />
                                                    <TextBox
                                                        Grid.Column="1"
                                                        Style="{StaticResource RowInputStyle}"
                                                        Text="{Binding Alias, UpdateSourceTrigger=LostFocus}"
                                                        ToolTip="脚本里的键（留空 = 确认时固化为当前变量名；之后变量改名不影响脚本）" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                                        Text="{Binding TypeName}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 空态：SharedVars.Count == 0 时显示 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SharedVars.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Style="{StaticResource EmptyStateRectangleStyle}" />
                                <StackPanel Margin="12,14" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource EmptyStateIconStyle}" Text="&#xf0ac;" />
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="还没有共享变量" />
                                    <TextBlock Style="{StaticResource EmptyStateHintStyle}" Text="点右上「新增」声明一个全局 / 系统变量" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Context 速查 -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="24"
                                    Height="24"
                                    Background="{StaticResource DialogRowHoverBrush}"
                                    CornerRadius="7">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="&#xf02d;" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource CardHeaderTitleStyle}"
                                    Text="Context 速查" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource CardHeaderHintStyle}"
                                    Text="脚本门面" />
                            </Grid>
                            <Border Style="{StaticResource CodeBlockStyle}">
                                <TextBlock
                                    FontFamily="{StaticResource PluginMonoFontFamily}"
                                    FontSize="10.5"
                                    LineHeight="17"
                                    TextWrapping="Wrap">
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.GetInput&lt;T&gt;(&quot;名&quot;)" /><Run Text="  取上游输入" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.SetOutput(&quot;名&quot;, 值)" /><Run Text="   写输出端口" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.GetGlobal&lt;T&gt;(&quot;别名&quot;)" /><Run Text="  读共享变量" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.SetGlobal(&quot;别名&quot;, 值)" /><Run Text="  写共享变量（读写）" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.GetVar&lt;T&gt;(&quot;名&quot;)" /><Run Text="      读运行期变量" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.SetVar(&quot;名&quot;, 值)" /><Run Text="     写运行期变量" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.Info/Warn/Error/Success" /><Run Text="  写日志" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.ShowImage(img, 窗口号)" /><Run Text="  推送图像" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.NewMarks()" /><Run Text="              建标注层" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.MarkText/MarkLine(...)" /><Run Text="  文本 / 线标注" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogAccentTextBrush}" Text="Context.ThrowIfCancellationRequested()" /><Run Text="  长循环查取消" /><LineBreak />
                                    <Run Foreground="{StaticResource DialogSuccessTextBrush}" Text="Context.Fail(&quot;原因&quot;)" /><Run Text="             主动判失败" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= 右：脚本编辑器工作区 ================= -->
        <Border
            Grid.Column="1"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!-- 编辑器标题栏 -->
                <Grid Grid.Row="0" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="{StaticResource DialogAccentLightBrush}"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="13"
                            Foreground="{StaticResource DialogAccentTextBrush}"
                            Text="&#xf121;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="9,0,8,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="C# 脚本" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="顶层语句 · 可用 class / 方法 / LINQ / using"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Command="{Binding ValidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource LocalPrimaryButtonStyle}"
                        ToolTip="强制重新编译（不执行），标出编译错误行列">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="11"
                                Text="&#xf00c;" />
                            <TextBlock VerticalAlignment="Center" Text="校验脚本" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 编辑器：AvalonEdit 原控件、原事件、原编辑能力 -->
                <avalon:TextEditor
                    x:Name="Editor"
                    Grid.Row="1"
                    FontFamily="Consolas"
                    FontSize="14"
                    ShowLineNumbers="True"
                    TextChanged="Editor_TextChanged" />

                <!-- 校验状态栏：ValidationResult 空串 → 尚未校验；✔ → 成功；✘ → 错误 -->
                <Border Grid.Row="2" Style="{StaticResource ValidationStatusBarStyle}">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Style="{StaticResource ValidationDotStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource ValidationMessageStyle}"
                            Text="{Binding ValidationResult, Converter={StaticResource ValidationTextConv}}"
                            ToolTip="{Binding ValidationResult}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource PluginMonoFontFamily}"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="AvalonEdit · C#" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
