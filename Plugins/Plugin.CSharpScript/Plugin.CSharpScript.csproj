<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>Plugin.CSharpScript</RootNamespace>
    <AssemblyName>Plugin.CSharpScript</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 把 NuGet 包（Roslyn 全链）的运行时 dll 真实复制到本插件输出目录，
         供 PostBuild 拷入 Modules；否则 dotnet CLI 构建下包依赖只记于 deps.json、不落盘 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!--
      插件自带帮助手册：编进本程序集（宿主 HelpCatalogService 按 "<程序集名>.Help." 前缀约定发现，
      文件名顺序即手册页序，页标题取正文第一个一级标题）。
      为什么走内嵌资源而不是随目录投放：插件 DLL 由构建约定统一投递到 Modules\，
      手册跟着 DLL 走就不会出现"换了台机器手册没拷过去"。
      改手册 = 重建本插件工程（与原代码改动同一口径）。
    -->
    <EmbeddedResource Include="Help\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Services\Core.Halcon\Core.Halcon.csproj" />
    <ProjectReference Include="..\..\Shard\Core.Controls\Core.Controls.csproj" />
    <ProjectReference Include="..\..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
    <ProjectReference Include="..\..\UI\Controls\UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- C# 脚本宿主：Roslyn 交互式脚本引擎（离线缓存已含 4.12.0 全链传递依赖） -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>..\..\DLL\Halcon\halcondotnet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- 插件私有依赖投递（插件自身 DLL 的投递已由 Plugins\Directory.Build.targets 统一处理） -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!-- Roslyn 脚本引擎依赖：宿主默认 ALC 通过 LoadFrom 连续性从 Modules 目录解析插件私有依赖，
         故把 Microsoft.CodeAnalysis* 全套拷入 Modules（halcondotnet 由主程序目录提供，勿拷入 Modules 以免类型标识冲突） -->
    <Exec Command="copy &quot;$(TargetDir)Microsoft.CodeAnalysis*.dll&quot; &quot;$(ModulesDir)&quot; /Y" />
  </Target>
</Project>
