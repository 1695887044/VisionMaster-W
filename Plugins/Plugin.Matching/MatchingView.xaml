<UserControl
    x:Class="Plugin.Matching.MatchingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.Matching"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="clr-namespace:UI.CustomControl;assembly=UI"
    MinWidth="600"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    d:DesignHeight="680"
    d:DesignWidth="960"
    mc:Ignorable="d">

    <!--
        模板匹配配置视图 —— Web 设计基线 v1（docs/UI设计基线/matching/）。

        纯 UI 重构：不改端口、命令语义、持久化与业务逻辑。
        · 左栏：模板库 / 提取参数 / 匹配参数 / 涂抹编辑 / 输出；
        · 右栏：参考图工作区（ImageEdit 常驻）+ 模板预览（ImageReadOnly 常驻）+ 状态栏；
        · 颜色全部走公共令牌（Dialog* / PluginPreview*），本文件零十六进制。
        · 两个 HALCON 控件都不做 Visibility=Collapsed 显隐：无图/无预览时用纯 WPF 覆盖层，
          避免“折叠态收到 HImage、恢复后不重绘”的时序问题。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  运行显示窗口候选（int 数组保证 SelectedItem 值相等匹配回显；0 = 不发布）  -->
            <x:Array x:Key="ViewIndexes" Type="sys:Int32">
                <sys:Int32>0</sys:Int32>
                <sys:Int32>1</sys:Int32>
                <sys:Int32>2</sys:Int32>
                <sys:Int32>3</sys:Int32>
                <sys:Int32>4</sys:Int32>
                <sys:Int32>5</sys:Int32>
                <sys:Int32>6</sys:Int32>
                <sys:Int32>7</sys:Int32>
                <sys:Int32>8</sys:Int32>
                <sys:Int32>9</sys:Int32>
            </x:Array>

            <local:StatusMessageConverter x:Key="StatusMessageConverter" />

            <!--  ================= 基础排版 =================  -->
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="FieldStackStyle" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,0,11" />
            </Style>

            <!--  ================= 按钮 =================  -->
            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="LocalSmallButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="LocalGhostButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0,7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ================= 模板库列表 =================  -->
            <Style x:Key="TemplateListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ScrollViewer Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TemplateListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Bd"
                                Height="30"
                                Padding="8,0"
                                Background="Transparent"
                                CornerRadius="6">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ================= 状态胶囊 =================  -->
            <Style x:Key="StatusPillStyle" TargetType="Border">
                <Setter Property="Padding" Value="9,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTemplateCreated}" Value="True">
                        <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                    </DataTrigger>
                    <!--  放最后：过期态覆盖已学习态  -->
                    <DataTrigger Binding="{Binding IsModelStale}" Value="True">
                        <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusPillTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTemplateCreated}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsModelStale}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  右侧工作区头部的状态胶囊：窄档隐藏（左栏标题行的胶囊始终保留）  -->
            <Style x:Key="HeaderStatusPillStyle" BasedOn="{StaticResource StatusPillStyle}" TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  ================= 数值输入 =================  -->
            <Style x:Key="LocalNumericBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource DialogInputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Validation.ErrorTemplate">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border
                                BorderBrush="{StaticResource DialogDangerBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <AdornedElementPlaceholder />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}"
                                SnapsToDevicePixels="True">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                </Trigger>
                                <Trigger Property="Validation.HasError" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogDangerBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsInvalid, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogDangerBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  ================= 状态栏 =================  -->
            <Style x:Key="StatusDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="7" />
                <Setter Property="Height" Value="7" />
                <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Warning}">
                        <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusMessageStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Warning}">
                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  ================= 画布覆盖层 =================  -->
            <Style x:Key="CanvasChipStyle" TargetType="Border">
                <Setter Property="Margin" Value="10" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,0,13" />
                <Setter Property="Background" Value="{StaticResource PluginPreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PluginPreviewBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateSubStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,14" />
                <Setter Property="MaxWidth" Value="330" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="DarkButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource PluginPreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PluginPreviewBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkPrimaryButtonStyle" BasedOn="{StaticResource DarkButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左配置轨 368（320~380）+ 右参考图工作区自适应。
        960 宿主内容区约 920 → 左 368 / 右 536；640 宿主内容区约 600 → 左 320 / 右 266。
    -->
    <Grid Margin="0" Typography.NumeralAlignment="Tabular">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="320" MaxWidth="380" />
            <ColumnDefinition Width="1.55*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!--  ================= 左：配置轨 =================  -->
        <Border
            Grid.Column="0"
            Margin="0,0,14,0"
            Padding="14"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!--  ① 模板库  -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="模板库" />
                            <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}">
                                <TextBlock Style="{StaticResource StatusPillTextStyle}" Text="{Binding TemplateStatusText}" />
                            </Border>
                        </Grid>

                        <ListBox
                            Height="112"
                            Margin="0,9,0,0"
                            ItemContainerStyle="{StaticResource TemplateListItemStyle}"
                            ItemsSource="{Binding Library}"
                            SelectedItem="{Binding EditingEntry, Mode=TwoWay}"
                            Style="{StaticResource TemplateListBoxStyle}"
                            ToolTip="模板库：一条 = 一个产品配方。运行时按 RecipeName 端口选条目；未连接用「设为默认」选中的这条">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Model}" Value="">
                                                            <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                        </DataTrigger>
                                                        <!--  MA2：Model=null 与空串同义（未学习），否则列表会误显示绿点  -->
                                                        <DataTrigger Binding="{Binding Model}" Value="{x:Null}">
                                                            <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            FontWeight="Normal">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="已学习" />
                                                    <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Model}" Value="">
                                                            <Setter Property="Text" Value="未学习" />
                                                            <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                        </DataTrigger>
                                                        <!--  MA2：Model=null 与空串同义（未学习）  -->
                                                        <DataTrigger Binding="{Binding Model}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="未学习" />
                                                            <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button
                                MinWidth="64"
                                Command="{Binding AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="新增"
                                Style="{StaticResource LocalSmallButtonStyle}"
                                ToolTip="新增一个模板条目（配方）" />
                            <Button
                                MinWidth="64"
                                Margin="8,0,0,0"
                                Command="{Binding DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="删除"
                                Style="{StaticResource LocalSmallButtonStyle}"
                                ToolTip="删除当前选中的模板条目" />
                            <Button
                                MinWidth="88"
                                Margin="8,0,0,0"
                                Command="{Binding SetDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="设为默认"
                                Style="{StaticResource LocalSmallButtonStyle}"
                                ToolTip="RecipeName 端口未连接/为空时使用这个模板" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldStackStyle}" Margin="0,11,0,0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="配方名" ToolTip="当前条目的配方键；RecipeName 端口按它选模板。改名即时刷新列表" />
                            <TextBox
                                Style="{StaticResource DialogInput}"
                                Text="{Binding EditingEntry.Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldStackStyle}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="上游图像" ToolTip="HImage 端口：在流程里连上游，或在宿主点「执行」把图带进来" />
                            <cv:LinkableValueEditor
                                HorizontalAlignment="Stretch"
                                Label=""
                                Port="{Binding Image}"
                                StepData="{Binding StepData}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldStackStyle}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="参考图路径（可选）" ToolTip="当前条目的参考图完整路径；仅配置态使用，运行期不用它" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding EditingEntry.RefImagePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    Grid.Column="1"
                                    MinWidth="60"
                                    Margin="8,0,0,0"
                                    Command="{Binding LoadImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="载入"
                                    Style="{StaticResource LocalButtonStyle}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="每个模板各自的示意图；填路径后点「载入」，或点宿主「执行」把上游图带进来。" />
                        </StackPanel>

                        <Border
                            Margin="0,2,0,0"
                            Padding="9,8"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PluginCardCornerRadius}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="当前模板区域" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontFamily="{StaticResource PluginMonoFontFamily}"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding TemplateSummary}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button
                                MinWidth="104"
                                Command="{Binding CreateTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="创建模板"
                                Style="{StaticResource LocalPrimaryButtonStyle}"
                                ToolTip="把当前区域做成 shape model，随方案保存；改了框或提取参数后需要重新创建" />
                            <Button
                                MinWidth="76"
                                Margin="8,0,0,0"
                                Command="{Binding ClearTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="清除"
                                Style="{StaticResource LocalButtonStyle}"
                                ToolTip="清空画布上的模板区域（已创建的模板要重新创建才会变）" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource HelpTextStyle}"
                            Text="画框要领：框住目标上稳定、独特、随产品一起动的特征（丝印、边角组合、安装孔位），不要框到反光面或会变的区域。" />
                    </StackPanel>

                    <!--  ② 提取参数  -->
                    <StackPanel Margin="0,14,0,0">
                        <Border
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="提取参数" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SectionHintStyle}" Text="改任何一项都要重新学习" />
                                </Grid>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="这一区决定模型怎么学（角度 / 缩放 / 步长 / 对比度 / 极性）—— 改任何一项都需要重新点「创建模板」，徽标会转橙提醒。" />

                                <UniformGrid Margin="0,10,0,0" Columns="2">
                                    <StackPanel Margin="0,0,6,11">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最小角度 (度)" ToolTip="模板允许的最小旋转角（-180~180），与商用工具同口径" />
                                        <ui:NumericBox
                                            Minimum="-180"
                                            Maximum="180"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="EditingEntry.MinAngleDeg" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="最小角度" Max="180" Min="-180" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,11">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最大角度 (度)" ToolTip="模板允许的最大旋转角（-180~180）。产线偏转小就收窄（如 -15~15），模型更小、匹配更快" />
                                        <ui:NumericBox
                                            Minimum="-180"
                                            Maximum="180"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="EditingEntry.MaxAngleDeg" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="最大角度" Max="180" Min="-180" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,11">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="角度步长 (度)" ToolTip="相邻两个旋转变体的间隔（0 = 按模板尺寸自动定）。越小越准、模型越大" />
                                        <ui:NumericBox
                                            Minimum="0"
                                            Maximum="30"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="EditingEntry.AngleStepDeg" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="角度步长" Max="30" Min="0" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,11">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="梯度阈值" ToolTip="边缘提取的对比度门限（1~255，0 = 自动）。越高特征越少越快，过低会把噪声当特征" />
                                        <ui:NumericBox
                                            Minimum="0"
                                            Maximum="255"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="EditingEntry.GradientThreshold" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="梯度阈值" Max="255" Min="0" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Style="{StaticResource FieldStackStyle}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="使用极性" ToolTip="使用极性 = 黑白方向必须一致才算命中（更快）；光照会反相的场合选忽略极性" />
                                    <ComboBox
                                        ItemsSource="{Binding PolarityOptions}"
                                        SelectedIndex="{Binding PolarityIndex}"
                                        Style="{StaticResource DialogCombo}" />
                                </StackPanel>

                                <CheckBox
                                    Margin="0,0,0,11"
                                    Content="启用缩放匹配（目标远近会变才开）"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    IsChecked="{Binding EditingEntry.ScaleEnabled, Mode=TwoWay}"
                                    VerticalContentAlignment="Center" />

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,11">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最小比例 (倍)" ToolTip="相对模板尺寸的最小倍率（0.5~2）" />
                                        <ui:NumericBox
                                            Minimum="0.5"
                                            Maximum="2"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="EditingEntry.ScaleMin" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="最小比例" Max="2" Min="0.5" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,11">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最大比例 (倍)" ToolTip="相对模板尺寸的最大倍率（0.5~2）。范围越宽模型越大越慢" />
                                        <ui:NumericBox
                                            Minimum="0.5"
                                            Maximum="2"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="EditingEntry.ScaleMax" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="最大比例" Max="2" Min="0.5" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Style="{StaticResource FieldStackStyle}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="金字塔层数" ToolTip="1~10：层数多找得快，但太粗会丢小目标。一般 4~6" />
                                    <ui:NumericBox
                                        DecimalPlaces="0"
                                        Minimum="1"
                                        Maximum="10"
                                        Style="{StaticResource LocalNumericBoxStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="EditingEntry.NumLevels" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="金字塔层数" Max="10" Min="1" IntegerOnly="True" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ③ 匹配参数  -->
                    <StackPanel Margin="0,14,0,0">
                        <Border
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="匹配参数" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SectionHintStyle}" Text="运行期 · 立即生效" />
                                </Grid>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="这一区是运行期参数，改完立即生效，不用重新创建模板。" />

                                <UniformGrid Margin="0,10,0,0" Columns="2">
                                    <StackPanel Margin="0,0,6,11">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="分数下限" ToolTip="低于它的命中不算找到（0~1）。找不到目标先试着降到 0.3；误匹配多就往上提" />
                                        <ui:NumericBox
                                            Minimum="0.01"
                                            Maximum="1"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="MinScore" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="分数下限" Max="1" Min="0.01" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,11">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="匹配数上限" ToolTip="最多输出几个命中实例（1 = 单目标）。多目标计数/抓取场景才调大" />
                                        <ui:NumericBox
                                            DecimalPlaces="0"
                                            Minimum="1"
                                            Maximum="100"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="MaxMatches" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="匹配数上限" Max="100" Min="1" IntegerOnly="True" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="最大重叠" ToolTip="两个命中区域允许的最大重叠比例（0~1），防止同一目标报两次" />
                                        <ui:NumericBox
                                            Minimum="0"
                                            Maximum="1"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="MaxOverlap" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="最大重叠" Max="1" Min="0" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="搜索激进度" ToolTip="0.1~0.9：越大越快、越容易漏检。产线不稳就调小（0.5~0.7）" />
                                        <ui:NumericBox
                                            Minimum="0.1"
                                            Maximum="0.9"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="Greediness" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="搜索激进度" Max="0.9" Min="0.1" IntegerOnly="False" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="分数下限找不到目标先降到 0.3 看看是不是光照变了；误匹配就往上调，或换一块更独特的模板区域。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ④ 涂抹编辑  -->
                    <StackPanel Margin="0,14,0,0">
                        <Border
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,14,0,0">
                            <Expander Foreground="{StaticResource DialogTextSecondaryBrush}" FontSize="12" IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="涂抹编辑" />
                                </Expander.Header>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="把反光面 / 会变的区域从模板域里挖掉（随「创建模板」生效）。" />
                                    <StackPanel Margin="0,8,0,0" Style="{StaticResource FieldStackStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="涂抹模式" ToolTip="绘制涂抹 = 笔刷涂过的部分不参与学习；擦除涂抹 = 把涂多的找回来" />
                                        <ComboBox
                                            ItemsSource="{Binding SmearModeOptions}"
                                            SelectedIndex="{Binding SmearModeIndex}"
                                            Style="{StaticResource DialogCombo}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldStackStyle}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="笔刷半径 (px)" ToolTip="涂抹笔刷的半径（1~50）" />
                                        <ui:NumericBox
                                            Minimum="1"
                                            Maximum="50"
                                            Style="{StaticResource LocalNumericBoxStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="BrushSize" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="笔刷半径" Max="50" Min="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <Button
                                        MinWidth="90"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ClearSmearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Content="清除涂抹"
                                        Style="{StaticResource LocalSmallButtonStyle}"
                                        ToolTip="清空全部涂抹（模型恢复整域学习；要重新创建模板才生效）" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="涂抹后要重新点「创建模板」才生效；掩膜随方案保存，重开配置界面会以橙色显示。" />
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>

                    <!--  ⑤ 输出  -->
                    <StackPanel Margin="0,14,0,0">
                        <Border
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="输出" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SectionHintStyle}" Text="运行结果" />
                                </Grid>

                                <StackPanel Margin="0,10,0,0" Style="{StaticResource FieldStackStyle}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="配方名端口" ToolTip="链接上游的配方变量（产品型号），运行时按名字选模板；也可手填固定名字（留空 = 用默认模板）" />
                                    <cv:LinkableValueEditor
                                        HorizontalAlignment="Stretch"
                                        Label=""
                                        Port="{Binding RecipeName}"
                                        StepData="{Binding StepData}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource FieldStackStyle}">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="运行显示窗口" ToolTip="正式运行时把标注图发布到主界面几号视图窗口（1~9）；选「不显示」则不发布" />
                                    <ComboBox
                                        ItemsSource="{StaticResource ViewIndexes}"
                                        SelectedItem="{Binding DisplayViewIndex}"
                                        Style="{StaticResource DialogCombo}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding StringFormat=图像窗口{0}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="0">
                                                                    <Setter Property="Text" Value="不显示" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <CheckBox
                                    Margin="0,0,0,8"
                                    Content="输出位姿归一化图像（AlignedImage 端口）"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    IsChecked="{Binding OutputAlignedImage, Mode=TwoWay}"
                                    ToolTip="把整图刚性变换到「目标永远在标准位置、标准角度」—— 下游所有固定坐标插件（画框裁剪/Blob/卡尺）零改动直接吃，产品偏移旋转不再作废固定框"
                                    VerticalContentAlignment="Center" />

                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="目标被刚性变换到标准位姿，下游固定坐标插件零改动直接吃。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ⑥ 怎么用  -->
                    <Expander
                        Margin="0,14,0,0"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        IsExpanded="False">
                        <Expander.Header>
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="怎么用" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock
                                Style="{StaticResource HelpTextStyle}"
                                Text="① 先在流程里把本节点的 Image 连到上游；② 打开本窗口点「执行」把上游图带进来（或填参考图路径点「载入」）；③ 在图上右键 → 新建矩形/圆形/椭圆，框住模板特征；④ 点「创建模板」；⑤ 提取参数（角度/缩放/步长/梯度阈值/极性/金字塔）按需调整 —— 改了任何一项都要重新点「创建模板」，徽标转橙就是在提醒。" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource HelpTextStyle}"
                                Text="分数下限找不到目标先降到 0.3 看看是不是光照变了；误匹配就往上调，或换一块更独特的模板区域。" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource HelpTextStyle}"
                                Text="执行内核已接通：连线上跑即可定位（位姿端口 + 主界面标注图）；提取参数改过记得重新点「创建模板」。" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  ================= 右：参考图工作区 =================  -->
        <Border
            Grid.Column="1"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!--  工作区头：参考图像 + 右键提示 + 模板状态 + 工具条  -->
                <Grid Grid.Row="0" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="&#xf1c5;" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="参考图像" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="右键 → 新建 ROI"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource HeaderStatusPillStyle}">
                        <TextBlock Style="{StaticResource StatusPillTextStyle}" Text="{Binding TemplateStatusText}" />
                    </Border>
                    <StackPanel
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="FitWindow_Click"
                            Content="&#xf065;">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="适应窗口" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Margin="2,0,0,0"
                            Style="{StaticResource ToolbarTextButtonStyle}"
                            Click="FitImage_Click"
                            Content="1:1">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="实际像素 1:1" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  画布：ImageEdit 常驻；无图/错误用覆盖层，不折叠控件  -->
                <Border Grid.Row="1" Background="{StaticResource PluginPreviewCanvasBrush}">
                    <Grid x:Name="MainCanvasHost">
                        <h:ImageEdit
                            ActiveRoi="{Binding CanvasActiveRoi, Mode=TwoWay}"
                            BrushRadius="{Binding BrushSize, Mode=TwoWay}"
                            DrawObjectList="{Binding CanvasRois}"
                            HImage="{Binding DisplayImage, Mode=OneWay}"
                            SmearDraw="{Binding SmearMask, Mode=TwoWay}"
                            SmearErase="{Binding SmearEraseRegion, Mode=TwoWay}"
                            SmearMode="{Binding CanvasSmearMode, Mode=TwoWay}" />

                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource CanvasChipStyle}" TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogSurfaceBrush}"
                                Text="可编辑 · 参考图" />
                        </Border>

                        <!--  空态：无图且不是错误  -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid
                                MaxWidth="420"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Rectangle
                                    Fill="{StaticResource PluginPreviewSurfaceBrush}"
                                    Opacity="0.55"
                                    RadiusX="14"
                                    RadiusY="14"
                                    Stroke="{StaticResource PluginPreviewBorderBrush}"
                                    StrokeDashArray="3,3" />
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource EmptyStateIconStyle}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="20"
                                            Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                            Text="&#xf1c5;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="载入参考图开始框选" />
                                    <TextBlock Style="{StaticResource EmptyStateSubStyle}" Text="填左侧「参考图路径」后点「载入」，或在流程里连好上游 Image 后点宿主「执行」把图带进来。支持 BMP / JPG / PNG / TIF。" />
                                    <Button
                                        HorizontalAlignment="Center"
                                        Command="{Binding LoadImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Content="载入参考图"
                                        Style="{StaticResource DarkPrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!--  错误态：无图且 StatusLevel=Error  -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DisplayImage}" Value="{x:Null}" />
                                                <Condition Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border
                                    Width="46"
                                    Height="46"
                                    Margin="0,0,0,13"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource DialogDangerSubtleBrush}"
                                    BorderBrush="{StaticResource DialogDangerBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="20"
                                        Foreground="{StaticResource DialogDangerBrush}"
                                        Text="&#xf071;" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogDangerBrush}"
                                    Text="参考图载入失败" />
                                <TextBlock
                                    MaxWidth="360"
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                    Text="{Binding StatusMessage}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                    Text="请检查路径，或先在流程里连好上游 Image 再点宿主「执行」。"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!--  模板预览：ImageReadOnly 常驻；无预览时覆盖层，不折叠控件  -->
                <Border
                    Grid.Row="2"
                    Padding="10"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Height" Value="148" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Height" Value="124" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" MinWidth="110" />
                            <ColumnDefinition Width="1.1*" MinWidth="110" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Grid.Column="0"
                            Background="{StaticResource PluginPreviewSurfaceBrush}"
                            BorderBrush="{StaticResource PluginPreviewBorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource PluginCardCornerRadius}">
                            <Grid>
                                <h:ImageReadOnly HImage="{Binding TemplatePreviewImage}" />
                                <Border Background="{StaticResource PluginPreviewSurfaceBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTemplatePreview}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock
                                        Margin="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                        Text="创建模板后显示特征预览"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="模板预览" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="绿色 = 模型记住的特征边" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontFamily="{StaticResource PluginMonoFontFamily}"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding TemplateSummary}"
                                TextWrapping="Wrap" />
                            <Border
                                Margin="0,7,0,0"
                                Padding="6,5"
                                Background="{StaticResource DialogWarningSubtleBrush}"
                                BorderBrush="{StaticResource DialogWarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PluginSmallCornerRadius}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelStale}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="提取参数已修改，需重新点「创建模板」。"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  状态栏：Info=绿 / Warning=橙 / Error=红，不新增第四档  -->
                <Border
                    Grid.Row="3"
                    Padding="12,0"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Style="{StaticResource StatusDotStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource StatusMessageStyle}"
                            Text="{Binding StatusMessage, Converter={StaticResource StatusMessageConverter}}" />
                        <TextBlock
                            Grid.Column="2"
                            MaxWidth="200"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource PluginMonoFontFamily}"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding EditingEntry.Name}"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
