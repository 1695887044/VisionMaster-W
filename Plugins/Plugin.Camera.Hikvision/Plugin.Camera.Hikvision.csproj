<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Plugin.Camera.Hikvision</RootNamespace>
    <AssemblyName>Plugin.Camera.Hikvision</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
  </ItemGroup>

  <!-- 内置帮助手册：Help\ 下每个 .md 一页，宿主按 {程序集名}.Help. 前缀扫描（页序 = 文件名典序） -->
  <ItemGroup>
    <EmbeddedResource Include="Help\**\*" />
  </ItemGroup>

  <!-- 像素格式分类等 internal 成员对断言工程开放（与 VisionMaster 对 ScadaChecks 同一口径） -->
  <ItemGroup>
    <InternalsVisibleTo Include="FlowCanvasChecks" />
  </ItemGroup>

  <!--
    自身 DLL 投递到 Modules\ 的路径**只有一条**：Plugins\Directory.Build.targets 的
    CopyPluginToModules 目标（它把 $(TargetPath) 拷到 $(ModulesDir)，两种构建入口都成立）。
    本工程原先另有一个同名 CopyToModules 目标把同一个 $(TargetPath) 再拷一遍——同一产物投两遍，
    多出来的那遍对增量构建毫无贡献，只会让"到底哪条路径负责投递"变成两处事实来源（2026-10-22 移除）。
    同批的 Plugin.ImageAssign.csproj 也是同一口径（它只留注释、不写 PostBuild）。
  -->

</Project>
