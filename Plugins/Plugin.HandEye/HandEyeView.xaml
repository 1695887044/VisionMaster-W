<UserControl x:Class="Plugin.HandEye.HandEyeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UI.CustomControl;assembly=UI"
             xmlns:local="clr-namespace:Plugin.HandEye"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="620"
             d:DataContext="{d:DesignInstance local:HandEyePlugin}"
             MinWidth="560"
             MinHeight="{DynamicResource PluginViewMinHeight}">

    <!--
      手眼标定配置视图 —— 数据是主体，矩阵是结论，参数是配角（设计基线 v2，见 docs/UI设计基线/hand-eye/）。
      契约：
        · DataContext 是 HandEyePlugin 实例；插件本身实现 IPluginConfigView，
          宿主按"视图 或 视图.DataContext"两种形态取 OnConfirm（PluginConfigShellViewModel:139-144）。
        · 视图不算数学：4×4 与三枚残差全部来自插件算好的 Preview* 只读属性。
        · 颜色只引用公共令牌，本文件里没有十六进制（R140）。
        · 资源就地合并：断言宿主没有 Application，不合并会在解析期抛 XamlParseException（R22 同族）。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全视图 ToolTip 统一走对话框域样式（R135） -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource DialogToolTipStyle}" />

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="HintTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
              采集进度条（设计基线 §12 Q2 落地）。

              为什么不直接用默认 ProgressBar：WPF 自带的模板带 3D 斜面与渐变，跟本页的扁平卡片不是一路；
              本仓 Fluent 分册里那个 `FluentProgressBarStyle` 又没进 UI/Controls/Themes/Generic.xaml 的合并链
              （只有 FluentAliases.xaml 在链上），在这里 StaticResource 它会在解析期抛"找不到资源"。
              所以就地写一个 6px 细条：外框 Track + 内部 PART_Indicator（ProgressBar 自己按 Value 算宽度）。

              颜色走令牌：未采够 = 主色，够了 = 成功色。两个都只引 Colors.xaml，视图内零十六进制（R140）。
            -->
            <Style x:Key="SampleProgressStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="6" />
                <Setter Property="Width" Value="88" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border x:Name="PART_Track"
                                    CornerRadius="3"
                                    Background="{StaticResource DialogBorderLightBrush}">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="3"
                                        Background="{TemplateBinding Background}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 采够建议组数就转绿：这里改的是 Background，它被 TemplateBinding 透到 PART_Indicator -->
                    <DataTrigger Binding="{Binding HasEnoughSamples}" Value="True">
                        <Setter Property="Background" Value="{StaticResource DialogSuccessBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
              装法两选一：分段按钮。不用 RadioButton 的默认圆点 —— 圆点与本页的卡片边线视觉打架，
              也没法让两项等宽铺满（设计基线 §4.1）。
              模板里的 Border / ContentPresenter 显式声明对齐（R148：自定义模板里的 ToggleButton 系
              会吃应用级 Fluent 的 Left/Center，不写就贴左上）。
            -->
            <Style x:Key="PoseSegmentStyle" TargetType="RadioButton">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Seg"
                                    Padding="12,5"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DialogSurfaceBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Seg" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                    <Setter TargetName="Seg" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Seg" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 单元格：等宽数字右对齐；mm/度混排时小数点能竖着对上 -->
            <Style x:Key="NumCellStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <!--
                数字列的单元格内边距必须比默认 12,0,0,0 紧：948 宽下 12 个 * 列各约 73px，
                默认内边距 + 原有 8px 右边距只剩 53px，容不下「-511.280」（8 字符），
                而右对齐会把多出的部分从左边裁掉 ⇒ 屏幕上是 11.280，
                一个负号消失的错误数字比截断的文字危险得多。
            -->
            <Style x:Key="NumCellHostStyle" TargetType="DataGridCell" BasedOn="{StaticResource DialogDataGridCell}">
                <Setter Property="Padding" Value="6,0,4,0" />
            </Style>

            <Style x:Key="NumEditStyle" TargetType="TextBox" BasedOn="{StaticResource PluginNumericBox}">
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>

            <Style x:Key="RowDeleteButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource PluginFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="ToolTip" Value="删掉这一行" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Shell"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Shell" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="KpiLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextTertiaryBrush}" />
            </Style>

            <Style x:Key="KpiValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
            </Style>

            <Style x:Key="MatrixCellStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,1,8,1" />
            </Style>

            <Style x:Key="MatrixAxisStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,1,6,1" />
            </Style>

            <!-- 结论胶囊：三态一次写完，配色只走令牌 -->
            <Style x:Key="ResultChipStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPreviewOk}" Value="True">
                        <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPreviewFailed}" Value="True">
                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResultChipTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPreviewOk}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPreviewFailed}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
      字体不能写在根 UserControl 上：元素自身属性在解析期先于该元素的 Resources 求值，
      PluginFontFamily 就在这时查不到，抛 XamlParseException「无法找到名为 PluginFontFamily 的资源」
      （AGENTS.md §9 "同文件后置键"）。挂到根 Grid 上，此时 Resources 已就绪。
    -->
    <Grid Margin="14,12,14,12" TextElement.FontFamily="{StaticResource PluginFontFamily}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 工具条 -->
            <RowDefinition Height="*" />
            <!-- 成对数据表（本页主体） -->
            <RowDefinition Height="Auto" />
            <!-- 表尾：加一行 + 计数 -->
            <RowDefinition Height="Auto" />
            <!-- 结果区 -->
            <RowDefinition Height="Auto" />
            <!-- 失败块 -->
            <RowDefinition Height="Auto" />
            <!-- 下一步提示 -->
        </Grid.RowDefinitions>

        <!-- ============ 工具条 ============ -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ImportButton"
                        Style="{StaticResource PluginButton}"
                        Content="导入 CSV"
                        Margin="0,0,6,0"
                        Click="ImportCsv_Click"
                        ToolTip="把一份 12 列的 CSV 整批读进表格；表格里已有的行会被替换" />
                <Button x:Name="ExportButton"
                        Style="{StaticResource PluginButton}"
                        Content="导出 CSV"
                        Margin="0,0,6,0"
                        Click="ExportCsv_Click"
                        ToolTip="把当前表格整批写成 CSV（带表头），方便留档或换台机器继续" />
                <Button x:Name="SolveButton"
                        Style="{StaticResource PluginPrimaryButton}"
                        Content="求解"
                        Command="{Binding SolveCommand}"
                        ToolTip="按当前表格解一次 4×4 并在下方给残差；不改流程结果，真正的结果以运行时的输出端口为准" />
            </StackPanel>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="装法" Style="{StaticResource FieldLabelStyle}" />
                <RadioButton Content="{Binding EyeInHandLabel}"
                             GroupName="HandEyePoseKind"
                             Style="{StaticResource PoseSegmentStyle}"
                             IsChecked="{Binding IsEyeInHand, Mode=TwoWay}"
                             ToolTip="相机装在机器人末端：结果是 T_gripper←camera" />
                <RadioButton Content="{Binding EyeToHandLabel}"
                             GroupName="HandEyePoseKind"
                             Style="{StaticResource PoseSegmentStyle}"
                             Margin="0,0,14,0"
                             IsChecked="{Binding IsEyeToHand, Mode=TwoWay}"
                             ToolTip="相机固定在工位：结果是 T_base←camera" />

                <TextBlock Text="平移上限" Style="{StaticResource FieldLabelStyle}" Margin="0,0,4,0" />
                <ui:NumericBox Width="86"
                               Margin="0,0,2,0"
                               Minimum="0" Maximum="1000" DecimalPlaces="2"
                               Suffix="mm"
                               RevertOnInvalid="True"
                               Value="{Binding MaxTranslationRmsMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="解出来以后平移残差 RMS 超过它就判失败（改这个值只影响判定，不影响解）" />

                <TextBlock Text="旋转上限" Style="{StaticResource FieldLabelStyle}" Margin="10,0,4,0" />
                <ui:NumericBox Width="86"
                               Margin="0,0,10,0"
                               Minimum="0" Maximum="180" DecimalPlaces="3"
                               Suffix="°"
                               RevertOnInvalid="True"
                               Value="{Binding MaxRotationRmsDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="解出来以后旋转残差 RMS 超过它就判失败" />

                <CheckBox Content="要求 ≥ 6 组"
                          VerticalAlignment="Center"
                          FontSize="11.5"
                          Foreground="{StaticResource DialogTextSecondaryBrush}"
                          IsChecked="{Binding RequireRecommendedPairs, Mode=TwoWay}"
                          ToolTip="关掉后 3 组也能解，但三组解出的旋转几乎不可复核，抓取会偏" />

                <CheckBox Content="写入标定资产"
                          Margin="12,0,6,0"
                          VerticalAlignment="Center"
                          FontSize="11.5"
                          Foreground="{StaticResource DialogTextSecondaryBrush}"
                          IsChecked="{Binding SaveToCatalog, Mode=TwoWay}"
                          ToolTip="运行成功后把 4×4 写进方案标定资产目录：资产页可版本回滚，下游也能按 Id 引用" />

                <TextBox Width="150"
                         VerticalAlignment="Center"
                         Style="{StaticResource DialogInput}"
                         IsEnabled="{Binding SaveToCatalog}"
                         Text="{Binding CatalogAssetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="资产名（留空 = 步骤名 + 手眼标定）" />
            </WrapPanel>
        </DockPanel>

        <!-- ============ 成对数据表 ============ -->
        <Border Grid.Row="1" Style="{StaticResource PluginCard}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="SamplesGrid"
                          ItemsSource="{Binding Samples}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="All"
                          RowHeight="30"
                          ColumnHeaderHeight="34"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          FontSize="12"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource DialogBorderLightBrush}"
                          Background="{StaticResource DialogSurfaceBrush}"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="CellOrRowHeader"
                          Style="{StaticResource DialogDataGrid}"
                          LoadingRow="SamplesGrid_LoadingRow"
                          PreviewKeyDown="SamplesGrid_PreviewKeyDown"
                          ToolTip="一行 = 一组「机器人位姿 ↔ 相机位姿」。位置 mm、角度度、姿态 ZYX 欧拉&#10;可以从 Excel 复制一片单元格，选中左上角那一格按 Ctrl+V 粘贴">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DialogDataGridRow}">
                            <Style.Triggers>
                                <!-- 12 个格全 0 = 加了行但没填：整行淡黄，求解前一眼能看出还差哪行 -->
                                <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.RowHeaderStyle>
                        <Style TargetType="DataGridRowHeader">
                            <Setter Property="Width" Value="34" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                        </Style>
                    </DataGrid.RowHeaderStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DialogDataGridColumnHeader}">
                            <Setter Property="Height" Value="34" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalContentAlignment" Value="Right" />
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!--
                      列必须显式包在 DataGrid.Columns 里：不包的话 XAML 会把 DataGridColumn
                      当成 Items 的内容（实测 Items.Count=13 / Columns.Count=0），随后
                      ItemsSource 一绑定就抛「在使用 ItemsSource 之前，项集合必须为空」。
                      本仓既有表格（GlobalVariableView / DeviceVariableImportView / FlowManagerView）
                      全都显式写 DataGrid.Columns。
                    -->
                    <DataGrid.Columns>
                    <!-- 12 个数值列：表头与 [Display(Name)] 一字不差（HandEyeChecks 会核这件事）。
                         ValidatesOnExceptions：手打一个非数字时单元格变红并停在原值，
                         而不是"看起来改成功了、其实没写进去"。 -->
                    <DataGridTextColumn Header="机器人 X" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="RobotX" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="机器人 Y" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="RobotY" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="机器人 Z" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="RobotZ" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="机器人 Rx" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="RobotRx" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="机器人 Ry" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="RobotRy" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="机器人 Rz" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="RobotRz" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="相机 X" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="CameraX" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="相机 Y" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="CameraY" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="相机 Z" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="CameraZ" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="相机 Rx" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="CameraRx" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="相机 Ry" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="CameraRy" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="相机 Rz" Width="*" MinWidth="72"
                                        ElementStyle="{StaticResource NumCellStyle}"
                                        CellStyle="{StaticResource NumCellHostStyle}"
                                        EditingElementStyle="{StaticResource NumEditStyle}">
                        <DataGridTextColumn.Binding>
                            <Binding Path="CameraRz" StringFormat="{}{0:F3}" UpdateSourceTrigger="LostFocus"
                                     ValidatesOnExceptions="True" NotifyOnValidationError="True" />
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="38" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowDeleteButtonStyle}"
                                        Content="&#215;"
                                        Command="{Binding DataContext.RemoveSampleCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空态：盖住表格区域。表尾的「＋ 加一行」在空态是隐藏的，
                     所以这里必须自带两个入口，否则提示"加一行"却无处可点。 -->
                <Border x:Name="EmptyOverlay"
                        Background="{StaticResource DialogSurfaceBrush}"
                        Padding="24">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSamples}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="还没有成对数据"
                                   Style="{StaticResource DialogEmptyStateTitle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,14"
                                   Text="一组 = 机器人走到某个位姿 + 相机在该位姿下测到的位姿，至少 3 组，建议 6 组以上" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PluginPrimaryButton}"
                                    Content="＋ 加一行"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddSampleCommand}" />
                            <Button Style="{StaticResource PluginButton}"
                                    Content="导入 CSV"
                                    Click="ImportCsv_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 表尾 ============ -->
        <DockPanel Grid.Row="2" LastChildFill="True" Margin="2,8,2,0">
            <Border DockPanel.Dock="Right" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <!--
                        窄窗口只露出一部分列（12 列共 884px，640 档可视 597px），而浅色主题下 12px 的
                        横向滚动条几乎看不见 —— 不给句话，用户会以为「相机 Rz」之后没有列了。
                    -->
                    <TextBlock x:Name="NarrowHint"
                               Style="{StaticResource HintTextStyle}"
                               Visibility="Collapsed"
                               Text="窄窗口：表格可左右滑动，右侧还有 4 列" />
                    <!--
                        采集进度：条 + 文字同一口径（都算"有效组数"，不含加了行没填的）。
                        空表时整块不显示 —— 没有数据就没有进度可言，摆一条空槽只是在占地方。
                    -->
                    <Border Background="Transparent" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSamples}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ProgressBar Style="{StaticResource SampleProgressStyle}"
                                     Value="{Binding SampleProgress, Mode=OneWay}"
                                     ToolTip="{Binding SampleCountHint}" />
                    </Border>
                    <TextBlock x:Name="TableFootHint"
                               Style="{StaticResource HintTextStyle}"
                               Text="{Binding SampleCountHint}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PluginButton}"
                        Content="＋ 加一行"
                        Command="{Binding AddSampleCommand}"
                        ToolTip="在表尾追加一行空记录，逐格填数" />
            </StackPanel>
        </DockPanel>

        <!-- ============ 结果区（只在解出来时出现） ============ -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource PluginCard}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewOk}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <Border DockPanel.Dock="Right" Background="Transparent">
                        <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding PreviewMeta}" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="标定结果" Style="{StaticResource SectionTitleStyle}" Margin="0,0,8,0" />
                        <Border Style="{StaticResource ResultChipStyle}">
                            <TextBlock Text="{Binding PreviewStatusText}" Style="{StaticResource ResultChipTextStyle}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="旋转残差 RMS" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding PreviewRotationRmsText}" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Style="{StaticResource HintTextStyle}">
                            <Run Text="上限" /><Run Text=" " /><Run Text="{Binding MaxRotationRmsDeg, Mode=OneWay, StringFormat={}{0:0.###}}" /><Run Text="°" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="平移残差 RMS" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding PreviewTranslationRmsText}" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Style="{StaticResource HintTextStyle}">
                            <Run Text="上限" /><Run Text=" " /><Run Text="{Binding MaxTranslationRmsMm, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text=" mm" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,14,0">
                        <TextBlock Text="参与组数" Style="{StaticResource KpiLabelStyle}" />
                        <TextBlock Text="{Binding PreviewUsedPairsText}" Style="{StaticResource KpiValueStyle}" />
                        <TextBlock Text="第一组作为基准" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>

                    <!-- 4×4：用网格而不是空格对齐（空格对齐在等宽字体下也排不齐小数点） -->
                    <Border Grid.Column="3"
                            Background="{StaticResource DialogRowAlternateBrush}"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="变换矩阵（4×4，行主序）" Style="{StaticResource KpiLabelStyle}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Style="{StaticResource MatrixAxisStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" Style="{StaticResource MatrixAxisStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" Style="{StaticResource MatrixAxisStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="—" Style="{StaticResource MatrixAxisStyle}" />

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PreviewMatrixCells[0]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PreviewMatrixCells[1]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PreviewMatrixCells[2]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding PreviewMatrixCells[3]}" Style="{StaticResource MatrixCellStyle}" />

                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PreviewMatrixCells[4]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PreviewMatrixCells[5]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PreviewMatrixCells[6]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding PreviewMatrixCells[7]}" Style="{StaticResource MatrixCellStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewMatrixCells[8]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PreviewMatrixCells[9]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding PreviewMatrixCells[10]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding PreviewMatrixCells[11]}" Style="{StaticResource MatrixCellStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PreviewMatrixCells[12]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding PreviewMatrixCells[13]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding PreviewMatrixCells[14]}" Style="{StaticResource MatrixCellStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding PreviewMatrixCells[15]}" Style="{StaticResource MatrixCellStyle}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       MaxWidth="240"
                                       Text="{Binding PreviewMatrixCaption}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ 失败块（只在解不出来 / 超门槛时出现） ============ -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="12,10"
                CornerRadius="{StaticResource PluginCardCornerRadius}"
                BorderThickness="1"
                Background="{StaticResource DialogDangerSubtleBrush}"
                BorderBrush="{StaticResource DialogDangerBorderBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewFailed}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="&#xf071;"
                               FontFamily="{StaticResource DialogIconFont}"
                               FontSize="12"
                               Foreground="{StaticResource DialogDangerTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="没解出来" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource DialogDangerTextBrush}" />
                    <Border Style="{StaticResource ResultChipStyle}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding PreviewStatusText}" Style="{StaticResource ResultChipTextStyle}" />
                    </Border>
                </StackPanel>
                <TextBox Text="{Binding PreviewError, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="{StaticResource PluginMonoFontFamily}"
                         FontSize="12"
                         Foreground="{StaticResource DialogTextPrimaryBrush}" />
                <TextBlock Style="{StaticResource HintTextStyle}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="求解失败时 Transform 端口被置空、指标归零；质量门槛失败时指标保留真实值（供现场判读），Transform 仍为空——上一次的解不会留在流程里被下游误用。" />
            </StackPanel>
        </Border>

        <!-- ============ 过期块（方案里存着上次结论，但数据/门槛已改） ============
             与失败块同占第 4 行：两者互斥（IsPreviewFailed 与 IsPreviewStale 不可能同时为真），
             同一行只画其中一个。配色走 amber 而不是红 —— 这不是错，只是"旧的不能用了"。 -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="12,10"
                CornerRadius="{StaticResource PluginCardCornerRadius}"
                BorderThickness="1"
                Background="{StaticResource DialogWarningSubtleBrush}"
                BorderBrush="{StaticResource DialogWarningBorderBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewStale}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource PluginButton}"
                            Height="28"
                            Padding="12,0"
                            Content="重新求解"
                            Command="{Binding SolveCommand}"
                            ToolTip="用当前数据重算一遍（改完数据后点这个）" />
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xf017;"
                                   FontFamily="{StaticResource DialogIconFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource DialogWarningTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="结果已过期" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource DialogWarningTextBrush}" />
                        <Border Style="{StaticResource ResultChipStyle}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding PreviewStatusText}" Style="{StaticResource ResultChipTextStyle}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{Binding PreviewStaleText}" />
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="旧矩阵故意不显示：它不对应当前这份数据，摆出来就是在骗人。" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 下一步提示（只在解出来时出现） ============ -->
        <Border Grid.Row="5"
                Margin="0,10,0,0"
                Padding="10,7"
                CornerRadius="6"
                BorderThickness="1"
                Background="{StaticResource DialogAccentSoftBrush}"
                BorderBrush="{StaticResource DialogAccentBorderBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewOk}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Style="{StaticResource HintTextStyle}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource DialogAccentTextBrush}">
                <Run Text="下一步：把" /><Run Text=" Transform " FontWeight="SemiBold" /><Run Text="接到" /><Run Text=" PoseTransform " FontWeight="SemiBold" /><Run Text="做运行期换算；也可以拿这里的矩阵去核对抓取点偏差。" />
                <LineBreak />
                <Run Text="矩阵核对不上时，先怀疑" /><Run Text="装法" FontWeight="SemiBold" /><Run Text="选错（症状是抓取点整体镜像），再怀疑姿态单位/欧拉约定。" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
