<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0-windows</TargetFrameworks>
    <RootNamespace>Plugin.HandEye</RootNamespace>
    <AssemblyName>Plugin.HandEye</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 配置界面是 WPF 视图（HandEyeView.xaml），必须开 UseWPF -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!--
      源生成器产出的 StepConfig partial 文件不带 using，
      [StepConfig] 用到 Core.Interfaces 里的枚举（HandEyePoseKind）时必须让全局可见。
    -->
    <Using Include="Core.Interfaces" />
  </ItemGroup>

  <!-- 工程必须放在 Plugins\\ 子树内：Directory.Build.targets 按目录生效，负责把 DLL 投递到 Modules\\ -->
  <ItemGroup>
    <ProjectReference Include="..\\..\\Shard\\Core.Interfaces\\Core.Interfaces.csproj" />
    <!-- 命令基类 RelayCommand（Core.Commands）：本仓公共基础设施，不许各插件自带副本 -->
    <ProjectReference Include="..\\..\\Shard\\Core.Controls\\Core.Controls.csproj" />
    <!--
      视图就地合并 /UI;component/Themes/Generic.xaml（颜色令牌 + DataGrid/对话框样式）。
      与 Plugin.CaliperMeasure / Plugin.DlClassify 同一写法：引用它，Pack URI 才能在
      没有 Application 的断言宿主里也解析到（R22 同族）。
    -->
    <ProjectReference Include="..\\..\\UI\\Controls\\UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Help\\**\\*" />
  </ItemGroup>

</Project>
