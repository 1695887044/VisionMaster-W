<UserControl
    x:Class="Plugin.CreateRoi.CreateRoiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.CreateRoi"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    Height="600"
    Width="1000"
    xmlns:ui="http://schemas.UI.com/ui">
    <UserControl.InputBindings>
        <!--  Del 删除选中 ROI（CanExecute 守卫：焦点在文本框时不触发）  -->
        <KeyBinding Command="{Binding DeleteSelectedCommand}" Key="Delete" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:SmearModeConverter x:Key="SmearModeEq" />

            <!--
                本视图不再定义任何样式/颜色：卡片、标题、提示文字、ROI 列表行一律取自
                UI 库的 Plugin* 公共样式（PluginCard / PluginCardTitle / PluginHintText / PluginListBoxItem）。
                与 CaliperMeasure/BlobDetect 用的是同一个键，改一次主题三张卡片一起变。
            -->
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="{StaticResource PluginViewMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左列：参数卡片流  -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  卡片：图像输入  -->
            <Border Style="{StaticResource PluginCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PluginCardTitle}" Text="图像输入" />
                    <cv:LinkableValueEditor
                        Margin="{StaticResource PluginFirstRowMargin}"
                        HorizontalAlignment="Stretch"
                        Label="图像路径"
                        Port="{Binding SrcImage}"
                        StepData="{Binding StepData}" />
                    <StackPanel Margin="{StaticResource PluginFirstRowMargin}" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="显示窗口" />
                        <ComboBox
                            Width="120"
                            Margin="8,0,0,0"
                            HorizontalContentAlignment="Center"
                            SelectedIndex="{Binding DisplayViewIndex}"
                            ToolTip="结果显示到主界面几号视图窗口；0 = 不显示">
                            <ComboBoxItem Content="不显示" />
                            <ComboBoxItem Content="窗口1" />
                            <ComboBoxItem Content="窗口2" />
                            <ComboBoxItem Content="窗口3" />
                            <ComboBoxItem Content="窗口4" />
                            <ComboBoxItem Content="窗口5" />
                            <ComboBoxItem Content="窗口6" />
                            <ComboBoxItem Content="窗口7" />
                            <ComboBoxItem Content="窗口8" />
                            <ComboBoxItem Content="窗口9" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  卡片：参数微调（绑定 SelectedRoi.ParamEntries，纯绑定无 code-behind）  -->
            <Border Grid.Row="1" Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource PluginCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="参数微调" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource PluginHintText}"
                            Text="{Binding SelectedRoi.Name, TargetNullValue='选中 ROI 后可编辑'}" />
                    </Grid>
                    <ItemsControl Margin="{StaticResource PluginSectionMargin}" ItemsSource="{Binding SelectedRoi.ParamEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource PluginHintTextBrush}"
                                        Text="{Binding Name}" />
                                    <TextBox
                                        Grid.Column="1"
                                        Height="{StaticResource PluginControlHeight}"
                                        Padding="{StaticResource PluginNumericBoxPadding}"
                                        VerticalContentAlignment="Center"
                                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  卡片：ROI 列表  -->
            <Border Grid.Row="2" Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource PluginCard}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="ROI 列表" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource PluginHintText}"
                            Text="右键图像 → 区域 → 新建" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource PluginSectionMargin}" Orientation="Horizontal">
                        <Button
                            MinWidth="76"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="删除" />
                        <Button
                            MinWidth="76"
                            Margin="8,0,0,0"
                            Command="{Binding ClearRoisCommand}"
                            Content="清空" />
                    </StackPanel>
                    <ListBox
                        Margin="{StaticResource PluginFirstRowMargin}"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="DisplayText"
                        ItemContainerStyle="{StaticResource PluginListBoxItem}"
                        ItemsSource="{Binding RoiList}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedRoi}"
                        local:ListBoxAutoScroll.Enabled="True" />
                </DockPanel>
            </Border>

            <!--  操作提示  -->
            <Border Grid.Row="3" Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource PluginCard}">
                <TextBlock Style="{StaticResource PluginHintText}" Text="拖拽句柄粗调，参数微调精调；选中后按 Del 快速删除" />
            </Border>
        </Grid>

        <!--  右列：图像编辑区  -->
        <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PluginCard}">
            <DockPanel>
                <!--  掩膜预览工具条  -->
                <Border
                    DockPanel.Dock="Top"
                    Padding="0,0,0,8"
                    BorderBrush="{StaticResource PluginDividerBrush}"
                    BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <!--  原图：OneWay 只做显示（避免组互斥回写打架），真值由"掩膜预览"单点写回  -->
                            <RadioButton
                                Content="原图"
                                GroupName="PreviewMode"
                                IsChecked="{Binding IsMaskPreview, Converter={StaticResource InverseBool}, Mode=OneWay}" />
                            <RadioButton
                                Margin="8,0,0,0"
                                Content="掩膜预览"
                                GroupName="PreviewMode"
                                IsChecked="{Binding IsMaskPreview, Mode=TwoWay}" />
                        </StackPanel>
                        <CheckBox
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Content="排除模式（ROI 外有效）"
                            IsChecked="{Binding MaskInvert}" />
                    </DockPanel>
                </Border>
                <!--  涂擦工具条：模式/笔刷是控件自有交互态，直连 ImageEdit 的 DP（ElementName 绑定，不经 VM）  -->
                <Border
                    DockPanel.Dock="Top"
                    Padding="0,6,0,8"
                    BorderBrush="{StaticResource PluginDividerBrush}"
                    BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Content="正常"
                            GroupName="SmearMode"
                            IsChecked="{Binding SmearMode, ElementName=ImageEditor, Converter={StaticResource SmearModeEq}, ConverterParameter=None, Mode=TwoWay}" />
                        <RadioButton
                            Margin="8,0,0,0"
                            Content="绘制涂抹"
                            GroupName="SmearMode"
                            IsChecked="{Binding SmearMode, ElementName=ImageEditor, Converter={StaticResource SmearModeEq}, ConverterParameter=Draw, Mode=TwoWay}" />
                        <RadioButton
                            Margin="8,0,0,0"
                            Content="擦除涂抹"
                            GroupName="SmearMode"
                            IsChecked="{Binding SmearMode, ElementName=ImageEditor, Converter={StaticResource SmearModeEq}, ConverterParameter=Erase, Mode=TwoWay}" />
                        <TextBlock
                            Margin="16,0,4,0"
                            VerticalAlignment="Center"
                            Text="笔刷:" />
                        <TextBox
                            Width="40"
                            Text="{Binding BrushRadius, ElementName=ImageEditor, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="笔刷半径（像素）" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding ClearSmearCommand}"
                            Content="清除涂抹" />
                    </StackPanel>
                </Border>
                <!--  图像编辑器：功能全部由控件 DP 提供，插件只做绑定与回传  -->
                <h:ImageEdit
                    x:Name="ImageEditor"
                    ActiveRoi="{Binding CanvasActiveRoi, Mode=TwoWay}"
                    DrawObjectList="{Binding CanvasRois}"
                    HImage="{Binding DisplayImage, Mode=OneWay}"
                    SmearDraw="{Binding SmearDraw, Mode=TwoWay}"
                    SmearErase="{Binding SmearErase, Mode=TwoWay}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
