<UserControl
    x:Class="Plugin.DlClassify.ClassifyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:UI.CustomControl;assembly=UI"
    Width="980"
    Height="620"
    d:DesignHeight="620"
    d:DesignWidth="980"
    mc:Ignorable="d">

    <!--
        深度学习分类的配置视图。与 Plugin.Yolo / Plugin.Ocr 同范式：左参数、右图像。
        本节点**不吃 ROI**（分类整幅图；要只分某个区域，请上游先用创建ROI裁好），
        所以右侧用只读的 ImageReadOnly，不给框选能力 —— 免得让人以为能框。

        界面上刻意显示两处"排障用的信息"，它们不是装饰：
          · 模型摘要（输入输出形状 / task / 类别名）—— 模型选错时这里是唯一线索；
          · 试算结果里的 TopK 概率 —— 置信度没区分度时（softmax 做重了）先看这里。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ParamLabel" TargetType="TextBlock" BasedOn="{StaticResource PluginHintText}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource PluginLabelTextBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ── 图像输入：配置窗口内直接链接上游，不必回画布拖线 ──  -->
                <Border Margin="0,0,0,8" Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="图像输入" />
                        <cv:LinkableValueEditor
                            Margin="{StaticResource PluginFirstRowMargin}"
                            HorizontalAlignment="Stretch"
                            Label="输入图像"
                            Port="{Binding Image}"
                            StepData="{Binding StepData}" />
                    </StackPanel>
                </Border>

                <!--  ── 模型 ──  -->
                <Border Margin="0,0,0,8" Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="分类模型（.onnx）" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Height="24"
                                Padding="4,0,0,0"
                                VerticalContentAlignment="Center"
                                Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Width="56"
                                Margin="6,0,0,0"
                                Style="{StaticResource PluginButton}"
                                Click="OnBrowseModelClick"
                                Content="浏览" />
                        </Grid>

                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource PluginHintText}"
                            Text="支持相对路径（相对宿主程序目录），换机器部署时不用改配置。" />

                        <TextBlock
                            Margin="0,8,0,0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{StaticResource PluginTitleTextBrush}"
                            Text="{Binding ModelSummary}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource PluginHintText}"
                            Text="只支持「图像分类」模型。检测 / 分割模型的输出格式不同，会被明确拒绝（不会拿错格式硬算）。" />
                    </StackPanel>
                </Border>

                <!--  ── 分类参数 ──  -->
                <Border Margin="0,0,0,8" Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="分类参数" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource ParamLabel}"
                            Text="缩放模式"
                            ToolTip="Letterbox = 等比缩放 + 补边（默认，不改变长宽比，最稳）；Stretch = 直接拉成方形。选错会让精度静默下降 —— 按你训练该模型时的预处理来选。" />
                        <ComboBox
                            Height="24"
                            Margin="0,4,0,0"
                            ItemsSource="{Binding ResizeModeOptions}"
                            SelectedItem="{Binding ResizeMode}" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource ParamLabel}"
                            Text="结果保留前 K 类"
                            ToolTip="试算结果与 TopKText 里列出前 K 个类别。K 会被夹到 [1, 类别数]。" />
                        <ui:NumericBox
                            Minimum="1"
                            Maximum="100"
                            DecimalPlaces="0"
                            Style="{StaticResource PluginNumericBox}"
                            Value="{Binding TopK, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!--  ── 高级参数（折叠）  ──  -->
                <Expander Margin="0,0,0,8" Header="高级参数（多数场景不用动）">
                    <Border Margin="0,8,0,0" Style="{StaticResource PluginCard}">
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource ParamLabel}"
                                Text="输入尺寸（0 = 用模型自带的）"
                                ToolTip="模型输入边长。模型元数据里有静态尺寸时留 0 即可；模型是动态形状才需要手填（分类模型常见 224）。" />
                            <ui:NumericBox
                                Minimum="0"
                                Maximum="4096"
                                DecimalPlaces="0"
                                Style="{StaticResource PluginNumericBox}"
                                Value="{Binding InputSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                </Expander>

                <!--  ── 试算 ──  -->
                <Border Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="试算" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource PluginHintText}"
                            Text="图像来自上方「图像输入」：链接上游输出、或手动指定一张图；绑定后点「执行」跑一遍，图会自动显示进来" />

                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PluginButton}"
                            Click="OnTryClassifyClick"
                            Content="试算一下" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource PluginHintText}"
                            Text="{Binding Hint}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontFamily="Consolas"
                            FontSize="11"
                            Foreground="{StaticResource PluginTitleTextBrush}"
                            Text="{Binding ResultSummary}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  右侧：只读显示。本节点分类整幅图，不吃 ROI，所以刻意不用可框选的控件  -->
        <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PluginCard}">
            <h:ImageReadOnly HImage="{Binding DisplayImage, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>
