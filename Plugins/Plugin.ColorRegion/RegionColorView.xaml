<UserControl
    x:Class="Plugin.ColorRegion.RegionColorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.ColorRegion"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    MinWidth="560"
    MinHeight="320"
    d:DesignHeight="520"
    d:DesignWidth="920"
    mc:Ignorable="d">

    <!--
        区域颜色检查的配置视图（Web 基线 v1 复刻）。

        功能契约一个都没有变：
          · DataContext 仍是插件实例（宿主靠它取 IPluginConfigView.OnConfirm）；
          · LinkableValueEditor 仍绑 Image 端口 / StepData；
          · ImageEdit 常驻，HImage / DrawObjectList / ActiveRoi 三条绑定原样；
          · ExpectedColors / MinShare / SamplePoints / DisplayViewIndex / 13 项阈值仍走原属性名；
          · 三个动作仍是插件既有的 ClearRoi / TryPreviewAnalyze / ApplyPreviewAsExpected。
        视图只负责布局、命令转发与三态着色，不写任何颜色算法或 ROI 业务。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:Array x:Key="ViewIndexes" Type="system:Int32">
                <system:Int32>0</system:Int32>
                <system:Int32>1</system:Int32>
                <system:Int32>2</system:Int32>
                <system:Int32>3</system:Int32>
                <system:Int32>4</system:Int32>
                <system:Int32>5</system:Int32>
                <system:Int32>6</system:Int32>
                <system:Int32>7</system:Int32>
                <system:Int32>8</system:Int32>
                <system:Int32>9</system:Int32>
            </x:Array>

            <local:RoiShapeLabelConverter x:Key="RoiShapeLabelConverter" />
            <local:ResultToneConverter x:Key="ResultToneConverter" />
            <local:ViewIndexLabelConverter x:Key="ViewIndexLabelConverter" />

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ShapeChipStyle" TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ResultPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Warning">
                        <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Error">
                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResultTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="MinHeight" Value="86" />
                <Setter Property="MaxHeight" Value="150" />
                <Setter Property="IsTabStop" Value="False" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Warning">
                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Error">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,0,13" />
                <Setter Property="Background" Value="{StaticResource PluginPreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PluginPreviewBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
            </Style>

            <Style x:Key="EmptyStateSubStyle" TargetType="TextBlock">
                <Setter Property="MaxWidth" Value="330" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左配置轨（1*，300~356）+ 右采样画布（1.6*）。
        960 宿主内容区约 920 → 左 354 / 右 550；640 宿主内容区约 600 → 左 300 / 右 284。
        所有颜色/字号走 UI 公共令牌，视图内不写十六进制。
    -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="356" />
            <ColumnDefinition Width="1.6*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：配置轨 ================= -->
        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="14"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <!-- 图像输入 -->
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="图像输入" />
                    <TextBlock
                        Margin="0,9,0,6"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="上游图像" />
                    <cc:LinkableValueEditor
                        x:Name="ImageInput"
                        HorizontalAlignment="Stretch"
                        Label=""
                        Port="{Binding Image}"
                        StepData="{Binding StepData}" />
                    <TextBlock
                        Style="{StaticResource HelpTextStyle}"
                        Text="点 🔗 绑定上游 Image 输出或变量；绑定后点「执行」，图会自动带进右侧画布。本算子不提供「载入本地图」。" />

                    <!-- 采样区 -->
                    <Border
                        Margin="0,14,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource ShapeChipStyle}">
                                    <TextBlock
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                        Text="{Binding RoiShape, Converter={StaticResource RoiShapeLabelConverter}}" />
                                </Border>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="采样区" />
                            </DockPanel>

                            <Border
                                Margin="0,9,0,0"
                                Padding="10,9"
                                Background="{StaticResource DialogSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <TextBlock
                                    FontFamily="Consolas, Microsoft YaHei"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding RoiSummary}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <Button
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ClearRoiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="清空采样区"
                                Style="{StaticResource LocalButtonStyle}" />

                            <TextBlock
                                Style="{StaticResource HelpTextStyle}"
                                Text="在右侧画布右键 → 新建矩形 / 圆形 / 椭圆；圆形指示灯请用圆形，方框的四个角会把背景投进主色。" />
                        </StackPanel>
                    </Border>

                    <!-- 检查参数 -->
                    <Border
                        Margin="0,14,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="检查参数" />

                            <TextBlock
                                Margin="0,9,0,6"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="期望颜色" />
                            <TextBox
                                x:Name="ExpectedColorsBox"
                                Height="36"
                                Style="{StaticResource DialogInput}"
                                Text="{Binding ExpectedColors, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="例如 红,玫红。颜色词只有 黑/白/灰/棕/红/玫红/橙/黄/绿/蓝/紫 才认得出来" />
                                </TextBox.ToolTip>
                            </TextBox>
                            <TextBlock
                                Style="{StaticResource HelpTextStyle}"
                                Text="多个用逗号分隔，命中任一即可；写 * 表示只报颜色不判定。" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource FieldLabelStyle}"
                                    Text="最小占比"
                                    ToolTip="主色至少占这么多才算合格；占比不足会判「颜色不纯」" />
                                <TextBox
                                    Grid.Column="1"
                                    Height="36"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding MinShare}"
                                    TextAlignment="Right"
                                    ToolTip="默认 0.6（60%）。区域里有反光 / 边界过渡时适当调低" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource HelpTextStyle}"
                                Text="0~1，默认 0.6（60%）；区域里有反光 / 边界过渡时适当调低。" />

                            <Button
                                Margin="0,12,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding TryAnalyzeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="试算一下"
                                Style="{StaticResource LocalPrimaryButtonStyle}"
                                ToolTip="用画布里的上游图跑一遍，看这块区域的主色、占比与明细" />

                            <Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ApplyExpectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="把主色填成期望颜色"
                                Style="{StaticResource LocalButtonStyle}"
                                ToolTip="拿一张已知良品的图点「试算一下」，再点这里 —— 省得手打颜色词打错" />

                            <Border Style="{StaticResource ResultPanelStyle}">
                                <TextBox
                                    Style="{StaticResource ResultTextStyle}"
                                    Text="{Binding ResultSummary, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 高级参数 -->
                    <Border
                        Margin="0,14,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Expander FontSize="12" Header="高级参数">
                            <StackPanel Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="采样点数上限"
                                        ToolTip="区域内最多取多少点投票；点太多时按步长均匀抽稀" />
                                    <TextBox
                                        Grid.Column="1"
                                        Height="36"
                                        Style="{StaticResource DialogInput}"
                                        Text="{Binding SamplePoints}"
                                        TextAlignment="Right"
                                        ToolTip="默认 400。区域很大时不必调大 —— 抽稀是均匀的，投票不会偏" />
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="默认 400；区域很大时不必调大，抽稀是均匀的，投票不会偏。" />

                                <TextBlock
                                    Margin="0,12,0,6"
                                    Style="{StaticResource FieldLabelStyle}"
                                    Text="投射视图窗口"
                                    ToolTip="结果画到主界面哪个视图窗口（1~9）；填 0 = 不投射" />
                                <ComboBox
                                    Height="36"
                                    Style="{StaticResource DialogCombo}"
                                    ItemsSource="{StaticResource ViewIndexes}"
                                    SelectedItem="{Binding DisplayViewIndex, Mode=TwoWay}">
                                    <ComboBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="结果画到主界面哪个视图窗口（1~9）；0 = 不投射" />
                                    </ComboBox.ToolTip>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ViewIndexLabelConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="0 = 不投射；1~9 对应主界面视图窗口。" />

                                <Border
                                    Margin="0,12,0,0"
                                    Padding="0,10,0,0"
                                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <TextBlock
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="颜色判据阈值"
                                            ToolTip="把实测颜色归到哪个颜色词用的阈值；本算子带一份可覆盖的副本，随方案落盘" />
                                        <TextBlock
                                            Style="{StaticResource HelpTextStyle}"
                                            Text="13 项阈值随方案落盘；默认值来自颜色内核，所有颜色算子共用同一套颜色词。" />
                                        <cc:ColorThresholdEditor Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- 用法 -->
                    <Border
                        Margin="0,14,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Expander FontSize="12" Header="怎么用">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="① 在流程里把本节点的 Image 连到上游；② 打开本窗口点「执行」，上游图像显示在右侧；③ 在图上右键 → 新建矩形 / 圆形 / 椭圆，框住要检的那块；④ 填期望颜色，再点「执行」或「试算一下」核对。" />
                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="第一次点「执行」会报「尚未框选采样区」——那是对的：此时图已经上屏，框完再执行一次即可。" />
                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="本算子认「一块区域是什么颜色」（不看顺序）；要检线序、排线、一排色带的顺序，请用「颜色序列检查」。两者共用同一套颜色词与判据。" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= 右：采样画布 ================= -->
        <Border
            Grid.Column="1"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!-- 画布头：标题 + 只读/ROI 标识 + 工具条 -->
                <Grid Grid.Row="0" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="&#xf53f;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="采样画布" />
                        <TextBlock
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="上游图像 · ROI 编辑" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="FitWindow_Click"
                            Content="&#xf065;">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="适应窗口" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Margin="2,0,0,0"
                            Style="{StaticResource ToolbarTextButtonStyle}"
                            Click="FitImage_Click"
                            Content="1:1">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="实际像素 1:1" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 画布：ImageEdit 常驻；无图时用覆盖层，不折叠控件 -->
                <Border Grid.Row="1" Background="{StaticResource PluginPreviewCanvasBrush}">
                    <Grid>
                        <h:ImageEdit
                            x:Name="ImageEditor"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ActiveRoi="{Binding CanvasActiveRoi, Mode=TwoWay}"
                            DrawObjectList="{Binding CanvasRois}"
                            HImage="{Binding DisplayImage, Mode=OneWay}" />

                        <!-- 角标：有图时提示 ROI 入口 -->
                        <Border
                            Margin="10"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{StaticResource DialogTextPrimaryBrush}"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogSurfaceBrush}"
                                Text="ROI 编辑 · 右键新建" />
                        </Border>

                        <!-- 空态：无上游图时覆盖在画布上；ImageEdit 本身保持常驻 -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid
                                MaxWidth="420"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Rectangle
                                    Fill="{StaticResource PluginPreviewSurfaceBrush}"
                                    Opacity="0.55"
                                    RadiusX="14"
                                    RadiusY="14"
                                    Stroke="{StaticResource PluginPreviewBorderBrush}"
                                    StrokeDashArray="3,3" />
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource EmptyStateIconStyle}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="20"
                                            Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                            Text="&#xf1c5;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="还没有上游图像" />
                                    <TextBlock Style="{StaticResource EmptyStateSubStyle}" Text="在左侧「图像输入」点 🔗 绑定上游 Image 端口或变量，再点「执行」把图带进画布。" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 状态栏：Hint + 当前采样区（本插件没有 StatusLevel，状态点固定为主色信息点） -->
                <Border
                    Grid.Row="2"
                    Padding="12,0"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Width="7"
                            Height="7"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource DialogAccentBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="{Binding Hint}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="RoiSummaryText"
                            Grid.Column="2"
                            MaxWidth="300"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas, Microsoft YaHei"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding RoiSummary}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
