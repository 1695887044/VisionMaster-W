<Project>

  <!--
    插件工程公共构建配置（MSBuild 会为 Plugins\ 下每个工程自动导入本文件）

    为什么需要它：
      各插件 csproj 原先裸用 $(SolutionDir)\Modules\ 作为投递目标。
      一旦构建入口是"单个 csproj"而不是 .sln——例如
        dotnet build Plugins\Plugin.X\Plugin.X.csproj
        IDE 直接打开工程 / CI 做工程粒度构建 / dotnet run 指定工程
      ——$(SolutionDir) 的值就是字面量 *Undefined*，而 * 是非法路径字符，
      拷贝命令必然硬失败（MSB3073），单工程构建链路全断。
      历史上没暴露，是因为这 9 个插件恰好都登记在 VisionMaster.sln 里。

    做法：把"产物投递到哪"收口成两个属性 + 一个目标，
          各插件 csproj 只需再声明自己的"私有依赖"投递。

    为什么是 .targets 而不是 .props：
      $(Configuration) 的默认值（Debug）由 Microsoft.Common.props 在导入
      Directory.Build.props **之后**才赋。HostBinDir 若写在 .props 里，
      会在导入时就被展开成 ...\bin\\net9.0-windows\（配置名缺失，资源落到垃圾目录）。
      Directory.Build.targets 导入得足够晚，此时 Configuration 已就位。
      原 csproj 把 $(ConfigurationName) 直接写在 Exec Command 里之所以没事，
      是因为那是在"目标执行时"展开——与本文件的时机一致。

    目录契约：Plugins\ 下的工程 = 插件；插件 DLL 一律投递到仓库根 Modules\，
              宿主 Engine.PluginService 只扫描 Modules\Plugin*.dll。
  -->

  <PropertyGroup>
    <!-- 插件产物投递目录：仓库根 Modules\（两种构建入口都指向同一处） -->
    <ModulesDir Condition="'$(SolutionDir)' == '' or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\Modules\</ModulesDir>
    <ModulesDir Condition="'$(ModulesDir)' == ''">$(SolutionDir)Modules\</ModulesDir>

    <!-- 宿主运行目录：供需要投递"运行期资源"的插件使用（如 ImageScript 的示例代码 ScriptAssets） -->
    <HostBinDir Condition="'$(SolutionDir)' == '' or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\VisionMaster\bin\$(Configuration)\net9.0-windows\</HostBinDir>
    <HostBinDir Condition="'$(HostBinDir)' == ''">$(SolutionDir)VisionMaster\bin\$(Configuration)\net9.0-windows\</HostBinDir>
  </PropertyGroup>

  <!-- 所有插件共同动作：把自身 DLL 投递到 Modules\，使插件即使不写进 .sln 也能被扫描装载 -->
  <Target Name="CopyPluginToModules" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModulesDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
