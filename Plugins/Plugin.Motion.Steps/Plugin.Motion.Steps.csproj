<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 流程步骤插件（L4 层）：用户在流程里拖的「轴使能 / 轴运动 / 轴回零 / 等待到位 / 读轴状态 / 轴停止 / 轴 IO」。
         纯托管、net9.0（不带 -windows）：这些步骤只调 Core.Interfaces 里的契约，
         真正的硬件差异全部留在驱动插件里（Plugin.Motion.*），本工程不该知道任何厂商 SDK。 -->
    <TargetFrameworks>net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只引用契约层：VisionPluginBase / InputPort / OutputPort / IMotionProvider 都在这里。
         刻意不引用宿主 exe，也不引用任何驱动工程 —— 步骤要能配任意品牌的卡。 -->
    <ProjectReference Include="..\..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      插件自带帮助手册：编进本程序集（宿主 HelpCatalogService 按 "<程序集名>.Help." 前缀约定发现，
      文件名顺序即手册页序，页标题取正文第一个一级标题）。
      本程序集里有 7 个步骤插件，所以手册按插件类名分子目录：Help\{插件类名}\01-overview.md，
      宿主会把"非本类型子目录"的页面自动排除（一个插件一册，互不串页）。
      改手册 = 重建本插件工程（与原代码改动同一口径，见 AGENTS.md 红线③）。
    -->
    <EmbeddedResource Include="Help\**\*" />
  </ItemGroup>

</Project>
