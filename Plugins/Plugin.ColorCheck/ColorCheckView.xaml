<UserControl
    x:Class="Plugin.ColorCheck.ColorCheckView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.ColorCheck"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    MinWidth="560"
    MinHeight="360"
    SizeChanged="OnViewSizeChanged"
    d:DesignHeight="560"
    d:DesignWidth="920"
    mc:Ignorable="d">

    <!--
        颜色序列检查的配置视图（Web 基线 v1 复刻）。

        功能契约一个都没有变：
          · DataContext 仍是插件实例（宿主靠它取 IPluginConfigView.OnConfirm）；
          · LinkableValueEditor 仍绑 Image 端口 / StepData；
          · ImageEdit 常驻，HImage / DrawObjectList / ActiveRoi 三条绑定原样；
          · ReverseSequence / WireCount / Regularize / 5 项序列参数 / ExtendEnds /
            DisplayViewIndex / 13 项阈值 / RecipeText 仍走原属性名；
          · 三个动作仍是插件既有的 ClearRoi / TryPreviewAnalyze / SavePreviewAsRecipe。
        视图只负责布局、命令转发与结果着色，不写任何颜色算法或 ROI 业务。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:Array x:Key="ViewIndexes" Type="system:Int32">
                <system:Int32>0</system:Int32>
                <system:Int32>1</system:Int32>
                <system:Int32>2</system:Int32>
                <system:Int32>3</system:Int32>
                <system:Int32>4</system:Int32>
                <system:Int32>5</system:Int32>
                <system:Int32>6</system:Int32>
                <system:Int32>7</system:Int32>
                <system:Int32>8</system:Int32>
                <system:Int32>9</system:Int32>
            </x:Array>

            <local:RoiStateConverter x:Key="RoiStateConverter" />
            <local:ResultToneConverter x:Key="ResultToneConverter" />
            <local:ViewIndexLabelConverter x:Key="ViewIndexLabelConverter" />

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionDividerStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Padding" Value="0,10,0,0" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 开关行：整行可点，右侧方框；不改变 CheckBox 的 IsChecked 语义 -->
            <Style x:Key="CheckCardStyle" TargetType="CheckBox">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border
                                x:Name="Bd"
                                Margin="0,0,0,8"
                                Padding="10,9"
                                Background="{StaticResource DialogSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                    <Border
                                        x:Name="Box"
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Margin="10,0,0,0"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            x:Name="CheckGlyph"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="9"
                                            Foreground="{StaticResource DialogSurfaceBrush}"
                                            Text="&#xf00c;"
                                            Visibility="Collapsed" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Box" Property="Background" Value="{StaticResource DialogAccentBrush}" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RoiChipStyle" TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasRoi}" Value="False">
                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RoiChipTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasRoi}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                        <Setter Property="FontWeight" Value="Normal" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResultPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Success">
                        <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Warning">
                        <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Error">
                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ResultTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="MinHeight" Value="86" />
                <Setter Property="MaxHeight" Value="170" />
                <Setter Property="IsTabStop" Value="False" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Success">
                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Warning">
                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ResultSummary, Converter={StaticResource ResultToneConverter}}" Value="Error">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,0,13" />
                <Setter Property="Background" Value="{StaticResource PluginPreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PluginPreviewBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
            </Style>

            <Style x:Key="EmptyStateSubStyle" TargetType="TextBlock">
                <Setter Property="MaxWidth" Value="330" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左配置轨（1*，300~356）+ 右采样画布（1.6*）。
        960 宿主内容区约 920 → 左 354 / 右 550；640 宿主内容区约 600 → 左 300 / 右 284。
        所有颜色/字号走 UI 公共令牌，视图内不写十六进制。
    -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="356" />
            <ColumnDefinition Width="1.6*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：配置轨 ================= -->
        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="14"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                        <!-- 图像输入 -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="图像输入" />
                        <TextBlock
                            Margin="0,9,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="上游图像" />
                        <cc:LinkableValueEditor
                            HorizontalAlignment="Stretch"
                            Label=""
                            Port="{Binding Image}"
                            StepData="{Binding StepData}" />
                        <TextBlock
                            Style="{StaticResource HelpTextStyle}"
                            Text="点 🔗 绑定上游 Image；点「执行」载入画布。" />

                        <!-- 采样区 -->
                        <Border Style="{StaticResource SectionDividerStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource RoiChipStyle}">
                                        <TextBlock
                                            Style="{StaticResource RoiChipTextStyle}"
                                            Text="{Binding HasRoi, Converter={StaticResource RoiStateConverter}}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="采样区" />
                                </DockPanel>

                                <Border
                                    Margin="0,9,0,0"
                                    Padding="10,9"
                                    Background="{StaticResource DialogSurfaceBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontFamily="Consolas, Microsoft YaHei"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="{Binding RoiSummary}"
                                        TextWrapping="Wrap" />
                                </Border>

                                <Button
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ClearRoiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="清空采样区"
                                    Style="{StaticResource LocalButtonStyle}" />

                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="右键 → 新建矩形框住线束；长轴沿线束、短轴采样。" />
                            </StackPanel>
                        </Border>

                        <!-- 检查参数 -->
                        <Border Style="{StaticResource SectionDividerStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="随方案落盘" />
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="检查参数" />
                                </DockPanel>

                                <CheckBox
                                    Margin="0,9,0,0"
                                    Content="序列反向"
                                    IsChecked="{Binding ReverseSequence}"
                                    Style="{StaticResource CheckCardStyle}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="勾上则把序列首尾对调：线束摆放方向与上次相反时用它，免得改框" />
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <CheckBox
                                    Content="等间距规整化"
                                    IsChecked="{Binding Regularize}"
                                    Style="{StaticResource CheckCardStyle}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="开：按估出的线距铺满整束，看不见的白线也能补出来；关：只报看得见的线（调参时用来对比）" />
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="线数（0 = 自动反推）"
                                        ToolTip="留 0 由算法按线距反推根数；填了正数就按这个根数展开（以检出范围的中点为基准）" />
                                    <TextBox
                                        Grid.Column="1"
                                        Height="36"
                                        FontFamily="Consolas, Microsoft YaHei"
                                        Style="{StaticResource DialogInput}"
                                        Text="{Binding WireCount}"
                                        TextAlignment="Right"
                                        ToolTip="默认 0：自动反推；填正数则按该根数展开" />
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="留 0 自动反推；填正数按该根数展开。" />

                                <Button
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding TryAnalyzeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="试算一下"
                                    Style="{StaticResource LocalPrimaryButtonStyle}"
                                    ToolTip="用画布当前这张图跑一遍（含右键 → 打开图片临时换的图），看几根、什么颜色、哪几根是补出来的；只试算，不改上游图像来源" />

                                <Border Style="{StaticResource ResultPanelStyle}">
                                    <TextBox
                                        Style="{StaticResource ResultTextStyle}"
                                        Text="{Binding ResultSummary, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 高级参数 -->
                        <Border Style="{StaticResource SectionDividerStyle}">
                            <Expander FontSize="12" Header="高级参数">
                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="暗线判据幅度 (%)"
                                            ToolTip="判定线 = 剖面众数亮度 减去 这个百分比 ×（众数亮度 − 最暗像素）" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="36"
                                            FontFamily="Consolas, Microsoft YaHei"
                                            Style="{StaticResource DialogInput}"
                                            Text="{Binding DarkSpanRatio}"
                                            TextAlignment="Right"
                                            ToolTip="默认 35%：比线间缝再暗 35% 的对比度幅度才算「可靠的暗线」。线色普遍偏浅时调小" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="默认 35%：比线间缝再暗 35% 的对比度幅度才算可靠的暗线。线色普遍偏浅时调小。" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="白线百分位"
                                            ToolTip="亮度高于这条百分位的行算「白线」；浅色背景被误当线时报的错就靠调小它避开" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="36"
                                            FontFamily="Consolas, Microsoft YaHei"
                                            Style="{StaticResource DialogInput}"
                                            Text="{Binding BrightPercentile}"
                                            TextAlignment="Right"
                                            ToolTip="默认 92：亮度最高的 8% 视为白线。日志出现「丢弃过长可靠区间」时把它调小" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="默认 92：亮度最高的 8% 视为白线。日志出现「丢弃过长可靠区间」时把它调小。" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="最小段长"
                                            ToolTip="连续多少行都可靠才算一根线，用来滤掉噪点" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="36"
                                            FontFamily="Consolas, Microsoft YaHei"
                                            Style="{StaticResource DialogInput}"
                                            Text="{Binding MinRun}"
                                            TextAlignment="Right"
                                            ToolTip="默认 4 行。图像噪声大时调大" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="默认 4 行：连续这么多行都可靠才算一根线，用来滤掉噪点。" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="最大段长比例"
                                            ToolTip="长过剖面长度这个比例的可靠段按背景丢弃；填 0 = 不做这个保护" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="36"
                                            FontFamily="Consolas, Microsoft YaHei"
                                            Style="{StaticResource DialogInput}"
                                            Text="{Binding MaxRunRatio}"
                                            TextAlignment="Right"
                                            ToolTip="默认 0.33：一根线不可能占掉剖面三分之一以上，占到了就是背景混进来了" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="默认 0.33：一根线不可能占掉剖面三分之一以上，占到了就是背景混进来了；填 0 = 不做保护。" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Style="{StaticResource FieldLabelStyle}"
                                            Text="补色窗口比例"
                                            ToolTip="给「补出来」的那几根取色时的窗口半宽，单位是线距的比例" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="36"
                                            FontFamily="Consolas, Microsoft YaHei"
                                            Style="{StaticResource DialogInput}"
                                            Text="{Binding RuleWindowRatio}"
                                            TextAlignment="Right"
                                            ToolTip="默认 0.30：取中心上下各 0.3 倍线距的范围求中位色。线间距很密时调小" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="默认 0.30：给「补出来」的那几根取色时的窗口半宽，单位是线距的比例；线距很密时调小。" />

                                    <CheckBox
                                        Margin="0,10,0,0"
                                        Content="端点外推"
                                        IsChecked="{Binding ExtendEnds}"
                                        Style="{StaticResource CheckCardStyle}">
                                        <CheckBox.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="允许在检出范围两端各多探一根（靠「那一格有没有起伏」判断）；只有线色均匀的单色线束才建议关掉" />
                                        </CheckBox.ToolTip>
                                    </CheckBox>

                                    <Border
                                        Margin="0,4,0,0"
                                        Padding="0,10,0,0"
                                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                                        BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock
                                                Style="{StaticResource FieldLabelStyle}"
                                                Text="颜色判据阈值"
                                                ToolTip="把实测颜色归到哪个颜色词用的阈值；本算子带一份可覆盖的副本，随方案落盘" />
                                            <TextBlock
                                                Style="{StaticResource HelpTextStyle}"
                                                Text="13 项阈值随方案落盘；默认值来自颜色内核，所有颜色算子共用同一套颜色词。" />
                                            <cc:ColorThresholdEditor Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- 配方 -->
                        <Border Style="{StaticResource SectionDividerStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="按实测根数匹配" />
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="配方" />
                                </DockPanel>
                                <TextBlock
                                    Margin="0,9,0,6"
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="一行一条：产品名 = 颜色1,颜色2,...　（井号开头是注释；颜色词只有 黑/白/灰/紫/蓝/绿/黄/红/玫红/橙 才认得出来；某一位写 * 表示这一位不检）" />
                                <TextBox
                                    x:Name="RecipeTextBox"
                                    Height="96"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas, Microsoft YaHei"
                                    FontSize="11"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding RecipeText, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalScrollBarVisibility="Auto" />
                                <Button
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SaveRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="把试算结果存成配方"
                                    Style="{StaticResource LocalButtonStyle}"
                                    ToolTip="拿一张已知良品的图点「试算一下」，再点这里 —— 省得手打颜色词打错" />
                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="运行期按实测根数匹配（期望序列的长度就是这条配方要求几根）；另有「期望序列」输入端口，端口填了就以端口为准。" />
                            </StackPanel>
                        </Border>

                        <!-- 怎么用 -->
                        <Border Style="{StaticResource SectionDividerStyle}">
                            <Expander FontSize="12" Header="怎么用">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="① 在流程里把本节点的 Image 连到上游；② 打开本窗口点「执行」，上游图像显示在右侧；③ 在图上右键 → 新建矩形，框住整条线束；④ 再点「执行」或「试算一下」核对结果。" />
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="第一次点「执行」会报「尚未框选采样区」——那是对的：此时图已经上屏，框完再执行一次即可。" />
                                    <TextBlock
                                        Style="{StaticResource HelpTextStyle}"
                                        Text="本算子认「一维颜色序列」（线序 / 色带 / 排线通用），矩形长轴判为线束走向；要检「一块区域是什么颜色」请用「区域颜色检查」。" />
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- 输出：左栏末尾（随滚动，不固定） -->
                        <Border Style="{StaticResource SectionDividerStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SectionHintStyle}"
                                        Text="运行结果" />
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="输出" />
                                </DockPanel>
                                <TextBlock
                                    Margin="0,9,0,6"
                                    Style="{StaticResource FieldLabelStyle}"
                                    Text="投射视图窗口"
                                    ToolTip="结果画到主界面哪个视图窗口（1~9）；填 0 = 不投射" />
                                <ComboBox
                                    Height="36"
                                    Style="{StaticResource DialogCombo}"
                                    ItemsSource="{StaticResource ViewIndexes}"
                                    SelectedItem="{Binding DisplayViewIndex, Mode=TwoWay}">
                                    <ComboBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="结果画到主界面哪个视图窗口（1~9）；0 = 不投射" />
                                    </ComboBox.ToolTip>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ViewIndexLabelConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock
                                    Style="{StaticResource HelpTextStyle}"
                                    Text="0 = 不投射；1~9 对应主界面视图窗口。" />
                            </StackPanel>
                        </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= 右：采样画布 ================= -->
        <Border
            Grid.Column="1"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!-- 画布头：标题 + ROI 标识 + 工具条 -->
                <Grid Grid.Row="0" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="&#xf125;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="采样画布" />
                        <TextBlock
                            x:Name="CanvasSubtitle"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="上游图像 · ROI 编辑" />
                        <TextBlock
                            FontSize="9.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="长轴 = 线束走向 · 短轴 = 采样方向" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="FitWindow_Click"
                            Content="&#xf065;">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="适应窗口" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Margin="2,0,0,0"
                            Style="{StaticResource ToolbarTextButtonStyle}"
                            Click="FitImage_Click"
                            Content="1:1">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="实际像素 1:1" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 画布：ImageEdit 常驻；无图时用覆盖层，不折叠控件 -->
                <Border Grid.Row="1" Background="{StaticResource PluginPreviewCanvasBrush}">
                    <Grid>
                        <h:ImageEdit
                            x:Name="ImageEditor"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ActiveRoi="{Binding CanvasActiveRoi, Mode=TwoWay}"
                            DrawObjectList="{Binding CanvasRois}"
                            HImage="{Binding DisplayImage, Mode=OneWay}" />

                        <!-- 角标：有图时提示 ROI 入口 -->
                        <Border
                            Margin="10"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{StaticResource DialogTextPrimaryBrush}"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HImage, ElementName=ImageEditor}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogSurfaceBrush}"
                                Text="ROI 编辑 · 右键新建矩形" />
                        </Border>

                        <!-- 空态：无上游图时覆盖在画布上；ImageEdit 本身保持常驻 -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HImage, ElementName=ImageEditor}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid
                                MaxWidth="420"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Rectangle
                                    Fill="{StaticResource PluginPreviewSurfaceBrush}"
                                    Opacity="0.55"
                                    RadiusX="14"
                                    RadiusY="14"
                                    Stroke="{StaticResource PluginPreviewBorderBrush}"
                                    StrokeDashArray="3,3" />
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource EmptyStateIconStyle}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="20"
                                            Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                            Text="&#xf1c5;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="还没有上游图像" />
                                    <TextBlock Style="{StaticResource EmptyStateSubStyle}" Text="在左侧「图像输入」点 🔗 绑定上游 Image 端口或变量，再点「执行」把图带进画布。" />
                                    <TextBlock Style="{StaticResource EmptyStateSubStyle}" Text="只想先看效果：在画面上右键 → 打开图片，再点「试算一下」（仅试算，不改上游图像来源）。" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 状态栏：Hint + 当前采样区（本插件没有 StatusLevel，状态点固定为主色信息点） -->
                <Border
                    Grid.Row="2"
                    Padding="12,0"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Width="7"
                            Height="7"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource DialogAccentBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="{Binding Hint}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Hint}" />
                        <TextBlock
                            x:Name="RoiSummaryText"
                            Grid.Column="2"
                            MaxWidth="300"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas, Microsoft YaHei"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding RoiSummary}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding RoiSummary}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
