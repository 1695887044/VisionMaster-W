<UserControl
    x:Class="VisionMaster.Plugins.Util.VariableAssignmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisionMaster.Plugins.Util"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="560"
    MinHeight="320"
    d:DesignHeight="520"
    d:DesignWidth="920"
    mc:Ignorable="d">

    <!--
        「变量定义与赋值」v4 配置视图：一个节点声明并写多个变量，声明的运行时变量作为输出端口供下游绑定。

        设计基线：docs/UI设计基线/variable-assignment/design-v3.html + README.md
        契约：
          · DataContext = 插件实例（宿主靠它取 IPluginConfigView.OnConfirm）；
          · 每行一个 Value_<RowId> 输入端口，值行用 LinkableValueEditor；
          · 全局名字只能从变量管理里选（非可编辑 ComboBox + 失效项）；
          · 运行时名字可编辑，未命中给提示；值行变量引用只能连。
        颜色全部走公共令牌，视图内不写十六进制。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <!--  行操作图标按钮：22×22 + Padding=0（R68）  -->
            <Style x:Key="RowActionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,1,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.25" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DeleteRowButtonStyle" BasedOn="{StaticResource RowActionButtonStyle}" TargetType="Button">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  添加一行：主色浅底 + 图标  -->
            <Style x:Key="AddRowButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BannerButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerBannerButtonStyle" BasedOn="{StaticResource BannerButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogDangerBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="BadgeBorderStyle" TargetType="Border">
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>

            <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ChipBorderStyle" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="ChipTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SideCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="14" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="RowMessageTextStyle" TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Margin" Value="0,-2,0,7" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasRowMessage}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RowMessageLevel}" Value="Error">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SideHintBorderStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Padding" Value="9,8" />
                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedRow.HintLevel}" Value="Warn">
                        <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedRow.HintLevel}" Value="Error">
                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SideHintIconStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,1,7,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedRow.HintLevel}" Value="Warn">
                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding SelectedRow.HintLevel}" Value="Error">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GlobalNameToggleStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="10"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="&#xf078;" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlobalCandidateButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.65" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ============ 行内单元格模板 ============  -->

            <DataTemplate x:Key="ScopeCellTemplate">
                <Border
                    x:Name="ScopePill"
                    BorderThickness="1"
                    CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGlobal}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ComboBox
                        Height="30"
                        Padding="2,0,18,0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        IsEditable="False"
                        IsTextSearchEnabled="False"
                        SelectedValue="{Binding Row.Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="运行" Tag="Runtime" />
                        <ComboBoxItem Content="全局" Tag="Global" />
                    </ComboBox>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NameCellTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,4,0"
                        Style="{StaticResource BadgeBorderStyle}"
                        Visibility="{Binding HasLegacyBadge, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="由旧版单条配置迁移">
                        <TextBlock Style="{StaticResource BadgeTextStyle}" Text="原" />
                    </Border>

                    <Grid Grid.Column="1">
                        <!--
                            变量名（2026-10-30 改）：不再用行内下拉，整格可点 → 宿主的变量选择弹窗。
                            为什么：下拉在几千条变量时会把全部候选项实例化（实测 10000 条 = 10002 个按钮，
                            且 ItemsControl 结构上不支持虚拟化）；弹窗那边的列表已虚拟化（5000 条只实例化 6 行）。
                            语义提醒：这里选的只是**名字**，不建立连线（值的来源由右边「值」列的 🔗 负责）。
                        -->
                        <Button
                            x:Name="PickNameButton"
                            Height="30"
                            Padding="8,0"
                            HorizontalContentAlignment="Stretch"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            Command="{Binding PickNameCommand}"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            ToolTip="点这里选变量（全局 / 运行时；只选名字，不建立连线）">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                        <Grid Margin="{TemplateBinding Padding}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInvalidGlobal}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="10"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="&#xf0d7;" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border Visibility="{Binding IsInvalidGlobal, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style BasedOn="{StaticResource BadgeBorderStyle}" TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Foreground="{StaticResource DialogDangerTextBrush}"
                                Style="{StaticResource BadgeTextStyle}"
                                Text="失效" />
                        </Border>
                        <Border
                            Style="{StaticResource BadgeBorderStyle}"
                            Visibility="{Binding IsManualRuntime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource BadgeTextStyle}" Text="手填" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="3"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="12"
                        ToolTip="{Binding RowMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Text" Value="&#xf071;" />
                                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowWarnIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RowMessageLevel}" Value="Error">
                                        <Setter Property="Text" Value="&#xf06a;" />
                                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ValueCellTemplate">
                <cv:LinkableValueEditor
                    Label=""
                    Port="{Binding Port}"
                    StepData="{Binding StepData}"
                    VerticalAlignment="Center" />
            </DataTemplate>

            <!--
                声明类型（v4 新增）：运行时变量按这个类型生成输出端口 Var_{变量名}，
                下游绑定后 FlowCompiler 会做编译期类型检查。全局行不产端口，整格隐藏。
                用外层 Border 控制可见性，**不要**给 ComboBox 挂本地 Style：
                本地 Style 会顶掉应用级隐式样式（R30/R31 的坑），外观会突变。
            -->
            <DataTemplate x:Key="TypeCellTemplate">
                <Border Visibility="{Binding TypeSelectable, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox
                        Height="30"
                        Padding="8,0,22,0"
                        VerticalContentAlignment="Center"
                        FontSize="11.5"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding TypeOptions}"
                        SelectedValue="{Binding Row.Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Value"
                        ToolTip="运行时变量的声明类型（决定输出端口 Var_变量名的 CLR 类型）；「任意对象」= 不校验类型" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CreateCellTemplate">
                <Grid>
                    <CheckBox
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Row.CreateIfNotExists, Mode=TwoWay}"
                        Visibility="{Binding IsRuntime, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="&#xf023;"
                        ToolTip="全局变量必须先在变量管理里存在；不能自动创建"
                        Visibility="{Binding IsGlobal, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ActionsCellTemplate">
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="&#xf077;"
                        Style="{StaticResource RowActionButtonStyle}"
                        ToolTip="上移" />
                    <Button
                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="&#xf078;"
                        Style="{StaticResource RowActionButtonStyle}"
                        ToolTip="下移" />
                    <Button
                        Command="{Binding DataContext.DuplicateRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="&#xf0c5;"
                        Style="{StaticResource RowActionButtonStyle}"
                        ToolTip="复制行（清空目标名）" />
                    <Button
                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="&#xf2ed;"
                        Style="{StaticResource DeleteRowButtonStyle}"
                        ToolTip="删除行" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="NarrowActionsCellTemplate">
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding DataContext.DuplicateRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="&#xf0c5;"
                        Style="{StaticResource RowActionButtonStyle}"
                        ToolTip="复制行（清空目标名）" />
                    <Button
                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="&#xf2ed;"
                        Style="{StaticResource DeleteRowButtonStyle}"
                        ToolTip="删除行" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="RowMessageTemplate">
                <TextBlock Style="{StaticResource RowMessageTextStyle}" Text="{Binding RowMessage}" />
            </DataTemplate>

            <!--  ============ 行模板：宽档 / 窄档两行式 ============  -->

            <DataTemplate x:Key="WideRowTemplate">
                <Grid MinHeight="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ScopeCellTemplate}" />
                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource NameCellTemplate}" />
                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource TypeCellTemplate}" />
                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ValueCellTemplate}" />
                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="4"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource CreateCellTemplate}" />
                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="5"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ActionsCellTemplate}" />
                    <ContentControl
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="5"
                        HorizontalContentAlignment="Stretch"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource RowMessageTemplate}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="NarrowRowTemplate">
                <Grid MinHeight="76" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="66" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ScopeCellTemplate}" />
                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource NameCellTemplate}" />
                    <ContentControl
                        Grid.Row="0"
                        Grid.Column="2"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource NarrowActionsCellTemplate}" />
                    <ContentControl
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,6,6,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ValueCellTemplate}" />
                    <ContentControl
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,6,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource TypeCellTemplate}" />
                    <ContentControl
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,6,6,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource ValueCellTemplate}" />
                    <ContentControl
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,6,0,0"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource CreateCellTemplate}" />
                    <ContentControl
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        HorizontalContentAlignment="Stretch"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource RowMessageTemplate}" />
                </Grid>
            </DataTemplate>

            <Style x:Key="RowItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="RowBorder"
                                Padding="0,0,8,0"
                                Background="Transparent"
                                BorderBrush="{StaticResource DialogBorderLightBrush}"
                                BorderThickness="0,0,0,1">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="3,0,0,1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding RowMessageLevel}" Value="Warn">
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource DialogWarningBrush}" />
                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="3,0,0,1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RowMessageLevel}" Value="Error">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource DialogDangerBrush}" />
                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="3,0,0,1" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="320" />
            <ColumnDefinition Width="1*" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <!--  ================= 左：赋值行列表 =================  -->
        <Border
            Grid.Column="0"
            Padding="16"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题 + 行数 + 添加  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="赋值设置" />
                    <Border
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="7,0"
                        Style="{StaticResource ChipBorderStyle}">
                        <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding RowCountText}" />
                    </Border>
                    <Button
                        Grid.Column="3"
                        Command="{Binding AddRowCommand}"
                        Style="{StaticResource AddRowButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="11"
                                Text="&#xf067;" />
                            <TextBlock VerticalAlignment="Center" Text="添加一行" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    FontSize="11.5"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="每行写一个变量；点行选中，在右侧查看目标、声明类型与提示。" />

                <!--  横幅：迁移 / 删除确认 / 错误  -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Border
                        Padding="9,8"
                        Background="{StaticResource DialogAccentSoftBrush}"
                        BorderBrush="{StaticResource DialogAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding ShowMigrationBanner, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,2,7,0"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="12"
                                Foreground="{StaticResource DialogAccentTextBrush}"
                                Text="&#xf05a;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="已迁移旧配置" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding MigrationText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Command="{Binding DismissMigrationCommand}"
                                Content="知道了"
                                Style="{StaticResource BannerButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,6,0,0"
                        Padding="9,8"
                        Background="{StaticResource DialogDangerSubtleBrush}"
                        BorderBrush="{StaticResource DialogDangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding HasPendingDelete, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,2,7,0"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="12"
                                Foreground="{StaticResource DialogDangerTextBrush}"
                                Text="&#xf071;" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding PendingDeleteText}"
                                TextWrapping="Wrap" />
                            <StackPanel
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Orientation="Horizontal">
                                <Button
                                    Command="{Binding ConfirmDeleteCommand}"
                                    Content="删除"
                                    Style="{StaticResource DangerBannerButtonStyle}" />
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding CancelDeleteCommand}"
                                    Content="取消"
                                    Style="{StaticResource BannerButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,6,0,0"
                        Padding="9,8"
                        Background="{StaticResource DialogDangerSubtleBrush}"
                        BorderBrush="{StaticResource DialogDangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,2,7,0"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="12"
                                Foreground="{StaticResource DialogDangerTextBrush}"
                                Text="&#xf06a;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding ErrorSummary}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="修正后运行更稳妥；现在确认，运行期会明确失败。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Command="{Binding GoToErrorCommand}"
                                Content="定位"
                                Style="{StaticResource BannerButtonStyle}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  表头（窄档隐藏）  -->
                <Grid Grid.Row="3" Height="30" Margin="0,8,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="作用域" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="变量名" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="类型"
                        ToolTip="运行时变量会按这个类型生成输出端口 Var_变量名，下游可绑定；选「任意对象」则不校验类型" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="值（常量 / 上游）" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="自动创建" />
                </Grid>

                <!--  行列表 / 空态  -->
                <Grid Grid.Row="4" Margin="0,2,0,0">
                    <ListBox
                        x:Name="RowsList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource RowItemStyle}"
                        ItemsSource="{Binding RowVms}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionChanged="OnRowsSelectionChanged"
                        SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                        VirtualizingPanel.IsVirtualizing="False"
                        Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentControl
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource WideRowTemplate}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNarrow, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource NarrowRowTemplate}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            Background="{StaticResource DialogRowHoverBrush}"
                            CornerRadius="14">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="22"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="&#xf0c9;" />
                        </Border>
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="还没有赋值行" />
                        <TextBlock
                            Margin="0,4,0,0"
                            MaxWidth="300"
                            HorizontalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="添加一行，选择作用域与变量名；「值」可以填常量，也可以引用上游结果。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding AddRowCommand}"
                            Style="{StaticResource AddRowButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="11"
                                    Text="&#xf067;" />
                                <TextBlock VerticalAlignment="Center" Text="添加第一行" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="5" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="{Binding LimitText}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="行顺序即执行顺序" />
                </Grid>
            </Grid>
        </Border>

        <!--  ================= 右：当前行 + 规则 =================  -->
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  当前行  -->
            <Border Grid.Row="0" Style="{StaticResource SideCardStyle}" Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="13"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="&#xf044;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="当前行" />
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Style="{StaticResource ChipTextStyle}" Text="{Binding SelectedRow.RowIndexText}" />
                        </Border>
                        <Border Visibility="{Binding SelectedRow.IsGlobal, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Foreground="{StaticResource DialogAccentTextBrush}"
                                Style="{StaticResource ChipTextStyle}"
                                Text="全局变量" />
                        </Border>
                        <Border
                            Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding SelectedRow.IsRuntime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource ChipTextStyle}" Text="运行时变量" />
                        </Border>
                        <Border Visibility="{Binding SelectedRow.IsInvalidGlobal, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                                </Style>
                            </Border.Style>
                            <TextBlock
                                Foreground="{StaticResource DialogDangerTextBrush}"
                                Style="{StaticResource ChipTextStyle}"
                                Text="失效" />
                        </Border>
                        <Border
                            Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding SelectedRow.IsManualRuntime, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource ChipTextStyle}" Text="手填" />
                        </Border>
                        <Border
                            Style="{StaticResource ChipBorderStyle}"
                            Visibility="{Binding SelectedRow.HasLegacyBadge, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource ChipTextStyle}" Text="原配置" />
                        </Border>
                    </WrapPanel>

                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding SelectedRow.DisplayName}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} · 候选 {1} 个 · {2}">
                                <Binding Path="SelectedRow.TypeText" />
                                <Binding Path="SelectedRow.Candidates.Count" />
                                <Binding Path="SelectedRow.ValueSourceText" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <Border Style="{StaticResource SideHintBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SideHintIconStyle}" Text="&#xf05a;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="11"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding SelectedRow.Hint}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,10,0,0"
                        Padding="0,9,0,0"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            TextWrapping="Wrap">
                            变量名只是<Run FontWeight="SemiBold" Text="名字" />：从候选里选择会落成常量，不会建立连线；「值」才负责引用上游结果。<Run FontWeight="SemiBold" Text="值行不提供手输变量名" />，变量引用请用链接。
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!--  未选择行  -->
            <Border Grid.Row="0" Style="{StaticResource SideCardStyle}" Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="13"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="&#xf044;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="当前行" />
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Style="{StaticResource ChipTextStyle}" Text="未选择" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="20"
                        FontWeight="Medium"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="未选择行" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="点左侧任意一行，查看目标变量、声明类型与提示。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  作用域规则  -->
            <Border
                Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource SideCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="13"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="&#xf05a;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="作用域规则" />
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="28"
                                Height="28"
                                Margin="0,0,9,0"
                                Background="{StaticResource DialogAccentLightBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="14"
                                    Foreground="{StaticResource DialogAccentTextBrush}"
                                    Text="&#xf085;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="运行时变量" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="由上游「变量定义」节点创建，只在本轮执行内有效，跑完即弃。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="28"
                                Height="28"
                                Margin="0,0,9,0"
                                Background="{StaticResource DialogRowHoverBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="14"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="&#xf0ac;" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="全局变量" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="变量管理里维护，跨流程、随方案存盘；运行期找不到会明确报错，不会静默新建。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border
                            Margin="0,10,0,0"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="0,1,0,0" />

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Text="一句话：" />同名变量在两个作用域各有一份；名字打错不会静默落到别的变量，运行期会明确报错。
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
