<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 本插件带自定义配置视图（VariableAssignmentView），故需要 WPF。
         从 net9.0 升到 net9.0-windows：只影响 Windows（本软件本来就是 Windows 专用）。 -->
    <TargetFrameworks>net9.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      插件自带帮助手册：编进本程序集（宿主 HelpCatalogService 按 "<程序集名>.Help." 前缀约定发现，
      文件名顺序即手册页序，页标题取正文第一个一级标题）。
      本工程一个程序集里有 6 个插件类，故手册按 **Help\{C# 类名}\01-overview.md** 分目录，
      目录名必须与类名逐字一致（宿主按类型名收窄到当前插件）。
      改手册 = 重建本插件工程（与原代码改动同一口径）。
    -->
    <EmbeddedResource Include="Help\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core.Controls 提供 LinkableValueEditor：手填常量 + 链接上游二合一，插件配置视图统一用它 -->
    <ProjectReference Include="..\..\Shard\Core.Controls\Core.Controls.csproj" />
    <ProjectReference Include="..\..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>
