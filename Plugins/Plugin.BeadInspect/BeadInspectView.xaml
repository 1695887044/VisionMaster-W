<UserControl
    x:Class="Plugin.BeadInspect.BeadInspectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.BeadInspect"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    d:DesignHeight="680"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <!--
        胶路检测配置视图（Web 基线 v2，2026-10-20）。

        结构：左 330px 设置轨（输入绑定 → 配方库 → 点列 → 配方参数 → 运行参数 → 搜索范围 → 结果预览 → 怎么用）
              + 右侧画布工作区（工具栏 + 结论横幅 + 画布标题 + 操作提示 + ImageEdit hero）+ 状态条。

        契约（逐字保留，详见 docs/UI设计基线/bead-inspect/README.md）：
        · DataContext = 插件实例（BeadInspectPlugin）；宿主靠它取 IPluginConfigView.OnConfirm。
        · 5 个 LinkableValueEditor：SrcImage / RecipeName / AlignedImageIn / RoiRegion / Transform。
        · 两块 HALCON 画布：ImageEdit（DisplayImage + PathAnnotations）、ImageReadOnly（PreviewImage）；
          两块都常驻，不用 Visibility=Collapsed 显隐已设图控件。
        · DataGrid：ItemsSource=PointRows、Index/Row/Col 列绑定、CellEditEnding 提交、行删除。
        · 所有 Numeric 参数绑定、命令入口、StatusMessage/StatusLevel 三档原样保留。
        · 颜色全部走公共令牌；本文件 hex = 0。

        v2 增量（5 个原本无 UI 入口的属性，全部已存在于插件上，本版只补入口、不改插件）：
        · ④ 运行参数：PixelSizeMm（像素当量 mm/px，0~1000）+ OutputAlignedImage（输出对齐图勾选）
        · ⑤ 搜索范围：MinScore（最低分数 0~1）+ PlanarNumLevels（金字塔层数 1~10 整数）
        · ① 配方库「自动提取输入（可选）」：ExtractTargetPoints（抽稀目标点数 10~500 整数）
          —— 该属性不是 [StepConfig]，只在本次配置会话生效、不落盘（详见 README 契约 C8）。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:EnumDisplayNameConverter x:Key="EnumName" />
            <local:PolarityNameConverter x:Key="PolarityName" />

            <!--  本视图所有 ToolTip 统一走公共对话框提示样式（R135）；只影响本视图资源作用域。  -->
            <Style BasedOn="{StaticResource DialogToolTipStyle}" TargetType="ToolTip" />

            <!--
                本视图局部样式：全部 BasedOn 共享件，只覆盖间距 / 字号 / 圆角，不另起炉灶。
            -->
            <Style
                x:Key="BeadCard"
                BasedOn="{StaticResource PluginCard}"
                TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style
                x:Key="BeadCardTitle"
                BasedOn="{StaticResource PluginCardTitle}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
            </Style>

            <Style
                x:Key="BeadFieldLabel"
                BasedOn="{StaticResource PluginFieldLabel}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style
                x:Key="BeadHint"
                BasedOn="{StaticResource PluginHintText}"
                TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 表单输入：复用 PluginNumericBox 的圆角/聚焦环模板，只把高度调到 32。 -->
            <Style
                x:Key="BeadInput"
                BasedOn="{StaticResource PluginNumericBox}"
                TargetType="TextBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                <Setter Property="Background" Value="{StaticResource DialogInputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
            </Style>

            <Style
                x:Key="BeadCombo"
                BasedOn="{StaticResource DialogCombo}"
                TargetType="ComboBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0,30,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style
                x:Key="BeadToolbarButton"
                BasedOn="{StaticResource PluginButton}"
                TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
            </Style>

            <Style
                x:Key="BeadAccentButton"
                BasedOn="{StaticResource PluginAccentButton}"
                TargetType="Button">
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
            </Style>

            <Style
                x:Key="BeadPointCell"
                BasedOn="{StaticResource {x:Type DataGridCell}}"
                TargetType="DataGridCell">
                <Setter Property="Padding" Value="8,2" />
            </Style>

            <Style
                x:Key="BeadPointHeader"
                BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"
                TargetType="DataGridColumnHeader">
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style
                x:Key="BeadPointEditBox"
                BasedOn="{StaticResource {x:Type TextBox}}"
                TargetType="TextBox">
                <Setter Property="Padding" Value="4,1" />
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource PluginLabelFontSize}" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <Style
                x:Key="BeadPointDeleteButton"
                BasedOn="{StaticResource PluginButton}"
                TargetType="Button">
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
            </Style>

            <Style
                x:Key="BeadWorkspaceCard"
                BasedOn="{StaticResource PluginCard}"
                TargetType="Border">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style
                x:Key="BeadStatusPanel"
                BasedOn="{StaticResource PluginStatusPanel}"
                TargetType="Border">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style
                x:Key="BeadBanner"
                BasedOn="{StaticResource PluginStatusPanel}"
                TargetType="Border">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!--  运行显示窗口候选（int 数组保证 SelectedItem 值相等匹配回显；0 = 不发布）  -->
            <x:Array x:Key="ViewIndexes" Type="sys:Int32">
                <sys:Int32>0</sys:Int32>
                <sys:Int32>1</sys:Int32>
                <sys:Int32>2</sys:Int32>
                <sys:Int32>3</sys:Int32>
                <sys:Int32>4</sys:Int32>
                <sys:Int32>5</sys:Int32>
                <sys:Int32>6</sys:Int32>
                <sys:Int32>7</sys:Int32>
                <sys:Int32>8</sys:Int32>
                <sys:Int32>9</sys:Int32>
            </x:Array>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PluginViewMargin}">
        <Grid.ColumnDefinitions>
            <!--  左：设置栏（共享宽度令牌；本视图不再放 GridSplitter）  -->
            <ColumnDefinition Width="{StaticResource PluginParamsColumnWidth}" MinWidth="{StaticResource PluginParamsColumnMinWidth}" />
            <!--  右：画布工作区  -->
            <ColumnDefinition Width="*" MinWidth="{StaticResource PluginPreviewColumnMinWidth}" />
        </Grid.ColumnDefinitions>

        <!--  ================= 左：设置栏（可滚动） =================  -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,8,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  ⓪ 输入绑定：5 个 LinkableValueEditor 是上游图 / 配方名 / 对齐图 / 检测区域 / 标定的唯一入口。  -->
                <Border Style="{StaticResource BeadCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BeadCardTitle}" Text="⓪ 输入绑定" />
                        <TextBlock
                            Margin="0,3,0,8"
                            Style="{StaticResource BeadHint}"
                            Text="固定值 / 变量链接：未链接时使用配置值，链接时运行期取上游输出" />
                        <cv:LinkableValueEditor
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch"
                            Label="输入图像"
                            Port="{Binding SrcImage}"
                            StepData="{Binding StepData}"
                            ToolTip="输入图像 SrcImage：待检测图像（上传上游「图像采集」的 Image 端口）" />
                        <cv:LinkableValueEditor
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch"
                            Label="配方名"
                            Port="{Binding RecipeName}"
                            StepData="{Binding StepData}"
                            ToolTip="配方名 RecipeName：多产品切换用，可不连；未连接/为空时用「设为默认」选中的那条" />
                        <cv:LinkableValueEditor
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch"
                            Label="对齐图"
                            Port="{Binding AlignedImageIn}"
                            StepData="{Binding StepData}"
                            ToolTip="对齐图 AlignedImageIn：仅「匹配位姿」对齐模式接（上游匹配插件给出的对齐后图像）" />
                        <cv:LinkableValueEditor
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch"
                            Label="检测区域"
                            Port="{Binding RoiRegion}"
                            StepData="{Binding StepData}"
                            ToolTip="检测区域 RoiRegion：可选，给了就只在区域内检测（缩域提速）" />
                        <cv:LinkableValueEditor
                            HorizontalAlignment="Stretch"
                            Label="标定"
                            Port="{Binding Transform}"
                            StepData="{Binding StepData}"
                            ToolTip="标定 Transform：输出单位选「毫米」时接标定插件的变换端口（没接则回退「像素当量」参数）" />
                    </StackPanel>
                </Border>

                <!--  ① 配方库：选型 → 载图 → 拾取的第一步。  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource BeadCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BeadCardTitle}" Text="① 配方库" />
                        <TextBlock
                            Margin="0,3,0,8"
                            Style="{StaticResource BeadHint}"
                            Text="一条 = 一个产品型号；运行时按 RecipeName 端口选条目，未连接用「设为默认」这条" />
                        <ListBox
                            MinHeight="72"
                            MaxHeight="110"
                            ItemContainerStyle="{StaticResource PluginListBoxItem}"
                            ItemsSource="{Binding RecipeRows}"
                            SelectedItem="{Binding EditingRow, Mode=TwoWay}"
                            ToolTip="配方库：点一行切换编辑态；行内显示点数与学习状态">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,1">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="10.5"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="{Binding PointCountText}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                FontSize="10.5"
                                                Text="{Binding LearnedText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LearnedText}" Value="已学习">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LearnedText}" Value="参数已变·需重学">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <Button
                                MinWidth="56"
                                Command="{Binding AddEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="新增"
                                Style="{StaticResource BeadToolbarButton}"
                                ToolTip="新增一个配方条目（产品型号）" />
                            <Button
                                MinWidth="56"
                                Margin="6,0,0,0"
                                Command="{Binding DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="删除"
                                Style="{StaticResource BeadToolbarButton}"
                                ToolTip="删除当前选中的配方条目" />
                            <Button
                                MinWidth="72"
                                Margin="6,0,0,0"
                                Command="{Binding SetDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="设为默认"
                                Style="{StaticResource BeadToolbarButton}"
                                ToolTip="把当前条目设为默认配方：RecipeName 端口未连接/为空时使用它" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource BeadFieldLabel}"
                            Text="参考图路径" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Style="{StaticResource BeadInput}"
                                Text="{Binding EditingEntry.RefImagePath, UpdateSourceTrigger=LostFocus}"
                                ToolTip="参考图：planar 对齐模板 + 路径坐标系基准（换路径后需重新学习）" />
                            <Button
                                Grid.Column="1"
                                MinWidth="44"
                                Margin="4,0,0,0"
                                Command="{Binding LoadRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="载入"
                                Style="{StaticResource BeadToolbarButton}"
                                ToolTip="载入参考图：路径为空或文件不存在时弹文件选择框，选定后自动写入路径并载入画布" />
                        </Grid>

                        <Expander
                            Margin="0,7,0,0"
                            Header="自动提取输入（可选）"
                            ToolTip="「自动提取」用的两张图：无胶参考图（差分基准）+ 提取用良品图（胶路完整、位姿与参考一致）">
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="无胶参考图路径" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding EditingEntry.RefNoBeadImagePath, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="自动提取中心线的「参考图差分」基准（P6：差分 σ=0.96px 最紧）。空 = 提取回退 black-hat" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Style="{StaticResource BeadFieldLabel}"
                                    Text="提取用良品图路径" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding ExtractImagePath, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="「自动提取」的输入：一张胶路完整、位姿与参考一致的良品图（教学会话数据，不随配方保存）" />
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Style="{StaticResource BeadFieldLabel}"
                                    Text="抽稀目标点数" />
                                <TextBox
                                    x:Name="ExtractTargetPointsBox"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    ToolTip="「自动提取」抽稀后的点数（10~500，默认 40）。40~80 点对检出几乎无影响，点数越多画布上越密">
                                    <TextBox.Text>
                                        <Binding Path="ExtractTargetPoints" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <cv:NumberValidationRule
                                                    FieldName="抽稀目标点数"
                                                    IntegerOnly="True"
                                                    Max="500"
                                                    Min="10" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadHint}"
                                    Text="仅本次配置会话生效，不落盘：重新打开配置界面回到默认 40" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!--  ② 路径点列：紧凑复核表；与画布双向同步。  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource BeadCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BeadCardTitle}" Text="② 路径点列（Row / Col 可编辑）" TextWrapping="Wrap" />
                        <DataGrid
                            MinHeight="140"
                            MaxHeight="286"
                            Margin="0,8,0,0"
                            AlternatingRowBackground="{StaticResource DialogRowAlternateBrush}"
                            AutoGenerateColumns="False"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CellEditEnding="OnPointCellEditEnding"
                            CellStyle="{StaticResource BeadPointCell}"
                            ColumnHeaderStyle="{StaticResource BeadPointHeader}"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            HorizontalGridLinesBrush="{StaticResource DialogBorderLightBrush}"
                            ItemsSource="{Binding PointRows}"
                            RowBackground="{StaticResource DialogSurfaceBrush}"
                            RowHeight="28"
                            SelectionMode="Single"
                            ToolTip="与画布双向同步：改这里=移点；画布加点/删点/拖动也会刷新本表">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="32"
                                    Binding="{Binding Index, Mode=OneWay}"
                                    Header="#"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="84"
                                    Binding="{Binding Row, UpdateSourceTrigger=LostFocus}"
                                    EditingElementStyle="{StaticResource BeadPointEditBox}"
                                    Header="Row" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="84"
                                    Binding="{Binding Col, UpdateSourceTrigger=LostFocus}"
                                    EditingElementStyle="{StaticResource BeadPointEditBox}"
                                    Header="Col" />
                                <DataGridTemplateColumn Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Click="OnDeletePointRowClick"
                                                Content="删"
                                                Style="{StaticResource BeadPointDeleteButton}"
                                                ToolTip="删除本点（可撤销）" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource BeadHint}"
                            Text="位置容差：3~5 张良品重测后定" />
                    </StackPanel>
                </Border>

                <!--  ③ 配方参数（配方值优先，0 回落插件级）  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource BeadCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BeadCardTitle}" Text="③ 配方参数" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="胶宽(px)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding EditingEntry.TargetWidth, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="目标胶宽（px）。P3 实测范例 15.26px。下限 6：低于它 HALCON 报 #3716（会被自动夹到 6）" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="容差(px)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding EditingEntry.WidthTolerance, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="胶宽容差（px）。P12：须 ≥ 自动提取路径的偏差上界（实测 8.39px），默认 8；用 7 会过报" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="位置(px)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding EditingEntry.PositionTolerance, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="位置容差（px）。P9：待现场良品样本标定，默认保守值 30" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="极性" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    ItemsSource="{Binding PolarityOptions}"
                                    SelectedItem="{Binding EditingEntry.Polarity, Mode=TwoWay}"
                                    Style="{StaticResource BeadCombo}"
                                    ToolTip="dark=暗胶（亮面上的一条暗线）；light=亮胶。HALCON 硬约束只支持二选一">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PolarityName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource BeadHint}"
                            Text="胶宽下限 6；容差须 ≥ 自动提取偏差上界 8.39px" />

                        <Expander
                            Margin="0,7,0,0"
                            Header="高级：显式目标矩形"
                            ToolTip="「拾取矫正四点」默认按源四点外接矩形自动推导目标矩形（未过真值断言）；需要精确坐标系时在此显式指定">
                            <StackPanel Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BeadHint}" Text="起始行" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource BeadHint}" Text="起始列" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,3,4,6"
                                        Style="{StaticResource BeadInput}"
                                        Text="{Binding RectTargetR1, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="目标矩形起始行" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="4,3,0,6"
                                        Style="{StaticResource BeadInput}"
                                        Text="{Binding RectTargetC1, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="目标矩形起始列" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BeadHint}" Text="结束行" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource BeadHint}" Text="结束列" />
                                    <TextBox
                                        Grid.Row="3"
                                        Grid.Column="0"
                                        Margin="0,3,4,0"
                                        Style="{StaticResource BeadInput}"
                                        Text="{Binding RectTargetR2, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="目标矩形结束行" />
                                    <TextBox
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="4,3,0,0"
                                        Style="{StaticResource BeadInput}"
                                        Text="{Binding RectTargetC2, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="目标矩形结束列" />
                                </Grid>
                                <Button
                                    MinWidth="96"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ApplyRectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="应用目标矩形"
                                    Style="{StaticResource BeadToolbarButton}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!--  ④ 运行参数（插件级）  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource BeadCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BeadCardTitle}" Text="④ 运行参数" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="对齐模式" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    ItemsSource="{Binding AlignModes}"
                                    SelectedItem="{Binding AlignMode, Mode=TwoWay}"
                                    Style="{StaticResource BeadCombo}"
                                    ToolTip="固定相机：不对齐；匹配位姿：接匹配插件的 AlignedImage；平面可变形：内置投影对齐（推荐）">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="输出单位" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    ItemsSource="{Binding UnitOptions}"
                                    SelectedItem="{Binding UnitOutput, Mode=TwoWay}"
                                    Style="{StaticResource BeadCombo}"
                                    ToolTip="毫米 = 像素值 × 像素当量；优先接标定插件的 Transform 端口，回退「像素当量」参数；两者皆无则执行失败">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="碎段过滤(px)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding MinErrorLength, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="错误段长度下限：短于此的碎段不计数（滤小误报）" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="显示窗口" />
                                <ComboBox
                                    Margin="0,4,0,0"
                                    ItemsSource="{StaticResource ViewIndexes}"
                                    SelectedItem="{Binding DisplayViewIndex, Mode=TwoWay}"
                                    Style="{StaticResource BeadCombo}"
                                    ToolTip="把标注图发布到主界面几号视图窗口（0 = 不发布）">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding StringFormat=图像窗口 {0}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="0">
                                                                <Setter Property="Text" Value="不显示" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="像素当量(mm/px)" />
                                <TextBox
                                    x:Name="PixelSizeMmBox"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    ToolTip="输出单位选「毫米」且未接标定 Transform 时的兜底当量；0 = 未填（此时毫米输出会失败并提示补来源）">
                                    <TextBox.Text>
                                        <Binding Path="PixelSizeMm" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <cv:NumberValidationRule
                                                    FieldName="像素当量"
                                                    Max="1000"
                                                    Min="0" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Bottom">
                                <CheckBox
                                    x:Name="OutputAlignedImageBox"
                                    Style="{StaticResource DialogCheckBox}"
                                    Content="输出对齐图"
                                    IsChecked="{Binding OutputAlignedImage, Mode=TwoWay}"
                                    ToolTip="勾选后 AlignedImage 输出端口给出对齐后的图（供下游复用，省一次对齐）；取消 = 该口输出空，对齐本身照做" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ⑤ 平面匹配搜索范围（只在换工位/相机时才需要调）  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource BeadCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BeadCardTitle}" Text="⑤ 平面匹配搜索范围" />
                        <TextBlock
                            Margin="0,3,0,8"
                            Style="{StaticResource BeadHint}"
                            Text="仅「平面可变形」对齐模式生效。工件旋转/远近超出默认范围、对齐失败时才需要调大——默认值来自范例实测，不改也能跑。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="起始角(°)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding FindAngleStartDeg, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="平面匹配起始角（度）。默认 -22.35°（≈ 范例 -0.39rad）" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="角度范围(°)" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding FindAngleExtentDeg, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="从起始角起的搜索范围（度）。默认 44.69°（≈ 范例 0.78rad）" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="缩放R最小" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding FindScaleRMin, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="行方向最小缩放。1 = 不允许缩放；相机远近/工件大小有变化时设成如 0.9" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="缩放R最大" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding FindScaleRMax, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="行方向最大缩放。1 = 不允许缩放；与「缩放R最小」配合给出搜索区间，如 0.9~1.1" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="缩放C最小" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding FindScaleCMin, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="列方向最小缩放。1 = 不允许缩放；列向尺寸变化与行向不一致时（各向异性）分开设" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,7">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="缩放C最大" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    Text="{Binding FindScaleCMax, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="列方向最大缩放。与「缩放C最小」配合给出搜索区间" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="最低分数" />
                                <TextBox
                                    x:Name="MinScoreBox"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    ToolTip="平面匹配最低分数（0~1，默认 0.4）：匹配得分低于它就判对齐失败。调高 = 更严（可能漏对齐），调低 = 更宽容">
                                    <TextBox.Text>
                                        <Binding Path="MinScore" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <cv:NumberValidationRule
                                                    FieldName="最低分数"
                                                    Max="1"
                                                    Min="0" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Style="{StaticResource BeadFieldLabel}" Text="金字塔层数" />
                                <TextBox
                                    x:Name="PlanarNumLevelsBox"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource BeadInput}"
                                    ToolTip="平面匹配金字塔层数（1~10，默认 5）：层数越多越快但越小/越模糊的工件越容易漏；范围不合法会被夹到 1~10">
                                    <TextBox.Text>
                                        <Binding Path="PlanarNumLevels" UpdateSourceTrigger="LostFocus">
                                            <Binding.ValidationRules>
                                                <cv:NumberValidationRule
                                                    FieldName="金字塔层数"
                                                    IntegerOnly="True"
                                                    Max="10"
                                                    Min="1" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  结果预览：ImageReadOnly 常驻；无图时只盖 WPF 覆盖层，绝不折叠控件。  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource BeadCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BeadCardTitle}" Text="结果预览" />
                        <TextBlock
                            Margin="0,3,0,7"
                            Style="{StaticResource BeadHint}"
                            Text="学习叠加 / 试运行标注" />
                        <Grid Height="160">
                            <Border
                                Background="{StaticResource PluginPreviewCanvasBrush}"
                                BorderBrush="{StaticResource PluginPreviewBorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="8">
                                <h:ImageReadOnly
                                    HImage="{Binding PreviewImage, Mode=OneWay}"
                                    ToolTip="学习完成后显示底图 + 参考路径叠加；试运行后显示标注图" />
                            </Border>
                            <Border
                                Background="{StaticResource PluginPreviewCanvasBrush}"
                                BorderBrush="{StaticResource PluginPreviewBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="14">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PluginPreviewTextBrush}"
                                        Text="暂无结果图" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                        Text="学习或试运行后在这里显示叠加图 / 标注图"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  怎么用  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource BeadCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BeadCardTitle}" Text="怎么用" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource BeadHint}"
                            Text="① 新增配方 → 点「载入」选择参考图文件（或先填路径）；② 在画布上左键逐点拾取胶路中心线（或填良品图路径点「自动提取」后微调）；③ 点「学习」；④ 可选：拾取矫正四点提升对齐稳定性；⑤ 试运行看标注图。" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource BeadHint}"
                            Text="设了矫正四点后，底图会切到矫正后的参考图——路径点列存的是矫正后坐标系的坐标，画布拾取与运行期检测始终同坐标系。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  ================= 右：画布工作区 =================  -->
        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="{StaticResource PluginCanvasMinHeight}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource BeadWorkspaceCard}">
                <DockPanel>
                    <!--  工具栏：6 个动作 + 适应图片（在画布标题行）。窄了换行、不裁字。  -->
                    <WrapPanel DockPanel.Dock="Top">
                        <Button
                            Margin="0,0,5,4"
                            Command="{Binding LearnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="学习"
                            IsEnabled="{Binding HasEnoughPoints}"
                            Style="{StaticResource BeadAccentButton}"
                            ToolTip="建胶路检测模型并记录学习指纹（需要 ≥ 2 个点；「平面可变形」对齐还需参考图）"
                            ToolTipService.ShowOnDisabled="True" />
                        <Button
                            MinWidth="76"
                            Margin="0,0,5,4"
                            Command="{Binding AutoExtractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="自动提取"
                            Style="{StaticResource BeadToolbarButton}"
                            ToolTip="从良品图自动提取胶路中心线（差分 → 骨架 → 树直径合并 → 抽稀 40 点）。覆盖当前点列前会先确认；失败不写空点列" />
                        <Button
                            MinWidth="52"
                            Margin="0,0,5,4"
                            Command="{Binding UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="撤销"
                            Style="{StaticResource BeadToolbarButton}"
                            ToolTip="撤销上一步拾取（Ctrl+Z）" />
                        <Button
                            MinWidth="64"
                            Margin="0,0,5,4"
                            Command="{Binding ClearPointsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="清空点列"
                            IsEnabled="{Binding HasAnyPoints}"
                            Style="{StaticResource BeadToolbarButton}"
                            ToolTip="清空当前点列（可撤销）" />
                        <Button
                            MinWidth="96"
                            Margin="0,0,5,4"
                            Command="{Binding ToggleQuadPickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource BeadToolbarButton}"
                            ToolTip="在参考图上点选平面区域四角（§6.3）：4 点后自动记录，目标矩形自动推导；再点一次取消">
                            <TextBlock Text="拾取矫正四点">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="拾取矫正四点" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QuadPicking}" Value="True">
                                                <Setter Property="Text" Value="拾取中…再点结束" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button
                            MinWidth="64"
                            Margin="0,0,5,4"
                            Command="{Binding ClearQuadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="清除矫正"
                            Style="{StaticResource BeadToolbarButton}"
                            ToolTip="清除矫正四点：RectifyQuadJson 为空 = 跳过矫正" />
                    </WrapPanel>

                    <!--  操作结果横幅：学习 / 自动提取 / 矫正的结论必须落在不滚动就能看见的地方。  -->
                    <Border
                        DockPanel.Dock="Top"
                        Margin="0,2,0,0"
                        Visibility="{Binding HasActionBanner, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style BasedOn="{StaticResource BeadBanner}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActionBannerLevel}" Value="{x:Static local:StatusLevel.Warning}">
                                        <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActionBannerLevel}" Value="{x:Static local:StatusLevel.Error}">
                                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="11"
                            Text="{Binding ActionBanner}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActionBannerLevel}" Value="{x:Static local:StatusLevel.Warning}">
                                            <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActionBannerLevel}" Value="{x:Static local:StatusLevel.Error}">
                                            <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!--  画布标题行：标题 + 点数 + 适应图片。  -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BeadCardTitle}"
                            Text="胶路中心线拾取" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource BeadHint}"
                            Text="{Binding PointCountText}" />
                        <Button
                            MinWidth="64"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding FitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="适应图片"
                            Style="{StaticResource BeadToolbarButton}"
                            ToolTip="画布铺满整幅底图（滚轮缩放）" />
                    </WrapPanel>

                    <TextBlock
                        DockPanel.Dock="Top"
                        Margin="0,2,0,3"
                        Style="{StaticResource BeadHint}"
                        Text="左键加点｜右键删点｜拖动改坐标｜Ctrl+Z｜滚轮缩放｜橙=路径 红=点 青=四角" />

                    <Grid>
                        <!--  MinHeight=120：极矮窗口下画布不许塌成 0；常规尺寸远高于它。  -->
                        <h:ImageEdit
                            x:Name="Canvas"
                            MinHeight="120"
                            Annotations="{Binding PathAnnotations, Mode=OneWay}"
                            HImage="{Binding DisplayImage, Mode=OneWay}"
                            ToolTip="橙色=参考路径，红色=点，青色=矫正四点；左键加点会插到最近线段之间，右键删最近点，拖动可改坐标（Ctrl+Z 撤销）" />
                        <!--  空态：无底图时中央给一句怎么办；画布控件本身仍常驻。  -->
                        <TextBlock
                            Margin="16"
                            MaxWidth="220"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                            IsHitTestVisible="False"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding IsCanvasEmpty, Converter={StaticResource BoolToVis}}"
                            Text="尚未载入图像&#10;绑定输入图，或点「载入」选择参考图文件" />
                    </Grid>
                </DockPanel>
            </Border>

            <!--  状态条：StatusMessage + BaseImageHint，两行内完整可见。  -->
            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Style="{StaticResource BeadStatusPanel}"
                VerticalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="7"
                        Height="7"
                        Margin="0,5,8,0"
                        VerticalAlignment="Top">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Warning}">
                                        <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="11" Text="{Binding StatusMessage}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Warning}">
                                            <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                                            <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="10.5"
                            Text="{Binding BaseImageHint}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BaseImageLevel}" Value="{x:Static local:StatusLevel.Warning}">
                                            <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
