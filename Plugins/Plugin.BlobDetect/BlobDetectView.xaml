<UserControl
    x:Class="Plugin.BlobDetect.BlobDetectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.BlobDetect"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="clr-namespace:UI.CustomControl;assembly=UI"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    d:DesignHeight="620"
    d:DesignWidth="960"
    mc:Ignorable="d">

    <!--
        Blob 缺陷检测配置视图（Web 基线 v1 复刻）。

        布局：左「图像输入 + ①~⑤ 参数分区（可滚动）」+ 右「标注图 / 数据输出工作区」。
        功能契约：DataContext = 插件实例；3 个 LinkableValueEditor（SrcImage / MaskRegion / ExcludeRegion）；
        ImageReadOnly.HImage = PreviewImage 常驻；HistogramPlot 4 个绑定；缺陷清单 DataGrid；
        19 个 NumericBox 的 Value/ValidationRules；全部下拉、勾选、命令与状态三档原样保留。
        本文件不写任何十六进制颜色；颜色一律走公共令牌。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:EnumDisplayNameConverter x:Key="EnumName" />
            <local:StatusMessageConverter x:Key="StatusMessageConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!--  运行显示窗口候选（int 数组保证 SelectedItem 值相等匹配回显；0 = 不发布）  -->
            <x:Array x:Key="ViewIndexes" Type="system:Int32">
                <system:Int32>0</system:Int32>
                <system:Int32>1</system:Int32>
                <system:Int32>2</system:Int32>
                <system:Int32>3</system:Int32>
                <system:Int32>4</system:Int32>
                <system:Int32>5</system:Int32>
                <system:Int32>6</system:Int32>
                <system:Int32>7</system:Int32>
                <system:Int32>8</system:Int32>
                <system:Int32>9</system:Int32>
            </x:Array>

            <!--  分区标题  -->
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>

            <Style x:Key="SectionBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
            </Style>

            <!--  字段标签 / 帮助文字  -->
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  数值框：沿用 PluginNumericBox 的校验红框/聚焦环，只把高度压到 32  -->
            <Style
                x:Key="FieldNumericStyle"
                BasedOn="{StaticResource PluginNumericBox}"
                TargetType="TextBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="FieldComboStyle"
                BasedOn="{StaticResource DialogCombo}"
                TargetType="ComboBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--  普通按钮（32px）  -->
            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  预览工具条图标按钮：30×30 + Padding=0（R68）  -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0,7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  预览页签项  -->
            <Style x:Key="PreviewTabItemStyle" TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Bd"
                                Padding="12,5"
                                Background="Transparent"
                                CornerRadius="6">
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                BlurRadius="2"
                                                Direction="270"
                                                Opacity="0.10"
                                                ShadowDepth="1"
                                                Color="{StaticResource DialogShadowColor}" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  状态栏  -->
            <Style x:Key="StatusDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="7" />
                <Setter Property="Height" Value="7" />
                <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Warning}">
                        <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                状态消息用只读 TextBox 而不是 TextBlock：文本可选中复制（错误信息能直接贴给同事），
                同时保留 TextBox.Text 绑定，批量插件视图冒烟的 TextBox 绑定检查不再空跑。
                外观与 TextBlock 一致：无边框、无背景、无内边距。
            -->
            <Style x:Key="StatusMessageBoxStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Warning}">
                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  缺陷清单表格  -->
            <Style x:Key="DefectGridStyle" TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="RowBackground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="AlternatingRowBackground" Value="{StaticResource DialogRowAlternateBrush}" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeight" Value="30" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AutoGenerateColumns" Value="False" />
            </Style>

            <Style x:Key="DefectGridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="DefectCellTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="7,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <Style x:Key="CountChipStyle" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                <Setter Property="CornerRadius" Value="11" />
            </Style>

            <Style x:Key="CountChipTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <Style x:Key="PreviewChipStyle" TargetType="Border">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Background" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateSubStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="MaxWidth" Value="380" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,0,13" />
                <Setter Property="Background" Value="{StaticResource PluginPreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PluginPreviewBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="356" />
            <ColumnDefinition Width="1.6*" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <!--  ================= 左：配置轨 =================  -->
        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="12"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!--  图像输入  -->
                    <Border Margin="0,0,0,10" Style="{StaticResource PluginCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SectionBadgeStyle}">
                                    <TextBlock Style="{StaticResource SectionBadgeTextStyle}" Text="0" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="图像输入" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SectionHintStyle}" Text="3 个输入端口" />
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="输入图像" />
                            <cv:LinkableValueEditor
                                AutomationProperties.Name="输入图像"
                                Label=""
                                Port="{Binding SrcImage}"
                                StepData="{Binding StepData}" />

                            <TextBlock
                                Margin="0,9,0,5"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="检测区域（可选）" />
                            <cv:LinkableValueEditor
                                AutomationProperties.Name="检测区域"
                                Label=""
                                Port="{Binding MaskRegion}"
                                StepData="{Binding StepData}" />

                            <TextBlock
                                Margin="0,9,0,5"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="排除区域（可选）" />
                            <cv:LinkableValueEditor
                                AutomationProperties.Name="排除区域"
                                Label=""
                                Port="{Binding ExcludeRegion}"
                                StepData="{Binding StepData}" />

                            <Button
                                Margin="0,10,0,0"
                                Command="{Binding AdaptToImageCommand}"
                                Style="{StaticResource LocalButtonStyle}">
                                <Button.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="按当前输入图像的实际灰度范围与分辨率，换算固定阈值上下限与面积规格；不改变二值化方式、检测目标、形态学参数" />
                                </Button.ToolTip>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="13"
                                        Text="&#xf0d0;" />
                                    <TextBlock VerticalAlignment="Center" Text="按当前图像重新适配" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="首次加载图像时，若参数仍是出厂默认值会自动适配一次；改过参数后不再自动覆盖。检测/排除区域可不接。" />
                        </StackPanel>
                    </Border>

                    <!--  ① 二值化  -->
                    <Border Margin="0,0,0,10" Style="{StaticResource PluginCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SectionBadgeStyle}">
                                    <TextBlock Style="{StaticResource SectionBadgeTextStyle}" Text="1" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="二值化" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SectionHintStyle}" Text="分割方式" />
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="二值化方式" />
                            <ComboBox
                                ItemsSource="{Binding ThresholdModes}"
                                SelectedItem="{Binding ThresholdMode, Mode=TwoWay}"
                                Style="{StaticResource FieldComboStyle}">
                                <ComboBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="固定阈值：自己做灰度区间；自动阈值：最大类间方差法自动求分割点；动态阈值：按局部背景分割，抗光照不均" />
                                </ComboBox.ToolTip>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!--  固定阈值  -->
                            <StackPanel Visibility="{Binding IsFixedThreshold, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="下限灰度" ToolTip="被检目标的灰度下界（含）。找暗缺陷填小区间、找亮缺陷填大区间" />
                                        <ui:NumericBox
                                            Maximum="65535"
                                            Minimum="0"
                                            Style="{StaticResource FieldNumericStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="MinGray" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="下限灰度" Min="0" Max="65535" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="上限灰度" ToolTip="被检目标的灰度上界（含）" />
                                        <ui:NumericBox
                                            Maximum="65535"
                                            Minimum="0"
                                            Style="{StaticResource FieldNumericStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="MaxGray" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="上限灰度" Min="0" Max="65535" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="上下限填反了会按区间自动排序，不会报错。" />
                            </StackPanel>

                            <!--  自动阈值  -->
                            <StackPanel Visibility="{Binding IsAutoThreshold, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="自动求分割点（最大类间方差法），适合来料灰度整体漂移、不方便固定阈值的场合，无需额外参数。" />
                            </StackPanel>

                            <!--  动态阈值  -->
                            <StackPanel Visibility="{Binding IsDynamicThreshold, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="局部窗口宽" ToolTip="动态阈值的邻域宽度（像素）。要略大于缺陷宽度，否则缺陷会被当成本地背景" />
                                        <ui:NumericBox
                                            DecimalPlaces="0"
                                            Maximum="1000"
                                            Minimum="1"
                                            Style="{StaticResource FieldNumericStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="VarMaskWidth" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule
                                                            FieldName="局部窗口宽"
                                                            IntegerOnly="True"
                                                            Max="1000"
                                                            Min="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="局部窗口高" ToolTip="动态阈值的邻域高度（像素）" />
                                        <ui:NumericBox
                                            DecimalPlaces="0"
                                            Maximum="1000"
                                            Minimum="1"
                                            Style="{StaticResource FieldNumericStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="VarMaskHeight" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule
                                                            FieldName="局部窗口高"
                                                            IntegerOnly="True"
                                                            Max="1000"
                                                            Min="1" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="标准差权重" ToolTip="局部灰度标准差要乘的系数；越大越严格、检出的越少" />
                                        <ui:NumericBox
                                            Maximum="100"
                                            Minimum="0"
                                            Style="{StaticResource FieldNumericStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="VarStdDevScale" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="标准差权重" Min="0" Max="100" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="绝对灰度偏移" ToolTip="相对局部均值的固定灰度偏移量，兜底那些对比度很低的区域" />
                                        <ui:NumericBox
                                            Maximum="65535"
                                            Minimum="0"
                                            Style="{StaticResource FieldNumericStyle}">
                                            <ui:NumericBox.Value>
                                                <Binding Path="VarAbsThreshold" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <cv:NumberValidationRule FieldName="绝对灰度偏移" Min="0" Max="65535" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </ui:NumericBox.Value>
                                        </ui:NumericBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="窗口要略大于缺陷宽度；标准差权重越大越严格，检出的越少。" />
                            </StackPanel>

                            <!--  检测目标：固定阈值下由灰度区间决定极性，故隐藏  -->
                            <StackPanel
                                Margin="0,10,0,0"
                                Visibility="{Binding ShowDetectTarget, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="检测目标" ToolTip="亮缺陷：比背景亮的划痕/亮点；暗缺陷：比背景暗的划痕/暗斑" />
                                <ComboBox
                                    ItemsSource="{Binding DetectTargets}"
                                    SelectedItem="{Binding DetectTarget, Mode=TwoWay}"
                                    Style="{StaticResource FieldComboStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!--  亮暗同检：仅自动/动态阈值下出现  -->
                            <CheckBox
                                Margin="0,9,0,0"
                                Content="亮暗同检（同时检出比背景亮与暗的缺陷）"
                                FontSize="11.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                IsChecked="{Binding DetectBrightAndDark, Mode=TwoWay}"
                                Visibility="{Binding ShowDualPolarity, Converter={StaticResource BoolToVis}}"
                                ToolTip="一块板面上「暗划痕 + 亮亮点」要一次检完时勾选：两种极性各做一次二值化再取并集。需要额外跑一遍分割，速度略慢；固定阈值方式下不需要也无法勾选" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="固定阈值下由灰度区间决定极性，检测目标与亮暗同检自动隐藏。" />
                        </StackPanel>
                    </Border>

                    <!--  ② 特征筛选  -->
                    <Border Margin="0,0,0,10" Style="{StaticResource PluginCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SectionBadgeStyle}">
                                    <TextBlock Style="{StaticResource SectionBadgeTextStyle}" Text="2" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="特征筛选" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SectionHintStyle}" Text="噪点 / 形状 / 触边" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="面积下限" ToolTip="小于该面积（像素）的连通域当噪点丢弃。注意单位是像素，不是毫米" />
                                    <ui:NumericBox
                                        Maximum="1000000000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MinArea" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="面积下限" Min="0" Max="1000000000" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="面积上限" ToolTip="超过它的连通域直接不算缺陷（不计数、不判定）。填 0 = 不限，此时上限自动取图像像素总数" />
                                    <ui:NumericBox
                                        Maximum="1000000000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MaxBlobArea" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="面积上限" Min="0" Max="1000000000" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="圆度下限" ToolTip="0~1，1=正圆。细长划痕约 0.02~0.1，方块约 0.67。填 0 = 不按圆度筛" />
                                    <ui:NumericBox
                                        Maximum="1"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MinCircularity" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="圆度下限" Min="0" Max="1" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="长宽比上限" ToolTip="外接矩形 长边/短边，越大越细长（正方形=1）。填 0 = 不按长宽比筛" />
                                    <ui:NumericBox
                                        Maximum="10000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MaxAspectRatio" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="长宽比上限" Min="0" Max="10000" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="排除触边(px)" ToolTip="缺陷外接矩形碰到图像最外 N 像素就丢弃——打光/裁切边缘效应是固定误检源。填 0 = 不排除" />
                                    <ui:NumericBox
                                        DecimalPlaces="0"
                                        Maximum="10000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="ExcludeBorderPx" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule
                                                        FieldName="排除触边"
                                                        IntegerOnly="True"
                                                        Max="10000"
                                                        Min="0" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="筛选掉的不计数也不判定；判定规格在下方第 4 区，两者是两回事。面积单位是像素。" />
                        </StackPanel>
                    </Border>

                    <!--  ③ 形态学  -->
                    <Border Margin="0,0,0,10" Style="{StaticResource PluginCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SectionBadgeStyle}">
                                    <TextBlock Style="{StaticResource SectionBadgeTextStyle}" Text="3" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="形态学" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SectionHintStyle}" Text="去毛刺 / 连断桥" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="开运算半径" ToolTip="先腐蚀后膨胀，磨掉细小毛刺、断开粘连细桥。填 0 表示不做" />
                                    <ui:NumericBox
                                        Maximum="1000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="OpenRadius" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="开运算半径" Min="0" Max="1000" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="闭运算半径" ToolTip="先膨胀后腐蚀，补上缺陷内部的小孔、连接断裂的划痕。填 0 表示不做" />
                                    <ui:NumericBox
                                        Maximum="1000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="CloseRadius" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="闭运算半径" Min="0" Max="1000" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="合并半径" ToolTip="把间距小于 2 倍半径的几段连成一个缺陷。填 0 = 不合并" />
                                    <ui:NumericBox
                                        Maximum="1000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MergeRadius" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="合并半径" Min="0" Max="1000" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                            </Grid>

                            <CheckBox
                                Margin="0,9,0,0"
                                Content="填孔（缺陷内部反光会把它挖成环形）"
                                FontSize="11.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                IsChecked="{Binding FillHoles, Mode=TwoWay}"
                                ToolTip="勾选后按外轮廓计算面积。缺陷内部有亮斑/反光时，不填孔会让面积偏小、甚至被拆成多个区域" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="开/闭运算填 0 表示跳过该步（默认两步都跳过）。合并半径把间距小于 2 倍半径的几段连成一个缺陷。" />
                        </StackPanel>
                    </Border>

                    <!--  ④ 判定规格  -->
                    <Border Margin="0,0,0,10" Style="{StaticResource PluginCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SectionBadgeStyle}">
                                    <TextBlock Style="{StaticResource SectionBadgeTextStyle}" Text="4" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="判定规格" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SectionHintStyle}" Text="OK / NG" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="缺陷个数上限" ToolTip="缺陷个数超过它即判 NG。填 0 表示一个缺陷都不允许" />
                                    <ui:NumericBox
                                        DecimalPlaces="0"
                                        Maximum="1000000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MaxDefectCount" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule
                                                        FieldName="缺陷个数上限"
                                                        IntegerOnly="True"
                                                        Max="1000000"
                                                        Min="0" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="缺陷个数下限" ToolTip="缺陷个数少于它即判 NG。填 0 = 不做这项判定" />
                                    <ui:NumericBox
                                        DecimalPlaces="0"
                                        Maximum="1000000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MinDefectCount" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule
                                                        FieldName="缺陷个数下限"
                                                        IntegerOnly="True"
                                                        Max="1000000"
                                                        Min="0" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="单个缺陷面积上限" ToolTip="最大单缺陷面积超过它即判 NG（单位：像素）。填 0 = 不做这项判定" />
                                    <ui:NumericBox
                                        Maximum="1000000000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MaxSingleArea" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="单个缺陷面积上限" Min="0" Max="1000000000" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="缺陷总面积上限" ToolTip="所有缺陷面积之和超过它即判 NG。填 0 = 不做这项判定" />
                                    <ui:NumericBox
                                        Maximum="1000000000"
                                        Minimum="0"
                                        Style="{StaticResource FieldNumericStyle}">
                                        <ui:NumericBox.Value>
                                            <Binding Path="MaxTotalArea" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <cv:NumberValidationRule FieldName="缺陷总面积上限" Min="0" Max="1000000000" />
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </ui:NumericBox.Value>
                                    </ui:NumericBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="判定：个数超出上/下限、单个面积或总面积超出上限，任一命中即 NG。填 0 = 不启用该项。" />
                        </StackPanel>
                    </Border>

                    <!--  ⑤ 输出  -->
                    <Border Margin="0,0,0,0" Style="{StaticResource PluginCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SectionBadgeStyle}">
                                    <TextBlock Style="{StaticResource SectionBadgeTextStyle}" Text="5" />
                                </Border>
                                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleStyle}" Text="输出" />
                                <TextBlock Grid.Column="2" Style="{StaticResource SectionHintStyle}" Text="发布 / 单位 / 排序" />
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="运行显示窗口" ToolTip="正式运行时把标注图发布到主界面几号视图窗口（1~9）；选「不显示」则不发布。配置态预览不受影响" />
                            <ComboBox
                                ItemsSource="{StaticResource ViewIndexes}"
                                SelectedItem="{Binding DisplayViewIndex}"
                                Style="{StaticResource FieldComboStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding StringFormat=图像窗口{0}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="0">
                                                            <Setter Property="Text" Value="不显示" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock
                                Margin="0,9,0,5"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="像素当量(mm/px)"
                                ToolTip="标定后填真实值，MaxAreaMm2 / TotalAreaMm2 即为物理量。默认 1.0 = 输出的 mm² 数值等于像素值。判定仍按像素做" />
                            <ui:NumericBox
                                Maximum="1000"
                                Minimum="0"
                                Style="{StaticResource FieldNumericStyle}">
                                <ui:NumericBox.Value>
                                    <Binding Path="PixelSizeMm" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <cv:NumberValidationRule FieldName="像素当量" Min="0" Max="1000" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </ui:NumericBox.Value>
                            </ui:NumericBox>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="接「标定」插件的 MmPerPixel 输出时，运行时以标定值为准；判定仍按像素做。" />

                            <TextBlock
                                Margin="0,9,0,5"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="输出排序"
                                ToolTip="CenterRows / CenterCols / DefectAreas / DefectWidths / DefectHeights 与 Defects 端口按同一顺序逐项对齐" />
                            <ComboBox
                                ItemsSource="{Binding SortModes}"
                                SelectedItem="{Binding SortMode, Mode=TwoWay}"
                                Style="{StaticResource FieldComboStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="数组端口与 Defects 端口按同一顺序逐项对齐，下游按同一索引取即可对上号。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  ================= 右：预览工作区 =================  -->
        <Border
            Grid.Column="1"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" MinHeight="40" />
                </Grid.RowDefinitions>

                <!--  预览头：标题 + 缺陷计数 + 工具条  -->
                <Grid Grid.Row="0" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="&#xf1c5;" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="标注图预览" />
                    <Border
                        Grid.Column="2"
                        Margin="8,0,0,0">
                        <Border.Style>
                            <Style BasedOn="{StaticResource CountChipStyle}" TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DefectCountText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource CountChipTextStyle}" Text="{Binding DefectCountText}" />
                    </Border>
                    <StackPanel
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Click="FitWindow_Click"
                            Content="&#xf065;"
                            Style="{StaticResource ToolbarButtonStyle}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="适应窗口" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Margin="2,0,0,0"
                            Click="FitImage_Click"
                            Content="1:1"
                            Style="{StaticResource ToolbarTextButtonStyle}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="实际像素 1:1" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  页签条  -->
                <Grid Grid.Row="1" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Padding="2"
                        VerticalAlignment="Center"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="{StaticResource PluginCardCornerRadius}">
                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource PreviewTabItemStyle}"
                            ItemsSource="{Binding PreviewTabLabels}"
                            SelectedIndex="{Binding SelectedPreviewTab, Mode=TwoWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="改参数后自动刷新" />
                </Grid>

                <!--  画布：ImageReadOnly 常驻；数据页签是覆盖层，不折叠图像控件  -->
                <Border Grid.Row="2" Background="{StaticResource PluginPreviewCanvasBrush}">
                    <Grid>
                        <h:ImageReadOnly x:Name="PreviewCanvas" HImage="{Binding PreviewImage}" />

                        <!--  左上角只读 chip：有图时显示  -->
                        <Border
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <Border.Style>
                                <Style BasedOn="{StaticResource PreviewChipStyle}" TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogSurfaceBrush}"
                                Text="标注图 · 只读" />
                        </Border>

                        <!--  空态：无图且非错误时显示  -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border Style="{StaticResource EmptyStateIconStyle}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="20"
                                        Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                        Text="&#xf1c5;" />
                                </Border>
                                <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="等待输入图像" />
                                <TextBlock Style="{StaticResource EmptyStateSubStyle}" Text="在流程中把上游图像连到「输入图像」端口；配置态预览会在接上后自动刷新。也可以先调参数，接图后立即看到标注结果。" />
                            </StackPanel>
                        </Grid>

                        <!--  错误态：无图且 StatusLevel=Error 时显示  -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding PreviewImage}" Value="{x:Null}" />
                                                <Condition Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border
                                    Width="46"
                                    Height="46"
                                    Margin="0,0,0,13"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource DialogDangerSubtleBrush}"
                                    BorderBrush="{StaticResource DialogDangerBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="20"
                                        Foreground="{StaticResource DialogDangerBrush}"
                                        Text="&#xf071;" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogDangerBrush}"
                                    Text="预览不可用" />
                                <TextBlock
                                    MaxWidth="380"
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                    Text="{Binding StatusMessage}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                    Text="请检查输入图像与检测/排除区域。"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!--  数据输出页签：覆盖层；图像控件仍在下面，不折叠  -->
                        <Border Background="{StaticResource DialogSurfaceBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreviewTab}" Value="1">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="12">
                                    <!--  缺陷清单  -->
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="10,12"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource PluginCardCornerRadius}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource DialogIconFont}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                    Text="&#xf03a;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                    Text="缺陷清单" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding DefectCountText}"
                                                    Typography.NumeralAlignment="Tabular" />
                                            </Grid>
                                            <DataGrid
                                                MaxHeight="180"
                                                ColumnHeaderStyle="{StaticResource DefectGridHeaderStyle}"
                                                ItemsSource="{Binding DefectRows}"
                                                SelectionChanged="DefectList_SelectionChanged"
                                                Style="{StaticResource DefectGridStyle}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Width="36"
                                                        Binding="{Binding Index}"
                                                        ElementStyle="{StaticResource DefectCellTextStyle}"
                                                        Header="#" />
                                                    <DataGridTextColumn
                                                        Width="70"
                                                        Binding="{Binding Area, StringFormat=0.#}"
                                                        ElementStyle="{StaticResource DefectCellTextStyle}"
                                                        Header="面积(px)" />
                                                    <DataGridTextColumn
                                                        Width="60"
                                                        Binding="{Binding Circularity, StringFormat=0.###}"
                                                        ElementStyle="{StaticResource DefectCellTextStyle}"
                                                        Header="圆度" />
                                                    <DataGridTextColumn
                                                        Width="66"
                                                        Binding="{Binding AspectRatio, StringFormat=0.#}"
                                                        ElementStyle="{StaticResource DefectCellTextStyle}"
                                                        Header="长宽比" />
                                                    <DataGridTextColumn
                                                        Width="56"
                                                        Binding="{Binding Width, StringFormat=0.#}"
                                                        ElementStyle="{StaticResource DefectCellTextStyle}"
                                                        Header="宽" />
                                                    <DataGridTextColumn
                                                        Width="56"
                                                        Binding="{Binding Height, StringFormat=0.#}"
                                                        ElementStyle="{StaticResource DefectCellTextStyle}"
                                                        Header="高" />
                                                    <DataGridTextColumn
                                                        Width="64"
                                                        Binding="{Binding Row, StringFormat=0.#}"
                                                        ElementStyle="{StaticResource DefectCellTextStyle}"
                                                        Header="行" />
                                                    <DataGridTextColumn
                                                        Width="64"
                                                        Binding="{Binding Col, StringFormat=0.#}"
                                                        ElementStyle="{StaticResource DefectCellTextStyle}"
                                                        Header="列" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="点行会在标注图上套黄框并自动切回图像视图；清单顺序与输出端口顺序一致（最多列前 200 行）。" />
                                        </StackPanel>
                                    </Border>

                                    <!--  灰度直方图  -->
                                    <Border
                                        Padding="10,12"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource PluginCardCornerRadius}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource DialogIconFont}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                    Text="&#xf080;" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                    Text="灰度直方图" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="标记区间 = 当前固定阈值"
                                                    Visibility="{Binding IsFixedThreshold, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <Grid Height="150">
                                                <h:HistogramPlot
                                                    Data="{Binding Histogram}"
                                                    ShowThresholdMarkers="{Binding IsFixedThreshold}"
                                                    ThresholdHigh="{Binding MaxGray}"
                                                    ThresholdLow="{Binding MinGray}"
                                                    Visibility="{Binding HistogramVisible, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource HelpTextStyle}"
                                                    Text="{Binding HistogramError}"
                                                    Visibility="{Binding HistogramErrorVisible, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding HistogramRangeText}"
                                                    Typography.NumeralAlignment="Tabular" />
                                                <TextBlock
                                                    Margin="12,0,0,0"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding HistogramTypeText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!--  状态栏：Info=绿 / Warning=橙 / Error=红，不新增第四档  -->
                <Border
                    Grid.Row="3"
                    Padding="12,0"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Style="{StaticResource StatusDotStyle}" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource StatusMessageBoxStyle}"
                            Text="{Binding StatusMessage, Mode=OneWay, Converter={StaticResource StatusMessageConverter}}"
                            ToolTip="{Binding StatusMessage}" />
                        <TextBlock
                            Grid.Column="2"
                            MaxWidth="300"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding HistogramTypeText}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
