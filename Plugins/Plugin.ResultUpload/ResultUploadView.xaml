<UserControl
    x:Class="Plugin.ResultUpload.ResultUploadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.ResultUpload"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.UI.com/ui"
    MinWidth="560"
    MinHeight="280"
    d:DesignHeight="680"
    d:DesignWidth="960"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:EnumLabelConverter x:Key="EnumLabel" />
            <local:EnumInToVisibilityConverter x:Key="EnumInVis" />
            <local:InverseBoolConverter x:Key="NotBool" />
            <local:LogLevelColorConverter x:Key="LevelColor" />
            <local:PreviewErrorConverter x:Key="PreviewError" />
            <local:UrlDisplayConverter x:Key="UrlDisplay" />
            <local:InputPortConverter x:Key="InputPortConv" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!--
                本视图只派生"外观"，不改共享控件：
                · 卡片/标题/帮助/按钮/图标按钮/行内输入/行内下拉全部就地定义；
                · 颜色一律走 Dialog* / Plugin* 公共令牌，视图内零十六进制。
            -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MiniButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="11.5" />
            </Style>

            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RowRemoveButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogDangerBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                字段行内的端口编辑器（R189：绑定一律走公共控件 LinkableValueEditor）。
                Port 用 MultiBinding：字段名 + 宿主插件 + PortsVersion 三路，
                端口对象重建后（PortsVersion 推一格）自动重取，不会指着已丢弃的旧端口。
                范式同 Plugin.DataRecord 的 ColumnPortEditorTemplate。
            -->
            <DataTemplate x:Key="FieldPortEditorTemplate">
                <cv:LinkableValueEditor
                    VerticalAlignment="Center"
                    Label=""
                    StepData="{Binding DataContext.StepData, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <cv:LinkableValueEditor.Port>
                        <MultiBinding Converter="{StaticResource InputPortConv}">
                            <Binding Path="Name" />
                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            <Binding Path="DataContext.PortsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                        </MultiBinding>
                    </cv:LinkableValueEditor.Port>
                </cv:LinkableValueEditor>
            </DataTemplate>

            <!--  报文预设卡片：IsChecked 仍由 ui:EnumConverter 写 PayloadKind  -->
            <Style x:Key="ModeCardStyle" TargetType="RadioButton">
                <Setter Property="GroupName" Value="PayloadKind" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border
                                x:Name="Card"
                                Padding="8,7"
                                Background="{StaticResource DialogSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                    <Border
                                        x:Name="Check"
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Margin="5,0,0,0"
                                        Background="{StaticResource DialogAccentBrush}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="9"
                                            Foreground="{StaticResource DialogSurfaceBrush}"
                                            Text="&#xf00c;" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Card" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModeIconChipStyle" TargetType="Border">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ModeIconGlyphStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ModeTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="ModeSubtitleStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RowInputStyle" BasedOn="{StaticResource DialogCellInput}" TargetType="TextBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Padding" Value="6,0" />
            </Style>

            <Style x:Key="RowComboStyle" BasedOn="{StaticResource DialogCombo}" TargetType="ComboBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Padding" Value="7,0,24,0" />
            </Style>

            <Style x:Key="LogListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>

            <Style x:Key="PayloadTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="LineHeight" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PayloadPreview, Converter={StaticResource PreviewError}}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左配置轨（280~340，1*）+ 右报文工作区（1.75*）。
        920 内容区 → 左 340 / 右 580；600 内容区 → 左 280 / 右 320。
        颜色/字号走公共令牌，视图内零十六进制。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="280" MaxWidth="340" />
            <ColumnDefinition Width="1.75*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!--  ==================== 左：配置轨 ====================  -->
        <Border
            Grid.Column="0"
            Margin="0,0,12,0"
            Padding="12"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!--  报文预设：2×2 卡片  -->
                    <UniformGrid Margin="-4,-4,-4,0" Columns="2">
                        <RadioButton
                            Margin="4"
                            IsChecked="{Binding PayloadKind, Converter={ui:EnumConverter}, ConverterParameter={x:Static local:PayloadKind.FieldTable}}"
                            Style="{StaticResource ModeCardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ModeIconChipStyle}">
                                    <TextBlock Style="{StaticResource ModeIconGlyphStyle}" Text="&#xf1c0;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ModeTitleStyle}" Text="MES 字段表" />
                                    <TextBlock Style="{StaticResource ModeSubtitleStyle}" Text="字段表 = 载荷" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            Margin="4"
                            IsChecked="{Binding PayloadKind, Converter={ui:EnumConverter}, ConverterParameter={x:Static local:PayloadKind.DingTalkText}}"
                            Style="{StaticResource ModeCardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ModeIconChipStyle}">
                                    <TextBlock Style="{StaticResource ModeIconGlyphStyle}" Text="&#xf075;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ModeTitleStyle}" Text="钉钉文本" />
                                    <TextBlock Style="{StaticResource ModeSubtitleStyle}" Text="群机器人通知" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            Margin="4"
                            IsChecked="{Binding PayloadKind, Converter={ui:EnumConverter}, ConverterParameter={x:Static local:PayloadKind.WeComText}}"
                            Style="{StaticResource ModeCardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ModeIconChipStyle}">
                                    <TextBlock Style="{StaticResource ModeIconGlyphStyle}" Text="&#xf27a;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ModeTitleStyle}" Text="企业微信" />
                                    <TextBlock Style="{StaticResource ModeSubtitleStyle}" Text="群机器人通知" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton
                            Margin="4"
                            IsChecked="{Binding PayloadKind, Converter={ui:EnumConverter}, ConverterParameter={x:Static local:PayloadKind.RawJson}}"
                            Style="{StaticResource ModeCardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource ModeIconChipStyle}">
                                    <TextBlock Style="{StaticResource ModeIconGlyphStyle}" Text="&#xf121;" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ModeTitleStyle}" Text="原始 JSON" />
                                    <TextBlock Style="{StaticResource ModeSubtitleStyle}" Text="自定义报文" />
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!--  目标与连接  -->
                    <StackPanel Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="目标与连接" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SectionHintStyle}"
                                Text="URL / 超时 / 鉴权" />
                        </Grid>

                        <TextBlock
                            Margin="0,9,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="目标 URL" />
                        <TextBox
                            Height="36"
                            Style="{StaticResource DialogInput}"
                            Tag="https://…"
                            Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="MES 接口地址，或钉钉 / 企业微信机器人 webhook。" />
                            </TextBox.ToolTip>
                        </TextBox>
                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="MES 接口地址，或钉钉 / 企业微信机器人 webhook。" />

                        <TextBlock
                            Margin="0,12,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="单次请求超时" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Height="36"
                                Style="{StaticResource DialogInput}"
                                Text="{Binding TimeoutMs}">
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="单次请求超时（毫秒），默认 3000；≤0 会被插件自动拉回 3000" />
                                </TextBox.ToolTip>
                            </TextBox>
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="ms" />
                        </Grid>
                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="默认 3000；≤ 0 会被插件自动拉回 3000。" />

                        <!--  高级连接：请求头 / 加签 / 证书  -->
                        <Expander Margin="0,12,0,0" Header="高级连接（请求头 / 加签 / 证书）">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="请求头（MES 常要 Authorization；钉钉 / 企微 webhook 不用填）" />
                                <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Headers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Style="{StaticResource RowInputStyle}"
                                                    Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="请求头名，如 Authorization" />
                                                    </TextBox.ToolTip>
                                                </TextBox>
                                                <PasswordBox
                                                    Grid.Column="1"
                                                    Height="30"
                                                    Margin="4,0,0,0"
                                                    Padding="6,0"
                                                    VerticalContentAlignment="Center"
                                                    Background="{StaticResource DialogInputBackgroundBrush}"
                                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                                    BorderThickness="1"
                                                    FontSize="11.5"
                                                    local:PasswordBoxHelper.BoundPassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <PasswordBox.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="请求头值（打码显示，如 Bearer xxxx；持久化仍是明文随方案保存）" />
                                                    </PasswordBox.ToolTip>
                                                </PasswordBox>
                                                <Button
                                                    Grid.Column="2"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xf00d;"
                                                    Style="{StaticResource RowRemoveButtonStyle}">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="删除此请求头" />
                                                    </Button.ToolTip>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AddHeaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="+ 添加请求头"
                                    Style="{StaticResource MiniButtonStyle}" />

                                <TextBlock
                                    Margin="0,12,0,6"
                                    Style="{StaticResource FieldLabelStyle}"
                                    Text="钉钉加签密钥" />
                                <PasswordBox
                                    Height="36"
                                    Padding="10,0"
                                    VerticalContentAlignment="Center"
                                    Background="{StaticResource DialogInputBackgroundBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="1"
                                    FontSize="12.5"
                                    local:PasswordBoxHelper.BoundPassword="{Binding SignSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <PasswordBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="钉钉机器人安全设置选「加签」时的 SEC 开头密钥；非空时每次发送自动拼 timestamp+sign（重试会重签防过期）。MES / 企微 / 其他留空" />
                                    </PasswordBox.ToolTip>
                                </PasswordBox>
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="非空时每次发送自动拼 timestamp + sign（重试会重签防过期）。" />

                                <CheckBox
                                    Margin="0,12,0,0"
                                    Content="跳过 HTTPS 证书校验"
                                    Foreground="{StaticResource DialogDangerTextBrush}"
                                    IsChecked="{Binding SkipCertValidation}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="自签证书内网调试用；开启后不校验服务器证书，非必要不开" />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogDangerTextBrush}"
                                    Text="⚠ 有中间人风险，仅自签证书调试用"
                                    Visibility="{Binding SkipCertValidation, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!--  发送策略  -->
                    <StackPanel Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="发送策略" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SectionHintStyle}"
                                Text="时机 / 队列 / 失败处置" />
                        </Grid>

                        <TextBlock
                            Margin="0,9,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="上报时机" />
                        <ComboBox
                            Height="36"
                            ItemsSource="{Binding SendTimings}"
                            SelectedItem="{Binding SendTiming}"
                            Style="{StaticResource DialogCombo}">
                            <ComboBox.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="每次执行=MES 逐件上报；仅 NG=IM 通知的常规姿势；触发端口=收工信号触发" />
                            </ComboBox.ToolTip>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  上报时机=触发端口  -->
                        <StackPanel Visibility="{Binding SendTiming, Converter={StaticResource EnumInVis}, ConverterParameter=OnTrigger}">
                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="触发信号" />
                            <cv:LinkableValueEditor
                                Label=""
                                Port="{Binding TriggerPort}"
                                StepData="{Binding StepData}" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="仍由 LinkableValueEditor 承载；不连线 = 该次不上报。" />
                        </StackPanel>

                        <!--  上报时机=仅 NG  -->
                        <StackPanel Visibility="{Binding SendTiming, Converter={StaticResource EnumInVis}, ConverterParameter=OnlyNG}">
                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{StaticResource FieldLabelStyle}"
                                Text="判定字段 / NG 值" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Height="36"
                                    FontSize="12.5"
                                    IsEditable="True"
                                    ItemsSource="{Binding JudgeFieldNames}"
                                    Text="{Binding JudgeFieldName}">
                                    <ComboBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="看哪个字段的值（从字段表里选，也可手填字段名）" />
                                    </ComboBox.ToolTip>
                                </ComboBox>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="等于" />
                                <TextBox
                                    Grid.Column="2"
                                    Height="36"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding NgValue, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="判定字段的值等于它（不区分大小写）即视为 NG" />
                                    </TextBox.ToolTip>
                                </TextBox>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="数值 / 布尔 / 文本三路智能比对，不区分大小写。" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <CheckBox
                                Margin="0,0,0,6"
                                Content="异步队列（推荐）"
                                IsChecked="{Binding AsyncMode}">
                                <CheckBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="取消勾选=同步等响应（下游要用 Response/状态码时用，超时会拖节拍）" />
                                </CheckBox.ToolTip>
                            </CheckBox>
                            <CheckBox
                                Content="上报失败阻断流程"
                                IsChecked="{Binding BlockOnFailure}">
                                <CheckBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="默认不勾：宁漏报不停线；MES 没收到就停线的场合才勾" />
                                </CheckBox.ToolTip>
                            </CheckBox>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="异步：组报文入队微秒级返回，网络再烂也拖不垮节拍。" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="失败重试" />
                                <TextBox
                                    Height="36"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding RetryCount}">
                                    <TextBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="失败后再试几次（退避 0.5s/1s/1.5s… 封顶 3s），0~10" />
                                    </TextBox.ToolTip>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="成功关键字" />
                                <TextBox
                                    Height="36"
                                    Style="{StaticResource DialogInput}"
                                    Tag="留空 = 2xx 即成功"
                                    Text="{Binding SuccessKeyword, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="非空时：HTTP 2xx 且响应体包含它才算业务成功（如钉钉响应里的 errcode）。留空=2xx 即成功" />
                                    </TextBox.ToolTip>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="重试退避 0.5s / 1s / 1.5s… 封顶 3s；关键字命中才算业务成功。" />

                        <CheckBox
                            Margin="0,12,0,0"
                            Content="断网续传"
                            IsChecked="{Binding SpoolEnabled}">
                            <CheckBox.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="断网期间失败的件存到 exe目录\ResultUploadSpool\spool.jsonl（上限 10 万行，满了丢最老）；后台空闲时自动补传且实时件优先；每条自动带 X-Upload-Id 幂等头，MES 端按 ID 去重不会记重" />
                            </CheckBox.ToolTip>
                        </CheckBox>
                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="重试穷尽落盘，网络恢复后自动补传；每条带幂等 ID。" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  ==================== 右：报文工作区 ====================  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="128" />
                <RowDefinition Height="172" />
            </Grid.RowDefinitions>

            <!--  上报内容  -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="上报内容" />
                        <Border
                            Grid.Column="1"
                            Height="20"
                            Margin="8,0,0,0"
                            Padding="7,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource DialogAccentLightBrush}"
                            CornerRadius="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogAccentTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="字段表" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFieldTable}" Value="False">
                                                <Setter Property="Text" Value="值池" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Style="{StaticResource SectionHintStyle}"
                            Text="字段表就是 JSON 载荷本身，数字不带引号"
                            Visibility="{Binding PayloadKind, Converter={StaticResource EnumInVis}, ConverterParameter=FieldTable}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Style="{StaticResource SectionHintStyle}"
                            Text="字段表是模板占位符的值池；来源=端口会生成输入端口"
                            Visibility="{Binding PayloadKind, Converter={StaticResource EnumInVis}, ConverterParameter='DingTalkText,WeComText,RawJson'}" />
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                Style="{StaticResource HelpTextStyle}"
                                Text="来源=端口：字段名就是输入端口名，点行内 🔗 选上游输出或全局变量；来源=变量 / 内置：运行期按名取值。"
                                Visibility="{Binding PayloadKind, Converter={StaticResource EnumInVis}, ConverterParameter='DingTalkText,WeComText,RawJson'}" />
                            <TextBlock
                                Margin="0,0,0,4"
                                Style="{StaticResource HelpTextStyle}"
                                Text="启用字段会出现在 JSON 里；数字按真实类型写出（不带引号）。"
                                Visibility="{Binding PayloadKind, Converter={StaticResource EnumInVis}, ConverterParameter=FieldTable}" />

                            <!--  字段表列头  -->
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="启用" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="字段名" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="来源" />
                                <TextBlock
                                    Grid.Column="3"
                                    Margin="6,0,0,0"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="取值" />
                            </Grid>

                            <Grid>
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding Enabled}">
                                                    <CheckBox.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="是否参与上报（临时停用不必删除）" />
                                                    </CheckBox.ToolTip>
                                                </CheckBox>
                                                <TextBox
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0"
                                                    Style="{StaticResource RowInputStyle}"
                                                    Text="{Binding Name}">
                                                    <TextBox.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="字段名（JSON 键 / 占位符名；来源=端口时也是端口名。改名后连线会自动迁到新端口名）" />
                                                    </TextBox.ToolTip>
                                                </TextBox>
                                                <ComboBox
                                                    Grid.Column="2"
                                                    Margin="4,0,0,0"
                                                    ItemsSource="{Binding DataContext.FieldSources, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedItem="{Binding Source}"
                                                    Style="{StaticResource RowComboStyle}">
                                                    <ComboBox.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="取值来源：取值（绑定）=点 🔗 绑全局变量/系统变量/运行时变量/上游端口（绑定后显示路径） / 内置=自动供给" />
                                                    </ComboBox.ToolTip>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Grid Grid.Column="3" Margin="4,0,0,0">
                                                    <!--
                                                        旧配置兜底（方案 B）：「变量」档已下线，但旧 .vms 打开时仍可能是这一档。
                                                        显示只读提示 + 原变量名（不给已经不能用的输入框），
                                                        明确告诉用户改选「取值（绑定）」；运行期仍按旧口径取值。
                                                    -->
                                                    <Border
                                                        Padding="8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource DialogRowAlternateBrush}"
                                                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Visibility="{Binding Source, Converter={StaticResource EnumInVis}, ConverterParameter=Variable}">
                                                        <TextBlock
                                                            Style="{StaticResource HelpTextStyle}"
                                                            Text="{Binding VariableName, StringFormat=旧配置：{0}（已弃用，请改选「取值（绑定）」）}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="「变量」档已下线：取值统一走「取值（绑定）」——点 🔗 直接绑全局变量 / 系统变量 / 运行时变量 / 上游端口，绑定后显示路径。本行保留旧变量名仅供对照，运行期仍按旧口径取值。" />
                                                    </Border>
                                                    <ComboBox
                                                        ItemsSource="{Binding DataContext.BuiltInFields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        SelectedItem="{Binding BuiltIn}"
                                                        Style="{StaticResource RowComboStyle}"
                                                        Visibility="{Binding Source, Converter={StaticResource EnumInVis}, ConverterParameter=BuiltIn}">
                                                        <ComboBox.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="内置字段：时间戳=上报时刻；步骤名=本步骤实例名" />
                                                        </ComboBox.ToolTip>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <!--
                                                        来源=端口：用公共控件 LinkableValueEditor（R189）。
                                                        按需由 ContentControl 实例化而不是常驻 + Visibility：
                                                        非端口行没有动态端口（GetInputPort 返回 null），常驻会留下一个 Port=null 的空编辑器。
                                                        端口对象每次 RebuildDynamicInputs 都换新，靠 PortsVersion 这个 MultiBinding 锚点重取。
                                                    -->
                                                    <ContentControl
                                                        VerticalAlignment="Center"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource FieldPortEditorTemplate}"
                                                        Visibility="{Binding Source, Converter={StaticResource EnumInVis}, ConverterParameter=Port}" />
                                                </Grid>
                                                <Button
                                                    Grid.Column="4"
                                                    Margin="2,0,0,0"
                                                    Command="{Binding RemoveFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xf00d;"
                                                    Style="{StaticResource RowRemoveButtonStyle}">
                                                    <Button.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="删除此字段" />
                                                    </Button.ToolTip>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  空字段态  -->
                                <Border
                                    MinHeight="96"
                                    Padding="16"
                                    Background="{StaticResource DialogRowAlternateBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="{StaticResource PluginCardCornerRadius}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Fields.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="18"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="&#xf0ce;" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="还没有启用字段，至少添加一个字段才有东西可上报"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding AddFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="+ 添加字段"
                                Style="{StaticResource MiniButtonStyle}" />

                            <!--  字段操作回执（绑定 / 解绑 / 改名的结果；空串时整行不占位）  -->
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--  旧「变量」档提示（方案 B）：只在旧配置里存在该档时才有内容  -->
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding LegacyVariableNotice}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LegacyVariableNotice}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--  通知内容模板  -->
                            <StackPanel
                                Margin="0,10,0,0"
                                Visibility="{Binding PayloadKind, Converter={StaticResource EnumInVis}, ConverterParameter='DingTalkText,WeComText'}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="通知内容模板" />
                                <TextBox
                                    MinHeight="54"
                                    AcceptsReturn="True"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding MessageTemplate, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top">
                                    <TextBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="例：件{sn}判定{result}，直径{value1}" />
                                    </TextBox.ToolTip>
                                </TextBox>
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="占位符：{字段名} {时间} {日期} {步骤名}；找不到的字段会原样保留，便于发现写错名。" />
                            </StackPanel>

                            <!--  原始 JSON 模板  -->
                            <StackPanel
                                Margin="0,10,0,0"
                                Visibility="{Binding PayloadKind, Converter={StaticResource EnumInVis}, ConverterParameter=RawJson}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="JSON 模板" />
                                <TextBox
                                    MinHeight="78"
                                    AcceptsReturn="True"
                                    FontFamily="{StaticResource PluginMonoFontFamily}"
                                    FontSize="11"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding RawJsonTemplate, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    VerticalContentAlignment="Top">
                                    <TextBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="例：{&quot;sn&quot;:&quot;{sn}&quot;,&quot;value&quot;:{#value1}}" />
                                    </TextBox.ToolTip>
                                </TextBox>
                                <TextBlock Style="{StaticResource HelpTextStyle}" Text="{}{名} = 转义字符串注入；{#名} = 原样注入（数字 / 布尔 / JSON 片段不带引号）。" />
                            </StackPanel>

                            <!--  时间戳  -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="时间格式" />
                                    <TextBox
                                        Height="36"
                                        Style="{StaticResource DialogInput}"
                                        Text="{Binding TimestampFormat, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="内置「时间戳」字段和 {时间} 占位符的输出格式（.NET 格式串，留空用 yyyy-MM-dd HH:mm:ss.fff）" />
                                        </TextBox.ToolTip>
                                    </TextBox>
                                </StackPanel>
                                <CheckBox
                                    Grid.Column="1"
                                    Margin="0,22,0,0"
                                    VerticalAlignment="Center"
                                    Content="UTC"
                                    IsChecked="{Binding TimestampUtc}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="勾选=时间戳输出 UTC 时间（对接跨时区 MES 用）；默认本机时间" />
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </Grid>
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="影响内置「时间戳」字段与 {时间} / {时间戳} 占位符；留空用默认格式。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  实际发出  -->
            <Border
                Grid.Row="1"
                Margin="0,8,0,0"
                Padding="0"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,8,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="实际发出" />
                        <Border
                            Grid.Column="1"
                            Height="20"
                            Margin="8,0,0,0"
                            Padding="7,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource DialogSuccessSubtleBrush}"
                            CornerRadius="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogSuccessTextBrush}"
                                Text="实时预览" />
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Style="{StaticResource SectionHintStyle}"
                            Text="只读 · 与真实发送共用同一套组报文逻辑" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="{StaticResource PluginPreviewCanvasBrush}"
                        BorderBrush="{StaticResource PluginPreviewBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="10,5,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource DialogSuccessBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource PluginMonoFontFamily}"
                                    FontSize="10"
                                    Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                    Text="{Binding Url, Converter={StaticResource UrlDisplay}}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                    Text="{Binding PayloadKind, Converter={StaticResource EnumLabel}}" />
                            </Grid>
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    Margin="10,4,10,8"
                                    Style="{StaticResource PayloadTextStyle}"
                                    Text="{Binding PayloadPreview}" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  测试发送 + 最近日志  -->
            <Border
                Grid.Row="2"
                Margin="0,8,0,0"
                Padding="0"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,8,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="测试发送" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource SectionHintStyle}"
                                Text="按当前配置真发一条，当场验证 URL / 报文 / 鉴权" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Command="{Binding TestSendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="立即发送"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource NotBool}}"
                            Style="{StaticResource LocalPrimaryButtonStyle}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="后台线程发送，不卡界面" />
                            </Button.ToolTip>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,6,12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="ResultText"
                            MinHeight="30"
                            Padding="8,6"
                            Background="{StaticResource DialogRowAlternateBrush}"
                            FontSize="11.5"
                            Text="{Binding LastResult}"
                            TextWrapping="Wrap" />

                        <Grid Grid.Row="1" Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="最近上报日志" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SectionHintStyle}"
                                    Text="最近 50 条 · 测试发送也留痕" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Command="{Binding RefreshLogsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="刷新"
                                Style="{StaticResource MiniButtonStyle}" />
                        </Grid>

                        <Border
                            Grid.Row="2"
                            Padding="4"
                            Background="{StaticResource DialogRowAlternateBrush}"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PluginCardCornerRadius}">
                            <ListBox x:Name="RecentLogsList" Style="{StaticResource LogListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="Bold"
                                                Foreground="{Binding Level, Converter={StaticResource LevelColor}}"
                                                Text="{Binding Level}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="{Binding Message}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding Message}" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
