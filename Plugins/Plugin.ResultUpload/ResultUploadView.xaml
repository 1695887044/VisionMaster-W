<UserControl
    x:Class="Plugin.ResultUpload.ResultUploadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Plugin.ResultUpload"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="540"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:EnumLabelConverter x:Key="EnumLabel" />
            <local:EnumInToVisibilityConverter x:Key="EnumInVis" />
            <local:InverseBoolConverter x:Key="NotBool" />
            <local:LogLevelColorConverter x:Key="LevelColor" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!--
                卡片/标题/提示/预览/字段标签/输入框/按钮/下拉全部收编进 UI 库 Plugin* 键。
                本地只留"公共派生 + 本视图专属"，各自的理由：
                · Card：五家视图（Excel/本视图/DataRecord/CSharpScript/ImageScript）的卡片内边距抄写源是 12，
                  公共 PluginCard 是 14 —— 零视觉变化优先，BasedOn 挂靠结构、只覆盖 Padding，归一待确认后删除。
                · EnumCombo / RowEnumCombo：只有"条目显示中文标签"的转换器（EnumLabel）是本视图专属；
                · RowBox / MiniButton：尺寸比公共版小一号的行内变体，BasedOn 公共版再覆盖尺寸；
                · 危险红 #C62828 / 提示绿 #2E7D32 / 预览浅蓝底 #F5F9FE / 日志底 #FAFAFA 无对应公共令牌，
                  保持内联原值（字典里没有就不硬造，已记录汇报）。
            -->
            <Style x:Key="Card" BasedOn="{StaticResource PluginCard}" TargetType="Border">
                <Setter Property="Padding" Value="12" />
            </Style>
            <!--  枚举下拉：条目显示中文标签（通用枚举标签转换器），SelectedItem 仍是枚举本身  -->
            <Style
                x:Key="EnumCombo"
                BasedOn="{StaticResource PluginModernComboBase}"
                TargetType="ComboBox">
                <Setter Property="ItemContainerStyle" Value="{StaticResource PluginModernComboItem}" />
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--  行内小号枚举下拉  -->
            <Style
                x:Key="RowEnumCombo"
                BasedOn="{StaticResource EnumCombo}"
                TargetType="ComboBox">
                <Setter Property="Height" Value="22" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <!--  字段表/请求头行内的小输入框  -->
            <Style x:Key="RowBox" BasedOn="{StaticResource PluginFieldBox}" TargetType="TextBox">
                <Setter Property="Height" Value="22" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="2,0" />
            </Style>
            <Style x:Key="MiniButton" BasedOn="{StaticResource PluginPrimaryButton}" TargetType="Button">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!--  卡片1：报文预设（往哪发、什么格式）  -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PluginCardTitle}" Text="① 报文预设" />
                    <TextBlock
                        Margin="0,2,0,6"
                        Style="{StaticResource PluginHintText}"
                        Text="MES 上传 / 钉钉·企微通知 / 自定义协议——底层都是往一个 URL 发一条 JSON" />
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="报文格式" />
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource EnumCombo}"
                            ItemsSource="{Binding PayloadKinds}"
                            SelectedItem="{Binding PayloadKind}"
                            ToolTip="MES字段表=字段表就是JSON载荷；钉钉/企微=群机器人文本通知；原始JSON=自己写模板（兜底奇葩协议）" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="目标 URL" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="MES 接口地址；钉钉机器人：https://oapi.dingtalk.com/robot/send?access_token=xxx；企业微信：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="超时 ms" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding TimeoutMs}"
                            ToolTip="单次请求超时（毫秒），默认 3000" />
                    </Grid>

                    <!--  自定义请求头（Key-Value 行编辑）  -->
                    <TextBlock
                        Margin="0,6,0,2"
                        Style="{StaticResource PluginHintText}"
                        Text="请求头（MES 常要 Authorization；钉钉/企微 webhook 不用填）" />
                    <ItemsControl ItemsSource="{Binding Headers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Style="{StaticResource RowBox}"
                                        Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="请求头名，如 Authorization" />
                                    <PasswordBox
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Height="22"
                                        VerticalContentAlignment="Center"
                                        FontSize="11"
                                        Padding="2,0"
                                        local:PasswordBoxHelper.BoundPassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="请求头值（打码显示，如 Bearer xxxx；持久化仍是明文随方案保存）" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveHeader_Click"
                                        Content="✕"
                                        Cursor="Hand"
                                        FontSize="11"
                                        Foreground="#C62828"
                                        ToolTip="删除此请求头" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        Click="AddHeader_Click"
                        Content="+ 添加请求头"
                        Style="{StaticResource MiniButton}" />
                </StackPanel>
            </Border>

            <!--  卡片2：上传内容（字段表 + 模板 + 预览）  -->
            <Border
                Margin="{StaticResource PluginSectionMargin}"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PluginCardTitle}" Text="② 上传内容（字段表）" />
                    <TextBlock
                        Margin="0,2,0,4"
                        Style="{StaticResource PluginHintText}"
                        Text="MES字段表模式：这张表就是 JSON 载荷本身（数字不带引号）。" />
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource PluginHintText}"
                        Text="通知/原始JSON模式：这张表是模板占位符的值池——来源=端口的字段会生成输入端口，画布上连线供值。" />

                    <!--  字段表  -->
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        IsChecked="{Binding Enabled}"
                                        VerticalAlignment="Center"
                                        ToolTip="是否参与上报（临时停用不必删除）" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="2,0"
                                        Style="{StaticResource RowBox}"
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="字段名（JSON 键 / 占位符名；来源=端口时也是端口名）" />
                                    <ComboBox
                                        Grid.Column="2"
                                        Margin="2,0"
                                        Style="{StaticResource RowEnumCombo}"
                                        ItemsSource="{Binding DataContext.FieldSources, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedItem="{Binding Source}"
                                        ToolTip="取值来源：端口=画布连线 / 变量=运行期变量池 / 内置=自动供给" />
                                    <TextBox
                                        Grid.Column="3"
                                        Margin="2,0"
                                        Style="{StaticResource RowBox}"
                                        Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="变量名（运行期变量池的键，如『变量定义』步骤写入的名字）"
                                        Visibility="{Binding Source, Converter={StaticResource EnumInVis}, ConverterParameter=Variable}" />
                                    <ComboBox
                                        Grid.Column="3"
                                        Margin="2,0"
                                        Style="{StaticResource RowEnumCombo}"
                                        ItemsSource="{Binding DataContext.BuiltInFields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        SelectedItem="{Binding BuiltIn}"
                                        ToolTip="内置字段：时间戳=上报时刻；步骤名=本步骤实例名"
                                        Visibility="{Binding Source, Converter={StaticResource EnumInVis}, ConverterParameter=BuiltIn}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="6,0,0,0"
                                        FontSize="11"
                                        Foreground="#2E7D32"
                                        Text="画布上连线供值"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Source, Converter={StaticResource EnumInVis}, ConverterParameter=Port}" />
                                    <Button
                                        Grid.Column="4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveField_Click"
                                        Content="✕"
                                        Cursor="Hand"
                                        FontSize="11"
                                        Foreground="#C62828"
                                        ToolTip="删除此字段" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        Click="AddField_Click"
                        Content="+ 添加字段"
                        Style="{StaticResource MiniButton}" />

                    <!--  通知内容模板（钉钉/企微）  -->
                    <Grid
                        Margin="{StaticResource PluginSectionMargin}"
                        Visibility="{Binding PayloadKind, Converter={StaticResource EnumInVis}, ConverterParameter='DingTalkText,WeComText'}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PluginHintText}" Text="通知内容（占位符：&#x7B;字段名&#x7D; &#x7B;时间&#x7D; &#x7B;日期&#x7D; &#x7B;步骤名&#x7D;，例：件&#x7B;sn&#x7D;判定&#x7B;result&#x7D;）" />
                        <TextBox
                            Grid.Row="1"
                            Margin="0,3,0,0"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding MessageTemplate, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="例：件&#x7B;sn&#x7D;判定&#x7B;result&#x7D;，直径&#x7B;value1&#x7D;" />
                    </Grid>

                    <!--  原始 JSON 模板  -->
                    <Grid
                        Margin="{StaticResource PluginSectionMargin}"
                        Visibility="{Binding PayloadKind, Converter={StaticResource EnumInVis}, ConverterParameter=RawJson}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource PluginHintText}" Text="JSON 模板（&#x7B;名&#x7D;=转义字符串注入；&#x7B;#名&#x7D;=原样注入，数字/布尔/JSON片段不带引号）" />
                        <TextBox
                            Grid.Row="1"
                            Margin="0,3,0,0"
                            MinHeight="52"
                            AcceptsReturn="True"
                            FontFamily="Consolas, Microsoft YaHei"
                            FontSize="11"
                            Text="{Binding RawJsonTemplate, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            ToolTip="例：&#x7B;&quot;sn&quot;:&quot;&#x7B;sn&#x7D;&quot;,&quot;value&quot;:&#x7B;#value1&#x7D;&#x7D;" />
                    </Grid>

                    <!--  时间戳格式 + UTC（影响内置"时间戳"字段与 {时间}/{时间戳} 占位符，改完预览即时见效）  -->
                    <Grid Margin="{StaticResource PluginFieldRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="时间格式" />
                        <TextBox
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding TimestampFormat, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="内置「时间戳」字段和 {时间} 占位符的输出格式（.NET 格式串，留空用 yyyy-MM-dd HH:mm:ss.fff）；例 yyyy/MM/dd HH:mm 或 yyyy-MM-ddTHH:mm:ss.fff" />
                        <CheckBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="UTC"
                            IsChecked="{Binding TimestampUtc}"
                            ToolTip="勾选=时间戳输出 UTC 时间（对接跨时区 MES 用）；默认本机时间" />
                    </Grid>

                    <!--  报文预览  -->
                    <Border
                        Margin="{StaticResource PluginFieldRowMargin}"
                        Padding="8,5"
                        Background="#F5F9FE"
                        CornerRadius="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PluginHintText}" Text="实际发出 →" />
                            <TextBlock Style="{StaticResource PluginPreviewText}" Text="{Binding PayloadPreview}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  卡片3：发送策略  -->
            <Border
                Margin="{StaticResource PluginSectionMargin}"
                Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PluginCardTitle}" Text="③ 发送策略" />
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="上报时机" />
                        <ComboBox
                            Grid.Column="1"
                            Style="{StaticResource EnumCombo}"
                            ItemsSource="{Binding SendTimings}"
                            SelectedItem="{Binding SendTiming}"
                            ToolTip="每次执行=MES逐件上报；仅NG=IM通知的常规姿势；触发端口=收工信号触发" />
                    </Grid>

                    <!--  上报时机=触发端口 时出现：把上游信号连给"上报触发"端口  -->
                    <Grid
                        Margin="0,2"
                        Visibility="{Binding SendTiming, Converter={StaticResource EnumInVis}, ConverterParameter=OnTrigger}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="触发信号" />
                        <cv:LinkableValueEditor
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            StepData="{Binding StepData}"
                            Port="{Binding TriggerPort}" />
                    </Grid>

                    <!--  上报时机=仅NG 时出现：判定字段 + NG 值  -->
                    <Grid
                        Margin="0,2"
                        Visibility="{Binding SendTiming, Converter={StaticResource EnumInVis}, ConverterParameter=OnlyNG}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="判定字段" />
                        <ComboBox
                            Grid.Column="1"
                            IsEditable="True"
                            Style="{StaticResource EnumCombo}"
                            Text="{Binding JudgeFieldName}"
                            ItemsSource="{Binding JudgeFieldNames}"
                            ToolTip="看哪个字段的值（从字段表里选，也可手填字段名）" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,4,0"
                            Style="{StaticResource PluginFieldLabelFixed}"
                            Width="Auto"
                            Text="等于" />
                        <TextBox
                            Grid.Column="3"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding NgValue, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="判定字段的值等于它（不区分大小写）即视为 NG" />
                    </Grid>

                    <TextBlock
                        Margin="{StaticResource PluginFieldRowMargin}"
                        Style="{StaticResource PluginHintText}"
                        Text="异步队列（推荐）：组报文入队微秒级返回，网络再烂也拖不垮节拍" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,14,0"
                            Content="异步队列"
                            IsChecked="{Binding AsyncMode}"
                            ToolTip="取消勾选=同步等响应（下游要用 Response/状态码时用，超时会拖节拍）" />
                        <CheckBox
                            Content="上报失败阻断流程"
                            IsChecked="{Binding BlockOnFailure}"
                            ToolTip="默认不勾：宁漏报不停线；MES 没收到就停线的场合才勾" />
                    </StackPanel>
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="失败重试" />
                        <TextBox
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding RetryCount}"
                            ToolTip="失败后再试几次（退避 0.5s/1s/1.5s… 封顶 3s），0~10" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource PluginFieldLabelFixed}"
                            Width="Auto"
                            Text="成功关键字" />
                        <TextBox
                            Grid.Column="3"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding SuccessKeyword, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="非空时：HTTP 2xx 且响应体包含它才算业务成功（如钉钉响应里的 errcode）。留空=2xx 即成功" />
                    </Grid>

                    <!--  断网续传（默认开：spool 落盘 + 空闲补传 + 幂等 ID）  -->
                    <CheckBox
                        Margin="{StaticResource PluginFieldRowMargin}"
                        Content="断网续传（重试穷尽落盘，网络恢复后自动补传）"
                        IsChecked="{Binding SpoolEnabled}"
                        ToolTip="断网期间失败的件存到 exe目录\ResultUploadSpool\spool.jsonl（上限 10 万行，满了丢最老）；后台空闲时自动补传且实时件优先；每条自动带 X-Upload-Id 幂等头，MES 端按 ID 去重不会记重" />

                    <!--  钉钉加签密钥（可选）  -->
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource PluginFieldLabelFixed}" Text="加签密钥" />
                        <TextBox
                            Grid.Column="1"
                            Style="{StaticResource PluginFieldBox}"
                            Text="{Binding SignSecret, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="钉钉机器人安全设置选「加签」时的 SEC 开头密钥；非空时每次发送自动拼 timestamp+sign（重试会重签防过期）。MES/企微/其他留空" />
                    </Grid>

                    <!--  跳过证书校验（默认关 + 红字警告仅勾选时出现）  -->
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <CheckBox
                            Foreground="#C62828"
                            Content="跳过 HTTPS 证书校验"
                            IsChecked="{Binding SkipCertValidation}"
                            ToolTip="自签证书内网调试用；开启后不校验服务器证书，非必要不开" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#C62828"
                            Text="⚠ 有中间人风险，仅自签证书调试用"
                            Visibility="{Binding SkipCertValidation, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  卡片4：测试发送  -->
            <Border
                Margin="{StaticResource PluginSectionMargin}"
                Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PluginCardTitle}" Text="④ 测试发送" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource PluginHintText}"
                                Text="按上面的配置真发一条，当场验证 URL/报文/鉴权（端口没值用(空)占位）" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Content="立即发送"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource NotBool}}"
                            Click="TestSend_Click"
                            Style="{StaticResource PluginPrimaryButton}"
                            ToolTip="后台线程发送，不卡界面" />
                    </Grid>
                    <TextBlock
                        x:Name="ResultText"
                        Margin="{StaticResource PluginFieldRowMargin}"
                        FontSize="12"
                        Text="{Binding LastResult}"
                        TextWrapping="Wrap" />

                    <!--  最近日志回看（后台线程持续产生；打开面板/有新结果时自动刷新，也可手动点）  -->
                    <Grid Margin="{StaticResource PluginFirstRowMargin}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PluginCardTitle}" Text="最近上报日志" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Style="{StaticResource PluginHintText}"
                                Text="最近 50 条（含断网续传动态；测试发送也留痕）" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            Click="RefreshLogs_Click"
                            Content="刷新"
                            Style="{StaticResource MiniButton}" />
                    </Grid>
                    <Border
                        Margin="0,4,0,0"
                        Padding="4"
                        Background="#FAFAFA"
                        BorderBrush="{StaticResource PluginCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <ListBox
                            x:Name="RecentLogsList"
                            Height="110"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Consolas, Microsoft YaHei"
                            FontSize="11"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="122" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="{StaticResource PluginHintTextBrush}" Text="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{Binding Level, Converter={StaticResource LevelColor}}"
                                            Text="{Binding Level}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding Message}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
