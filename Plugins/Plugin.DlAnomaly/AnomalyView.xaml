<UserControl
    x:Class="Plugin.DlAnomaly.AnomalyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.DlAnomaly"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:UI.CustomControl;assembly=UI"
    MinWidth="560"
    MinHeight="280"
    d:DesignHeight="680"
    d:DesignWidth="960"
    mc:Ignorable="d">

    <!--
        深度学习异常检测的配置视图（Web 化 V1）。
        与 Plugin.DlClassify 同一视觉语言：左配置轨 + 右预览工作区。

        功能契约（一个都不能动）：
          · DataContext = 插件实例（宿主靠它取 IPluginConfigView.OnConfirm）；
          · LinkableValueEditor：Port=Image / StepData=StepData；
          · ImageReadOnly：HImage = DisplayImage（ContentControl 有图才创建，避免折叠后不重绘）；
          · ModelPath / ResizeMode / InputSize / HeatmapMax / HeatmapInterpolation / DisplayViewIndex 六个 [StepConfig] 属性；
          · 「浏览」写 ModelPath 并 OnViewLoaded()；「试算一下」走 TryPreviewDetect()；
          · Hint / ResultSummary / ModelSummary 原绑定；插件没有 StatusLevel，本视图不伪造第四档状态。

        本节点整幅图判异常、不吃 ROI，所以右侧是只读 ImageReadOnly，不给框选能力。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:AnomalyResizeModeLabelConverter x:Key="ResizeModeLabelConverter" />
            <local:AnomalyInterpolationLabelConverter x:Key="InterpolationLabelConverter" />

            <!-- 区块标题：12px SemiBold，右侧可带一行弱提示 -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 36px 普通按钮：只在本视图派生，不改共享样式 -->
            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- 30×30 图标按钮：Padding=0（R68），否则 Fluent 隐式内边距会切掉字形 -->
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 模型信息卡：默认浅灰；模型态为 Failed 时整卡切红（状态契约，不看摘要文案） -->
            <Style x:Key="ModelInfoCardStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ModelState}" Value="{x:Static local:DlModelState.Failed}">
                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ModelSummaryStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ModelState}" Value="{x:Static local:DlModelState.Failed}">
                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 试算结果卡：等宽多行，最大高度内滚动 -->
            <Style x:Key="ResultPanelStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="ResultCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="ResultBodyStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="10,8,10,10" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HintBarStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateSubStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="MaxWidth" Value="340" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,0,13" />
                <Setter Property="Background" Value="{StaticResource PluginPreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PluginPreviewBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="PreviewChipStyle" TargetType="Border">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Background" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左配置轨（1*，300~356）+ 右预览工作区（1.6*，min 240）。
        960 宿主内容区约 920 → 左 354 / 右 550；640 宿主内容区约 600 → 左 300 / 右 284。
        所有颜色走 UI 公共令牌，视图内不写十六进制。
    -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="356" />
            <ColumnDefinition Width="1.6*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：配置轨 ================= -->
        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="14"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 图像输入：LinkableValueEditor 只包裹、不改内部 -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="图像输入" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SectionHintStyle}"
                                Text="上游端口 / 变量" />
                        </Grid>

                        <TextBlock
                            Margin="0,9,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="输入图像" />
                        <cv:LinkableValueEditor
                            Label=""
                            Port="{Binding Image}"
                            StepData="{Binding StepData}" />
                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="本节点检测整幅图，不吃 ROI；要只看某个区域，请上游先用「创建ROI」裁好。" />
                    </StackPanel>

                    <!-- 模型 -->
                    <StackPanel Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="异常检测模型（.onnx）" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SectionHintStyle}"
                                Text="客户资产" />
                        </Grid>

                        <TextBlock
                            Margin="0,9,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="模型路径" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Height="36"
                                Style="{StaticResource DialogInput}"
                                Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.ToolTip>
                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="ONNX 异常检测模型文件；支持相对路径（相对宿主程序目录）" />
                                </TextBox.ToolTip>
                            </TextBox>
                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource LocalButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="13"
                                        Text="&#xf07c;" />
                                    <TextBlock VerticalAlignment="Center" Text="浏览" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="支持相对路径（相对宿主程序目录），换机器部署时不用改配置。" />

                        <Border Style="{StaticResource ModelInfoCardStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="模型信息与输出契约" />
                                <TextBlock Style="{StaticResource ModelSummaryStyle}" Text="{Binding ModelSummary}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="异常检测的输出格式各家不同，本插件按「秩」识别：秩 2 的 [1,1] 当图像级分数，秩 4 的 [1,1,H,W] 或秩 3 的 [1,H,W] 当热力图。其余形状会被明确拒绝，并把读到的真实形状显示在上面那张卡里——不会猜。" />
                    </StackPanel>

                    <!-- 预处理参数 -->
                    <StackPanel Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="预处理参数" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SectionHintStyle}"
                                Text="须与训练一致" />
                        </Grid>

                        <TextBlock
                            Margin="0,9,0,6"
                            Style="{StaticResource FieldLabelStyle}"
                            Text="缩放模式" />
                        <ComboBox
                            Height="36"
                            Style="{StaticResource DialogCombo}"
                            ItemsSource="{Binding ResizeModeOptions}"
                            SelectedItem="{Binding ResizeMode}">
                            <ComboBox.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="Letterbox = 等比缩放 + 补边（默认，不改变长宽比，最稳）；Stretch = 直接拉成方形。按训练该模型时的预处理来选。" />
                            </ComboBox.ToolTip>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ResizeModeLabelConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource HelpTextStyle}" Text="Letterbox = 等比缩放 + 补边（默认）；Stretch = 直接拉成方形。选错会让分数静默偏移。" />

                        <Expander
                            Margin="0,12,0,0"
                            Header="高级参数（多数场景不用动）">
                            <Border
                                Margin="0,8,0,0"
                                Padding="10"
                                Background="{StaticResource DialogSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="输入尺寸（0 = 用模型自带的）" />
                                    <ui:NumericBox
                                        Height="36"
                                        Minimum="0"
                                        Maximum="4096"
                                        DecimalPlaces="0"
                                        Style="{StaticResource PluginNumericBox}"
                                        Value="{Binding InputSize, UpdateSourceTrigger=PropertyChanged}">
                                        <ui:NumericBox.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="模型输入边长。模型元数据里有静态尺寸时留 0 即可；动态形状才需要手填（异常检测模型常见 224 / 256）" />
                                        </ui:NumericBox.ToolTip>
                                    </ui:NumericBox>
                                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="模型元数据里有静态尺寸时留 0 即可；模型是动态形状才需要手填（异常检测模型常见 224 / 256）。" />

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="热力图归一化上限（0 = 用本轮最大值）" />
                                    <ui:NumericBox
                                        Height="36"
                                        Minimum="0"
                                        Maximum="1000000"
                                        DecimalPlaces="4"
                                        Style="{StaticResource PluginNumericBox}"
                                        Value="{Binding HeatmapMax, UpdateSourceTrigger=PropertyChanged}">
                                        <ui:NumericBox.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="0 = 用本轮热力图自身的最大值做上限（自适应，适合只看「异常在哪」）；&gt;0 = 固定上限（跨批次比较才有意义，适合看趋势）" />
                                        </ui:NumericBox.ToolTip>
                                    </ui:NumericBox>
                                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="0 = 用本轮自身最大值（自适应，只看「在哪」）；填固定值才适合跨批次比较趋势。只影响热力图渲染，不影响分数。" />

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="热力图插值" />
                                    <ComboBox
                                        Height="36"
                                        Style="{StaticResource DialogCombo}"
                                        ItemsSource="{Binding HeatmapInterpolationOptions}"
                                        SelectedItem="{Binding HeatmapInterpolation}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource InterpolationLabelConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="只影响上屏显示，不影响分数。" />

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="预览窗口号（0 = 不发布）" />
                                    <ui:NumericBox
                                        Height="36"
                                        Minimum="0"
                                        Maximum="9"
                                        DecimalPlaces="0"
                                        Style="{StaticResource PluginNumericBox}"
                                        Value="{Binding DisplayViewIndex, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource HelpTextStyle}" Text="热力图发到流程栏九宫格的哪一个预览窗；0 = 只算输出端口、不上屏。" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <!-- 试算 -->
                    <StackPanel Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="试算" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource SectionHintStyle}"
                                Text="不上流程" />
                        </Grid>

                        <TextBlock
                            Margin="0,9,0,0"
                            Style="{StaticResource HelpTextStyle}"
                            Text="图像来自上方「图像输入」：链接上游输出、或手动指定一张图；绑定后点宿主底部「执行」跑一遍，图会自动显示进来。" />

                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding TryPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource LocalPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="12"
                                    Text="&#xf04b;" />
                                <TextBlock VerticalAlignment="Center" Text="试算一下" />
                            </StackPanel>
                        </Button>

                        <Border Style="{StaticResource HintBarStyle}">
                            <TextBlock
                                FontSize="11.5"
                                LineHeight="18"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding Hint}"
                                TextWrapping="Wrap" />
                        </Border>

                        <Border Style="{StaticResource ResultPanelStyle}">
                            <StackPanel>
                                <Border
                                    Padding="10,7"
                                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ResultCaptionStyle}" Text="试算结果" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="10.5"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="分数 / 热力图" />
                                    </Grid>
                                </Border>
                                <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Style="{StaticResource ResultBodyStyle}" Text="{Binding ResultSummary}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= 右：预览工作区 ================= -->
        <Border
            Grid.Column="1"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!-- 预览头：标题 + 只读标签 + 工具条 -->
                <Grid Grid.Row="0" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="&#xf1c5;" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="图像预览" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="只读 · 整幅图" />
                    <StackPanel
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="FitWindow_Click"
                            Content="&#xf065;">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="适应窗口" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Margin="2,0,0,0"
                            Style="{StaticResource ToolbarTextButtonStyle}"
                            Click="FitImage_Click"
                            Content="1:1">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="实际像素 1:1" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 画布：ImageReadOnly 由 ContentTemplate 承载；有图才创建，避免折叠后不重绘 -->
                <Border Grid.Row="1" Background="{StaticResource PluginPreviewCanvasBrush}">
                    <Grid>
                        <ContentControl
                            x:Name="PreviewHost"
                            Focusable="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding DisplayImage}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <h:ImageReadOnly
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HImage="{Binding Mode=OneWay}" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- 左上角只读角标：有图才显示 -->
                        <StackPanel
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource PreviewChipStyle}">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogSurfaceBrush}"
                                    Text="只读预览" />
                            </Border>
                            <Border
                                Margin="6,0,0,0"
                                Padding="8,3"
                                Background="{StaticResource PluginPreviewSurfaceBrush}"
                                CornerRadius="6">
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{StaticResource PluginPreviewTextBrush}"
                                    Text="整幅图" />
                            </Border>
                        </StackPanel>

                        <!-- 空态：无图且模型态不是 Failed 时显示 -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ModelState}" Value="{x:Static local:DlModelState.Failed}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid
                                MaxWidth="420"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Rectangle
                                    Fill="{StaticResource PluginPreviewSurfaceBrush}"
                                    Opacity="0.55"
                                    RadiusX="14"
                                    RadiusY="14"
                                    Stroke="{StaticResource PluginPreviewBorderBrush}"
                                    StrokeDashArray="3,3" />
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource EmptyStateIconStyle}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="20"
                                            Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                            Text="&#xf03e;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="还没有图像" />
                                    <TextBlock Style="{StaticResource EmptyStateSubStyle}" Text="在「图像输入」里点 🔗 绑定上游端口或变量；也可以先点宿主底部「执行」把试运行图像带进来。" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 错误态：无图 + 模型加载失败 -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DisplayImage}" Value="{x:Null}" />
                                                <Condition Binding="{Binding ModelState}" Value="{x:Static local:DlModelState.Failed}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border
                                    Width="46"
                                    Height="46"
                                    Margin="0,0,0,13"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource DialogDangerSubtleBrush}"
                                    BorderBrush="{StaticResource DialogDangerBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="20"
                                        Foreground="{StaticResource DialogDangerBrush}"
                                        Text="&#xf071;" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogDangerBrush}"
                                    Text="模型加载失败" />
                                <TextBlock
                                    MaxWidth="360"
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    LineHeight="18"
                                    Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                    Text="请检查「模型路径」是否存在、是否是真 .onnx，以及输出形状是否被本插件的契约认可（真实形状见左侧「模型信息与输出契约」）。模型不可用时不会退回任何默认模型。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 状态栏：Hint 是插件既有文本；不伪造 StatusLevel 三档 -->
                <Border
                    Grid.Row="2"
                    Padding="12,0"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Width="7"
                            Height="7"
                            Margin="0,0,8,0"
                            Fill="{StaticResource DialogAccentBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="{Binding Hint}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            MaxWidth="180"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="整幅图 · 只读"
                            TextTrimming="CharacterEllipsis"
                            Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
