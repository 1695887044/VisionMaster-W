<UserControl
    x:Class="Plugin.CodeReader.CodeReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.CodeReader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="560"
    MinHeight="280"
    d:Background="Gray"
    mc:Ignorable="d">

    <!--
        码读取配置视图（Web 化 v1）。

        功能契约与改造前完全一致：
        · DataContext = CodeReaderPlugin（宿主靠它取 IPluginConfigView.OnConfirm）
        · Image 端口仍由 LinkableValueEditor 承载（Port / StepData）
        · DisplayImage 仍由 h:ImageReadOnly 显示（有图才创建，HImage 显式 OneWay）
        · Symbology / Polarity / TimeoutMs / Is2D / Hint / ResultSummary 的绑定不变
        · 试算仍调用 TryPreviewRecognize()

        本节点不做定位：右侧刻意只用 ImageReadOnly，不用 ImageEdit，也不提供任何框选入口。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:ResultSummaryBrushConverter x:Key="ResultSummaryBrush" />
            <local:CodeSymbologyDisplayConverter x:Key="CodeSymbologyDisplayConverter" />

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HelpGlyphStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,1,5,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
            </Style>

            <Style x:Key="LocalButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PluginCardCornerRadius}">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.90" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.80" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LocalPrimaryButtonStyle" BasedOn="{StaticResource LocalButtonStyle}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ToolbarTextButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0,7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ResultBoxStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="MinHeight" Value="86" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PluginCardCornerRadius}" />
            </Style>

            <Style x:Key="ResultTextStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="12,9,10,9" />
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="LineHeight" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="FamilyBadgeStyle" TargetType="Border">
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Is2D}" Value="False">
                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FamilyBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Text" Value="二维码" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Is2D}" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                        <Setter Property="Text" Value="一维码" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PortChipStyle" TargetType="Border">
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="PortNameStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PluginMonoFontFamily}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PortTypeStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="5,0,0,0" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateIconStyle" TargetType="Border">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Margin" Value="0,0,0,13" />
                <Setter Property="Background" Value="{StaticResource PluginPreviewSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PluginPreviewBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="EmptyStateSubStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="MaxWidth" Value="350" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource PluginPreviewMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        两栏：左配置轨（300~356）+ 右只读预览工作区（1.6*）。
        960 宿主内容区约 920 → 左 354 / 右 550；640 宿主内容区约 600 → 左 300 / 右 284。
        所有颜色走 UI 公共令牌，视图内不写十六进制。
    -->
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="300" MaxWidth="356" />
            <ColumnDefinition Width="1.6*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左：配置轨 ================= -->
        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="14"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <!--  图像输入：唯一入口是 Image 端口，不提供文件浏览  -->
                    <StackPanel>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SectionHintStyle}" Text="HImage · 只读" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="图像输入" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="待读码图像" />
                        <Border
                            Height="36"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PluginCardCornerRadius}"
                            ToolTip="点击右侧 🔗 绑定上游图像">
                            <cv:LinkableValueEditor
                                Height="36"
                                HorizontalAlignment="Stretch"
                                Label=""
                                Port="{Binding Image}"
                                StepData="{Binding StepData}" />
                        </Border>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource HelpGlyphStyle}" Text="&#xf05a;" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="本节点不做定位：请由上游把码裁好并完整包住、留点余量。贴边裁可能导致找不到码。" />
                        </DockPanel>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,14,0,0"
                        Background="{StaticResource DialogBorderBrush}" />

                    <!--  码制：存 HALCON 原始名，界面显示中文/通用名  -->
                    <StackPanel Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,9">
                            <Border DockPanel.Dock="Right" Style="{StaticResource FamilyBadgeStyle}">
                                <TextBlock Style="{StaticResource FamilyBadgeTextStyle}" />
                            </Border>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="码制" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="选择码制" />
                        <ComboBox
                            Height="36"
                            ItemsSource="{Binding SymbologyOptions}"
                            SelectedValue="{Binding Symbology}"
                            SelectedValuePath="HalconName"
                            Style="{StaticResource DialogCombo}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource HelpGlyphStyle}" Text="&#xf05a;" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="{Binding SymbologyHint}" />
                        </DockPanel>
                    </StackPanel>

                    <!--  二维码专属参数：仅 Is2D 时出现  -->
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding Is2D, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SectionHintStyle}" Text="仅二维码" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="二维码参数" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="极性" />
                        <ComboBox
                            Height="36"
                            ItemsSource="{Binding PolarityOptions}"
                            SelectedValue="{Binding Polarity}"
                            SelectedValuePath="Value"
                            Style="{StaticResource DialogCombo}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource HelpGlyphStyle}" Text="&#xf05a;" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="默认「自动」：激光打码在金属上常是亮码暗底或低对比，两种都试更稳。已知极性时明确指定可提速。" />
                        </DockPanel>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,14,0,0"
                        Background="{StaticResource DialogBorderBrush}" />

                    <!--  通用参数  -->
                    <StackPanel Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SectionHintStyle}" Text="仅本节点" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="通用参数" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Border DockPanel.Dock="Right" Height="20" Padding="8,0" Background="{StaticResource DialogRowHoverBrush}" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <TextBlock VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource DialogTextSecondaryBrush}" Text="0 = 不限" />
                            </Border>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="搜索超时 (ms)" />
                        </DockPanel>
                        <TextBox
                            Height="36"
                            Style="{StaticResource DialogInput}"
                            Text="{Binding TimeoutMs}" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource HelpGlyphStyle}" Text="&#xf05a;" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="图上没有码时 HALCON 会在候选区域反复尝试。没有超时保护会拖住整条流程。" />
                        </DockPanel>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="0,14,0,0"
                        Background="{StaticResource DialogBorderBrush}" />

                    <!--  输出端口：只读说明，不新增可编辑控件  -->
                    <StackPanel Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SectionHintStyle}" Text="运行期写入" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="输出端口" />
                        </DockPanel>
                        <WrapPanel>
                            <Border Margin="0,0,6,6" Style="{StaticResource PortChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PortNameStyle}" Text="Codes" />
                                    <TextBlock Style="{StaticResource PortTypeStyle}" Text="string[]" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,6,6" Style="{StaticResource PortChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PortNameStyle}" Text="Count" />
                                    <TextBlock Style="{StaticResource PortTypeStyle}" Text="int" />
                                </StackPanel>
                            </Border>
                            <Border Margin="0,0,6,6" Style="{StaticResource PortChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource PortNameStyle}" Text="Text" />
                                    <TextBlock Style="{StaticResource PortTypeStyle}" Text="string" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource HelpGlyphStyle}" Text="&#xf05a;" />
                            <TextBlock Style="{StaticResource HelpTextStyle}" Text="Count = 0 是正常工况（翻面 / 未打码 / 码被遮挡）；只有程序级异常才失败。" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <!--  试算固定底部：主操作常驻，不随配置区滚动  -->
                <Border
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="0,12,0,0"
                    BorderBrush="{StaticResource DialogBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SectionHintStyle}" Text="与运行同一条读码路径" />
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="试算" />
                        </DockPanel>
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{Binding TryRecognizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Content="试算一下"
                            Style="{StaticResource LocalPrimaryButtonStyle}" />
                        <Border
                            Background="{Binding ResultSummary, Converter={StaticResource ResultSummaryBrush}, ConverterParameter=Background}"
                            Style="{StaticResource ResultBoxStyle}">
                            <Grid>
                                <Border
                                    Width="3"
                                    HorizontalAlignment="Left"
                                    Background="{Binding ResultSummary, Converter={StaticResource ResultSummaryBrush}, ConverterParameter=Accent}"
                                    CornerRadius="8,0,0,8" />
                                <TextBlock
                                    Foreground="{Binding ResultSummary, Converter={StaticResource ResultSummaryBrush}, ConverterParameter=Foreground}"
                                    Style="{StaticResource ResultTextStyle}"
                                    Text="{Binding ResultSummary}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 右：只读预览工作区 ================= -->
        <Border
            Grid.Column="1"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="{StaticResource PluginCardCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!--  预览头：来源 + 只读说明 + 现有 Fit 入口  -->
                <Grid Grid.Row="0" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="26"
                        Height="26"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="7">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="&#xf1c5;" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        MaxWidth="230"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="上游图像"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="只读 · 不参与定位" />
                    <StackPanel
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="FitWindow_Click"
                            Content="&#xf065;">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="适应窗口" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            Margin="2,0,0,0"
                            Style="{StaticResource ToolbarTextButtonStyle}"
                            Click="FitImage_Click"
                            Content="1:1">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="实际像素 1:1" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--
                    画布：有图才创建 ImageReadOnly（ContentControl + DataTemplate），
                    避免“折叠状态下收到 HImage、恢复后不重绘”的时序问题。
                    HImage 依赖属性默认双向，模板里必须显式 Mode=OneWay。
                -->
                <Border Grid.Row="1" Background="{StaticResource PluginPreviewCanvasBrush}">
                    <Grid>
                        <ContentControl
                            x:Name="PreviewHost"
                            Focusable="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding DisplayImage}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <h:ImageReadOnly
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HImage="{Binding Mode=OneWay}" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!--  有图时才显示“只读预览”角标  -->
                        <Border
                            Margin="10"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{StaticResource DialogTextPrimaryBrush}"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogSurfaceBrush}"
                                Text="只读预览" />
                        </Border>

                        <!--  空态：纯 WPF 覆盖层，不创建 HALCON 控件  -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid
                                MaxWidth="420"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Rectangle
                                    Fill="{StaticResource PluginPreviewSurfaceBrush}"
                                    Opacity="0.55"
                                    RadiusX="14"
                                    RadiusY="14"
                                    Stroke="{StaticResource PluginPreviewBorderBrush}"
                                    StrokeDashArray="3,3" />
                                <StackPanel Margin="24" HorizontalAlignment="Center">
                                    <Border Style="{StaticResource EmptyStateIconStyle}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="20"
                                            Foreground="{StaticResource PluginPreviewMutedTextBrush}"
                                            Text="&#xf1c5;" />
                                    </Border>
                                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="等待上游图像" />
                                    <TextBlock Style="{StaticResource EmptyStateSubStyle}" Text="本节点不做定位，图像只有一个来源：在左侧「图像输入」点 🔗 绑定上游端口或变量；点「执行」试运行后也会自动显示进来。" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!--  状态栏：Hint + 当前码制；本插件没有 StatusLevel  -->
                <Border
                    Grid.Row="2"
                    Padding="12,0"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Width="7"
                            Height="7"
                            Margin="0,0,8,0"
                            Fill="{Binding ResultSummary, Converter={StaticResource ResultSummaryBrush}, ConverterParameter=Dot}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="{Binding Hint}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="SymbologyText"
                            Grid.Column="2"
                            MaxWidth="220"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource PluginMonoFontFamily}"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding Symbology, Converter={StaticResource CodeSymbologyDisplayConverter}}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
