<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Plugin.CodeReader</RootNamespace>
    <AssemblyName>Plugin.CodeReader</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core.Halcon 只用来复用既有的图像显示与参数控件风格；本插件不做框选，不需要 ImageEdit -->
    <ProjectReference Include="..\..\Services\Core.Halcon\Core.Halcon.csproj" />
    <ProjectReference Include="..\..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
    <ProjectReference Include="..\..\UI\Controls\UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>..\..\DLL\Halcon\halcondotnet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      插件自带帮助手册：Help\ 下的每个 .md 编进本程序集，主界面「帮助」窗口按一页一个文件读它。
      宿主 HelpCatalogService 按 "<程序集名>.Help." 前缀发现，文件名顺序即页序（01-、02- 前缀），
      目录树里该页的标题取正文第一个一级标题。本工程只有一个插件类，所以手册扁平放 Help\ 根下。
      为什么走内嵌资源而不是随目录投放：插件 DLL 由构建约定统一投递到 Modules\，
      手册跟着 DLL 走就不会出现"换了台机器手册没拷过去"。
      改手册 = 重建本插件工程（与改源码同一口径，见 AGENTS.md 红线③）。
    -->
    <EmbeddedResource Include="Help\**\*" />
  </ItemGroup>

  <!--
    本插件**没有需要投递的资源文件**，这是与 Plugin.Ocr 的一个重要差别：
    一维/二维码的模型是 HALCON 用 create_bar_code_model / create_data_code_2d_model
    在运行期按码制名现场构造出来的，不依赖任何外部模型文件（OCR 的 .omc 则是训练产物，必须随插件带）。
    所以既不需要 Assets 目录，也不需要 PostBuild 投递 —— 少一条会出错的链路。
    插件 DLL 自身的投递由 Plugins\Directory.Build.targets 统一处理。
  -->

</Project>
