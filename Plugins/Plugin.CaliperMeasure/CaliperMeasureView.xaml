<UserControl
    x:Class="Plugin.CaliperMeasure.CaliperMeasureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Core.Controls;assembly=Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:h="clr-namespace:Core.Halcon.Controls;assembly=Core.Halcon"
    xmlns:local="clr-namespace:Plugin.CaliperMeasure"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="{DynamicResource PluginViewMinWidth}"
    MinHeight="{DynamicResource PluginViewMinHeight}"
    d:DesignHeight="640"
    d:DesignWidth="940"
    mc:Ignorable="d">

    <!--
        布局：左「参数五区（可滚动）」+ 右「标注图预览（同时是搜索区拖拽画布）」。
        本视图不定义任何样式/颜色，卡片/标题/提示文字/字段名/数值框/列表行一律取自
        UI 库的 Plugin* 公共样式（与 ImageAcquisitionView、CreateRoiView、BlobDetectView 同一套）。
        右侧用 ImageEdit 而不是 ImageReadOnly：既要显示标注结果，又要能拖动搜索区（与 CreateRoi 同一范式）。
    -->
    <UserControl.InputBindings>
        <!--  Del 删除选中搜索区（CanExecute 守卫：焦点在文本框时不触发）  -->
        <KeyBinding Command="{Binding DeleteSelectedRegionCommand}" Key="Delete" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  枚举 → 中文名（读 [Display(Name)]，新增枚举成员界面自动生效）  -->
            <local:EnumDisplayNameConverter x:Key="EnumName" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!--
                本视图不再定义任何样式/颜色：卡片、标题、字段名、提示文字、数值框、搜索区列表行
                一律取自 UI 库的 Plugin* 公共样式（UI/Controls/Themes/PluginConfigStyles.xaml）。
                两个刻意的归一（原 #0A7 → PluginOkBrush #00AA77、根元素最小尺寸 640×380 → 620×360）
                见 docs/code-changes/2026-09-25-插件配置视图样式统一.md。
            -->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PluginViewMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="{StaticResource PluginParamsColumnMinWidth}" />
            <ColumnDefinition Width="*" MinWidth="{StaticResource PluginPreviewColumnMinWidth}" />
        </Grid.ColumnDefinitions>

        <!--  ================= 左：参数五区 =================  -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,8,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!--  图像输入  -->
                <Border Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="图像输入" />
                        <cv:LinkableValueEditor
                            Margin="{StaticResource PluginFirstRowMargin}"
                            HorizontalAlignment="Stretch"
                            Label="输入图像"
                            Port="{Binding SrcImage}"
                            StepData="{Binding StepData}" />
                        <Button
                            Margin="{StaticResource PluginFirstRowMargin}"
                            Padding="0,4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ResetRegionsCommand}"
                            Content="重置搜索区"
                            ToolTip="按当前测量类型重建默认搜索区（宽度/圆直径=1 个，其余=2 个；圆直径播种圆形）；会清掉现有区域，请谨慎使用" />
                        <TextBlock
                            Margin="{StaticResource PluginFieldRowMargin}"
                            Style="{StaticResource PluginHintText}"
                            Text="在右侧图像上可右键新建搜索区；拖动句柄粗调、下方参数微调精调。" />
                    </StackPanel>
                </Border>

                <!--  ① 测量类型  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="① 测量类型" />
                        <Grid Margin="{StaticResource PluginFirstRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="测量类型" ToolTip="宽度/间隙（1 个矩形区，成对找边）、两点距（2 个矩形区，各取一个边点）、点到线距（2 区：1 点 1 线）、圆直径（1 个圆形区 + 环宽）、角度（2 个矩形区各拟合一条线）" />
                            <ComboBox
                                Grid.Column="1"
                                Height="{StaticResource PluginControlHeight}"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding MeasureKinds}"
                                SelectedItem="{Binding MeasureKind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <TextBlock
                            Margin="{StaticResource PluginSectionMargin}"
                            Style="{StaticResource PluginHintText}"
                            Text="{Binding RegionCountHint}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource PluginHintText}"
                            Text="一个步骤只测一个尺寸；要测多个尺寸请添加多个卡尺测量步骤。" />
                    </StackPanel>
                </Border>

                <!--  ② 搜索区与卡尺  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="② 搜索区与卡尺" />

                        <Grid Margin="{StaticResource PluginFirstRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="卡尺数 N" ToolTip="每个搜索区内自动均布的卡尺条数。多点取平均可抗噪；越多越稳但越慢。工业常用起步值 5" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="CaliperCount" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule
                                                FieldName="卡尺数"
                                                IntegerOnly="True"
                                                Max="1000"
                                                Min="1" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <!--  搜索区列表  -->
                        <Grid Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource PluginCardTitle}" Text="搜索区列表" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource PluginHintText}"
                                Text="右键图像 → 区域 → 新建" />
                        </Grid>
                        <ListBox
                            MaxHeight="120"
                            Margin="{StaticResource PluginSectionMargin}"
                            Background="Transparent"
                            BorderThickness="0"
                            DisplayMemberPath="DisplayText"
                            ItemContainerStyle="{StaticResource PluginListBoxItem}"
                            ItemsSource="{Binding CaliperRegions}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedRegion}" />
                        <StackPanel Margin="{StaticResource PluginSectionMargin}" Orientation="Horizontal">
                            <Button
                                MinWidth="76"
                                Command="{Binding DeleteSelectedRegionCommand}"
                                Content="删除" />
                            <Button
                                MinWidth="76"
                                Margin="8,0,0,0"
                                Command="{Binding ResetRegionsCommand}"
                                Content="重置" />
                        </StackPanel>

                        <!--  参数微调（绑定 SelectedRegion.ParamEntries，纯绑定无 code-behind）  -->
                        <Grid Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource PluginCardTitle}" Text="参数微调" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource PluginHintText}"
                                Text="{Binding SelectedRegion.Name, TargetNullValue='选中搜索区后可编辑'}" />
                        </Grid>
                        <ItemsControl Margin="{StaticResource PluginFieldRowMargin}" ItemsSource="{Binding SelectedRegion.ParamEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource PluginHintTextBrush}"
                                            Text="{Binding Name}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Style="{StaticResource PluginNumericBox}"
                                            Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Margin="{StaticResource PluginFieldRowMargin}"
                            Style="{StaticResource PluginHintText}"
                            Text="矩形要「横跨」被测的边缝：半长 L1 方向=扫描方向（与边垂直），半宽 L2 方向=卡尺阵列排布方向。" />
                    </StackPanel>
                </Border>

                <!--  ③ 找边参数  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="③ 找边参数" />

                        <Grid Margin="{StaticResource PluginFirstRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="平滑 Sigma" ToolTip="测量前的高斯平滑系数；越大越抗噪、边缘定位越糊。常用 1.0，HALCON 要求 ≥ 0.4" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="Sigma" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule FieldName="平滑 Sigma" Min="0.4" Max="100" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="边缘阈值" ToolTip="相邻像素最小灰度差；低于它不算边。太大找不到边，太小噪声当边。常用 30" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="EdgeThreshold" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule FieldName="边缘阈值" Min="1" Max="255" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="极性" ToolTip="沿扫描方向允许哪种明暗跳变；不确定就选「全部」" />
                            <ComboBox
                                Grid.Column="1"
                                Height="{StaticResource PluginControlHeight}"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding Polarities}"
                                SelectedItem="{Binding Polarity, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="选择" ToolTip="一条卡尺上有多条边缘时取哪条；宽度/间隙取第一条配对，两点距取每个搜索区的第一条" />
                            <ComboBox
                                Grid.Column="1"
                                Height="{StaticResource PluginControlHeight}"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding EdgeSelects}"
                                SelectedItem="{Binding Select, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="插值方式" ToolTip="nearest 最快但只有整像素；bilinear 亚像素且较快（默认）；bicubic 最平滑但最慢" />
                            <ComboBox
                                Grid.Column="1"
                                Height="{StaticResource PluginControlHeight}"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding Interpolations}"
                                SelectedItem="{Binding Interpolation, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  ④ 拟合参数（仅拟合类测量显示：点到线距 / 圆直径 / 角度）  -->
                <Border
                    Margin="{StaticResource PluginSectionMargin}"
                    Style="{StaticResource PluginCard}"
                    Visibility="{Binding IsFitMeasure, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="④ 拟合参数" />

                        <Grid Margin="{StaticResource PluginFirstRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="拟合方式" ToolTip="fit_line/circle_contour_xld 的鲁棒算法：Tukey 对离群点（毛刺）降权、推荐；Huber 折中；最小二乘会被单个坏点拽歪整条线/圆" />
                            <ComboBox
                                Grid.Column="1"
                                Height="{StaticResource PluginControlHeight}"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding FitAlgorithms}"
                                SelectedItem="{Binding FitAlgorithm, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="最大残差(px)" ToolTip="边缘点到拟合几何距离的中位数上限，超限判拟合失败。用中位数口径容忍少量毛刺离群点（与 Tukey 配套）。默认 1.0" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="FitMaxError" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule FieldName="最大残差" Min="0.05" Max="1000000" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="最少点数" ToolTip="参与拟合的最少边缘点数，不足判拟合失败。直线 2 点定线、圆 3 点定圆；默认 3" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="FitMinPoints" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule
                                                FieldName="最少点数"
                                                IntegerOnly="True"
                                                Max="1000"
                                                Min="2" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <!--  环宽：仅圆直径测量显示  -->
                        <Grid Margin="{StaticResource PluginFieldRowMargin}" Visibility="{Binding IsCircleMeasure, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="环宽(px)" ToolTip="每把卡尺沿半径方向扫描的总宽度，覆盖圆心/半径的摆放误差（默认 30 = ±15px 容差）。真实圆边落在环内即可检出；过大易扫入相邻特征" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="AnnulusWidth" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule FieldName="环宽" Min="2" Max="100000" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <TextBlock
                            Margin="{StaticResource PluginFieldRowMargin}"
                            Style="{StaticResource PluginHintText}"
                            Text="角度结果单位是度（不受像素当量影响）；点到线距与圆直径输出物理值（像素值 × 当量）。" />
                    </StackPanel>
                </Border>

                <!--  ⑤ 判定与标定  -->
                <Border Margin="{StaticResource PluginSectionMargin}" Style="{StaticResource PluginCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="⑤ 判定与标定" />

                        <Grid Margin="{StaticResource PluginFirstRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="标准值" ToolTip="名义尺寸；默认 0 是「零容忍」起点，提示你去填实际规格" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="StandardValue" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule FieldName="标准值" Min="-1000000000" Max="1000000000" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="上公差" ToolTip="允许偏差的正向上限（偏差 ≤ 上公差 才 OK）；支持非对称公差，例如 +0.05" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="UpperTolerance" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule FieldName="上公差" Min="-1000000000" Max="1000000000" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="下公差" ToolTip="允许偏差的负向下限（偏差 ≥ 下公差 才 OK）；非对称公差请填负数，例如 -0.02" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="LowerTolerance" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule FieldName="下公差" Min="-1000000000" Max="1000000000" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <Grid Margin="{StaticResource PluginFieldRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PluginFieldLabel}" Text="像素当量(mm/px)" ToolTip="物理值 = 像素测量值 × 像素当量。默认 1.0 = 直接输出像素值（未标定）；将来有标定模块可改为连线取值" />
                            <TextBox Grid.Column="1" Style="{StaticResource PluginNumericBox}">
                                <TextBox.Text>
                                    <Binding Path="PixelSizeMm" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <local:NumberValidationRule FieldName="像素当量" Min="0.000001" Max="1000000" />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                        </Grid>

                        <TextBlock
                            Margin="{StaticResource PluginFieldRowMargin}"
                            Style="{StaticResource PluginHintText}"
                            Text="判定：下公差 ≤ 偏差 ≤ 上公差 为 OK。默认标准值/上下公差均为 0（零容忍），因此默认即为 NG。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  ================= 右：标注图预览 + 搜索区拖拽 =================  -->
        <Border Grid.Column="1" Style="{StaticResource PluginCard}">
            <DockPanel>
                <Border
                    DockPanel.Dock="Top"
                    Padding="0,0,0,8"
                    BorderBrush="{StaticResource PluginDividerBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Style="{StaticResource PluginCardTitle}" Text="标注图预览（可拖拽搜索区）" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Style="{StaticResource PluginHintText}"
                            Text="改参数后自动刷新" />
                    </Grid>
                </Border>

                <!--  信息栏：测量值 / 判定 / 失败原因，颜色由 StatusLevel 决定（三色一律走公共令牌）  -->
                <Border
                    DockPanel.Dock="Bottom"
                    Margin="{StaticResource PluginSectionMargin}"
                    Style="{StaticResource PluginStatusPanel}">
                    <TextBlock FontSize="{StaticResource PluginLabelFontSize}" Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!--  默认=正常（绿）；级别由视图的 DataTrigger 切换。
                                      原默认色 #0A7 与字典 PluginOkBrush(#00AA77) 语义相同值不同，
                                      收编时归一到字典值（刻意的归一，非视觉还原）。  -->
                                <Setter Property="Foreground" Value="{StaticResource PluginOkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Warning}">
                                        <Setter Property="Foreground" Value="{StaticResource PluginWarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusLevel}" Value="{x:Static local:StatusLevel.Error}">
                                        <Setter Property="Foreground" Value="{StaticResource PluginErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!--  图像编辑器：功能全部由控件 DP 提供，插件只做绑定与回传（与 CreateRoi 同一用法）  -->
                <h:ImageEdit
                    x:Name="ImageEditor"
                    ActiveRoi="{Binding CanvasActiveRegion, Mode=TwoWay}"
                    DrawObjectList="{Binding CanvasRegions}"
                    HImage="{Binding PreviewImage, Mode=OneWay}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
