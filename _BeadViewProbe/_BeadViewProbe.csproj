<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>_BeadViewProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plugins\Plugin.BeadInspect\Plugin.BeadInspect.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- halcondotnet 在插件工程里是 HintPath 直引，不随 ProjectReference 传递 -->
    <Reference Include="halcondotnet">
      <HintPath>..\DLL\Halcon\halcondotnet.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
