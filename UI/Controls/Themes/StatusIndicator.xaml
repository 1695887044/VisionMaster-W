<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UI.CustomControl">

    <!--
        状态灯（StatusIndicator）：一枚圆点 + 一行文字。

        颜色口径：文字色与通信设置原来那套状态胶囊**逐字对齐**（#15803D / #B45309 / #B91C1C / 次要灰），
        圆点取同色系的实色 —— 换到控件里实现，观感不变，但四套 DataTrigger 从宿主模板里搬进了控件。
        颜色写死不走令牌：与本层其它控件主题同一取舍（自包含、不依赖合并顺序）。

        Busy 脉动用 MultiTrigger（Level=Busy 且 IsPulsing=True）驱动、作用在整枚灯上；
        退出时 StopStoryboard 归位 —— 不做 ExitActions 的话动画会把 Opacity 钉在中间值上。
    -->
    <Style TargetType="{x:Type local:StatusIndicator}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusIndicator}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid x:Name="LampRoot" VerticalAlignment="Center">
                            <!--  柔和光晕：给圆点一圈同色虚光，观感上"亮着"而不是"贴了张纸"  -->
                            <Ellipse
                                x:Name="Glow"
                                Width="{TemplateBinding DotSize}"
                                Height="{TemplateBinding DotSize}"
                                Fill="#98A2B3"
                                Opacity="0.3">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="5" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse
                                x:Name="Dot"
                                Width="{TemplateBinding DotSize}"
                                Height="{TemplateBinding DotSize}"
                                Fill="#98A2B3" />
                        </Grid>

                        <TextBlock
                            x:Name="Label"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="#4A5568"
                            Text="{TemplateBinding StatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!--  没有文案时只留圆点（空 TextBlock 仍占 6px 左边距）  -->
                                        <DataTrigger Binding="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Level" Value="Ok">
                            <Setter TargetName="Dot" Property="Fill" Value="#16A34A" />
                            <Setter TargetName="Glow" Property="Fill" Value="#16A34A" />
                            <Setter TargetName="Label" Property="Foreground" Value="#15803D" />
                        </Trigger>
                        <Trigger Property="Level" Value="Busy">
                            <Setter TargetName="Dot" Property="Fill" Value="#D97706" />
                            <Setter TargetName="Glow" Property="Fill" Value="#D97706" />
                            <Setter TargetName="Label" Property="Foreground" Value="#B45309" />
                        </Trigger>
                        <Trigger Property="Level" Value="Error">
                            <Setter TargetName="Dot" Property="Fill" Value="#DC2626" />
                            <Setter TargetName="Glow" Property="Fill" Value="#DC2626" />
                            <Setter TargetName="Label" Property="Foreground" Value="#B91C1C" />
                        </Trigger>
                        <!--  Off 就是模板默认值（#98A2B3 + 中性字色），不必再写一条  -->

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Level" Value="Busy" />
                                <Condition Property="IsPulsing" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="BusyPulseStory">
                                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="LampRoot"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.35"
                                            Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BusyPulseStory" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
