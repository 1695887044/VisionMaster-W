<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UI.CustomControl">

    <!--
        数值输入框（NumericBox）。

        配色刻意与属性网格原来那套**逐字一致**（#DCDFE6 描边 / #606266 字 / 只读 #F5F7FA+#909399）：
        它替掉的是 StructValueGenerator 在数值属性上生成的裸 TextBox，
        换个皮肤会让"只有数值格变了样"，而这里要的是"数值格终于对了，但看不出换了控件"。
        颜色写死不走令牌：与 LogConsole/StatusIndicator 等本层主题同一取舍（自包含、不依赖合并顺序）。
    -->
    <Style TargetType="{x:Type local:NumericBox}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#DCDFE6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#606266" />
        <Setter Property="CaretBrush" Value="#606266" />
        <Setter Property="SelectionBrush" Value="#CCE8FF" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="SnapsToDevicePixels" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NumericBox}">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  TextBox 的模板契约：内容宿主必须叫 PART_ContentHost  -->
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />

                            <!--  单位后缀：空串时整块收起来（留着会白占 10px 右边距）  -->
                            <TextBlock
                                x:Name="SuffixText"
                                Grid.Column="1"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#909399"
                                Text="{TemplateBinding Suffix}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Suffix" Value="">
                            <Setter TargetName="SuffixText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#C0C4CC" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#409EFF" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F7FA" />
                            <Setter Property="Foreground" Value="#909399" />
                        </Trigger>
                        <!--  非法输入：红边 + 红字（值本身不动，文本已退回上一个有效值）  -->
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#E05B5B" />
                            <Setter Property="Foreground" Value="#E05B5B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
