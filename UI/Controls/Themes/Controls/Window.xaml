<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:att="clr-namespace:UI.AttachedProperties" xmlns:ui="clr-namespace:UI.CustomControl">
  <ResourceDictionary.MergedDictionaries>
    <!--  依赖就地合并：本文件的样式 Setter 内含跨字典 StaticResource 引用，
         若只依赖父级 Generic 的合并顺序，父级在加载完本字典后又被失效（如后合并
         Fluent 主题包、App 资源写入），跨兄弟字典的引用会重新解析失败并被烘焙成

         UnsetValue，模板应用时抛 "{DependencyProperty.UnsetValue} 不是 Foreground 的有效值"。
         自合并后引用只走自身链，与父级无关。同 FluentTokens/FluentAliases 的既有模式。  -->
    <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="Window">
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif" />
  </Style>
  <Style x:Key="WindowControlButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" SnapsToDevicePixels="True">
            <Border.Background>
              <SolidColorBrush x:Name="BgBrush" Color="Transparent" />
            </Border.Background>
            <Path x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" />
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="Tag" Value="{x:Null}" />
              </MultiTrigger.Conditions>
              <MultiTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#15000000" Duration="0:0:0.15">
                      <ColorAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </ColorAnimation.EasingFunction>
                    </ColorAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="Transparent" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.ExitActions>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="Tag" Value="Close" />
              </MultiTrigger.Conditions>
              <MultiTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#E81123" Duration="0:0:0.15">
                      <ColorAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </ColorAnimation.EasingFunction>
                    </ColorAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.EnterActions>
              <MultiTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="Transparent" Duration="0:0:0.2" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiTrigger.ExitActions>
              <Setter Property="Foreground" Value="#FFFFFF" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Win11WindowStyle" TargetType="Window">
    <Setter Property="Background" Value="#F3F3F3" />
    <Setter Property="att:WindowExtensions.IsAutoWireCommands" Value="True" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="WindowChrome.WindowChrome">
      <Setter.Value>
        <WindowChrome CaptionHeight="32" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <Border x:Name="WindowBorder" Background="{TemplateBinding Background}" BorderBrush="#808080" BorderThickness="1" ClipToBounds="True" CornerRadius="8">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#505050" Text="{TemplateBinding Title}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
                  <Button Command="{x:Static SystemCommands.MinimizeWindowCommand}" Content="M 0 5 L 10 5" Style="{StaticResource WindowControlButton}" />
                  <Button x:Name="BtnMaximize" Command="{x:Static SystemCommands.MaximizeWindowCommand}" Content="M 0 0 H 10 V 10 H 0 Z" Style="{StaticResource WindowControlButton}" />
                  <Button Command="{x:Static SystemCommands.CloseWindowCommand}" Content="M 0 0 L 10 10 M 0 10 L 10 0" Style="{StaticResource WindowControlButton}" Tag="Close" />
                </StackPanel>
              </Grid>
              <ContentPresenter Grid.Row="1" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter TargetName="WindowBorder" Property="Margin" Value="7" />
              <Setter TargetName="WindowBorder" Property="CornerRadius" Value="0" />
              <Setter TargetName="BtnMaximize" Property="Content" Value="M 2 2 H 10 V 10 H 2 Z M 2 2 V 0 H 12 V 8 H 10" />
              <Setter TargetName="BtnMaximize" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
            </Trigger>
            <Trigger Property="IsActive" Value="False">
              <Setter Property="Foreground" Value="#A0A0A0" />
              <Setter TargetName="WindowBorder" Property="BorderBrush" Value="#D0D0D0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>