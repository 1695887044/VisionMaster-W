<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:att="clr-namespace:UI.AttachedProperties" xmlns:ui="clr-namespace:UI.CustomControl">
  <ResourceDictionary.MergedDictionaries>
    <!--  依赖就地合并：本文件的样式 Setter 内含跨字典 StaticResource 引用，
         若只依赖父级 Generic 的合并顺序，父级在加载完本字典后又被失效（如后合并
         Fluent 主题包、App 资源写入），跨兄弟字典的引用会重新解析失败并被烘焙成

         UnsetValue，模板应用时抛 "{DependencyProperty.UnsetValue} 不是 Foreground 的有效值"。
         自合并后引用只走自身链，与父级无关。同 FluentTokens/FluentAliases 的既有模式。  -->
    <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!--  控件基础色令牌已迁往 Colors.xaml（第一层）：本文件在 Controls 域最后合并，
        先合并的模板解析期查不到这里的键，曾导致 OverlayHost 启动崩溃
        （"无法找到名为 AccentBrush 的资源"）。见 Colors.xaml 内注释。  -->
  <Style TargetType="{x:Type Thumb}">
    <Setter Property="OverridesDefaultStyle" Value="true" />
    <Setter Property="IsTabStop" Value="false" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="rectangle" Margin="4,0,4,0" Background="{StaticResource ScrollBarThumbBrush}" CornerRadius="4" SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
              <Setter TargetName="rectangle" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />
              <Setter TargetName="rectangle" Property="Margin" Value="2,0,2,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
    <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
              <Track.Thumb>
                <Thumb />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Win11Card" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.04" ShadowDepth="2" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextDecorations" Value="None" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="#A0A0A0" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>