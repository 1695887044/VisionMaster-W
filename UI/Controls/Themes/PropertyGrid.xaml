<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UI.CustomControl">

    <!--
        属性网格的画刷**不再自带色值**，全部指向 FluentTokens。
        改造前这里是全库第四份强调色（#409EFF），与 Colors.xaml 的 #3182CE、
        DefaultStyle 的 AccentBrush、PluginConfigColors 的 PluginAccentBrush 互不相干 ——
        改配色要改四处，漏一处就是"属性面板和其它地方不是一个蓝"。

        键名保留：LayoutProcessor / EasyDialog 是按名字取这些资源的（含 FindResource），
        改名会让取不到的一方直接抛异常。

        依赖就地合并（同 FluentControls 的理由）：本字典常被单独取用，
        不能指望外层 Generic 已经把 FluentTokens 合并好。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UI;component/Themes/Fluent/FluentTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="SidebarBg" Color="{Binding Color, Source={StaticResource FluentSurfaceSunkenBrush}}" />
    <SolidColorBrush x:Key="ContentBg" Color="{Binding Color, Source={StaticResource FluentSurfaceBrush}}" />
    <SolidColorBrush x:Key="TextMain" Color="{Binding Color, Source={StaticResource FluentTextPrimaryBrush}}" />
    <SolidColorBrush x:Key="TextRegular" Color="{Binding Color, Source={StaticResource FluentTextSecondaryBrush}}" />
    <SolidColorBrush x:Key="BorderLight" Color="{Binding Color, Source={StaticResource FluentBorderBrush}}" />

    <SolidColorBrush x:Key="AccentBlue" Color="{Binding Color, Source={StaticResource FluentAccentBrush}}" />
    <SolidColorBrush x:Key="AccentBlueHover" Color="{Binding Color, Source={StaticResource FluentAccentHoverBrush}}" />
    <SolidColorBrush x:Key="AccentBlueActive" Color="{Binding Color, Source={StaticResource FluentAccentPressedBrush}}" />

    <!--  以下两个键原来在库内从未定义（卡片式模板直接引用 AppBg/CardBg），
          导致要么靠宿主 App.xaml 偷偷供给、要么潜在 XamlParseException。
          这里补齐桥接，与上面 SidebarBg/ContentBg 等保持一致，统一指向 Fluent 令牌。  -->
    <SolidColorBrush x:Key="AppBg" Color="{Binding Color, Source={StaticResource FluentBackgroundBrush}}" />
    <SolidColorBrush x:Key="CardBg" Color="{Binding Color, Source={StaticResource FluentCardBackgroundBrush}}" />

    <!--
        PropertyLabelStyle / FlatButtonStyle / FlatButtonVariantStyle 已从本文件移除：
        它们在 FluentAliases.xaml 里被同名键重定向到 Fluent 样式，Generic 合并顺序
        决定 Aliases 最后生效，故这里的旧（硬编码色值）版本是死代码，留着只误导人。
        布局处理器按名取这些键时，解析到的是 FluentAliases 的版本。
    -->

    <Style x:Key="LightFlatTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextRegular}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="Border"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2">
                        <ContentPresenter
                            x:Name="ContentSite"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource FluentSurfaceSunkenBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBlue}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBlue}" />
                            <Setter TargetName="Border" Property="Background" Value="Transparent" />
                            <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:FlatPropertyGrid}">
        <Setter Property="Background" Value="{StaticResource ContentBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FlatPropertyGrid}">
                    <Border Background="{TemplateBinding Background}">
                        <TabControl
                            x:Name="PART_TabControl"
                            Background="Transparent"
                            BorderThickness="0">
                            <TabControl.ItemContainerStyle>
                                <Style BasedOn="{StaticResource LightFlatTabItemStyle}" TargetType="TabItem" />
                            </TabControl.ItemContainerStyle>
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            x:Name="HeaderPanel"
                                            Grid.Row="0"
                                            Margin="16,8,16,0"
                                            BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="0,0,0,1">
                                            <TabPanel
                                                Margin="0,0,0,-1"
                                                IsItemsHost="true"
                                                KeyboardNavigation.TabIndex="1" />
                                        </Border>
                                        <ContentPresenter
                                            x:Name="PART_SelectedContentHost"
                                            Grid.Row="1"
                                            ContentSource="SelectedContent" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="1">
                                            <Setter TargetName="HeaderPanel" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TabControl.Template>
                        </TabControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:CardPropertyGrid}">
        <Setter Property="Background" Value="{StaticResource AppBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CardPropertyGrid}">
                    <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                        <TabControl
                            x:Name="PART_TabControl"
                            Background="Transparent"
                            BorderThickness="0"
                            TabStripPlacement="Left">

                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid IsItemsHost="False">
                                        <Grid.ColumnDefinitions>
                                            <!--
                                                页签条宽度：原先写死 180，加上内容区 24×2 与卡片 32,24×2 的留白，
                                                卡片式的固定开销是 292px —— 放不宽的地方（如插件配置壳 540 的参数列）
                                                参数区只剩 248px，比表格式的 360 全宽还窄，切过去只会更难看。
                                                这里减重到 128 + 14×2 + 20,16×2 = 196px：
                                                同一处能剩 344px，与表格式基本等价（实测见 2026-10-09 记录）。
                                                128 对 2~4 字的组名（算子/编辑框/连接…）依然宽松。
                                            -->
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Background="{StaticResource SidebarBg}"
                                            BorderBrush="{StaticResource BorderLight}"
                                            BorderThickness="0,0,1,0">
                                            <ScrollViewer
                                                Padding="8,16"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>

                                        <Border Grid.Column="1" Background="Transparent">
                                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </TabControl.Template>

                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Margin" Value="0,2,0,2" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border
                                                    x:Name="BaseBorder"
                                                    Padding="0,4"
                                                    Background="Transparent"
                                                    CornerRadius="4">
                                                    <Grid Height="36">
                                                        <Border
                                                            x:Name="ActiveMark"
                                                            Width="3"
                                                            Height="16"
                                                            Margin="4,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            Background="Transparent"
                                                            CornerRadius="2" />

                                                        <ContentPresenter
                                                            x:Name="TextHost"
                                                            Margin="16,0,10,0"
                                                            VerticalAlignment="Center"
                                                            ContentSource="Header"
                                                            TextBlock.FontSize="13"
                                                            TextBlock.Foreground="{StaticResource TextRegular}" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BaseBorder" Property="Background" Value="{StaticResource BorderLight}" />
                                                        <Setter TargetName="TextHost" Property="TextBlock.Foreground" Value="{StaticResource TextMain}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="BaseBorder" Property="Background" Value="{StaticResource CardBg}" />
                                                        <Setter TargetName="ActiveMark" Property="Background" Value="{StaticResource AccentBlue}" />
                                                        <Setter TargetName="TextHost" Property="TextBlock.Foreground" Value="{StaticResource AccentBlue}" />
                                                        <Setter TargetName="TextHost" Property="TextBlock.FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="BaseBorder" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect
                                                                    BlurRadius="5"
                                                                    Direction="270"
                                                                    Opacity="0.05"
                                                                    ShadowDepth="1" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <ScrollViewer
                                        Padding="14"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <Border
                                            Padding="20,16"
                                            Background="{StaticResource CardBg}"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="8">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="25"
                                                    Direction="270"
                                                    Opacity="0.06"
                                                    ShadowDepth="6"
                                                    Color="#000000" />
                                            </Border.Effect>
                                            <ContentPresenter Content="{Binding}" />
                                        </Border>
                                    </ScrollViewer>
                                </DataTemplate>
                            </TabControl.ContentTemplate>

                        </TabControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>