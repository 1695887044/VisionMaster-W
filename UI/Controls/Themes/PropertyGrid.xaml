<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UI.CustomControl">

    <!--
        属性网格主题（v1 设计基线：docs\UI设计基线\property-grid\design.html）。

        改动要点（对应基线 README 的「v1 方向」）：
          · 行高统一 36px：输入框 / 数值框 / 下拉 / 开关四类控件同高、8px 圆角，单行 48px 节奏。
          · 颜色全令牌化：一律 Dialog*（Colors.xaml 第一层令牌），不再自带色值。
          · 扁平式页签 44px + 2px 主色下划线（原来是 20,12 内边距的 40px 灰底条）。
          · 卡片式左栏改 176px 浅底导航：组名 + 条目计数 + 选中项白底卡片与左侧强调条
            （原来是 128px 灰底 + 一条 3px 竖线）。
          · 行悬停整行浅底；错误行浅红底由 ValidationProcessor 在运行期挂。

        依赖就地合并（同 FluentControls 的理由）：本字典常被单独取用，
        不能指望外层 Generic 已经把 Colors.xaml 合并好；R30/R31 要求
        {StaticResource} 必须能在「本分册 + 本分册自己 merge 的子树」里解析。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
        <ResourceDictionary Source="/UI;component/Themes/Fluent/FluentTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        兼容桥接键：LayoutProcessor / 生成器 / EasyDialog 是按名字取这些资源的（含 FindResource），
        改名会让取不到的一方直接抛异常。值统一指向第一层令牌。
    -->
    <SolidColorBrush x:Key="SidebarBg" Color="{Binding Color, Source={StaticResource DialogRowAlternateBrush}}" />
    <SolidColorBrush x:Key="ContentBg" Color="{Binding Color, Source={StaticResource DialogSurfaceBrush}}" />
    <SolidColorBrush x:Key="TextMain" Color="{Binding Color, Source={StaticResource DialogTextPrimaryBrush}}" />
    <SolidColorBrush x:Key="TextRegular" Color="{Binding Color, Source={StaticResource DialogTextSecondaryBrush}}" />
    <SolidColorBrush x:Key="BorderLight" Color="{Binding Color, Source={StaticResource DialogBorderBrush}}" />

    <SolidColorBrush x:Key="AccentBlue" Color="{Binding Color, Source={StaticResource DialogAccentBrush}}" />
    <SolidColorBrush x:Key="AccentBlueHover" Color="{Binding Color, Source={StaticResource DialogAccentDarkBrush}}" />
    <SolidColorBrush x:Key="AccentBlueActive" Color="{Binding Color, Source={StaticResource DialogAccentDarkBrush}}" />

    <SolidColorBrush x:Key="AppBg" Color="{Binding Color, Source={StaticResource DialogBackgroundBrush}}" />
    <SolidColorBrush x:Key="CardBg" Color="{Binding Color, Source={StaticResource DialogSurfaceBrush}}" />

    <!--
        键盘焦点环：DialogFocusVisual 在 Dialog.Misc.xaml 里，而本分册在 Generic.xaml 中排在
        Dialog 分册**之前**，跨分册 StaticResource 会解析失败（R30/R31）。这里自带一份同形定义。
        加 PG 前缀是为了不与该键撞名（资源字典同名键后合并者覆盖，会静默换掉弹窗那支）。
    -->
    <Style x:Key="PropertyGridFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="2"
                        BorderBrush="{StaticResource DialogAccentBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        页签（扁平式）：44px 高、选中 2px 主色下划线。
        高度由样式显式给（MinHeight + Padding），不用「Grid Auto 行 + 子元素 Margin」表达留白 —— R133。
    -->
    <Style x:Key="LightFlatTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource PropertyGridFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2">
                        <ContentPresenter
                            x:Name="ContentSite"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                            <Setter TargetName="ContentSite" Property="TextElement.FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 扁平式 ==================== -->
    <Style TargetType="{x:Type local:FlatPropertyGrid}">
        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:FlatPropertyGrid}">
                    <Border Background="{TemplateBinding Background}">
                        <TabControl
                            x:Name="PART_TabControl"
                            Background="Transparent"
                            BorderThickness="0">
                            <TabControl.ItemContainerStyle>
                                <Style BasedOn="{StaticResource LightFlatTabItemStyle}" TargetType="TabItem" />
                            </TabControl.ItemContainerStyle>
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!--  页签条：44px，底部 1px 分隔线；选中项靠 TabItem 模板的 2px 下划线  -->
                                        <Border
                                            x:Name="HeaderPanel"
                                            Grid.Row="0"
                                            Height="44"
                                            Padding="18,0"
                                            Background="{StaticResource DialogSurfaceBrush}"
                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                            <TabPanel IsItemsHost="true" KeyboardNavigation.TabIndex="1" />
                                        </Border>
                                        <ContentPresenter
                                            x:Name="PART_SelectedContentHost"
                                            Grid.Row="1"
                                            ContentSource="SelectedContent" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="1">
                                            <Setter TargetName="HeaderPanel" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TabControl.Template>
                        </TabControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 卡片式 ==================== -->
    <Style TargetType="{x:Type local:CardPropertyGrid}">
        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CardPropertyGrid}">
                    <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                        <TabControl
                            x:Name="PART_TabControl"
                            Background="Transparent"
                            BorderThickness="0"
                            TabStripPlacement="Left">
                            <TabControl.Template>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!--
                                                左栏 176px（基线）。原 128px 是为「插件配置壳 540px 参数列」让宽，
                                                这里取 176 是因为导航项改成「图标 + 组名 + 计数」后 128 会挤；
                                                窄宿主下由 ControlTemplate 的 MinWidth 兜底，见 README 复刻约束 6。
                                            -->
                                            <ColumnDefinition x:Name="RailColumn" Width="176" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            x:Name="RailHost"
                                            Grid.Column="0"
                                            Background="{StaticResource DialogRowAlternateBrush}"
                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                            BorderThickness="0,0,1,0">
                                            <ScrollViewer
                                                Padding="10,12"
                                                HorizontalScrollBarVisibility="Disabled"
                                                VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>

                                        <Border Grid.Column="1" Background="Transparent">
                                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!--
                                            空态：收起左栏（176px 空导航条 + 一条空态说明并排很难看）。
                                            判据是控件自己的只读依赖属性，不是 Items.Count —— 空态会塞一个
                                            Header 为空的占位页签，Count 恒为 1，不能拿来判。
                                        -->
                                        <DataTrigger Binding="{Binding IsEmptyState, RelativeSource={RelativeSource AncestorType={x:Type local:CardPropertyGrid}}}" Value="True">
                                            <Setter TargetName="RailColumn" Property="Width" Value="0" />
                                            <Setter TargetName="RailHost" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TabControl.Template>

                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="MinHeight" Value="34" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource PropertyGridFocusVisual}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border
                                                    x:Name="Bd"
                                                    Padding="10,0"
                                                    Background="Transparent"
                                                    CornerRadius="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--  选中项左侧 3px 强调条（未选中时透明占位，避免文字左右跳动）  -->
                                                        <Border
                                                            x:Name="ActiveMark"
                                                            Grid.Column="0"
                                                            Width="3"
                                                            Height="16"
                                                            Margin="0,0,7,0"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            CornerRadius="2" />

                                                        <ContentPresenter
                                                            x:Name="TextHost"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            ContentSource="Header"
                                                            TextBlock.FontSize="12.5"
                                                            TextBlock.Foreground="{StaticResource DialogTextSecondaryBrush}" />

                                                        <!--  条目计数：由 PropertyGridAttach.GroupCount 提供  -->
                                                        <TextBlock
                                                            x:Name="CountHost"
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="10.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="{Binding Path=(local:PropertyGridAttach.GroupCount), RelativeSource={RelativeSource TemplatedParent}}" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Path=(local:PropertyGridAttach.GroupCount), RelativeSource={RelativeSource Self}}" Value="0">
                                                        <Setter TargetName="CountHost" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                        <Setter TargetName="TextHost" Property="TextBlock.Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                                        <Setter TargetName="ActiveMark" Property="Background" Value="{StaticResource DialogAccentBrush}" />
                                                        <Setter TargetName="TextHost" Property="TextBlock.Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                        <Setter TargetName="TextHost" Property="TextBlock.FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <ScrollViewer
                                        Padding="16"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ContentPresenter Content="{Binding}" />
                                    </ScrollViewer>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
