<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ==================== 插件配置界面令牌（Plugin*） ====================

        为什么单开一本、而不是直接改 Scada* 那本：
        插件配置界面（PluginConfigShell 里那 14 张卡）此前是"每个插件抄一份样式"：
        CardBorder 被抄了 15 份，CardTitle/HintText/FieldLabel/NumericBox 每家 2~4 份，
        颜色（#E5E5E5/#1F1F1F/#888888/#444444…）直接写死在各家 XAML 里。
        结果想统一调一次色，得先全仓搜一遍、再逐个判断哪些"看着像其实不是同一个"。

        这一本就是那 15 份重复定义的唯一真相。命名规则沿用 Colors.xaml 里 SCADA 那节的做法：

          1. 一律带 Plugin 前缀 —— 不带前缀会和宿主/组态那边的令牌撞名，
             撞名的后果是"改令牌改不动那一处"（局部覆盖优先于全局）。
          2. 按"用在哪"命名，不按"是什么颜色" —— HintTextBrush 是"提示文字"，
             不是"某个灰"。将来换肤（深色主题）改的是这里的值，
             而不是去每个插件里判断哪个 #FF888888 该跟着变。
          3. 值全部照抄改造前插件里的原值，不做"顺手美化" ——
             收编阶段的唯一目标是"行为不变、真相归一"。

        主题化怎么用：
        换主题只需要替换/覆盖这一本（颜色 + 尺寸都是可覆盖键），
        PluginConfigStyles.xaml 里只有结构与引用，不含任何具体数值。
    -->

    <!--  ==================== 容器 ====================  -->
    <SolidColorBrush x:Key="PluginSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PluginCardBorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="PluginSubtleBackgroundBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="PluginDividerBrush" Color="#EEEEEE" />

    <Color x:Key="PluginCardShadowColor">#FF000000</Color>

    <!--  ==================== 文字：标题 / 字段标签 / 提示说明 ====================  -->
    <SolidColorBrush x:Key="PluginTitleTextBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="PluginLabelTextBrush" Color="#444444" />
    <SolidColorBrush x:Key="PluginHintTextBrush" Color="#888888" />

    <!--  ==================== 输入控件（TextBox）====================  -->
    <SolidColorBrush x:Key="PluginInputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PluginInputBorderBrush" Color="#D8DCE0" />
    <SolidColorBrush x:Key="PluginInputHoverBorderBrush" Color="#A9B4C2" />
    <SolidColorBrush x:Key="PluginInputFocusBrush" Color="#2F6FBF" />
    <!--  聚焦外圈：半透明主色，只在键盘聚焦时淡入（Fluent 那一圈 focus ring）  -->
    <SolidColorBrush x:Key="PluginInputFocusRingBrush" Color="#332F6FBF" />
    <SolidColorBrush x:Key="PluginInputTextBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="PluginInputDisabledBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="PluginInputDisabledTextBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="PluginInputErrorBackgroundBrush" Color="#FDF6F6" />
    <SolidColorBrush x:Key="PluginCaretBrush" Color="#2F6FBF" />

    <CornerRadius x:Key="PluginInputCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PluginInputFocusRingRadius">6</CornerRadius>
    <Thickness x:Key="PluginInputPadding">6,0,6,0</Thickness>

    <!--  ==================== 语义色：正常 / 警示 / 错误 ====================  -->
    <SolidColorBrush x:Key="PluginOkBrush" Color="#00AA77" />
    <SolidColorBrush x:Key="PluginWarningBrush" Color="#E6A23C" />
    <SolidColorBrush x:Key="PluginErrorBrush" Color="#F56C6C" />

    <!--
        ==================== 图表（灰度直方图） ====================
        这五个原先硬编码在 Plugin.BlobDetect\HistogramPlot.cs 的静态画笔里。
        C# 侧改成"先查资源、查不到再退回内置值"（见该文件的注释），
        这样插件在没有 Application 的环境（冒烟/离线）里实例化视图也不会崩。
    -->
    <SolidColorBrush x:Key="PluginChartFillBrush" Color="#483A7BD5" />
    <SolidColorBrush x:Key="PluginChartStrokeBrush" Color="#FF2F6FBF" />
    <SolidColorBrush x:Key="PluginChartBandBrush" Color="#2EE6A23C" />
    <SolidColorBrush x:Key="PluginChartMarkerBrush" Color="#FFE6A23C" />
    <SolidColorBrush x:Key="PluginChartGridBrush" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="PluginChartPlaceholderBrush" Color="#FF999999" />
    <sys:Double x:Key="PluginChartStrokeThickness">1</sys:Double>
    <sys:Double x:Key="PluginChartMarkerThickness">1.2</sys:Double>

    <!--  字体：占位提示等自绘文字用（自绘不继承控件树，必须显式取）  -->
    <FontFamily x:Key="PluginFontFamily">Microsoft YaHei</FontFamily>

    <!--  ==================== 尺寸与间距 ====================  -->
    <CornerRadius x:Key="PluginCardCornerRadius">8</CornerRadius>
    <Thickness x:Key="PluginCardPadding">14</Thickness>
    <!--  小圆角：校验红框、信息栏内边距圆角等  -->
    <CornerRadius x:Key="PluginSmallCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="PluginStatusPanelCornerRadius">4</CornerRadius>
    <Thickness x:Key="PluginStatusPanelPadding">10,8</Thickness>

    <Thickness x:Key="PluginViewMargin">12</Thickness>
    <!--  块间距：卡片与卡片、卡片与信息栏之间（= 原 0,8,0,0）  -->
    <Thickness x:Key="PluginSectionMargin">0,8,0,0</Thickness>
    <!--  行间距：参数区首行 / 后续行  -->
    <Thickness x:Key="PluginFirstRowMargin">0,10,0,0</Thickness>
    <Thickness x:Key="PluginFieldRowMargin">0,6,0,0</Thickness>
    <Thickness x:Key="PluginErrorBorderThickness">1</Thickness>
    <Thickness x:Key="PluginNumericBoxPadding">4,0,0,0</Thickness>

    <sys:Double x:Key="PluginTitleFontSize">13</sys:Double>
    <sys:Double x:Key="PluginLabelFontSize">12</sys:Double>
    <sys:Double x:Key="PluginHintFontSize">11</sys:Double>
    <sys:Double x:Key="PluginControlHeight">24</sys:Double>
    <sys:Double x:Key="PluginCardShadowBlur">12</sys:Double>
    <sys:Double x:Key="PluginCardShadowOpacity">0.05</sys:Double>
    <sys:Double x:Key="PluginCardShadowDepth">2</sys:Double>

    <!--  ==================== 布局：两栏参数面板 ====================  -->
    <sys:Double x:Key="PluginViewMinWidth">620</sys:Double>
    <sys:Double x:Key="PluginViewMinHeight">360</sys:Double>

    <!--
        列宽必须是 GridLength、不是 double：ColumnDefinition.Width 的类型是 GridLength，
        给它塞 sys:Double 会在 XAML 解析时抛"设置属性 Width 时引发了异常"（冒烟断言抓到的就是这个）。
        MinWidth 仍是 double，两者别混。
    -->
    <GridLength x:Key="PluginParamsColumnWidth">330</GridLength>
    <GridLength x:Key="PluginEditorColumnWidth">150</GridLength>
    <sys:Double x:Key="PluginParamsColumnMinWidth">300</sys:Double>
    <sys:Double x:Key="PluginPreviewColumnMinWidth">240</sys:Double>
    <sys:Double x:Key="PluginHistogramHeight">104</sys:Double>

</ResourceDictionary>
