<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        依赖显式化：令牌必须在本文件内合并一次。
        不能指望"外层 Generic.xaml 里先合并了 Tokens"—— MergedDictionaries 是**延迟加载**的，
        本字典被单独取用（EasyDialog 的 TryFindResource 就是这种入口）时，
        外层那条链未必已物化，BasedOn / StaticResource 会当场报"找不到资源"。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UI;component/Themes/Fluent/FluentTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        ============================================================
        Fluent（Windows 11）控件库 —— 统一命名 + 完整变体
        ============================================================

        【命名规范】Fluent + 控件名 + 变体 + Style
          · FluentButtonStyle            —— 默认（次级/Subtle）
          · FluentButtonAccentStyle      —— 主操作（Accent）
          · FluentButtonSmallStyle       —— 尺寸变体
        一律带 Style 后缀（旧库里 Win11Card / PluginCard 不带，DialogPrimaryButton 又带，两套并存）。

        【变体体系】每个控件按"语义 × 尺寸"两维给全，避免调用方为了一个红按钮
        去自己抄一份模板（旧库正是这么散的：Dialog 一套按钮、Plugin 一套、PropertyGrid 又一套）。

        【状态叠加层】按钮的悬停/按下用**半透明叠加层**而不是换背景色，
        所以变体只改一组颜色即可拥有完整状态表现 —— Win11 本身就是这个做法。
    -->

    <!--  ==================== Button ====================  -->
    <Style x:Key="FluentButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="{StaticResource FluentPaddingControl}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FluentBorderThickness}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource FluentRadiusMedium}">
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <!--  状态叠加层：与变体颜色无关，所有变体共用同一套状态表现  -->
                            <Border
                                x:Name="HoverOverlay"
                                Background="#0D000000"
                                CornerRadius="{StaticResource FluentRadiusMedium}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="PressedOverlay"
                                Background="#1A000000"
                                CornerRadius="{StaticResource FluentRadiusMedium}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource FluentEaseOut}"
                                            Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource FluentDurationFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource FluentEaseOut}"
                                            Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource FluentDurationFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressedOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource FluentDurationFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressedOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource FluentDurationFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  主操作：Accent 底 + 白字（一个界面只该有一个，用来指路）  -->
    <Style
        x:Key="FluentButtonAccentStyle"
        BasedOn="{StaticResource FluentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource FluentAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource FluentOnAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Subtle：透明底，靠叠加层出 hover —— Win11 里最常见的"次级按钮"  -->
    <Style
        x:Key="FluentButtonSubtleStyle"
        BasedOn="{StaticResource FluentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--  Outline：保留描边，用于"有形状但不抢焦点"  -->
    <Style
        x:Key="FluentButtonOutlineStyle"
        BasedOn="{StaticResource FluentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorderStrongBrush}" />
    </Style>

    <!--  Transparent：工具栏 / 图标按钮，没有容器感  -->
    <Style
        x:Key="FluentButtonTransparentStyle"
        BasedOn="{StaticResource FluentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource FluentPaddingCompact}" />
    </Style>

    <!--  危险 / 成功： destructive 操作与"确认成功"要一眼分得开  -->
    <Style
        x:Key="FluentButtonDangerStyle"
        BasedOn="{StaticResource FluentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource FluentDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentDangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource FluentOnAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style
        x:Key="FluentButtonSuccessStyle"
        BasedOn="{StaticResource FluentButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource FluentSuccessBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentSuccessBrush}" />
        <Setter Property="Foreground" Value="{StaticResource FluentOnAccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  尺寸变体  -->
    <Style
        x:Key="FluentButtonSmallStyle"
        BasedOn="{StaticResource FluentButtonStyle}"
        TargetType="Button">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="{StaticResource FluentPaddingCompact}" />
    </Style>
    <Style
        x:Key="FluentButtonLargeStyle"
        BasedOn="{StaticResource FluentButtonStyle}"
        TargetType="Button">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8,16,8" />
    </Style>

    <!--  ==================== Card（容器）====================  -->
    <Style x:Key="FluentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FluentBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource FluentRadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource FluentPaddingCard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{StaticResource FluentShadowCard}" />
    </Style>
    <Style
        x:Key="FluentCardElevatedStyle"
        BasedOn="{StaticResource FluentCardStyle}"
        TargetType="Border">
        <Setter Property="Effect" Value="{StaticResource FluentShadowRaised}" />
    </Style>
    <!--  亚克力卡片：浮层/侧边面板用，与主内容区拉开层次  -->
    <Style
        x:Key="FluentCardAcrylicStyle"
        BasedOn="{StaticResource FluentCardStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentAcrylicBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentAcrylicBorderBrush}" />
    </Style>
    <Style
        x:Key="FluentCardOutlineStyle"
        BasedOn="{StaticResource FluentCardStyle}"
        TargetType="Border">
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}" />
    </Style>

    <!--  ==================== 输入控件 ====================  -->
    <Style x:Key="FluentTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,6,8,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FluentBorderThickness}" />
        <Setter Property="CaretBrush" Value="{StaticResource FluentTextPrimaryBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!--
                        Win11 文本框的识别点：圆角 + 底部 2px 强调线（聚焦时）。
                        用一个底层 Border（底边）叠一个内容 Border 实现，避免改 BorderThickness 抖版面。
                    -->
                    <Grid>
                        <Border
                            x:Name="Underline"
                            Background="{StaticResource FluentAccentBrush}"
                            CornerRadius="0,0,4,4"
                            Opacity="0"
                            VerticalAlignment="Bottom"
                            Height="2" />
                        <Border
                            x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource FluentRadiusSmall}">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Padding="{TemplateBinding Padding}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Underline"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource FluentDurationFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Underline"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource FluentDurationFast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="{StaticResource FluentPaddingRow}" />
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="Root"
                        Margin="2,1,2,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource FluentRadiusSmall}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FluentSurfaceSunkenBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FluentAccentSubtleBrush}" />
                            <!--
                                Foreground 是 Brush 类型，这里必须给 **Brush 令牌**。
                                写成 FluentAccentPressedColor（Color 令牌）时，TextBlock 在测量期会抛
                                "「#FF0067BE」不是属性「Foreground」的有效值"；而这个异常被 AppLifetimeService
                                降级成 WARN 吞掉 → 布局反复失效、反复重试 → 界面永久无响应（实测 ~50 条 WARN/秒，
                                一次会话能刷两万多条）。凡是"选中某一行就卡死"的场景，先回来查这一行。
                            -->
                            <Setter Property="Foreground" Value="{StaticResource FluentAccentPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ToggleSwitch：iOS 规格开关（本库第一个把"四态 + 减动效"做全的控件）
        · 形态：轨道 54×24 圆角胶囊；滑块 Ø20，四周内缩 2px（不鼓出轨道）
        · 位移：30 = 54 − 2×2 − 20，只动 Transform，绝不动画 Width/Height（避免布局抖动）。
          改 Width 必须同步改 IsChecked 动画的 To 值，否则滑块停在半路。
        · 颜色全走令牌：开=FluentAccentColor、关=FluentToggleTrackOff*；滑块恒白 + 极轻投影
        · 四态：悬停（叠加层加深一档 + 滑块放大 1.06）、按下（滑块横向拉伸 ≈24，松开弹回）、
                键盘焦点（外圈 2px 半透明主色环，向外偏 2px）、禁用（整颗 0.45 + 禁用光标 + 不可聚焦）
        · 动效：200ms FluentEaseInOut；位移动画时长绑 SystemParameters.ClientAreaAnimation，
                系统「显示动画」关闭时降级为 0 时长 —— 颜色仍切换，只是没有过程（减动效该有的行为）
        · 画刷是**实例专属**（内联画刷 + 初值绑令牌）：动画若写进共享令牌，会把全应用引用
          该令牌的画刷一起改色 —— 现场事故：新建一颗开关，整窗连锁重绘。
        · 已知取舍：WPF 没有 CSS 的 :focus-visible，鼠标点击也会落键盘焦点，焦点环会跟着亮；
          要严格区分输入来源得加行为类，等真有需求再做。
    -->
    <!-- ==================== 样式主体 ==================== -->
    <Style x:Key="FluentToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">

                        <!-- 键盘焦点环。圆角必须写 12（= 高度 24 的一半）：
                             WPF Border 对超大圆角（如 FluentRadiusFull=999）是按轴钳制
                             （横钳到宽/2、纵钳到高/2），四个角变成椭圆弧 → 整颗画成蛋形；
                             CSS 式"999=胶囊"在 WPF 不成立。改 Width/Height 时同步改这里。 -->
                        <Border x:Name="FocusRing"
                                Margin="-4"
                                Opacity="0"
                                BorderBrush="{StaticResource FluentAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="12" />

                        <!-- 轨道 -->
                        <Border x:Name="Track"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Border.Background>
                                <SolidColorBrush x:Name="TrackBrush" Color="{StaticResource FluentToggleTrackOffColor}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="TrackBorderBrush" Color="{StaticResource FluentToggleTrackOffBorderColor}" />
                            </Border.BorderBrush>
                        </Border>

                        <!-- 悬停叠加层 -->
                        <Border x:Name="HoverOverlay"
                                Opacity="0"
                                Background="{StaticResource FluentTextPrimaryBrush}"
                                CornerRadius="12" />

                        <!--
                            ThumbHost：
                            修复1：去掉 RenderTransformOrigin="0.5,0.5"。
                            因为内部 Ellipse 有 TranslateTransform 做位移，如果 Host 以中心为原点缩放，
                            位移后的滑块会被拉回中间。改为默认 (0,0) 让缩放跟随布局对齐。
                        -->
                        <Grid x:Name="ThumbHost"
                              Width="20"
                              Height="20"
                              Margin="2"
                              HorizontalAlignment="Left">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ThumbHoverScale" />
                            </Grid.RenderTransform>

                            <!--
                                修复2：Ellipse 去掉 RenderTransformOrigin="0.5,0.5"。
                                Fluent 设计按下拉伸时，滑块应沿滑动方向延伸（向右开时向右长，向左关时向左长），
                                而不是从圆心向两侧对称膨胀。使用默认 (0,0) 配合 Left 对齐即可实现。
                                
                                修复3：删除了 Trigger 中对 RenderTransformOrigin 的 Setter。
                                WPF 的 Trigger.Setter 无法在动画时间线中安全地切换 TransformOrigin，
                                会导致渲染撕裂或位置跳变。
                            -->
                            <Ellipse x:Name="Thumb"
                                     Effect="{StaticResource FluentShadowKnob}">
                                <Ellipse.Fill>
                                    <SolidColorBrush x:Name="ThumbBrush" Color="{Binding Color, Source={StaticResource FluentSurfaceBrush}}" />
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="ThumbStretch" />
                                        <TranslateTransform x:Name="ThumbTransform" X="0" />
                                    </TransformGroup>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- ====== IsChecked：开关颜色 + 滑块位移 ====== -->
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 修复4：删除了 <Setter TargetName="Thumb" Property="RenderTransformOrigin" Value="1,0.5" /> -->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource FluentToggleTrackOnColor}"
                                                        Duration="{StaticResource FluentDurationMedium}" />
                                        <ColorAnimation Storyboard.TargetName="TrackBorderBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource FluentToggleTrackOnColor}"
                                                        Duration="{StaticResource FluentDurationMedium}" />
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseInOut}"
                                                         Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="30"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="TrackBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource FluentToggleTrackOffColor}"
                                                        Duration="{StaticResource FluentDurationMedium}" />
                                        <ColorAnimation Storyboard.TargetName="TrackBorderBrush"
                                                        Storyboard.TargetProperty="Color"
                                                        To="{StaticResource FluentToggleTrackOffBorderColor}"
                                                        Duration="{StaticResource FluentDurationMedium}" />
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseInOut}"
                                                         Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- ====== 悬停：叠加层 + 整体放大 1.06 ====== -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseOut}"
                                                         Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseOut}"
                                                         Storyboard.TargetName="ThumbHoverScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.06"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseOut}"
                                                         Storyboard.TargetName="ThumbHoverScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.06"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseOut}"
                                                         Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseOut}"
                                                         Storyboard.TargetName="ThumbHoverScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseOut}"
                                                         Storyboard.TargetName="ThumbHoverScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- ====== 按下：横向拉伸 1.2 ====== -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseInOut}"
                                                         Storyboard.TargetName="ThumbStretch"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.2"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation EasingFunction="{StaticResource FluentEaseInOut}"
                                                         Storyboard.TargetName="ThumbStretch"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="{StaticResource FluentDurationMedium}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- ====== 禁用态 ====== -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="No" />
                            <Setter Property="Focusable" Value="False" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        ToggleSwitch（减动效变体）：系统「显示动画」关闭时由 BoolStateGenerator 选用。
        与常规版唯一的区别是**没有任何 Storyboard**：颜色用双轨道 Opacity 交换、
        位置用对齐交换，全部是 Setter 直切 —— 零位移零过渡，这正是减动效该有的样子。
        视觉规格与常规版一致：轨道 54×24、滑块 Ø20 内缩 2px、颜色同一组令牌。
        （为什么不在常规版里用绑定 Duration 实现：模板触发器里的 Storyboard 必须可冻结，
        里面放 Binding 会让整个样式解析失败 —— 实测 XamlParseException，别再走那条路。）
    -->
    <Style x:Key="FluentToggleSwitchStyleStatic" TargetType="ToggleButton">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="FocusRing"
                            Margin="-4"
                            Opacity="0"
                            BorderBrush="{StaticResource FluentAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="12" />
                        <Border
                            x:Name="TrackOff"
                            Background="{StaticResource FluentBorderBrush}"
                            BorderBrush="{StaticResource FluentBorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="12" />
                        <Border
                            x:Name="TrackOn"
                            Opacity="0"
                            Background="{StaticResource FluentTextPrimaryBrush}"
                            CornerRadius="12" />
                        <Border
                            x:Name="HoverOverlay"
                            Opacity="0"
                            Background="{StaticResource FluentTextPrimaryBrush}"
                            CornerRadius="12" />
                        <Ellipse
                            x:Name="Thumb"
                            Width="20"
                            Height="20"
                            Margin="2"
                            HorizontalAlignment="Left"
                            Fill="{StaticResource FluentSurfaceBrush}"
                            Effect="{StaticResource FluentShadowKnob}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.08" />
                        </MultiTrigger>
                        <!--  焦点环同常规版：由 FocusVisibleBehavior 驱动（只认键盘焦点）  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="No" />
                            <Setter Property="Focusable" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ==================== Chip / Badge（状态标签）====================  -->
    <Style x:Key="FluentChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentSurfaceSunkenBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource FluentRadiusFull}" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style
        x:Key="FluentChipAccentStyle"
        BasedOn="{StaticResource FluentChipStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentAccentSubtleBrush}" />
    </Style>
    <Style
        x:Key="FluentChipSuccessStyle"
        BasedOn="{StaticResource FluentChipStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentSuccessSubtleBrush}" />
    </Style>
    <Style
        x:Key="FluentChipWarningStyle"
        BasedOn="{StaticResource FluentChipStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentWarningSubtleBrush}" />
    </Style>
    <Style
        x:Key="FluentChipDangerStyle"
        BasedOn="{StaticResource FluentChipStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentDangerSubtleBrush}" />
    </Style>

    <!--  ==================== InfoBar（Win11 的条状提示）====================  -->
    <Style x:Key="FluentInfoBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentInfoSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource FluentRadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource FluentPaddingRow}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentInfoBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style
        x:Key="FluentInfoBarSuccessStyle"
        BasedOn="{StaticResource FluentInfoBarStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentSuccessSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentSuccessBrush}" />
    </Style>
    <Style
        x:Key="FluentInfoBarWarningStyle"
        BasedOn="{StaticResource FluentInfoBarStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentWarningSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentWarningBrush}" />
    </Style>
    <Style
        x:Key="FluentInfoBarDangerStyle"
        BasedOn="{StaticResource FluentInfoBarStyle}"
        TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentDangerSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentDangerBrush}" />
    </Style>

    <!--  ==================== 进度 / 分隔 / 导航 / 提示 ====================  -->
    <Style x:Key="FluentProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource FluentAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource FluentSurfaceSunkenBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource FluentRadiusFull}">
                        <Border
                            x:Name="PART_Track"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="{StaticResource FluentRadiusFull}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentDividerStyle" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource FluentDividerBrush}" />
        <Setter Property="Margin" Value="0,8,0,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FluentNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="{StaticResource FluentPaddingRow}" />
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Root"
                        Margin="2,1,2,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource FluentRadiusMedium}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FluentSurfaceSunkenBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FluentAccentSubtleBrush}" />
                            <!--
                                Foreground 是 Brush 类型，这里必须给 **Brush 令牌**。
                                写成 FluentAccentPressedColor（Color 令牌）时，TextBlock 在测量期会抛
                                "「#FF0067BE」不是属性「Foreground」的有效值"；而这个异常被 AppLifetimeService
                                降级成 WARN 吞掉 → 布局反复失效、反复重试 → 界面永久无响应（实测 ~50 条 WARN/秒，
                                一次会话能刷两万多条）。凡是"选中某一行就卡死"的场景，先回来查这一行。
                            -->
                            <Setter Property="Foreground" Value="{StaticResource FluentAccentPressedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FluentToolTipStyle" TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FluentBorderThickness}" />
        <Setter Property="Padding" Value="8,5,8,5" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Margin="6"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource FluentRadiusMedium}"
                        Effect="{StaticResource FluentShadowCard}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Segmented（Win11 分段控件）：选中项"浮起"成白底，而不是描边变色  -->
    <Style x:Key="FluentSegmentedRadioStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="{StaticResource FluentPaddingCompact}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource FluentTextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="{StaticResource FluentRadiusSmall}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FluentSurfaceSunkenBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource FluentSurfaceBrush}" />
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource FluentShadowCard}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  状态圆点（在线/离线/报警）  -->
    <Style x:Key="FluentStatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{StaticResource FluentTextTertiaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
