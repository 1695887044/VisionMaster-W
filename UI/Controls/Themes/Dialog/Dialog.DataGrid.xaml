<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:att="clr-namespace:UI.AttachedProperties" xmlns:ui="clr-namespace:UI.CustomControl">
  <ResourceDictionary.MergedDictionaries>
    <!--  依赖就地合并：本文件的样式 Setter 内含跨字典 StaticResource 引用，
         若只依赖父级 Generic 的合并顺序，父级在加载完本字典后又被失效（如后合并
         Fluent 主题包、App 资源写入），跨兄弟字典的引用会重新解析失败并被烘焙成

         UnsetValue，模板应用时抛 "{DependencyProperty.UnsetValue} 不是 Foreground 的有效值"。
         自合并后引用只走自身链，与父级无关。同 FluentTokens/FluentAliases 的既有模式。  -->
    <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="DialogDataGridCell" TargetType="DataGridCell">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <!--
            左边距统一交给单元格（而不是让每个 CellTemplate 自己写 Margin）：
            表头 Padding 是 12，单元格 Padding 也是 12，两行的文字基线才落在同一竖线上。
            老写法只有"设备名称"那列写了 Margin=14，其余列贴左 0 ⇒ 表头与内容错开一格。
        -->
    <Setter Property="Padding" Value="12,0,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DialogDataGridCellFlush" BasedOn="{StaticResource DialogDataGridCell}" TargetType="DataGridCell">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="DialogDataGridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Style.Triggers>
      <Trigger Property="ItemsControl.AlternationIndex" Value="1">
        <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DialogDataGridColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="42" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
  </Style>
  <Style x:Key="DialogDataGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeight" Value="46" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DialogBorderLightBrush}" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="CanUserAddRows" Value="False" />
    <!--
            CanUserDeleteRows 默认是 true：选中一行按 Delete 会直接从数据源里删掉那一行，
            而且不弹确认框。连接管理 / 变量管理 / 扫描组三张表都不该有这种"误按即丢配置"的入口，
            所以统一在皮肤层关掉，删除一律走各表自己的「删除」按钮（那里有确认框）。
        -->
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />
    <Setter Property="AlternationCount" Value="2" />
    <Setter Property="CellStyle" Value="{StaticResource DialogDataGridCell}" />
    <Setter Property="RowStyle" Value="{StaticResource DialogDataGridRow}" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource DialogDataGridColumnHeader}" />
  </Style>

  <!--
      ============================================================
      v2.1「报警配置」基线（docs/UI设计基线/scada-alarm-config）
      ============================================================
      与上面那套的差别只有"密度"：表头 34（原 42）、行内边距 8（原 12）、
      行不交替、无列排序/拖动/改宽（列宽是设计基线钉死的）。
  -->
  <Style x:Key="DialogAlarmGridColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <!--  数值列表头：右对齐，右侧预留 20（与阈值单元格的"数字右边缘同一条线"）  -->
  <Style
      x:Key="DialogAlarmGridColumnHeaderNumeric"
      BasedOn="{StaticResource DialogAlarmGridColumnHeader}"
      TargetType="DataGridColumnHeader">
    <Setter Property="Padding" Value="12,0,20,0" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>
  <Style x:Key="DialogAlarmGridCell" TargetType="DataGridCell" BasedOn="{StaticResource DialogDataGridCell}">
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!--
      首列专用：选中时左侧 2px 主色竖条，行内校验失败时转危险红（错误优先于选中）。
      竖条画在单元格模板里而不是行上 —— 行的左侧竖条要 Retemplate DataGridRow，
      会连带接管展开行（RowDetails）的呈现，风险远大于收益。
  -->
  <Style x:Key="DialogAlarmGridCellMarker" TargetType="DataGridCell" BasedOn="{StaticResource DialogDataGridCell}">
    <Setter Property="Padding" Value="0,8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid>
              <Border
                  x:Name="Marker"
                  Width="2"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  SnapsToDevicePixels="True" />
              <ContentPresenter
                  Margin="{TemplateBinding Padding}"
                  VerticalAlignment="Center"
                  SnapsToDevicePixels="True" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
              <Setter TargetName="Marker" Property="Background" Value="{StaticResource DialogAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasInlineError}" Value="True">
              <Setter TargetName="Marker" Property="Background" Value="{StaticResource DialogDangerBrush}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--  行：不加行间距（行间分隔交给 1px 横向网格线）；停用行走第三级灰，不降透明度  -->
  <Style x:Key="DialogAlarmGridRow" TargetType="DataGridRow" BasedOn="{StaticResource DialogDataGridRow}">
    <Setter Property="Margin" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsEnabled}" Value="False">
        <Setter Property="Foreground" Value="{StaticResource DialogTextTertiaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DialogAlarmGrid" TargetType="DataGrid" BasedOn="{StaticResource DialogDataGrid}">
    <Setter Property="AlternationCount" Value="1" />
    <Setter Property="RowDetailsVisibilityMode" Value="VisibleWhenSelected" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="CanUserSortColumns" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="CanUserResizeColumns" Value="False" />
    <Setter Property="CellStyle" Value="{StaticResource DialogAlarmGridCell}" />
    <Setter Property="RowStyle" Value="{StaticResource DialogAlarmGridRow}" />
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource DialogAlarmGridColumnHeader}" />
  </Style>
</ResourceDictionary>