<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:att="clr-namespace:UI.AttachedProperties" xmlns:ui="clr-namespace:UI.CustomControl">
  <ResourceDictionary.MergedDictionaries>
    <!--  依赖就地合并：本文件的样式 Setter 内含跨字典 StaticResource 引用，
         若只依赖父级 Generic 的合并顺序，父级在加载完本字典后又被失效（如后合并
         Fluent 主题包、App 资源写入），跨兄弟字典的引用会重新解析失败并被烘焙成

         UnsetValue，模板应用时抛 "{DependencyProperty.UnsetValue} 不是 Foreground 的有效值"。
         自合并后引用只走自身链，与父级无关。同 FluentTokens/FluentAliases 的既有模式。  -->
    <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="DialogStatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
  </Style>
  <DataTemplate x:Key="DialogStatusPillTemplate">
    <Border x:Name="Pill" Padding="9,3" HorizontalAlignment="Left" Background="{StaticResource DialogRowHoverBrush}" CornerRadius="11" ToolTipService.ShowDuration="30000">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="ToolTip" Value="{x:Null}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connected">
              <Setter Property="Background" Value="#E8F5E9" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
              <Setter Property="Background" Value="#FDECEC" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
              <Setter Property="Background" Value="#FFF4E5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Reconnecting">
              <Setter Property="Background" Value="#FFF4E5" />
            </DataTrigger>
            <!--  只有真的有错误文案才挂 ToolTip，否则空字符串会弹出一个空框  -->
            <DataTrigger Binding="{Binding HasError}" Value="True">
              <Setter Property="ToolTip" Value="{Binding LastError}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="#98A2B3" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected">
                  <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                  <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Connecting">
                  <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                  <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Text" Value="离线" />
              <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected">
                  <Setter Property="Text" Value="在线" />
                  <Setter Property="Foreground" Value="#15803D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                  <Setter Property="Text" Value="错误" />
                  <Setter Property="Foreground" Value="#B91C1C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Connecting">
                  <Setter Property="Text" Value="连接中" />
                  <Setter Property="Foreground" Value="#B45309" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Reconnecting">
                  <Setter Property="Text" Value="重连中" />
                  <Setter Property="Foreground" Value="#B45309" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <!--  有错误时追加 ⚠：一眼能看出"这条不只是离线，是出过错"  -->
        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DialogIconFont}" FontSize="11" Foreground="{StaticResource DialogDangerBrush}" Text="">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>
  </DataTemplate>
  <Style x:Key="DialogChip" TargetType="Border">
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="DialogChipText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="DialogChipNeutral" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
  </Style>
  <Style x:Key="DialogChipAccent" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
  </Style>
  <Style x:Key="DialogChipSuccess" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
  </Style>
  <Style x:Key="DialogChipWarning" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
  </Style>
  <Style x:Key="DialogChipDanger" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
  </Style>
  <Style x:Key="DialogChipTextNeutral" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
  </Style>
  <Style x:Key="DialogChipTextAccent" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
  </Style>
  <Style x:Key="DialogChipTextSuccess" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
  </Style>
  <Style x:Key="DialogChipTextWarning" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
  </Style>
  <Style x:Key="DialogChipTextDanger" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
  </Style>

  <!--
      DialogTag / DialogTagText：**带底色的小方圆角标签**（如端口数据类型「图像 (HImage)」）。
      与 Chip 的分工（踩过坑才分出来的）：
        Chip = 胶囊：短角标专用（"枚举" / "变量"），1~2 个字时两端是半圆，正好是胶囊的观感；
        但**长文本套胶囊会把两端各撑成一个半圆，整块变成一颗横椭圆**（Fluent 层 CornerRadius 是
        FluentRadiusFull=999，一定变成全圆角）——类型名恰恰是长文本，所以它要的是 Tag 不是 Chip。
        Tag  = 小方圆角（4）+ 1px 描边 + 浅底：文本再长也还是"标签"；
               底色与行悬停色（DialogRowAlternateBrush）不同、且带描边，悬停/选中时都不会隐身。
  -->
  <Style x:Key="DialogTag" TargetType="Border">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="DialogTagText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
  </Style>
</ResourceDictionary>