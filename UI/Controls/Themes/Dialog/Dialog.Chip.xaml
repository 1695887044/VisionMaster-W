<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:att="clr-namespace:UI.AttachedProperties" xmlns:ui="clr-namespace:UI.CustomControl">
  <ResourceDictionary.MergedDictionaries>
    <!--  依赖就地合并：本文件的样式 Setter 内含跨字典 StaticResource 引用，
         若只依赖父级 Generic 的合并顺序，父级在加载完本字典后又被失效（如后合并
         Fluent 主题包、App 资源写入），跨兄弟字典的引用会重新解析失败并被烘焙成

         UnsetValue，模板应用时抛 "{DependencyProperty.UnsetValue} 不是 Foreground 的有效值"。
         自合并后引用只走自身链，与父级无关。同 FluentTokens/FluentAliases 的既有模式。  -->
    <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
    <!--
        2026-10-09 补：本字典的状态胶囊模板里用了 DialogIconFont（"出过错"那个 ⚠ 字形），
        而该键定义在兄弟字典 Themes/Dialog/Dialog.Text.xaml —— 与上面 Colors.xaml 同一个问题：
        跨兄弟字典的引用在宿主合并链与 App 不一致时会解析失败，且失败点在**模板实例化**时
        （离屏渲染探针里实测抛"无法找到名为 DialogIconFont 的资源"，整条模板一起打不开）。
        按本文件既有的做法自合并，引用只走自身链。
    -->
    <ResourceDictionary Source="/UI;component/Themes/Dialog/Dialog.Text.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="DialogStatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
  </Style>
  <!--
      通讯连接状态胶囊。
      2026-10-09 改造：圆点 / 文案 / 悬停详情这三件事原先在**本模板里手搓**
      （四套 DataTrigger × 圆点填充 / 文字颜色 / 文案，再加 HasError 角标与 ToolTip，100 多行），
      现在收进控件 ui:StatusIndicator（那枚控件此前"保留但零消费"，这里就是它的归宿）。
      本模板只剩两件事：
        · 状态 → 档位/文案 的映射（通信域枚举 ConnectionState 不进 UI 库，映射留在宿主侧）；
        · 胶囊底色与"出过错"角标（这两件是"行"的外观，不属于灯本身）。
  -->
  <DataTemplate x:Key="DialogStatusPillTemplate">
    <Border
      x:Name="Pill"
      Padding="9,3"
      HorizontalAlignment="Left"
      Background="{StaticResource DialogRowHoverBrush}"
      CornerRadius="11"
      ToolTipService.ShowDuration="30000">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Connected">
              <Setter Property="Background" Value="#E8F5E9" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
              <Setter Property="Background" Value="#FDECEC" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Connecting">
              <Setter Property="Background" Value="#FFF4E5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Reconnecting">
              <Setter Property="Background" Value="#FFF4E5" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <!--  默认（Disconnected）= Off / 离线，不必写触发器  -->
        <ui:StatusIndicator x:Name="Lamp" />
        <!--  有错误时追加 ⚠：一眼能看出"这条不只是离线，是出过错"  -->
        <TextBlock
          Margin="5,0,0,0"
          VerticalAlignment="Center"
          FontFamily="{StaticResource DialogIconFont}"
          FontSize="11"
          Foreground="{StaticResource DialogDangerBrush}"
          Text="">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding State}" Value="Connected">
        <Setter TargetName="Lamp" Property="Level" Value="Ok" />
        <Setter TargetName="Lamp" Property="StatusText" Value="在线" />
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Connecting">
        <Setter TargetName="Lamp" Property="Level" Value="Busy" />
        <Setter TargetName="Lamp" Property="StatusText" Value="连接中" />
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Reconnecting">
        <Setter TargetName="Lamp" Property="Level" Value="Busy" />
        <Setter TargetName="Lamp" Property="StatusText" Value="重连中" />
      </DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Error">
        <Setter TargetName="Lamp" Property="Level" Value="Error" />
        <Setter TargetName="Lamp" Property="StatusText" Value="错误" />
      </DataTrigger>
      <!--  Disconnected → Off / 离线  -->
      <DataTrigger Binding="{Binding State}" Value="Disconnected">
        <Setter TargetName="Lamp" Property="Level" Value="Off" />
        <Setter TargetName="Lamp" Property="StatusText" Value="离线" />
      </DataTrigger>
      <!--  悬停详情只在真有错误文案时才挂（控件侧对空串不挂 ToolTip，空框问题在控件里解决了）  -->
      <DataTrigger Binding="{Binding HasError}" Value="True">
        <Setter TargetName="Lamp" Property="Detail" Value="{Binding LastError}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="DialogChip" TargetType="Border">
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="DialogChipText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="DialogChipNeutral" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
  </Style>
  <Style x:Key="DialogChipAccent" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
  </Style>
  <Style x:Key="DialogChipSuccess" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
  </Style>
  <Style x:Key="DialogChipWarning" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
  </Style>
  <Style x:Key="DialogChipDanger" TargetType="Border" BasedOn="{StaticResource DialogChip}">
    <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
  </Style>
  <Style x:Key="DialogChipTextNeutral" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
  </Style>
  <Style x:Key="DialogChipTextAccent" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
  </Style>
  <Style x:Key="DialogChipTextSuccess" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
  </Style>
  <Style x:Key="DialogChipTextWarning" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
  </Style>
  <Style x:Key="DialogChipTextDanger" TargetType="TextBlock" BasedOn="{StaticResource DialogChipText}">
    <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
  </Style>
  <!--
      DialogTag / DialogTagText：**带底色的小方圆角标签**（如端口数据类型「图像 (HImage)」）。
      与 Chip 的分工（踩过坑才分出来的）：
        Chip = 胶囊：短角标专用（"枚举" / "变量"），1~2 个字时两端是半圆，正好是胶囊的观感；
        但**长文本套胶囊会把两端各撑成一个半圆，整块变成一颗横椭圆**（Fluent 层 CornerRadius 是
        FluentRadiusFull=999，一定变成全圆角）——类型名恰恰是长文本，所以它要的是 Tag 不是 Chip。
        Tag  = 小方圆角（4）+ 1px 描边 + 浅底：文本再长也还是"标签"；
               底色与行悬停色（DialogRowAlternateBrush）不同、且带描边，悬停/选中时都不会隐身。
  -->
  <Style x:Key="DialogTag" TargetType="Border">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="DialogTagText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
  </Style>

  <!--
      文字按钮：变量绑定右栏的「清除绑定」与候选提示条上的「显示全部」。
      为什么不用 BasedOn FluentButtonSubtleStyle：本分册只就地 merge Colors.xaml 与
      Dialog.Text.xaml，BasedOn 兄弟分册的键会在模板实例化时断链（R30/R31）。
      所以这里自带最小模板：透明底、悬停 RowHover 底、禁用 40% 透明。
      焦点环由使用方显式挂 DialogFocusVisual（与全仓可聚焦控件同一口径）。
  -->
  <Style x:Key="DialogTextButton" TargetType="Button">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle">
      <Setter.Value>
        <!--  与 DialogFocusVisual 同形；本分册不能跨册 StaticResource（R30），故就地内联。  -->
        <Style TargetType="Control">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Border
                    Margin="2"
                    BorderBrush="{StaticResource DialogAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    SnapsToDevicePixels="True" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
              x:Name="Bg"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              CornerRadius="6"
              SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
      ============================================================
      v2.1「报警配置」基线新增（docs/UI设计基线/scada-alarm-config）
      ============================================================
      说明：DialogChip* / DialogTag* 会被应用级 FluentAliases.xaml 同名覆盖，
      所以运行中 chip、规则标签这些"尺寸写死"的元素另起新键，不与覆盖层抢同一个名字。
  -->
  <!--  详情块句首的「规则」小标签：10.5 / accent-text / accent-light 底 / r3  -->
  <Style x:Key="DialogRuleTag" TargetType="Border">
    <Setter Property="Margin" Value="0,1,0,0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="DialogRuleTagText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
  </Style>
  <!--  运行中：绿色胶囊 + 6px 圆点（22 高；与标题栏计数同一行，不能把行撑高）  -->
  <Style x:Key="DialogRunChip" TargetType="Border">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="DialogRunChipText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
  </Style>
  <Style x:Key="DialogChipDotSuccess" TargetType="Ellipse">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
  </Style>
  <!--  计数之间的 3px 分隔点  -->
  <Style x:Key="DialogCountSeparator" TargetType="Ellipse">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
  </Style>
  <!--  缺变量：不是胶囊，是"5px 琥珀点 + 琥珀文字"，跟在计数后面  -->
  <Style x:Key="DialogIncompleteDot" TargetType="Ellipse">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
  </Style>
  <Style x:Key="DialogIncompleteText" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
  </Style>
  <!--
      文字链接（工具栏「清除」、删除回执「撤销」）：下划线由使用方的 TextBlock 加，
      本样式只管字号/颜色/命中区/焦点环；不设悬停变色，链接的 affordance 靠下划线。
  -->
  <Style x:Key="DialogLinkButton" TargetType="Button">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle">
      <Setter.Value>
        <!--  同 DialogFocusVisual 形制；本分册不能跨册 StaticResource（R30），就地内联  -->
        <Style TargetType="Control">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Border
                    Margin="2"
                    BorderBrush="{StaticResource DialogAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    SnapsToDevicePixels="True" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DialogLinkButtonSuccess" BasedOn="{StaticResource DialogLinkButton}" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
  </Style>
  <!--
      幽灵按钮（删除 / 底栏撤销）：透明底无框，悬停出浅底与描边。
      为什么不用 DialogGhostButton：那一支在应用级被 FluentAliases 覆盖，圆角/内距对不上基线。
      颜色一律走模板触发器写自身属性（不写子元素 Background），基于本样式的派生样式才改得动前景色。
  -->
  <Style x:Key="DialogQuietButton" TargetType="Button">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="FocusVisualStyle">
      <Setter.Value>
        <Style TargetType="Control">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate>
                <Border
                    Margin="2"
                    BorderBrush="{StaticResource DialogAccentBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    SnapsToDevicePixels="True" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
              x:Name="Bd"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="6"
              SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>