<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UI.CustomControl"
    xmlns:models="clr-namespace:UI.Models;assembly=VM.Core">

    <ResourceDictionary.MergedDictionaries>
        <!--
            依赖就地合并（同其它皮肤分册的既有范式）：本文件全部颜色都引用
            {StaticResource Dialog*Brush}，它们定义在第一层令牌字典 Colors.xaml。
            不合并的话，这些引用在「声明它的分册」作用域里查不到（R30：兄弟分册互相看不见）。
        -->
        <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        日志控制台皮肤（设计基线 docs/UI设计基线/log-console/ v1，2026-10-22 复刻）。

        行结构：3px 等级状态条 | 84px 时间 | 78px 来源徽标 | 正文
        颜色全部走 Dialog* 令牌，本文件零硬编码色值（R140）。

        三条保留的行为约束（勿改）：
          ① 模板里必须有 x:Name="PART_ScrollViewer"（LogConsole.cs 的粘底滚动靠它）；
          ② 分组表头不得回退成深色底（亮色列表上的黑条）；
          ③ 来源徽标带 Tag="SourceChip"，供断言按"可见性"计数而不是按颜色计数。
    -->
    <Style TargetType="{x:Type local:LogConsole}">
        <Style.Resources>
            <Style TargetType="{x:Type GroupItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                            <StackPanel>
                                <Border
                                    Margin="0,4"
                                    Padding="12,6"
                                    Background="{StaticResource DialogRowAlternateBrush}"
                                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                                    BorderThickness="0,1">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                                            Text="▤" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="12"
                                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                                            Text="{Binding ItemCount, StringFormat=' ({0} 条记录)'}" />
                                    </StackPanel>
                                </Border>
                                <ItemsPresenter />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>

        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />

        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />

        <Setter Property="AlternationCount" Value="2" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:LogConsole}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False">
                            <ItemsPresenter Margin="{TemplateBinding Padding}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- 交替行：用最浅的一档，保证与错误行的常驻红底可区分 -->
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    </Trigger>
                                    <!-- 行选中：设计稿定义了这一态（现状是硬编码浅蓝，现改令牌） -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type models:LogItem}">
                    <Grid x:Name="RowRoot" Background="Transparent">
                        <!--  悬停叠层：错误行底色是常驻的，靠它表达"悬停仍在响应"（不引入第二个红）  -->
                        <Border
                            x:Name="HoverLayer"
                            Background="{StaticResource DialogDangerBrush}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                        <Grid
                            x:Name="RowContent"
                            Margin="0"
                            Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  等级状态条：颜色只表达等级  -->
                            <Border
                                x:Name="LevelBar"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource DialogTextMutedBrush}" />

                            <TextBlock
                                Grid.Column="1"
                                Margin="10,7,12,7"
                                VerticalAlignment="Top"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{StaticResource DialogTextTertiaryBrush}"
                                Text="{Binding Time, StringFormat={}{0:HH:mm:ss.fff}}" />

                            <!--
                                来源徽标：来源为空时整块 Collapsed（否则每行时间右边一个灰块），
                                列宽固定 78 所以有无来源的行正文起点保持一致。
                                Tag="SourceChip" 供断言按可见性计数（不绑死颜色）。
                            -->
                            <Border
                                x:Name="SourceChip"
                                Grid.Column="2"
                                Width="78"
                                Margin="0,6,12,0"
                                Padding="6,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{StaticResource DialogBorderLightBrush}"
                                CornerRadius="4"
                                Tag="SourceChip">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding Source}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>

                            <TextBlock
                                x:Name="TxtMessage"
                                Grid.Column="3"
                                Margin="0,7,12,7"
                                VerticalAlignment="Top"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="{Binding Message}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Grid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Info}">
                            <Setter TargetName="LevelBar" Property="Background" Value="{StaticResource DialogAccentBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Success}">
                            <Setter TargetName="LevelBar" Property="Background" Value="{StaticResource DialogSuccessBrush}" />
                            <Setter TargetName="TxtMessage" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}">
                            <Setter TargetName="LevelBar" Property="Background" Value="{StaticResource DialogWarningBrush}" />
                            <Setter TargetName="TxtMessage" Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                            <Setter TargetName="LevelBar" Property="Background" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="TxtMessage" Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                            <Setter TargetName="TxtMessage" Property="FontWeight" Value="SemiBold" />
                            <!-- 错误行整行红底：一屏几十行时靠文字变色扫不出来 -->
                            <Setter TargetName="RowContent" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.05" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
