<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  ====================  通用令牌  ====================  -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ExpanderHeaderBrush" Color="#F7FAFC" />
    <SolidColorBrush x:Key="ToolBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#2D3748" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3182CE" />

    <!--
        控件基础色令牌（原在 Controls/Misc.xaml —— 已迁移）。
        为什么必须放在"第一层"：Controls/Window|Button|Input|Selection|List|DataGrid|Navigation|Layout
        的模板内容大量引用这组键，而 Misc.xaml 在 Controls 域里**最后**合并；
        先合并的字典在解析期查不到后合并的键，轻则模板实例化时抛
        "{DependencyProperty.UnsetValue} 不是 Foreground 的有效值"，
        重则视图解析期直接抛"无法找到名为 AccentBrush 的资源"（OverlayHost 启动崩溃实例）。
        键名保留原样（引用方按名查找），只挪位置不改值。
    -->
    <Color x:Key="AccentColor">#005FB8</Color>
    <Color x:Key="AccentHoverColor">#0053A0</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202020" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Opacity="0.5" Color="#8D8D8D" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Opacity="0.8" Color="#7A7A7A" />

    <!--  ====================  SCADA 组态视图令牌  ====================  -->

    <!--
        为什么要有这一节：SCADA 那几个面板（工具箱 / 属性面板 / 图层 / 报警历史…）
        原先各自把十六进制写死在 XAML 里，同一个灰在三个文件里抄了三遍，
        想统一调一次色得先把全仓搜一遍、还得自己判断哪些"看着像其实不是同一个"。

        这里的键一律带 Scada 前缀，不是画蛇添足：上面那支 PrimaryTextBrush
        已经被 ToolView.xaml 与 GlobalVariableView.xaml 各自重定义成本地色（#0369A1）
        作局部覆盖，撞名的后果是"改令牌改不动那一处"。带前缀就不必再逐个核对谁覆盖了谁。

        命名按"用在哪"而不是"是什么颜色"：LabelTextBrush 是"标签文字"，
        不是"某个灰"。将来要换肤（深色主题）时，改的是这里的值，
        而不是去每个面板里判断哪个 #FF606266 该跟着变。

        本节的值全部照抄改造前的原值，唯一一处合并：#DCDFE6（弹窗里取消按钮的描边）
        与 #FFDCE0E6（其余所有浅边框）本就是同一个语义、只差 G 通道 1/255，
        统一到 ScadaPanelBorderBrush——肉眼不可辨，但从此只有一份。
    -->

    <!--  容器：面板底 / 标题栏底 / 白底表面（弹窗、卡片、按钮）  -->
    <SolidColorBrush x:Key="ScadaPanelBackgroundBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="ScadaTitleBarBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="ScadaSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ScadaPanelBorderBrush" Color="#D7E0EF" />
    <SolidColorBrush x:Key="ScadaActionCardBorderBrush" Color="#E4E7ED" />
    <!--  属性面板 v2：卡片化分组 + filled 输入（2026-10-28）。
         卡片描边比面板描边更中性（去掉蓝调），输入底比卡片深半档——
         层次靠底色差表达，输入框不再画描边；聚焦时才换白底 + 主色描边。  -->
    <SolidColorBrush x:Key="ScadaCardBorderBrush" Color="#E2E7EF" />
    <SolidColorBrush x:Key="ScadaFieldBackgroundBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="ScadaFieldHoverBrush" Color="#EBEEF4" />
    <!--  工具提示：墨黑底白字（系统默认黄底 ToolTip 会盖住动作卡，见 scada-property-panel 基线）  -->
    <SolidColorBrush x:Key="ScadaTooltipBackgroundBrush" Color="#1E2530" />
    <SolidColorBrush x:Key="ScadaTooltipTextBrush" Color="#FFFFFF" />
    <!--  卡片投影色（DropShadowEffect 的 Color 资源；R140：XAML 里不许写 #RRGGBB）  -->
    <Color x:Key="ScadaCardShadowColor">#0F172A</Color>
    <!--  分隔线：比描边更浅一档。分组之间、组头与行之间用它，视觉上"分开但不框住"——
         卡片描边（DCE0E6）围一圈会把每组分成立体卡片，260 宽的面板里三层面板感就是这么来的  -->
    <SolidColorBrush x:Key="ScadaHairlineBrush" Color="#E9ECF1" />
    <!--  计数徽标底：与分隔线同族，比面板底深一点，11px 的字压上去仍清楚  -->
    <SolidColorBrush x:Key="ScadaBadgeBackgroundBrush" Color="#E6EBF2" />

    <!--  用户管理弹窗（Element 口径）：浅底 / 行分隔线 / 底边线 / 弹窗标题栏  -->
    <!--  浅底：列表列头、只读字段、行悬停共用同一档——三处若各写各的，改一次色要改三遍  -->
    <SolidColorBrush x:Key="ScadaSubtleFillBrush" Color="#F5F7FA" />
    <!--  行分隔线：比列头底边再浅一档，只做"分开"，不做"框住"  -->
    <SolidColorBrush x:Key="ScadaRowDividerBrush" Color="#F2F3F5" />
    <!--  底边线：列头下沿、弹窗标题栏下沿  -->
    <SolidColorBrush x:Key="ScadaHeaderDividerBrush" Color="#EBEEF5" />
    <!--  弹窗标题栏底：比列头再浅一档，让标题条与内容区之间有层次  -->
    <SolidColorBrush x:Key="ScadaDialogTitleBarBrush" Color="#F8F9FA" />

    <!--  文字：正文 / 标签 / 次要说明 / 占位与禁用  -->
    <SolidColorBrush x:Key="ScadaTextBrush" Color="#303133" />
    <SolidColorBrush x:Key="ScadaLabelTextBrush" Color="#606266" />
    <!--  次要文字：取 web 参考项目 muted-foreground 的 #66708A（在 #FFFFFF 上 4.93:1）。
         旧值 #909399 只有 3.07:1，11~12px 的小字压在白底上达不到 WCAG AA 的 4.5:1；
         属性面板里大把"未绑定 / 已由变量提供 / 色板"这类说明文字都吃这一档。  -->
    <SolidColorBrush x:Key="ScadaSecondaryTextBrush" Color="#66708A" />
    <SolidColorBrush x:Key="ScadaFaintTextBrush" Color="#A8ABB2" />
    <SolidColorBrush x:Key="ScadaDisabledTextBrush" Color="#C0C4CC" />
    <!--  占位/空态灰：用户管理弹窗沿用的 Element 口径 #909399。
         它比 ScadaFaintTextBrush（#A8ABB2）深、比 ScadaSecondaryTextBrush（#66708A）浅，
         是"这里没内容"而不是"这是一句说明"——语义不同，所以不并进上面两档。  -->
    <SolidColorBrush x:Key="ScadaPlaceholderTextBrush" Color="#909399" />

    <!--  交互：悬停底 / 选中蓝 / 选中底 / 主按钮底 / 主按钮上的字  -->
    <SolidColorBrush x:Key="ScadaHoverBrush" Color="#E3EEF9" />
    <SolidColorBrush x:Key="ScadaAccentBrush" Color="#3B82F6" />
    <!--  收藏星：暖金语义色（与主色蓝的选中态区分）；工具箱 v2 起使用  -->
    <SolidColorBrush x:Key="ScadaFavoriteBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="ScadaAccentSoftBrush" Color="#1A3B82F6" />
    <SolidColorBrush x:Key="ScadaPrimaryButtonBrush" Color="#409EFF" />
    <SolidColorBrush x:Key="ScadaOnAccentTextBrush" Color="#FFFFFF" />
    <!--  强调色用作线条/文字（选中行描边、描边按钮的边与字）：与 ScadaPrimaryButtonBrush 同值不同用，
         一个是"填充"一个是"线条"。合成一个键的话，将来把主按钮改成深一档会连带把描边也改深。  -->
    <SolidColorBrush x:Key="ScadaAccentLineBrush" Color="#409EFF" />
    <!--  选中行底：浅蓝，与 ScadaAccentLineBrush 的描边成对出现  -->
    <SolidColorBrush x:Key="ScadaSelectedRowBrush" Color="#ECF5FF" />
    <!--  次要按钮描边（白底 + 浅灰边）：取消/关闭/重置一类  -->
    <SolidColorBrush x:Key="ScadaButtonBorderBrush" Color="#DCDFE6" />

    <!--
        组态编辑器工作台（design.html v2 §组态画面）。

        与上面那批「弹窗域」的 Scada* 分开命名：这里描述的是<b>编辑器 chrome</b>
        （顶栏、工作台底、按钮五态），不是弹窗里的卡片与表单。
        取值逐项对应 design.html 的 .scada-top / .scada-btn / .scada-canvas-wrap / .scada-zoom。
    -->
    <!--  顶栏底（.scada-top 的 surface-2）  -->
    <SolidColorBrush x:Key="ScadaToolbarBackgroundBrush" Color="#F8FAFC" />
    <!--  画布视口底（.scada-canvas-wrap）——浅色工作台，画面自己浮在上面  -->
    <SolidColorBrush x:Key="ScadaWorkbenchBrush" Color="#E9EEF5" />
    <!--  顶栏文字（.scada-top label 的 text-2）  -->
    <SolidColorBrush x:Key="ScadaToolbarTextBrush" Color="#475569" />
    <!--  .scada-btn 的描边 / 悬停 / 按下  -->
    <SolidColorBrush x:Key="ScadaToolbarBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ScadaToolbarBorderStrongBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScadaToolbarHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ScadaToolbarPressedBrush" Color="#E2E8F0" />
    <!--  主按钮悬停（.scada-btn.primary:hover 的 primary-strong）  -->
    <SolidColorBrush x:Key="ScadaPrimaryButtonHoverBrush" Color="#0284C7" />
    <!--  浮出工具条的投影色：DropShadowEffect.Color 要 Color 不是 Brush，单列一条  -->
    <Color x:Key="ScadaToolbarShadowColor">#0F172A</Color>

    <!--  语义色：非法（红）/ 警示（橙）/ 成功（绿）/ 色块描边  -->
    <SolidColorBrush x:Key="ScadaDangerBrush" Color="#E05B5B" />
    <SolidColorBrush x:Key="ScadaInvalidBackgroundBrush" Color="#FDF0F0" />
    <SolidColorBrush x:Key="ScadaWarningBrush" Color="#E6A23C" />
    <SolidColorBrush x:Key="ScadaSwatchBorderBrush" Color="#C0C4CC" />
    <!--  警告条（浅橙底 + 橙边）：用户管理弹窗里"当前不是管理员"的提示条  -->
    <SolidColorBrush x:Key="ScadaWarningSoftBrush" Color="#FDF6EC" />
    <SolidColorBrush x:Key="ScadaWarningBorderBrush" Color="#F5DAB1" />
    <!--  危险按钮（红边红字的描边态 + 红底白字的确认态）  -->
    <SolidColorBrush x:Key="ScadaDangerOutlineBrush" Color="#F56C6C" />
    <!--  成功提示文字（保存成功那一行）  -->
    <SolidColorBrush x:Key="ScadaSuccessTextBrush" Color="#67C23A" />

    <!--  已绑变量：ƒx 按钮 / 变量带底与描边 / ƒ 记号 / 变量带上的 ✕  -->
    <SolidColorBrush x:Key="ScadaBoundBrush" Color="#2A6BB5" />    <SolidColorBrush x:Key="ScadaBoundChipBrush" Color="#EAF3FF" />
    <SolidColorBrush x:Key="ScadaBoundChipBorderBrush" Color="#C6DDF5" />
    <SolidColorBrush x:Key="ScadaBoundGlyphBrush" Color="#7FA8D4" />
    <SolidColorBrush x:Key="ScadaChipCloseBrush" Color="#6B8FB5" />

    <!--  ====================  Dialog 弹窗族令牌（青蓝设计系统）  ====================  -->

    <!--
        为什么要有这一节：连接管理 / 变量管理 / 扫描组编辑 这几张弹窗
        原先各自把十六进制写死在 XAML 里，出现了三套并存的蓝：
        连接管理用 #17A2F2、变量管理用 #0EA5E9、SCADA 弹窗用 #409EFF。
        更麻烦的是"扫描组编辑"是从"连接管理"里点进去的，两套蓝会直接照面。

        本节确立单一基准：以变量管理那套 #0EA5E9 青蓝体系为准，
        其余画面统一迁过来（详见 DialogStyles.xaml）。

        键一律带 Dialog 前缀，理由与上面 Scada 那节完全相同：
        本节沿用 Scada 那节的约定——"命名按用在哪，而不是是什么颜色"。
        将来换肤（深色主题）改的是这里的值，不必再去每张画面里判断
        哪个 #0F172A 该跟着变。

        注意：短名 PrimaryTextBrush 已被 ToolView.xaml 与 GlobalVariableView.xaml
        本地重定义作局部覆盖，BorderBrush 又是 WPF 系统键名，
        所以这里一律不用短名，避免"改令牌改不动那一处"。
    -->

    <!--  主色三阶：基准 / 加深（悬停按下）/ 提亮（浅底、选中行）  -->
    <SolidColorBrush x:Key="DialogAccentBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="DialogAccentDarkBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="DialogAccentLightBrush" Color="#E0F2FE" />
    <!--
        DropShadowEffect.Color 只收 Color 不收 Brush，所以主色另存一条 Color 令牌。
        用途：静默单元格 / 选择器聚焦时那圈 3px 主色柔光（设计基线 §7.2）。
    -->
    <Color x:Key="DialogAccentColor">#0EA5E9</Color>

    <!--
        主色浅底再淡一阶 + 同族浅描边：专给"蓝底分组"容器用
        （变量管理里的"网络参数"分组：底色比分组内的白色控件深一点、
        比选中行浅一点，三层才拉得开；描边跟着分组底色走同一族）。
    -->
    <SolidColorBrush x:Key="DialogAccentSoftBrush" Color="#F0F9FF" />
    <SolidColorBrush x:Key="DialogAccentBorderBrush" Color="#BAE6FD" />

    <!--  主色文字：深底上的强调文字（如卡片标题图标、链接式按钮）  -->
    <SolidColorBrush x:Key="DialogAccentTextBrush" Color="#0369A1" />

    <!--  容器：窗口底 / 卡片与输入框白底 / 卡片描边 / 输入框浅底  -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="DialogCardBorderBrush" Color="#E3E9F2" />
    <SolidColorBrush x:Key="DialogInputBackgroundBrush" Color="#F8FAFC" />

    <!--  描边：常规控件描边 / 更浅的分隔线  -->
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DialogBorderLightBrush" Color="#EEF2F7" />
    <!--  悬停/按下描边：比 DialogBorderBrush 深一档（卡片、输入框 hover）  -->
    <SolidColorBrush x:Key="DialogBorderStrongBrush" Color="#CBD5E1" />

    <!--  文字：正文 / 次要 / 第三级说明 / 占位与禁用  -->
    <SolidColorBrush x:Key="DialogTextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="DialogTextSecondaryBrush" Color="#475569" />
    <!--
        第三级说明文字（11~12px）：MessageDialog 的底栏快捷键提示、详情区标签与 Hint。
        为什么不复用上面两支：DialogTextMutedBrush(#94A3B8) 在白底上只有约 2.6:1，
        DialogTextSecondaryBrush(#475569) 又太深（和正文抢层级）。
        #64748B 在白底约 4.8:1，刚好满足 WCAG AA 的小字口径。
        DialogTextMutedBrush 仍只用于占位 / 禁用。
    -->
    <SolidColorBrush x:Key="DialogTextTertiaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="DialogTextMutedBrush" Color="#94A3B8" />

    <!--  语义色：成功（在线）/ 危险（错误、离线）/ 警示（重连中）  -->
    <SolidColorBrush x:Key="DialogSuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="DialogDangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DialogWarningBrush" Color="#F59E0B" />

    <!--
        警示文字：与 DialogWarningBrush 同族但压深一档。
        DialogWarningBrush 是给"色块/圆点"用的亮琥珀，直接拿来写字在白底上对比度不够，
        所以"地址列、恢复初始值图标、线圈注意事项"这类浅底上的琥珀文字单独走这支。
    -->
    <SolidColorBrush x:Key="DialogWarningTextBrush" Color="#B45309" />

    <!--
        危险类浅底：给"危险动作"的软色块按钮用（表格行内的解密、删除这类）。
        与 DialogDangerBrush 成对：底色用这支、文字用 DialogDangerBrush。
        直接用 DialogDangerBrush 当底色不行 —— 饱和红上压白字只适合"主操作按钮"，
        行内动作要的是"一眼看出是危险的，但不抢主操作的视线"。
    -->
    <SolidColorBrush x:Key="DialogDangerSubtleBrush" Color="#FEF2F2" />
    <!--  危险文字/描边：与 DialogWarningTextBrush 对称；#EF4444 当小字对比度不够  -->
    <SolidColorBrush x:Key="DialogDangerTextBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DialogDangerBorderBrush" Color="#FECACA" />

    <!--
        权限类徽标（分类胶囊）：紫系三件套，与 DialogDangerSubtle/Border/Text 同构。
        语义色只登记在第一层令牌字典（R140/R31），Dialog 分册与视图一律引用、不写 hex。
    -->
    <SolidColorBrush x:Key="DialogPermissionSoftBrush" Color="#F5F3FF" />
    <SolidColorBrush x:Key="DialogPermissionBorderBrush" Color="#DDD6FE" />
    <SolidColorBrush x:Key="DialogPermissionTextBrush" Color="#6D28D9" />

    <!--  警示类浅底：给"注意事项"块的软底色（网络相机参数不生效之类），与 DialogWarningTextBrush 成对  -->
    <SolidColorBrush x:Key="DialogWarningSubtleBrush" Color="#FFF4E5" />
    <SolidColorBrush x:Key="DialogWarningBorderBrush" Color="#FDE68A" />

    <!--
        成功类浅底 + 深字：与 DialogSuccessBrush(#22C55E) 同族，成对使用。
        补这两支是为了让三个语义色**结构对称**：原先只有警示/危险有"浅底+深字"，
        成功色只有亮绿（#22C55E 直接写字对比度不够，当底色又太扎眼），
        于是"到位 / 在线 / 已完成"这类状态在界面上无处可用 —— 只能退回灰字，
        状态表达就弱了一档（运动调试面板的轴状态点正需要它）。
    -->
    <SolidColorBrush x:Key="DialogSuccessSubtleBrush" Color="#F0FDF4" />
    <SolidColorBrush x:Key="DialogSuccessTextBrush" Color="#15803D" />
    <SolidColorBrush x:Key="DialogSuccessBorderBrush" Color="#BBF7D0" />

    <!--
        数据类型：数组类型色（2026-10-20 变量管理类型 chip 新增）。
        只补"数组"这一档：int/double/bool/string/image 复用既有语义族，
        不另造第二套数据色。三支键放在第一层令牌字典，任何 Dialog 分册都可引用（R30-R32）。
    -->
    <SolidColorBrush x:Key="DialogTypeArrayBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="DialogTypeArrayTextBrush" Color="#0E7490" />
    <SolidColorBrush x:Key="DialogTypeArraySoftBrush" Color="#ECFEFF" />

    <!--  交互底：行悬停 / 行选中（与 DialogAccentLightBrush 同族但更淡）  -->
    <SolidColorBrush x:Key="DialogRowHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DialogRowAlternateBrush" Color="#F8FAFC" />

    <!--  投影：卡片投影色（配合 DropShadowEffect 使用，仅取色不带透明度）  -->
    <Color x:Key="DialogShadowColor">#0F172A</Color>

    <!--
        图标字体令牌（Font Awesome 6 Pro Solid，与 App.xaml 的 Icon、IconDictionary 的 FA.Solid 同源同串）。

        为什么放在「第一层令牌字典」而不是某个 Dialog 分册里：
        弹窗皮肤拆成 Dialog.*.xaml 分册后，写在分册里的 {StaticResource} 只有
        「本文件 + 本文件自己 merge 的子树」这一层作用域 —— 兄弟分册互相看不见。
        本令牌被三个分册消费（Container / Input / Misc），原先挂在 Dialog.Text.xaml，
        拆册当天就断了：两支 Setter 静默失效（卡片标题图标退成默认字体 → 豆腐块），
        模板里那支更狠 —— 2026-10-10「变量管理」弹窗一打开就抛「无法找到名为 DialogIconFont 的资源」。
        放进 Colors.xaml 后所有分册都能查到（每个样式分册都自带 merge Colors.xaml），
        键名保留 DialogIconFont 不动，避免改一串引用方。
        换图标字体时：本处 + App.xaml 的 Icon + IconDictionary 的 FA.Solid，三处一起改。
    -->
    <FontFamily x:Key="DialogIconFont">pack://application:,,,/UI;component/Asserts/FontFamilys/Font Awesome 6 Pro-Solid-900.otf#Font Awesome 6 Pro Solid</FontFamily>

    <!--  ====================  流程画布令牌  ====================  -->

    <!--
        与 SCADA 节同理由：流程画布的节点/容器/连线原先把十六进制写死在 FlowCanvasView.xaml，
        统一收口到这里。键带 FlowCanvas 前缀防撞名；命名按"用在哪"而不是"是什么颜色"。
    -->

    <!--  画布：底 / 网格点 / 顶部工具条底  -->
    <SolidColorBrush x:Key="FlowCanvasBackgroundBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="FlowCanvasGridDotBrush" Color="#C9D2DE" />
    <SolidColorBrush x:Key="FlowCanvasToolbarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlowCanvasToolbarBorderBrush" Color="#E2E8F0" />

    <!--  模块盒：底 / 描边 / 悬停描边 / 选中描边与光晕 / 标题字 / 副标题字 / 图标字 / 禁用  -->
    <SolidColorBrush x:Key="FlowCanvasNodeBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlowCanvasNodeBorderBrush" Color="#C9D2DE" />
    <SolidColorBrush x:Key="FlowCanvasNodeHoverBorderBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="FlowCanvasNodeSelectedBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="FlowCanvasNodeSelectedGlowBrush" Color="#333B82F6" />
    <SolidColorBrush x:Key="FlowCanvasNodeTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="FlowCanvasNodeSubTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="FlowCanvasNodeIconBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="FlowCanvasNodeDisabledBrush" Color="#B8BFC9" />
    <!--  失败节点底色（flow-logic：失败态红边 + #FFF7F7 淡红底；容器用同族更浅一档）  -->
    <SolidColorBrush x:Key="FlowCanvasNodeFailedBackgroundBrush" Color="#FFF7F7" />
    <SolidColorBrush x:Key="FlowCanvasContainerFailedBackgroundBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="FlowCanvasFailedSoftBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="FlowCanvasFailedBorderBrush" Color="#FECACA" />
    <SolidColorBrush x:Key="FlowCanvasFailedTextBrush" Color="#B91C1C" />

    <!--  状态点：正常 / 运行 / 成功 / 失败 / 跳过 / 告警（flow-logic 状态矩阵）  -->
    <SolidColorBrush x:Key="FlowCanvasStateIdleBrush" Color="#A8ABB2" />
    <SolidColorBrush x:Key="FlowCanvasStateRunningBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="FlowCanvasStateSuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="FlowCanvasStateFailedBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="FlowCanvasStateSkippedBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="FlowCanvasStateWarningBrush" Color="#D97706" />

    <!--  序号角标：底 / 字（flow-logic：深色小胶囊，不再用亮蓝）  -->
    <SolidColorBrush x:Key="FlowCanvasOrderBadgeBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="FlowCanvasOnOrderBadgeTextBrush" Color="#FFFFFF" />

    <!--  运行态描边：运行中 / 成功 / 失败 / 跳过；Idle 不特殊描边（回落默认描边）  -->
    <SolidColorBrush x:Key="FlowCanvasRunningBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="FlowCanvasSuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="FlowCanvasFailedBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="FlowCanvasSkippedBrush" Color="#CBD5E1" />

    <!--  连线：数据依赖 / 非法（虚线）/ 执行顺序链（细虚线，与数据线视觉区分）  -->
    <SolidColorBrush x:Key="FlowCanvasLinkBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="FlowCanvasLinkIllegalBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="FlowCanvasOrderLinkBrush" Color="#94A3B8" />

    <!--  连线交叉分离描边：同色线条互相穿过时，先画一圈画布底色的粗笔再画本线，
          交叉处出现一道"断口"，一眼能看出谁在上谁在下（Nodify BaseConnection.OutlineBrush
          正是"同几何粗笔垫底"的机制）。取画布底色而不是白色，是为了在泳道淡蓝底上也自然  -->
    <SolidColorBrush x:Key="FlowCanvasLinkOutlineBrush" Color="#F7F8FA" />

    <!--  连线中段标签：底色 + 字色。此前只给 Text 不给底色，标签直接飘在点阵背景上，
          与线交叠时既看不清边界也读不出字（用户口径"文字也不醒目"）  -->
    <SolidColorBrush x:Key="FlowCanvasLinkLabelBackgroundBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="FlowCanvasLinkLabelTextBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="FlowCanvasOrderLinkLabelTextBrush" Color="#64748B" />

    <!--  ====================  拖拽落点提示条（设计基线 docs/UI设计基线/drag-drop-hint v2）  ====================  -->
    <!--  四档状态色：底 = 状态色 8~10% 叠白（无描边），文字与图标同色系深一档。
          口径见设计稿 §05；提示条内部只引这四个键，不写字面色（R140）。  -->
    <SolidColorBrush x:Key="DragHintValidBackgroundBrush" Color="#ECF8FD" />
    <SolidColorBrush x:Key="DragHintValidTextBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="DragHintValidIconBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="DragHintCautionBackgroundBrush" Color="#FEF5E7" />
    <SolidColorBrush x:Key="DragHintCautionTextBrush" Color="#B45309" />
    <SolidColorBrush x:Key="DragHintCautionIconBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DragHintIllegalBackgroundBrush" Color="#FCEFEE" />
    <SolidColorBrush x:Key="DragHintIllegalTextBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DragHintIllegalIconBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DragHintLockedBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="DragHintLockedTextBrush" Color="#475569" />
    <SolidColorBrush x:Key="DragHintLockedIconBrush" Color="#64748B" />

    <!--  ====================  逻辑容器类型色（flow-logic）  ====================  -->
    <!--  只用于容器组头/边框/类型徽标；叶子节点仍用 ToolboxCategoryVisuals 的分类色。  -->
    <SolidColorBrush x:Key="LogicIfBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="LogicIfSoftBrush" Color="#EEF2FF" />
    <SolidColorBrush x:Key="LogicIfBorderBrush" Color="#C7D2FE" />
    <SolidColorBrush x:Key="LogicIfTextBrush" Color="#4338CA" />
    <SolidColorBrush x:Key="LogicCaseBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="LogicCaseSoftBrush" Color="#F5F3FF" />
    <SolidColorBrush x:Key="LogicCaseBorderBrush" Color="#DDD6FE" />
    <SolidColorBrush x:Key="LogicCaseTextBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="LogicWhileBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="LogicWhileSoftBrush" Color="#FFFBEB" />
    <SolidColorBrush x:Key="LogicWhileBorderBrush" Color="#FDE68A" />
    <SolidColorBrush x:Key="LogicWhileTextBrush" Color="#B45309" />
    <SolidColorBrush x:Key="LogicForBrush" Color="#10B981" />
    <SolidColorBrush x:Key="LogicForSoftBrush" Color="#ECFDF5" />
    <SolidColorBrush x:Key="LogicForBorderBrush" Color="#A7F3D0" />
    <SolidColorBrush x:Key="LogicForTextBrush" Color="#047857" />
    <SolidColorBrush x:Key="LogicParallelBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="LogicParallelSoftBrush" Color="#F0F9FF" />
    <SolidColorBrush x:Key="LogicParallelBorderBrush" Color="#BAE6FD" />
    <SolidColorBrush x:Key="LogicParallelTextBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="LogicSelectionSoftBrush" Color="#EFF6FF" />

    <!--
        容器组头渐变（flow-logic `.container-head`：类型浅底 → 白色 76%）。
        颜色全部来自上面各类型的 soft 值，只为 WPF 的 LinearGradientBrush 提供 Color 形态；
        引用方只用 *HeaderBrush，不再直接拼色。
    -->
    <LinearGradientBrush x:Key="LogicIfHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#EEF2FF" />
        <GradientStop Offset="0.76" Color="#FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogicCaseHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#F5F3FF" />
        <GradientStop Offset="0.76" Color="#FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogicWhileHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFFBEB" />
        <GradientStop Offset="0.76" Color="#FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogicForHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#ECFDF5" />
        <GradientStop Offset="0.76" Color="#FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogicParallelHeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#F0F9FF" />
        <GradientStop Offset="0.76" Color="#FFFFFF" />
    </LinearGradientBrush>

    <!--  ====================  运行驾驶舱深色子主题  ====================  -->
    <SolidColorBrush x:Key="RunCockpitBackgroundBrush" Color="#0E141B" />
    <SolidColorBrush x:Key="RunCockpitSurfaceBrush" Color="#151D26" />
    <SolidColorBrush x:Key="RunCockpitChromeBrush" Color="#111820" />
    <SolidColorBrush x:Key="RunCockpitBorderBrush" Color="#26303B" />
    <SolidColorBrush x:Key="RunCockpitTextBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="RunCockpitTextSecondaryBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="RunCockpitTextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="RunCockpitTextFaintBrush" Color="#64748B" />
    <SolidColorBrush x:Key="RunCockpitSuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="RunCockpitDangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="RunCockpitWarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="RunCockpitInfoBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="RunCockpitStopBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="RunCockpitStopBorderBrush" Color="#E05A4A" />
    <SolidColorBrush x:Key="RunCockpitStopHoverBrush" Color="#D9453A" />

    <!--  容器框：头带底 / 框体描边 / 框体 tint 底 / 头带字；分支泳道：tint 底 / 描边 / 标题字  -->
    <SolidColorBrush x:Key="FlowCanvasFrameHeaderBrush" Color="#EEF4FF" />
    <SolidColorBrush x:Key="FlowCanvasFrameBorderBrush" Color="#A5C0E8" />
    <SolidColorBrush x:Key="FlowCanvasFrameTintBrush" Color="#0DA5B4FC" />
    <SolidColorBrush x:Key="FlowCanvasFrameHeaderTextBrush" Color="#3B5B8C" />
    <SolidColorBrush x:Key="FlowCanvasLaneTintBrush" Color="#0F3B82F6" />
    <SolidColorBrush x:Key="FlowCanvasLaneBorderBrush" Color="#264B82F6" />
    <SolidColorBrush x:Key="FlowCanvasLaneTextBrush" Color="#5A6C99" />
    <!--  泳道头带：flow-logic 用 68% 白覆盖在类型浅底上（半透明白 → 同一支令牌）；运行中换 #EFF6FF  -->
    <SolidColorBrush x:Key="FlowCanvasLaneHeaderBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="FlowCanvasLaneRunningHeaderBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="FlowCanvasRunningTextBrush" Color="#1D4ED8" />

    <!--  中性分支泳道（If 的 Else/ElseIf、Case 的默认分支）：flow-logic 用灰底灰边，不再套类型色  -->
    <SolidColorBrush x:Key="FlowCanvasLaneNeutralBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="FlowCanvasLaneNeutralBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="FlowCanvasLaneNeutralBadgeBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="FlowCanvasLaneNeutralTextBrush" Color="#475569" />

    <!--  类型徽标（If/While/For）：底 / 字  -->
    <SolidColorBrush x:Key="FlowCanvasTypeBadgeBrush" Color="#3B5B8C" />
    <SolidColorBrush x:Key="FlowCanvasOnTypeBadgeTextBrush" Color="#FFFFFF" />

    <!--  外链徽标（全局变量/常量绑定数）：底 / 描边 / 字  -->
    <SolidColorBrush x:Key="FlowCanvasExtBadgeBrush" Color="#FFF7E6" />
    <SolidColorBrush x:Key="FlowCanvasExtBadgeBorderBrush" Color="#E6C98A" />
    <SolidColorBrush x:Key="FlowCanvasExtBadgeTextBrush" Color="#9A6B0F" />

    <!--  折叠按钮：底 / 描边 / 字 / 悬停底  -->
    <SolidColorBrush x:Key="FlowCanvasCollapseBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FlowCanvasCollapseBorderBrush" Color="#C9D2DE" />
    <SolidColorBrush x:Key="FlowCanvasCollapseTextBrush" Color="#475569" />
    <SolidColorBrush x:Key="FlowCanvasCollapseHoverBrush" Color="#E3EEF9" />

    <!--
        调试/断点与告警：警示橙（调试停驻描边 + Warning 运行态描边，与 ScadaWarningBrush 同值但各守各的域）/
        断点实心红（与 FlowCanvasFailedBrush 是两种语义的红：断点=用户挂的，失败=运行态）/ 
        断点空闲环与 Cancel 运行态灰 / 告警条浅红底（原先是画布跨域借用 ScadaInvalidBackgroundBrush）。
        2026-10-07 画布审查：这三处十六进制曾写死在 FlowCanvasView.xaml，按本文件收口约定迁入。
    -->
    <SolidColorBrush x:Key="FlowCanvasWarningBrush" Color="#E6A23C" />
    <SolidColorBrush x:Key="FlowCanvasBreakpointBrush" Color="#F56C6C" />
    <SolidColorBrush x:Key="FlowCanvasCanceledBrush" Color="#C0C4CC" />
    <SolidColorBrush x:Key="FlowCanvasWarningBackgroundBrush" Color="#FDF0F0" />

    <!--  ====================  登录窗品牌区（深色语境）  ====================  -->
    <!--
        2026-10-22 从 ScadaLoginView.xaml 收口上来（原先 8 处字面量写死在视图里，违反 R140）。

        为什么单独一组而不复用 Dialog*：品牌区是深色语境（深青渐变 + 半透明白卡），
        与弹窗的浅色面语义相反；混用会让"改弹窗底色"顺手把品牌区也改浅。
        设计基线 parts/18-scada-login.html 的「已知偏差」写明：当时共享 CSS 没有深色档位，
        只能用浅色示意；这组令牌补的就是那一档。

        渐变只能是 LinearGradientBrush，所以键名带 Gradient 后缀；其余五支是它上面的
        文字 / 卡片 / 分隔线。改品牌色只改这里，视图里不留色值。
    -->
    <LinearGradientBrush x:Key="BrandSurfaceGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0B1F33" />
        <GradientStop Offset="0.52" Color="#0C3B57" />
        <GradientStop Offset="1" Color="#0B5F7A" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrandTextBrush" Color="#EAF6FF" />
    <SolidColorBrush x:Key="BrandMutedBrush" Color="#B7D9EC" />
    <SolidColorBrush x:Key="BrandCardBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BrandCardBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="BrandDividerBrush" Color="#33FFFFFF" />

    <!--  ====================  组态运行态窗口（深色语境）  ====================  -->
    <!--
        2026-10-22 从 ScadaRuntimeWindow.xaml 收口上来（原先 17 个色值写死在视图里，
        R140 基线由 14 被顶到 22）。

        为什么单独一组而不复用 Dialog*/Scada*：运行态窗口是**深色**语境（操作员在车间
        大屏前看），与编辑态的浅色面板语义相反。混用会让"改面板底色"顺手把运行窗口
        也改浅 —— 那正是 R140 想避免的连带。

        命名带 Run 前缀，与编辑态那组 Scada* 分开；改深色配色只改这一节，视图里不留色值。
        视图 ScadaRuntimeWindow.xaml 就地合并本字典（断言宿主没有应用级资源，R22/R94）。
    -->
    <SolidColorBrush x:Key="ScadaRunWindowBrush" Color="#FF16191D" />
    <SolidColorBrush x:Key="ScadaRunBarBrush" Color="#FF22262C" />
    <SolidColorBrush x:Key="ScadaRunBarLineBrush" Color="#FF33383F" />
    <SolidColorBrush x:Key="ScadaRunTextBrush" Color="#FFD6DAE0" />
    <SolidColorBrush x:Key="ScadaRunMutedTextBrush" Color="#FF8A929E" />
    <SolidColorBrush x:Key="ScadaRunStopBrush" Color="#FFC0392B" />
    <SolidColorBrush x:Key="ScadaRunStopBorderBrush" Color="#FFE05A4A" />
    <SolidColorBrush x:Key="ScadaRunStopHoverBrush" Color="#FFD9453A" />
    <SolidColorBrush x:Key="ScadaRunStopPressedBrush" Color="#FFA5342A" />
    <SolidColorBrush x:Key="ScadaRunControlBrush" Color="#FF2A2F36" />
    <SolidColorBrush x:Key="ScadaRunControlBorderBrush" Color="#FF3A4048" />
    <SolidColorBrush x:Key="ScadaRunControlHoverBrush" Color="#FF323841" />
    <SolidColorBrush x:Key="ScadaRunToggleOnBrush" Color="#FF2B4C7E" />
    <SolidColorBrush x:Key="ScadaRunAccentBrush" Color="#FF4A8FE0" />
    <SolidColorBrush x:Key="ScadaRunBackdropBrush" Color="#A603070C" />
    <SolidColorBrush x:Key="ScadaRunPopupBrush" Color="#FF151C23" />
    <SolidColorBrush x:Key="ScadaRunPopupBorderBrush" Color="#FF3A4A5C" />
</ResourceDictionary>
