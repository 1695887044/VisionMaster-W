<UserControl
    x:Class="UI.CustomControl.DialogArrayEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="440"
    MinHeight="360"
    mc:Ignorable="d">

    <!--
        数组元素编辑器（可增 / 删 / 改 / 上下移）。
        由 EasyDialog.ShowSync(title, FrameworkElement) 承载，也可以嵌进任何需要"编辑一串值"的地方。

        为什么要有这个控件（而不是继续用 PropertyGrid 弹窗）：
        UI 库的 PropertyGrid 是反射式生成器体系，它的生成器只有
        Bool / Enum / struct(基础类型) / 嵌套对象 / [PropertyItem] 兜底五种，**没有集合生成器**。
        也就是说把 ObservableCollection 挂在承载对象上让它渲染，结果就是"什么都不显示" ——
        数组变量原来的编辑弹窗里只有一行只读的"元素数"，新建数组（长度 0）后等于死路。
        这里改成显式的列表编辑器，不再依赖反射能猜对集合。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部提示：元素类型 + 说明  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Style="{StaticResource DialogColumnTitleIcon}"
                    Text="&#xf0cb;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogAccentTextBrush}"
                    Text="{Binding ElementTypeName, StringFormat='元素类型：{0}'}" />
            </StackPanel>
            <TextBlock
                Margin="0,6,0,0"
                FontSize="11.5"
                Foreground="{StaticResource DialogTextMutedBrush}"
                Text="{Binding Hint}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  元素列表  -->
        <Border
            Grid.Row="1"
            Background="{StaticResource DialogInputBackgroundBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <ScrollViewer Padding="8,6" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  下标（与变量表里 [0]/[1] 的编号一致，便于对照）  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding DisplayIndex}" />

                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource DialogCellInput}"
                                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Orientation="Horizontal">
                                        <Button
                                            Click="OnMoveUpClick"
                                            Style="{StaticResource DialogIconButton}"
                                            ToolTip="上移">
                                            <TextBlock
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="12"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="&#xf077;" />
                                        </Button>
                                        <Button
                                            Click="OnMoveDownClick"
                                            Style="{StaticResource DialogIconButton}"
                                            ToolTip="下移">
                                            <TextBlock
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="12"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="&#xf078;" />
                                        </Button>
                                        <Button
                                            Click="OnRemoveClick"
                                            Style="{StaticResource DialogIconButton}"
                                            ToolTip="删除该元素">
                                            <TextBlock
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="12"
                                                Foreground="{StaticResource DialogDangerBrush}"
                                                Text="&#xf2ed;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  空状态：新建的数组长度是 0，必须明确告诉用户"怎么开始"  -->
                <StackPanel
                    x:Name="EmptyHint"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="24"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="&#xf0cb;" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="还没有元素，点下方「添加元素」开始" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  底部：添加 + 计数  -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <!--
                Style 用 DialogFooterPrimaryButton（对话框里的小号主按钮：高 34 + 最小宽 88），
                不是 DialogAccentButton —— 后者定义在 PluginConfigStyles.xaml（插件配置族），
                本控件属于弹窗族，引过来会把两个族耦在一起，而且它在本字典的解析链上根本找不到
                （本轮探针就是被这条抓住的：XamlParseException + 无法找到资源）。
            -->
            <Button
                HorizontalAlignment="Left"
                Click="OnAddClick"
                Style="{StaticResource DialogFooterPrimaryButton}"
                ToolTip="在末尾追加一个元素">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="11"
                        Text="&#xf067;" />
                    <TextBlock VerticalAlignment="Center" Text="添加元素" />
                </StackPanel>
            </Button>

            <TextBlock
                x:Name="CountText"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="11.5"
                Foreground="{StaticResource DialogTextMutedBrush}" />
        </Grid>
    </Grid>
</UserControl>
