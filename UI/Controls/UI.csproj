<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Asserts\FontFamilys\Font Awesome 6 Pro-Light-300.otf" />
    <None Remove="Asserts\FontFamilys\Font Awesome 6 Pro-Regular-400.otf" />
    <None Remove="Asserts\FontFamilys\Font Awesome 6 Pro-Solid-900.otf" />
    <None Remove="Asserts\FontFamilys\Font Awesome 6 Pro-Thin-100.otf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\VM.Core.csproj" />
    <!--
      还要**直接**引用契约层：属性面板的"动态候选下拉"要认 Core.Interfaces 里的
      StepConfigOptionsAttribute。
      VM.Core 虽然间接引用 Core.Interfaces，但传递引用不参与编译 ——
      不显式引一下，UI 库看不到那个特性类型。
    -->
    <ProjectReference Include="..\..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Asserts\FontFamilys\Font Awesome 6 Pro-Light-300.otf" />
    <Resource Include="Asserts\FontFamilys\Font Awesome 6 Pro-Regular-400.otf" />
    <Resource Include="Asserts\FontFamilys\Font Awesome 6 Pro-Solid-900.otf" />
    <Resource Include="Asserts\FontFamilys\Font Awesome 6 Pro-Thin-100.otf" />
  </ItemGroup>

</Project>
