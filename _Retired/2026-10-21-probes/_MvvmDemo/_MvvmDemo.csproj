<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RootNamespace>_MvvmDemo</RootNamespace>
    <AssemblyName>_MvvmDemo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <!-- 图表库源码链接编译:随 _ChartProbe5\Charts 一起更新 -->
  <ItemGroup>
    <Compile Include="..\_ChartProbe5\Charts\*.cs" Link="Charts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
