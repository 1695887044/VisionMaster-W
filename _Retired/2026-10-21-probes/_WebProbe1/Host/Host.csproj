<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M0 探针宿主：模拟 VisionMaster.exe 的"可选模块"加载路径。
    只做隔离实验，不参与 VisionMaster.sln，不影响生产工程。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Probe.Host</AssemblyName>
    <RootNamespace>Probe.Host</RootNamespace>
    <!-- 输出到 _WebProbe1\out\ ：exe 与 Web\ 同级、AppConfig.json 同级，与 <publish> 布局一致 -->
    <OutputPath>$(MSBuildThisFileDirectory)..\out\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\VM.Core.csproj" />
  </ItemGroup>

</Project>
