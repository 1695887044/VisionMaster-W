<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Same Program.cs as Host, plus <FrameworkReference Include="Microsoft.AspNetCore.App" />.
    Used only for observation H: proves the fix for "web module cannot resolve ASP.NET Core".
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Probe.HostAspNet</AssemblyName>
    <RootNamespace>Probe.Host</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>$(MSBuildThisFileDirectory)..\out\HostAspNet\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Host\Program.cs" Link="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\VM.Core.csproj" />
  </ItemGroup>

</Project>
