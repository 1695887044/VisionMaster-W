<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UI.CustomControl">

    <Style TargetType="{x:Type local:Popover}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Popover}">
                    <Grid x:Name="RootNode">

                        <ContentPresenter />

                        <Popup
                            AllowsTransparency="True"
                            IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Placement="{TemplateBinding Placement}"
                            PlacementTarget="{Binding ElementName=RootNode}"
                            PopupAnimation="Fade"
                            StaysOpen="False">

                            <Border
                                Margin="16"
                                Padding="12"
                                Background="#FFFFFF"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="20"
                                        Direction="270"
                                        Opacity="0.12"
                                        ShadowDepth="4"
                                        Color="Black" />
                                </Border.Effect>

                                <ContentPresenter Content="{TemplateBinding FlyoutContent}" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>