<Window x:Class="VirtualCameraClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="虚拟相机客户端 · HTTP 推图工具"
        Height="720" Width="1120" MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左列：连接参数 + 图片源 ============ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 连接参数 -->
            <GroupBox Grid.Row="0" Header="连接参数" Margin="0,0,0,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="主机" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="端口" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="序列号" VerticalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                               Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="令牌" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1"
                               Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <!-- 图片源 -->
            <GroupBox Grid.Row="1" Header="图片源">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="选择文件夹" Padding="10,4"
                                Command="{Binding BrowseFolderCommand}"/>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding ImageCount, StringFormat=共 {0} 张图片}"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Images}"
                             SelectedItem="{Binding SelectedImage}"
                             DisplayMemberPath="FileName"/>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ============ 右列：预览 + 推图控制 + 心跳/统计 + 日志 ============ -->
        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <!-- 预览 -->
            <GroupBox Grid.Row="0" Header="预览">
                <Border Background="#FF202020" Margin="4">
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"/>
                </Border>
            </GroupBox>

            <!-- 推图控制 -->
            <GroupBox Grid.Row="1" Header="推图节拍" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="8">
                    <TextBlock Text="节拍(ms)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="80" VerticalAlignment="Center"
                             Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}"/>

                    <Button Content="{Binding StartStopText}" Padding="14,4" Margin="16,0,0,0"
                            Command="{Binding TogglePushCommand}"/>
                    <Button Content="手动推一帧" Padding="14,4" Margin="10,0,0,0"
                            Command="{Binding PushOnceCommand}"/>

                    <TextBlock VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#FF666666"
                               Text="{Binding ImageFolder}"/>
                </StackPanel>
            </GroupBox>

            <!-- 心跳 + 统计 -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="心跳（每 1 秒自动发送，与推图开关无关）" Margin="0,0,4,0">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding HeartbeatText}" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding HeartbeatState, StringFormat=服务端状态：{0}}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="统计" Margin="4,0,0,0">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="成功推帧：" Margin="0,0,4,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,2">
                            <Run Text="{Binding PushSuccess, Mode=OneWay}"/>
                            <Run Text=" 张"/>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="失败推帧：" Margin="0,0,4,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,2">
                            <Run Text="{Binding PushFail, Mode=OneWay}"/>
                            <Run Text=" 张"/>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="最近耗时：" Margin="0,0,4,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1">
                            <Run Text="{Binding LastElapsedMs, Mode=OneWay}"/>
                            <Run Text=" ms"/>
                        </TextBlock>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- 最近响应 + 日志 -->
            <GroupBox Grid.Row="3" Header="日志（最多保留 200 条）" Margin="0,8,0,0">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="4,2,4,6" TextWrapping="Wrap"
                               Foreground="#FF1F6FEB"
                               Text="{Binding LastServerSummary, StringFormat=最近响应：{0}}"/>

                    <TextBox Grid.Row="1"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
