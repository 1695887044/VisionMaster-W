<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WebProbe6</AssemblyName>
    <RootNamespace>WebProbe6</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0618;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 被测对象：M1b 的快照 + 值帧 + 静态资源 -->
    <ProjectReference Include="..\..\..\Web\VisionMaster.ScadaWeb\VisionMaster.ScadaWeb.csproj" />
  </ItemGroup>

  <!-- Watson 在 Web 工程里是 Private=false，探针必须自带一份（与 _WebProbe5 同源） -->
  <ItemGroup>
    <Reference Include="WatsonWebserver">
      <HintPath>..\..\..\DLL\Watson\WatsonWebserver.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="IpMatcher">
      <HintPath>..\..\..\DLL\Watson\IpMatcher.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RegexMatcher">
      <HintPath>..\..\..\DLL\Watson\RegexMatcher.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Timestamps">
      <HintPath>..\..\..\DLL\Watson\Timestamps.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UrlMatcher">
      <HintPath>..\..\..\DLL\Watson\UrlMatcher.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    静态资源兜底投递：Web 工程的 Content 正常情况下会随工程引用进输出目录；
    这里显式再挂一份，保证探针的 AppContext.BaseDirectory\wwwroot 一定有文件
    （ScadaWebHost.ResolveStaticFile 的第二个候选根）。
  -->
  <ItemGroup>
    <Content Include="..\..\..\Web\VisionMaster.ScadaWeb\wwwroot\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
