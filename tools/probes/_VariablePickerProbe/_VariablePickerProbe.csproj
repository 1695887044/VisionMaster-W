<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VariablePickerProbe</AssemblyName>
    <RootNamespace>VariablePickerProbe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- 真视图：赋值插件的 VariableAssignmentView（Step 0 要量的是它，不是仿造件） -->
    <ProjectReference Include="..\..\..\Plugins\Plugin.Utility\Plugin.Util.csproj" />
    <!-- 主题链：UI 库的 Generic.xaml（含 Selection.xaml 的隐式 ComboBox 样式）与 Fluent 令牌 -->
    <ProjectReference Include="..\..\..\UI\Controls\UI.csproj" />
    <!-- Core.Halcon 用原始 Reference，不随工程引用传递（同 ResProbe 的说明） -->
    <Reference Include="halcondotnet">
      <HintPath>..\..\..\DLL\Halcon\halcondotnet.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
