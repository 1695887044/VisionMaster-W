<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只引主程序：Core / Scada / Scada.Controls 都由它传递引用。
         显式再引 Scada 会让同一程序集被两条引用链各构建一次（RG1000）。 -->
    <ProjectReference Include="..\..\..\VisionMaster\VisionMaster.csproj" />
  </ItemGroup>

</Project>
