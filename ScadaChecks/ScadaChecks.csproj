<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <!-- 断言工程只做逻辑校验与压力测试，不参与产品发布；Debug/Release 都可直接 dotnet run -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- B3：角色制并发夹具已下线，改由 SolutionUserChecks 的 [SL]/[SL-g] 覆盖。 -->
    <Compile Remove="UserStoreConcurrencyChecks.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用主程序即可拿到 Core / Core.Interfaces / Communication 的全部 public 面。
         VM.Scada.Controls 由 VisionMaster 传递引用：再显式引一次会让它被两条引用链
         各构建一次，WPF 的 _wpftmp 与主工程抢同一个 obj，报 RG1000「BAML 键重复」。 -->
    <ProjectReference Include="..\VisionMaster\VisionMaster.csproj" />
  </ItemGroup>

</Project>
