{
  "schema": "vm-plan/1",
  "id": "solution-create-and-save",
  "title": "新建方案并保存到父目录（组合任务）",
  "version": "1.1.0",
  "risk": "low",
  "description": "先调用 solution-new，再调用 solution-save-as。落点是 <parent_dir>/<方案名>/<方案名>.vms：方案名里的非法字符会被替换成下划线，断言时用净化后的名字。",
  "params": {
    "solution_name": {
      "type": "string",
      "required": true,
      "example": "Demo_20261023"
    },
    "parent_dir": {
      "type": "string",
      "required": true,
      "example": "D:\\VMSolutions"
    }
  },
  "preconditions": [
    { "assert": "process_running", "process": "VisionMaster" },
    { "assert": "window", "target": "app.main" }
  ],
  "steps": [
    {
      "n": 1,
      "do": "call",
      "plan": "solution-new",
      "args": { "solution_name": "${solution_name}" },
      "expect": { "window": "app.main", "state": "visible" },
      "timeout_ms": 20000
    },
    {
      "n": 2,
      "do": "call",
      "plan": "solution-save-as",
      "args": {
        "parent_dir": "${parent_dir}",
        "expected_vms": "${parent_dir}\\${solution_name}\\${solution_name}.vms"
      },
      "expect": { "window": "app.main", "state": "visible" },
      "timeout_ms": 40000
    },
    {
      "n": 3,
      "do": "assert",
      "assert": "file_exists",
      "path": "${parent_dir}\\${solution_name}\\${solution_name}.vms",
      "timeout_ms": 5000
    }
  ],
  "postconditions": [
    { "assert": "file_exists", "path": "${parent_dir}\\${solution_name}\\${solution_name}.vms", "timeout_ms": 5000 }
  ],
  "on_fail": "stop_and_report",
  "tags": ["solution", "create", "save", "composite"]
}
