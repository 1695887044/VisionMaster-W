{
  "schema": "vm-plan/1",
  "id": "solution-create-and-save",
  "title": "新建方案并保存到指定路径（组合任务）",
  "version": "1.0.0",
  "risk": "low",
  "description": "组合示例：先调用 solution-new，再调用 solution-save。上层任务只关心「新建并落盘」这个结果，不重复写两次菜单路径。",
  "params": {
    "solution_name": {
      "type": "string",
      "required": true,
      "example": "Demo_20261023"
    },
    "save_path": {
      "type": "string",
      "required": true,
      "example": "D:\\C#\\VM\\解决方案\\Demo_20261023.vms"
    }
  },
  "preconditions": [
    { "assert": "process_running", "process": "VisionMaster" },
    { "assert": "window", "target": "app.main" }
  ],
  "steps": [
    {
      "n": 1,
      "do": "call",
      "plan": "solution-new",
      "args": { "solution_name": "${solution_name}" },
      "expect": { "window": "app.main", "state": "visible" },
      "timeout_ms": 20000
    },
    {
      "n": 2,
      "do": "call",
      "plan": "solution-save",
      "args": { "save_path": "${save_path}" },
      "expect": { "window": "app.main", "state": "visible" },
      "timeout_ms": 40000
    },
    {
      "n": 3,
      "do": "assert",
      "assert": "file_exists",
      "path": "${save_path}",
      "timeout_ms": 5000
    }
  ],
  "postconditions": [
    { "assert": "file_exists", "path": "${save_path}", "timeout_ms": 5000 }
  ],
  "on_fail": "stop_and_report",
  "tags": ["solution", "create", "save", "composite"]
}
