{
  "schema": "vm-plan/1",
  "id": "step-configure-condition",
  "title": "配置等待/条件步骤（条件编辑器）",
  "version": "1.0.0",
  "risk": "medium",
  "description": "等待步骤双击后打开「等待条件配置」，条件步骤打开「条件逻辑配置中心」；填表达式与轮询/超时后点「保存并应用」。",
  "params": {
    "step_name": {
      "type": "string",
      "required": true,
      "example": "等待"
    },
    "expression": {
      "type": "string",
      "required": true,
      "example": "Global.Var1 > 10"
    },
    "poll_interval_ms": {
      "type": "string",
      "required": false,
      "default": "100",
      "example": "100"
    },
    "max_timeout_ms": {
      "type": "string",
      "required": false,
      "default": "5000",
      "example": "5000"
    }
  },
  "preconditions": [
    { "assert": "process_running", "process": "VisionMaster" },
    { "assert": "element_exists", "target": "canvas.step_title" }
  ],
  "steps": [
    {
      "n": 1,
      "do": "double_click",
      "target": "canvas.step_title",
      "target_name": "${step_name}",
      "expect": { "window": "dialog.condition", "state": "visible" },
      "timeout_ms": 8000
    },
    {
      "n": 2,
      "do": "click",
      "target": "dialog.condition.expression",
      "expect": { "element": "dialog.condition.expression", "state": "enabled" },
      "timeout_ms": 3000
    },
    {
      "n": 3,
      "do": "type",
      "target": "dialog.condition.expression",
      "text": "${expression}",
      "clear": true,
      "expect": { "element": "dialog.condition.expression", "value": "${expression}" }
    },
    {
      "n": 4,
      "do": "note",
      "text": "轮询间隔/最大超时字段是自定义 TextBlock 标签，没有 AutomationName；先补 AutomationId 或按 Tab 顺序校准，再在此插入 fill/type_focused 步骤"
    },
    {
      "n": 5,
      "do": "click",
      "target": "dialog.condition.save",
      "expect": { "window": "dialog.condition", "state": "closed" },
      "timeout_ms": 10000
    }
  ],
  "postconditions": [
    { "assert": "element_exists", "target": "canvas.step_title", "name_contains": "${step_name}", "timeout_ms": 5000 }
  ],
  "on_fail": "stop_and_report",
  "tags": ["flow", "step", "condition", "wait"]
}
