{
  "schema": "vm-plan/1",
  "id": "comm-delete",
  "title": "删除一条通讯连接",
  "version": "1.0.0",
  "risk": "high",
  "description": "删除会丢连接参数与扫描组；其下变量保留为离线定义并停止采集。",
  "params": {
    "connection_name": {
      "type": "string",
      "required": true,
      "example": "PLC1"
    }
  },
  "preconditions": [
    {
      "assert": "process_running",
      "process": "VisionMaster"
    },
    {
      "assert": "window",
      "target": "app.main"
    },
    {
      "assert": "text_absent",
      "text": "运行中"
    }
  ],
  "steps": [
    {
      "n": 1,
      "do": "click",
      "target": "app.menu.root",
      "expect": {
        "element": "app.menu.system",
        "state": "visible"
      },
      "timeout_ms": 3000
    },
    {
      "n": 2,
      "do": "click",
      "target": "app.menu.system",
      "expect": {
        "element": "app.menu.system.hardware",
        "state": "visible"
      },
      "timeout_ms": 3000
    },
    {
      "n": 3,
      "do": "click",
      "target": "app.menu.system.hardware",
      "expect": {
        "window": "dialog.hardware",
        "state": "visible"
      },
      "timeout_ms": 5000
    },
    {
      "n": 4,
      "do": "click",
      "target": "dialog.hardware.tab_comm"
    },
    {
      "n": 5,
      "do": "click",
      "target": "dialog.hardware.row",
      "target_name": "${connection_name}"
    },
    {
      "n": 6,
      "do": "click",
      "target": "dialog.hardware.comm_delete_row",
      "expect": {
        "window": "dialog.conn_delete",
        "state": "visible"
      },
      "timeout_ms": 5000
    },
    {
      "n": 7,
      "do": "click",
      "target": "dialog.conn_delete.ok",
      "expect": {
        "window": "dialog.conn_delete",
        "state": "closed"
      },
      "timeout_ms": 5000
    },
    {
      "n": 8,
      "do": "assert",
      "assert": "element_absent",
      "target": "dialog.hardware.row",
      "name_contains": "${connection_name}",
      "timeout_ms": 5000
    }
  ],
  "postconditions": [
    {
      "assert": "element_absent",
      "target": "dialog.hardware.row",
      "name_contains": "${connection_name}"
    }
  ],
  "on_fail": "stop_and_report",
  "tags": ["comm", "delete"]
}
