{
  "schema": "vm-plan/1",
  "id": "run-loop",
  "title": "循环运行主流程",
  "version": "1.0.0",
  "risk": "medium",
  "description": "循环运行 Role=Main 的流程，直到点「停止」。工位/子流程不参与批量启动。",
  "params": {},
  "preconditions": [
    { "assert": "process_running", "process": "VisionMaster" },
    { "assert": "window", "target": "app.main" }
  ],
  "steps": [
    {
      "n": 1,
      "do": "key",
      "keys": "Ctrl+1",
      "expect": { "element": "runbar.run_loop", "state": "enabled" },
      "timeout_ms": 3000
    },
    {
      "n": 2,
      "do": "click",
      "target": "runbar.run_loop",
      "expect": { "element": "runbar.stop", "state": "enabled" },
      "timeout_ms": 5000
    },
    {
      "n": 3,
      "do": "assert",
      "assert": "toast_contains",
      "text": "连续运行",
      "timeout_ms": 5000
    }
  ],
  "postconditions": [
    { "assert": "text_exists", "text": "循环运行中", "timeout_ms": 5000 }
  ],
  "on_fail": "stop_and_report",
  "tags": ["run", "loop", "main-flow"]
}
