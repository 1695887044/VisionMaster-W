{
  "schema": "vm-plan/1",
  "id": "camera-delete",
  "title": "删除一台相机配置",
  "version": "1.0.0",
  "risk": "high",
  "description": "删除立即断开运行态连接；配置随方案保存才长期生效。",
  "params": {
    "camera_name": {
      "type": "string",
      "required": true,
      "example": "Cam1"
    }
  },
  "preconditions": [
    {
      "assert": "process_running",
      "process": "VisionMaster"
    },
    {
      "assert": "window",
      "target": "app.main"
    }
  ],
  "steps": [
    {
      "n": 1,
      "do": "click",
      "target": "app.menu.root",
      "expect": {
        "element": "app.menu.system",
        "state": "visible"
      },
      "timeout_ms": 3000
    },
    {
      "n": 2,
      "do": "click",
      "target": "app.menu.system",
      "expect": {
        "element": "app.menu.system.hardware",
        "state": "visible"
      },
      "timeout_ms": 3000
    },
    {
      "n": 3,
      "do": "click",
      "target": "app.menu.system.hardware",
      "expect": {
        "window": "dialog.hardware",
        "state": "visible"
      },
      "timeout_ms": 5000
    },
    {
      "n": 4,
      "do": "click",
      "target": "dialog.hardware.tab_camera"
    },
    {
      "n": 5,
      "do": "click",
      "target": "dialog.hardware.row",
      "target_name": "${camera_name}"
    },
    {
      "n": 6,
      "do": "click",
      "target": "dialog.hardware.camera_delete",
      "expect": {
        "window": "dialog.camera_delete",
        "state": "visible"
      },
      "timeout_ms": 5000
    },
    {
      "n": 7,
      "do": "click",
      "target": "dialog.camera_delete.ok",
      "expect": {
        "window": "dialog.camera_delete",
        "state": "closed"
      },
      "timeout_ms": 5000
    },
    {
      "n": 8,
      "do": "assert",
      "assert": "element_absent",
      "target": "dialog.hardware.row",
      "name_contains": "${camera_name}",
      "timeout_ms": 5000
    }
  ],
  "postconditions": [
    {
      "assert": "element_absent",
      "target": "dialog.hardware.row",
      "name_contains": "${camera_name}"
    }
  ],
  "on_fail": "stop_and_report",
  "tags": ["camera", "delete"]
}
