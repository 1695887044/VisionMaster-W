{
  "schema": "vm-plan/1",
  "id": "run-once",
  "title": "运行主流程一次",
  "version": "1.0.0",
  "risk": "medium",
  "description": "只运行 Role=Main 的流程；工位/子流程由主流程调用。运行条在组态/运行模式下是隐藏的，先切到调试模式。",
  "params": {},
  "preconditions": [
    { "assert": "process_running", "process": "VisionMaster" },
    { "assert": "window", "target": "app.main" }
  ],
  "steps": [
    {
      "n": 1,
      "do": "key",
      "keys": "Ctrl+1",
      "expect": { "element": "runbar.run_once", "state": "enabled" },
      "timeout_ms": 3000
    },
    {
      "n": 2,
      "do": "click",
      "target": "runbar.run_once",
      "expect": { "element": "runbar.stop", "state": "enabled" },
      "timeout_ms": 1500,
      "on_fail": "continue",
      "note": "流程可能在断言前就跑完；停止按钮变灰不算失败，以启动提示为准"
    },
    {
      "n": 3,
      "do": "assert",
      "assert": "toast_contains",
      "text": "已启动",
      "timeout_ms": 5000
    }
  ],
  "postconditions": [
    { "assert": "toast_contains", "text": "已启动", "timeout_ms": 5000 }
  ],
  "on_fail": "stop_and_report",
  "tags": ["run", "main-flow"]
}
