{
  "schema": "vm-plan/1",
  "id": "solution-save",
  "title": "保存已落盘的方案（直接写回）",
  "version": "1.1.0",
  "risk": "low",
  "description": "已符合「<位置>/<方案名>/<方案名>.vms」约定的方案直接写回原文件，不弹对话框；从未保存或散装老方案会自动转为「另存为」文件夹选择，此时请改用 solution-save-as。",
  "params": {},
  "preconditions": [
    { "assert": "process_running", "process": "VisionMaster" },
    { "assert": "window", "target": "app.main" }
  ],
  "steps": [
    {
      "n": 1,
      "do": "menu",
      "path": ["app.menu.root", "app.menu.file", "app.menu.file.save"],
      "note": "已落盘方案不弹对话框；未落盘会打开文件夹选择框，本计划会等待超时",
      "timeout_ms": 5000
    },
    {
      "n": 2,
      "do": "assert",
      "assert": "toast_contains",
      "text": "已保存到",
      "timeout_ms": 20000
    }
  ],
  "on_fail": "stop_and_report",
  "tags": ["solution", "save"]
}
