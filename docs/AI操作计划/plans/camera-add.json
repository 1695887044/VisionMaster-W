{
  "schema": "vm-plan/1",
  "id": "camera-add",
  "title": "新增一台相机",
  "version": "1.1.0",
  "risk": "medium",
  "description": "硬件管理 → 相机 → 添加相机（内联表单）→ 驱动类型/序列号/显示名 → 添加。内联表单的 TextBox 没有 AutomationName，走键盘 Tab 顺序。",
  "params": {
    "driver": {
      "type": "string",
      "required": true,
      "example": "虚拟相机",
      "description": "下拉里的驱动显示名，取决于已加载的相机驱动插件"
    },
    "serial": {
      "type": "string",
      "required": true,
      "example": "CAM-001"
    },
    "display_name": {
      "type": "string",
      "required": false,
      "default": "",
      "example": "上相机"
    }
  },
  "preconditions": [
    { "assert": "process_running", "process": "VisionMaster" },
    { "assert": "window", "target": "app.main" },
    { "assert": "text_absent", "text": "未加载方案", "timeout_ms": 3000 }
  ],
  "steps": [
    {
      "n": 1,
      "do": "menu",
      "path": ["app.menu.root", "app.menu.system", "app.menu.system.hardware"],
      "expect": { "window": "dialog.hardware", "state": "visible" },
      "timeout_ms": 8000
    },
    {
      "n": 2,
      "do": "click",
      "target": "dialog.hardware.tab_camera",
      "expect": { "element": "dialog.hardware.add_camera", "state": "enabled" },
      "timeout_ms": 3000
    },
    {
      "n": 3,
      "do": "click",
      "target": "dialog.hardware.add_camera",
      "expect": { "element": "dialog.camera.driver", "state": "visible" },
      "timeout_ms": 3000
    },
    {
      "n": 4,
      "do": "click",
      "target": "dialog.camera.driver",
      "expect": { "element": "dialog.camera.driver", "state": "enabled" },
      "timeout_ms": 3000
    },
    {
      "n": 5,
      "do": "select",
      "target": "dialog.camera.driver",
      "text": "${driver}"
    },
    {
      "n": 6,
      "do": "key",
      "keys": "Tab",
      "note": "焦点从驱动下拉移到序列号输入框"
    },
    {
      "n": 7,
      "do": "type_focused",
      "text": "${serial}"
    },
    {
      "n": 8,
      "do": "key",
      "keys": "Tab",
      "note": "焦点从序列号移到显示名"
    },
    {
      "n": 9,
      "do": "type_focused",
      "text": "${display_name}"
    },
    {
      "n": 10,
      "do": "click",
      "target": "dialog.camera.add",
      "expect": { "element": "dialog.hardware.row", "name_contains": "${serial}", "state": "exists" },
      "timeout_ms": 5000
    },
    {
      "n": 11,
      "do": "click",
      "target": "dialog.hardware.close",
      "expect": { "window": "dialog.hardware", "state": "closed" },
      "timeout_ms": 10000
    }
  ],
  "postconditions": [
    { "assert": "window_closed", "window": "dialog.hardware", "timeout_ms": 5000 }
  ],
  "on_fail": "stop_and_report",
  "tags": ["camera", "hardware", "create", "keyboard"]
}
