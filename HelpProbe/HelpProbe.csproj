<Project Sdk="Microsoft.NET.Sdk">

  <!--
    帮助系统离屏探针（一次性验收工具，不入交付产物）：
      · 走真实链路 —— PluginService 扫描 Modules\ + HelpCatalogService 合并目录；
      · 把真实 HelpView + HelpViewModel 渲染成 PNG，用于人工看效果与回归对照。
    为什么不在 UIThemeSmokeTest 里加一个模式：那个工程是"主题/控件"的守门人，
    帮助列表属于应用功能，混进去会让那道闸的失败原因变得不纯。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HelpProbe</AssemblyName>
    <RootNamespace>HelpProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VisionMaster\VisionMaster.csproj" />
  </ItemGroup>

</Project>
