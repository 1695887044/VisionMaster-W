<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WPF_Demo">
    <!--  轻量操作小按钮  -->
    <Style x:Key="ParamActionBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F2F6FC" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:BindableParamBox}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BindableParamBox}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!--  1. 参数标题栏 (固定宽度对齐)  -->
                            <ColumnDefinition Width="70" />
                            <!--  2. 类型标签  -->
                            <ColumnDefinition Width="38" />
                            <!--  3. 输入与展示核心区 (自适应宽度，限制最大宽度)  -->
                            <ColumnDefinition Width="Auto" />
                            <!--  4. 操作图标区 (紧贴输入框)  -->
                            <ColumnDefinition Width="Auto" />
                            <!--  5. 剩余空间填充  -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  1. 参数名称  -->
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#303133"
                            Text="{TemplateBinding Label}" />

                        <!--  2. 类型徽标 (INT/DBL/ENUM)  -->
                        <Border
                            Grid.Column="1"
                            Padding="3,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#F2F4F7"
                            CornerRadius="3">
                            <TextBlock
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#909399"
                                Text="{TemplateBinding DataTypeBadge}" />
                        </Border>

                        <!--  3. 输入与动态插槽区  -->
                        <Grid
                            Grid.Column="2"
                            Width="200"
                            Margin="6,0,6,0"
                            VerticalAlignment="Center">
                            <!--  状态 A: 手动输入插槽（由外部控件承载）  -->
                            <Border x:Name="PART_ManualContent" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center" ContentSource="Content" />
                            </Border>

                            <!--  状态 B: 上游数据绑定胶囊  -->
                            <Border
                                x:Name="PART_LinkedCapsule"
                                Height="24"
                                MinWidth="140"
                                Padding="6,0"
                                Background="#ECF5FF"
                                BorderBrush="#D9ECFF"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="Collapsed">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="#409EFF"
                                        Text="🔗 " />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#409EFF"
                                        Text="{TemplateBinding SourcePath}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!--  4. 右侧操作区 (连线 & 断开)  -->
                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                x:Name="LinkBtn"
                                Command="{TemplateBinding LinkCommand}"
                                Style="{StaticResource ParamActionBtn}"
                                ToolTip="绑定上游变量">
                                <Path
                                    x:Name="LinkPath"
                                    Width="12"
                                    Height="12"
                                    Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                                    Fill="#909399"
                                    Stretch="Uniform" />
                            </Button>

                            <Button
                                x:Name="PART_UnlinkBtn"
                                Margin="2,0,0,0"
                                Style="{StaticResource ParamActionBtn}"
                                ToolTip="解除绑定">
                                <Path
                                    x:Name="UnlinkPath"
                                    Width="10"
                                    Height="10"
                                    Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"
                                    Fill="#C0C4CC"
                                    Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLinked" Value="True">
                            <Setter TargetName="PART_ManualContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_LinkedCapsule" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LinkPath" Property="Fill" Value="#409EFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>