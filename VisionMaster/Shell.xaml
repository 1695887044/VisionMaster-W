                                ui:MenuItemEx.Tone="Indigo">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf15b;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.BrowseList}"
