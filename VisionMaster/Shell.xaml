                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_FlowCanvasView"
                                Header="流程画布"
                                ui:MenuItemEx.Description="打开流程画布文档"
                                ui:MenuItemEx.Tone="Indigo">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf5cb;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaEditorView"
                                Header="组态画面"
                                ui:MenuItemEx.Description="打开组态画面文档"
                                ui:MenuItemEx.Tone="Indigo">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf1fc;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaToolboxView"
