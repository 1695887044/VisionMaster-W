<Window
    x:Class="VisionMaster.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:commands="clr-namespace:VisionMaster.Commands"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:shell="clr-namespace:VisionMaster"
    xmlns:ui="http://schemas.UI.com/ui"
    xmlns:views="clr-namespace:VisionMaster.Views"
    Title="VisionMaster"
    Width="1280"
    Height="860"
    MinWidth="1120"
    MinHeight="680"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ui:WindowExtensions.IsAutoWireCommands="True"
    PreviewKeyDown="OnShellPreviewKeyDown"
    Background="{StaticResource DialogSurfaceBrush}"
    FontFamily="Microsoft YaHei"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            CornerRadius="1"
            GlassFrameThickness="1"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!--  标题栏图标按钮（高频操作驻留）  -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            x:Name="Bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                            </Trigger>
                            <!--  禁用态（Command.CanExecute=false 自动触发）：半透明置灰 + 取消手型，让互锁"看得见"  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  标题栏分隔线  -->
        <Style x:Key="TitleSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource DialogBorderBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!--  工作模式分段按钮：调试 / 运行 / 组态 / 自由  -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeButtonDebug" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Debug}">
                    <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeButtonRun" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Run}">
                    <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeButtonConfig" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Config}">
                    <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeButtonFree" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Free}">
                    <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  运行条按钮：文字 + 图标位，和标题栏的图标按钮区分开  -->
        <Style x:Key="RunBarButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  活动栏开关（VS Code 式，左侧强调条指示）  -->
        <Style x:Key="ActivityToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!--  左侧强调指示条  -->
                            <Border
                                x:Name="Indicator"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{StaticResource DialogAccentBrush}"
                                CornerRadius="0,2,2,0"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  活动栏动作按钮（打开对话框类）  -->
        <Style x:Key="ActivityAction" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  状态栏可点项（设计基线 docs/UI设计基线/app-shell-chrome：24px 命中区 / 6px 圆角 / hover 灰底）  -->
        <Style x:Key="StatusBarItemButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  状态栏分隔块：1px × 14px（设计稿用它取代 TextBlock "|"）  -->
        <Style x:Key="StatusBarSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Fill" Value="{StaticResource DialogBorderBrush}" />
        </Style>

        <!--  系统资源浮窗里的进度条：4px 高、轨道浅灰、填充主色（只在这个浮窗里用）  -->
        <Style x:Key="PerfBarStyle" TargetType="ProgressBar">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="2">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Fill="{TemplateBinding Foreground}"
                                    RadiusX="2"
                                    RadiusY="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!--  DWV 第 1 期快捷键（窗口级）：F9 切换断点、F5 继续。
              F10（单步）不走这里 —— WPF Menu 会把 F10 当"菜单激活键"消费，
              改在 Shell.xaml.cs 的 PreviewKeyDown 里截获（见 OnShellPreviewKeyDown 注释）。  -->
        <KeyBinding Key="F9" Command="{Binding ToggleBreakpointOnCurrentStepCommand}" />
        <KeyBinding
            Key="F5"
            Command="{Binding ExecutionCommand}"
            CommandParameter="{x:Static local:ExecutionAction.Resume}" />
        <KeyBinding
            Key="D1"
            Modifiers="Control"
            Command="{Binding SetShellModeCommand}"
            CommandParameter="Debug" />
        <KeyBinding
            Key="D2"
            Modifiers="Control"
            Command="{Binding SetShellModeCommand}"
            CommandParameter="Run" />
        <KeyBinding
            Key="D3"
            Modifiers="Control"
            Command="{Binding SetShellModeCommand}"
            CommandParameter="Config" />
        <KeyBinding
            Key="D4"
            Modifiers="Control"
            Command="{Binding SetShellModeCommand}"
            CommandParameter="Free" />
        <KeyBinding
            Key="A"
            Modifiers="Control+Alt"
            Command="{Binding OpenProjectAssetsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!--  底部控制台抽屉条（收起态 32px）。行高 Auto：抽屉条自己折叠时这一行归零  -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <ui:OverlayHost />

        <!--  ============ 命令面板（Ctrl+K） ============  -->
        <!--  放在 OverlayHost 之后、标题栏之前：覆盖整个窗口，不改变停靠树。  -->
        <Grid
            x:Name="CommandPaletteOverlay"
            Grid.RowSpan="5"
            Panel.ZIndex="200"
            IsVisibleChanged="CommandPaletteOverlay_IsVisibleChanged"
            Visibility="{Binding IsCommandPaletteOpen, Converter={ui:BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource DialogScrimBrush}" MouseDown="CommandPaletteScrim_MouseDown" />
            <Border
                Width="640"
                MaxHeight="480"
                Margin="0,96,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="24"
                        Opacity="0.18"
                        ShadowDepth="6" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="CommandPaletteBox"
                        Margin="16,10"
                        Padding="10,0"
                        VerticalContentAlignment="Center"
                        Background="{StaticResource DialogInputBackgroundBrush}"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="1"
                        FontSize="13"
                        KeyDown="CommandPaletteBox_KeyDown"
                        Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="输入流程、视图或命令名称；↑↓ 选择，Enter 执行，Esc 关闭" />
                    <ListBox
                        x:Name="CommandPaletteList"
                        Grid.Row="1"
                        Margin="8,0,8,8"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding CommandPaletteItems}"
                        MouseDoubleClick="CommandPaletteList_MouseDoubleClick"
                        SelectedItem="{Binding SelectedCommandPaletteItem}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="ItemBorder"
                                                Padding="10,8"
                                                Background="Transparent"
                                                CornerRadius="7">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="14"
                                        Foreground="{StaticResource DialogAccentBrush}"
                                        Text="{Binding Glyph}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock
                        Grid.Row="1"
                        Margin="16,12"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="没有匹配的流程、视图或命令"
                        Visibility="{Binding CommandPaletteEmptyVisibility}" />
                </Grid>
            </Border>
        </Grid>

        <!--  ============ 单行标题栏（VS Code 式） ============  -->
        <Grid Background="{StaticResource DialogSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <!--  ☰ 菜单（完整菜单树折叠于此）  -->
                <Menu
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Menu.Resources>
                        <!--  ==========================================  -->
                        <!--  📁 「文件」子菜单（设计稿 C：标题区 + 双行说明 + 页脚）  -->
                        <!--  只挂给「文件」这一项；其余顶级菜单与竖排菜单行保持原样。  -->
                        <!--  可见宽 360 = Popup 内 Border 的 Width；外圈 Margin 10 留给投影。  -->
                        <!--  ==========================================  -->
                        <Style x:Key="MenuFlyoutStyle" TargetType="MenuItem">
                            <Setter Property="Padding" Value="12,8,24,8" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border
                                            x:Name="Row"
                                            Margin="2"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="8,0" VerticalAlignment="Center" ContentSource="Icon" />
                                                <ContentPresenter
                                                    Grid.Column="1"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="Center"
                                                    ContentSource="Header" />
                                                <ContentPresenter
                                                    Grid.Column="2"
                                                    Margin="16,0,8,0"
                                                    VerticalAlignment="Center"
                                                    ContentSource="InputGestureText"
                                                    TextElement.Foreground="#888888" />
                                                <Path
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Data="M 0 0 L 4 4 L 0 8"
                                                    IsHitTestVisible="False"
                                                    Stroke="#888888"
                                                    StrokeThickness="1.5" />
                                                <Popup
                                                    x:Name="PART_Popup"
                                                    AllowsTransparency="True"
                                                    Focusable="False"
                                                    IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                    Placement="Right"
                                                    PopupAnimation="Fade">
                                                    <Border
                                                        Width="360"
                                                        Margin="10"
                                                        Background="{StaticResource ScadaSurfaceBrush}"
                                                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="16">
                                                        <Border.Effect>
                                                            <DropShadowEffect
                                                                BlurRadius="28"
                                                                Direction="270"
                                                                Opacity="0.18"
                                                                ShadowDepth="6"
                                                                Color="Black" />
                                                        </Border.Effect>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <!--  标题区：图标 / 标题 / 一句说明由 ui:MenuItemEx 提供（每支菜单各配一次）。  -->
                                                            <StackPanel
                                                                x:Name="Header"
                                                                Grid.Row="0"
                                                                Margin="9,9,9,10"
                                                                Orientation="Horizontal">
                                                                <Border
                                                                    Width="32"
                                                                    Height="32"
                                                                    Background="{StaticResource ScadaAccentSoftBrush}"
                                                                    CornerRadius="9">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource Icon}"
                                                                        FontSize="16"
                                                                        Foreground="{StaticResource DialogAccentBrush}"
                                                                        Text="{Binding Path=(ui:MenuItemEx.FlyoutIcon), RelativeSource={RelativeSource TemplatedParent}}" />
                                                                </Border>
                                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        FontFamily="Microsoft YaHei"
                                                                        FontSize="13"
                                                                        FontWeight="Medium"
                                                                        Foreground="{StaticResource ScadaTextBrush}"
                                                                        Text="{Binding Path=(ui:MenuItemEx.FlyoutTitle), RelativeSource={RelativeSource TemplatedParent}}" />
                                                                    <TextBlock
                                                                        FontFamily="Microsoft YaHei"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                                                        Text="{Binding Path=(ui:MenuItemEx.FlyoutDescription), RelativeSource={RelativeSource TemplatedParent}}" />
                                                                </StackPanel>
                                                            </StackPanel>
