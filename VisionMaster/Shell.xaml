                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf187;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MenuFlyoutSeparatorStyle}" />
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.HardwareSettings}"
                                Header="硬件管理"
                                ui:MenuItemEx.Description="相机、通讯与运动卡"
                                ui:MenuItemEx.Tone="Slate">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf2db;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.SystemSettings}"
                                Header="系统设置"
                                ui:MenuItemEx.Description="软件级参数设置"
                                ui:MenuItemEx.Tone="Slate">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf1de;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.ReturnToZero}"
                                Header="回零"
                                ui:MenuItemEx.Description="全部轴回到原点"
                                ui:MenuItemEx.Tone="Amber">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf015;" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>

                        <MenuItem
                            Header="帮助(H)"
                            FontFamily="Microsoft YaHei"
                            Style="{StaticResource MenuFlyoutStyle}"
                            ui:MenuItemEx.FlyoutDescription="文档与版本信息"
                            ui:MenuItemEx.FlyoutIcon="&#xf059;"
                            ui:MenuItemEx.FlyoutTitle="帮助">
                            <MenuItem.Resources>
                                <Style BasedOn="{StaticResource MenuFlyoutItemStyle}" TargetType="MenuItem" />
                            </MenuItem.Resources>
                            <MenuItem
                                Header="激活（未实现）"
                                IsEnabled="False"
                                ui:MenuItemEx.Description="功能尚未实现"
                                ui:MenuItemEx.Tone="Gray">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf084;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="建议及反馈（未实现）"
                                IsEnabled="False"
                                ui:MenuItemEx.Description="功能尚未实现"
                                ui:MenuItemEx.Tone="Gray">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf4ad;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.Help}"
                                Header="帮助文档"
                                ui:MenuItemEx.Description="打开插件帮助手册"
                                ui:MenuItemEx.Tone="Slate">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf02d;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource MenuFlyoutSeparatorStyle}" />
                            <MenuItem
                                Header="关于（未实现）"
                                IsEnabled="False"
                                ui:MenuItemEx.Description="功能尚未实现"
                                ui:MenuItemEx.Tone="Gray">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf05a;" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!--  文件操作  -->
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Create}"
                    Content="&#xf15b;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="新建方案" />
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Open}"
                    Content="&#xf07c;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="打开方案" />
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Save}"
                    Content="&#xf0c7;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="保存方案" />

                <Rectangle Style="{StaticResource TitleSeparator}" />

                <!--  工作模式：一个 24px 容器 + 4 段；选中用单一强调色（v2 设计）  -->
                <Border
                    Height="24"
                    Padding="2"
                    VerticalAlignment="Center"
                    Background="{StaticResource DialogRowHoverBrush}"
                    CornerRadius="6"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Command="{Binding SetShellModeCommand}"
                            CommandParameter="Debug"
                            Content="调试"
                            Style="{StaticResource ModeButtonDebug}"
                            ToolTip="调试：视觉图像 + 流程画布 + 步骤/工具箱（Ctrl+1）" />
                        <Button
                            Command="{Binding SetShellModeCommand}"
                            CommandParameter="Run"
                            Content="运行"
                            Style="{StaticResource ModeButtonRun}"
                            ToolTip="运行：全宽运行驾驶舱 + 图像 + KPI（Ctrl+2）" />
                        <Button
                            Command="{Binding SetShellModeCommand}"
                            CommandParameter="Config"
                            Content="组态"
                            Style="{StaticResource ModeButtonConfig}"
                            ToolTip="组态：仅组态画面 + 属性/图层/图元（Ctrl+3）" />
                        <Button
                            Command="{Binding SetShellModeCommand}"
                            CommandParameter="Free"
                            Content="自由"
                            Style="{StaticResource ModeButtonFree}"
                            ToolTip="自由：全部面板与文档（Ctrl+4）" />
                    </StackPanel>
                </Border>

                <Rectangle Style="{StaticResource TitleSeparator}" />

                <!--  全局命令：原来挂在左侧活动栏底部，2026-10-15 上移到顶栏。  -->
                <!--  为什么上移：活动栏按"图标与落点同侧"拆成左右两条后，左条只该放左侧面板的开关；  -->
                <!--  这两个是命令（没有面板落点，点了弹窗），混在竖条里语义不对——顶栏本就是全局命令区。  -->
                <Button
                    Command="{Binding OpenCommandPaletteCommand}"
                    Content="&#xf002;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="搜索流程 / 视图 / 命令（Ctrl+K）" />
                <Button
                    Command="{Binding SystemCommand}"
                    CommandParameter="{x:Static local:SystemAction.GlobalVariables}"
                    Content="&#xf121;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="全局变量" />
                <Button
                    Command="{Binding SystemCommand}"
                    CommandParameter="{x:Static local:SystemAction.HardwareSettings}"
                    Content="&#xf2db;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="硬件管理" />
                <!--  配方入口：与全局变量/硬件管理同属顶栏全局命令区（R47）。
                      不放标题栏中央：那里只显示"当前方案是谁"，不承担命令。  -->
                <Button
                    Command="{Binding Recipe.OpenManagerCommand}"
                    Content="&#xf0ca;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="{Binding Recipe.ChipToolTip}" />
            </StackPanel>

            <!--  居中：当前方案名  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                    Text="&#xf07b;">
                    <TextBlock.FontFamily>
                        <StaticResource ResourceKey="Icon" />
                    </TextBlock.FontFamily>
                </TextBlock>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource ScadaTextBrush}"
                    Text="{Binding Workspace.CurrentSolution.SolutionName, TargetNullValue='未加载方案', FallbackValue='未加载方案'}"
                    ToolTip="当前正在运行的视觉解决方案" />
            </StackPanel>

            <!--  窗口控制按钮  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Height="36"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    Content="M 0 5 L 10 5"
                    Style="{StaticResource WindowControlButton}" />
                <Button
                    x:Name="BtnMaximize"
                    Height="36"
                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                    Content="M 0 0 H 10 V 10 H 0 Z"
                    Style="{StaticResource WindowControlButton}" />
                <Button
                    Height="36"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    Content="M 0 0 L 10 10 M 0 10 L 10 0"
                    Style="{StaticResource WindowControlButton}"
                    Tag="Close" />
            </StackPanel>

            <!--  v2：底部 1px 边界，与 48px 运行条分开  -->
            <Rectangle
                Grid.ColumnSpan="3"
                Height="1"
                VerticalAlignment="Bottom"
                Fill="{StaticResource DialogBorderBrush}"
                IsHitTestVisible="False" />
        </Grid>

        <!--  ============ 运行条（48px）：状态 + 编译/运行/暂停/单步/停止 ============  -->
        <Border
            x:Name="RunBar"
            Grid.Row="1"
            Height="48"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Config}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Run}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                        Width="9"
                        Height="9"
                        VerticalAlignment="Center"
                        Fill="{Binding RunStateBrush}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding RunStateBrush}"
                        Text="{Binding RunStateText}" />
                    <!--  绑 RunBarFlowText 而不是「当前流程名」：本仓允许多条流程并跑（单流程 / HTTP / 定时触发各开各的会话），
                          只显示选中项会出现"两条在跑、条上只写一条"，写的那条还可能根本没在跑（2026-10-20 真机）。
                          0 条在跑时它回落到当前流程，1 条报那一条，多条报「A 等 N 个流程」，完整名单在悬停提示里。  -->
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="{Binding RunBarFlowText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding RunBarFlowToolTip}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Compile}"
                        Content="编译"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="流程编译" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.RunOnce}"
                        Content="启动整线"
                        Foreground="{StaticResource DialogSuccessBrush}"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="单次启动所有勾选「随整线启动」的流程：各起各的会话，互不阻塞；一条都没勾时提示先去「流程管理」勾「整线」" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.RunContinuous}"
                        Content="整线循环"
                        Foreground="{StaticResource DialogSuccessBrush}"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="循环启动所有勾选「随整线启动」的流程：各起各的会话，一条出问题只停它自己；一条都没勾时提示先去「流程管理」勾「整线」" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Pause}"
                        Content="暂停"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="暂停（全部运行中的调试会话）" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Resume}"
                        Content="继续"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="继续（F5）" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.StepOnce}"
                        Content="单步"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="单步（F10）" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Stop}"
                        Content="停止"
                        Foreground="{StaticResource DialogDangerBrush}"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="停止" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource ScadaFaintTextBrush}"
                    Text="F5 继续 · F10 单步" />
            </Grid>
        </Border>

        <!--  ============ 主体：停靠区（活动栏已于 2026-10-15 整条下线） ============  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  停靠区（FluentLight 主题在代码后台应用）  -->
            <avalonDock:DockingManager
                x:Name="dockManager"
                Grid.Column="0"
                AllowMixedOrientation="True"
                AutoWindowSizeWhenOpened="True"
                IsVirtualizingAnchorable="True"
                IsVirtualizingDocument="True">
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">

                        <!--  1. 左侧栏：流程导航（流程胶囊 + 当前流程树）  -->
                        <!--  v2 把原来的“程序”窗格并入 ProcessView 顶部：两者表达同一棵 Solution → Flow → Steps，  -->
                        <!--  再拆两个窗格只会让矮的程序列表白占高度。宽度 340 / 最小 320：  -->
                        <!--  组头要同时放“类型标签 + 实例名 + N 分支 · M 算子 + 状态图标”。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="340" DockMinWidth="320">
                            <avalonDock:LayoutAnchorable
                                Title="流程导航"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ProcessView">
                                <views:ProcessView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!--  2. 中央工作区：流程画布 / 视觉图像 / 组态画面（文档标签，可拆分/浮动）  -->
                        <!--  流程画布为什么从左侧栏搬到这里：它是节点编辑器的主工作区，面积需求与视觉图像同级，  -->
                        <!--  而原来跟流程栏挤在 17* 宽的同一列里做标签页——同一时刻只能看见一个，  -->
                        <!--  等于"要么看树、要么看画布"，两件事本来是要对照着做的。  -->
                        <!--  默认选中仍是「视觉图像」（IsSelected=True 在它身上）：画布是编辑入口，但启动视角  -->
                        <!--  先给实时图像，避免每次开软件都先看到一张空白画布。  -->
                        <avalonDock:LayoutPanel Orientation="Vertical" DockWidth="70*">
                            <avalonDock:LayoutDocumentPane>
                                <!--  IsSelected 是必要的：一个 pane 里有多个文档时，默认激活哪一个不保证是第一个，  -->
                                <!--  不写这一行就可能让"组态画面"抢走启动时的前台标签，改变现有用户的默认视角。  -->
                                <avalonDock:LayoutDocument
                                    Title="视觉图像"
                                    CanClose="False"
                                    ContentId="Panel_ImageView"
                                    IsSelected="True">
                                    <views:ImageView />
                                </avalonDock:LayoutDocument>
                                <!--  流程节点画布：与视觉图像同为中央文档区，可拖出成分屏对照着调  -->
                                <avalonDock:LayoutDocument
                                    Title="流程画布"
                                    CanClose="False"
                                    ContentId="Panel_FlowCanvasView">
                                    <views:FlowCanvasView />
                                </avalonDock:LayoutDocument>
                                <!--  组态画面编辑器：与视觉图像同为中央文档区，可拖出成分屏对照着调画面  -->
                                <avalonDock:LayoutDocument
                                    Title="组态画面"
                                    CanClose="False"
                                    ContentId="Panel_ScadaEditorView">
                                    <views:ScadaEditorView />
                                </avalonDock:LayoutDocument>
                                <avalonDock:LayoutDocument
                                    Title="运行驾驶舱"
                                    CanClose="False"
                                    ContentId="Panel_RunCockpitView">
                                    <views:RunCockpitView />
                                </avalonDock:LayoutDocument>
                            </avalonDock:LayoutDocumentPane>

                            <!--  3. 底部面板组：控制台（日志 / 监控栏）两个标签，可整体隐藏  -->
                            <!--  收起态由 Shell 根 Grid 的 ConsoleDrawerBar 承载：
                                  为什么不能把抽屉头放进这个面板的内容里 —— AvalonDock 4.74 的
                                  LayoutAnchorablePane 没有 ShowHeader，面板在树里就一定画自己的页签条，
                                  自定义头会被它挤没。详见交接报告 2026-10-26 §7。  -->
                            <avalonDock:LayoutAnchorablePane DockHeight="200">
                                <avalonDock:LayoutAnchorable
                                    Title="控制台"
                                    CanClose="False"
                                    CanHide="False"
                                    CanFloat="False"
                                    ContentId="Panel_LogView">
                                    <views:LogView />
                                </avalonDock:LayoutAnchorable>
                                <avalonDock:LayoutAnchorable
                                    Title="监控栏"
                                    CanClose="False"
                                    CanHide="False"
                                    CanFloat="False"
                                    ContentId="Panel_MonitorView">
                                    <views:MonitorView />
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutPanel>

                        <!--  4. 右侧单列检查器：属性 / 图层 / 工具箱 / 图元工具箱共用一列 300。
                              v2 把原来的属性 260 + 图层 240 + 工具箱 260 三列收成一列；
                              模式只决定哪些标签可见，不再用不同列宽占掉中央画布。
                              300 取设计稿 ≤1500px 视口的检查器值（当前窗口约 1310）；320 是 ≥1500 的值。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="300" DockMinWidth="300">
                            <avalonDock:LayoutAnchorable
                                Title="属性"
                                AutoHideWidth="300"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ScadaPropertyView">
                                <views:ScadaPropertyView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="图层"
                                AutoHideWidth="300"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ScadaLayerView">
                                <views:ScadaLayerView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="工具箱"
                                AutoHideWidth="300"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ToolView">
                                <views:ToolView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="图元工具箱"
                                AutoHideWidth="300"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ScadaToolboxView">
                                <views:ScadaToolboxView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>

            <!--  ============ VS 式胶囊轨道（收起的面板贴右边） ============  -->
            <!--  18px 轨道；胶囊 16×48~72（v2.1），点击把面板钉回 300 列。
                  数据来自 ShellViewModel.InspectorCapsules：当前模式本应显示、但用户收起的面板。
                  不写进 AvalonDock 模板：auto-hide 页签是库内部控件，无法稳定拿到实例。  -->
            <Border
                x:Name="InspectorCapsuleRail"
                Width="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Panel.ZIndex="5"
                Background="{StaticResource DialogRowHoverBrush}"
                BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding HasInspectorCapsules, Converter={ui:BooleanToVisibilityConverter}}">
                <ItemsControl Margin="0,6,2,0" ItemsSource="{Binding InspectorCapsules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  用 Button 而不是 Border+MouseBinding：InputBinding 不在可视树里，
                                  RelativeSource 绑定到 ItemsControl.DataContext 解析不到，点了静默无反应。  -->
                            <Button
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="{Binding Title}"
                                Click="OnInspectorCapsuleClick"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="{Binding ToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="Bd"
                                            Width="16"
                                            MinHeight="48"
                                            MaxHeight="72"
                                            Margin="0,0,0,2"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!--  悬停主色竖线：贴页签内侧（左）边，整高 2px  -->
                                                <Border
                                                    x:Name="HoverBar"
                                                    Width="2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Stretch"
                                                    Background="{StaticResource DialogAccentBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <StackPanel
                                                    Margin="0,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="{StaticResource Icon}"
                                                        FontSize="9"
                                                        Foreground="{StaticResource DialogAccentBrush}"
                                                        Text="{Binding Icon}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        HorizontalAlignment="Center"
                                                        FontSize="8"
                                                        FontWeight="Normal"
                                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                        Text="{Binding Title}">
                                                        <TextBlock.LayoutTransform>
                                                            <RotateTransform Angle="-90" />
                                                        </TextBlock.LayoutTransform>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                                <Setter TargetName="HoverBar" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!--  ============ 底部控制台抽屉条（收起态 32px） ============  -->
        <!--
            与 DockingManager 同级、在它下方：收起时面板压到 1px（溢出由 LayoutHelper 裁掉），
            这一条顶上来做"抽屉头"（页签 + 计数 + 最近一条摘要 + 展开箭头）；
            展开时它折叠成 0 高，由面板自己的页签条接管。
            为什么不能覆盖在停靠区上：停靠区横跨左中右三列，覆盖会把流程导航/工具箱的底部也盖住。
            DataContext 由这里显式给，视图内不用 AutoWire（断言宿主没有容器）。
        -->
        <views:ConsoleDrawerBar Grid.Row="3" DataContext="{Binding ConsoleDrawer}" />

        <!--  ============ 状态栏（VS Code 式） ============  -->
        <Border
            Grid.Row="4"
            Background="{StaticResource ScadaTitleBarBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Config}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!--  运行状态指示灯 + 文字（唯一事实来源：ShellViewModel.RunState）  -->
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{Binding RunStateBrush}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{Binding RunStateBrush}"
                        Text="{Binding RunStateText}" />

                    <Button
                        x:Name="FlowScopeChip"
                        Height="22"
                        Margin="8,0,0,0"
                        Padding="8,0"
                        Command="{Binding ShowAllFlowsCommand}"
                        Content="{Binding ScopeText}"
                        Style="{StaticResource StatusBarItemButton}"
                        ToolTip="当前统计范围；点击回到全部" />

                    <Button
                        x:Name="FlowRunningChip"
                        Height="22"
                        Margin="8,0,0,0"
                        Padding="8,0"
                        Background="{StaticResource DialogAccentSoftBrush}"
                        Click="FlowRunningChip_Click"
                        PreviewMouseLeftButtonDown="FlowRunningChip_PreviewMouseLeftButtonDown"
                        Style="{StaticResource StatusBarItemButton}"
                        ToolTip="{Binding FlowStatsToolTip}"
                        ToolTipService.ShowDuration="20000">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogAccentBrush}"
                            Text="{Binding RunningFlowCountText}" />
                    </Button>

                    <TextBlock
                        Margin="10,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <!--  当前登录者胶囊（设计基线 app-shell-chrome）：头像圆 + 「角色 · 用户名」。
                          读的是全局唯一的 ScadaAccessPolicy（App 里注册的单例），权限判定用的也是这一份，
                          所以"状态栏写的"和"实际生效的"不可能不一致。
                          未登录显示灰头像 + 「未登录」而不是空白：让人一眼明白不是软件坏了，是权限就这么多。
                          灰色=未登录 / 蓝色=有人登录着；点一下直接开登录弹窗（比走"系统 → 用户登录"少两步）。  -->
                    <Border
                        x:Name="CurrentUserText"
                        Height="24"
                        Padding="8,0"
                        CornerRadius="6"
                        Cursor="Hand"
                        ToolTip="点击切换用户（也可走 系统 → 用户登录）">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                MouseAction="LeftClick" />
                        </Border.InputBindings>
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding SystemCommand}"
                                    CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                    Header="用户登录" />
                                <MenuItem
                                    Command="{Binding SystemCommand}"
                                    CommandParameter="{x:Static local:SystemAction.UserManagement}"
                                    Header="用户管理"
                                    Visibility="{Binding CanManageUsers, Converter={ui:BooleanToVisibilityConverter}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="16" Height="16" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccessPolicy.IsLoggedIn}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Text="{Binding UserAvatarText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccessPolicy.IsLoggedIn}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding UserDisplayText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccessPolicy.IsLoggedIn}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!--
                        调试模式徽标：只在开启时出现（Visibility 绑 IsDebugModeEnabled）。
                        这是"调试模式没有按时间失效"的唯一可见证据——重启软件后它还在，
                        就说明状态是从 AppConfig.json 读回来的，不是内存里的一次性开关。
                        点击直接进调试面板（与 工具 → 调试面板 同一入口）。
                    -->
                    <Border
                        Height="22"
                        Margin="6,0,0,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource ScadaWarningSoftBrush}"
                        BorderBrush="{StaticResource DialogWarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Cursor="Hand"
                        ToolTip="调试模式已开启（不会自动失效；点击打开调试面板）"
                        Visibility="{Binding IsDebugModeEnabled, Converter={ui:BooleanToVisibilityConverter}}">
                        <Border.InputBindings>
                            <MouseBinding Command="{Binding OpenDebugPanelCommand}" MouseAction="LeftClick" />
                        </Border.InputBindings>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{StaticResource DialogWarningTextBrush}"
                            Text="调试模式" />
                    </Border>
                    <TextBlock
                        Margin="8,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <!--  方案只显名称（设计基线 P0 第 1 条）：全路径进 ToolTip，不再把 400px 宽的一行截成"…综合测试台（测试员版…"  -->
                    <TextBlock FontSize="12" Text="方案" />
                    <TextBlock
                        x:Name="SolutionPathText"
                        MaxWidth="320"
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Text="{Binding Workspace.CurrentSolution.SolutionName, TargetNullValue='未加载', FallbackValue='未加载'}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Workspace.CurrentSolution.SolutionFilePath, TargetNullValue='未加载方案', FallbackValue='未加载方案'}" />
                </StackPanel>

                <!--  组态模式状态：页面/网格/选中图元（不显示流程运行态）  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Config}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource LogicWhileTextBrush}"
                        Text="组态设计" />
                    <TextBlock
                        Margin="8,0"
                        FontSize="12"
                        Foreground="{StaticResource DialogBorderBrush}"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="1280 × 800 · 网格 20 px · 选中图元" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  系统资源（设计基线 docs/UI设计基线/app-shell-chrome）：常驻 CPU + MEM；
                          线程 / 句柄 / GC 堆进浮窗，四组读数不再常年占掉底栏约 1/3 宽度。  -->
                    <Button
                        x:Name="PerfButton"
                        Click="PerfButton_Click"
                        PreviewMouseLeftButtonDown="PerfButton_PreviewMouseLeftButtonDown"
                        Style="{StaticResource StatusBarItemButton}"
                        ToolTip="系统资源（点击查看明细）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource ScadaFaintTextBrush}"
                                Text="CPU" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding CpuUsagePercent, StringFormat={}{0:F1}%}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCpuUsageHigh}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource ScadaFaintTextBrush}"
                                Text="MEM" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding MemoryUsageMB, StringFormat={}{0:F0}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMemoryUsageHigh}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource ScadaFaintTextBrush}"
                                Text="MB" />
                        </StackPanel>
                    </Button>

                    <!--  系统资源浮窗：点底栏 CPU/MEM 打开，点外面自动关（StaysOpen=False）  -->
                    <Popup
                        x:Name="PerfPopup"
                        AllowsTransparency="True"
                        Focusable="False"
                        Placement="Top"
                        PlacementTarget="{Binding ElementName=PerfButton}"
                        PopupAnimation="Fade"
                        StaysOpen="False">
                        <Border
                            Width="268"
                            Margin="10"
                            Padding="8"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="24"
                                    Direction="270"
                                    Opacity="0.16"
                                    ShadowDepth="6"
                                    Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock
                                    Margin="4,2,4,6"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                    Text="系统资源 · 进程" />

                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="CPU" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Style="{StaticResource PerfBarStyle}"
                                        Value="{Binding CpuUsagePercent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Width="62"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding CpuUsagePercent, StringFormat={}{0:F1} %}" />
                                </Grid>

                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="内存（Working Set）" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="1024"
                                        Style="{StaticResource PerfBarStyle}"
                                        Value="{Binding MemoryUsageMB, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Width="62"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding MemoryUsageMB, StringFormat={}{0:F0} MB}" />
                                </Grid>

                                <Grid Height="24">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="线程" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding ThreadCount}" />
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="句柄" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding HandleCount, StringFormat={}{0:N0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHandleCountHigh}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="GC 堆" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding GcHeapMB, StringFormat={}{0:F1} MB}" />
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="LOH" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding LohSizeMB, StringFormat={}{0:F1} MB}"
                                        ToolTip="大对象堆：图像帧都在这里，持续上涨通常意味着图像没释放" />
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="磁盘剩余" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding DiskFreeText}"
                                        ToolTip="{Binding DiskFreeTip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDiskFreeLow}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="运行时长" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding UptimeText}" />
                                </Grid>

                                <Border
                                    Margin="0,4,0,0"
                                    Padding="4,6,2,2"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                        Text="阈值：CPU ≥ 80%、内存 ≥ 1 GB、磁盘剩余 &lt; 5% 时数字变橙；句柄 ≥ 10 000 视为异常。"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!--  工位浮窗：点底栏「N 条在跑」打开；点外面自动关（StaysOpen=False）  -->
                    <Popup
                        x:Name="FlowStatsPopup"
                        AllowsTransparency="True"
                        Focusable="False"
                        Placement="Top"
                        PlacementTarget="{Binding ElementName=FlowRunningChip}"
                        PopupAnimation="Fade"
                        StaysOpen="False">
                        <Border
                            Width="860"
                            Margin="10"
                            Padding="10"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="24"
                                    Direction="270"
                                    Opacity="0.16"
                                    ShadowDepth="6"
                                    Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="2,0,2,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource ScadaTextBrush}"
                                            Text="在跑流程" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            Foreground="{StaticResource ScadaFaintTextBrush}"
                                            Text="只统计生产流程 · Home / End / 调试轮不计入；子程序按工位计入" />
                                    </StackPanel>
                                    <Button
                                        HorizontalAlignment="Right"
                                        Click="FlowStatsPopupClose_Click"
                                        Content="✕"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                        ToolTip="关闭" />
                                </Grid>

                                <Grid Margin="6,0,6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="流程 / 工位" />
                                    <TextBlock Grid.Column="2" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="状态" />
                                    <TextBlock Grid.Column="3" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="节拍" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="OK" TextAlignment="Right" />
                                    <TextBlock Grid.Column="5" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="NG" TextAlignment="Right" />
                                    <TextBlock Grid.Column="6" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="未判定" TextAlignment="Right" />
                                    <TextBlock Grid.Column="7" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="判定源" />
                                    <TextBlock Grid.Column="8" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="最近一轮" TextAlignment="Right" />
                                </Grid>

                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FlowStatsRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Margin="0,1"
                                                    Padding="6,5"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.SelectFlowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsIncluded}"
                                                    ToolTip="{Binding Station}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border
                                                                            Padding="{TemplateBinding Padding}"
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="6">
                                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="68" />
                                                            <ColumnDefinition Width="118" />
                                                            <ColumnDefinition Width="70" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Width="7"
                                                            Height="7"
                                                            VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource ScadaFaintTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateText}" Value="暂停">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StateText}" Value="故障">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource ScadaTextBrush}"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="9.5"
                                                                Foreground="{StaticResource ScadaFaintTextBrush}"
                                                                Text="{Binding Station}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="{Binding StateText}" />
                                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaTextBrush}" Text="{Binding CycleText}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DialogSuccessBrush}" Text="{Binding OkText}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DialogDangerBrush}" Text="{Binding NgText}" TextAlignment="Right" />
                                                        <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource DialogWarningBrush}" Text="{Binding UnknownText}" TextAlignment="Right" />
                                                        <Border
                                                            Grid.Column="7"
                                                            Margin="0,0,8,0"
                                                            Padding="5,1"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource DialogAccentSoftBrush}"
                                                            CornerRadius="4">
                                                            <TextBlock
                                                                FontSize="9.5"
                                                                Foreground="{StaticResource DialogAccentBrush}"
                                                                Text="{Binding SourceText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                        <TextBlock Grid.Column="8" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource ScadaFaintTextBrush}" Text="{Binding LastRoundText}" TextAlignment="Right" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Margin="2,8,2,0">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                        Text="串联线不跨站求和；线级取「线级汇总来源」流程的汇总。" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            Command="{Binding ShowAllFlowsCommand}"
                                            Content="全部在跑"
                                            Style="{StaticResource StatusBarItemButton}" />
                                        <Button
                                            Click="FlowRoundDetail_Click"
                                            Content="查看最近一轮"
                                            Style="{StaticResource StatusBarItemButton}" />
                                        <Button
                                            Click="FlowStatsPopupClose_Click"
                                            Content="关闭"
                                            Style="{StaticResource StatusBarItemButton}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!--  轮次下钻：选中流程最近一轮的不可变记录（宿主侧第一批）  -->
                    <Popup
                        x:Name="FlowRoundPopup"
                        AllowsTransparency="True"
                        Focusable="False"
                        Placement="Top"
                        PlacementTarget="{Binding ElementName=FlowRunningChip}"
                        PopupAnimation="Fade"
                        StaysOpen="False">
                        <Border
                            Width="480"
                            Margin="10"
                            Padding="12"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="24"
                                    Direction="270"
                                    Opacity="0.16"
                                    ShadowDepth="6"
                                    Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="轮次详情" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Click="FlowRoundPopupClose_Click"
                                        Content="✕"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                        ToolTip="关闭" />
                                </Grid>

                                <StackPanel Margin="0,8,0,8" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        Text="{Binding RoundDetail.FlowName}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                        Text="{Binding RoundDetail.RoundText}" />
                                    <Border
                                        Margin="10,0,0,0"
                                        Padding="8,1"
                                        Background="{StaticResource DialogRowHoverBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999">
                                        <TextBlock Text="{Binding RoundDetail.OutcomeText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{StaticResource DialogWarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RoundDetail.OutcomeText}" Value="OK">
                                                            <Setter Property="Foreground" Value="{StaticResource DialogSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RoundDetail.OutcomeText}" Value="NG">
                                                            <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaFaintTextBrush}" Text="开始" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaTextBrush}" Text="{Binding RoundDetail.StartedText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaFaintTextBrush}" Text="结束" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaTextBrush}" Text="{Binding RoundDetail.CompletedText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaFaintTextBrush}" Text="节拍" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ScadaTextBrush}" Text="{Binding RoundDetail.CycleText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaFaintTextBrush}" Text="判定源" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaTextBrush}" Text="{Binding RoundDetail.VerdictSourceText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaFaintTextBrush}" Text="失败步骤" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaTextBrush}" Text="{Binding RoundDetail.FailedStepName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaFaintTextBrush}" Text="步骤" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource ScadaTextBrush}" Text="{Binding RoundDetail.StepsText}" />
                                </Grid>

                                <TextBlock
                                    Margin="0,8,0,4"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                    Text="步骤时间线" />
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RoundDetail.Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="20" Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource ScadaFaintTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding State}" Value="Success">
                                                                        <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                                        <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="4,0,6,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource ScadaTextBrush}"
                                                        Text="{Binding StepName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                                        Text="{Binding State}"
                                                        TextAlignment="Right" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                                        Text="{Binding ElapsedText}"
                                                        TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border
                                    Margin="0,8,0,0"
                                    Padding="9,7"
                                    Background="{StaticResource DialogRowHoverBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding RoundDetail.Reason}"
                                        TextWrapping="Wrap" />
                                </Border>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="10"
                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                    Text="NG ≠ 技术故障：判定表 Failed 仍按 IsOk 计 NG；结果输出步骤始终 Success。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Rectangle Style="{StaticResource StatusBarSeparator}" />
                    <Button
                        Command="{Binding ToggleConsoleCommand}"
                        Style="{StaticResource StatusBarItemButton}"
                        ToolTip="展开 / 收起底部控制台（32 ↔ 240）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                Text="&#xf120;" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="控制台" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource StatusBarSeparator}" />
                    <TextBlock
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding CurrentTimeText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
