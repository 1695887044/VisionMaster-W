                                <Setter.Value>
                                    <ControlTemplate TargetType="Separator">
                                        <Border Height="1" Background="{TemplateBinding Background}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Menu.Resources>
                    <MenuItem
                        Foreground="{StaticResource ScadaTextBrush}"
                        Header="&#xf0c9;">
                        <MenuItem
                            Header="文件(F)"
                            FontFamily="Microsoft YaHei"
                            Style="{StaticResource MenuFlyoutStyle}"
