                            ui:MenuItemEx.FlyoutIcon="&#xf07b;"
                            ui:MenuItemEx.FlyoutTitle="文件">
                            <!--  子项走本菜单的隐式样式：Separator 按自己的类型查样式，不会被套上 MenuItem 模板。  -->
