                                ui:MenuItemEx.Tone="Slate">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf0ca;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Open}"
                                Header="打开方案"
                                InputGestureText="O"
                                ui:MenuItemEx.Description="从磁盘打开方案文件"
                                ui:MenuItemEx.Tone="Amber">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf07c;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Save}"
                                Header="保存方案"
                                InputGestureText="S"
                                ui:MenuItemEx.Description="保存当前方案的全部修改"
                                ui:MenuItemEx.Tone="Green">
                                <MenuItem.Icon>
                                    <TextBlock FontFamily="{StaticResource Icon}" Text="&#xf0c7;" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
