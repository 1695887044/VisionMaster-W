<Window
    x:Class="VisionMaster.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:commands="clr-namespace:VisionMaster.Commands"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:shell="clr-namespace:VisionMaster"
    xmlns:ui="http://schemas.UI.com/ui"
    xmlns:views="clr-namespace:VisionMaster.Views"
    Title="VisionMaster"
    Width="1280"
    Height="860"
    MinWidth="1120"
    MinHeight="680"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ui:WindowExtensions.IsAutoWireCommands="True"
    PreviewKeyDown="OnShellPreviewKeyDown"
    Background="{StaticResource DialogSurfaceBrush}"
    FontFamily="Microsoft YaHei"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            CornerRadius="1"
            GlassFrameThickness="1"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!--  标题栏图标按钮（高频操作驻留）  -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            x:Name="Bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                            </Trigger>
                            <!--  禁用态（Command.CanExecute=false 自动触发）：半透明置灰 + 取消手型，让互锁"看得见"  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  标题栏分隔线  -->
        <Style x:Key="TitleSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="5,7" />
            <Setter Property="Fill" Value="{StaticResource DialogBorderBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!--  工作模式分段按钮：调试 / 运行 / 组态 / 自由  -->
        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeButtonDebug" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Debug}">
                    <Setter Property="Background" Value="{StaticResource LogicIfSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource LogicIfTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeButtonRun" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Run}">
                    <Setter Property="Background" Value="{StaticResource LogicForSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource LogicForTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeButtonConfig" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Config}">
                    <Setter Property="Background" Value="{StaticResource LogicWhileSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource LogicWhileTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModeButtonFree" TargetType="Button" BasedOn="{StaticResource ModeButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Free}">
                    <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  运行条按钮：文字 + 图标位，和标题栏的图标按钮区分开  -->
        <Style x:Key="RunBarButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  活动栏开关（VS Code 式，左侧强调条指示）  -->
        <Style x:Key="ActivityToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!--  左侧强调指示条  -->
                            <Border
                                x:Name="Indicator"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{StaticResource DialogAccentBrush}"
                                CornerRadius="0,2,2,0"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  活动栏动作按钮（打开对话框类）  -->
        <Style x:Key="ActivityAction" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!--  DWV 第 1 期快捷键（窗口级）：F9 切换断点、F5 继续。
              F10（单步）不走这里 —— WPF Menu 会把 F10 当"菜单激活键"消费，
              改在 Shell.xaml.cs 的 PreviewKeyDown 里截获（见 OnShellPreviewKeyDown 注释）。  -->
        <KeyBinding Key="F9" Command="{Binding ToggleBreakpointOnCurrentStepCommand}" />
        <KeyBinding
            Key="F5"
            Command="{Binding ExecutionCommand}"
            CommandParameter="{x:Static local:ExecutionAction.Resume}" />
        <KeyBinding
            Key="D1"
            Modifiers="Control"
            Command="{Binding SetShellModeCommand}"
            CommandParameter="Debug" />
        <KeyBinding
            Key="D2"
            Modifiers="Control"
            Command="{Binding SetShellModeCommand}"
            CommandParameter="Run" />
        <KeyBinding
            Key="D3"
            Modifiers="Control"
            Command="{Binding SetShellModeCommand}"
            CommandParameter="Config" />
        <KeyBinding
            Key="D4"
            Modifiers="Control"
            Command="{Binding SetShellModeCommand}"
            CommandParameter="Free" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <ui:OverlayHost />

        <!--  ============ 命令面板（Ctrl+K） ============  -->
        <!--  放在 OverlayHost 之后、标题栏之前：覆盖整个窗口，不改变停靠树。  -->
        <Grid
            x:Name="CommandPaletteOverlay"
            Grid.RowSpan="4"
            Panel.ZIndex="200"
            IsVisibleChanged="CommandPaletteOverlay_IsVisibleChanged"
            Visibility="{Binding IsCommandPaletteOpen, Converter={ui:BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource DialogScrimBrush}" MouseDown="CommandPaletteScrim_MouseDown" />
            <Border
                Width="640"
                MaxHeight="480"
                Margin="0,96,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="24"
                        Opacity="0.18"
                        ShadowDepth="6" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="CommandPaletteBox"
                        Margin="16,10"
                        Padding="10,0"
                        VerticalContentAlignment="Center"
                        Background="{StaticResource DialogInputBackgroundBrush}"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="1"
                        FontSize="13"
                        KeyDown="CommandPaletteBox_KeyDown"
                        Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="输入流程、视图或命令名称；↑↓ 选择，Enter 执行，Esc 关闭" />
                    <ListBox
                        x:Name="CommandPaletteList"
                        Grid.Row="1"
                        Margin="8,0,8,8"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding CommandPaletteItems}"
                        MouseDoubleClick="CommandPaletteList_MouseDoubleClick"
                        SelectedItem="{Binding SelectedCommandPaletteItem}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="ItemBorder"
                                                Padding="10,8"
                                                Background="Transparent"
                                                CornerRadius="7">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="14"
                                        Foreground="{StaticResource DialogAccentBrush}"
                                        Text="{Binding Glyph}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock
                        Grid.Row="1"
                        Margin="16,12"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="没有匹配的流程、视图或命令"
                        Visibility="{Binding CommandPaletteEmptyVisibility}" />
                </Grid>
            </Border>
        </Grid>

        <!--  ============ 单行标题栏（VS Code 式） ============  -->
        <Grid Background="{StaticResource DialogSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <!--  ☰ 菜单（完整菜单树折叠于此）  -->
                <Menu
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem
                        Foreground="{StaticResource ScadaTextBrush}"
                        Header="&#xf0c9;">
                        <MenuItem Header="文件(F)" FontFamily="Microsoft YaHei">
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Create}"
                                Header="新建方案(N)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf15b;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.BrowseList}"
                                Header="方案列表(L)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0ca;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Open}"
                                Header="打开方案(O)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf07c;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Save}"
                                Header="保存方案(S)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0c7;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="视图(V)">
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ImageView"
                                Header="视觉图像"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf030;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ProcessView"
                                Header="流程导航"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0e8;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ToolView"
                                Header="工具箱"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf552;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_LogView"
                                Header="控制台"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf15c;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_DataView"
                                Header="数据栏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf080;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ModuleOutView"
                                Header="模块输出"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2f5;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_FlowCanvasView"
                                Header="流程画布"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf5cb;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaEditorView"
                                Header="组态画面"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf1fc;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaToolboxView"
                                Header="图元工具箱"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf552;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaPropertyView"
                                Header="检查器"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf013;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaLayerView"
                                Header="图层"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf5fd;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_DeviceStateView"
                                Header="设备状态"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf108;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="画布(C)">
                            <!--
                                每一格都是**一张完整的画布**（上行当前图 + 下行走马灯），不是老式"一路图钉死一个窗口"：
                                格号 ↔ 插件的"显示窗口号"，第 N 格只收窗口号 N 的图，各自维护自己的列表。
                            -->
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="1"
                                Header="单画面 1×1"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf065;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="2"
                                Header="双画面 1×2"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf009;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="3"
                                Header="主从 1+2 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="4"
                                Header="四宫格 2×2"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf009;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="5"
                                Header="多视口 2+3 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="6"
                                Header="六宫格 2×3"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="7"
                                Header="矩阵 3+4 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="8"
                                Header="矩阵 4+4 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="9"
                                Header="九宫格 3×3"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>

                        </MenuItem>

                        <MenuItem Header="工具(T)">
                            <MenuItem Header="截屏"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf125;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:SaveLayoutCommand}"
                                Header="保存布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:LoadLayoutCommand}"
                                Header="加载布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf07b;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ResetLayoutCommand}"
                                Header="恢复默认布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2d2;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="系统(S)">
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                Header="用户登录"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf4fe;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.GlobalVariables}"
                                Header="全局变量"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf121;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.HardwareSettings}"
                                Header="硬件管理"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2db;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.SystemSettings}"
                                Header="系统设置"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf1de;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.ReturnToZero}"
                                Header="回零"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf015;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="帮助(H)" FontFamily="Microsoft YaHei">
                            <MenuItem Header="激活（未实现）" IsEnabled="False">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf084;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem Header="建议及反馈（未实现）" IsEnabled="False">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf4ad;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.Help}"
                                Header="帮助文档"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf02d;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem Header="关于（未实现）" IsEnabled="False">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf05a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!--  文件操作  -->
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Create}"
                    Content="&#xf15b;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="新建方案" />
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Open}"
                    Content="&#xf07c;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="打开方案" />
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Save}"
                    Content="&#xf0c7;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="保存方案" />

                <Rectangle Style="{StaticResource TitleSeparator}" />

                <!--  工作模式：调试 / 运行 / 组态 / 自由（Ctrl+1..4）  -->
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Command="{Binding SetShellModeCommand}"
                        CommandParameter="Debug"
                        Content="调试"
                        Style="{StaticResource ModeButtonDebug}"
                        ToolTip="调试：视觉图像 + 流程画布 + 步骤/工具箱（Ctrl+1）" />
                    <Button
                        Command="{Binding SetShellModeCommand}"
                        CommandParameter="Run"
                        Content="运行"
                        Style="{StaticResource ModeButtonRun}"
                        ToolTip="运行：全宽运行驾驶舱 + 图像 + KPI（Ctrl+2）" />
                    <Button
                        Command="{Binding SetShellModeCommand}"
                        CommandParameter="Config"
                        Content="组态"
                        Style="{StaticResource ModeButtonConfig}"
                        ToolTip="组态：仅组态画面 + 属性/图层/图元（Ctrl+3）" />
                    <Button
                        Command="{Binding SetShellModeCommand}"
                        CommandParameter="Free"
                        Content="自由"
                        Style="{StaticResource ModeButtonFree}"
                        ToolTip="自由：全部面板与文档（Ctrl+4）" />
                </StackPanel>

                <Rectangle Style="{StaticResource TitleSeparator}" />

                <!--  全局命令：原来挂在左侧活动栏底部，2026-10-15 上移到顶栏。  -->
                <!--  为什么上移：活动栏按"图标与落点同侧"拆成左右两条后，左条只该放左侧面板的开关；  -->
                <!--  这两个是命令（没有面板落点，点了弹窗），混在竖条里语义不对——顶栏本就是全局命令区。  -->
                <Button
                    Command="{Binding OpenCommandPaletteCommand}"
                    Content="&#xf002;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="搜索流程 / 视图 / 命令（Ctrl+K）" />
                <Button
                    Command="{Binding SystemCommand}"
                    CommandParameter="{x:Static local:SystemAction.GlobalVariables}"
                    Content="&#xf121;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="全局变量" />
                <Button
                    Command="{Binding SystemCommand}"
                    CommandParameter="{x:Static local:SystemAction.HardwareSettings}"
                    Content="&#xf2db;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="硬件管理" />
            </StackPanel>

            <!--  居中：当前方案名  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                    Text="&#xf07b;">
                    <TextBlock.FontFamily>
                        <StaticResource ResourceKey="Icon" />
                    </TextBlock.FontFamily>
                </TextBlock>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource ScadaTextBrush}"
                    Text="{Binding Workspace.CurrentSolution.SolutionName, TargetNullValue='未加载方案', FallbackValue='未加载方案'}"
                    ToolTip="当前正在运行的视觉解决方案" />
            </StackPanel>

            <!--  窗口控制按钮  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    Content="M 0 5 L 10 5"
                    Style="{StaticResource WindowControlButton}" />
                <Button
                    x:Name="BtnMaximize"
                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                    Content="M 0 0 H 10 V 10 H 0 Z"
                    Style="{StaticResource WindowControlButton}" />
                <Button
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    Content="M 0 0 L 10 10 M 0 10 L 10 0"
                    Style="{StaticResource WindowControlButton}"
                    Tag="Close" />
            </StackPanel>
        </Grid>

        <!--  ============ 运行条（48px）：状态 + 编译/运行/暂停/单步/停止 ============  -->
        <Border
            x:Name="RunBar"
            Grid.Row="1"
            Height="48"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Config}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Run}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                        Width="9"
                        Height="9"
                        VerticalAlignment="Center"
                        Fill="{Binding RunStateBrush}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding RunStateBrush}"
                        Text="{Binding RunStateText}" />
                    <!--  绑 RunBarFlowText 而不是「当前流程名」：本仓允许多条流程并跑（单流程 / HTTP / 定时触发各开各的会话），
                          只显示选中项会出现"两条在跑、条上只写一条"，写的那条还可能根本没在跑（2026-10-20 真机）。
                          0 条在跑时它回落到当前流程，1 条报那一条，多条报「A 等 N 个流程」，完整名单在悬停提示里。  -->
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="{Binding RunBarFlowText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding RunBarFlowToolTip}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Compile}"
                        Content="编译"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="流程编译" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.RunOnce}"
                        Content="运行一次"
                        Foreground="{StaticResource DialogSuccessBrush}"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="运行一次" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.RunContinuous}"
                        Content="循环运行"
                        Foreground="{StaticResource DialogSuccessBrush}"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="循环运行" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Pause}"
                        Content="暂停"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="暂停（全部运行中的调试会话）" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Resume}"
                        Content="继续"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="继续（F5）" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.StepOnce}"
                        Content="单步"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="单步（F10）" />
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Stop}"
                        Content="停止"
                        Foreground="{StaticResource DialogDangerBrush}"
                        Style="{StaticResource RunBarButton}"
                        ToolTip="停止" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource ScadaFaintTextBrush}"
                    Text="F5 继续 · F10 单步" />
            </Grid>
        </Border>

        <!--  ============ 主体：停靠区（活动栏已于 2026-10-15 整条下线） ============  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  停靠区（FluentLight 主题在代码后台应用）  -->
            <avalonDock:DockingManager
                x:Name="dockManager"
                Grid.Column="0"
                AllowMixedOrientation="True"
                AutoWindowSizeWhenOpened="True"
                IsVirtualizingAnchorable="True"
                IsVirtualizingDocument="True">
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">

                        <!--  1. 左侧栏：流程导航（流程胶囊 + 当前流程树）  -->
                        <!--  v2 把原来的“程序”窗格并入 ProcessView 顶部：两者表达同一棵 Solution → Flow → Steps，  -->
                        <!--  再拆两个窗格只会让矮的程序列表白占高度。宽度 340 / 最小 320：  -->
                        <!--  组头要同时放“类型标签 + 实例名 + N 分支 · M 算子 + 状态图标”。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="340" DockMinWidth="320">
                            <avalonDock:LayoutAnchorable
                                Title="流程导航"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ProcessView">
                                <views:ProcessView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!--  2. 中央工作区：流程画布 / 视觉图像 / 组态画面（文档标签，可拆分/浮动）  -->
                        <!--  流程画布为什么从左侧栏搬到这里：它是节点编辑器的主工作区，面积需求与视觉图像同级，  -->
                        <!--  而原来跟流程栏挤在 17* 宽的同一列里做标签页——同一时刻只能看见一个，  -->
                        <!--  等于"要么看树、要么看画布"，两件事本来是要对照着做的。  -->
                        <!--  默认选中仍是「视觉图像」（IsSelected=True 在它身上）：画布是编辑入口，但启动视角  -->
                        <!--  先给实时图像，避免每次开软件都先看到一张空白画布。  -->
                        <avalonDock:LayoutPanel Orientation="Vertical" DockWidth="70*">
                            <avalonDock:LayoutDocumentPane>
                                <!--  IsSelected 是必要的：一个 pane 里有多个文档时，默认激活哪一个不保证是第一个，  -->
                                <!--  不写这一行就可能让"组态画面"抢走启动时的前台标签，改变现有用户的默认视角。  -->
                                <avalonDock:LayoutDocument
                                    Title="视觉图像"
                                    CanClose="False"
                                    ContentId="Panel_ImageView"
                                    IsSelected="True">
                                    <views:ImageView />
                                </avalonDock:LayoutDocument>
                                <!--  流程节点画布：与视觉图像同为中央文档区，可拖出成分屏对照着调  -->
                                <avalonDock:LayoutDocument
                                    Title="流程画布"
                                    CanClose="False"
                                    ContentId="Panel_FlowCanvasView">
                                    <views:FlowCanvasView />
                                </avalonDock:LayoutDocument>
                                <!--  组态画面编辑器：与视觉图像同为中央文档区，可拖出成分屏对照着调画面  -->
                                <avalonDock:LayoutDocument
                                    Title="组态画面"
                                    CanClose="False"
                                    ContentId="Panel_ScadaEditorView">
                                    <views:ScadaEditorView />
                                </avalonDock:LayoutDocument>
                                <avalonDock:LayoutDocument
                                    Title="运行驾驶舱"
                                    CanClose="False"
                                    ContentId="Panel_RunCockpitView">
                                    <views:RunCockpitView />
                                </avalonDock:LayoutDocument>
                            </avalonDock:LayoutDocumentPane>

                            <!--  3. 底部面板组：四合一标签（可整体隐藏）  -->
                            <avalonDock:LayoutAnchorablePane DockHeight="200">
                                <avalonDock:LayoutAnchorable
                                    Title="日志信息"
                                    CanClose="False"
                                    CanHide="True"
                                    ContentId="Panel_LogView">
                                    <views:LogView />
                                </avalonDock:LayoutAnchorable>
                                <avalonDock:LayoutAnchorable
                                    Title="监控栏"
                                    CanClose="False"
                                    CanHide="True"
                                    ContentId="Panel_MonitorView">
                                    <views:MonitorView />
                                </avalonDock:LayoutAnchorable>
                                <avalonDock:LayoutAnchorable
                                    Title="设备状态"
                                    CanClose="False"
                                    CanHide="True"
                                    ContentId="Panel_DeviceStateView" />
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutPanel>

                        <!--  4. 右侧单列检查器：属性 / 图层 / 工具箱 / 图元工具箱共用一列 320。
                              v2 把原来的属性 260 + 图层 240 + 工具箱 260 三列收成一列；
                              模式只决定哪些标签可见，不再用不同列宽占掉中央画布。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="320" DockMinWidth="300">
                            <avalonDock:LayoutAnchorable
                                Title="属性"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ScadaPropertyView">
                                <views:ScadaPropertyView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="图层"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ScadaLayerView">
                                <views:ScadaLayerView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="工具箱"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ToolView">
                                <views:ToolView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="图元工具箱"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ScadaToolboxView">
                                <views:ScadaToolboxView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>
        </Grid>

        <!--  ============ 状态栏（VS Code 式） ============  -->
        <Border
            Grid.Row="3"
            Background="{StaticResource ScadaTitleBarBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Config}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!--  运行状态指示灯 + 文字（唯一事实来源：ShellViewModel.RunState）  -->
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{Binding RunStateBrush}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{Binding RunStateBrush}"
                        Text="{Binding RunStateText}" />

                    <!--  生产 KPI 占位：数据源未接入时显示“—”，不用 0 冒充真实计数  -->
                    <TextBlock
                        Margin="10,0,0,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock
                        Margin="6,0,0,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="节拍" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource ScadaTextBrush}"
                        Text="{Binding CycleTimeText}"
                        ToolTip="待接入运行统计：节拍" />
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock
                        Margin="6,0,0,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="OK" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogSuccessBrush}"
                        Text="{Binding OkCountText}"
                        ToolTip="待接入运行统计：OK 数" />
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock
                        Margin="6,0,0,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="NG" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogDangerBrush}"
                        Text="{Binding NgCountText}"
                        ToolTip="待接入运行统计：NG 数" />
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock
                        Margin="6,0,0,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="告警" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogWarningBrush}"
                        Text="{Binding AlarmCountText}"
                        ToolTip="待接入运行统计：未确认告警数" />

                    <TextBlock
                        Margin="10,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock FontSize="12" Text="当前用户：" />
                    <!--  当前登录者 + 角色。读的是全局唯一的 ScadaAccessPolicy（App 里注册的单例），  -->
                    <!--  权限判定用的也是这一份，所以"状态栏写的"和"实际生效的"不可能不一致。  -->
                    <!--  未登录显示"未登录（操作员）"而不是空白：让人一眼明白不是软件坏了，是权限就这么多。  -->
                    <!--  灰色=未登录 / 蓝色=有人登录着；点一下直接开登录弹窗（比走"系统 → 用户登录"少两步）。  -->
                    <TextBlock
                        x:Name="CurrentUserText"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="Bold"
                        Text="{Binding AccessPolicy.LoginStateText}"
                        ToolTip="点击切换用户（也可走 系统 → 用户登录）">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccessPolicy.IsLoggedIn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ScadaPrimaryButtonBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.InputBindings>
                            <MouseBinding
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                MouseAction="LeftClick" />
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBlock
                        Margin="8,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock FontSize="12" Text="当前方案" />
                    <TextBlock
                        x:Name="SolutionPathText"
                        MaxWidth="400"
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Text="{Binding Workspace.CurrentSolution.SolutionFilePath, TargetNullValue='未加载', FallbackValue='未加载'}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>

                <!--  组态模式状态：页面/网格/选中图元（不显示流程运行态）  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentMode}" Value="{x:Static shell:ShellMode.Config}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource LogicWhileTextBrush}"
                        Text="组态设计" />
                    <TextBlock
                        Margin="8,0"
                        FontSize="12"
                        Foreground="{StaticResource DialogBorderBrush}"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="1280 × 800 · 网格 20 px · 选中图元" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="24"
                        Height="20"
                        Margin="0,0,8,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleConsoleCommand}"
                        ToolTip="展开 / 收起底部控制台（32 ↔ 240）">
                        <TextBlock
                            FontFamily="{StaticResource Icon}"
                            FontSize="12"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="&#xf120;" />
                    </Button>
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource DialogAccentBrush}"
                        Text="&#xf2db;">
                        <TextBlock.FontFamily>
                            <StaticResource ResourceKey="Icon" />
                        </TextBlock.FontFamily>
                    </TextBlock>
                    <TextBlock
                        Width="72"
                        FontSize="12"
                        Text="{Binding CpuUsageStr}"
                        ToolTip="进程CPU占用率" />
                    <TextBlock
                        Margin="6,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="&#xf538;">
                        <TextBlock.FontFamily>
                            <StaticResource ResourceKey="Icon" />
                        </TextBlock.FontFamily>
                    </TextBlock>
                    <TextBlock
                        Width="88"
                        FontSize="12"
                        Text="{Binding MemoryUsageStr}"
                        ToolTip="进程物理内存 (Working Set)" />
                    <TextBlock
                        Margin="6,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ScadaDisabledTextBrush}"
                        Text="&#xf0e8;">
                        <TextBlock.FontFamily>
                            <StaticResource ResourceKey="Icon" />
                        </TextBlock.FontFamily>
                    </TextBlock>
                    <TextBlock
                        Width="62"
                        FontSize="12"
                        Text="{Binding ThreadCountStr}"
                        ToolTip="当前进程活动线程数" />
                    <TextBlock
                        Margin="6,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource ScadaDisabledTextBrush}"
                        Text="&#xf24d;">
                        <TextBlock.FontFamily>
                            <StaticResource ResourceKey="Icon" />
                        </TextBlock.FontFamily>
                    </TextBlock>
                    <TextBlock
                        Width="62"
                        FontSize="12"
                        Text="{Binding HandleCountStr}"
                        ToolTip="系统句柄数 (警告线: 10000)" />
                    <TextBlock
                        Margin="10,0"
                        FontSize="12"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Text="{Binding CurrentTimeText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
