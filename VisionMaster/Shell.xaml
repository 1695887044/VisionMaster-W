                                <Style BasedOn="{StaticResource MenuFlyoutItemStyle}" TargetType="MenuItem" />
                            </MenuItem.Resources>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Create}"
