<Window
    x:Class="VisionMaster.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:commands="clr-namespace:VisionMaster.Commands"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    xmlns:views="clr-namespace:VisionMaster.Views"
    Title="VisionMaster"
    Width="1280"
    Height="920"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ui:WindowExtensions.IsAutoWireCommands="True"
    Background="#FFFFFF"
    FontFamily="Microsoft YaHei"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            CornerRadius="1"
            GlassFrameThickness="1"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!--  标题栏图标按钮（高频操作驻留）  -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            x:Name="Bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E9EDF4" />
                                <Setter Property="Foreground" Value="#1F1F1F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DCE6F5" />
                            </Trigger>
                            <!--  禁用态（Command.CanExecute=false 自动触发）：半透明置灰 + 取消手型，让互锁"看得见"  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  标题栏分隔线  -->
        <Style x:Key="TitleSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="5,7" />
            <Setter Property="Fill" Value="#E0E0E0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!--  活动栏开关（VS Code 式，左侧强调条指示）  -->
        <Style x:Key="ActivityToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#5A5A5A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!--  左侧强调指示条  -->
                            <Border
                                x:Name="Indicator"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="#0067C0"
                                CornerRadius="0,2,2,0"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1F1F1F" />
                                <Setter TargetName="Bd" Property="Background" Value="#F0F3F8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0067C0" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  活动栏动作按钮（打开对话框类）  -->
        <Style x:Key="ActivityAction" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#5A5A5A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1F1F1F" />
                                <Setter TargetName="Bd" Property="Background" Value="#F0F3F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <ui:OverlayHost />

        <!--  ============ 单行标题栏（VS Code 式） ============  -->
        <Grid Background="#FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <!--  ☰ 菜单（完整菜单树折叠于此）  -->
                <Menu
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem
                        Foreground="#444444"
                        Header="&#xf0c9;">
                        <MenuItem Header="文件(F)" FontFamily="Microsoft YaHei">
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Create}"
                                Header="新建方案(N)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf15b;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.BrowseList}"
                                Header="方案列表(L)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0ca;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Open}"
                                Header="打开方案(O)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf07c;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Save}"
                                Header="保存方案(S)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0c7;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.AlarmConfig}"
                                Header="报警配置(A)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0f3;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="视图(V)">
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ImageView"
                                Header="视觉图像"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf030;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ProcessView"
                                Header="流程设计器"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf542;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_FlowListView"
                                Header="程序"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00b;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ToolView"
                                Header="工具箱"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf552;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_LogView"
                                Header="日志信息"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf15c;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_DataView"
                                Header="数据栏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf080;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ModuleOutView"
                                Header="模块输出"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2f5;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_FlowCanvasView"
                                Header="流程画布"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf5cb;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaEditorView"
                                Header="组态画面"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf1fc;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaToolboxView"
                                Header="图元工具箱"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf552;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaPropertyView"
                                Header="属性"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf013;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_ScadaLayerView"
                                Header="图层"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf5fd;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ShowPanelCommand}"
                                CommandParameter="Panel_DeviceStateView"
                                Header="设备状态"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf108;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="画布(C)">
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="1"
                                Header="单画面 1×1"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf065;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="2"
                                Header="双画面 1×2"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf009;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="3"
                                Header="主从 1+2 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="4"
                                Header="四宫格 2×2"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf009;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="5"
                                Header="多视口 2+3 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="6"
                                Header="六宫格 2×3"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="7"
                                Header="矩阵 3+4 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="8"
                                Header="矩阵 4+4 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="9"
                                Header="九宫格 3×3"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="工具(T)">
                            <MenuItem Header="截屏"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf125;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:SaveLayoutCommand}"
                                Header="保存布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:LoadLayoutCommand}"
                                Header="加载布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf07b;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{commands:ResetLayoutCommand}"
                                Header="恢复默认布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2d2;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem Header="报表查询"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf200;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="系统(S)">
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                Header="用户登录"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf4fe;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.GlobalVariables}"
                                Header="全局变量"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf121;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.CameraSettings}"
                                Header="相机设置"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf030;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.CommSettings}"
                                Header="通讯设置"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf6ff;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.HardwareSettings}"
                                Header="硬件设置"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2db;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.RuntimeWindowSettings}"
                                Header="运行窗口设置"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2d0;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.SystemParameters}"
                                Header="系统参数设置"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf1de;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.VariableEvents}"
                                Header="变量事件"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0f3;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.ReportQuery}"
                                Header="报表查询"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf200;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.ReturnToZero}"
                                Header="回零"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf015;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UIDesign}"
                                Header="UI 设计"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf53f;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="帮助(H)" FontFamily="Microsoft YaHei">
                            <MenuItem Header="激活"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf084;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem Header="建议及反馈"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf4ad;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem Header="帮助文档"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf02d;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem Header="关于"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf05a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!--  文件操作  -->
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Create}"
                    Content="&#xf15b;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="新建方案" />
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Open}"
                    Content="&#xf07c;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="打开方案" />
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Save}"
                    Content="&#xf0c7;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="保存方案" />

                <Rectangle Style="{StaticResource TitleSeparator}" />

                <!--  运行控制  -->
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static local:ExecutionAction.Compile}"
                    Content="&#xf0e7;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="流程编译" />
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static local:ExecutionAction.RunOnce}"
                    Content="&#xf061;"
                    Foreground="#2DA44E"
                    Style="{StaticResource TitleButton}"
                    ToolTip="运行一次" />
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static local:ExecutionAction.RunContinuous}"
                    Content="&#xf021;"
                    Foreground="#2DA44E"
                    Style="{StaticResource TitleButton}"
                    ToolTip="循环运行" />
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static local:ExecutionAction.Stop}"
                    Content="&#xf28d;"
                    Foreground="#D1242F"
                    Style="{StaticResource TitleButton}"
                    ToolTip="停止" />
            </StackPanel>

            <!--  居中：当前方案名  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#5A5A5A"
                    Text="&#xf07b;">
                    <TextBlock.FontFamily>
                        <StaticResource ResourceKey="Icon" />
                    </TextBlock.FontFamily>
                </TextBlock>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#333333"
                    Text="{Binding Workspace.CurrentSolution.SolutionName, TargetNullValue='未加载方案', FallbackValue='未加载方案'}"
                    ToolTip="当前正在运行的视觉解决方案" />
            </StackPanel>

            <!--  窗口控制按钮  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    Content="M 0 5 L 10 5"
                    Style="{StaticResource WindowControlButton}" />
                <Button
                    x:Name="BtnMaximize"
                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                    Content="M 0 0 H 10 V 10 H 0 Z"
                    Style="{StaticResource WindowControlButton}" />
                <Button
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    Content="M 0 0 L 10 10 M 0 10 L 0 10"
                    Style="{StaticResource WindowControlButton}"
                    Tag="Close" />
            </StackPanel>
        </Grid>

        <!--  ============ 主体：活动栏 + 停靠区 ============  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  活动栏（Activity Bar）  -->
            <Border
                Background="#F7F8FA"
                BorderBrush="#E5E5E5"
                BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <ToggleButton
                            Command="{Binding TogglePanelCommand}"
                            CommandParameter="Panel_FlowListView"
                            Content="&#xf00b;"
                            IsChecked="{Binding IsFlowListActive, Mode=OneWay}"
                            Style="{StaticResource ActivityToggle}"
                            ToolTip="程序" />
                        <ToggleButton
                            Command="{Binding TogglePanelCommand}"
                            CommandParameter="Panel_ProcessView"
                            Content="&#xf0e8;"
                            IsChecked="{Binding IsProcessActive, Mode=OneWay}"
                            Style="{StaticResource ActivityToggle}"
                            ToolTip="流程栏" />
                        <ToggleButton
                            Command="{Binding TogglePanelCommand}"
                            CommandParameter="Panel_ToolView"
                            Content="&#xf552;"
                            IsChecked="{Binding IsToolboxActive, Mode=OneWay}"
                            Style="{StaticResource ActivityToggle}"
                            ToolTip="工具箱" />
                        <!--  f1fc = draw-polygon（矢量图元），与菜单里组态画面同一码位、同字体，图形存在性已验证  -->
                        <ToggleButton
                            Command="{Binding TogglePanelCommand}"
                            CommandParameter="Panel_ScadaToolboxView"
                            Content="&#xf1fc;"
                            IsChecked="{Binding IsScadaToolboxActive, Mode=OneWay}"
                            Style="{StaticResource ActivityToggle}"
                            ToolTip="图元工具箱" />
                        <!--  f5fd = layer-group，与画布右键菜单「图层」子菜单同一码位、同字体  -->
                        <ToggleButton
                            Command="{Binding TogglePanelCommand}"
                            CommandParameter="Panel_ScadaLayerView"
                            Content="&#xf5fd;"
                            IsChecked="{Binding IsScadaLayerActive, Mode=OneWay}"
                            Style="{StaticResource ActivityToggle}"
                            ToolTip="图层" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button
                            Command="{Binding SystemCommand}"
                            CommandParameter="{x:Static local:SystemAction.GlobalVariables}"
                            Content="&#xf121;"
                            Style="{StaticResource ActivityAction}"
                            ToolTip="全局变量" />
                        <Button
                            Command="{Binding SystemCommand}"
                            CommandParameter="{x:Static local:SystemAction.CommSettings}"
                            Content="&#xf6ff;"
                            Style="{StaticResource ActivityAction}"
                            ToolTip="通讯设置" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  停靠区（FluentLight 主题在代码后台应用）  -->
            <avalonDock:DockingManager
                x:Name="dockManager"
                Grid.Column="1"
                AllowMixedOrientation="True"
                AutoWindowSizeWhenOpened="True"
                IsVirtualizingAnchorable="True"
                IsVirtualizingDocument="True">
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">

                        <!--  1. 左侧双栏：程序 / 流程栏（星号比例：任意分辨率/DPI 下占比恒定，顶层并列避免嵌套宽度失效）  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="13*">
                            <avalonDock:LayoutAnchorable
                                Title="程序"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_FlowListView">
                                <views:FlowListView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                        <avalonDock:LayoutAnchorablePane DockWidth="17*">
                            <avalonDock:LayoutAnchorable
                                Title="流程栏"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ProcessView">
                                <views:ProcessView />
                            </avalonDock:LayoutAnchorable>
                            <!--  流程节点画布：与流程栏同 pane（标签页），可拖出成上下/左右分屏对照。  -->
                            <!--  树表达执行顺序（SortId），画布表达数据流（LinkedSources），两者共用同一份 FlowModel  -->
                            <avalonDock:LayoutAnchorable
                                Title="流程画布"
                                CanClose="False"
                                CanHide="False"
                                ContentId="Panel_FlowCanvasView">
                                <views:FlowCanvasView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!--  2. 中央工作区：视觉图像（文档标签，可拆分/浮动）  -->
                        <avalonDock:LayoutPanel Orientation="Vertical" DockWidth="70*">
                            <avalonDock:LayoutDocumentPane>
                                <!--  IsSelected 是必要的：一个 pane 里有多个文档时，默认激活哪一个不保证是第一个，  -->
                                <!--  不写这一行就可能让"组态画面"抢走启动时的前台标签，改变现有用户的默认视角。  -->
                                <avalonDock:LayoutDocument
                                    Title="视觉图像"
                                    CanClose="False"
                                    ContentId="Panel_ImageView"
                                    IsSelected="True">
                                    <views:ImageView />
                                </avalonDock:LayoutDocument>
                                <!--  组态画面编辑器：与视觉图像同为中央文档区，可拖出成分屏对照着调画面  -->
                                <avalonDock:LayoutDocument
                                    Title="组态画面"
                                    CanClose="False"
                                    ContentId="Panel_ScadaEditorView">
                                    <views:ScadaEditorView />
                                </avalonDock:LayoutDocument>
                            </avalonDock:LayoutDocumentPane>

                            <!--  3. 底部面板组：四合一标签（可整体隐藏）  -->
                            <avalonDock:LayoutAnchorablePane DockHeight="200">
                                <avalonDock:LayoutAnchorable
                                    Title="日志信息"
                                    CanClose="False"
                                    CanHide="True"
                                    ContentId="Panel_LogView">
                                    <views:LogView />
                                </avalonDock:LayoutAnchorable>
                                <avalonDock:LayoutAnchorable
                                    Title="监控栏"
                                    CanClose="False"
                                    CanHide="True"
                                    ContentId="Panel_MonitorView">
                                    <views:MonitorView />
                                </avalonDock:LayoutAnchorable>
                                <avalonDock:LayoutAnchorable
                                    Title="设备状态"
                                    CanClose="False"
                                    CanHide="True"
                                    ContentId="Panel_DeviceStateView" />
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutPanel>

                        <!--  4. 右侧属性栏：图元属性面板  -->
                        <!--  为什么是顶层并列的定宽栏，而不是塞进中央那个竖向 LayoutPanel：  -->
                        <!--  竖向面板里的子项只有高度方向说话（DockHeight），宽度会被整个面板拉平，  -->
                        <!--  属性栏就会跟着日志栏一起吞掉工作区宽度。定像素（不用星号）是因为  -->
                        <!--  一列"标签 + 输入框"需要的是稳定可读宽度，1080 与 2560 下都是 260 最舒服。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="260">
                            <avalonDock:LayoutAnchorable
                                Title="属性"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ScadaPropertyView">
                                <views:ScadaPropertyView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!--  5. 图层面板：独占一列而不是跟属性/工具箱挤标签页  -->
                        <!--  为什么给它一整列：图层是"画布上现在有什么"的总览，用户是"看一眼 → 点一下眼睛 → 继续调画面"  -->
                        <!--  的高频轻操作；挤成标签页就得来回切换，看一眼的代价变成两次点击，正好把便捷性做没了。  -->
                        <!--  为什么排在属性栏右侧：改完图元属性，视线右移一格就是它的可见性/锁定，编辑动作连成一条线；  -->
                        <!--  工具箱留在最右缘不动（它是低频拖拽源，且不该被新增面板挤走老用户的肌肉记忆）。  -->
                        <!--  240 是行内最挤的那个数：眼睛+锁+名称+数量+上/下移+删除，再窄名称就只剩两三个字了。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="240">
                            <avalonDock:LayoutAnchorable
                                Title="图层"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ScadaLayerView">
                                <views:ScadaLayerView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!--  6. 右侧工具箱停靠栏：插件工具箱 + 图元工具箱（互斥标签页共享一列宽度）  -->
                        <!--  为什么不再用 LayoutRoot.RightSide 自动隐藏滑出区：那种面板一失去鼠标焦点就收回，  -->
                        <!--  从图元工具箱往画布拖图元拖到一半会被收走；常驻停靠栏全程可见，拖动链路不被打断。  -->
                        <!--  为什么图元工具箱从左侧"程序"pane 挪过来：图元调色板和插件工具箱是同一类  -->
                        <!--  "往画布上放东西"的资源面板，用户要找应该在同一个停靠栏里，而不是语义无关的"程序"旁边。  -->
                        <!--  两栏顺序：属性栏贴着中央工作区（改属性时抬眼即见），工具箱列在最右缘——  -->
                        <!--  与原自动隐藏区同侧边缘，老用户的肌肉记忆平移最小；且工具箱是低频拖拽源，让位给高频核对的属性。  -->
                        <!--  共享一列（标签页互斥）而非各占一列，避免不碰 SCADA 的用户长期白丢一条工作区宽度。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="300">
                            <avalonDock:LayoutAnchorable
                                Title="工具箱"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ToolView">
                                <views:ToolView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="图元工具箱"
                                CanClose="False"
                                CanHide="True"
                                ContentId="Panel_ScadaToolboxView">
                                <views:ScadaToolboxView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>
        </Grid>

        <!--  ============ 状态栏（VS Code 式） ============  -->
        <Border
            Grid.Row="2"
            Background="#F5F7FA"
            BorderBrush="#E5E5E5"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  运行状态指示灯 + 文字（唯一事实来源：ShellViewModel.RunState）  -->
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{Binding RunStateBrush}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{Binding RunStateBrush}"
                        Text="{Binding RunStateText}" />
                    <TextBlock
                        Margin="8,0"
                        FontSize="12"
                        Foreground="#C9CEDB"
                        Text="|" />
                    <TextBlock FontSize="12" Text="当前用户：" />
                    <!--  当前登录者 + 角色。读的是全局唯一的 ScadaAccessPolicy（App 里注册的单例），  -->
                    <!--  权限判定用的也是这一份，所以"状态栏写的"和"实际生效的"不可能不一致。  -->
                    <!--  未登录显示"未登录（操作员）"而不是空白：让人一眼明白不是软件坏了，是权限就这么多。  -->
                    <!--  灰色=未登录 / 蓝色=有人登录着；点一下直接开登录弹窗（比走"系统 → 用户登录"少两步）。  -->
                    <TextBlock
                        x:Name="CurrentUserText"
                        Cursor="Hand"
                        FontSize="12"
                        FontWeight="Bold"
                        Text="{Binding AccessPolicy.LoginStateText}"
                        ToolTip="点击切换用户（也可走 系统 → 用户登录）">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#606266" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AccessPolicy.IsLoggedIn}" Value="True">
                                        <Setter Property="Foreground" Value="#409EFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.InputBindings>
                            <MouseBinding
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                MouseAction="LeftClick" />
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBlock
                        Margin="8,0"
                        FontSize="12"
                        Foreground="#C9CEDB"
                        Text="|" />
                    <TextBlock FontSize="12" Text="当前方案" />
                    <TextBlock
                        x:Name="SolutionPathText"
                        MaxWidth="400"
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Text="{Binding Workspace.CurrentSolution.SolutionFilePath, TargetNullValue='未加载', FallbackValue='未加载'}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="#0067C0"
                        Text="&#xf2db;">
                        <TextBlock.FontFamily>
                            <StaticResource ResourceKey="Icon" />
                        </TextBlock.FontFamily>
                    </TextBlock>
                    <TextBlock
                        Width="72"
                        FontSize="12"
                        Text="{Binding CpuUsageStr}"
                        ToolTip="进程CPU占用率" />
                    <TextBlock
                        Margin="6,0"
                        FontSize="12"
                        Foreground="#C9CEDB"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#6897BB"
                        Text="&#xf538;">
                        <TextBlock.FontFamily>
                            <StaticResource ResourceKey="Icon" />
                        </TextBlock.FontFamily>
                    </TextBlock>
                    <TextBlock
                        Width="88"
                        FontSize="12"
                        Text="{Binding MemoryUsageStr}"
                        ToolTip="进程物理内存 (Working Set)" />
                    <TextBlock
                        Margin="6,0"
                        FontSize="12"
                        Foreground="#C9CEDB"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#9E9E9E"
                        Text="&#xf0e8;">
                        <TextBlock.FontFamily>
                            <StaticResource ResourceKey="Icon" />
                        </TextBlock.FontFamily>
                    </TextBlock>
                    <TextBlock
                        Width="62"
                        FontSize="12"
                        Text="{Binding ThreadCountStr}"
                        ToolTip="当前进程活动线程数" />
                    <TextBlock
                        Margin="6,0"
                        FontSize="12"
                        Foreground="#C9CEDB"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#9E9E9E"
                        Text="&#xf24d;">
                        <TextBlock.FontFamily>
                            <StaticResource ResourceKey="Icon" />
                        </TextBlock.FontFamily>
                    </TextBlock>
                    <TextBlock
                        Width="62"
                        FontSize="12"
                        Text="{Binding HandleCountStr}"
                        ToolTip="系统句柄数 (警告线: 10000)" />
                    <TextBlock
                        Margin="10,0"
                        FontSize="12"
                        Foreground="#C9CEDB"
                        Text="|" />
                    <TextBlock
                        FontSize="12"
                        Text="{Binding CurrentTimeText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
