                                                                            FontFamily="Microsoft YaHei"
                                                                            FontSize="11"
                                                                            Foreground="{StaticResource ScadaFaintTextBrush}"
                                                                            Text="{Binding Workspace.CurrentSolution.SolutionName}" />
                                                                    </StackPanel>
                                                                    <TextBlock
                                                                        HorizontalAlignment="Right"
                                                                        FontFamily="Microsoft YaHei"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                                                        Text="Esc 关闭" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ui:MenuItemEx.FlyoutTitle" Value="{x:Null}">
                                                <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F0F0F0" />
                                            </Trigger>
                                            <Trigger Property="IsSubmenuOpen" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F0F0F0" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#A0A0A0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!--  子项：28px 图标底片 + 标题/说明双行 + 右侧快捷键字母。
                              语气色由 ui:MenuItemEx.Tone 驱动；本样式只用于「文件」的 4 个子项。  -->
                        <Style x:Key="MenuFlyoutItemStyle" TargetType="MenuItem">
                            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                            <Setter Property="FontFamily" Value="Microsoft YaHei" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border
                                            x:Name="Row"
                                            MinHeight="44"
                                            Margin="0,1"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="9"
                                            SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    x:Name="Chip"
                                                    Width="28"
                                                    Height="28"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource ScadaBadgeBackgroundBrush}"
                                                    CornerRadius="8"
                                                    TextElement.FontSize="15"
                                                    TextElement.Foreground="{StaticResource ScadaSecondaryTextBrush}">
                                                    <ContentPresenter
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        ContentSource="Icon" />
                                                </Border>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="10,0,10,0"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        Text="{TemplateBinding Header}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        x:Name="Desc"
                                                        Margin="0,1,0,0"
                                                        FontSize="11"
                                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                                        Text="{Binding Path=(ui:MenuItemEx.Description), RelativeSource={RelativeSource TemplatedParent}}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                                    Text="{TemplateBinding InputGestureText}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ui:MenuItemEx.Description" Value="{x:Null}">
                                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource ScadaToolbarHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="ui:MenuItemEx.Tone" Value="Indigo">
                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource LogicIfSoftBrush}" />
                                                <Setter TargetName="Chip" Property="TextElement.Foreground" Value="{StaticResource LogicIfTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="ui:MenuItemEx.Tone" Value="Slate">
                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ScadaBadgeBackgroundBrush}" />
                                                <Setter TargetName="Chip" Property="TextElement.Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="ui:MenuItemEx.Tone" Value="Amber">
                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                                <Setter TargetName="Chip" Property="TextElement.Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="ui:MenuItemEx.Tone" Value="Green">
                                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                <Setter TargetName="Chip" Property="TextElement.Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                                                <Setter TargetName="Chip" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!--  飞菜单分隔线：只用于这几支菜单；其它菜单仍走默认分隔线。  -->
                        <Style x:Key="MenuFlyoutSeparatorStyle" TargetType="Separator">
                            <Setter Property="Height" Value="1" />
                            <Setter Property="Margin" Value="8,4" />
                            <Setter Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
