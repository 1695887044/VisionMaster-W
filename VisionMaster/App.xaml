<prism:PrismApplication
    x:Class="VisionMaster.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster"
    xmlns:prism="http://prismlibrary.com/"
    ShutdownMode="OnMainWindowClose">
    <prism:PrismApplication.Resources>
        <ResourceDictionary>
            <!--  全局图标字体：Font Awesome 6 Pro Solid（Shell 菜单/活动栏 glyph 均为 Solid 码点）  -->
            <FontFamily x:Key="Icon">pack://application:,,,/UI;component/Asserts/FontFamilys/Font Awesome 6 Pro-Solid-900.otf#Font Awesome 6 Pro Solid</FontFamily>
            <ControlTemplate x:Key="ExpandToggleButtonTemplate" TargetType="ToggleButton">
                <Border
                    Background="#FFFFFF"
                    BorderBrush="#C0C4CC"
                    BorderThickness="1"
                    CornerRadius="2">
                    <TextBlock
                        Margin="0,-1,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="#606266">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="+" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                        <Setter Property="Text" Value="-" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </ControlTemplate>

            <!--  通用链接按钮样式  -->
            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#409EFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Content}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Core.Halcon;component/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI;component/Themes/Generic.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                <!--
                    2026-10-23：把「输入域」这一册提到 Fluent 之后重挂一次。
                    原因：资源字典后合并者优先，Fluent 的隐式 TextBox / PasswordBox / Slider
                    把 UI 自绘的那三份顶掉了 —— 登录框的「显示密码」眼睛与 PlainTextHost 明码通道
                    因此从未生效（实测运行期 PasswordBox 拿到的是 Fluent 的 Padding 10,5,10,6）。
                    只重挂这一册（三类控件），不动其它册：Button / ListView / DataGrid 等仍走 Fluent，
                    R148（自定义模板里的 ToggleButton 依赖 Fluent 的 Left/Center）与 R19（GridView 让路）
                    的既有前提不变。整册顺序翻转属换肤级改动，需单独评审。
                -->
                <ResourceDictionary Source="/UI;component/Themes/Controls/Input.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </prism:PrismApplication.Resources>
</prism:PrismApplication>
