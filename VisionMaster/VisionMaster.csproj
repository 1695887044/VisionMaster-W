<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<LangVersion>preview</LangVersion>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
	<PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
	<PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
	<PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
	<PackageReference Include="Prism.Core" Version="9.0.537" />
	<PackageReference Include="Prism.Unity" Version="9.0.537" />
	<PackageReference Include="Prism.Wpf" Version="9.0.537" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Communication\VM.Communication.csproj" />
    <ProjectReference Include="..\Core\VM.Core.csproj" />
    <ProjectReference Include="..\DLL\HslCommunication\HslCommunication.csproj" />
    <ProjectReference Include="..\Engine\VM.FlowEngine.csproj" />
    <ProjectReference Include="..\Services\Core.Halcon\Core.Halcon.csproj" />
    <ProjectReference Include="..\Shard\Core.Controls\Core.Controls.csproj" />
    <ProjectReference Include="..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
    <ProjectReference Include="..\UI\Controls\UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImageView 订阅 ImageDisplayEvent 并直接操作 HImage（复制副本显示），需要编译期类型 -->
    <Reference Include="HalconDotNet">
      <HintPath>..\DLL\Halcon\halcondotnet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Shell.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
  </ItemGroup>

</Project>
