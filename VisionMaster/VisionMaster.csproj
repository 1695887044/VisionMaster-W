<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<LangVersion>preview</LangVersion>
    <UseWPF>true</UseWPF>
    <!--
      窗口/任务栏/Alt-Tab 图标。仓库此前**一份图标资源都没有**，所以主窗口与所有弹窗
      显示的都是系统默认图标。ApplicationIcon 同时喂 exe 与"没显式设 Icon 的窗口"。
      产物由 tools\bake_icons.ps1 烘焙（矢量源 → 逐尺寸原生渲染，16px 不是缩出来的）。
    -->
    <ApplicationIcon>Resources\Icons\visionmaster.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 帮助弹窗自己的窗口图标：HelpView.xaml 的 Dialog.WindowStyle 用 /VisionMaster;component/... 引它 -->
    <Resource Include="Resources\Icons\help.ico" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
	<PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
	<PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
	<PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
	<PackageReference Include="MiniExcel" Version="1.46.0" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
	<PackageReference Include="Nodify" Version="7.3.0" />
	<PackageReference Include="Prism.Core" Version="9.0.537" />
	<PackageReference Include="Prism.Unity" Version="9.0.537" />
	<PackageReference Include="Prism.Wpf" Version="9.0.537" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Communication\VM.Communication.csproj" />
    <ProjectReference Include="..\Core\VM.Core.csproj" />
    <ProjectReference Include="..\DLL\HslCommunication\HslCommunication.csproj" />
    <ProjectReference Include="..\Engine\VM.FlowEngine.csproj" />
    <ProjectReference Include="..\Scada\VM.Scada.csproj" />
    <!-- 画布宿主（ScadaCanvas）与图元控件都在这一层，编辑器面板直接拿类型用，不再反射 -->
    <ProjectReference Include="..\Scada.Controls\VM.Scada.Controls.csproj" />
    <!-- 曲线图元（Hmi.ChartTrend）。单独一个程序集：它要拖 ScottPlot → SkiaSharp
         一整套原生 runtimes，不该让"不用曲线"的引用方也背上这份重依赖。
         代价是它<b>不在</b> ElementRegistry 的自动注册里（跨程序集的静态构造不会被触发），
         必须在启动时显式调一次 ScadaChartElements.Register()——见 App.Initialize 那一行。 -->
    <ProjectReference Include="..\Scada.Controls.Charts\VM.Scada.Controls.Charts.csproj" />
    <ProjectReference Include="..\Services\Core.Halcon\Core.Halcon.csproj" />
    <!-- 数据库服务：Provider（Microsoft.Data.Sqlite）只允许出现在这一层，插件与宿主都不直接引用 -->
    <ProjectReference Include="..\Services\Core.Database\Core.Database.csproj" />
    <ProjectReference Include="..\Shard\Core.Controls\Core.Controls.csproj" />
    <ProjectReference Include="..\Shard\Core.Interfaces\Core.Interfaces.csproj" />
    <ProjectReference Include="..\UI\Controls\UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImageView 订阅 ImageDisplayEvent 并直接操作 HImage（复制副本显示），需要编译期类型 -->
    <Reference Include="HalconDotNet">
      <HintPath>..\DLL\Halcon\halcondotnet.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- HTTP 收图服务端：Watson 7.2.0。7.x 已移除 http.sys 依赖，改由自己的 TcpListener 承载，
         所以监听内网地址不需要注册 URLACL、不需要管理员权限。
         （注意别选 6.x 的 WatsonWebserver 包，那个走 http.sys，等于绕回原点。）
         本机 NuGet 还原被代理拦成 NU1301 502，故与本仓 DLL\Halcon 同范式落地离线 DLL + HintPath，
         不碰全局 NuGet 源，换任何机器都能直接编译。 -->
    <Reference Include="WatsonWebserver">
      <HintPath>..\DLL\Watson\WatsonWebserver.dll</HintPath>
    </Reference>
    <!-- WatsonWebserver 在 net8.0 分支下的 4 个传递依赖（作者自产小库，依赖组为空、无更深依赖）。
         纯 HintPath 引用不会自动带出传递依赖，必须显式声明，否则运行时装配解析会抛 FileNotFoundException。 -->
    <Reference Include="IpMatcher">
      <HintPath>..\DLL\Watson\IpMatcher.dll</HintPath>
    </Reference>
    <Reference Include="RegexMatcher">
      <HintPath>..\DLL\Watson\RegexMatcher.dll</HintPath>
    </Reference>
    <Reference Include="Timestamps">
      <HintPath>..\DLL\Watson\Timestamps.dll</HintPath>
    </Reference>
    <Reference Include="UrlMatcher">
      <HintPath>..\DLL\Watson\UrlMatcher.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      软件自带手册：编进宿主程序集（HelpCatalogService 按 "<程序集名>.Help." 前缀约定发现）。
      为什么编进程序集而不是随目录投放：部署面只有程序目录这一份，手册与程序同生共死——
      不会出现"换了台机器手册没拷过去"（与插件手册走内嵌资源同一口径）。
      新增/改名手册页 = 改这个目录下的 md 文件即可，目录顺序按文件名（01-/02-…）。
    -->
    <EmbeddedResource Include="Help\*.md" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="Shell.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <!-- 离屏断言（ScadaChecks）要复用视图里那份「菜单描述 → MenuItem」的翻译。
         在断言里照抄一份等于验的是照抄的那份，真视图里这份漏抄了字段照样漏，
         所以开放 internal 而不是把翻译提成公开 API（视图不该有对外契约）。 -->
    <InternalsVisibleTo Include="ScadaChecks" />
    <!-- 离屏断言（FlowCanvasChecks）同理：ProcessViewModel.TickRunningTimes 是纯计算
         （2026-10-10 判据放宽为 State==Running，服务并行分支步骤的实时耗时上屏），
         断言直接调它验判据，不走反射——与 CheckLinkOrder 当年"反射直调"的别扭说再见。 -->
    <InternalsVisibleTo Include="FlowCanvasChecks" />
    <!-- 渲染/主题冒烟（UIThemeSmokeTest）需要 LayoutHelper（internal）：它要对着 ShellCopy.xaml
         实例化出来的真实 DockingManager 调 ApplyScadaPanelMode / IsPanelVisible，
         验"组态三面板与算子工具箱按场景互斥"这条可见性矩阵。
         不开放就等于只能写"XAML 里出现过这段字符串"——那种断言挡不住逻辑写反。 -->
    <InternalsVisibleTo Include="UIThemeSmokeTest" />
  </ItemGroup>

</Project>
