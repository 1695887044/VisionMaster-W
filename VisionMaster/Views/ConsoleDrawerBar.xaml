<UserControl
    x:Class="VisionMaster.Views.ConsoleDrawerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:UI.Models;assembly=VM.Core"
    Height="32">

    <!--
        底部控制台抽屉条（收起态 32px）：页签 + 计数 + 最近一条摘要 + 展开箭头。

        为什么这一条挂在 Shell 的根 Grid 上、而不是放进 LogView：
        AvalonDock 4.74 的 LayoutAnchorablePane 没有 ShowHeader（只有 LayoutDocumentPane 有），
        面板只要还在停靠树里，库就一定会画自己的页签条；抽屉头放进视图内容只会被它挤没。
        详见 docs/架构文档/交接报告/交接报告-2026-10-26-底部控制台与三页签冗余核查.md §7。

        设计基线：docs/UI设计基线/app-shell/design-bottom-console.html「摘要头（推荐）」。
        本文件零硬编码色值（R140）；就地合并 Colors.xaml，断言宿主没有应用级资源（R22）。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  页签按钮：与面板页签同高（24），悬停才出底  -->
            <Style x:Key="DrawerTabButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  计数徽标  -->
            <Style x:Key="DrawerCountStyle" TargetType="Border">
                <Setter Property="Margin" Value="5,0,0,0" />
                <Setter Property="Padding" Value="5,0" />
                <Setter Property="Height" Value="15" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  箭头按钮  -->
            <Style x:Key="DrawerIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource Icon}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDrawerVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border
        Background="{StaticResource ScadaTitleBarBrush}"
        BorderBrush="{StaticResource DialogBorderBrush}"
        BorderThickness="0,1,0,1">
        <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  ① 两个入口：点哪个就展开到哪个页  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button Command="{Binding ExpandLogCommand}" ToolTip="展开控制台（日志）">
                    <Button.Style>
                        <Style BasedOn="{StaticResource DrawerTabButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePanelId}" Value="Panel_LogView">
                                    <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="控制台" />
                        <Border Style="{StaticResource DrawerCountStyle}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Normal"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding LogCount}" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ExpandMonitorCommand}" ToolTip="展开控制台（监控栏）">
                    <Button.Style>
                        <Style BasedOn="{StaticResource DrawerTabButtonStyle}" TargetType="Button">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePanelId}" Value="Panel_MonitorView">
                                    <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="监控栏" />
                        <Border Style="{StaticResource DrawerCountStyle}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Normal"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding WatchCount}" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  ② 最近一条摘要：等级点 + 来源 + 正文（超出省略，悬停看全文）  -->
            <Grid
                Grid.Column="1"
                Margin="10,0"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Ellipse
                    Grid.Column="0"
                    Width="6"
                    Height="6"
                    VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LastLevel}" Value="{x:Static models:LogLevel.Info}">
                                    <Setter Property="Fill" Value="{StaticResource DialogAccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastLevel}" Value="{x:Static models:LogLevel.Success}">
                                    <Setter Property="Fill" Value="{StaticResource DialogSuccessTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastLevel}" Value="{x:Static models:LogLevel.Warning}">
                                    <Setter Property="Fill" Value="{StaticResource DialogWarningTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LastLevel}" Value="{x:Static models:LogLevel.Error}">
                                    <Setter Property="Fill" Value="{StaticResource DialogDangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                    Text="{Binding LastSource}" />

                <TextBlock
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                    Text="{Binding LastText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding LastText}" />
            </Grid>

            <!--  ③ 错误计数 + 展开箭头  -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Margin="0,0,6,0"
                    Padding="6,0"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{StaticResource DialogDangerTextBrush}"
                    CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource DialogSurfaceBrush}"
                        Text="{Binding ErrorCount, StringFormat={}{0} 错误}" />
                </Border>

                <Button
                    Command="{Binding ToggleCommand}"
                    Style="{StaticResource DrawerIconButtonStyle}"
                    ToolTip="展开控制台（32 ↔ 240）"
                    Content="&#xf077;" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
