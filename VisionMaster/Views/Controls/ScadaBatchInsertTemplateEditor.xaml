<UserControl
    x:Class="VisionMaster.Views.Controls.ScadaBatchInsertTemplateEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="620"
    MinHeight="360"
    d:DesignHeight="420"
    d:DesignWidth="620"
    mc:Ignorable="d">

    <!--
        批量插入模板的参数编辑器。由 EasyDialog.ShowSync 承载（窗口外壳与确定/取消在那边），
        这里只有内容区。字段刻意保持扁平：模板、数量、起始序号、列数、间距、起点。
        预览/校验结果由 ViewModel 在确认时算一次，失败时把原因留在 StatusText 上。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
            </Style>

            <Style x:Key="FieldBox" TargetType="TextBox">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  模板选择  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="模板" />
            <ComboBox
                Grid.Column="1"
                Height="28"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Templates}"
                SelectedItem="{Binding SelectedTemplate}" />
        </Grid>

        <!--  数量 / 起始序号  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="生成数量" />
            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Margin="16,0,10,0" Style="{StaticResource FieldLabel}" Text="起始序号" />
            <TextBox Grid.Column="3" Style="{StaticResource FieldBox}" Text="{Binding StartIndexText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!--  列数 / 水平间距  -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="每行列数" />
            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding ColumnsText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Margin="16,0,10,0" Style="{StaticResource FieldLabel}" Text="水平间距" />
            <TextBox Grid.Column="3" Style="{StaticResource FieldBox}" Text="{Binding GapXText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!--  垂直间距 / 起点  -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="垂直间距" />
            <TextBox Grid.Column="1" Style="{StaticResource FieldBox}" Text="{Binding GapYText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Margin="16,0,10,0" Style="{StaticResource FieldLabel}" Text="起点 X / Y" />
            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource FieldBox}" Text="{Binding OriginXText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="2" Style="{StaticResource FieldBox}" Text="{Binding OriginYText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>

        <!--  模板摘要  -->
        <TextBlock
            Grid.Row="4"
            Margin="90,0,0,8"
            FontSize="11"
            Foreground="{StaticResource ScadaSecondaryTextBrush}"
            Text="{Binding TemplateSummary}"
            TextTrimming="CharacterEllipsis" />

        <!--  校验/警告结果  -->
        <Border
            Grid.Row="5"
            Padding="10"
            Background="{StaticResource ScadaPanelBackgroundBrush}"
            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock
                    FontSize="11.5"
                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
