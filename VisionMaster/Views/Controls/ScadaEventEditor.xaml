<UserControl
    x:Class="VisionMaster.Views.Controls.ScadaEventEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="120"
    d:DesignWidth="260"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  「事件 + 动作表」编辑器（公共控件）  -->
    <!--  DataContext = ScadaEventEditorViewModel（由使用方给）。  -->
    <!--  两个消费者：① 属性面板的事件行（图元事件 / 画面事件）；  -->
    <!--  ② 独立的「变量事件」弹窗（变量级 5 类事件）。  -->
    <!--  编辑逻辑全在 ViewModel 里，本文件只负责摆控件——  -->
    <!--  所以加一种宿主，这里一行都不用改；加一类动作则只需补一块"这类动作要填什么"的编辑区  -->
    <!--  （判据用模型上的布尔位，别在 XAML 里堆一串 DataTrigger，见运动命令族那块的注释）。  -->
    <!--  ==========================================  -->

    <!--  颜色令牌：与属性面板同一本字典（值集中在 UI/Controls/Themes/Colors.xaml）。  -->
    <!--  这里再合并一次是让控件"自带口粮"：脱离 App / 面板单独量也照样渲染，  -->
    <!--  而不是抛 XamlParseException 说找不到 ScadaActionCardBorderBrush。  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolVis" />

            <!--  v2 工具提示：与属性面板同一份视觉（墨黑底白字、最大宽 240、12px/1.45）。
                  本控件是独立 UserControl，属性面板的隐式样式管不到这里，所以自带一份；
                  作用域仅本控件，不影响别的面板。  -->
            <Style TargetType="ToolTip">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border
                                MaxWidth="240"
                                Padding="8,7"
                                Background="{StaticResource ScadaTooltipBackgroundBrush}"
                                CornerRadius="8">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaTooltipTextBrush}" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="LineHeight" Value="17.4" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  动作行里那三个小按钮共用：正方形、无边框感，密集排布不抢视线  -->
            <Style x:Key="ActionIconButton" TargetType="Button">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                <Style.Triggers>
                    <!--  到了端点（已经在最上面 / 最下面）按钮会变灰。
                          必须显式写这一条：显式 Style 会整个盖掉主题里的禁用态触发器，
                          而上面那句 Foreground 又压过了主题的灰字，不补就等于
                          "点不动的按钮和能点的长得一模一样"——最伤信任的一种界面。  -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource ScadaDisabledTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  一条动作：第一行选"干什么"和调顺序，第二行填这条动作的参数。
                  两行而不是挤一行：面板统共 260px 宽，一行里塞下"下拉框 + 参数 + 三个按钮"
                  之后留给日志文案的宽度不够写一句人话。  -->
            <DataTemplate x:Key="ActionItem">
                <Border
                    Margin="0,2,0,0"
                    Padding="5,4"
                    Background="{StaticResource ScadaSurfaceBrush}"
                    BorderBrush="{StaticResource ScadaActionCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  下拉的候选与命令都挂在编辑器视图模型上（本模板的 DataContext 是单条动作），
                                  AncestorType=ItemsControl 取到的正是动作表那个 ItemsControl，
                                  它的 DataContext 就是 ScadaEventEditorViewModel。  -->
                            <ComboBox
                                Grid.Column="0"
                                FontSize="11"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding DataContext.ActionTypeChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                SelectedValue="{Binding Type, Mode=TwoWay}"
                                SelectedValuePath="Type"
                                ToolTip="这条动作要干什么" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding DataContext.MoveActionUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="↑"
                                Style="{StaticResource ActionIconButton}"
                                ToolTip="上移（越靠上越先执行）" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding DataContext.MoveActionDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="↓"
                                Style="{StaticResource ActionIconButton}"
                                ToolTip="下移" />
                            <Button
                                Grid.Column="3"
                                Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="✕"
                                Style="{StaticResource ActionIconButton}"
                                ToolTip="删除这条动作" />
                        </Grid>

                        <!--  日志文案 / 播报文本：两种动作共用这一个框（都是自由文本）。
                              「语音播报」里可写 {变量名}，运行态按当前值替换（见 ScadaTextTemplate）。  -->
                        <TextBox
                            Margin="0,3,0,0"
                            Padding="3,2"
                            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                            FontSize="11"
                            Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                            ToolTip="记录日志：留空则记录「图元名 + 事件名」。语音播报：要念的话，可写 {变量名} 按当前值替换，如「一号罐液位 {T101} 毫米」">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Log">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="SpeakText">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!--  写变量：先选目标变量，再填要写进去的值。
                              目标变量存"身份 + 名字"两份，Id 优先、名字只用于显示与兜底寻址，
                              回填与寻址的口径在 ScadaAction.BindVariable 一处，这里只管展示。  -->
                        <StackPanel Margin="0,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="WriteVariable">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Increment">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="Decrement">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  名字为空（=还没选）时由 TargetNullValue 顶上一句占位文案，
                                      省掉一个"空/非空"双控件互斥的触发器  -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding VariableDisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding VariableDisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVariable}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button
                                    Grid.Column="1"
                                    Padding="6,1"
                                    FontSize="11"
                                    Command="{Binding DataContext.PickVariableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="选择变量"
                                    ToolTip="从当前方案的变量清单里挑一个" />
                            </Grid>

                            <TextBox
                                Margin="0,3,0,0"
                                Padding="3,2"
                                BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                FontSize="11"
                                Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                ToolTip="要写进变量的值（按变量类型转换，转不过去执行时会记一条错误）">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="WriteVariable">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!--  增量/减量：步长 + 可选上下限。读当前值再写回，避免为每个档位配一条写变量。  -->
                            <StackPanel Margin="0,3,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Increment">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Decrement">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                        <TextBlock FontSize="10" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="步长" />
                                        <TextBox
                                            Margin="0,2,0,0"
                                            Padding="3,2"
                                            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                            FontSize="11"
                                            Text="{Binding Step, UpdateSourceTrigger=LostFocus, TargetNullValue=1}"
                                            ToolTip="每次加/减多少；必须大于 0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                        <TextBlock FontSize="10" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="下限" />
                                        <TextBox
                                            Margin="0,2,0,0"
                                            Padding="3,2"
                                            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                            FontSize="11"
                                            Text="{Binding Min, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="留空 = 不夹紧；0 是合法下限" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                        <TextBlock FontSize="10" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="上限" />
                                        <TextBox
                                            Margin="0,2,0,0"
                                            Padding="3,2"
                                            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                            FontSize="11"
                                            Text="{Binding Max, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="留空 = 不夹紧" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!--  没选变量：执行侧会照实警告并跳过，先把这件事说在界面上  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource ScadaWarningBrush}"
                                Text="还没选变量，这条动作运行时会跳过。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVariable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!--  位操作（置位 / 复位 / 取反，v4）：选目标变量 + 填位号。
                              位号口径：留空 = Bool 变量整体写（置位=true / 复位=false / 取反=!当前值）；
                              0~31 = 整型变量里的一位（读-改-写，其余位不动），且不得超过该类型位宽
                              （byte 只有 0~7）。位宽只有执行侧知道，所以这里不预判，只把口径写在提示里。
                              可见性判据用 ScadaAction.IsBitAction 而不是三个 DataTrigger，理由同运动族：
                              这份"哪些类型算位操作"的知识只该存在领域层一处。  -->
                        <StackPanel Margin="0,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBitAction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  名字为空（=还没选）时由 TargetNullValue 顶上一句占位文案，
                                      省掉一个"空/非空"双控件互斥的触发器  -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding VariableDisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding VariableDisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVariable}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button
                                    Grid.Column="1"
                                    Padding="6,1"
                                    FontSize="11"
                                    Command="{Binding DataContext.PickVariableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="选择变量"
                                    ToolTip="从当前方案的变量清单里挑一个（Bool 或整型）" />
                            </Grid>

                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="位号：" />

                                <!--  空输入框对 int? 落 null（= Bool 整体写），所以这里不设默认值；
                                      TargetNullValue 只负责把"空着"这件事显示成一句话，不改模型语义  -->
                                <TextBox
                                    Grid.Column="1"
                                    Padding="3,2"
                                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                    FontSize="11"
                                    Text="{Binding BitIndex, UpdateSourceTrigger=LostFocus, TargetNullValue=（Bool 留空）}"
                                    ToolTip="0~31；Bool 变量可留空（整体写），整型必须填且不超过该类型位宽（byte 0~7 / short 0~15 / int 0~31）" />
                            </Grid>

                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10"
                                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                Text="留空 = Bool 整体写；整型必须填位号，越界或类型不符时运行日志会记一条错误。"
                                TextWrapping="Wrap" />

                            <!--  没选变量：执行侧会照实警告并跳过，先把这件事说在界面上  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource ScadaWarningBrush}"
                                Text="还没选变量，这条动作运行时会跳过。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVariable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!--  播放声音 / 语音播报：只选档位，不改变任何变量。
                              「播放声音」按 Info/Warning/Critical 播提示音；
                              「语音播报」用同一档位表达这句话有多急（严重的会打断正在念的低级别）。  -->
                        <StackPanel Margin="0,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="PlaySound">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="SpeakText">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock
                                Margin="0,0,0,3"
                                FontSize="11"
                                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                Text="档位"
                                ToolTip="提示音的音调；语音播报用它表达紧急程度（严重的会打断正在念的低级别）" />
                            <ComboBox
                                FontSize="11"
                                SelectedValue="{Binding SoundKind, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="提示" Tag="Info" />
                                <ComboBoxItem Content="警告" Tag="Warning" />
                                <ComboBoxItem Content="严重" Tag="Critical" />
                            </ComboBox>
                        </StackPanel>

                        <!--  条件动作（P0）：只给写变量用。典型配置是「暂停流程」后面跟一条
                              WriteVariable(Paused=1)，勾上后暂停失败/被跳过时不会把页面写成“已暂停”。  -->
                        <CheckBox
                            Margin="0,4,0,0"
                            FontSize="11"
                            Content="仅在上一条成功时执行"
                            IsChecked="{Binding OnlyIfPreviousSucceeded, Mode=TwoWay}"
                            ToolTip="上一条动作被跳过或失败时，本条不执行；用于“暂停成功后才写状态变量”这类联动">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="WriteVariable">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <!--  切换画面：只需选一个目标画面。
                              目标画面存"身份 + 名字"两份，Id 优先、名字只用于显示与兜底寻址，
                              回填与寻址的口径在 ScadaAction.BindPage 一处，这里只管展示。
                              与"写变量"不同，这条动作没有"值"要填，所以只有一个选画面的入口。  -->
                        <StackPanel Margin="0,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Navigate">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="OpenPopup">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  名字为空（=还没选）时由 TargetNullValue 顶上一句占位文案，
                                      省掉一个"空/非空"双控件互斥的触发器  -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding TargetPageName, TargetNullValue=（还没选画面）}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding TargetPageName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTargetPage}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button
                                    Grid.Column="1"
                                    Padding="6,1"
                                    FontSize="11"
                                    Command="{Binding DataContext.PickPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="选择画面"
                                    ToolTip="从当前方案的画面清单里挑一个" />
                            </Grid>

                            <!--  没选画面：执行侧会照实警告并跳过，先把这件事说在界面上  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource ScadaWarningBrush}"
                                Text="还没选画面，这条动作运行时会跳过。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTargetPage}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!--  流程动作（启动 / 暂停 / 恢复 / 停止 / 执行一次）：参数形状一模一样（就一个目标流程），
                              共用这一块面板，按类型三选一显形。目标流程存"身份 + 名字"两份，
                              Id 优先、名字只用于显示与兜底寻址，回填与寻址的口径在 ScadaAction.BindFlow 一处。  -->
                        <StackPanel Margin="0,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="StartFlow">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="StopFlow">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="RunFlowOnce">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="PauseFlow">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Type}" Value="ResumeFlow">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  名字为空（=还没选）时由 TargetNullValue 顶上一句占位文案，
                                      省掉一个"空/非空"双控件互斥的触发器  -->
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding FlowName, TargetNullValue=（还没选流程）}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding FlowName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFlow}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button
                                    Grid.Column="1"
                                    Padding="6,1"
                                    FontSize="11"
                                    Command="{Binding DataContext.PickFlowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="选择流程"
                                    ToolTip="从当前方案的流程清单里挑一条" />
                            </Grid>

                            <!--  没选流程：执行侧会照实警告并跳过，先把这件事说在界面上  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource ScadaWarningBrush}"
                                Text="还没选流程，这条动作运行时会跳过。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFlow}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!--  应用配方（方案级）：只需选一个目标配方。目标存"身份 + 名字"两份，
                              Id 优先、名字只用于显示与兜底寻址，回填口径在 ScadaAction.BindRecipe 一处。
                              与"切换画面"同形：这条动作没有值要填，只有一个选择入口。  -->
                        <StackPanel Margin="0,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="ApplyRecipe">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding TargetRecipeName, TargetNullValue=（还没选配方）}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding TargetRecipeName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRecipe}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button
                                    Grid.Column="1"
                                    Padding="6,1"
                                    FontSize="11"
                                    Command="{Binding DataContext.PickRecipeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="选择配方"
                                    ToolTip="从当前方案的配方清单里挑一条" />
                            </Grid>

                            <!--  没选配方：执行侧会照实警告并跳过，先把这件事说在界面上  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource ScadaWarningBrush}"
                                Text="还没选配方，这条动作运行时会跳过。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecipe}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!--  运动命令族（轴使能 / 失能 / 绝对定位 / 相对定位 / 回零 / 停止 / 清报警 / 点动开始 / 点动结束）：
                              一条运动动作只操作一根轴，所以这里只有一个「选轴」入口；
                              定位类动作再多两格"目标 / 速度"，点动多一格"方向"。
                              可见性判据用 ScadaAction.IsMotionAction 而不是九个 DataTrigger：
                              WPF 的 DataTrigger 只能判等、不支持"属于集合"，九个触发器写在一处
                              既容易漏（加一种运动动作就要记得补第九行）又看不出意图。
                              这份"哪些类型算运动动作"的知识留在领域层一处，模板只问"是不是"。  -->
                        <StackPanel Margin="0,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMotionAction}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="轴：" />

                                <!--  三种状态都要看得见（名字 / 只剩 Id / 还没选），所以绑 AxisDisplayName
                                      而不是 AxisName：只绑名字的话，"选了轴但名字为空"会显示成占位文案，
                                      用户以为没配、其实执行侧会按 Id 找到那根轴。  -->
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding AxisDisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding AxisDisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAxis}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!--  单选：一条运动动作只操作一根轴，所以走 PickSingle（弹窗里勾一行会取消其它行）  -->
                                <Button
                                    Grid.Column="2"
                                    Padding="6,1"
                                    Command="{Binding DataContext.PickAxisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="选轴"
                                    FontSize="11"
                                    ToolTip="从当前方案里已启用的轴中挑一根" />
                            </Grid>

                            <!--  定位类才填目标与速度。
                                  目标：绝对定位 = 目标点；相对定位 = 增量（可为负）。
                                  速度留空 / 填 0 都表示用卡级默认值（与 MotionCommand.VelocityMmPerS 的约定一致），
                                  所以这里不逼用户填——卡级默认在「运动卡设置」里已经配过一遍。
                                  两格的占位由 TargetNullValue 给（源为 null 时显示，不改模型语义：
                                  清空输入框仍然落 null，"没填"与"填了 0"始终分得开，0 mm 是合法目标）。
                                  缺值的后果也写在下面那行橙字里——占位文案只是"看着像填了"，不是填了。  -->
                            <StackPanel Margin="0,3,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="MotionMoveAbsolute">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="MotionMoveRelative">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="目标(mm)：" />

                                    <TextBox
                                        Grid.Column="1"
                                        Padding="3,2"
                                        BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                        FontSize="11"
                                        Text="{Binding TargetMm, UpdateSourceTrigger=LostFocus, TargetNullValue=未填}"
                                        ToolTip="绝对定位=目标点；相对定位=增量（可为负）" />
                                </Grid>

                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="速度(mm/s)：" />

                                    <TextBox
                                        Grid.Column="1"
                                        Padding="3,2"
                                        BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                        FontSize="11"
                                        Text="{Binding VelocityMmPerS, UpdateSourceTrigger=LostFocus, TargetNullValue=卡级默认}"
                                        ToolTip="留空或填 0 = 用卡级默认速度" />
                                </Grid>

                                <!--  没填目标：执行侧会照实警告并跳过，先把这件事说在界面上。
                                      判据直接看 TargetMm 是否为 null（而不是看某个"空/非空"布尔位）：
                                      这里要区分的就是"没填"与"填了 0"，只有可空类型答得出。  -->
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaWarningBrush}"
                                    Text="还没填目标位置，这条动作运行时会跳过。"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TargetMm}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!--  点动方向：只有「点动开始」需要。
                                  方向刻意复用 TargetMm 的正负号（不新增枚举字段）：
                                  动作表里"往哪边走"与"走到哪"不需要同时出现，多一个只在 1/9 种动作上
                                  有意义的字段，落盘与界面都要多解释一遍。  -->
                            <Grid Margin="0,3,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="MotionJogStart">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="方向：" />

                                <TextBox
                                    Grid.Column="1"
                                    Padding="3,2"
                                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                    FontSize="11"
                                    Text="{Binding TargetMm, UpdateSourceTrigger=LostFocus, TargetNullValue=正向}"
                                    ToolTip="正数 = 正向，负数 = 反向；留空按正向" />
                            </Grid>

                            <!--  没选轴：执行侧会照实警告并跳过，先把这件事说在界面上  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource ScadaWarningBrush}"
                                Text="还没选轴，这条动作运行时会跳过。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAxis}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--  点动开始没有"松手"这个手势（一个按钮只触发一次），靠的是「点动结束」动作
                                  或执行器里的看门狗兜底。这件事必须写在界面上：用户以为"点一下就动一下"，
                                  结果轴一直走，是最容易出事的误解。  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                Text="点动会一直走，直到同一条钩子里的「点动结束」动作，或看门狗超时兜底停止。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="MotionJogStart">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!--  还没接通的动作：说明"为什么现在配了也不会响"。
                              文案来自领域层（ScadaAction.PendingReason），与运行日志里那句逐字相同，
                              用户才能把"我配的这条"和"日志里那条"对上号。  -->
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="11"
                            Foreground="{StaticResource ScadaWarningBrush}"
                            Text="{Binding PendingReason}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingReason}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  v2 事件折叠卡（2026-10-28）：勾选管「配没配」，箭头管展开，摘要常显。
          卡头在配置中时用主色柔底；动作表有边界，不再悬浮在面板底色上。  -->
    <Border
        Margin="0,2,0,2"
        Padding="6,4"
        Background="{StaticResource ScadaSurfaceBrush}"
        BorderBrush="{StaticResource ScadaActionCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        ToolTip="{Binding Description}">
        <StackPanel>
            <Border Padding="5,3" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ScadaAccentSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="{Binding DisplayName}"
                        FontSize="12"
                        IsChecked="{Binding IsConfigured, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Text="{Binding Summary}"
                        Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ScadaAccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SummaryIsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ToggleButton
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Focusable="False"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                        ToolTip="展开 / 收起动作表"
                        Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent">
                                    <Path
                                        x:Name="Chevron"
                                        Width="9"
                                        Height="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 0 0 L 4.5 4.5 L 9 0"
                                        RenderTransformOrigin="0.5,0.5"
                                        Stroke="{StaticResource ScadaSecondaryTextBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.4" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>

            <!--  动作区：配了 + 展开才出现  -->
            <StackPanel
                Margin="16,4,0,2"
                Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolVis}}">
                <!--  P0：执行前确认。默认关闭；勾上后运行态命中该事件先弹确认框，取消则整串动作都不执行。  -->
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        Content="执行前确认"
                        FontSize="12"
                        IsChecked="{Binding RequireConfirmation, Mode=TwoWay}" />
                    <Border
                        Margin="8,0,0,0"
                        Padding="5,1"
                        BorderThickness="1"
                        BorderBrush="{StaticResource ScadaDangerBrush}"
                        CornerRadius="4"
                        Visibility="{Binding IsDangerous, Converter={StaticResource BoolVis}}">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ScadaDangerBrush}"
                            Text="危险动作" />
                    </Border>
                </StackPanel>

                <TextBox
                    Margin="0,4,0,0"
                    Padding="6,3"
                    FontSize="11"
                    Text="{Binding ConfirmationMessage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                    ToolTip="留空则使用默认提示：将执行：动作摘要。"
                    Visibility="{Binding RequireConfirmation, Converter={StaticResource BoolVis}}" />

                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                    Text="运行态命中该事件时先弹确认框；取消则整串动作都不执行。"
                    TextWrapping="Wrap"
                    Visibility="{Binding RequireConfirmation, Converter={StaticResource BoolVis}}" />

                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                    Text="动作（自上而下依次执行）：" />

                <ItemsControl ItemTemplate="{StaticResource ActionItem}" ItemsSource="{Binding Actions}" />

                <!--  配了钩子却把动作删光了：执行侧当"没配"处理，必须说出来，
                      否则用户会以为"我明明勾上了"  -->
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Foreground="{StaticResource ScadaWarningBrush}"
                    Text="还没有动作，运行态命中该事件时不会有任何反应，也不会弹确认框。请先添加动作。"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Actions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button
                    Margin="0,4,0,0"
                    Padding="6,2"
                    HorizontalAlignment="Left"
                    Command="{Binding AddActionCommand}"
                    Content="+ 添加动作"
                    FontSize="11"
                    ToolTip="新动作默认是「记录日志」，改文案即可用" />
            </StackPanel>
        </StackPanel>
