<UserControl
    x:Class="VisionMaster.Views.Controls.ScadaReportColumnsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="360"
    d:DesignWidth="820"
    mc:Ignorable="d">

    <!--
        报表的「配置列」编辑器：与数据表格的列编辑器同一套版式（ItemsControl + 定宽 Grid），
        差别只有字段：报表列绑的是<b>账本列名</b>，且多一个"聚合方式"。

        由 EasyDialog.ShowSync 承载（它提供窗口外壳与取消/确定），这里只有内容区。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  本视图自带口粮（R22）：脱离 App 单独渲染时也能取到令牌  -->
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
                <!--  行内下拉的 DialogComboCompact 在同一册里（断言宿主单独加载本视图时也要解析得到）  -->
                <ResourceDictionary Source="/UI;component/Themes/Dialog/Dialog.Input.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CellBox" TargetType="TextBox">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--  行内按钮：24×24 + Padding=0（R68）  -->
            <Style x:Key="RowButton" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!--  来源列为空 = 这一列还没配完：就地标红（确认时会被丢掉，但用户得先看见）  -->
            <Style x:Key="SourceBox" TargetType="TextBox" BasedOn="{StaticResource CellBox}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasSource}" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource ScadaDangerBrush}" />
                        <Setter Property="Background" Value="{StaticResource ScadaInvalidBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="ColumnRow">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        Style="{StaticResource SourceBox}"
                        Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="账本 CSV 里的列名（去空白、忽略大小写精确匹配）；留空的行确认时会被丢掉" />
                    <TextBox
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="报表上显示的列名；留空就用来源列名" />
                    <TextBox
                        Grid.Column="2"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="数值格式（如 0.00 / 0）；空 = 0.###。非数值单元格原样显示" />
                    <ComboBox Style="{StaticResource DialogComboCompact}"
                        Grid.Column="3"
                        Height="26"
                        Margin="0,0,6,0"
                        VerticalContentAlignment="Center"
                        FontSize="11.5"
                        SelectedValue="{Binding Aggregate, Mode=TwoWay}"
                        SelectedValuePath="Tag"
                        ToolTip="汇总模式下这一列怎么算；明细模式忽略">
                        <ComboBoxItem Content="不聚合" Tag="None" />
                        <ComboBoxItem Content="求和" Tag="Sum" />
                        <ComboBoxItem Content="平均" Tag="Average" />
                        <ComboBoxItem Content="最小" Tag="Min" />
                        <ComboBoxItem Content="最大" Tag="Max" />
                        <ComboBoxItem Content="计数" Tag="Count" />
                        <ComboBoxItem Content="末值" Tag="Last" />
                    </ComboBox>
                    <TextBox
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="列宽（像素）；填 0 = 占满剩余宽度" />

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button
                            Click="OnMoveUp"
                            Content="↑"
                            Style="{StaticResource RowButton}"
                            ToolTip="上移" />
                        <Button
                            Click="OnMoveDown"
                            Content="↓"
                            Style="{StaticResource RowButton}"
                            ToolTip="下移" />
                        <Button
                            Click="OnRemove"
                            Content="✕"
                            Style="{StaticResource RowButton}"
                            ToolTip="删除这一列" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinWidth="820" MaxHeight="460" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  表头：与行同宽同序（不绑数据，纯标注）  -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="来源列（账本表头）" />
            <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="报表列名" />
            <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="格式" />
            <TextBlock Grid.Column="3" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="聚合" />
            <TextBlock Grid.Column="4" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="宽度" />
            <TextBlock Grid.Column="5" Width="80" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="操作" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplate="{StaticResource ColumnRow}" ItemsSource="{Binding Rows}" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,0"
            Orientation="Horizontal">
            <Button
                Padding="12,4"
                Click="OnAdd"
                Content="＋ 添加列"
                Cursor="Hand" />
            <Button
                Margin="6,0,0,0"
                Padding="12,4"
                Click="OnImportFromLedger"
                Content="从账本导入列"
                Cursor="Hand"
                ToolTip="读当前方案 History 目录下最新的账本 CSV 的表头，一键生成整张列配置（会替换现有列）" />
            <TextBlock
                x:Name="ImportHintText"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource ScadaFaintTextBrush}"
                Text="来源列必须与账本表头一致；宽度填 0 = 占满剩余；汇总模式按「聚合」列计算"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
