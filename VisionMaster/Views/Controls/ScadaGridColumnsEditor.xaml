<UserControl
    x:Class="VisionMaster.Views.Controls.ScadaGridColumnsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="360"
    d:DesignWidth="760"
    mc:Ignorable="d">

    <!--
        数据表格的「配置列」编辑器（设计基线 docs/UI设计基线/scada-datagrid/ §03）。

        由 EasyDialog.ShowSync 承载（它提供窗口外壳与取消/确定），这里只有内容区。
        刻意不用 ListView/DataGrid：行内是可编辑输入框，而 R19-R21 那套表格纪律
        （GridListViewStyle / GridViewRowPresenter）是为只读列表定的；这里用
        ItemsControl + 定宽 Grid，列宽与表头天然对齐，也不会被 Fluent 的隐式样式顶掉。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  本视图自带口粮（R22）：脱离 App 单独渲染时也能取到令牌  -->
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CellBox" TargetType="TextBox">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--  行内按钮：24×24 + Padding=0（R68：图标字符按钮必须自己定内边距，
                  否则会吃应用级 Fluent 隐式 Button 样式的 11,5,11,6，把字形削掉）  -->
            <Style x:Key="RowButton" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!--  变量名为空 = 这一列还没配完：就地标红（确认时会被丢掉，但用户得先看见）  -->
            <Style x:Key="VariableBox" TargetType="TextBox" BasedOn="{StaticResource CellBox}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasVariable}" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource ScadaDangerBrush}" />
                        <Setter Property="Background" Value="{StaticResource ScadaInvalidBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="ColumnRow">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="表头；留空就用变量名" />
                    <TextBox
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        Style="{StaticResource VariableBox}"
                        Text="{Binding Variable, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="取哪个变量的值（按名字解析，精确匹配）；留空的行确认时会被丢掉" />
                    <TextBox
                        Grid.Column="2"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="列宽（像素）；填 0 = 占满剩余宽度" />
                    <ComboBox
                        Grid.Column="3"
                        Height="26"
                        Margin="0,0,6,0"
                        FontSize="11.5"
                        SelectedValue="{Binding Align, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="左对齐" Tag="left" />
                        <ComboBoxItem Content="居中" Tag="center" />
                        <ComboBoxItem Content="右对齐" Tag="right" />
                    </ComboBox>
                    <TextBox
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="格式串（如 F2 / HH:mm:ss）；空 = 默认" />

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Button
                            Click="OnMoveUp"
                            Content="↑"
                            Style="{StaticResource RowButton}"
                            ToolTip="上移" />
                        <Button
                            Click="OnMoveDown"
                            Content="↓"
                            Style="{StaticResource RowButton}"
                            ToolTip="下移" />
                        <Button
                            Click="OnRemove"
                            Content="✕"
                            Style="{StaticResource RowButton}"
                            ToolTip="删除这一列" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinWidth="760" MaxHeight="460" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  表头：与行同宽同序（不绑数据，纯标注）  -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="表头" />
            <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="绑定变量" />
            <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="宽度" />
            <TextBlock Grid.Column="3" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="对齐" />
            <TextBlock Grid.Column="4" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="格式" />
            <TextBlock Grid.Column="5" Width="80" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="操作" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplate="{StaticResource ColumnRow}" ItemsSource="{Binding Rows}" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,0"
            Orientation="Horizontal">
            <Button
                Padding="12,4"
                Click="OnAdd"
                Content="＋ 添加列"
                Cursor="Hand" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource ScadaFaintTextBrush}"
                Text="宽度填 0 = 占满剩余；变量名为空的行会被丢掉" />
        </StackPanel>
    </Grid>
</UserControl>
