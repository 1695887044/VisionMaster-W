<UserControl
    x:Class="VisionMaster.Views.Controls.ScadaChartSeriesEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="360"
    d:DesignWidth="640"
    mc:Ignorable="d">

    <!--
        柱状图 / 饼图的「数据项」编辑器（设计基线 scada-chart-alarmtable §1/§4）。

        与报表列编辑器同构（构造 → 编辑 → 读 ResultJson → 丢弃），差别只在字段：
        这里每行是「标签 + 变量名 + 颜色」，没有聚合与格式。
        刻意不共享同一个控件：报表列绑的是账本列名，图表项绑的是工程变量，语义不同。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  本视图自带口粮（R22）：脱离 App 单独渲染时也能取到令牌  -->
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CellBox" TargetType="TextBox">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--  行内按钮 24×24 + Padding=0（R68）  -->
            <Style x:Key="RowButton" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!--  变量名为空 = 这一项还没配完：就地标红（确认时会被丢掉）  -->
            <Style x:Key="VariableBox" TargetType="TextBox" BasedOn="{StaticResource CellBox}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasVariable}" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource ScadaDangerBrush}" />
                        <Setter Property="Background" Value="{StaticResource ScadaInvalidBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="SeriesRow">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="轴/图例上的文字；留空就用变量名" />
                    <!--
                        绑定变量：输入框 + 「选…」按钮。
                        只给输入框是不够的——现场没人愿意手打变量名（大小写、空格、重名都靠猜）。
                        按钮走宿主注入的 IScadaVariablePicker，与事件编辑器选变量同一个弹窗。
                    -->
                    <Grid Grid.Column="1" Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Style="{StaticResource VariableBox}"
                            Text="{Binding Variable, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="取值变量名（与工程变量同名，精确匹配）；留空的行确认时会被丢掉" />
                        <Button
                            Grid.Column="1"
                            Width="26"
                            Height="26"
                            Margin="4,0,0,0"
                            Padding="0"
                            Click="OnPickVariable"
                            Content="…"
                            Cursor="Hand"
                            ToolTip="从工程变量里选一个" />
                    </Grid>
                    <!--
                        颜色改成调色板下拉（2026-10-26 用户反馈）：原来是一个空文本框，
                        要人记住 #RRGGBB 手打——现场没人这么干。
                        「自动」= 留空，由图表按顺序取调色板；选了具体色则写死该色。
                    -->
                    <ComboBox
                        Grid.Column="2"
                        Height="26"
                        Margin="0,0,6,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="11.5"
                        ItemsSource="{Binding ColorOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        DisplayMemberPath="Label"
                        SelectedValue="{Binding Color, Mode=TwoWay}"
                        SelectedValuePath="Tag"
                        ToolTip="颜色；「自动」= 按图表调色板顺序取色" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button
                            Click="OnMoveUp"
                            Content="↑"
                            Style="{StaticResource RowButton}"
                            ToolTip="上移" />
                        <Button
                            Click="OnMoveDown"
                            Content="↓"
                            Style="{StaticResource RowButton}"
                            ToolTip="下移" />
                        <Button
                            Click="OnRemove"
                            Content="✕"
                            Style="{StaticResource RowButton}"
                            ToolTip="删除这一项" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinWidth="640" MaxHeight="460" Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="标签" />
            <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="绑定变量" />
            <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="颜色" />
            <TextBlock Grid.Column="3" Width="80" FontSize="11" Foreground="{StaticResource ScadaSecondaryTextBrush}" Text="操作" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemTemplate="{StaticResource SeriesRow}" ItemsSource="{Binding Rows}" />
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,0"
            Orientation="Horizontal">
            <Button
                Padding="12,4"
                Click="OnAdd"
                Content="＋ 添加数据项"
                Cursor="Hand" />
            <TextBlock
                x:Name="HintText"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource ScadaFaintTextBrush}"
                Text="每行一项；变量名为空的行会被丢掉；颜色留空 = 自动配色"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
