<UserControl
    x:Class="VisionMaster.Views.ScadaToolboxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="220"
    prism:ViewModelLocator.AutoWireViewModel="True"
    PreviewMouseMove="OnPreviewMouseMove"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  图元工具箱（S3-c）  -->
    <!--  内容全从 ElementRegistry 来：加一类图元 = 注册一条描述符，这里自动多一行。  -->
    <!--  本面板只负责"起拖"，不负责"放下"——放置要按画布的缩放/平移/吸附换算，  -->
    <!--  那是画布那边的事（见 ScadaEditorView 的 Drop）。两边靠 ScadaDrag 这一个协议串起来。  -->
    <!--  ==========================================  -->

    <!-- Border 只负责画右侧 1px 分隔线：Grid 没有 BorderBrush 属性（MC3072），边框必须挂在 Border 上 -->
    <Border
        Background="#FFF7F8FA"
        BorderBrush="#FFDCE0E6"
        BorderThickness="0,0,1,0">
        <Grid>
        <Grid.Resources>
            <!--  工具箱条目：手型提示可拖；按下只记意，起拖的判断挂在本视图根节点（原因见代码后台）  -->
            <DataTemplate x:Key="ItemTemplate">
                <Border
                    Height="28"
                    Margin="0,1"
                    Padding="8,0"
                    Background="Transparent"
                    CornerRadius="3"
                    Cursor="Hand"
                    PreviewMouseLeftButtonDown="OnItemPreviewMouseLeftButtonDown"
                    ToolTip="{Binding Description}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFE3EEF9" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="#FF303133"
                            Text="{Binding DisplayName}" />
                        <!--  类型键是调试时要看的东西（画布上出了个不认识的框，第一个问题就是"它到底注册的谁"），  -->
                        <!--  所以摆出来，但压成次要色，不跟名字抢视线  -->
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#FFA8ABB2"
                            Text="{Binding TypeKey}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ====================  标题  ====================  -->
        <Grid Grid.Row="0" Margin="10,10,10,6">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#FF303133"
                Text="图元工具箱" />
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="#FF909399"
                Text="{Binding TotalCount, StringFormat='共 {0} 种'}" />
        </Grid>

        <!--  ====================  搜索  ====================  -->
        <Grid
            Grid.Row="1"
            Margin="10,0,10,8">
            <TextBox
                x:Name="SearchBox"
                Padding="6,4"
                VerticalContentAlignment="Center"
                FontSize="12"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <!--  占位提示：WPF 的 TextBox 没有原生水印，就盖一个 TextBlock 上去，有字就藏。  -->
            <!--  IsHitTestVisible=False 是必须的，不然这层会把点击吃掉，搜索框永远聚不了焦。  -->
            <TextBlock
                Margin="7,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#FFC0C4CC"
                IsHitTestVisible="False"
                Text="搜索图元（名称 / 类型键 / 分类）">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!--  ====================  分组列表  ====================  -->
        <ScrollViewer
            Grid.Row="2"
            Margin="6,0,6,8"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander
                            Margin="0,2"
                            FontSize="12"
                            IsExpanded="True">
                            <Expander.Header>
                                <!--  分类名 + 数量：一眼能看出这组有没有被搜索词过滤掉  -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="#FF606266"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="#FF909399"
                                        Text="{Binding Items.Count, StringFormat=({0})}" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl
                                Margin="14,2,0,2"
                                ItemTemplate="{StaticResource ItemTemplate}"
                                ItemsSource="{Binding Items}" />
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
