<UserControl
    x:Class="VisionMaster.Views.ScadaPropertyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="260"
    prism:ViewModelLocator.AutoWireViewModel="True"
    DataContextChanged="OnViewDataContextChanged"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  属性面板（S3-d / S3-e3）—— 一个面板，两种编辑对象  -->
    <!--  选中图元 → 列这个类型的属性；没选中 → 列当前画面的属性。  -->
    <!--  两条路共用同一套编辑器：行内容全部由 IPropertySpec 驱动，  -->
    <!--  用什么控件由 Kind 决定，写到模型哪里由行自己（图元走 ElementValueAccess，  -->
    <!--  画面走声明里的读写委托）。所以加一类图元 / 加一条画面属性，这个文件一行都不用改。  -->
    <!--  ==========================================  -->

    <!--  本面板在右侧，分隔线画在左边（工具箱在左侧，画的是右边框，同一个道理）  -->
    <Border
        Background="#FFF7F8FA"
        BorderBrush="#FFDCE0E6"
        BorderThickness="1,0,0,0">
        <Grid>
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolVis" />

                <!--  ====================  编辑器：一组模板 + 按 Kind 挑选  ====================  -->
                <!--  刻意不用隐式 DataTemplate / DataTemplateSelector：两者都要让 XAML 认得  -->
                <!--  ScadaPropertyRow 这个自定义类型（需配 x:TypeArguments 或程序集白名单），  -->
                <!--  而显式 keyed 模板 + DataTrigger 没有任何额外要求，风险不对等。  -->

                <!--  所有文本类编辑器共用：值非法（数字框打了字母、越界）时标红，原因挂悬停  -->
                <Style x:Key="ValueBox" TargetType="TextBox">
                    <Setter Property="BorderBrush" Value="#FFDCE0E6" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="12" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="BorderBrush" Value="#FFE05B5B" />
                            <Setter Property="Background" Value="#FFFDF0F0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!--  Text / Number 同模板：现在两者都只是一个文本框。  -->
                <!--  将来给数值加上下调节按钮时再拆出去，那时才是真的不同  -->
                <DataTemplate x:Key="EditText">
                    <TextBox
                        Style="{StaticResource ValueBox}"
                        ToolTip="{Binding ErrorText}"
                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                </DataTemplate>

                <!--  多行：文本框属性（内容）要能换行写，高度给两行起  -->
                <DataTemplate x:Key="EditMultiline">
                    <TextBox
                        MinHeight="52"
                        Padding="4,3"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{StaticResource ValueBox}"
                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding ErrorText}"
                        VerticalScrollBarVisibility="Auto" />
                </DataTemplate>

                <DataTemplate x:Key="EditBool">
                    <CheckBox
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsChecked="{Binding BoolValue, Mode=TwoWay}"
                        ToolTip="{Binding ErrorText}" />
                </DataTemplate>

                <!--  颜色：文本框 + 色块。仓库里没有可用的取色器控件（第三方树里的都不在引用范围内），  -->
                <!--  而 #AARRGGBB 本来就是可手输的文本，色块只负责"这串字符到底长什么样"  -->
                <DataTemplate x:Key="EditColor">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Style="{StaticResource ValueBox}"
                            ToolTip="{Binding ErrorText}"
                            Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                        <!--  色块必须显式落在第 1 列：漏写 Grid.Column 会和文本框挤进同一格，
                            又因为设了固定 Width 而在该格内居中，直接压在十六进制文本上。
                            HorizontalAlignment=Left 让它紧贴文本框，VerticalAlignment=Center 保证和文本上下对齐。 -->
                        <Border
                            Grid.Column="1"
                            Width="18"
                            Height="18"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{Binding SwatchBrush}"
                            BorderBrush="#FFC0C4CC"
                            BorderThickness="1"
                            CornerRadius="2"
                            ToolTip="{Binding Value}" />
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="EditChoice">
                    <ComboBox
                        VerticalContentAlignment="Center"
                        FontSize="12"
                        ItemsSource="{Binding Choices}"
                        SelectedItem="{Binding Value, Mode=TwoWay}"
                        ToolTip="{Binding ErrorText}" />
                </DataTemplate>

                <Style x:Key="RowEditorHost" TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Number">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditText}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="MultilineText">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditMultiline}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Bool">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditBool}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Color">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditColor}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Choice">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditChoice}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!--  ====================  事件行（S5）：开关 + 内联动作表  ====================  -->

                <!--  动作行里那三个小按钮共用：正方形、无边框感，密集排布不抢视线  -->
                <Style x:Key="ActionIconButton" TargetType="Button">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Margin" Value="2,0,0,0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="#FF606266" />
                </Style>

                <!--  一条动作：第一行选"干什么"和调顺序，第二行填这条动作的参数。
                    两行而不是挤一行：面板统共 260px 宽，一行里塞下"下拉框 + 参数 + 三个按钮"
                    之后留给日志文案的宽度不够写一句人话。  -->
                <DataTemplate x:Key="ActionItem">
                    <Border
                        Margin="0,2,0,0"
                        Padding="4,3"
                        Background="#FFFFFFFF"
                        BorderBrush="#FFE4E7ED"
                        BorderThickness="1"
                        CornerRadius="2">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  下拉的候选与命令都挂在事件行上（本模板的 DataContext 是单条动作），
                                     AncestorType=ItemsControl 取到的正是动作表那个 ItemsControl，
                                     它的 DataContext 就是事件行。  -->
                                <ComboBox
                                    Grid.Column="0"
                                    FontSize="11"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding DataContext.ActionTypeChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    SelectedValue="{Binding Type, Mode=TwoWay}"
                                    SelectedValuePath="Type"
                                    ToolTip="这条动作要干什么" />
                                <Button
                                    Grid.Column="1"
                                    Command="{Binding DataContext.MoveActionUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="↑"
                                    Style="{StaticResource ActionIconButton}"
                                    ToolTip="上移（越靠上越先执行）" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding DataContext.MoveActionDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="↓"
                                    Style="{StaticResource ActionIconButton}"
                                    ToolTip="下移" />
                                <Button
                                    Grid.Column="3"
                                    Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="✕"
                                    Style="{StaticResource ActionIconButton}"
                                    ToolTip="删除这条动作" />
                            </Grid>

                            <!--  日志文案：只有"记录日志"需要填（留空则由执行侧回落成"图元名 + 事件名"）  -->
                            <TextBox
                                Margin="0,3,0,0"
                                Padding="3,2"
                                BorderBrush="#FFDCE0E6"
                                FontSize="11"
                                Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                ToolTip="留空则记录「图元名 + 事件名」">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Log">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!--  写变量（S6-6）：先选目标变量，再填要写进去的值。
                                目标变量存"身份 + 名字"两份，Id 优先、名字只用于显示与兜底寻址，
                                回填与寻址的口径在 ScadaAction.BindVariable 一处，这里只管展示。  -->
                            <StackPanel Margin="0,3,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="WriteVariable">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  名字为空（=还没选）时由 TargetNullValue 顶上一句占位文案，
                                        省掉一个"空/非空"双控件互斥的触发器  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding VariableName, TargetNullValue=（还没选变量）}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding VariableName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF303133" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVariable}" Value="False">
                                                        <Setter Property="Foreground" Value="#FFE6A23C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button
                                        Grid.Column="1"
                                        Padding="6,1"
                                        FontSize="11"
                                        Command="{Binding DataContext.PickVariableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="选择变量"
                                        ToolTip="从当前方案的变量清单里挑一个" />
                                </Grid>

                                <TextBox
                                    Margin="0,3,0,0"
                                    Padding="3,2"
                                    BorderBrush="#FFDCE0E6"
                                    FontSize="11"
                                    Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="要写进变量的值（按变量类型转换，转不过去执行时会记一条错误）" />

                                <!--  没选变量：执行侧会照实警告并跳过，先把这件事说在面板上  -->
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Foreground="#FFE6A23C"
                                    Text="还没选变量，这条动作运行时会跳过。"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVariable}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!--  还没接通的动作：说明"为什么现在配了也不会响"。
                                文案来自领域层（ScadaAction.PendingReason），与运行日志里那句逐字相同，
                                用户才能把"我配的这条"和"日志里那条"对上号。  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="#FFE6A23C"
                                Text="{Binding PendingReason}"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PendingReason}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!--  事件行本体：勾选框 + （勾上才出现的）动作表。
                    这份模板<b>独占整行宽度</b>、不排标签列——82px 的标签列留给动作表就只剩一条缝了。  -->
                <DataTemplate x:Key="EventRowBody">
                    <StackPanel Margin="0,2,0,2" ToolTip="{Binding Description}">
                        <CheckBox
                            Content="{Binding DisplayName}"
                            FontSize="12"
                            IsChecked="{Binding BoolValue, Mode=TwoWay}" />

                        <!--  没配钩子时 HasActions=false，整块收掉；配了才展开  -->
                        <StackPanel
                            Margin="16,3,0,0"
                            Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}">
                            <TextBlock
                                FontSize="11"
                                Foreground="#FF909399"
                                Text="动作（自上而下依次执行）：" />

                            <ItemsControl ItemTemplate="{StaticResource ActionItem}" ItemsSource="{Binding Actions}" />

                            <!--  配了钩子却把动作删光了：执行侧当"没配"处理，必须说出来，
                                否则用户会以为"我明明勾上了"  -->
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="#FFE6A23C"
                                Text="还没有动作，运行态命中该事件时不会有任何反应。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Actions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button
                                Margin="0,4,0,0"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                Command="{Binding AddActionCommand}"
                                Content="+ 添加动作"
                                FontSize="11"
                                ToolTip="新动作默认是「记录日志」，改文案即可用" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>

                <!--  ====================  一行属性  ====================  -->

                <!--  行尾那颗按钮的共用尺码。绑定/清除两颗按钮<b>必须同宽同边距</b>：
                    它们各自落在自己那一行的 Auto 列里，宽度一旦不同，上一行的编辑器列
                    就会比下一行的变量带短一截，两行的右缘对不齐。  -->
                <Style x:Key="BindSlotButton" TargetType="Button">
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Margin" Value="4,0,0,0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="#FF909399" />
                </Style>

                <!--  ƒx：没绑是灰色的"去绑定"，绑上了转成蓝色"已绑定"。
                    同一颗按钮两种状态，比"绑上之后再多长出一颗按钮"省地方，
                    也让人扫一眼就知道这行的值已经被变量接管。  -->
                <Style x:Key="BindGlyphButton" TargetType="Button" BasedOn="{StaticResource BindSlotButton}">
                    <Setter Property="Content" Value="ƒx" />
                    <Setter Property="ToolTip" Value="绑定工程变量" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBinding}" Value="True">
                            <Setter Property="Foreground" Value="#FF2A6BB5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="ToolTip" Value="已绑定变量，点击可换绑" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!--  变量带里那颗"✕"：无边框，只在悬停时泛一点红——它是删除语义，
                    平时不该有存在感，否则整条变量带会看着像一张按钮表。  -->
                <Style x:Key="ChipIconButton" TargetType="Button">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Foreground" Value="#FF6B8FB5" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFE05B5B" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!--  行本体：标签 + 编辑器 + ƒx；绑了变量的行，下面再挂一条"已绑"带。
                    行高只在绑定时才长——没绑的行仍是原来的一行，不为少数派付代价。  -->
                <DataTemplate x:Key="PropertyRowBody">
                    <StackPanel Margin="0,1" ToolTip="{Binding Description}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!--  标签列固定宽度：属性名长短不齐时，编辑器左缘必须是一条直线  -->
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                                <!--  行尾槽位固定 28px（= ƒx 的 Width 24 + Margin 左 4），
                                      即便这一行不可绑、按钮被 Collapsed 收掉，槽位也照样占着——
                                      否则不可绑行的编辑器会比可绑行宽出 28px，整列右缘参差不齐。  -->
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FF606266"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis" />

                            <ContentControl
                                Grid.Column="1"
                                Content="{Binding}"
                                Style="{StaticResource RowEditorHost}" />

                            <!--  ƒx 只对描述符声明了 IsBindable 的行出现。
                                  不可绑的是"设计期版面语言"（名称、X、Y）与事件行；
                                  可绑的是"运行期动画语言"（尺寸 / 角度 / 颜色 / 文字 / 状态 / 数据）——
                                  SCADA 里"液位随变量变化"就是绑 Height。  -->
                            <Button
                                Grid.Column="2"
                                Command="{Binding DataContext.BindVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource BindGlyphButton}"
                                Visibility="{Binding IsBindable, Converter={StaticResource BoolVis}}" />
                        </Grid>

                        <!--  已绑变量带：与上一行<b>同列对齐</b>——变量名落在编辑器列下、✕ 落在 ƒx 列下，
                              于是"这是哪一行的变量"一眼可辨，不用靠缩进去猜。
                              上边距 5 而不是 2：实测 2 只剩 2.4px 的缝，带子像贴在输入框下沿，
                              反而让人怀疑这条带子到底属于上一行还是下一行；5 之后缝有 5px 出头，
                              分组感出来了，又不会把行距撑散（断言钉着这条缝不许被压掉）。  -->
                        <Grid Margin="0,5,0,2" Visibility="{Binding HasBinding, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="1"
                                Padding="5,1,3,1"
                                Background="#FFEAF3FF"
                                BorderBrush="#FFC6DDF5"
                                BorderThickness="1"
                                CornerRadius="3"
                                ToolTip="运行态由这个变量驱动本属性；此处只是显示，寻址用的是变量 Id">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  ƒ 是面板里"变量"的记号，与上面那颗按钮同源，一眼能串起来  -->
                                    <TextBlock
                                        Margin="0,0,3,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#FF7FA8D4"
                                        Text="ƒ" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#FF2A6BB5"
                                        Text="{Binding BindingVariableName}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding BindingVariableName}" />

                                    <Button
                                        Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Command="{Binding DataContext.ClearBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="✕"
                                        Style="{StaticResource ChipIconButton}"
                                        ToolTip="清除绑定（只断开变量驱动，不改当前值）" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </DataTemplate>

                <!--  行级分流：复合编辑区（事件行）整份换模板，普通行走上面那份。
                    判据是行自己的 IsCompositeEditor，<b>不认具体类型</b>——与编辑器按 Kind 分流
                    同一个手法，也就不必让 XAML 认得 ScadaEventRow 这个自定义类型。  -->
                <DataTemplate x:Key="PropertyRow">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource PropertyRowBody}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompositeEditor}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EventRowBody}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ====================  标题：编辑的是谁 + 锁定  ====================  -->
            <Border
                Grid.Row="0"
                Background="#FFF5F7FA"
                BorderBrush="#FFDCE0E6"
                BorderThickness="0,0,0,1">
                <Grid Margin="10,7">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="#FF303133"
                        Text="{Binding HeaderText}"
                        TextTrimming="CharacterEllipsis" />
                    <!--  锁定是模型字段（要落盘），画布的拖动/改尺寸都认它，  -->
                    <!--  所以这里直绑 Element.IsLocked，双向写回，不经视图模型转发  -->
                    <CheckBox
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="锁定"
                        FontSize="12"
                        IsChecked="{Binding Element.IsLocked, Mode=TwoWay}"
                        ToolTip="锁定后在画布上不能拖动、不能改尺寸（防误挪已摆好的底图）"
                        Visibility="{Binding HasElement, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Border>

            <!--  ====================  属性行  ====================  -->
            <ScrollViewer
                Grid.Row="1"
                Margin="6,6,6,8"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander
                                Margin="0,2"
                                FontSize="12"
                                IsExpanded="True">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="#FF606266"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            Foreground="#FF909399"
                                            Text="{Binding Rows.Count, StringFormat=({0})}" />
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl
                                    Margin="12,2,0,4"
                                    ItemTemplate="{StaticResource PropertyRow}"
                                    ItemsSource="{Binding Rows}" />
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  ====================  空态  ====================  -->
            <!--  判空看 HasRows，不看 HasElement：画面模式下没有选中图元，但面板有六行内容，  -->
            <!--  用 HasElement 判空会把水印盖在画面属性上。文案由 VM 按成因给出（未打开方案 /  -->
            <!--  类型未注册 / 画面没有可编辑属性），这里不再写死。  -->
            <TextBlock
                Grid.Row="1"
                Margin="16,24,16,0"
                FontSize="12"
                Foreground="#FF909399"
                IsHitTestVisible="False"
                Text="{Binding EmptyHint}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRows}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
