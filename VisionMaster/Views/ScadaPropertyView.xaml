<UserControl
    x:Class="VisionMaster.Views.ScadaPropertyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:controls="clr-namespace:VisionMaster.Views.Controls"
    xmlns:scada="clr-namespace:VisionMaster.Scada.Controls;assembly=VM.Scada.Controls"
    xmlns:ui="clr-namespace:UI.CustomControl;assembly=UI"
    d:DesignHeight="600"
    d:DesignWidth="260"
    prism:ViewModelLocator.AutoWireViewModel="True"
    DataContextChanged="OnViewDataContextChanged"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  属性面板（S3-d / S3-e3）—— 一个面板，两种编辑对象  -->
    <!--  选中图元 → 列这个类型的属性；没选中 → 列当前画面的属性。  -->
    <!--  两条路共用同一套编辑器：行内容全部由 IPropertySpec 驱动，  -->
    <!--  用什么控件由 Kind 决定，写到模型哪里由行自己（图元走 ElementValueAccess，  -->
    <!--  画面走声明里的读写委托）。所以加一类图元 / 加一条画面属性，这个文件一行都不用改。  -->
    <!--  ==========================================  -->

    <!--  颜色令牌：面板里每一处颜色都从这本字典取（值集中在 UI/Controls/Themes/Colors.xaml，  -->
    <!--  换肤只改那一处，面板一行不动）。真 App 里它由 App.xaml 合并进来，这里再合并一次是让  -->
    <!--  面板"自带口粮"：脱离 App 单独量（断言宿主、设计器）也照样渲染，  -->
    <!--  而不是抛 XamlParseException 说找不到 ScadaPanelBackgroundBrush。  -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  本面板在右侧，分隔线画在左边（工具箱在左侧，画的是右边框，同一个道理）  -->
    <Border
        Background="{StaticResource ScadaPanelBackgroundBrush}"
        BorderBrush="{StaticResource ScadaPanelBorderBrush}"
        BorderThickness="1,0,0,0">
        <Grid>
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolVis" />

                <!--  ====================  v2 工具提示（2026-10-28）  ====================  -->
                <!--  系统默认 ToolTip 是黄底 11px、宽度不受控，长描述会盖住动作卡（真机截图实证）。
                      这里给一份墨黑底白字、最大宽 240、12px/1.45 的样式；作用域仅本 UserControl，
                      不影响别的面板（不改全局隐式 ToolTip）。  -->
                <Style TargetType="ToolTip">
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="HasDropShadow" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToolTip">
                                <Border
                                    MaxWidth="240"
                                    Padding="8,7"
                                    Background="{StaticResource ScadaTooltipBackgroundBrush}"
                                    CornerRadius="8">
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ScadaTooltipTextBrush}" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="LineHeight" Value="17.4" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--  ====================  分组折叠头（v2：38px，卡片内首行）  ====================  -->
                <!--  为什么是 keyed 样式而不是改主题里的隐式 Expander：App.xaml 在 UI 的
                      Generic.xaml 之后又合并了 PresentationFramework.Fluent，隐式 Expander 样式
                      很可能被 Fluent 那份顶掉（与 R19 的 ListView 同一族）——改主题里那份在真机上
                      不生效、在断言宿主里生效，是最难查的一种劈叉。keyed 样式不受合并顺序影响。  -->
                <!--  v2：组不再直接铺在面板底色上，而是套一张白卡（见 ItemsControl 的 ItemTemplate）。
                      组头 38px + 下沿 hairline；卡片圆角 10，组头悬停底给上圆角 9，避免溢出卡角。  -->
                <Style x:Key="SectionExpander" TargetType="Expander">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Expander">
                                <StackPanel>
                                    <!--  ★ HorizontalAlignment / VerticalAlignment 必须显式写 Stretch：
                                          App.xaml 最后合并的 .NET 9 Fluent 主题给「所有」ToggleButton 设了
                                          HorizontalAlignment=Left + VerticalAlignment=Center（实测 setter 链）。
                                          自定义模板里的 ToggleButton 没挂 Style，就会吃到那一份 ——
                                          表现是组头那圈下划线只到内容宽度、箭头贴在计数徽标后面
                                          （2026-10-20 真机截图复现）。  -->
                                    <ToggleButton
                                        x:Name="HeaderSite"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Focusable="False"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border
                                                    x:Name="HeaderBorder"
                                                    Height="38"
                                                    Padding="12,0"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource ScadaHairlineBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    CornerRadius="9,9,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ContentPresenter VerticalAlignment="Center" Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                                        <Path
                                                            x:Name="Chevron"
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Data="M 0 0 L 4 4 L 8 0"
                                                            RenderTransformOrigin="0.5,0.5"
                                                            Stroke="{StaticResource ScadaSecondaryTextBrush}"
                                                            StrokeEndLineCap="Round"
                                                            StrokeLineJoin="Round"
                                                            StrokeStartLineCap="Round"
                                                            StrokeThickness="1.4">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource ScadaHoverBrush}" />
                                                    </Trigger>
                                                    <!--  展开时箭头翻转。Trigger 只认本模板名字域里的元素，
                                                          所以必须写在这一层（Expander 那层的触发器够不到 Chevron）  -->
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Border
                                        x:Name="Body"
                                        Padding="0,2,0,6"
                                        Visibility="Collapsed">
                                        <ContentPresenter />
                                    </Border>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--  组头里的计数徽标：括号文本换成胶囊，基线不再随字号漂  -->
                <Style x:Key="SectionCountBadge" TargetType="Border">
                    <Setter Property="Margin" Value="6,0,0,0" />
                    <Setter Property="Padding" Value="5,0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Background" Value="{StaticResource ScadaBadgeBackgroundBrush}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <!--  开关（32×18，钮 12）：只用在标题条的「锁定」。
                      为什么这里不用勾选框：勾选框表示"选中了哪些项"，开关表示"这一项现在开没开"，
                      「锁定」是后者。面板里其余 Bool 行仍是勾选框——它们是"配没配这条功能"，
                      和旁边的事件行同一形态，一列扫下来才是齐的。  -->
                <Style x:Key="SwitchToggle" TargetType="ToggleButton">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="18" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border
                                    x:Name="Track"
                                    Background="{StaticResource ScadaBadgeBackgroundBrush}"
                                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <Ellipse
                                        x:Name="Knob"
                                        Width="12"
                                        Height="12"
                                        Margin="2,0,0,0"
                                        HorizontalAlignment="Left"
                                        Fill="{StaticResource ScadaSurfaceBrush}"
                                        Stroke="{StaticResource ScadaSwatchBorderBrush}"
                                        StrokeThickness="0.6" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="{StaticResource ScadaAccentBrush}" />
                                        <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                                        <Setter TargetName="Knob" Property="Stroke" Value="{StaticResource ScadaAccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--  ====================  编辑器：一组模板 + 按 Kind 挑选  ====================  -->
                <!--  刻意不用隐式 DataTemplate / DataTemplateSelector：两者都要让 XAML 认得  -->
                <!--  ScadaPropertyRow 这个自定义类型（需配 x:TypeArguments 或程序集白名单），  -->
                <!--  而显式 keyed 模板 + DataTrigger 没有任何额外要求，风险不对等。  -->

                <!--  所有文本类编辑器共用：值非法（数字框打了字母、越界）时标红，原因挂悬停  -->
                <!--  Padding 6,4 是面板级紧凑口径：应用级隐式 TextBox 样式给的是 10,8
                      （UI\Controls\Themes\Controls\Input.xaml:13），单行框会被撑到 ~35px——
                      属性面板行高有限，Web 端同密度表单的单行输入是 26~32px，不是 35+。  -->
                <Style x:Key="ValueBox" TargetType="TextBox">
                    <Setter Property="Background" Value="{StaticResource ScadaFieldBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="7,4" />
                    <Setter Property="MinHeight" Value="28" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ScadaFieldHoverBrush}" />
                        </Trigger>
                        <!--  v2 filled 输入：平时无描边，聚焦才转白底 + 主色描边（层次靠底色差，不靠框中框）。  -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{StaticResource ScadaSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="BorderBrush" Value="{StaticResource ScadaDangerBrush}" />
                            <Setter Property="Background" Value="{StaticResource ScadaInvalidBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!--  Text 类：普通文本框（数值类见下面的 EditNumber）  -->
                <DataTemplate x:Key="EditText">
                    <TextBox
                        Style="{StaticResource ValueBox}"
                        ToolTip="{Binding ErrorText}"
                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                </DataTemplate>

                <!--  只读行（「类型」）：给一块与输入框同尺码的底色，但不可聚焦、不可编辑。
                      为什么不复用 EditText + IsReadOnly：那仍然是个能聚焦、能选中、能打字的框，
                      而打进去的字会被静默丢掉——"看起来能改"比"看起来不能改"更伤信任
                      （与图像行不给输入框同一条理由）。  -->
                <DataTemplate x:Key="EditReadOnly">
                    <Border
                        MinHeight="28"
                        Padding="7,3"
                        VerticalAlignment="Center"
                        Background="{StaticResource ScadaFieldBackgroundBrush}"
                        BorderThickness="0"
                        CornerRadius="7">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="{Binding Value}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Value}" />
                    </Border>
                </DataTemplate>

                <!--
                    数值编辑器（2026-10-10 加）。原本文本与数值共用 EditText（那句注释写着"将来给数值加上下
                    调节按钮时再拆出去"，这次就是那一刻）。拆出去之后拿到：上下键/滚轮步进、区域设置容错解析、
                    以及（行 VM 给范围时）越界钳制。

                    ★ 非法文本**不退回**（RevertOnInvalid=False）：本面板的校验归行 VM（IsValid / ErrorText），
                      它要留住用户敲的内容好让人在原处改 —— 所以控件只负责标红，退回与否由面板决定。
                    ★ 文本仍绑 Value（行的编辑缓冲，字符串），提交 / 撤销 / 回填规范值那条链路一字未动；
                      控件自身的解析只用于步进与钳制，写回仍走 Text → Value。
                -->
                <Style x:Key="ScadaNumberBox" TargetType="{x:Type ui:NumericBox}">
                    <Setter Property="RevertOnInvalid" Value="False" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Background" Value="{StaticResource ScadaFieldBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="1" />
                    <!--  与 ValueBox 同一紧凑口径：控件默认 MinHeight 32 + Padding 10,6
                          （UI\Controls\Themes\NumericBox.xaml:15-16），在属性面板里比同级文本框高一头。  -->
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ScadaFieldHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{StaticResource ScadaSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                        </Trigger>
                        <!--  行 VM 的校验（打了字母、越界）  -->
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="BorderBrush" Value="{StaticResource ScadaDangerBrush}" />
                            <Setter Property="Background" Value="{StaticResource ScadaInvalidBackgroundBrush}" />
                        </DataTrigger>
                        <!--  控件自身的非法态（解析不出数字）—— 与上面同色，两条路都标红  -->
                        <DataTrigger Binding="{Binding IsInvalid, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ScadaDangerBrush}" />
                            <Setter Property="Background" Value="{StaticResource ScadaInvalidBackgroundBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <DataTemplate x:Key="EditNumber">
                    <!--  单位后缀走 NumericBox 自带的 Suffix（模板里空串即收起，不白占右边距）：
                          px / ° 由行 VM 按 Key 给出（见 ScadaPropertyRowBase.Unit），
                          XAML 不维护第二份"哪些属性带单位"的名单。  -->
                    <ui:NumericBox
                        Style="{StaticResource ScadaNumberBox}"
                        Suffix="{Binding Unit}"
                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                        ToolTip="{Binding ErrorText}" />
                </DataTemplate>

                <!--  多行：文本框属性（内容）要能换行写，高度给两行起  -->
                <DataTemplate x:Key="EditMultiline">
                    <TextBox
                        MinHeight="52"
                        Padding="4,3"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{StaticResource ValueBox}"
                        Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding ErrorText}"
                        VerticalScrollBarVisibility="Auto" />
                </DataTemplate>

                <DataTemplate x:Key="EditBool">
                    <CheckBox
                        VerticalAlignment="Center"
                        FontSize="12"
                        IsChecked="{Binding BoolValue, Mode=TwoWay}"
                        ToolTip="{Binding ErrorText}" />
                </DataTemplate>

                <!--  色板上的一个小格子：去掉按钮的三态外观，只留一块颜色 + 悬停描边  -->
                <Style x:Key="PaletteCell" TargetType="Button">
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Margin" Value="0,0,2,2" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Cell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <ControlTemplate.Triggers>
                                    <!--  只换描边不换粗细：改 BorderThickness 会让格子里的颜色
                                          在悬停时抖一下（描边向内吃掉 1px），一排格子扫过去像在呼吸  -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--  色块本身是个 ToggleButton：点开取色板，再点一下收起。
                      模板压成"只有内容"，因为真正的视觉是里面那块 Border（颜色由行给）。  -->
                <Style x:Key="SwatchToggle" TargetType="ToggleButton">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border
                                    x:Name="Chrome"
                                    Padding="1"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ScadaAccentSoftBrush}" />
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--  ====================  取色板卡片（属性行与动画档位共用）  ====================  -->

                <!--  这张卡片有两个宿主：属性行里那块色块（EditColor），以及动画档位卡片里的
                      「前景 / 背景」两个小色块。抽成一份而不是抄两份——两处弹出来的必须是同一张卡片，
                      否则改一处配色，另一处就悄悄长歪了。
                      本模板不认识任何具体类型：它的 DataContext 只要具备取色成员即可，
                      而 ScadaColorSlot 与属性行的那些成员是逐字同名的（这是刻意的）。
                      命令取的是"最近的 ItemsControl"的 DataContext，那个 ItemsControl 就是色板本身、
                      它的 DataContext 由宿主继承下来，所以槽与行两种宿主都能解析到自己的命令。  -->
                <DataTemplate x:Key="ColorPickerBody">
                    <Border
                        Width="228"
                        Padding="8"
                        Background="{StaticResource ScadaSurfaceBrush}"
                        BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Opacity="0.18"
                                ShadowDepth="2" />
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="11"
                                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                Text="色板" />

                            <ItemsControl ItemsSource="{Binding ColorPalette}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--  参数传 Color 而不是整支画刷：命令侧只关心三个通道，
                                              拿到 Brush 还得再判类型，多一道没用的分支  -->
                                        <Button
                                            Background="{Binding}"
                                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Color}"
                                            Style="{StaticResource PaletteCell}"
                                            ToolTip="{Binding Color}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Margin="0,8,0,2"
                                FontSize="11"
                                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                Text="透明度" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    Maximum="255"
                                    Minimum="0"
                                    TickFrequency="1"
                                    Value="{Binding ColorDraftAlpha, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Width="28"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaLabelTextBrush}"
                                    Text="{Binding ColorDraftAlpha, StringFormat={}{0:0}}"
                                    TextAlignment="Right" />
                            </Grid>

                            <TextBlock
                                Margin="0,8,0,2"
                                FontSize="11"
                                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                Text="颜色（#AARRGGBB）" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--  即时提交：草稿不进模型，每敲一个字符重算一次预览没有副作用，
                                      反而能让人"边打边看见"自己打的是什么颜色  -->
                                <TextBox
                                    Grid.Column="0"
                                    FontSize="11"
                                    Style="{StaticResource ValueBox}"
                                    Text="{Binding ColorDraft, UpdateSourceTrigger=PropertyChanged}" />
                                <Border
                                    Grid.Column="1"
                                    Width="24"
                                    Height="20"
                                    Margin="6,0,0,0"
                                    Background="{Binding ColorDraftBrush}"
                                    BorderBrush="{StaticResource ScadaSwatchBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                            </Grid>

                            <StackPanel
                                Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <!--  两个按钮照抄对话框的老规矩（白底描边 = 取消，蓝底白字 = 确定），
                                      面板里弹出来的小窗和对话框不该长成两家人。只是把内边距收窄，
                                      228 宽的弹窗塞不下对话框那对 28,8 的胖按钮  -->
                                <Button
                                    Padding="16,4"
                                    Background="{StaticResource ScadaSurfaceBrush}"
                                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                    Command="{Binding CancelColorCommand}"
                                    Content="取消"
                                    Cursor="Hand"
                                    FontSize="12">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button
                                    Margin="8,0,0,0"
                                    Padding="16,4"
                                    Background="{StaticResource ScadaPrimaryButtonBrush}"
                                    BorderThickness="0"
                                    Command="{Binding ApplyColorCommand}"
                                    Content="确定"
                                    Cursor="Hand"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaOnAccentTextBrush}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!--  颜色：行里只有一块可点的色块，点开是取色板（预设色 + 透明度 + 十六进制）。  -->
                <!--  为什么行里不再摆十六进制文本框：那是"让人手抄一串 #AARRGGBB"的设计，  -->
                <!--  与取色板是两套并存的入口——想点色板的人不会去背十六进制，会背的人又嫌色板碍事。  -->
                <!--  色块成为唯一入口后，精确值挂在它的悬停提示上；真要手打，弹窗里那个框还在。  -->
                <!--  弹窗里改的是"草稿"，点「确定」才写回模型——一次提交 = 一条撤销记录，  -->
                <!--  拖一次透明度滑块就灌满撤销栈的编辑器，等于把 Ctrl+Z 废掉  -->
                <!--  （草稿机制见 ScadaPropertyRowBase 的取色器注释）。  -->
                <DataTemplate x:Key="EditColor">
                    <!--  外层 Grid 只为容纳那个 Popup（Popup 不占布局，但它得有个爹）。  -->
                    <Grid>
                        <!--  色块左对齐、紧贴标签：与 Bool 行的复选框同一个左缘，  -->
                        <!--  几行颜色看下来是一条竖线，而不是"标签之后空一段、方块浮在右边"。  -->
                        <ToggleButton
                            x:Name="ColorSwatch"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsColorPickerOpen, Mode=TwoWay}"
                            Style="{StaticResource SwatchToggle}"
                            ToolTip="{Binding Value}">
                            <Border
                                Width="40"
                                Height="24"
                                Background="{Binding SwatchBrush}"
                                BorderBrush="{StaticResource ScadaSwatchBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6" />
                        </ToggleButton>

                        <!--  取色板弹窗。StaysOpen=False：点面板别处就收起，不必先找"取消"。
                              HorizontalOffset 是把弹窗拽回面板里的那一段：
                              弹窗宽 228，面板只有 260，色块左缘在面板内约 101px 处，
                              默认的"左边缘对齐色块"会让弹窗右边探出面板 60 多像素
                              （属性面板贴着窗口右沿，探出去的部分直接被窗口裁掉）。
                              偏移 -82 之后弹窗落在面板内 19~247，左右各留十几像素的边，
                              看着像从色块下面抽出来的一张卡片，而不是贴着窗口边。  -->
                        <Popup
                            AllowsTransparency="True"
                            HorizontalOffset="-82"
                            IsOpen="{Binding IsColorPickerOpen, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=ColorSwatch}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <!--  卡片正文与动画档位卡片里那两格小色块共用一份（见 ColorPickerBody）：
                                  两处弹出来的必须是同一张卡，否则改一处配色，另一处就悄悄长歪了。
                                  Content="{Binding}" 不能省：ContentControl 只给 ContentTemplate 时，
                                  它模板里的 ContentPresenter 拿不到数据源，模板子树整棵 DataContext 会是 null，
                                  于是色板、读数、预览块全部静默失效（字面量照常显示，所以很难看出来）。  -->
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColorPickerBody}" />
                        </Popup>
                    </Grid>
                </DataTemplate>

                <!--  下拉：应用级 Fluent 的隐式 ComboBox 样式把填充画成一层灰渐变
                      （实测采样 #E8E8E8 一带，且不吃 TemplateBinding 的 Background），
                      在属性面板里就成了"白输入框 + 灰下拉"，看着像禁用。这里给一份紧凑模板：
                      白底 + 同款描边 + 12px 字，与文本框、数值框一个尺码。
                      模板里只留必要部件：PART_Popup（ComboBox 内部靠它开合）、
                      ItemsPresenter（键盘导航走 ComboBox 自己的逻辑，不需要额外代码）。  -->
                <Style x:Key="ScadaCombo" TargetType="ComboBox">
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="8,0,24,0" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="{StaticResource ScadaFieldBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid SnapsToDevicePixels="True">
                                    <!--  ★ 同组头那处：Fluent 的隐式 ToggleButton 样式把对齐设成 Left/Center，
                                          这一颗是 ComboBox 的「外壳」，缩成内容宽度后只剩箭头那么大 ——
                                          框看不见、箭头跑到文字左边（2026-10-20 真机截图复现）。
                                          显式 Stretch 把它拉回整格。  -->
                                    <ToggleButton
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border
                                                    x:Name="Chrome"
                                                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                    <Path
                                                        x:Name="Arrow"
                                                        Margin="0,0,8,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Data="M 0 0 L 4 4 L 8 0"
                                                        Stroke="{StaticResource ScadaSecondaryTextBrush}"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="1.4" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!--  选中项显示：不接鼠标，点击落到底下那颗 ToggleButton 上  -->
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        IsHitTestVisible="False" />

                                    <Popup
                                        x:Name="PART_Popup"
                                        AllowsTransparency="True"
                                        Focusable="False"
                                        IsOpen="{TemplateBinding IsDropDownOpen}"
                                        Placement="Bottom"
                                        PopupAnimation="Slide">
                                        <Border
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            Margin="0,2,0,0"
                                            Padding="2"
                                            Background="{StaticResource ScadaSurfaceBrush}"
                                            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="10"
                                                    Opacity="0.15"
                                                    ShadowDepth="2" />
                                            </Border.Effect>
                                            <ScrollViewer>
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ScadaFieldHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Background" Value="{StaticResource ScadaSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <DataTemplate x:Key="EditChoice">
                    <!--  下拉绑的是"值 + 中文名"两列（ChoiceOptions），不是描述符里那串落盘值：
                          DisplayMemberPath 决定看到什么（圆形），SelectedValuePath 决定写回什么（Circle）。
                          选中项按 Value 匹配，所以中文显示名不参与写回，落进 .vms 的永远是英文原值。
                          与动作类型那个下拉同一个手法（见 ScadaActionTypeOption 的注释）。  -->
                    <!--  外观交给 ScadaCombo（见上面那份模板的注释）：应用级 Fluent 的隐式
                          ComboBox 样式会画一层灰渐变，与同组的白输入框对不上，所以这里自带模板。  -->
                    <Grid>
                        <ComboBox
                            Style="{StaticResource ScadaCombo}"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding ChoiceOptions}"
                            SelectedValue="{Binding Value, Mode=TwoWay}"
                            SelectedValuePath="Value"
                            ToolTip="{Binding ErrorText}" />
                        <!--  没选任何一项时给一句占位（例：「基座」未选 = 这一页不用公共层）。
                              空下拉框在窄面板里就是一只白盒子，看不出"是空的"还是"没加载出来"。  -->
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource ScadaFaintTextBrush}"
                            IsHitTestVisible="False"
                            Text="未选择">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>

                <!--  图像：位图没法手打，所以这一行不给输入框，只给一句状态说明 + 右侧的绑定按钮。
                      两种文案由 HasBinding 翻：没绑时告诉操作员去哪儿绑，绑了就说图由变量提供
                      （变量名在下方那条"已绑变量"带上，不在这里重复）。  -->
                <DataTemplate x:Key="EditImage">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ErrorText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="未绑定（点右侧 ƒx 选图像变量）" />
                                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBinding}" Value="True">
                                        <Setter Property="Text" Value="由变量提供" />
                                        <Setter Property="Foreground" Value="{StaticResource ScadaBoundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>

                <!--  方案内图片文件（页面背景图）：缩略图 + 文件名 + 选择/清除。
                      与上面的 Image（由变量提供的运行态图像）区分：这一行选的是方案资产。  -->
                <DataTemplate x:Key="EditImageFile">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="44"
                            Height="30"
                            Margin="0,0,8,0"
                            Background="{StaticResource ScadaFieldBackgroundBrush}"
                            BorderBrush="{StaticResource ScadaCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                    Text="空">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Image Source="{Binding ImagePreview}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Text="{Binding ImageSummaryText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding ErrorText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Grid.Column="2">
                            <!--  空值：只有一个「选择…」（不再常驻一颗看起来能点的「清除」）  -->
                            <Button
                                Height="28"
                                Padding="8,0"
                                Background="{StaticResource ScadaFieldBackgroundBrush}"
                                BorderThickness="0"
                                Command="{Binding PickImageCommand}"
                                Cursor="Hand"
                                FontSize="11"
                                Foreground="{StaticResource ScadaTextBrush}"
                                ToolTip="把图片复制进方案 Image\，迁移方案文件夹不断图">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,4,0" scada:ScadaIconHelper.Glyph="FolderOpen" FontSize="11" />
                                    <TextBlock Text="选择…" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <!--  已选：更换 / 清除用 24px 图标钮（给文件名让出宽度；旧版两颗文字钮把摘要挤成「..」）  -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Background="{StaticResource ScadaSurfaceBrush}"
                                    BorderBrush="{StaticResource ScadaCardBorderBrush}"
                                    BorderThickness="1"
                                    Command="{Binding PickImageCommand}"
                                    Cursor="Hand"
                                    ToolTip="更换图片">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaTextBrush}"
                                        scada:ScadaIconHelper.Glyph="FolderOpen" />
                                </Button>
                                <Button
                                    Width="24"
                                    Height="24"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    Background="{StaticResource ScadaSurfaceBrush}"
                                    BorderBrush="{StaticResource ScadaCardBorderBrush}"
                                    BorderThickness="1"
                                    Command="{Binding ClearImageCommand}"
                                    Cursor="Hand"
                                    ToolTip="清除图片（只清引用，不删文件）">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        scada:ScadaIconHelper.Glyph="Xmark" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="EditAxisList">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding ErrorText}" />
                        <Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            Background="#FFF5F7FA"
                            BorderBrush="#FFDCDFE6"
                            BorderThickness="1"
                            Command="{Binding PickAxesCommand}"
                            Content="选择轴…"
                            Cursor="Hand"
                            FontSize="11"
                            Foreground="#FF303133">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </DataTemplate>

                <!--  列定义（数据表格）：值是一整条 JSON，手填不现实 —— 行上只放摘要 + 「选择列…」。
                      与上面「候选轴」同一形态；按钮配色走令牌（R140：不许新增硬编码色值）。  -->
                <DataTemplate x:Key="EditColumnList">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Summary}" />
                        <Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            Background="{StaticResource ScadaSurfaceBrush}"
                            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                            BorderThickness="1"
                            Command="{Binding PickColumnsCommand}"
                            Content="选择列…"
                            Cursor="Hand"
                            FontSize="11"
                            Foreground="{StaticResource ScadaTextBrush}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </DataTemplate>

                <!--  图表数据项（柱状图 / 饼图）：摘要 + 「配置数据项…」，打开的是带变量选择器的列表编辑器。
                      与「选择列…」分开：那个绑账本列名，这个绑工程变量。  -->
                <DataTemplate x:Key="EditChartSeries">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Summary}" />
                        <Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            Background="{StaticResource ScadaSurfaceBrush}"
                            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                            BorderThickness="1"
                            Command="{Binding PickSeriesCommand}"
                            Content="配置数据项…"
                            Cursor="Hand"
                            FontSize="11"
                            Foreground="{StaticResource ScadaTextBrush}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="EditStateList">
                    <!--  方案级文本列表：选择器 + 管理…；空选项 = 继续用旧 Options  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            Grid.Column="0"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Options}"
                            SelectedValue="{Binding Value, Mode=TwoWay}"
                            SelectedValuePath="Value"
                            Style="{StaticResource ScadaCombo}"
                            ToolTip="{Binding ErrorText}" />

                        <Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            Background="{StaticResource ScadaSurfaceBrush}"
                            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                            BorderThickness="1"
                            Command="{Binding ManageCommand}"
                            Content="管理…"
                            Cursor="Hand"
                            FontSize="11"
                            Foreground="{StaticResource ScadaTextBrush}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="3" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="EditPage">
                    <!--  方案内画面选择器：候选来自当前文档的可导航页；空 = 未选择  -->
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Options}"
                        SelectedValue="{Binding Value, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        Style="{StaticResource ScadaCombo}"
                        ToolTip="{Binding ErrorText}" />
                </DataTemplate>

                <Style x:Key="RowEditorHost" TargetType="ContentControl">
                    <!--  ★ 绑 Content.Kind 而不是 Kind：这个 ContentControl 有两种宿主——
                          ① 普通行：Content={Binding}，DataContext 就是行，两种写法等价；
                          ② 成对行右列 / 曲线卡子行：Content=另一行对象，DataContext 仍是外层对象。
                          按 DataContext 的 Kind 选模板会让右列用左列的编辑器（字重被当成数值框显示 Normal）。  -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Text">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditText}" />
                        </DataTrigger>
                        <!--  只读事实（类型键）：只给一块底色，不给输入框  -->
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="ReadOnly">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditReadOnly}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Number">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditNumber}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="MultilineText">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditMultiline}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Bool">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditBool}" />
                            <!--  编辑器列整格收起：Bool 行由 PropertyRowBody 里那颗内联勾选框呈现
                                  （勾选框自带标签、整行可点）。EditBool 模板仍留着——它是"只要一个勾选框"
                                  的最小形态，将来别处要用不必再造一份。  -->
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Color">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditColor}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Choice">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditChoice}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Image">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditImage}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="ImageFile">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditImageFile}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="AxisList">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditAxisList}" />
                        </DataTrigger>
                        <!--  列定义：摘要 + 「选择列…」（与候选轴同一形态）  -->
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="ColumnList">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditColumnList}" />
                        </DataTrigger>
                        <!--  报表列定义：同一个模板（行上也是"摘要 + 选择列…"），打开的是报表列编辑器  -->
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="ReportColumnList">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditColumnList}" />
                        </DataTrigger>
                        <!--  图表数据项：摘要 + 「配置数据项…」（打开带变量选择器的编辑器）  -->
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="ChartSeries">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditChartSeries}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="StateList">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditStateList}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Kind, RelativeSource={RelativeSource Self}}" Value="Page">
                            <Setter Property="ContentTemplate" Value="{StaticResource EditPage}" />
                        </DataTrigger>
                        <!--
                            描述符声明为只读的键（如管线的 X/Y/宽高/旋转）：显示但置灰。
                            几何由系统算，改了会被下一拍写回——"看得见、点不动"比"直接消失"诚实：
                            用户能知道这个值是什么，也能知道为什么不能改。
                        -->
                        <DataTrigger Binding="{Binding Content.IsReadOnly, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="ToolTip" Value="由系统计算（随两端图元自动重排），不能直接修改" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!--  ====================  事件行（S5）：开关 + 内联动作表  ====================  -->

                <!--  动作行里那三个小按钮共用：正方形、无边框感，密集排布不抢视线  -->
                <Style x:Key="ActionIconButton" TargetType="Button">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Margin" Value="2,0,0,0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                    <Style.Triggers>
                        <!--  到了端点（已经在最上面 / 最下面）按钮会变灰。
                              必须显式写这一条：显式 Style 会整个盖掉主题里的禁用态触发器，
                              而上面那句 Foreground 又压过了主题的灰字，不补就等于
                              "点不动的按钮和能点的长得一模一样"——最伤信任的一种界面。  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ScadaDisabledTextBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!--  事件行本体：勾选框 + （勾上才出现的）动作表。
                    这份内容已抽成公共控件 ScadaEventEditor（属性面板与变量事件弹窗共用一份），
                    所以这里只剩一行挂载——DataContext 换成行内嵌的编辑视图模型。
                    控件自带主题字典与动作卡片模板，面板这一层不再需要它们。
                    仍独占整行宽度、不排标签列：82px 的标签列留给动作表就只剩一条缝了。  -->
                <DataTemplate x:Key="EventRowBody">
                    <!--  与普通行同一水平内边距（12）：事件行虽然独占整行，但它的勾选框左缘
                          必须与上面「启动画面」那颗落在同一条竖线上，否则同一分组里两套基线。  -->
                    <controls:ScadaEventEditor Margin="12,2,12,2" DataContext="{Binding Editor}" />
                </DataTemplate>

                <!--  ====================  动画行（r4）：开关 + 驱动变量 + 参数区  ====================  -->

                <!--  变量带里那颗"✕"：无边框，只在悬停时泛一点红——它是删除语义，
                    平时不该有存在感，否则整条变量带会看着像一张按钮表。
                    定义在动画行这一节的最前面（而不是留在下面属性行那一节）：StaticResource 在
                    同一份字典里只认"已经读到的"资源，档位卡片里的清除按钮要先用到它，写在使用点之后
                    就是一次解析期找不到。  -->
                <Style x:Key="ChipIconButton" TargetType="Button">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Foreground" Value="{StaticResource ScadaChipCloseBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ScadaDangerBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!--  档位卡片里的一格颜色（DataContext = ScadaColorSlot）。
                    标签 + 色块 + 清除 + 取色弹窗，与属性行那块色块同一套手势：
                    点色块开弹窗、点「确定」才写回模型。弹窗正文仍是共用那份 ColorPickerBody。  -->
                <DataTemplate x:Key="ColorSlotEditor">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Margin="0,0,3,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="{Binding Label}" />

                        <ToggleButton
                            x:Name="SlotSwatch"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsColorPickerOpen, Mode=TwoWay}"
                            Style="{StaticResource SwatchToggle}"
                            ToolTip="点开取色板；不配这个通道 = 这一档不改它（保持设计外观）">
                            <Border
                                Width="26"
                                Height="18"
                                Background="{Binding SwatchBrush}"
                                BorderBrush="{StaticResource ScadaSwatchBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        </ToggleButton>

                        <!--  没配色时把清除按钮收掉：一个"点了什么也不会发生"的按钮最伤信任  -->
                        <Button
                            Grid.Column="2"
                            Margin="1,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding ClearCommand}"
                            Content="✕"
                            Style="{StaticResource ChipIconButton}"
                            ToolTip="清除这个颜色（这一档不再改这个通道）"
                            Visibility="{Binding HasColor, Converter={StaticResource BoolVis}}" />

                        <!--  卡片正文与属性行那块色块共用一份（见 ColorPickerBody）。
                              偏移比属性行小一些：这一格本来就靠左，再拽 -82 会探到面板外面去。
                              Content="{Binding}" 与属性行那处同理，同样不能省。  -->
                        <Popup
                            AllowsTransparency="True"
                            HorizontalOffset="-70"
                            IsOpen="{Binding IsColorPickerOpen, Mode=TwoWay}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=SlotSwatch}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ColorPickerBody}" />
                        </Popup>
                    </Grid>
                </DataTemplate>

                <!--  一个档位 = 一张卡片两行（用户拍板）：
                    第一行「值 [低] ~ [高]」+ 上移/下移/删除；第二行「前景[色块] 背景[色块] ☑闪烁」。
                    与事件行的动作卡同一个视觉语言——面板里所有"可增删的一行配置"都长这样，
                    用户学会一处就够用。  -->
                <DataTemplate x:Key="AnimationStateItem">
                    <Border
                        Margin="0,2,0,0"
                            Padding="4,3"
                            Background="{StaticResource ScadaSurfaceBrush}"
                            BorderBrush="{StaticResource ScadaActionCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,3,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="值" />

                                <!--  两端填一样 = 单点值，不一样 = 范围。刻意不摆"模式"下拉：
                                      多一个下拉就多一处要和匹配逻辑对表的状态。  -->
                                <TextBox
                                    Grid.Column="1"
                                    Padding="3,1"
                                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                    FontSize="11"
                                    Text="{Binding ValueLow, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="下端点：变量值 ≤ 它算命中这一档" />

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="~" />

                                <TextBox
                                    Grid.Column="3"
                                    Padding="3,1"
                                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                    FontSize="11"
                                    Text="{Binding ValueHigh, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="上端点：与下端点填一样 = 只匹配这一个值" />

                                <!--  命令与参数都挂在档位表那个 ItemsControl 的 DataContext（动画行）上，
                                      与动作卡的 ↑/↓/✕ 同一个手法。  -->
                                <Button
                                    Grid.Column="4"
                                    Command="{Binding DataContext.MoveStateUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="↑"
                                    Style="{StaticResource ActionIconButton}"
                                    ToolTip="上移（越靠上越先匹配）" />
                                <Button
                                    Grid.Column="5"
                                    Command="{Binding DataContext.MoveStateDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="↓"
                                    Style="{StaticResource ActionIconButton}"
                                    ToolTip="下移" />
                                <Button
                                    Grid.Column="6"
                                    Command="{Binding DataContext.RemoveStateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Content="✕"
                                    Style="{StaticResource ActionIconButton}"
                                    ToolTip="删除这一档" />
                            </Grid>

                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ContentControl
                                    Grid.Column="0"
                                    Content="{Binding ForegroundSlot}"
                                    ContentTemplate="{StaticResource ColorSlotEditor}" />

                                <ContentControl
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Content="{Binding FillSlot}"
                                    ContentTemplate="{StaticResource ColorSlotEditor}" />

                                <CheckBox
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Content="闪烁"
                                    FontSize="11"
                                    IsChecked="{Binding IsFlashing, Mode=TwoWay}"
                                    ToolTip="命中这一档时按统一节拍在正常 / 变淡之间切换" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <!--  动画行本体：外层勾选框（= 这条动画配没配）+ 勾上才展开的配置区。
                    与事件行一样<b>独占整行宽度</b>，不排标签列——82px 的标签列留给档位卡片就只剩一条缝。  -->
                <DataTemplate x:Key="AnimationRowBody">
                    <StackPanel Margin="12,2,12,2" ToolTip="{Binding Description}">
                        <!--  v2 折叠头：勾选管「配没配」，箭头管展开，摘要常显（配了但没选变量 = 琥珀「未选变量」）  -->
                        <Border Padding="6,4" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnimation}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource ScadaAccentSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Content="{Binding DisplayName}"
                                        FontSize="12"
                                        IsChecked="{Binding BoolValue, Mode=TwoWay}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding HasAnimation, Converter={StaticResource BoolVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SummaryIsWarning}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ToggleButton
                                        Grid.Column="2"
                                        Width="20"
                                        Height="20"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Focusable="False"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                        ToolTip="展开 / 收起参数区"
                                        Visibility="{Binding HasAnimation, Converter={StaticResource BoolVis}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path
                                                        x:Name="Chevron"
                                                        Width="9"
                                                        Height="5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M 0 0 L 4.5 4.5 L 9 0"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Stroke="{StaticResource ScadaSecondaryTextBrush}"
                                                        StrokeEndLineCap="Round"
                                                        StrokeLineJoin="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="1.4" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!--  参数区：配了 + 展开才出现  -->
                            <StackPanel
                                Margin="16,4,0,2"
                                Visibility="{Binding IsBodyVisible, Converter={StaticResource BoolVis}}">

                            <!--  启用 = 跑不跑；与上面那个勾（有没有）是两件事：停用留着配置，删除才丢配置  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="启用"
                                    FontSize="11"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    ToolTip="取消勾选 = 暂停这条动画（档位与范围原样留着），不是删除" />

                                <!--  名字为空（=还没选）时由 TargetNullValue 顶上一句占位文案  -->
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Text="{Binding VariableDisplayName, TargetNullValue=（还没选变量）}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding VariableDisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVariable}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource ScadaWarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button
                                    Grid.Column="2"
                                    Padding="6,1"
                                    Command="{Binding PickVariableCommand}"
                                    Content="选变量"
                                    FontSize="11"
                                    ToolTip="这条动画由这个变量的值驱动" />

                                <Button
                                    Grid.Column="3"
                                    Margin="3,0,0,0"
                                    Padding="4,1"
                                    Command="{Binding ClearVariableCommand}"
                                    Content="✕"
                                    FontSize="11"
                                    ToolTip="断开驱动变量（动画本身与档位都留着）"
                                    Visibility="{Binding HasVariable, Converter={StaticResource BoolVis}}" />
                            </Grid>

                            <!--  没选变量：运行态会照实跳过，先把这件事说在面板上  -->
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{StaticResource ScadaWarningBrush}"
                                Text="还没选驱动变量，这条动画运行时会跳过。"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVariable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--  范围值：移动（值 → 位置）与可见性（值 → 显隐）都要它，外观变化不要。
                                  所以它既不归"移动"也不归"可见性"，单独按"这两者之一"显示。  -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMove}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsVisibility}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,3,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="范围" />

                                    <TextBox
                                        Grid.Column="1"
                                        Padding="3,1"
                                        BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                        FontSize="11"
                                        Text="{Binding RangeLow, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="范围值1：变量值 ≤ 它 → 停在起始位置 / 不命中" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="3,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="~" />

                                    <TextBox
                                        Grid.Column="3"
                                        Padding="3,1"
                                        BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                        FontSize="11"
                                        Text="{Binding RangeHigh, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="范围值2：变量值 ≥ 它 → 停在结束位置 / 命中" />
                                </Grid>
                            </StackPanel>

                            <!--  外观变化：多档「值 → 外观」表  -->
                            <StackPanel Visibility="{Binding IsAppearance, Converter={StaticResource BoolVis}}">
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="档位（自上而下依次匹配，第一个命中的生效）：" />

                                <ItemsControl ItemTemplate="{StaticResource AnimationStateItem}" ItemsSource="{Binding States}" />

                                <!--  勾了动画却一档都没配：运行态等于没配，必须说出来，
                                      否则用户会以为"我明明勾上了"（与事件行删光动作同一口径）  -->
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaWarningBrush}"
                                    Text="还没有档位，运行态命中时不会改变外观。"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding States.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button
                                    Margin="0,4,0,0"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AddStateCommand}"
                                    Content="+ 添加档位"
                                    FontSize="11"
                                    ToolTip="新档位默认是 0 ~ 0 且不改外观，填上值域再配色" />
                            </StackPanel>

                            <!--  水平 / 垂直移动：起始位置（只读）+ 结束位置  -->
                            <StackPanel Visibility="{Binding IsMove, Converter={StaticResource BoolVis}}">
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="起始位置" />
                                    <!--  只读：起始位置就是图元当前的 X / Y（手册 7.5.1.4 明写不可编辑）。
                                          存一份可编辑的副本只会带来"挪了图元、动画还按老起点算"的劈叉。  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaLabelTextBrush}"
                                        Text="{Binding StartPositionText}"
                                        ToolTip="起始位置不可编辑：它就是图元当前的 X / Y" />
                                </Grid>

                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="结束位置" />

                                    <!--  水平移动改 X、垂直移动改 Y：两个轴共用这一块参数区，
                                          所以摆两个文本框按类型互斥显示，而不是让行去暴露一个"当前轴"的枚举。  -->
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Padding="3,1"
                                        BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                        FontSize="11"
                                        Text="{Binding EndXText, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="变量值 ≥ 范围值2 时停在的 X 坐标">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVerticalMove}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Padding="3,1"
                                        BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                        FontSize="11"
                                        Text="{Binding EndYText, UpdateSourceTrigger=LostFocus}"
                                        ToolTip="变量值 ≥ 范围值2 时停在的 Y 坐标">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVerticalMove}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </StackPanel>

                            <!--  可见性：命中范围时显示还是隐藏。
                                  用一颗勾选框而不是"显示/隐藏"两个单选：后者要一个取反转换器，
                                  而"勾上 = 命中时显示"本身就是最好懂的措辞。  -->
                            <StackPanel Visibility="{Binding IsVisibility, Converter={StaticResource BoolVis}}">
                                <CheckBox
                                    Margin="0,4,0,0"
                                    Content="命中范围时显示对象（不勾 = 隐藏）"
                                    FontSize="11"
                                    IsChecked="{Binding VisibleInRange, Mode=TwoWay}"
                                    ToolTip="不命中范围时不接管可见性，交回图层判定（该显示还是显示）" />
                            </StackPanel>

                            <!--  启用对象：0 = 禁用（点不动）、非 0 = 启用；原因挂在 ToolTip 上。  -->
                            <StackPanel Visibility="{Binding IsEnable, Converter={StaticResource BoolVis}}">
                                <CheckBox
                                    Margin="0,4,0,0"
                                    Content="反转语义（勾上 = 值为 1 时禁用）"
                                    FontSize="11"
                                    IsChecked="{Binding EnableInvert, Mode=TwoWay}"
                                    ToolTip="有的 PLC 用 1 表示允许，有的用 1 表示联锁中；按现场接线选" />
                                <TextBox
                                    Margin="0,4,0,0"
                                    Padding="3,2"
                                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                                    FontSize="11"
                                    Text="{Binding DisableReason, UpdateSourceTrigger=LostFocus}"
                                    ToolTip="禁用时鼠标悬停显示的原因（联锁/权限/无数据各配一句）" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>

                <!--  ====================  一行属性  ====================  -->

                <!--  行尾那颗按钮的共用尺码。绑定/清除两颗按钮<b>必须同宽同边距</b>：
                    它们各自落在自己那一行的 Auto 列里，宽度一旦不同，上一行的编辑器列
                    就会比下一行的变量带短一截，两行的右缘对不齐。  -->
                <Style x:Key="BindSlotButton" TargetType="Button">
                    <Setter Property="Width" Value="22" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Margin" Value="4,0,0,0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="{StaticResource ScadaSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ScadaPanelBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!--  悬停只换描边、不换图标色：绑定的那档是"蓝底白链"，
                                          图标色若也跟着变蓝就成了蓝底蓝链（模板触发器的优先级高于样式触发器）  -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--  绑定按钮：没绑 = 白底灰链；绑上 = 实心主色 + 白链（与 web 参考项目同一手法，
                      比"灰色小字 ƒx"更像一个可操作的状态）。  -->
                <!--  Tag 是给断言用的稳定锚点：内容从文字换成图标之后，按 Content 找按钮就再也找不到了。  -->
                <Style x:Key="BindGlyphButton" TargetType="Button" BasedOn="{StaticResource BindSlotButton}">
                    <Setter Property="Tag" Value="BindVariable" />
                    <Setter Property="ToolTip" Value="绑定工程变量" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBinding}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ScadaAccentBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ScadaOnAccentTextBrush}" />
                            <Setter Property="ToolTip" Value="已绑定变量，点击可换绑" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

                <!--  行本体：标签 + 编辑器 + ƒx；绑了变量的行，下面再挂一条"已绑"带。
                    行高只在绑定时才长——没绑的行仍是原来的一行，不为少数派付代价。
                    水平内边距 12 在行上而不是在容器上：分组卡片拆掉之后，行是唯一知道
                    "内容离面板边缘多远"的一层，左右各 12 才不会一边贴着、一边空一截。  -->
                <DataTemplate x:Key="PropertyRowBody">
                    <StackPanel Margin="12,3,12,3" ToolTip="{Binding Description}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!--  v2：标签列 72（原 64）。「不透明度」「曲线 1 名称」不再被省略号截断；
                                      编辑器列仍 ≥ 176（300 面板）。  -->
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <!--  行尾槽位固定 26px（= 绑定按钮 Width 22 + Margin 左 4），
                                      即便这一行不可绑、按钮被 Collapsed 收掉，槽位也照样占着——
                                      否则不可绑行的编辑器会比可绑行宽出 26px，整列右缘参差不齐。  -->
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>

                            <!--  Bool 行：勾选框自带标签、整行一个可点目标（与事件行同一形态）。  -->
                            <CheckBox
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                ToolTip="{Binding ErrorText}">
                                <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Bool">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <!--  绑了变量的 Bool：勾选框收起，由 chip 表示「值由变量驱动」；
                                                      标签改由下面那条 TextBlock 显示（否则整行没有名字）。  -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Kind}" Value="Bool" />
                                                        <Condition Binding="{Binding HasBinding}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                </CheckBox.Style>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource ScadaLabelTextBrush}"
                                    Text="{Binding DisplayName}" />
                            </CheckBox>

                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DisplayName}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <!--  Bool 行已由上面那颗内联勾选框代劳  -->
                                            <DataTrigger Binding="{Binding Kind}" Value="Bool">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <!--  绑了变量的 Bool：勾选框收起，标签回到左列  -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Kind}" Value="Bool" />
                                                    <Condition Binding="{Binding HasBinding}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <!--  只读行：标签与值一起降级，行尾挂锁  -->
                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Grid.Column="1">
                                <!--  编辑器：绑上变量后整格换成 chip（v2：不另占一行，行高不变）  -->
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource RowEditorHost}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBinding}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>

                                <Border
                                    Height="28"
                                    Background="{StaticResource ScadaBoundChipBrush}"
                                    BorderBrush="{StaticResource ScadaBoundChipBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    ToolTip="运行态由这个变量驱动本属性；此处只是显示，寻址用的是变量 Id">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!--  Hidden 而不是 Collapsed：未绑时不可见但不退出视觉树，
                                                  既保留「清除绑定」按钮的实例（断言与命令可用性都认它），
                                                  又不改变行高（编辑器与 chip 同格同高）。  -->
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBinding}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="7,0,3,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  ƒ 是面板里"变量"的记号，与行尾那颗按钮同源，一眼能串起来  -->
                                        <TextBlock
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource ScadaBoundGlyphBrush}"
                                            Text="ƒ" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{StaticResource ScadaBoundBrush}"
                                            Text="{Binding BindingVariableName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding BindingVariableName}" />

                                        <Button
                                            Grid.Column="2"
                                            Margin="4,0,0,0"
                                            Command="{Binding DataContext.ClearBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="✕"
                                            Style="{StaticResource ChipIconButton}"
                                            ToolTip="清除绑定（只断开变量驱动，不改当前值）" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--  ƒx 只对描述符声明了 IsBindable 的行出现；只读行在同一个槽位显示锁。
                                  不可绑的是"设计期版面语言"：位置与尺寸、外观两组
                                  （X/Y/宽/高/旋转、填充色/边框色/边框粗细/圆角），外加名称、
                                  字号、字重与事件行——它们决定的是"版面长什么样"，
                                  改它属于重新设计，而不是运行期被变量驱动。  -->
                            <Grid Grid.Column="2">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                    Text="&#xF023;"
                                    ToolTip="由系统计算（随两端图元自动重排），不能直接修改"
                                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolVis}}" />
                                <Button
                                    Command="{Binding DataContext.BindVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource BindGlyphButton}"
                                    Visibility="{Binding IsBindable, Converter={StaticResource BoolVis}}">
                                    <!--  链接图标（lucide link-2 的 24 网格路径）：两条 C 形弧 + 中间短横。
                                          颜色绑按钮的 Foreground：没绑是灰、绑上是白（实心底），一处改两态跟着走。  -->
                                    <Viewbox Width="13" Height="13">
                                        <Canvas Width="24" Height="24">
                                            <Path
                                                Data="M9,17 H7 A5,5 0 0 1 7,7 H9 M15,7 H17 A5,5 0 1 1 17,17 H15 M8,12 H16"
                                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="2" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </Grid>

                        <!--  非法值的原因就地写在行下面：只挂在输入框的 ToolTip 上时，
                              "哪里错了"必须先悬停才知道；而这时用户已经在别处敲字了。
                              折叠时零高度，不影响正常行的行距。  -->
                        <TextBlock
                            Margin="72,2,0,0"
                            FontSize="11"
                            Foreground="{StaticResource ScadaDangerBrush}"
                            Text="{Binding ErrorText}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>

                <!--  ====================  v2 行布局（2026-10-28）  ====================  -->
                <!--  ① 上标签：名称 / 文字 / 说明这类长文本，标签在上、控件全宽，永不截断。  -->
                <DataTemplate x:Key="StackedRowBody">
                    <StackPanel Margin="12,4,12,4" ToolTip="{Binding Description}">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="11"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding DisplayName}" />
                        <ContentControl Content="{Binding}" Style="{StaticResource RowEditorHost}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{StaticResource ScadaDangerBrush}"
                            Text="{Binding ErrorText}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>

                <!--  ② 成对网格：X/Y、宽/高、边框粗细/圆角、字号/字重、弹窗偏移 X/Y。
                       view-only：右行仍留在 Rows 里，由左行的模板渲染，自己的模板收起（见 CollapsedRowBody）。  -->
                <DataTemplate x:Key="PairedRowBody">
                    <StackPanel Margin="12,3,12,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" ToolTip="{Binding Description}">
                                <TextBlock
                                    Margin="0,0,0,3"
                                    FontSize="10.5"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding DisplayName}" />
                                <ContentControl Content="{Binding}" Style="{StaticResource RowEditorHost}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource ScadaDangerBrush}"
                                    Text="{Binding ErrorText}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" ToolTip="{Binding PairWith.Description}">
                                <TextBlock
                                    Margin="0,0,0,3"
                                    FontSize="10.5"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="{Binding PairWith.DisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding PairWith.DisplayName}" />
                                <ContentControl Content="{Binding PairWith}" Style="{StaticResource RowEditorHost}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource ScadaDangerBrush}"
                                    Text="{Binding PairWith.ErrorText}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PairWith.IsValid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>

                <!--  ③ 成对行的右伙伴：自己的模板收起（左行已经把两格都画了）。  -->
                <DataTemplate x:Key="CollapsedRowBody">
                    <Border Height="0" Visibility="Collapsed" />
                </DataTemplate>

                <!--  行级分流：复合编辑区（事件行 / 动画行）整份换模板，普通行走上面那份。
                    判据是行自己的 EditorKind 枚举，<b>不认具体类型</b>——
                    与编辑器按 Kind 分流同一个手法，也就不必让 XAML 认得自定义行类型。
                    用枚举而不是"是不是复合编辑区"的布尔：事件行与动画行的内部结构完全不同，
                    布尔只能回答"要不要换"，回答不了"换成哪一份"。  -->
                <DataTemplate x:Key="PropertyRow">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource PropertyRowBody}" />
                                <Style.Triggers>
                                    <!--  成对行的右伙伴：收起（左行负责画两格）  -->
                                    <DataTrigger Binding="{Binding IsPairedFollow}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource CollapsedRowBody}" />
                                    </DataTrigger>
                                    <!--  成对行的左行：一行两列  -->
                                    <DataTrigger Binding="{Binding HasPair}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource PairedRowBody}" />
                                    </DataTrigger>
                                    <!--  长文本：上标签、控件全宽  -->
                                    <DataTrigger Binding="{Binding UseStackedLayout}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource StackedRowBody}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EditorKind}" Value="Event">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EventRowBody}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EditorKind}" Value="Animation">
                                        <Setter Property="ContentTemplate" Value="{StaticResource AnimationRowBody}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>

                <!--  ====================  v2 曲线卡（多曲线趋势「数据」组）  ====================  -->
                <!--  4 条曲线一行一条：颜色点 + 名称 + 值 + ƒx。行对象仍是普通属性行，
                      这里只是按曲线重组呈现；绑定 / 校验 / 撤销链路一字未改。  -->
                <Style x:Key="SeriesSwatchToggle" TargetType="ToggleButton">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border
                                    x:Name="Ring"
                                    Padding="1"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                        <Setter TargetName="Ring" Property="Background" Value="{StaticResource ScadaAccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <DataTemplate x:Key="SeriesCardBody">
                    <StackPanel>
                        <Border
                            Margin="12,4,12,4"
                            Padding="8,7,8,8"
                            Background="{StaticResource ScadaFieldBackgroundBrush}"
                            BorderBrush="{StaticResource ScadaCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="10.5"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="名称" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="10.5"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="值" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding SeriesCard.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="26" />
                                                    </Grid.ColumnDefinitions>

                                                    <ToggleButton
                                                        x:Name="SeriesSwatch"
                                                        Grid.Column="0"
                                                        IsChecked="{Binding ColorRow.IsColorPickerOpen, Mode=TwoWay}"
                                                        Style="{StaticResource SeriesSwatchToggle}"
                                                        ToolTip="{Binding Title}">
                                                        <Border
                                                            Width="14"
                                                            Height="14"
                                                            Background="{Binding ColorRow.SwatchBrush}"
                                                            BorderBrush="{StaticResource ScadaSwatchBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7" />
                                                    </ToggleButton>

                                                    <Popup
                                                        AllowsTransparency="True"
                                                        HorizontalOffset="-30"
                                                        IsOpen="{Binding ColorRow.IsColorPickerOpen, Mode=TwoWay}"
                                                        Placement="Bottom"
                                                        PlacementTarget="{Binding ElementName=SeriesSwatch}"
                                                        PopupAnimation="Fade"
                                                        StaysOpen="False">
                                                        <ContentControl Content="{Binding ColorRow}" ContentTemplate="{StaticResource ColorPickerBody}" />
                                                    </Popup>

                                                    <ContentControl
                                                        Grid.Column="1"
                                                        Content="{Binding NameRow}"
                                                        Style="{StaticResource RowEditorHost}" />

                                                    <ContentControl
                                                        Grid.Column="2"
                                                        Content="{Binding ValueRow}"
                                                        Style="{StaticResource RowEditorHost}" />

                                                    <Button
                                                        Grid.Column="3"
                                                        Command="{Binding DataContext.BindVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding ValueRow}"
                                                        DataContext="{Binding ValueRow}"
                                                        Style="{StaticResource BindGlyphButton}"
                                                        Visibility="{Binding IsBindable, Converter={StaticResource BoolVis}}">
                                                        <Viewbox Width="12" Height="12">
                                                            <Canvas Width="24" Height="24">
                                                                <Path
                                                                    Data="M9,17 H7 A5,5 0 0 1 7,7 H9 M15,7 H17 A5,5 0 1 1 17,17 H15 M8,12 H16"
                                                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                    StrokeEndLineCap="Round"
                                                                    StrokeLineJoin="Round"
                                                                    StrokeStartLineCap="Round"
                                                                    StrokeThickness="2" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>

                                                <!--  已绑：行下一条轻量小字标注（ƒ + 变量名 + ✕），不画带边框的盒子  -->
                                                <StackPanel
                                                    Margin="18,1,0,0"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding ValueRow.HasBinding, Converter={StaticResource BoolVis}}">
                                                    <TextBlock
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        Foreground="{StaticResource ScadaBoundGlyphBrush}"
                                                        Text="ƒ" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10.5"
                                                        Foreground="{StaticResource ScadaBoundBrush}"
                                                        Text="{Binding ValueRow.BindingVariableName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding ValueRow.BindingVariableName}" />
                                                    <Button
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.ClearBindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding ValueRow}"
                                                        Content="✕"
                                                        Style="{StaticResource ChipIconButton}"
                                                        ToolTip="清除绑定（只断开变量驱动，不改当前值）" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Margin="0,5,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                    Text="色点 = 曲线颜色（自「外观」组移入）；ƒx 绑变量；名称留空 = 图例不显示该条。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  3 项设置沿用普通行（时间窗 / 量程模式 / 显示图例）  -->
                        <ContentControl Content="{Binding SeriesCard.TimeWindowRow}" ContentTemplate="{StaticResource PropertyRow}" />
                        <ContentControl Content="{Binding SeriesCard.RangeModeRow}" ContentTemplate="{StaticResource PropertyRow}" />
                        <ContentControl Content="{Binding SeriesCard.ShowLegendRow}" ContentTemplate="{StaticResource PropertyRow}" />
                    </StackPanel>
                </DataTemplate>

                <!--  组体分流：曲线卡组走 SeriesCardBody，其余走普通行列表。  -->
                <DataTemplate x:Key="GroupBody">
                    <StackPanel>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SeriesCardBody}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeriesCard}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <ItemsControl ItemTemplate="{StaticResource PropertyRow}" ItemsSource="{Binding Rows}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeriesCard}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!--  基座页说明条：只在编辑基座（跨页公共层）时占位，普通页上 Collapsed = 不占高度  -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ====================  对象头：编辑的是谁 + 锁定  ====================  -->
            <!--  两行而不是一行（对齐设计基线）：第一行名字、第二行类型键。
                  旧版是一行「类型显示名 · 名字」，而新建图元的 Name 默认就等于 DisplayName，
                  于是面板顶上长期显示成「按钮 · 按钮」——两段一样的信息各占一半宽度。  -->
            <!--  图标只给一个视觉锚点，不按图元类型换：图元库没有图标资产（工具箱那边也只是名字 + 类型键），
                  在这里现造一张"类型 → 码点"的映射表，加一类图元就要多记一处，不值当。  -->
            <Border
                Grid.Row="0"
                Background="{StaticResource ScadaSurfaceBrush}"
                BorderBrush="{StaticResource ScadaHairlineBrush}"
                BorderThickness="0,0,0,1">
                <Grid Margin="12,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="34"
                        Height="34"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource ScadaAccentSoftBrush}"
                        CornerRadius="9">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="17"
                            Foreground="{StaticResource ScadaAccentBrush}"
                            Text="{Binding HeaderGlyph}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ScadaTextBrush}"
                            Text="{Binding HeaderTitle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding HeaderTitle}" />
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                            <!--  类型键：写进 .vms 的那个标识（Hmi.Button），不是 CLR 类名；等宽字体便于扫读  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="10.5"
                                Foreground="{StaticResource ScadaFaintTextBrush}"
                                Text="{Binding HeaderSubtitle}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding HeaderSubtitle}" />
                            <!--  画面模式：尺寸 chip（1920 × 1080）；图元模式为空 → 整块收起  -->
                            <Border
                                Margin="6,0,0,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource ScadaBadgeBackgroundBrush}"
                                CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeaderMeta}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="{Binding HeaderMeta}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  锁定是模型字段（要落盘），画布的拖动/改尺寸都认它。  -->
                    <!--  写回经视图模型转一道（IsElementLocked → SetSelectedLocked → TrySetElementLocked），  -->
                    <!--  而不是直绑 Element.IsLocked：裸 setter 绕开了 BeginEdit，撤销按钮上只会显示"编辑"。  -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding HasElement, Converter={StaticResource BoolVis}}">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="锁定" />
                        <ToggleButton
                            Style="{StaticResource SwitchToggle}"
                            IsChecked="{Binding IsElementLocked, Mode=TwoWay}"
                            ToolTip="锁定后在画布上不能拖动、不能改尺寸（防误挪已摆好的底图）；选中多个图元时可从右键菜单整批锁定" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ====================  搜索  ====================  -->
            <!--  匹配属性名 / 键名 / 分组名（口径见 VM 的 MatchesSearch）。  -->
            <!--  只过滤"显示哪些行"，不重建行——重建会把正在编辑的输入框连焦点一起换掉。  -->
            <Grid Grid.Row="1" Margin="10,8,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Height="32"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource ScadaFieldBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ScadaSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ScadaAccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="9,0,5,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="11"
                            Foreground="{StaticResource ScadaFaintTextBrush}"
                            Text="&#xf002;" />

                        <TextBox
                            Grid.Column="1"
                            Padding="0,4"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  占位提示：WPF 没有内建 placeholder，用一层不接鼠标的文字盖在输入框上  -->
                        <TextBlock
                            Grid.Column="1"
                            Margin="1,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource ScadaFaintTextBrush}"
                            IsHitTestVisible="False"
                            Text="搜索属性">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!--  清空：只有打了字才出现。固定 18×18 + Padding=0（R68：图标字符按钮必须自己定内边距，
                              否则会吃应用级 Fluent 隐式 Button 样式的 11,5,11,6，把 ✕ 削掉）。  -->
                        <Button
                            Grid.Column="2"
                            Width="18"
                            Height="18"
                            Margin="0,0,5,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ClearSearchCommand}"
                            Content="✕"
                            Cursor="Hand"
                            FontSize="10"
                            Foreground="{StaticResource ScadaChipCloseBrush}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Border>

                <!--  v2：折叠全部 / 展开全部（长面板一键收纳；搜索期间命中组强制展开）  -->
                <Button
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Margin="8,0,0,0"
                    Padding="0"
                    Background="{StaticResource ScadaSurfaceBrush}"
                    BorderBrush="{StaticResource ScadaCardBorderBrush}"
                    BorderThickness="1"
                    Command="{Binding ToggleFoldAllCommand}"
                    Content="{Binding FoldGlyph}"
                    Cursor="Hand"
                    FontSize="14"
                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                    ToolTip="{Binding FoldTooltip}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!--  ====================  基座页说明条  ====================  -->
            <!--  只在"当前页是基座（跨页公共层）"时出现。它回答的是现场最容易误解的那件事：
                  改了基座的底色/尺寸，引用页为什么一点变化都没有 —— 因为基座只合成图元。
                  文案只给一条规则 + 一个正解（顶栏「新建 ▾」里的那条命令），不写长篇解释。  -->
            <Border
                Grid.Row="2"
                Margin="10,0,10,2"
                Padding="8,6"
                Background="{StaticResource ScadaBadgeBackgroundBrush}"
                BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBasePageEditing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    FontSize="11"
                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                    Text="公共层：只有图元会合成到引用页；底色 / 尺寸 / 网格不参与。要公共底色 → 新建 ▾ → 插入公共底板矩形"
                    TextWrapping="Wrap" />
            </Border>

            <!--  ====================  属性行  ====================  -->
            <!--  水平边距交给行自己（12px），这里只留纵向：滚动条占掉右缘时，
               "行的内边距"与"面板的内边距"不会各算一套、左右还不对称。  -->
            <ScrollViewer
                Grid.Row="3"
                Margin="0,4,0,4"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  v2：每组一张白卡（圆角 10 + 淡蓝灰描边 + 极浅投影）。
                                  组头 38px：组名 + 错误/待完成点 + 计数胶囊 + 箭头；点整头折叠。  -->
                            <Border
                                Margin="0,0,0,8"
                                Background="{StaticResource ScadaSurfaceBrush}"
                                BorderBrush="{StaticResource ScadaCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="6"
                                        Color="{StaticResource ScadaCardShadowColor}"
                                        Opacity="0.08"
                                        ShadowDepth="1" />
                                </Border.Effect>
                                <Expander
                                    FontSize="12"
                                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                    Style="{StaticResource SectionExpander}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource ScadaTextBrush}"
                                                Text="{Binding Name}" />
                                            <!--  红点：有非法行；琥珀点：有待完成项（有红点时琥珀点让位）  -->
                                            <Border
                                                Width="6"
                                                Height="6"
                                                Margin="3,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource ScadaDangerBrush}"
                                                CornerRadius="3"
                                                ToolTip="{Binding ErrorTooltip}"
                                                Visibility="{Binding HasError, Converter={StaticResource BoolVis}}" />
                                            <Border
                                                Width="6"
                                                Height="6"
                                                Margin="3,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource ScadaWarningBrush}"
                                                CornerRadius="3"
                                                ToolTip="{Binding ErrorTooltip}"
                                                Visibility="{Binding ShowWarningDot, Converter={StaticResource BoolVis}}" />
                                            <Border Style="{StaticResource SectionCountBadge}">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource ScadaLabelTextBrush}"
                                                    Text="{Binding CountText}" />
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GroupBody}" />
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  ====================  空态  ====================  -->
            <!--  判空看 HasRows，不看 HasElement：画面模式下没有选中图元，但面板有六行内容，  -->
            <!--  用 HasElement 判空会把水印盖在画面属性上。文案由 VM 按成因给出（未打开方案 /  -->
            <!--  类型未注册 / 画面没有可编辑属性 / 搜索无结果），这里不再写死。  -->
            <!--  三件套（图标 + 标题 + 正文）而不是一段长句：旧版四行字挤在一起，  -->
            <!--  扫一眼分不清是"没选对象"还是"这个图元本机不认识"。  -->
            <StackPanel
                Grid.Row="3"
                Margin="20,28,20,0"
                HorizontalAlignment="Center"
                IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRows}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    Background="{StaticResource ScadaBadgeBackgroundBrush}"
                    BorderBrush="{StaticResource ScadaPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="15"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="&#xf245;" />
                </Border>

                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource ScadaTextBrush}"
                    Text="{Binding EmptyTitle}" />

                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="11.5"
                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                    Text="{Binding EmptyHint}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
