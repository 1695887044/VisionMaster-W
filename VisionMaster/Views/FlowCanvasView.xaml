<UserControl
    x:Class="VisionMaster.Views.FlowCanvasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VisionMaster.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:helpers="clr-namespace:VisionMaster.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    xmlns:vm="clr-namespace:VisionMaster.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="900"
    prism:ViewModelLocator.AutoWireViewModel="True"
    DataContextChanged="OnDataContextChanged"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  流程节点画布（海康式一图全展开）  -->
    <!--  整棵流程树摊在同一张画布上：模块盒 + 容器框（可折叠）+ 分支泳道 + 模块级聚合连线；  -->
    <!--  连线只在模块间画，具体端口绑定在变量绑定弹窗里维护（右键连线可逐条解绑/重开弹窗）。  -->
    <!--  执行顺序与连线合法性一律来自 FlowTopology，视图不参与判定。  -->
    <!--  ==========================================  -->

    <UserControl.Resources>

        <helpers:CategoryAccentBrushConverter x:Key="CategoryAccentBrushConverter" />
        <helpers:CategorySoftBrushConverter x:Key="CategorySoftBrushConverter" />
        <helpers:CategoryBorderBrushConverter x:Key="CategoryBorderBrushConverter" />

        <!--  模块卡片：flow-logic 156×58 / 圆角 10 / 1px 描边；
              运行=蓝边、失败=红边+淡红底、选中=2px 运行色；
              禁用态的整节点降透明在模板根 Grid 上（含状态点/耗时/序号/注释）。  -->
        <Style x:Key="StepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FlowCanvasNodeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasNodeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model.State}" Value="Running">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasStateRunningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.State}" Value="Failed">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                    <Setter Property="Background" Value="{StaticResource FlowCanvasNodeFailedBackgroundBrush}" />
                </DataTrigger>
                <!--  调试命中：停在断点/单步位置 = 橙色描边（与断点红点区分）  -->
                <DataTrigger Binding="{Binding Model.IsDebugStopped}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasWarningBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <!--  选中态：2px 运行色边框（Nodify 的 SelectedBrush 光晕仍保留在 ItemContainer 上）  -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasStateRunningBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  节点状态点：7×7，运行中脉冲；成功/失败/跳过各一色（StepState 只有这五个成员）  -->
        <Style x:Key="NodeStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{StaticResource FlowCanvasStateIdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model.State}" Value="Running">
                    <Setter Property="Fill" Value="{StaticResource FlowCanvasStateRunningBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="NodeDotPulse">
                            <Storyboard>
                                <DoubleAnimation
                                    AutoReverse="True"
                                    Duration="0:0:0.8"
                                    From="1"
                                    RepeatBehavior="Forever"
                                    Storyboard.TargetProperty="Opacity"
                                    To="0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="NodeDotPulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.State}" Value="Success">
                    <Setter Property="Fill" Value="{StaticResource FlowCanvasStateSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.State}" Value="Failed">
                    <Setter Property="Fill" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.State}" Value="Skipped">
                    <Setter Property="Fill" Value="{StaticResource FlowCanvasStateSkippedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  容器状态点：沿用节点语义色；条件缺失压过一切（红点，与编译错误同一判据）  -->
        <Style
            x:Key="ContainerStatusDotStyle"
            BasedOn="{StaticResource NodeStatusDotStyle}"
            TargetType="Ellipse">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMissingCondition}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  连接点（每节点左入右出各一枚，骑在盒子边缘上）：
              DataContext 切到连接器 VM——实心/空心的颜色旋钮是 BorderBrush：
              已连线 = 亮蓝实心常显（**前提是数据线开关开着**——数据线隐藏时已连线端口
              回退"悬停浮现"态，与未连线同款，免得满画布浮着看不见线的端口点）；
              未连线默认隐藏，悬停节点浮现淡灰空心（拖线入口不丢），
              拖线手势中全部现形（可达性由 IsConnectable 压灰提示，不受显隐开关影响）。
              Padding 必须归零：Nodify 的 NodeInput/NodeOutput 默认 Padding=4,2，
              在小控件盒内溢出会把可见圆环挤成残弧（2026-10-07 审查实测）。
              Anchor 不在这里回报——连线端点由主 VM 按盒子边缘中点直接算（确定性）。  -->
        <Style x:Key="FlowConnectorStyle" TargetType="Control">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasNodeSubTextBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <!--  悬停浮现：未连线常态、已连线但数据线隐藏的回退态，都靠悬停显形。
                      放在"已连线常显"之前：已连线且开着的端口悬停时仍是常显的 1.0（后写者赢）  -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.85" />
                </MultiDataTrigger>
                <!--  已连线且数据线开关开着 → 亮蓝常显（UserControl 的 DataContext 就是画布 VM）  -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsConnected}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShowDataLinks, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasNodeIconBrush}" />
                    <Setter Property="Opacity" Value="1" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDragInProgress}" Value="True">
                    <Setter Property="Opacity" Value="0.85" />
                </DataTrigger>
                <!--  拖线中的不可达端口：显示但压灰（放最后覆盖前两条的透明度）  -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDragInProgress}" Value="True" />
                        <Condition Binding="{Binding IsConnectable}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="0.25" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--  ====================  模块盒（真实步骤，flow-logic 156×58）  ====================  -->
        <DataTemplate x:Key="StepNodeTemplate" DataType="{x:Type vm:CanvasNodeViewModel}">
            <!--  两行结构：Row0 = 模块卡片（NodeWidth/NodeHeight 锚点几何基准），Row1 = 算子注释行
                  （卡片下缘外的灰色小字，海康式；有注释才显示，向下超出不影响锚点几何）  -->
            <Grid x:Name="StepNodeRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Width="{x:Static vm:FlowCanvasViewModel.NodeWidth}"
                    Height="{x:Static vm:FlowCanvasViewModel.NodeHeight}"
                    Grid.Row="0">
                    <!--  节点右键菜单：模板内联 = 每节点一份实例，DataContext 即节点 VM，命令走注入的闭包  -->
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding OpenBindingCommand}" Header="编辑绑定…（打开变量绑定）" />
                            <MenuItem Command="{Binding OpenModuleParametersCommand}" Header="步骤参数…" />
                            <Separator />
                            <MenuItem
                                Command="{Binding CopyCommand}"
                                Header="复制"
                                ToolTip="复制该模块（含子步骤与内部连线；Ctrl+V 或画布空白右键粘贴）" />
                            <MenuItem
                                Command="{Binding ToggleBreakpointCommand}"
                                Header="切换断点"
                                Visibility="{Binding BreakpointMenuVisibility}" />
                            <MenuItem Command="{Binding ToggleDisableCommand}" Header="{Binding DisableMenuHeader}" />
                            <Separator />
                            <MenuItem
                                Command="{Binding DeleteCommand}"
                                Header="删除"
                                ToolTip="连同子步骤一并移出图纸（Delete 键删除当前选中）" />
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <!--  卡片本体：内边距 8/10（flow-logic `padding:8px 10px`）  -->
                    <Border Padding="10,8" Style="{StaticResource StepCardStyle}" ToolTip="{Binding CardTooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  图标块 28×28、圆角 8、分类色浅底 + 描边；图标 14px（设计稿线框重量）  -->
                            <Grid
                                Grid.Column="0"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center">
                                <Border
                                    Background="{Binding Model.Category, Converter={StaticResource CategorySoftBrushConverter}}"
                                    BorderBrush="{Binding Model.Category, Converter={StaticResource CategoryBorderBrushConverter}}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="14"
                                    Foreground="{Binding Model.Category, Converter={StaticResource CategoryAccentBrushConverter}}"
                                    Text="{Binding IconGlyph}" />
                            </Grid>

                            <!--  标题行 = 标题 + 类型徽标（WAIT）+ 操作徽标（EQ/AND…）；副标题 = 表达式/操作摘要  -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="NodeHeaderText"
                                        Grid.Column="0"
                                        MaxWidth="72"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource FlowCanvasNodeTextBrush}"
                                        Text="{Binding Header}"
                                        TextTrimming="CharacterEllipsis" />
                                    <!--  等待节点不是容器，但有自己的身份徽标；其它叶子节点这里为空，不占位  -->
                                    <Border
                                        x:Name="NodeTypeBadge"
                                        Grid.Column="1"
                                        Height="14"
                                        Margin="4,0,0,0"
                                        Padding="4,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource FlowCanvasTypeBadgeBrush}"
                                        CornerRadius="3"
                                        Visibility="{Binding TypeBadgeVisibility}">
                                        <TextBlock
                                            FontSize="8"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource FlowCanvasOnTypeBadgeTextBrush}"
                                            Text="{Binding TypeBadge}" />
                                    </Border>
                                    <!--  操作徽标：比较/逻辑插件才出现，其它节点 Collapsed 不占位  -->
                                    <Border
                                        x:Name="NodeOpBadge"
                                        Grid.Column="2"
                                        Height="14"
                                        Margin="4,0,0,0"
                                        Padding="4,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource LogicCaseSoftBrush}"
                                        BorderBrush="{StaticResource LogicCaseBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding OpBadgeVisibility}">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="8"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource LogicCaseTextBrush}"
                                            Text="{Binding OpBadge}" />
                                    </Border>
                                </Grid>
                                <!--  右侧预留 30px 给状态点/耗时竖槽，避免副标题被压在耗时下面  -->
                                <TextBlock
                                    Margin="0,1,30,0"
                                    FontSize="9"
                                    Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                                    Text="{Binding SubTitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  右上角状态点：7×7，ok/run/fail/skip/warn 五色；运行脉冲只作用于这一点  -->
                    <Ellipse
                        x:Name="NodeStatusDot"
                        Margin="0,7,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource NodeStatusDotStyle}" />

                    <!--  必填参数缺失角标：黄色叹号（与编译期 [参数缺失] 同一判据）。
                          放在右侧竖槽的中间段，与状态点/耗时互不重叠；悬停列出缺失端口名。  -->
                    <Border
                        x:Name="NodeMissingRequiredBadge"
                        Width="14"
                        Height="14"
                        Margin="0,0,4,16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        ToolTip="{Binding MissingRequiredTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMissingRequired}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="10"
                            Foreground="{StaticResource FlowCanvasWarningBrush}"
                            Text="&#xf06a;" />
                    </Border>

                    <!--  断点圆点：右侧竖槽上段（状态点下、必填角标上），点击即切换。
                          外层 14×14 命中区，内层 8×8 圆点；不与状态点/耗时重叠。  -->
                    <Border
                        x:Name="NodeBreakpointDot"
                        Width="14"
                        Height="14"
                        Margin="0,14,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="点击设置/取消断点">
                        <Border.InputBindings>
                            <MouseBinding
                                Command="{Binding DataContext.ToggleBreakpointCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Gesture="LeftClick" />
                        </Border.InputBindings>
                        <Ellipse Width="8" Height="8">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Transparent" />
                                    <Setter Property="Stroke" Value="{StaticResource FlowCanvasCanceledBrush}" />
                                    <Setter Property="StrokeThickness" Value="1.2" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource FlowCanvasBreakpointBrush}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Model.IsBreakpoint}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource FlowCanvasBreakpointBrush}" />
                                            <Setter Property="Stroke" Value="{StaticResource FlowCanvasBreakpointBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Border>

                    <!--  执行序号角标：左上角 -7,-7（flow-logic `.node-order` 16×14 深色胶囊）  -->
                    <Border
                        x:Name="NodeOrderBadge"
                        MinWidth="16"
                        Height="14"
                        Margin="-7,-7,0,0"
                        Padding="3,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource FlowCanvasOrderBadgeBrush}"
                        CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OrderLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="8"
                            FontWeight="Bold"
                            Foreground="{StaticResource FlowCanvasOnOrderBadgeTextBrush}"
                            Text="{Binding OrderLabel}" />
                    </Border>

                    <!--  外链角标：全局变量/常量绑定数，贴左下角图标下方（12 高，避开 28 图标块）  -->
                    <Border
                        x:Name="NodeExternalBadge"
                        Height="12"
                        Margin="10,0,0,2"
                        Padding="4,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource FlowCanvasExtBadgeBrush}"
                        BorderBrush="{StaticResource FlowCanvasExtBadgeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ToolTip="{Binding ExternalLinkTooltip}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExternalLinkCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="8"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FlowCanvasExtBadgeTextBrush}"
                            Text="{Binding ExternalLinkCount}" />
                    </Border>

                    <!--  耗时：右下角纯文字（flow-logic `.node-time` 8px）；运行中显示实时耗时，结束后冻结  -->
                    <TextBlock
                        x:Name="NodeTimeText"
                        Margin="0,0,8,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontFamily="Consolas"
                        FontSize="8"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource FlowCanvasNodeSubTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Model.LastRunTimeMs, Converter={ui:GreaterThanZeroConverter}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="{Binding Model.LastRunTimeMs, StringFormat='{}{0:0.#} ms'}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Model.IsRunningFocus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{StaticResource FlowCanvasRunningTextBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Text" Value="{Binding Model.CurrentRunTimeMs, StringFormat='{}{0:0.#} ms'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  连接点：左入右出（DataContext 切到连接器 VM；拖线中按 IsConnectable 压灰）  -->
                    <nodify:NodeInput
                        Margin="-6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        DataContext="{Binding Inputs[0]}"
                        IsConnected="{Binding IsConnected}"
                        Style="{StaticResource FlowConnectorStyle}"
                        ToolTip="目标脚：从其它模块的圆点拖到这里建立连线" />
                    <nodify:NodeOutput
                        Margin="0,0,-6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        DataContext="{Binding Outputs[0]}"
                        IsConnected="{Binding IsConnected}"
                        Style="{StaticResource FlowConnectorStyle}"
                        ToolTip="源脚：按住拖到目标模块建立连线" />
                </Grid>

                <!--  算子注释行：卡片下缘外的灰色小字（StepModel.Description，有注释才占位）  -->
                <TextBlock
                    Grid.Row="1"
                    Width="{x:Static vm:FlowCanvasViewModel.NodeWidth}"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    FontSize="10"
                    Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                    Text="{Binding Comment}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Comment}"
                    Visibility="{Binding CommentVisibility}" />
            </Grid>

            <DataTemplate.Triggers>
                <!--  禁用态与流程栏同一语言：划线打在标题上 + 整节点降透明（含状态点/耗时/序号/注释/断点）  -->
                <DataTrigger Binding="{Binding Model.IsDisEnable}" Value="True">
                    <Setter TargetName="NodeHeaderText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="StepNodeRoot" Property="Opacity" Value="0.45" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  ====================  容器框（If / Case / While / For / Parallel，可折叠）  ====================  -->
        <DataTemplate x:Key="ContainerNodeTemplate" DataType="{x:Type vm:CanvasNodeViewModel}">
            <!--  两行结构：Row0 = 容器框体（几何由子孙外接框算出），Row1 = 算子注释行（有注释才显示）  -->
            <Grid x:Name="ContainerNodeRoot">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Model.IsDisEnable}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Width="{Binding LaneWidth}"
                    Height="{Binding LaneHeight}"
                    Grid.Row="0">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding OpenBindingCommand}" Header="编辑绑定…（打开变量绑定）" />
                            <MenuItem Command="{Binding OpenModuleParametersCommand}" Header="步骤参数…" />
                            <Separator />
                            <MenuItem
                                Command="{Binding CopyCommand}"
                                Header="复制"
                                ToolTip="复制该容器（含子步骤与内部连线；Ctrl+V 或画布空白右键粘贴）" />
                            <MenuItem Command="{Binding ToggleDisableCommand}" Header="{Binding DisableMenuHeader}" />
                            <Separator />
                            <MenuItem
                                Command="{Binding DeleteCommand}"
                                Header="删除"
                                ToolTip="连同子步骤一并移出图纸（Delete 键删除当前选中）" />
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <Border
                        x:Name="ContainerFrame"
                        ToolTip="{Binding CardTooltip}"
                        Background="{StaticResource FlowCanvasNodeBackgroundBrush}"
                        BorderBrush="{StaticResource FlowCanvasFrameBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  组头 46px：类型色条 4×26 + 类型徽标 20 高 + 标题 12.5 + 条件胶囊 20 高/9px
                                  + 右侧 "N 分支 · M 算子" + 7×7 状态点 + 折叠钮  -->
                            <Border
                                x:Name="ContainerHeader"
                                Height="{x:Static vm:FlowCanvasViewModel.FrameHeaderHeight}"
                                Background="{StaticResource FlowCanvasFrameHeaderBrush}"
                                BorderBrush="{StaticResource FlowCanvasFrameBorderBrush}"
                                BorderThickness="0,0,0,1"
                                ClipToBounds="True"
                                CornerRadius="10,10,0,0">
                                <Grid Margin="9,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        x:Name="ContainerTypeBar"
                                        Grid.Column="0"
                                        Width="4"
                                        Height="26"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource FlowCanvasTypeBadgeBrush}"
                                        CornerRadius="2" />

                                    <Border
                                        x:Name="TypeBadgeBorder"
                                        Grid.Column="1"
                                        Height="20"
                                        Margin="0,0,6,0"
                                        Padding="5,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource FlowCanvasTypeBadgeBrush}"
                                        CornerRadius="5"
                                        Visibility="{Binding TypeBadgeVisibility}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource FlowCanvasOnTypeBadgeTextBrush}"
                                            Text="{Binding TypeBadge}" />
                                    </Border>

                                    <TextBlock
                                        x:Name="ContainerHeaderText"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource FlowCanvasNodeTextBrush}"
                                        Text="{Binding Header}"
                                        TextTrimming="CharacterEllipsis" />

                                    <Border
                                        x:Name="ContainerCondBorder"
                                        Grid.Column="3"
                                        Height="20"
                                        MinWidth="0"
                                        MaxWidth="190"
                                        Margin="4,0,0,0"
                                        Padding="5,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource FlowCanvasNodeBackgroundBrush}"
                                        BorderBrush="{StaticResource FlowCanvasFrameBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Visibility="{Binding ContainerSummaryVisibility}">
                                        <TextBlock
                                            x:Name="ContainerCondText"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="9"
                                            Foreground="{StaticResource FlowCanvasFrameHeaderTextBrush}"
                                            Text="{Binding ContainerSummary}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <TextBlock
                                        x:Name="ContainerMetaLabel"
                                        Grid.Column="4"
                                        Margin="6,0,4,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="8.5"
                                        Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                                        Text="{Binding ContainerMetaText}"
                                        TextTrimming="CharacterEllipsis" />

                                    <Ellipse
                                        x:Name="ContainerStatusDot"
                                        Grid.Column="5"
                                        Margin="0,0,28,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ContainerStatusDotStyle}" />
                                </Grid>
                            </Border>

                            <!--  并行分组底部汇合条：22 高、底距 6；只显示分支数（不伪造完成数/耗时）  -->
                            <Border
                                x:Name="JoinBar"
                                Grid.Row="1"
                                Height="22"
                                Margin="12,0,12,6"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource LogicParallelSoftBrush}"
                                BorderBrush="{StaticResource LogicParallelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding JoinBarVisibility}">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="10"
                                        Foreground="{StaticResource LogicParallelTextBrush}"
                                        Text="&#xf126;" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="9"
                                        Foreground="{StaticResource LogicParallelTextBrush}"
                                        Text="{Binding JoinBarText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  折叠 / 展开：浮在组头右上角，不占组头排版宽度（否则窄容器会把标题挤成 "Whi..."）。
                          x:Name 是双击豁免的判据（见 FlowCanvasView.xaml.cs 的 IsInteractivePart）：
                          双击落在折叠钮上不许弹参数窗  -->
                    <Border
                        x:Name="ContainerCollapseToggle"
                        Width="18"
                        Height="18"
                        Margin="0,14,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{StaticResource FlowCanvasCollapseBrush}"
                        BorderBrush="{StaticResource FlowCanvasCollapseBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Cursor="Hand"
                        ToolTip="点击折叠 / 展开该容器">
                        <Border.InputBindings>
                            <MouseBinding
                                Command="{Binding DataContext.ToggleCollapseCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}"
                                Gesture="LeftClick" />
                        </Border.InputBindings>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="10"
                            Foreground="{StaticResource FlowCanvasCollapseTextBrush}"
                            Text="{Binding CollapseGlyph}" />
                    </Border>

                    <!--  执行序号角标：flow-logic `.container-order` 24×18，左上角 -9,-9  -->
                    <Border
                        x:Name="ContainerOrderBadge"
                        Width="24"
                        Height="18"
                        Margin="-9,-9,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource FlowCanvasOrderBadgeBrush}"
                        CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OrderLabel}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{StaticResource FlowCanvasOnOrderBadgeTextBrush}"
                            Text="{Binding OrderLabel}" />
                    </Border>

                    <!--  连接点：容器框左右缘、锚在头带中心（SideConnectorMargin 与连线锚点同一点）  -->
                    <nodify:NodeInput
                        Margin="{Binding SideConnectorMarginLeft}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        DataContext="{Binding Inputs[0]}"
                        IsConnected="{Binding IsConnected}"
                        Style="{StaticResource FlowConnectorStyle}"
                        ToolTip="目标脚：从其它模块的圆点拖到这里建立连线" />
                    <nodify:NodeOutput
                        Margin="{Binding SideConnectorMarginRight}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        DataContext="{Binding Outputs[0]}"
                        IsConnected="{Binding IsConnected}"
                        Style="{StaticResource FlowConnectorStyle}"
                        ToolTip="源脚：按住拖到目标模块建立连线" />
                </Grid>

                <!--  算子注释行：容器框下缘外的灰色小字（容器同样是算子，注释一并显示）  -->
                <TextBlock
                    Grid.Row="1"
                    Width="{Binding LaneWidth}"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Left"
                    FontSize="10"
                    Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                    Text="{Binding Comment}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Comment}"
                    Visibility="{Binding CommentVisibility}" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Model.PluginTypeName}" Value="BuiltIn_If">
                    <Setter TargetName="ContainerFrame" Property="BorderBrush" Value="{StaticResource LogicIfBorderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="Background" Value="{StaticResource LogicIfHeaderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="BorderBrush" Value="{StaticResource LogicIfBorderBrush}" />
                    <Setter TargetName="ContainerTypeBar" Property="Background" Value="{StaticResource LogicIfBrush}" />
                    <Setter TargetName="TypeBadgeBorder" Property="Background" Value="{StaticResource LogicIfBrush}" />
                    <Setter TargetName="ContainerCondBorder" Property="BorderBrush" Value="{StaticResource LogicIfBorderBrush}" />
                    <Setter TargetName="ContainerCondText" Property="Foreground" Value="{StaticResource LogicIfTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.PluginTypeName}" Value="BuiltIn_While">
                    <Setter TargetName="ContainerFrame" Property="BorderBrush" Value="{StaticResource LogicWhileBorderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="Background" Value="{StaticResource LogicWhileHeaderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="BorderBrush" Value="{StaticResource LogicWhileBorderBrush}" />
                    <Setter TargetName="ContainerTypeBar" Property="Background" Value="{StaticResource LogicWhileBrush}" />
                    <Setter TargetName="TypeBadgeBorder" Property="Background" Value="{StaticResource LogicWhileBrush}" />
                    <Setter TargetName="ContainerCondBorder" Property="BorderBrush" Value="{StaticResource LogicWhileBorderBrush}" />
                    <Setter TargetName="ContainerCondText" Property="Foreground" Value="{StaticResource LogicWhileTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.PluginTypeName}" Value="BuiltIn_For">
                    <Setter TargetName="ContainerFrame" Property="BorderBrush" Value="{StaticResource LogicForBorderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="Background" Value="{StaticResource LogicForHeaderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="BorderBrush" Value="{StaticResource LogicForBorderBrush}" />
                    <Setter TargetName="ContainerTypeBar" Property="Background" Value="{StaticResource LogicForBrush}" />
                    <Setter TargetName="TypeBadgeBorder" Property="Background" Value="{StaticResource LogicForBrush}" />
                    <Setter TargetName="ContainerCondBorder" Property="BorderBrush" Value="{StaticResource LogicForBorderBrush}" />
                    <Setter TargetName="ContainerCondText" Property="Foreground" Value="{StaticResource LogicForTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.PluginTypeName}" Value="BuiltIn_Parallel">
                    <Setter TargetName="ContainerFrame" Property="BorderBrush" Value="{StaticResource LogicParallelBorderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="Background" Value="{StaticResource LogicParallelHeaderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="BorderBrush" Value="{StaticResource LogicParallelBorderBrush}" />
                    <Setter TargetName="ContainerTypeBar" Property="Background" Value="{StaticResource LogicParallelBrush}" />
                    <Setter TargetName="TypeBadgeBorder" Property="Background" Value="{StaticResource LogicParallelBrush}" />
                    <Setter TargetName="ContainerCondBorder" Property="BorderBrush" Value="{StaticResource LogicParallelBorderBrush}" />
                    <Setter TargetName="ContainerCondText" Property="Foreground" Value="{StaticResource LogicParallelTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.PluginTypeName}" Value="BuiltIn_Case">
                    <Setter TargetName="ContainerFrame" Property="BorderBrush" Value="{StaticResource LogicCaseBorderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="Background" Value="{StaticResource LogicCaseHeaderBrush}" />
                    <Setter TargetName="ContainerHeader" Property="BorderBrush" Value="{StaticResource LogicCaseBorderBrush}" />
                    <Setter TargetName="ContainerTypeBar" Property="Background" Value="{StaticResource LogicCaseBrush}" />
                    <Setter TargetName="TypeBadgeBorder" Property="Background" Value="{StaticResource LogicCaseBrush}" />
                    <Setter TargetName="ContainerCondBorder" Property="BorderBrush" Value="{StaticResource LogicCaseBorderBrush}" />
                    <Setter TargetName="ContainerCondText" Property="Foreground" Value="{StaticResource LogicCaseTextBrush}" />
                </DataTrigger>

                <!--  失败态：红边 + 淡红底 + 红点（设计稿状态矩阵；只换组头/描边，不把整框刷高饱和）  -->
                <DataTrigger Binding="{Binding Model.State}" Value="Failed">
                    <Setter TargetName="ContainerFrame" Property="BorderBrush" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                    <Setter TargetName="ContainerFrame" Property="Background" Value="{StaticResource FlowCanvasContainerFailedBackgroundBrush}" />
                    <Setter TargetName="ContainerHeader" Property="Background" Value="{StaticResource FlowCanvasFailedSoftBrush}" />
                    <Setter TargetName="ContainerHeader" Property="BorderBrush" Value="{StaticResource FlowCanvasFailedBorderBrush}" />
                    <Setter TargetName="ContainerHeaderText" Property="Foreground" Value="{StaticResource FlowCanvasFailedTextBrush}" />
                    <Setter TargetName="ContainerTypeBar" Property="Background" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                    <Setter TargetName="TypeBadgeBorder" Property="Background" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                    <Setter TargetName="ContainerCondBorder" Property="BorderBrush" Value="{StaticResource FlowCanvasFailedBorderBrush}" />
                    <Setter TargetName="ContainerCondText" Property="Foreground" Value="{StaticResource FlowCanvasFailedTextBrush}" />
                </DataTrigger>

                <!--  条件缺失：与编译错误同一判据（红边 + 红字 + 红点，meta 显示「缺条件」）  -->
                <DataTrigger Binding="{Binding HasMissingCondition}" Value="True">
                    <Setter TargetName="ContainerFrame" Property="BorderBrush" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                    <Setter TargetName="ContainerFrame" Property="Background" Value="{StaticResource FlowCanvasContainerFailedBackgroundBrush}" />
                    <Setter TargetName="ContainerHeader" Property="Background" Value="{StaticResource FlowCanvasFailedSoftBrush}" />
                    <Setter TargetName="ContainerHeader" Property="BorderBrush" Value="{StaticResource FlowCanvasFailedBorderBrush}" />
                    <Setter TargetName="ContainerHeaderText" Property="Foreground" Value="{StaticResource FlowCanvasFailedTextBrush}" />
                    <Setter TargetName="ContainerTypeBar" Property="Background" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                    <Setter TargetName="TypeBadgeBorder" Property="Background" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                    <Setter TargetName="ContainerCondBorder" Property="BorderBrush" Value="{StaticResource FlowCanvasFailedBorderBrush}" />
                    <Setter TargetName="ContainerCondText" Property="Foreground" Value="{StaticResource FlowCanvasFailedTextBrush}" />
                </DataTrigger>

                <!--  选中态：2px 运行色边框（Nodify 选择光晕仍保留）  -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ContainerFrame" Property="BorderBrush" Value="{StaticResource FlowCanvasStateRunningBrush}" />
                    <Setter TargetName="ContainerFrame" Property="BorderThickness" Value="2" />
                </DataTrigger>

            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  ====================  分支泳道（容器框内的列背景装饰）  ====================  -->
        <DataTemplate x:Key="LaneNodeTemplate" DataType="{x:Type vm:CanvasNodeViewModel}">
            <Border
                x:Name="LaneRoot"
                Width="{Binding LaneWidth}"
                Height="{Binding LaneHeight}"
                Background="{StaticResource FlowCanvasLaneTintBrush}"
                BorderBrush="{StaticResource FlowCanvasLaneBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  泳道头 28px：分支徽标 + 名称 + 右侧计数（flow-logic `.lane-head`）  -->
                    <Border
                        x:Name="LaneHeader"
                        Height="{x:Static vm:FlowCanvasViewModel.LaneHeaderHeight}"
                        Background="{StaticResource FlowCanvasLaneHeaderBrush}"
                        BorderBrush="{StaticResource FlowCanvasLaneBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="7,7,0,0">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="LaneBadge"
                                Grid.Column="0"
                                Height="16"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource FlowCanvasNodeSubTextBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="8"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource FlowCanvasOnOrderBadgeTextBrush}"
                                    Text="{Binding BranchBadge}" />
                            </Border>
                            <TextBlock
                                x:Name="LaneNameText"
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FlowCanvasLaneTextBrush}"
                                Text="{Binding LaneName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding LaneName}" />
                            <TextBlock
                                x:Name="LaneCountText"
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="8.5"
                                Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                                Text="{Binding LaneCountText}" />
                        </Grid>
                    </Border>

                    <!--  空分支提示（保留）：泳道头下方灰色小字  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="10,6"
                        FontSize="9"
                        Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                        Text="（空分支，可从流程栏添加步骤）"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLaneEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  底部说明条（While / For）：22 高、底距 9；只用现有模型字段，不伪造运行数据  -->
                    <Grid
                        x:Name="LaneNote"
                        Grid.Row="1"
                        Height="22"
                        Margin="10,0,10,9"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding LaneNoteVisibility}">
                        <Rectangle
                            x:Name="LaneNoteBorder"
                            Fill="{StaticResource FlowCanvasLaneHeaderBrush}"
                            RadiusX="5"
                            RadiusY="5"
                            Stroke="{StaticResource FlowCanvasLaneBorderBrush}"
                            StrokeDashArray="2,2" />
                        <StackPanel
                            Margin="7,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                x:Name="LaneNoteIcon"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="10"
                                Foreground="{StaticResource FlowCanvasLaneTextBrush}"
                                Text="{Binding LaneNoteGlyph}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="8.5"
                                Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                                Text="{Binding LaneNoteText}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding LaneNoteText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!--  按父容器类型分色：If / Case / While / For / Parallel 的 soft / border / badge / text  -->
                <DataTrigger Binding="{Binding LaneParentKind}" Value="If">
                    <Setter TargetName="LaneRoot" Property="Background" Value="{StaticResource LogicIfSoftBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderBrush" Value="{StaticResource LogicIfBorderBrush}" />
                    <Setter TargetName="LaneHeader" Property="BorderBrush" Value="{StaticResource LogicIfBorderBrush}" />
                    <Setter TargetName="LaneBadge" Property="Background" Value="{StaticResource LogicIfBrush}" />
                    <Setter TargetName="LaneNameText" Property="Foreground" Value="{StaticResource LogicIfTextBrush}" />
                    <Setter TargetName="LaneNoteBorder" Property="Stroke" Value="{StaticResource LogicIfBorderBrush}" />
                    <Setter TargetName="LaneNoteIcon" Property="Foreground" Value="{StaticResource LogicIfTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LaneParentKind}" Value="Case">
                    <Setter TargetName="LaneRoot" Property="Background" Value="{StaticResource LogicCaseSoftBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderBrush" Value="{StaticResource LogicCaseBorderBrush}" />
                    <Setter TargetName="LaneHeader" Property="BorderBrush" Value="{StaticResource LogicCaseBorderBrush}" />
                    <Setter TargetName="LaneBadge" Property="Background" Value="{StaticResource LogicCaseBrush}" />
                    <Setter TargetName="LaneNameText" Property="Foreground" Value="{StaticResource LogicCaseTextBrush}" />
                    <Setter TargetName="LaneNoteBorder" Property="Stroke" Value="{StaticResource LogicCaseBorderBrush}" />
                    <Setter TargetName="LaneNoteIcon" Property="Foreground" Value="{StaticResource LogicCaseTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LaneParentKind}" Value="While">
                    <Setter TargetName="LaneRoot" Property="Background" Value="{StaticResource LogicWhileSoftBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderBrush" Value="{StaticResource LogicWhileBorderBrush}" />
                    <Setter TargetName="LaneHeader" Property="BorderBrush" Value="{StaticResource LogicWhileBorderBrush}" />
                    <Setter TargetName="LaneBadge" Property="Background" Value="{StaticResource LogicWhileBrush}" />
                    <Setter TargetName="LaneNameText" Property="Foreground" Value="{StaticResource LogicWhileTextBrush}" />
                    <Setter TargetName="LaneNoteBorder" Property="Stroke" Value="{StaticResource LogicWhileBorderBrush}" />
                    <Setter TargetName="LaneNoteIcon" Property="Foreground" Value="{StaticResource LogicWhileTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LaneParentKind}" Value="For">
                    <Setter TargetName="LaneRoot" Property="Background" Value="{StaticResource LogicForSoftBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderBrush" Value="{StaticResource LogicForBorderBrush}" />
                    <Setter TargetName="LaneHeader" Property="BorderBrush" Value="{StaticResource LogicForBorderBrush}" />
                    <Setter TargetName="LaneBadge" Property="Background" Value="{StaticResource LogicForBrush}" />
                    <Setter TargetName="LaneNameText" Property="Foreground" Value="{StaticResource LogicForTextBrush}" />
                    <Setter TargetName="LaneNoteBorder" Property="Stroke" Value="{StaticResource LogicForBorderBrush}" />
                    <Setter TargetName="LaneNoteIcon" Property="Foreground" Value="{StaticResource LogicForTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LaneParentKind}" Value="Parallel">
                    <Setter TargetName="LaneRoot" Property="Background" Value="{StaticResource LogicParallelSoftBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderBrush" Value="{StaticResource LogicParallelBorderBrush}" />
                    <Setter TargetName="LaneHeader" Property="BorderBrush" Value="{StaticResource LogicParallelBorderBrush}" />
                    <Setter TargetName="LaneBadge" Property="Background" Value="{StaticResource LogicParallelBrush}" />
                    <Setter TargetName="LaneNameText" Property="Foreground" Value="{StaticResource LogicParallelTextBrush}" />
                    <Setter TargetName="LaneNoteBorder" Property="Stroke" Value="{StaticResource LogicParallelBorderBrush}" />
                    <Setter TargetName="LaneNoteIcon" Property="Foreground" Value="{StaticResource LogicParallelTextBrush}" />
                </DataTrigger>

                <!--  运行中的分支：蓝边 + 蓝头带 + 蓝字（只染这一条泳道，不整框高饱和）  -->
                <DataTrigger Binding="{Binding IsBranchRunning}" Value="True">
                    <Setter TargetName="LaneRoot" Property="Background" Value="{StaticResource FlowCanvasLaneRunningHeaderBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderBrush" Value="{StaticResource FlowCanvasStateRunningBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="LaneHeader" Property="Background" Value="{StaticResource FlowCanvasLaneRunningHeaderBrush}" />
                    <Setter TargetName="LaneNameText" Property="Foreground" Value="{StaticResource FlowCanvasRunningTextBrush}" />
                </DataTrigger>

                <!--  中性分支：If 的 Else/ElseIf、Case 的默认分支不套类型色（灰底灰边灰徽标）；
                      运行中的分支仍由下面的运行触发器接管（Multi 条件排除运行态）。  -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsNeutralLane}" Value="True" />
                        <Condition Binding="{Binding IsBranchRunning}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="LaneRoot" Property="Background" Value="{StaticResource FlowCanvasLaneNeutralBackgroundBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderBrush" Value="{StaticResource FlowCanvasLaneNeutralBorderBrush}" />
                    <Setter TargetName="LaneHeader" Property="BorderBrush" Value="{StaticResource FlowCanvasLaneNeutralBorderBrush}" />
                    <Setter TargetName="LaneBadge" Property="Background" Value="{StaticResource FlowCanvasLaneNeutralBadgeBrush}" />
                    <Setter TargetName="LaneNameText" Property="Foreground" Value="{StaticResource FlowCanvasLaneNeutralTextBrush}" />
                    <Setter TargetName="LaneNoteBorder" Property="Stroke" Value="{StaticResource FlowCanvasLaneNeutralBorderBrush}" />
                    <Setter TargetName="LaneNoteIcon" Property="Foreground" Value="{StaticResource FlowCanvasLaneNeutralTextBrush}" />
                </MultiDataTrigger>

                <!--  父容器失败/条件缺失：整列泳道红染（设计状态矩阵），放在最后覆盖类型/运行色  -->
                <DataTrigger Binding="{Binding IsLaneParentFaulted}" Value="True">
                    <Setter TargetName="LaneRoot" Property="Background" Value="{StaticResource FlowCanvasContainerFailedBackgroundBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderBrush" Value="{StaticResource FlowCanvasFailedBorderBrush}" />
                    <Setter TargetName="LaneRoot" Property="BorderThickness" Value="1.5" />
                    <Setter TargetName="LaneHeader" Property="Background" Value="{StaticResource FlowCanvasFailedSoftBrush}" />
                    <Setter TargetName="LaneHeader" Property="BorderBrush" Value="{StaticResource FlowCanvasFailedBorderBrush}" />
                    <Setter TargetName="LaneBadge" Property="Background" Value="{StaticResource FlowCanvasStateFailedBrush}" />
                    <Setter TargetName="LaneNameText" Property="Foreground" Value="{StaticResource FlowCanvasFailedTextBrush}" />
                    <Setter TargetName="LaneNoteBorder" Property="Stroke" Value="{StaticResource FlowCanvasFailedBorderBrush}" />
                    <Setter TargetName="LaneNoteIcon" Property="Foreground" Value="{StaticResource FlowCanvasFailedTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  ====================  模块级聚合连线（端点 = 主 VM 算好的盒子边缘中点）  ====================  -->
        <!--  数据线：横向（右缘出 → 左缘入）；执行顺序链：纵向（底缘出 → 顶缘入），细虚线、无菜单。
              StepConnection = 台阶式正交走线（海康式直角折线），替换此前 LineConnection——
              直线斜穿大半张画布；CircuitConnection 的中段是 45° 斜线，两端接近同列时斜线拉得很长。
              StepConnection 按 SourcePosition/TargetPosition 四边枚举走纯直角。
              OffsetMode 必须显式 None：端点贴锚点，杜绝 Nodify 默认 offset 的端外"横杆"。
              右键菜单内联在模板里 = 每连线一份实例（DataContext 就是连线 VM）——
              绝不能改回 StaticResource 共享或属性元素本地值：本地值会压掉样式触发器
              （2026-10-07 事故：数据线弹出类型全名行、顺序链弹空菜单）。
              Fill 必须给：Nodify 的箭头由 Fill 填充，漏了就是描边色空芯三角。  -->
        <DataTemplate x:Key="ModuleLinkTemplate" DataType="{x:Type vm:CanvasLinkViewModel}">
            <nodify:StepConnection
                ContextMenuOpening="OnConnectionContextMenuOpening"
                Source="{Binding SourceAnchor}"
                SourceOffsetMode="None"
                SourcePosition="{Binding SourcePosition}"
                Target="{Binding TargetAnchor}"
                TargetOffsetMode="None"
                TargetPosition="{Binding TargetPosition}"
                Text="{Binding LinkLabel}"
                ToolTip="{Binding Tooltip}">
                <nodify:StepConnection.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding OpenBindingCommand}" Header="编辑绑定…（打开变量绑定）" />
                        <Separator />
                        <MenuItem Command="{Binding UnbindAllCommand}" Header="断开全部绑定（整批可撤销）" />
                        <MenuItem Header="断开单条绑定" ItemsSource="{Binding Bindings}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding MenuHeader}" />
                                    <Setter Property="Command" Value="{Binding DataContext.UnbindCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                    </ContextMenu>
                </nodify:StepConnection.ContextMenu>
                <nodify:StepConnection.Style>
                    <Style TargetType="{x:Type nodify:StepConnection}">
                        <Setter Property="Stroke" Value="{StaticResource FlowCanvasLinkBrush}" />
                        <Setter Property="Fill" Value="{StaticResource FlowCanvasLinkBrush}" />
                        <Setter Property="StrokeThickness" Value="1.5" />
                        <Style.Triggers>
                            <!--  执行顺序链：自上而下流动（底缘出、顶缘进），细灰虚线与数据线区分；
                                  进出边（Bottom/Top）由主 VM 按连线语义写入，不在样式里覆盖  -->
                            <DataTrigger Binding="{Binding IsOrderLink}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource FlowCanvasOrderLinkBrush}" />
                                <Setter Property="Fill" Value="{StaticResource FlowCanvasOrderLinkBrush}" />
                                <Setter Property="StrokeDashArray" Value="2.5,2.5" />
                                <Setter Property="StrokeThickness" Value="1.2" />
                            </DataTrigger>
                            <!--  顺序链"已执行"染色（评审清单 B 包）：两端步骤都离开 Idle（终态口径）→
                                  换运行色实线。放在 IsOrderLink 触发器之后（后写者赢），
                                  未执行的顺序链保持灰虚线不变  -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOrderLink}" Value="True" />
                                    <Condition Binding="{Binding IsExecuted}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Stroke" Value="{StaticResource FlowCanvasRunningBrush}" />
                                <Setter Property="Fill" Value="{StaticResource FlowCanvasRunningBrush}" />
                                <Setter Property="StrokeDashArray" Value="1,0" />
                                <Setter Property="StrokeThickness" Value="1.4" />
                            </MultiDataTrigger>
                            <!--  结构非法的线：红色虚线，编译会报致命错  -->
                            <DataTrigger Binding="{Binding IsIllegal}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource FlowCanvasLinkIllegalBrush}" />
                                <Setter Property="Fill" Value="{StaticResource FlowCanvasLinkIllegalBrush}" />
                                <Setter Property="StrokeDashArray" Value="4,3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </nodify:StepConnection.Style>
            </nodify:StepConnection>
        </DataTemplate>

        <!--  小地图项：一个点代表一个模块（180×118 画布下用 8×5 更贴近实际占比）  -->
        <DataTemplate x:Key="MinimapItemTemplate" DataType="{x:Type vm:CanvasNodeViewModel}">
            <nodify:MinimapItem Location="{Binding Location}">
                <Rectangle
                    Width="8"
                    Height="5"
                    Fill="{StaticResource FlowCanvasLinkBrush}"
                    RadiusX="1.5"
                    RadiusY="1.5" />
            </nodify:MinimapItem>
        </DataTemplate>

        <!--  拖线橡皮筋：显式样式整条替换 Nodify 主题默认（无法 BasedOn——默认样式在主题字典里，
              编译期 StaticResource 查不到），描边收口到画布色板（默认是 DodgerBlue）  -->
        <Style
            x:Key="FlowPendingConnectionStyle"
            TargetType="{x:Type nodify:PendingConnection}">
            <Setter Property="Stroke" Value="{StaticResource FlowCanvasNodeIconBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashArray" Value="4,4" />
        </Style>

        <!--  缩放工具条按钮  -->
        <Style x:Key="ZoomToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource FlowCanvasNodeTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource FlowCanvasCollapseHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  画布快捷键挂 UserControl 级：挂 NodifyEditor 上时焦点一旦落到工具条/流程栏（编辑器子树外），
          Ctrl+Z / Delete 就静默失效（元素级 InputBindings 沿焦点链路由）。挂这里覆盖整个视图子树。  -->
    <UserControl.InputBindings>
        <KeyBinding
            Key="Z"
            Command="{Binding UndoCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="Y"
            Command="{Binding RedoCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="Delete"
            Command="{Binding DeleteSelectionCommand}" />
        <!--  复制/粘贴（2026-10-12）：Ctrl+C 走既有选中机制（多选给提示、空选空跑）；
              Ctrl+V 的落点取视图随 MouseMove 回报的 LastPointerGraphPosition，无回报时追加到顶层末尾  -->
        <KeyBinding
            Key="C"
            Command="{Binding CopySelectedCommand}"
            Modifiers="Control" />
        <KeyBinding
            Key="V"
            Command="{Binding PasteCommand}"
            Modifiers="Control" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部工具条：左 = 流程名与操作提示；右 = 缩放工具  -->
        <Border
            Grid.Row="0"
            Padding="10,6"
            Background="{StaticResource FlowCanvasToolbarBrush}"
            BorderBrush="{StaticResource FlowCanvasToolbarBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource FlowCanvasNodeTextBrush}"
                        Text="{Binding FlowTitle}" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                        Text="拖动模块排序 · 双击/右键开参数 · 圆点拖线连接 · 数据线默认隐藏" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <!--  数据线开关：默认关（只显示执行顺序）；非法连线（红虚线）不受开关影响，始终显示  -->
                    <CheckBox
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Content="数据线"
                        IsChecked="{Binding ShowDataLinks}"
                        ToolTip="显示/隐藏端口之间的数据绑定连线（非法连线始终显示）" />
                    <CheckBox
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Content="顺序链"
                        IsChecked="{Binding ShowOrderLinks}"
                        ToolTip="显示/隐藏执行顺序（节点间的细虚线箭头）" />
                    <!--  flow-logic：小地图默认关闭，避免常驻右下角遮挡“结果汇总”等输出节点；
                          打开后仍可拖动/点击平移视口  -->
                    <CheckBox
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Content="小地图"
                        IsChecked="{Binding ShowMinimap}"
                        ToolTip="显示/隐藏右下角小地图（默认关闭，避免遮挡输出节点）" />
                    <!--  撤销 / 重做（2026-10-11 撤销补口：拖入与删除也入栈，按钮补上常驻入口；
                          快捷键 Ctrl+Z / Ctrl+Y 挂 UserControl 级，见下方 InputBindings）  -->
                    <Button
                        Command="{Binding UndoCommand}"
                        Content="撤销"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="撤销上一步编辑（Ctrl+Z）" />
                    <Button
                        Command="{Binding RedoCommand}"
                        Content="重做"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="重做被撤销的编辑（Ctrl+Y）" />
                    <!--  编译错误列表：有错误才出现；点击开列表，双击行定位到出错步骤。
                            Foreground 本地值压过 ZoomToolButtonStyle 的 setter → 红字提醒  -->
                    <Button
                        Command="{Binding ShowCompileErrorsCommand}"
                        Content="错误列表"
                        Foreground="{StaticResource FlowCanvasFailedBrush}"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="查看最近一次编译的错误，双击条目定位到出错步骤"
                        Visibility="{Binding CompileErrorsVisibility}" />
                    <Button
                        Command="{Binding ZoomCommand}"
                        CommandParameter="{x:Static vm:FlowCanvasZoomCommand.ZoomIn}"
                        Content="＋"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="放大" />
                    <Button
                        Command="{Binding ZoomCommand}"
                        CommandParameter="{x:Static vm:FlowCanvasZoomCommand.ZoomOut}"
                        Content="－"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="缩小" />
                    <Button
                        Command="{Binding ZoomCommand}"
                        CommandParameter="{x:Static vm:FlowCanvasZoomCommand.ActualSize}"
                        Content="1:1"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="恢复 100%" />
                    <Button
                        Command="{Binding ZoomCommand}"
                        CommandParameter="{x:Static vm:FlowCanvasZoomCommand.Fit}"
                        Content="适应"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="适应画布" />
                    <Button
                        Command="{Binding TidyLayoutCommand}"
                        Content="整理"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="清空散乱坐标，按执行顺序重新正交排布" />

                    <!--  连线图例（三视角评审第二批）：三条线样例，画刷与连线模板同源——
                            数据 = 蓝实线 / 顺序 = 灰细虚线 / 非法 = 红虚线（编译致命错）  -->
                    <StackPanel
                        Margin="12,0,2,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Line
                            Stroke="{StaticResource FlowCanvasLinkBrush}"
                            StrokeThickness="2"
                            X1="0"
                            X2="20"
                            Y1="0"
                            Y2="0" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                            Text="数据" />
                        <Line
                            Margin="10,0,0,0"
                            Stroke="{StaticResource FlowCanvasOrderLinkBrush}"
                            StrokeDashArray="2.5,2.5"
                            StrokeThickness="1.2"
                            X1="0"
                            X2="20"
                            Y1="0"
                            Y2="0" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                            Text="顺序" />
                        <Line
                            Margin="10,0,0,0"
                            Stroke="{StaticResource FlowCanvasLinkIllegalBrush}"
                            StrokeDashArray="4,3"
                            StrokeThickness="1.5"
                            X1="0"
                            X2="20"
                            Y1="0"
                            Y2="0" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                            Text="非法" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  顶部提示条区：运行锁横幅（运行中常驻，评审 P0-4）+ 结构告警条（只有非法连线才出现；
              全局变量/常量折成角标是常态，不报警）。两条同区并存互斥少见但都可能出现，纵向堆叠  -->
        <StackPanel Grid.Row="1">
            <Border
                Padding="10,4"
                Background="{StaticResource FlowCanvasWarningBackgroundBrush}"
                BorderThickness="0"
                Visibility="{Binding RunLockBannerVisibility}">
                <TextBlock
                    FontSize="11"
                    Foreground="{StaticResource FlowCanvasRunningBrush}"
                    Text="{Binding RunLockBannerText}"
                    TextWrapping="Wrap" />
            </Border>

            <Border
                Padding="10,4"
                Background="{StaticResource FlowCanvasWarningBackgroundBrush}"
                BorderThickness="0"
                Visibility="{Binding WarningVisibility}">
                <TextBlock
                    FontSize="11"
                    Foreground="{StaticResource FlowCanvasFailedBrush}"
                    Text="{Binding WarningText}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!--  点阵背景：DrawingBrush 平铺 24×24 一个圆点，与 GridCellSize 对齐（吸附格 = 可见格）。
              NodifyEditor 不自带网格绘制，只设 GridCellSize 是看不见格子的。
              dd:DragDrop.IsDropTarget = 工具箱拖入（主编辑面）：**必须走 gong 的拖放目标**，
              不能只挂裸 DragOver/Drop——gong 的拖影 Popup 只在它自己的 Drop 处理器里关闭，
              裸 Drop 返回 Copy 会让拖影永久停在落点（2026-10-21 真机）。DropHandler 在
              FlowCanvasView.xaml.cs 里挂（要拿 Editor 的缩放/视口换算图坐标）。
              AllowDrop 由 IsDropTarget 一并设置，这里不再重复声明。  -->
        <nodify:NodifyEditor
            x:Name="Editor"
            Grid.Row="2"
            dd:DragDrop.IsDropTarget="True"
            Connections="{Binding Links}"
            ConnectionTemplate="{StaticResource ModuleLinkTemplate}"
            DisplayConnectionsOnTop="False"
            GridCellSize="24"
            ItemsSource="{Binding Nodes}"
            ItemsDragStartedCommand="{Binding ItemsDragStartedCommand}"
            ItemsDragCompletedCommand="{Binding ItemsDragCompletedCommand}"
            MouseDoubleClick="OnEditorMouseDoubleClick"
            PendingConnection="{Binding PendingConnection}">
            <!--  画布空白右键菜单：只有「粘贴」。WPF 按命中元素向上找最近一份 ContextMenu——
                  右键落在节点/连线上时它们的模板菜单接管，只有空白（编辑器本体）才轮到这里  -->
            <nodify:NodifyEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Command="{Binding PasteCommand}"
                        Header="粘贴"
                        ToolTip="把复制的模块粘贴到鼠标位置（含子步骤与内部连线；指向外部步骤的连线不随粘贴保留）" />
                </ContextMenu>
            </nodify:NodifyEditor.ContextMenu>
            <nodify:NodifyEditor.Background>
                <DrawingBrush
                    TileMode="Tile"
                    Viewport="0,0,24,24"
                    ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <!--  底色图层 + 24×24 一个圆点：吸附格 = 可见格  -->
                            <GeometryDrawing
                                Brush="{StaticResource FlowCanvasBackgroundBrush}"
                                Geometry="F0 M0,0 H24 V24 H0 Z" />
                            <GeometryDrawing Geometry="M 12 12 L 12.01 12">
                                <GeometryDrawing.Pen>
                                    <Pen
                                        Brush="{StaticResource FlowCanvasGridDotBrush}"
                                        EndLineCap="Round"
                                        StartLineCap="Round"
                                        Thickness="1.4" />
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </nodify:NodifyEditor.Background>

            <nodify:NodifyEditor.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type nodify:ItemContainer}}" TargetType="{x:Type nodify:ItemContainer}">
                    <!--  Location 双向：拖动即回写视图模型，视图模型再写入 FlowLayoutStore  -->
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <!--  泳道与容器框钉死：框体坐标每次渲染由内容算出，拖了没地方存 -->
                    <Setter Property="IsDraggable" Value="{Binding IsDraggable}" />
                    <Setter Property="IsSelectable" Value="{Binding IsSelectable}" />
                    <!--  叠放层次：同层"框 < 泳道 < 内容"、跨层按拓扑深度抬高。
                          此前靠 Nodes 集合加入顺序叠放，后入分支的泳道会盖住先入分支里的嵌套容器框  -->
                    <Setter Property="Panel.ZIndex" Value="{Binding ZOrder}" />
                    <Setter Property="SelectedBrush" Value="{StaticResource FlowCanvasNodeSelectedGlowBrush}" />
                    <Setter Property="SelectedBorderThickness" Value="1.5" />
                    <!--  覆盖 Nodify 默认的常驻 DodgerBlue 1px 外框：未选中无框，选中态走 SelectedBrush  -->
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <!--  同一 ItemsSource 混放三种身份，按 Kind 切模板  -->
                <DataTemplate DataType="{x:Type vm:CanvasNodeViewModel}">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="ContentTemplate" Value="{StaticResource StepNodeTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:CanvasNodeKind.Lane}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource LaneNodeTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:CanvasNodeKind.Container}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ContainerNodeTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <!--  拖线中的临时连线：Source/Target 回写视图模型，由 CompletedCommand 落地为建线请求  -->
            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate>
                    <nodify:PendingConnection
                        AllowOnlyConnectors="True"
                        CompletedCommand="{Binding DataContext.CompleteConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                        EnablePreview="True"
                        EnableSnapping="True"
                        IsVisible="{Binding IsVisible}"
                        Source="{Binding Source, Mode=OneWayToSource}"
                        StartedCommand="{Binding DataContext.StartConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                        Style="{StaticResource FlowPendingConnectionStyle}"
                        Target="{Binding Target, Mode=OneWayToSource}"
                        TargetAnchor="{Binding TargetLocation, Mode=OneWayToSource}" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>
        </nodify:NodifyEditor>

        <!--  画布内拖动节点的浮层（纯视觉）：与工具箱 / 流程栏共用 DragGhostCard（设计基线 v2）。
              Popup 相对 Editor 定位，偏移由视图在 PreviewMouseMove 里按 (16,12) 更新；
              不参与命中测试，不会挡住放置目标。  -->
        <Popup
            x:Name="NodeDragGhost"
            Grid.Row="2"
            AllowsTransparency="True"
            Focusable="False"
            IsHitTestVisible="False"
            IsOpen="{Binding IsDragGhostVisible, Mode=OneWay}"
            Placement="Relative"
            PlacementTarget="{Binding ElementName=Editor}"
            PopupAnimation="Fade"
            StaysOpen="True">
            <controls:DragGhostCard
                Category="{Binding DragGhostCategory}"
                Icon="{Binding DragGhostIcon}"
                Title="{Binding DragGhostTitle}" />
        </Popup>

        <!--  小地图（flow-logic：180×118，工具条开关控制，默认关闭）：
              打开后仍可拖动/点击平移视口；关闭时整体 Collapsed，不占位、不遮挡输出节点  -->
        <Border
            Grid.Row="2"
            Width="180"
            Height="118"
            Margin="0,0,10,10"
            Padding="5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource FlowCanvasToolbarBrush}"
            BorderBrush="{StaticResource FlowCanvasToolbarBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowMinimap}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.15"
                    ShadowDepth="1" />
            </Border.Effect>
            <nodify:Minimap
                Background="{StaticResource FlowCanvasToolbarBrush}"
                ItemsSource="{Binding Nodes}"
                ItemTemplate="{StaticResource MinimapItemTemplate}"
                ViewportLocation="{Binding ViewportLocation, ElementName=Editor, Mode=TwoWay}"
                ViewportSize="{Binding ViewportSize, ElementName=Editor, Mode=TwoWay}" />
        </Border>

        <!--  空状态：未选流程时给出明确指引，而不是留一片空白画布  -->
        <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
            Text="请先在「程序」栏中选择一个流程"
            Visibility="{Binding EmptyHintVisibility}" />

        <!--  状态提示：连线被拒 / 解绑回执等一次性文案。StatusHint 为 null 时整行收起  -->
        <Border
            Grid.Row="3"
            Padding="10,4"
            Background="{StaticResource FlowCanvasToolbarBrush}"
            BorderBrush="{StaticResource FlowCanvasToolbarBorderBrush}"
            BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusHint}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                FontSize="11"
                Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                Text="{Binding StatusHint}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
