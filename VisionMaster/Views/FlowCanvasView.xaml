<UserControl
    x:Class="VisionMaster.Views.FlowCanvasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:VisionMaster.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="900"
    prism:ViewModelLocator.AutoWireViewModel="True"
    DataContextChanged="OnDataContextChanged"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  流程节点画布（海康式一图全展开）  -->
    <!--  整棵流程树摊在同一张画布上：模块盒 + 容器框（可折叠）+ 分支泳道 + 模块级聚合连线；  -->
    <!--  连线只在模块间画，具体端口绑定在变量绑定弹窗里维护（右键连线可逐条解绑/重开弹窗）。  -->
    <!--  执行顺序与连线合法性一律来自 FlowTopology，视图不参与判定。  -->
    <!--  ==========================================  -->

    <UserControl.Resources>

        <!--  模块卡片：圆角 + 运行态描边 + 禁用降透明（尺寸与 FlowCanvasViewModel.NodeWidth/Height 常量一致，锚点是边缘中点的纯数学）  -->
        <Style x:Key="StepCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FlowCanvasNodeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasNodeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Model.State}" Value="Running">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasRunningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.State}" Value="Success">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.State}" Value="Failed">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasFailedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.State}" Value="Skipped">
                    <Setter Property="BorderBrush" Value="{StaticResource FlowCanvasSkippedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Model.IsDisEnable}" Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  连接点（每节点左入右出各一枚，骑在盒子边缘上）：
              DataContext 切到连接器 VM（IsConnected 驱动实心/空心外观）；
              Anchor 不在这里回报——连线端点由主 VM 按盒子边缘中点直接算（确定性）。  -->
        <Style x:Key="FlowConnectorStyle" TargetType="Control">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!--  ====================  模块盒（真实步骤，固定 210×62）  ====================  -->
        <DataTemplate x:Key="StepNodeTemplate" DataType="{x:Type vm:CanvasNodeViewModel}">
            <Grid Width="210" Height="62">
                <Border Style="{StaticResource StepCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  图标  -->
                        <TextBlock
                            Grid.Column="0"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="20"
                            Foreground="{StaticResource FlowCanvasNodeIconBrush}"
                            Text="{Binding IconGlyph}" />

                        <!--  名称 + 插件名  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,4,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FlowCanvasNodeTextBrush}"
                                Text="{Binding Header}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Header}" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                                Text="{Binding SubTitle}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding SubTitle}" />
                        </StackPanel>

                        <!--  外链角标：全局变量/常量绑定数（悬停看明细）  -->
                        <Border
                            Grid.Column="2"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource FlowCanvasExtBadgeBrush}"
                            BorderBrush="{StaticResource FlowCanvasExtBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="5,1"
                            ToolTip="{Binding ExternalLinkTooltip}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExternalLinkCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource FlowCanvasExtBadgeTextBrush}"
                                Text="{Binding ExternalLinkCount}" />
                        </Border>
                    </Grid>
                </Border>

                <!--  执行序号角标：贴在节点左上角，越界压住标题栏是可接受的（它就是要显眼）  -->
                <Border
                    Padding="6,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource FlowCanvasOrderBadgeBrush}"
                    CornerRadius="0,0,7,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrderLabel}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{StaticResource FlowCanvasOnOrderBadgeTextBrush}"
                        Text="{Binding OrderLabel}" />
                </Border>

                <!--  连接点：左入右出（DataContext 切到连接器 VM）  -->
                <nodify:NodeInput
                    Margin="-7,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    DataContext="{Binding Inputs[0]}"
                    IsConnected="{Binding IsConnected}"
                    Style="{StaticResource FlowConnectorStyle}"
                    ToolTip="目标脚：从其它模块的圆点拖到这里建立连线" />
                <nodify:NodeOutput
                    Margin="0,0,-7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    DataContext="{Binding Outputs[0]}"
                    IsConnected="{Binding IsConnected}"
                    Style="{StaticResource FlowConnectorStyle}"
                    ToolTip="源脚：按住拖到目标模块建立连线" />
            </Grid>
        </DataTemplate>

        <!--  ====================  容器框（If / While / For，可折叠）  ====================  -->
        <DataTemplate x:Key="ContainerNodeTemplate" DataType="{x:Type vm:CanvasNodeViewModel}">
            <Grid Width="{Binding LaneWidth}" Height="{Binding LaneHeight}">
                <Border
                    Background="{StaticResource FlowCanvasFrameTintBrush}"
                    BorderBrush="{StaticResource FlowCanvasFrameBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="10">
                    <!--  头带：折叠钮 + 类型徽标 + 名称 + 折叠角标  -->
                    <Border VerticalAlignment="Top" Background="Transparent">
                        <Border
                            Margin="6,6,6,0"
                            Padding="8,4"
                            Background="{StaticResource FlowCanvasFrameHeaderBrush}"
                            BorderBrush="{StaticResource FlowCanvasFrameBorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  折叠 / 展开  -->
                                <Border
                                    Grid.Column="0"
                                    Margin="0,0,6,0"
                                    Background="{StaticResource FlowCanvasCollapseBrush}"
                                    BorderBrush="{StaticResource FlowCanvasCollapseBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Cursor="Hand"
                                    ToolTip="点击折叠 / 展开该容器">
                                    <Border.InputBindings>
                                        <MouseBinding
                                            Command="{Binding DataContext.ToggleCollapseCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Gesture="LeftClick" />
                                    </Border.InputBindings>
                                    <TextBlock
                                        MinWidth="16"
                                        TextAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="11"
                                        Foreground="{StaticResource FlowCanvasCollapseTextBrush}"
                                        Text="{Binding CollapseGlyph}" />
                                </Border>

                                <!--  类型徽标  -->
                                <Border
                                    Grid.Column="1"
                                    Margin="0,0,6,0"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource FlowCanvasTypeBadgeBrush}"
                                    CornerRadius="4"
                                    Visibility="{Binding TypeBadgeVisibility}">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource FlowCanvasOnTypeBadgeTextBrush}"
                                        Text="{Binding TypeBadge}" />
                                </Border>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource FlowCanvasFrameHeaderTextBrush}"
                                    Text="{Binding Header}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Header}" />

                                <TextBlock
                                    Grid.Column="3"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="{StaticResource FlowCanvasFrameHeaderTextBrush}"
                                    Text="{Binding CollapsedBadgeText}" />
                            </Grid>
                        </Border>
                    </Border>
                </Border>

                <!--  执行序号角标：容器也参与执行序（折叠时同样可见）  -->
                <Border
                    Padding="6,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource FlowCanvasOrderBadgeBrush}"
                    CornerRadius="0,0,7,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrderLabel}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{StaticResource FlowCanvasOnOrderBadgeTextBrush}"
                        Text="{Binding OrderLabel}" />
                </Border>

                <!--  连接点：容器框左右缘中点（For.Index 这类产出从这里连出）  -->
                <nodify:NodeInput
                    Margin="-7,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    DataContext="{Binding Inputs[0]}"
                    IsConnected="{Binding IsConnected}"
                    Style="{StaticResource FlowConnectorStyle}"
                    ToolTip="目标脚：从其它模块的圆点拖到这里建立连线" />
                <nodify:NodeOutput
                    Margin="0,0,-7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    DataContext="{Binding Outputs[0]}"
                    IsConnected="{Binding IsConnected}"
                    Style="{StaticResource FlowConnectorStyle}"
                    ToolTip="源脚：按住拖到目标模块建立连线" />
            </Grid>
        </DataTemplate>

        <!--  ====================  分支泳道（容器框内的列背景装饰）  ====================  -->
        <DataTemplate x:Key="LaneNodeTemplate" DataType="{x:Type vm:CanvasNodeViewModel}">
            <Border
                Width="{Binding LaneWidth}"
                Height="{Binding LaneHeight}"
                Background="{StaticResource FlowCanvasLaneTintBrush}"
                BorderBrush="{StaticResource FlowCanvasLaneBorderBrush}"
                BorderThickness="1"
                CornerRadius="7">
                <Grid VerticalAlignment="Top">
                    <TextBlock
                        Margin="10,6"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource FlowCanvasLaneTextBrush}"
                        Text="{Binding Header}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Header}" />
                    <TextBlock
                        Margin="10,26,10,0"
                        FontSize="10"
                        Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                        Text="（空分支，可从流程栏添加步骤）"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLaneEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  数据线的右键菜单（顺序链没有绑定语义，不挂菜单）  -->
        <ContextMenu x:Key="DataLinkMenu">
            <MenuItem
                Command="{Binding DataContext.OpenBindingCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                CommandParameter="{Binding Target.Model}"
                Header="编辑绑定…（打开变量绑定）" />
            <Separator />
            <ItemsControl ItemsSource="{Binding Bindings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <MenuItem
                            Command="{Binding DataContext.UnbindCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                            CommandParameter="{Binding}"
                            Header="{Binding MenuHeader}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContextMenu>

        <!--  ====================  模块级聚合连线（端点 = 主 VM 算好的盒子边缘中点）  ====================  -->
        <!--  数据线：横向（右缘出 → 左缘入）；执行顺序链：纵向（底缘出 → 顶缘入），细虚线、无菜单  -->
        <DataTemplate x:Key="ModuleLinkTemplate" DataType="{x:Type vm:CanvasLinkViewModel}">
            <nodify:LineConnection
                Source="{Binding SourceAnchor}"
                Target="{Binding TargetAnchor}"
                ToolTip="{Binding Tooltip}">
                <nodify:LineConnection.ContextMenu>
                    <ContextMenu
                        ItemsSource="{Binding Bindings}"
                        Visibility="{Binding ContextMenuVisibility, Converter={x:Null}}" />
                </nodify:LineConnection.ContextMenu>
                <nodify:LineConnection.Style>
                    <Style TargetType="{x:Type nodify:LineConnection}">
                        <Setter Property="ContextMenu" Value="{StaticResource DataLinkMenu}" />
                        <Setter Property="Stroke" Value="{StaticResource FlowCanvasLinkBrush}" />
                        <Setter Property="StrokeThickness" Value="2" />
                        <Style.Triggers>
                            <!--  执行顺序链：细灰虚线自上而下（与数据线区分）  -->
                            <DataTrigger Binding="{Binding IsOrderLink}" Value="True">
                                <Setter Property="ContextMenu" Value="{x:Null}" />
                                <Setter Property="Stroke" Value="{StaticResource FlowCanvasOrderLinkBrush}" />
                                <Setter Property="StrokeDashArray" Value="3,3" />
                                <Setter Property="StrokeThickness" Value="1.5" />
                            </DataTrigger>
                            <!--  结构非法的线：红色虚线，编译会报致命错  -->
                            <DataTrigger Binding="{Binding IsIllegal}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource FlowCanvasLinkIllegalBrush}" />
                                <Setter Property="StrokeDashArray" Value="4,3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </nodify:LineConnection.Style>
            </nodify:LineConnection>
        </DataTemplate>

        <!--  小地图项：一个点代表一个模块  -->
        <DataTemplate x:Key="MinimapItemTemplate" DataType="{x:Type vm:CanvasNodeViewModel}">
            <nodify:MinimapItem Location="{Binding Location}">
                <Rectangle
                    Width="9"
                    Height="6"
                    Fill="{StaticResource FlowCanvasLinkBrush}"
                    RadiusX="1.5"
                    RadiusY="1.5" />
            </nodify:MinimapItem>
        </DataTemplate>

        <!--  缩放工具条按钮  -->
        <Style x:Key="ZoomToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource FlowCanvasNodeTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource FlowCanvasCollapseHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部工具条：左 = 流程名与操作提示；右 = 缩放工具  -->
        <Border
            Grid.Row="0"
            Padding="10,6"
            Background="{StaticResource FlowCanvasToolbarBrush}"
            BorderBrush="{StaticResource FlowCanvasToolbarBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource FlowCanvasNodeTextBrush}"
                        Text="{Binding FlowTitle}" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                        Text="拖动节点改布局 · 从模块圆点拖线连接 · 右键连线编辑绑定 · 点框头折叠容器" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        Command="{Binding ZoomCommand}"
                        CommandParameter="{x:Static vm:FlowCanvasZoomCommand.ZoomIn}"
                        Content="＋"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="放大" />
                    <Button
                        Command="{Binding ZoomCommand}"
                        CommandParameter="{x:Static vm:FlowCanvasZoomCommand.ZoomOut}"
                        Content="－"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="缩小" />
                    <Button
                        Command="{Binding ZoomCommand}"
                        CommandParameter="{x:Static vm:FlowCanvasZoomCommand.ActualSize}"
                        Content="1:1"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="恢复 100%" />
                    <Button
                        Command="{Binding ZoomCommand}"
                        CommandParameter="{x:Static vm:FlowCanvasZoomCommand.Fit}"
                        Content="适应"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="适应画布" />
                    <Button
                        Command="{Binding TidyLayoutCommand}"
                        Content="整理"
                        Style="{StaticResource ZoomToolButtonStyle}"
                        ToolTip="清空散乱坐标，按执行顺序重新正交排布" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  结构告警条：只有非法连线才出现（全局变量/常量折成角标是常态，不报警）  -->
        <Border
            Grid.Row="1"
            Padding="10,4"
            Background="{StaticResource ScadaInvalidBackgroundBrush}"
            BorderThickness="0"
            Visibility="{Binding WarningVisibility}">
            <TextBlock
                FontSize="11"
                Foreground="{StaticResource FlowCanvasFailedBrush}"
                Text="{Binding WarningText}"
                TextWrapping="Wrap" />
        </Border>

        <nodify:NodifyEditor
            x:Name="Editor"
            Grid.Row="2"
            Background="{StaticResource FlowCanvasBackgroundBrush}"
            Connections="{Binding Links}"
            ConnectionTemplate="{StaticResource ModuleLinkTemplate}"
            GridCellSize="24"
            ItemsSource="{Binding Nodes}"
            ItemsDragStartedCommand="{Binding ItemsDragStartedCommand}"
            ItemsDragCompletedCommand="{Binding ItemsDragCompletedCommand}"
            PendingConnection="{Binding PendingConnection}">

            <!--  撤销 / 重做 快捷键（栈空时 CanExecute=false 自动屏蔽）  -->
            <nodify:NodifyEditor.InputBindings>
                <KeyBinding
                    Key="Z"
                    Command="{Binding UndoCommand}"
                    Modifiers="Control" />
                <KeyBinding
                    Key="Y"
                    Command="{Binding RedoCommand}"
                    Modifiers="Control" />
            </nodify:NodifyEditor.InputBindings>

            <nodify:NodifyEditor.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type nodify:ItemContainer}}" TargetType="{x:Type nodify:ItemContainer}">
                    <!--  Location 双向：拖动即回写视图模型，视图模型再写入 FlowLayoutStore  -->
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <!--  泳道与容器框钉死：框体坐标每次渲染由内容算出，拖了没地方存 -->
                    <Setter Property="IsDraggable" Value="{Binding IsDraggable}" />
                    <Setter Property="IsSelectable" Value="{Binding IsSelectable}" />
                    <Setter Property="SelectedBrush" Value="{StaticResource FlowCanvasNodeSelectedGlowBrush}" />
                    <Setter Property="SelectedBorderThickness" Value="1.5" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <!--  同一 ItemsSource 混放三种身份，按 Kind 切模板  -->
                <DataTemplate DataType="{x:Type vm:CanvasNodeViewModel}">
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="ContentTemplate" Value="{StaticResource StepNodeTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:CanvasNodeKind.Lane}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource LaneNodeTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:CanvasNodeKind.Container}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ContainerNodeTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <!--  拖线中的临时连线：Source/Target 回写视图模型，由 CompletedCommand 落地为建线请求  -->
            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate>
                    <nodify:PendingConnection
                        AllowOnlyConnectors="True"
                        CompletedCommand="{Binding DataContext.CompleteConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                        EnablePreview="True"
                        EnableSnapping="True"
                        IsVisible="{Binding IsVisible}"
                        Source="{Binding Source, Mode=OneWayToSource}"
                        StartedCommand="{Binding DataContext.StartConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                        Target="{Binding Target, Mode=OneWayToSource}"
                        TargetAnchor="{Binding TargetLocation, Mode=OneWayToSource}" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>
        </nodify:NodifyEditor>

        <!--  小地图：右下角浮层，点住可平移视口  -->
        <Border
            Grid.Row="2"
            Width="216"
            Height="146"
            Margin="0,0,10,10"
            Padding="6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource FlowCanvasToolbarBrush}"
            BorderBrush="{StaticResource FlowCanvasToolbarBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.15"
                    ShadowDepth="1" />
            </Border.Effect>
            <nodify:Minimap
                ItemsSource="{Binding Nodes}"
                ItemTemplate="{StaticResource MinimapItemTemplate}"
                ViewportLocation="{Binding ViewportLocation, ElementName=Editor, Mode=TwoWay}"
                ViewportSize="{Binding ViewportSize, ElementName=Editor, Mode=TwoWay}" />
        </Border>

        <!--  空状态：未选流程时给出明确指引，而不是留一片空白画布  -->
        <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
            Text="请先在「程序」栏中选择一个流程"
            Visibility="{Binding EmptyHintVisibility}" />

        <!--  状态提示：连线被拒 / 解绑回执等一次性文案。StatusHint 为 null 时整行收起  -->
        <Border
            Grid.Row="3"
            Padding="10,4"
            Background="{StaticResource FlowCanvasToolbarBrush}"
            BorderBrush="{StaticResource FlowCanvasToolbarBorderBrush}"
            BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusHint}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                FontSize="11"
                Foreground="{StaticResource FlowCanvasNodeSubTextBrush}"
                Text="{Binding StatusHint}"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
