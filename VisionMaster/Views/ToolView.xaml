<UserControl
    x:Class="VisionMaster.Views.ToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    d:DesignHeight="600"
    d:DesignWidth="250"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Background="#F5F6F8">
        <Grid.Resources>
            <!--  拖拽预览：胶囊行  -->
            <DataTemplate x:Key="MyDragAdornerTemplate">
                <Border
                    Height="32"
                    MinWidth="120"
                    Background="#FFFFFF"
                    BorderBrush="#C9D2DC"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="14"
                            Foreground="#4A5568"
                            Text="{Binding Icon}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#2D3748"
                            Text="{Binding Name}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  搜索工具箱（Win11 输入框风格）  -->
        <Border
            Grid.Row="0"
            Margin="8,8,8,4"
            Padding="10,5"
            Background="#FFFFFF"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    Foreground="#333333"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Resources>
                        <VisualBrush
                            x:Key="SearchHint"
                            AlignmentX="Left"
                            Stretch="None">
                            <VisualBrush.Visual>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="12"
                                        Foreground="#9AA5B1"
                                        Text="&#xf002;" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#9AA5B1"
                                        Text="搜索工具箱" />
                                </StackPanel>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource SearchHint}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    FontSize="13"
                    Foreground="#9AA5B1"
                    Text="&#xf002;" />
            </Grid>
        </Border>

        <!--  插件分组区（Win11 卡片式：组=独立卡片，行=独立圆角行）  -->
        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

                <ItemsControl Margin="8,4,8,8" ItemsSource="{Binding FilteredToolBarSource}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  组卡片  -->
                            <Border
                                Margin="0,4"
                                Background="#FFFFFF"
                                BorderBrush="#E5E8EC"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Expander
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Header="{Binding Name}"
                                    IsExpanded="True">

                                    <Expander.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="12,10"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </Expander.HeaderTemplate>

                                    <!--  工具列表：一行一个工具，行间留隙不连片  -->
                                    <ItemsControl
                                        Margin="5,0,5,7"
                                        dd:DragDrop.DragAdornerTemplate="{StaticResource MyDragAdornerTemplate}"
                                        dd:DragDrop.IsDragSource="True"
                                        dd:DragDrop.UseDefaultDragAdorner="False"
                                        dd:DragDrop.UseDefaultEffectDataTemplate="True"
                                        ItemsSource="{Binding Children}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    x:Name="RowBorder"
                                                    Height="30"
                                                    Margin="2,3"
                                                    Padding="10,0"
                                                    Background="Transparent"
                                                    BorderBrush="Gray"
                                                    BorderThickness="0.1"
                                                    CornerRadius="4"
                                                    ToolTip="{Binding Description}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#EEF3F8" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock
                                                            Width="20"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource Icon}"
                                                            FontSize="15"
                                                            Foreground="#5B6B7C"
                                                            Text="{Binding Icon}"
                                                            TextAlignment="Center"
                                                            TextOptions.TextFormattingMode="Display" />
                                                        <TextBlock
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12.5"
                                                            Foreground="#33363D"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
