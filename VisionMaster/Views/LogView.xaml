<UserControl
    x:Class="VisionMaster.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Views"
    xmlns:models="clr-namespace:UI.Models;assembly=VM.Core"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="clr-namespace:UI.CustomControl;assembly=UI"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!--
            搜索框外观：Fluent 的隐式 TextBox 样式把输入框画成"透明底 + 一条 6% 黑的底线"，
            放在这条浅色工具条上就是一块看不见的空地（真机截图已踩：搜索框完全没有输入框的样子）。
            这里用一个显式的模板给回"白底 + 1px 描边 + 4px 圆角，聚焦时描边转强调色"。
            OverridesDefaultStyle 是必须的：不写的话 Fluent 的隐式样式仍然会赢，模板换不上。
            颜色照本控件自己的亮色系（AccentBrush 的 #005FB8 / 面板边框 #DCE3EB 同族），
            与 MonitorView.xaml 的工具条写法一致（视图内不引令牌键，避免无 Application 的宿主解析期报错）。
        -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="CaretBrush" Value="#333333" />
            <Setter Property="SelectionBrush" Value="#CCE8FF" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="Bd"
                            Background="#FFFFFF"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A94A6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#005FB8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            等级筹码的容器样式：筹码外形全在 ItemTemplate 里画（因此"选中 = 填成本级色"这些
            状态都由模板触发器统一处理），容器只保留"能点 + 手型"。
            OverridesDefaultStyle 是必须的：不写的话 Fluent 的隐式 ListBoxItem 样式会画选中高亮，
            和筹码自己的着色叠在一起。
        -->
        <Style x:Key="LevelChipHostStyle" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  日志区：MaxItems 限制面板保留条数（超出裁掉最旧的），完整历史以 Logs\yyyy-MM-dd.log 为准  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            过滤工具条：搜索 / 等级 / 跟随最新 —— 这三个控件是 LogConsole 三个依赖属性
            （SearchText / FilterLevel / AutoScroll）的界面入口；没有它们，
            控件里那套过滤与"智能滚动"在真机上根本没路可走。
            配色取本控件自己的亮色系（面板 #FAFAFA / 分组表头 #E9EEF5 / 边框 #E5E5E5）。
        -->
        <Border
            Grid.Row="0"
            Padding="10,6"
            Background="#F1F4F8"
            BorderBrush="#DCE3EB"
            BorderThickness="0,0,0,1">
            <Grid>
                <!--
                    两行：第一行"搜索 + 跟随最新"，第二行"等级筹码"吃满整行宽度。
                    为什么分开：5 枚筹码加起来约 380px，和搜索框挤一行时，窄面板(≈560px)只能
                    一格一行竖着堆成 5 行（试过，很丑）；分两行后 1000px 面板一行放全，
                    窄到 500px 也才折两行。与 ScadaAlarmHistoryView 筛选区的排法一致。
                -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#5A6472"
                    Text="搜索:" />

                <!--  搜索框：定宽（不跟窗口拉伸，免得宽屏时变成一条"空地"）  -->
                <Grid
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="200"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <TextBox
                        x:Name="SearchBox"
                        Style="{StaticResource SearchBoxStyle}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="匹配日志正文与来源，忽略大小写；输入停顿 200ms 后刷新列表" />
                    <!--  占位提示：只在没输入时显示（WPF 原生 TextBox 无 Placeholder），左缩进 = 边框 1 + Padding 8  -->
                    <TextBlock
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#9AA4B2"
                        IsHitTestVisible="False"
                        Text="正文或来源">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,6,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#5A6472"
                    Text="等级:" />

                <!--
                    等级筹码（取代原来的下拉框）：一格一级，带本级颜色圆点与实时条数。
                    只有 5 个固定项，摊开就是一眼看全；计数顺手回答了"有没有错误"。
                    与 ScadaAlarmHistoryView 的 FilterStrip 是同一套做法（ListBox + WrapPanel + 自带容器样式）。
                -->
                <ListBox
                    x:Name="LevelChips"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,6,0,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource LevelChipHostStyle}"
                    ItemsSource="{Binding LevelOptions}"
                    SelectedItem="{Binding LevelOption}"
                    ToolTip="只看某一等级；「全部」= 不限等级（数字是这一级当前有多少条）"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="Chip"
                                Padding="9,3"
                                Background="#FFFFFF"
                                BorderBrush="#D0D7DE"
                                BorderThickness="1"
                                CornerRadius="11">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Fill="#9AA4B2" />
                                    <TextBlock
                                        x:Name="Label"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#4A5568"
                                        Text="{Binding Text}" />
                                    <TextBlock
                                        x:Name="Count"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#8A94A6"
                                        Text="{Binding Count}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <!--  「全部」不带圆点：它是"不限"，不属于某一级  -->
                                <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!--  未选中：圆点用本级色  -->
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static models:LogLevel.Info}">
                                    <Setter TargetName="Dot" Property="Fill" Value="#0078D4" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static models:LogLevel.Success}">
                                    <Setter TargetName="Dot" Property="Fill" Value="#107C10" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static models:LogLevel.Warning}">
                                    <Setter TargetName="Dot" Property="Fill" Value="#D83B01" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static models:LogLevel.Error}">
                                    <Setter TargetName="Dot" Property="Fill" Value="#D13438" />
                                </DataTrigger>
                                <!--  选中：整枚填成本级色（"全部"填强调色），字转白、圆点转白  -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="#005FB8" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#005FB8" />
                                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="Count" Property="Foreground" Value="#B9D4EF" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Static models:LogLevel.Info}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="#0078D4" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#0078D4" />
                                    <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF" />
                                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="Count" Property="Foreground" Value="#B3D7F2" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Static models:LogLevel.Success}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="#107C10" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#107C10" />
                                    <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF" />
                                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="Count" Property="Foreground" Value="#B9DCB9" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Static models:LogLevel.Warning}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="#D83B01" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#D83B01" />
                                    <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF" />
                                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="Count" Property="Foreground" Value="#F2CDB3" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Static models:LogLevel.Error}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="#D13438" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#D13438" />
                                    <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF" />
                                    <Setter TargetName="Label" Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="Count" Property="Foreground" Value="#F2BFC1" />
                                </MultiDataTrigger>
                                <!--  悬停（未选中）：描边加深  -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="#8A94A6" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="跟随最新"
                    IsChecked="{Binding AutoScroll}"
                    ToolTip="勾选时贴着最新日志滚动；你往上翻会自动暂停，翻回底部自动恢复" />
            </Grid>
        </Border>

        <ui:LogConsole
            Grid.Row="1"
            AutoScroll="{Binding AutoScroll}"
            FilterLevel="{Binding FilterLevel}"
            ItemsSource="{Binding SystemLogs}"
            MaxItems="2000"
            SearchText="{Binding SearchText}" />
    </Grid>
</UserControl>
