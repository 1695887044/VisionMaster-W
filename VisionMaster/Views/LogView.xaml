<UserControl
    x:Class="VisionMaster.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VisionMaster.Views"
    xmlns:models="clr-namespace:UI.Models;assembly=VM.Core"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="clr-namespace:UI.CustomControl;assembly=UI"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!--
            设计基线：docs/UI设计基线/log-console/ v1（2026-10-22 复刻）。
            本文件零硬编码色值（R140）；颜色全部走 Dialog* 令牌。

            就地合并 Colors.xaml：本视图的局部样式直接引用 {StaticResource Dialog*Brush}，
            而断言宿主（ScadaChecks / 无 Application 的探针）没有应用级资源，
            不合并会在 XAML 解析期抛"找不到资源"（R22 同族教训）。
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  搜索框：白底 + 1px 描边 + 6px 圆角，聚焦转强调色（Fluent 隐式样式那条底线在浅色条上看不见）  -->
            <Style x:Key="SearchBoxStyle" TargetType="TextBox">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource DialogAccentLightBrush}" />
                <Setter Property="Padding" Value="28,0,28,0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border
                                x:Name="Bd"
                                Background="{StaticResource DialogSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Focusable="False"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogTextMutedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                等级筹码容器：筹码外形全在 ItemTemplate 里画（选中=填成本级色），
                容器只保留"能点 + 手型 + 焦点环"。
                OverridesDefaultStyle 必须写：否则 Fluent 隐式 ListBoxItem 样式会再画一层选中高亮。
            -->
            <Style x:Key="LevelChipHostStyle" TargetType="ListBoxItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="FocusBd"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="15">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusBd" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  空态 / 无结果态的图标与标题  -->
            <Style x:Key="StateGlyphStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="34" />
                <Setter Property="Foreground" Value="{StaticResource DialogBorderStrongBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StateTitleStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextTertiaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StateHintStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <!--  次要按钮（无结果态的"清空筛选条件"）：白底 + 描边  -->
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource DialogSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            过滤工具条（两行）：
              第一行 搜索 + 跟随最新；第二行 等级筹码。
            为什么两行：5 枚筹码约 380px，与搜索框挤一行时窄面板会竖着堆成 5 行；
            分两行后宽面板一行放全，窄到 500px 也只折两行。
        -->
        <Border
            Grid.Row="0"
            Padding="10,8"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                    Text="搜索" />

                <!--  搜索框：定宽 220（不跟窗口拉伸，免得宽屏时变成一条"空地"）  -->
                <Grid
                    x:Name="SearchBoxHost"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="220"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <TextBox
                        x:Name="SearchBox"
                        Style="{StaticResource SearchBoxStyle}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="匹配日志正文与来源，忽略大小写；输入停顿 200ms 后刷新列表">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding ClearFiltersCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <!--  左侧放大镜  -->
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        IsHitTestVisible="False"
                        Text="⌕" />
                    <!--  占位提示：只在没输入时显示（WPF 原生 TextBox 无 Placeholder）  -->
                    <TextBlock
                        Margin="30,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        IsHitTestVisible="False"
                        Text="正文或来源">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!--  清空按钮：22×22，Padding=0（R68：不写就会被隐式内边距削掉字形）  -->
                    <Button
                        x:Name="ClearSearchButton"
                        Width="22"
                        Height="22"
                        Margin="0,0,4,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ClearFiltersCommand}"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="清空搜索与等级筛选（Esc）">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="✕" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Content="跟随最新"
                    FontSize="12"
                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                    IsChecked="{Binding AutoScroll}"
                    ToolTip="勾选时贴着最新日志滚动；你往上翻会自动暂停，翻回底部自动恢复" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,8,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                    Text="等级" />

                <!--
                    等级筹码：一格一级，带本级颜色圆点与实时条数。
                    选中态由 DataTemplate.Triggers 按 Value 逐级着色（设计稿的"整枚填成本级色"）。
                -->
                <ListBox
                    x:Name="LevelChips"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource LevelChipHostStyle}"
                    ItemsSource="{Binding LevelOptions}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding LevelOption}"
                    ToolTip="只看某一等级；「全部」= 不限等级（数字是这一级当前有多少条）">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="Chip"
                                Height="26"
                                Padding="10,0"
                                Background="{StaticResource DialogSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="13">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource DialogTextMutedBrush}" />
                                    <TextBlock
                                        x:Name="Label"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="{Binding Text}" />
                                    <TextBlock
                                        x:Name="Count"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding Count}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <!--  「全部」不带圆点：它是"不限"，不属于某一级  -->
                                <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!--  未选中：圆点用本级色  -->
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static models:LogLevel.Info}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogAccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static models:LogLevel.Success}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static models:LogLevel.Warning}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Value}" Value="{x:Static models:LogLevel.Error}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                </DataTrigger>
                                <!--  悬停（未选中）：描边加深  -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogTextMutedBrush}" />
                                </MultiDataTrigger>

                                <!--
                                    选中：整枚填成本级色，文字转白、圆点转白。
                                    这四组 MultiDataTrigger 是"按 Value 逐级换色"的唯一写法
                                    （DataTrigger 不能按枚举值直接给 Setter 换不同画刷），
                                    颜色仍全部来自令牌，新增等级只需补一组。
                                -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Null}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogAccentDarkBrush}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogAccentDarkBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Count" Property="Foreground" Value="{StaticResource DialogAccentBorderBrush}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Static models:LogLevel.Info}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogAccentDarkBrush}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogAccentDarkBrush}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Count" Property="Foreground" Value="{StaticResource DialogAccentBorderBrush}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Static models:LogLevel.Success}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogSuccessTextBrush}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogSuccessTextBrush}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Count" Property="Foreground" Value="{StaticResource DialogSuccessBorderBrush}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Static models:LogLevel.Warning}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogWarningTextBrush}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogWarningTextBrush}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Count" Property="Foreground" Value="{StaticResource DialogWarningBorderBrush}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                        <Condition Binding="{Binding Value}" Value="{x:Static models:LogLevel.Error}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogDangerTextBrush}" />
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogDangerTextBrush}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                                    <Setter TargetName="Count" Property="Foreground" Value="{StaticResource DialogDangerBorderBrush}" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!--
            日志区 + 两种"空"。
            「无结果」（有筛选、一条没命中）与「空态」（真的没有日志）必须分开：
            只给白板的话，用户分不清是"没日志"还是"筛没了"。

            布局用"叠层 + 可见性"，不用 Collapsed 收起 LogConsole：
            控件一旦 Collapsed 就不参与布局，模板里的 ScrollViewer 拿不到尺寸，
            "首屏贴底"与"翻回底部恢复"两处断言会失去意义（且用户切回有日志时
            会看到从顶部开始，而不是贴底）。
        -->
        <Grid Grid.Row="1">
            <!--
                面板保留条数绑 VM.PanelMaxRows（= AppConfigModel.LogPanelMaxRows，设置弹窗可改）。
                原先这里硬编码 MaxItems="2000"，与配置默认值 5000 并存 —— 改配置永远被 2000 压住，
                "面板保留条数"这一项实际上是死的（2026-10-30 实测）。
            -->
            <ui:LogConsole
                x:Name="Console"
                AutoScroll="{Binding AutoScroll}"
                FilterLevel="{Binding FilterLevel}"
                ItemsSource="{Binding SystemLogs}"
                MaxItems="{Binding PanelMaxRows}"
                SearchText="{Binding SearchText}" />

            <!--  无结果：放大镜 + 一句说明 + 清空筛选条件（出口按钮，接 ClearFiltersCommand）  -->
            <Border Background="{StaticResource DialogSurfaceBrush}" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilterEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StateGlyphStyle}" Text="⌕" />
                    <TextBlock Style="{StaticResource StateTitleStyle}" Text="没有匹配的日志" />
                    <TextBlock Style="{StaticResource StateHintStyle}" Text="当前筛选条件在面板里没有命中任何一条。" />
                    <Button
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空筛选条件"
                        Style="{StaticResource QuietButtonStyle}" />
                </StackPanel>
            </Border>

            <!--  空态：真的没有日志  -->
            <Border Background="{StaticResource DialogSurfaceBrush}" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource StateGlyphStyle}" Text="▤" />
                    <TextBlock Style="{StaticResource StateTitleStyle}" Text="还没有日志" />
                    <TextBlock Style="{StaticResource StateHintStyle}" Text="软件刚启动或日志已清空；完整历史在 Logs\ 目录。" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  底栏：显示 N / 共 M，右侧给出完整历史的文件口径（不是按钮）  -->
        <Border
            Grid.Row="2"
            Padding="12,6"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="显示 " />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="{Binding FilteredCount}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text=" / 共 " />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="{Binding SystemLogs.Count}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text=" 条" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="10.5"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="完整历史：Logs\yyyy-MM-dd.log" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
