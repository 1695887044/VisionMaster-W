<UserControl
    x:Class="VisionMaster.Views.RunCockpitView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:VisionMaster.Views"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="CockpitStopButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource RunCockpitStopBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RunCockpitStopBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource RunCockpitTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RunCockpitStopHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CockpitKpiCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RunCockpitSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RunCockpitBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource RunCockpitBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="96" />
        </Grid.RowDefinitions>

        <!--  驾驶舱顶条  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource RunCockpitChromeBrush}"
            BorderBrush="{StaticResource RunCockpitBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,9,0"
                        VerticalAlignment="Center"
                        Fill="{Binding RunStateBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource RunCockpitTextBrush}"
                        Text="{Binding RunStateText}" />
                    <!--  与调试运行条同一口径：绑 RunBarFlowText（在跑的那几条），不绑选中项。
                          原来的「当前流程 · {0}」前缀一并去掉——多条并跑时它不是"当前流程"，
                          而且左边那行已经写着「循环运行中」，再写一遍"当前"只会让人以为只有这一条在跑。  -->
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource RunCockpitTextMutedBrush}"
                        Text="{Binding RunBarFlowText}"
                        ToolTip="{Binding RunBarFlowToolTip}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ExecutionCommand}"
                        CommandParameter="{x:Static local:ExecutionAction.Stop}"
                        Content="停止运行"
                        Style="{StaticResource CockpitStopButton}"
                        ToolTip="停止当前运行（与顶栏停止同一命令）" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  图像区：复用现有 ImageView，不复制图像渲染链路  -->
        <Border
            Grid.Row="1"
            Margin="12"
            Padding="0"
            Background="{StaticResource RunCockpitSurfaceBrush}"
            BorderBrush="{StaticResource RunCockpitBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Border
                Background="{StaticResource RunCockpitBackgroundBrush}"
                ClipToBounds="True"
                CornerRadius="6">
                <views:ImageView Margin="0" />
            </Border>
        </Border>

        <!--  KPI 条：当前没有运行统计源，先显示“待接入”，不伪造生产数字  -->
        <UniformGrid
            Grid.Row="2"
            Margin="12,0,2,12"
            Columns="4">
            <Border Style="{StaticResource CockpitKpiCard}">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource RunCockpitTextMutedBrush}"
                        Text="节拍" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource RunCockpitTextBrush}"
                        Text="—" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource RunCockpitTextFaintBrush}"
                        Text="待接入运行统计" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CockpitKpiCard}">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource RunCockpitTextMutedBrush}"
                        Text="良率" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource RunCockpitSuccessBrush}"
                        Text="—" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource RunCockpitTextFaintBrush}"
                        Text="待接入运行统计" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CockpitKpiCard}">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource RunCockpitTextMutedBrush}"
                        Text="设备在线" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource RunCockpitInfoBrush}"
                        Text="—" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource RunCockpitTextFaintBrush}"
                        Text="待接入设备状态" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CockpitKpiCard}">
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource RunCockpitTextMutedBrush}"
                        Text="未确认报警" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource RunCockpitWarningBrush}"
                        Text="—" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource RunCockpitTextFaintBrush}"
                        Text="待接入报警统计" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
