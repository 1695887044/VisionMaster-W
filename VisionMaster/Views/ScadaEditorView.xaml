<UserControl
    x:Class="VisionMaster.Views.ScadaEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VisionMaster.Scada.Controls;assembly=VM.Scada.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:VisionMaster.Scada;assembly=VM.Scada"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="900"
    prism:ViewModelLocator.AutoWireViewModel="True"
    DataContextChanged="OnViewDataContextChanged"
    mc:Ignorable="d">

    <!--
        ============================================================================
        组态编辑器宿主面板（design.html v2 · 组态画面）
        ============================================================================

        版式照 docs/UI设计基线/app-shell/design.html 的 .scada-view：
          · 顶栏<b>一行 44px</b>：画面/基座 + 新建/删除 + 撤销/重做 ‖ 网格/吸附 + 缩放 + 运行
            （旧版拆成两行、总高 111px，且把"运行画面"挤到第二行最右——设计稿里它是顶栏唯一的实心主按钮）
            面板被拖窄到一排排不下时，顶栏<b>自动折成两行</b>（见下方 WrapPanel 的注释，2026-10-21）
          · <b>没有常驻格式栏</b>：v2 把它改成"选中图元时浮出的上下文工具条"（见 SelectionToolbar），
            没选中时那 20 多颗灰按钮不该占一排视觉噪音
          · 画布是<b>浅色工作台</b>（#E9EEF5）+ 居中的画面，不是运行态那层近黑底
          · 左下角浮一枚"缩放 | 画面尺寸"胶囊

        画布本身仍是"模型 → 可视树"的单向渲染，本面板不持有任何图元副本，
        画面属性一律直绑 SelectedPage.*，中转一次就要多订阅一次、多一处漏摘。
        ============================================================================
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  图标字体令牌（DialogIconFont）在 Colors.xaml 里。就地合并的理由见 R22：
                      只写 {StaticResource} 而不自合并，在没有 Application 的断言宿主里会在 XAML
                      解析期抛"找不到资源"（本视图 2026-10-18 的顶栏渲染探针就是这么红的）。  -->
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
                <!--  顶栏两个下拉框走弹窗域那支 DialogCombo（带边框的 28px 小下拉），
                      定义在 Dialog.Input.xaml —— 同一条 R22：用谁就就地合并谁。  -->
                <ResourceDictionary Source="/UI;component/Themes/Dialog/Dialog.Input.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  ============ 顶栏按钮（design.html .scada-btn） ============
                  28px 高、圆角 6、1px #E2E8F0 描边、白底、12px 字、悬停 #F1F5F9。
                  必须自带 Template：不带就等于把外观交给应用级隐式 Button 样式
                  （App.xaml 最后合并 .NET 9 Fluent，实际生效的是 Fluent 那支——
                   实测 21px 高、渐变描边、圆角 5，与设计稿完全不是一套）。  -->
            <Style x:Key="ScadaToolButton" TargetType="Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource ScadaToolbarTextBrush}" />
                <Setter Property="Background" Value="{StaticResource ScadaSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ScadaToolbarBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaToolbarHoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScadaToolbarBorderStrongBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaToolbarPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  只有图标的按钮：正方形格子，内边距 0（否则字形被格子切掉，见 R68）  -->
            <Style
                x:Key="ScadaIconButton"
                BasedOn="{StaticResource ScadaToolButton}"
                TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!--  主按钮（运行画面）：实心主色 + 白字，顶栏里唯一的实心块  -->
            <Style
                x:Key="ScadaPrimaryButton"
                BasedOn="{StaticResource ScadaToolButton}"
                TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ScadaOnAccentTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaPrimaryButtonHoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScadaPrimaryButtonHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  顶栏标签（画面 / 基座）：11px、次要文字色
                  不用 TextBlock 直接写死字号：顶栏里它出现三次，改一次要改三处  -->
            <Style x:Key="ScadaToolbarLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource ScadaToolbarTextBrush}" />
            </Style>

            <!--  顶栏分组竖线：1×16，色同描边  -->
            <Style x:Key="ScadaToolbarSeparator" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Margin" Value="8,0" />
                <Setter Property="Fill" Value="{StaticResource ScadaToolbarBorderBrush}" />
            </Style>

            <!--  顶栏下拉框：DialogCombo 的 28px 版本（设计稿 .scada-select）  -->
            <Style
                x:Key="ScadaToolbarCombo"
                BasedOn="{StaticResource DialogCombo}"
                TargetType="ComboBox">
                <Setter Property="Height" Value="28" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,0,26,0" />
            </Style>

            <!--  上下文工具条里的图标按钮：27×27、透明底、无描边（design.html .scada-context-toolbar .fmt-btn）  -->
            <Style x:Key="ScadaContextButton" TargetType="Button">
                <Setter Property="Width" Value="27" />
                <Setter Property="Height" Value="27" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{StaticResource DialogIconFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource ScadaToolbarTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaToolbarHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaToolbarPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.32" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--  Ctrl+Z / Ctrl+Y 挂在这一层：只要焦点还在编辑器里（画布、画面下拉）就生效。  -->
    <!--  刻意不挂到窗口级：属性面板里还有一堆文本框，窗口级热键会把它们的文本撤销抢走。  -->
    <!--  InputBindings 不在可视树上，但 WPF 会给它一个继承上下文，所以这里的 Binding 能取到 DataContext。  -->
    <UserControl.InputBindings>
        <KeyBinding
            Key="Z"
            Command="{Binding UndoCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Y"
            Command="{Binding RedoCommand}"
            Modifiers="Ctrl" />
        <!--  复制 / 粘贴 / 再制也挂这一层：它们读的是"选中集合"、写的是当前画面，  -->
        <!--  是编辑器级语义，和 Delete / 方向键那种"画布级"（挂在 ScadaCanvas 上）不同域。  -->
        <KeyBinding
            Key="C"
            Command="{Binding CopyCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="V"
            Command="{Binding PasteCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D"
            Command="{Binding DuplicateCommand}"
            Modifiers="Ctrl" />
    </UserControl.InputBindings>

    <Grid Background="{StaticResource ScadaPanelBackgroundBrush}">
        <Grid.RowDefinitions>
            <!--  顶栏：一行 44px（design.html .scada-top）；排不下时自动折行，所以是 Auto + MinHeight  -->
            <RowDefinition Height="Auto" MinHeight="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ====================  顶栏：画面/基座 · 编辑 · 取景 · 运行  ====================  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource ScadaToolbarBackgroundBrush}"
            BorderBrush="{StaticResource ScadaToolbarBorderBrush}"
            BorderThickness="0,0,0,1">
            <!--
                宽屏一行、窄屏自动折行（2026-10-21 真机反馈：面板被拖窄时右侧一整排按钮被推到视口外）。

                旧写法是"一行 + 横向滚动条"：滚动条在 44px 的顶栏里只剩几个像素高，几乎看不见，
                被滚出去的「适应 / 1:1 / 运行画面」等于不存在。折行至少让每颗按钮都露在脸上。

                折行粒度是"组"：左组（画面/基座 + 新建/删除 + 撤销/重做）与右组（网格/吸附 + 缩放 + 运行）
                各是一个 WrapPanel，排不进一行时右组<b>整组</b>掉到第二行——逐个按钮折会掉出孤立的一颗，
                读起来像排版事故。两组都带 MaxWidth（由 UpdateToolbarLayout 按可用宽度现设）：
                连"一组自己都放不下"的极端窄宽度下，组内按钮再各自折行，任何宽度都不裁切。

                左右两组的间距由 ToolbarSpacer 撑开（宽度现算）：算出来是 0 就说明本行排不下，
                右组自然折到第二行。
            -->
            <WrapPanel
                x:Name="ToolbarPanel"
                Margin="10,0"
                VerticalAlignment="Center"
                SizeChanged="OnToolbarSizeChanged">

                <!--  左组：画面选择 + 文档级动作  -->
                <WrapPanel
                    x:Name="ToolbarLeftGroup"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" Style="{StaticResource ScadaToolbarLabel}" Text="画面" />
                    <!--  IsSynchronizedWithCurrentItem=False：选中项只由 SelectedPage 这条绑定决定。  -->
                    <!--  默认值在 ObservableCollection 上会被共享的 CollectionView 当前项牵着走，  -->
                    <!--  换方案时"谁覆盖谁"变得不确定，这里显式关掉，路径只剩一条。  -->
                    <ComboBox
                        x:Name="PageSelector"
                        Width="150"
                        VerticalAlignment="Center"
                        Selector.IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding Pages}"
                        SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                        Style="{StaticResource ScadaToolbarCombo}">
                        <!--  用 ItemTemplate 而不是 DisplayMemberPath：DialogCombo 的模板靠
                              SelectionBoxItemTemplate 渲染收起态，DisplayMemberPath 那条路在这支模板上
                              不生效（实测收起态显示成类型全名 VisionMaster.Scada.ScadaPage）。  -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!--  基座多选菜单：一页可以同时叠多只基座（公共标题栏 + 公共底栏…）。
                          勾选直接回写文档的引用列表，顺序 = 文档 BasePages 的顺序（靠前的在下面）。
                          仍然置灰基座页自身：基座不能再引用基座（一层限制）。  -->
                    <TextBlock
                        Margin="10,0,6,0"
                        Style="{StaticResource ScadaToolbarLabel}"
                        Text="基座" />
                    <Button
                        x:Name="BasePageSelector"
                        Width="130"
                        VerticalAlignment="Center"
                        Click="OnDropDownMenuClick"
                        IsEnabled="{Binding CanSelectBasePage}"
                        Style="{StaticResource ScadaToolButton}"
                        ToolTip="本页引用的基座（公共层，可多选）；勾选顺序按基座列表，靠前的压在下面">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                MaxWidth="100"
                                VerticalAlignment="Center"
                                Text="{Binding BasePageSummary}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding BasePageSummary}" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="9"
                                Text="▾" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Command="{Binding ClearBasePagesCommand}" Header="（无基座）" />
                                <Separator />
                                <ItemsControl ItemsSource="{Binding BasePageSelections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Margin="10,4"
                                                Content="{Binding Name}"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Rectangle Style="{StaticResource ScadaToolbarSeparator}" />

                    <!--  新建：主按钮 = 新建画面（一次点击，现场最常用的动作），
                          右侧 ▾ = 更多新建方式（新建基座）。
                          两个并排的文字按钮（新建 / 新建基座）在顶栏里读起来像"同一件事的两个说法"，
                          而"新建基座"是低频动作，不该占常驻按钮位。  -->
                    <Button
                        Command="{Binding AddPageCommand}"
                        Style="{StaticResource ScadaToolButton}"
                        ToolTip="新建画面（默认沿用当前页的基座）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="11"
                                Text="&#xF067;" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="新建" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NewMenuButton"
                        Margin="2,0,0,0"
                        Padding="0"
                        Click="OnDropDownMenuClick"
                        Style="{StaticResource ScadaIconButton}"
                        ToolTip="更多新建方式：新建基座（跨页公共层）">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="10"
                            Text="&#xF0D7;" />
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Command="{Binding AddPageCommand}" Header="新建画面" />
                                <MenuItem Command="{Binding AddPopupPageCommand}" Header="新建弹窗页（特殊画面）" />
                                <MenuItem Command="{Binding AddBasePageCommand}" Header="新建基座（跨页公共层）" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!--  删除改成图标按钮：顶栏里三个文字按钮（新建 / 新建基座 / 删除）并列，
                          最容易被误点的恰是"删除"，图标 + 悬停说明能把它从视觉重心上降下来。  -->
                    <Button
                        Margin="2,0,0,0"
                        Command="{Binding RemovePageCommand}"
                        Style="{StaticResource ScadaIconButton}"
                        ToolTip="删除当前画面（可撤销）">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Text="&#xF1F8;" />
                    </Button>

                    <Rectangle Style="{StaticResource ScadaToolbarSeparator}" />

                    <!--  撤销/重做与"画面"并排而不是挤进取景组：它覆盖的不只是画布上的改动，
                          还包括新建/删除画面、改图元属性——是"文档级"的操作，不是取景工具。
                          图标走 App.xaml 的图标字体（Font Awesome 6 Pro Solid 的旋转箭头），
                          文字单独一个 TextBlock：图标字体里没有中文字形，混在一个 TextBlock 里会掉字。  -->
                    <Button
                        Command="{Binding UndoCommand}"
                        Style="{StaticResource ScadaToolButton}"
                        ToolTip="{Binding UndoLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="12"
                                Text="&#xF0E2;" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="撤销" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="2,0,0,0"
                        Command="{Binding RedoCommand}"
                        Style="{StaticResource ScadaToolButton}"
                        ToolTip="{Binding RedoLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="12"
                                Text="&#xF01E;" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="重做" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!--  撑开左右两组的弹性空白：宽度由 UpdateToolbarLayout 按可用宽度现算。
                      算出来是 0 就说明本行排不下，右组自然折到第二行。  -->
                <Border x:Name="ToolbarSpacer" Width="0" />

                <!--  右组：设计辅助 + 取景 + 运行  -->
                <WrapPanel
                    x:Name="ToolbarRightGroup"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  网格与吸附是画面属性（落盘），所以绑到 SelectedPage 上双向写回模型  -->
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="网格"
                        FontSize="11"
                        Foreground="{StaticResource ScadaToolbarTextBrush}"
                        IsChecked="{Binding SelectedPage.ShowGrid, Mode=TwoWay}" />
                    <CheckBox
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="吸附"
                        FontSize="11"
                        Foreground="{StaticResource ScadaToolbarTextBrush}"
                        IsChecked="{Binding SelectedPage.SnapToGrid, Mode=TwoWay}" />

                    <Rectangle Style="{StaticResource ScadaToolbarSeparator}" />

                    <Button
                        Click="OnZoomOut"
                        Content="&#xF068;"
                        FontFamily="{StaticResource DialogIconFont}"
                        Style="{StaticResource ScadaIconButton}"
                        ToolTip="缩小" />
                    <!--  缩放倍率只是取景器状态，绑画布自己的 DP，不进视图模型  -->
                    <TextBlock
                        Width="40"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource ScadaToolbarTextBrush}"
                        Text="{Binding Zoom, ElementName=Canvas, StringFormat=P0, FallbackValue=100%}"
                        TextAlignment="Center" />
                    <Button
                        Click="OnZoomIn"
                        Content="&#xF067;"
                        FontFamily="{StaticResource DialogIconFont}"
                        Style="{StaticResource ScadaIconButton}"
                        ToolTip="放大" />
                    <Button
                        Margin="6,0,0,0"
                        Click="OnFitToScreen"
                        Content="适应"
                        Style="{StaticResource ScadaToolButton}"
                        ToolTip="整页缩放到可视范围" />
                    <Button
                        Margin="2,0,0,0"
                        Click="OnActualSize"
                        Content="1:1"
                        Style="{StaticResource ScadaToolButton}"
                        ToolTip="按 100% 显示" />

                    <Rectangle Style="{StaticResource ScadaToolbarSeparator}" />

                    <!--  运行入口：顶栏唯一的实心主按钮。走命令而不走 code-behind，
                          因为置灰条件（有没有可跑的画面）只有视图模型知道  -->
                    <Button
                        Command="{Binding RunPageCommand}"
                        Style="{StaticResource ScadaPrimaryButton}"
                        ToolTip="按启动画面全屏运行当前方案（不存盘，跑的是内存里这份）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="11"
                                Text="&#xF04B;" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="运行画面" />
                        </StackPanel>
                    </Button>

                    <!--  低频动作收进"…"：报警配置是方案级设置、批量插入模板是建页时的批量动作，
                          都不该与"运行画面"抢常驻按钮位（v2 的减法口径）。  -->
                    <Button
                        x:Name="MoreMenuButton"
                        Margin="6,0,0,0"
                        Padding="0"
                        Click="OnDropDownMenuClick"
                        Style="{StaticResource ScadaIconButton}"
                        ToolTip="更多：报警配置 / 批量插入模板">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Text="&#xF141;" />
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Command="{Binding OpenAlarmConfigCommand}" Header="报警配置…" />
                                <MenuItem Command="{Binding BatchInsertTemplateCommand}" Header="批量插入模板…" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </WrapPanel>
        </Border>

        <!--  ====================  画布工作台  ====================  -->
        <!--  浅色工作台 + 居中的画面：设计稿 .scada-canvas-wrap(#E9EEF5) + .scada-page(白纸)。
              画面自己那块底色仍由 ScadaPage.Background 决定（运行态默认深色），
              工作台这一层只管"画面浮在什么上面"——两者不是一回事。  -->
        <Grid
            x:Name="CanvasHost"
            Grid.Row="1"
            Background="{StaticResource ScadaWorkbenchBrush}"
            ClipToBounds="True">

            <!--  画面底色是落盘的 #AARRGGBB 文本，绑到 Brush 依赖属性上由 WPF 按目标类型的  -->
            <!--  TypeConverter（BrushConverter）自动换算，无需自写转换器：领域层也因此不必引用 WPF。  -->
            <!--  Page 是图层上下文：画布只有 ItemsSource 时只知道"一堆图元"，不知道它们属于哪一页，  -->
            <!--  图层的可见/锁定规则在渲染侧就无从落地。不接这一行，图层开关等于没生效。  -->
            <controls:ScadaCanvas
                x:Name="Canvas"
                AllowDrop="True"
                Background="{StaticResource ScadaWorkbenchBrush}"
                BasePages="{Binding SelectedBasePages}"
                ContextMenuOpening="OnCanvasContextMenuOpening"
                DragOver="OnCanvasDragOver"
                Drop="OnCanvasDrop"
                GridSize="{Binding SelectedPage.GridSize}"
                ImageAssetResolver="{Binding ResolveImageAsset}"
                ItemsSource="{Binding SelectedPage.Elements}"
                Page="{Binding SelectedPage}"
                PageBackground="{Binding SelectedPage.Background}"
                PageBackgroundImage="{Binding SelectedPageBackgroundImage}"
                PageBackgroundOpacity="{Binding SelectedPageBackgroundOpacity}"
                PageBackgroundStretch="{Binding SelectedPageBackgroundStretch}"
                PageBackgroundTile="{Binding SelectedPageBackgroundTile}"
                PageHeight="{Binding SelectedPage.Height}"
                PageWidth="{Binding SelectedPage.Width}"
                SelectedElement="{Binding SelectedElement, Mode=TwoWay}"
                SelectedElements="{Binding SelectedElements, Mode=TwoWay}"
                ShowGrid="{Binding SelectedPage.ShowGrid}"
                SnapToGrid="{Binding SelectedPage.SnapToGrid}">

                <!--  Delete / 方向键挂在画布上：画布在鼠标按下时抢焦点（见 ScadaCanvas.OnPreviewMouseLeftButtonDown），  -->
                <!--  所以"焦点在画面下拉里按方向键"仍然是在切画面，不会被微调抢走——这条只有挂在画布上才成立。  -->
                <!--  CanExecute 为假时 WPF 不消费按键，事件照常往下走，不会把别的控件的方向键吞掉。  -->
                <controls:ScadaCanvas.InputBindings>
                    <KeyBinding Command="{Binding RemoveElementCommand}" Key="Delete" />
                    <KeyBinding
                        Command="{Binding NudgeCommand}"
                        CommandParameter="Left"
                        Key="Left" />
                    <KeyBinding
                        Command="{Binding NudgeCommand}"
                        CommandParameter="Right"
                        Key="Right" />
                    <KeyBinding
                        Command="{Binding NudgeCommand}"
                        CommandParameter="Up"
                        Key="Up" />
                    <KeyBinding
                        Command="{Binding NudgeCommand}"
                        CommandParameter="Down"
                        Key="Down" />
                </controls:ScadaCanvas.InputBindings>

                <!--  图元右键菜单：图层归属 + 叠放次序 + 对齐与分布 + 等尺寸/等间距 + 剪贴板。  -->
                <!--  这里只放一个空壳，菜单项每次弹出时由代码后台按当前选中图元现装（见 OnCanvasContextMenuOpening）——  -->
                <!--  图层候选、勾选态、端点判灰都随用户操作在变，预先建好就得逐个订阅刷新，而"弹出即重建"天然不会过期。  -->
                <!--  FontFamily 用 Colors.xaml 里的图标字体令牌（本视图已就地合并）：菜单项的文字是 Font Awesome 码点，  -->
                <!--  字形从 ContextMenu 往下继承到各 MenuItem（与 FlowListView 的右键菜单同一套写法）。  -->
                <!--  刻意不用 App.xaml 的 Icon：那一档资源在没有 Application 的断言宿主里取不到，  -->
                <!--  整个视图会在 XAML 解析期失败（R22 同族，2026-10-18 顶栏渲染探针实测）。  -->
                <controls:ScadaCanvas.ContextMenu>
                    <ContextMenu FontFamily="{StaticResource DialogIconFont}" />
                </controls:ScadaCanvas.ContextMenu>
            </controls:ScadaCanvas>

            <!--  浮层：位置由代码后台按"选中集合的外接框"与取景器状态现算（见 UpdateSelectionToolbar）。
                  这层 Canvas 自己不参与命中测试（Background 为 null 就不吃鼠标），
                  只有里面那两枚带底色的 Border 会接住点击——所以画布该收的拖拽/框选一个都不会少。  -->
            <Canvas x:Name="Overlay">
                <!--  左下角取景胶囊：缩放倍率 | 画面设计尺寸（design.html .scada-zoom）  -->
                <Border
                    Canvas.Left="12"
                    Canvas.Bottom="10"
                    Padding="8,4"
                    Background="{StaticResource ScadaSurfaceBrush}"
                    BorderBrush="{StaticResource ScadaToolbarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="0.94">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource ScadaToolbarTextBrush}"
                            Text="{Binding Zoom, ElementName=Canvas, StringFormat=P0, FallbackValue=100%}" />
                        <Rectangle
                            Width="1"
                            Height="10"
                            Margin="7,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource ScadaToolbarBorderStrongBrush}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource ScadaToolbarTextBrush}"
                            Text="{Binding SelectedPage.Width, StringFormat={}{0:0}}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource ScadaToolbarTextBrush}"
                            Text=" × " />
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource ScadaToolbarTextBrush}"
                            Text="{Binding SelectedPage.Height, StringFormat={}{0:0}}" />
                    </StackPanel>
                </Border>

                <!--  选中图元的上下文格式工具条（design.html .scada-context-toolbar）。
                      只有 7 颗：对齐三连 + 叠放两连 + "更多"；其余排列命令在"更多"与右键菜单里。
                      没选中时整条收起——这是 v2 相对 v1 最重要的一处减法。  -->
                <Border
                    x:Name="SelectionToolbar"
                    Padding="3"
                    Background="{StaticResource ScadaSurfaceBrush}"
                    BorderBrush="{StaticResource ScadaToolbarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsHitTestVisible="True"
                    Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="18"
                            Direction="270"
                            Opacity="0.16"
                            ShadowDepth="3"
                            Color="{StaticResource ScadaToolbarShadowColor}" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Command="{Binding AlignCommand}"
                            CommandParameter="{x:Static enums:ScadaAlign.Left}"
                            Content="&#xF036;"
                            Style="{StaticResource ScadaContextButton}"
                            ToolTip="左对齐" />
                        <Button
                            Command="{Binding AlignCommand}"
                            CommandParameter="{x:Static enums:ScadaAlign.HorizontalCenter}"
                            Content="&#xF037;"
                            Style="{StaticResource ScadaContextButton}"
                            ToolTip="水平居中" />
                        <Button
                            Command="{Binding AlignCommand}"
                            CommandParameter="{x:Static enums:ScadaAlign.Right}"
                            Content="&#xF038;"
                            Style="{StaticResource ScadaContextButton}"
                            ToolTip="右对齐" />
                        <Rectangle
                            Width="1"
                            Height="16"
                            Margin="3,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource ScadaToolbarBorderBrush}" />
                        <Button
                            Command="{Binding MoveZCommand}"
                            CommandParameter="{x:Static enums:ScadaZMove.ToFront}"
                            Content="&#xF102;"
                            Style="{StaticResource ScadaContextButton}"
                            ToolTip="置于顶层" />
                        <Button
                            Command="{Binding MoveZCommand}"
                            CommandParameter="{x:Static enums:ScadaZMove.Forward}"
                            Content="&#xF062;"
                            Style="{StaticResource ScadaContextButton}"
                            ToolTip="上移一层" />
                        <Rectangle
                            Width="1"
                            Height="16"
                            Margin="3,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource ScadaToolbarBorderBrush}" />
                        <Button
                            x:Name="MoreFormatButton"
                            Click="OnMoreFormatClick"
                            Content="&#xF141;"
                            Style="{StaticResource ScadaContextButton}"
                            ToolTip="更多排列命令（等尺寸 / 等间距 / 对齐网格 / 分布…）" />
                    </StackPanel>
                </Border>
            </Canvas>

            <!--  空态：方案已打开但还没有组态画面。没有这块，用户看到的就是一张纯白画布，
                  会误判成“方案没打开/软件坏了”。  -->
            <Border
                Panel.ZIndex="10"
                Background="{StaticResource ScadaPanelBackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaTextBrush}"
                        Text="当前方案还没有组态画面" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="新建一张画面后，就可以拖入图元开始组态。" />
                    <Button
                        MinWidth="112"
                        Margin="0,18,0,0"
                        Padding="16,7"
                        HorizontalAlignment="Center"
                        Background="{StaticResource DialogAccentBrush}"
                        BorderThickness="0"
                        Command="{Binding AddPageCommand}"
                        Content="新建画面"
                        Foreground="{StaticResource ScadaOnAccentTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
