<UserControl
    x:Class="VisionMaster.Views.ScadaEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VisionMaster.Scada.Controls;assembly=VM.Scada.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:VisionMaster.Scada;assembly=VM.Scada"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="900"
    prism:ViewModelLocator.AutoWireViewModel="True"
    DataContextChanged="OnViewDataContextChanged"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  格式工具栏的图标按钮：只显示图标，文字交给 ToolTip。  -->
        <!--  18 颗按钮若都照顶栏那样写"图标 TextBlock + 文字 TextBlock"，一行绝对放不下；  -->
        <!--  而格式工具栏本来就是"扫一眼图标就懂"的地方，只挂图标是 Word / VS 一路的通行做法。  -->
        <!--  Content 里只有 Font Awesome 码点、没有中文，所以可以整串塞进 Content——  -->
        <!--  顶栏那条"图标与文字必须拆成两个 TextBlock"的规矩，防的是图标字体里没有中文字形。  -->
        <Style x:Key="FormatToolButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#FF303133" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  工具栏分组之间的竖线：宽高色与顶栏那三条一致，两行看着才像同一套东西  -->
        <Style x:Key="ToolSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Fill" Value="#FFDCE0E6" />
        </Style>
    </UserControl.Resources>

    <!--  ==========================================  -->
    <!--  SCADA 组态编辑器宿主面板（S3）  -->
    <!--  这里只做两件事：挑画面（顶栏）+ 把画面的模型交给画布（ScadaCanvas）。  -->
    <!--  画布是"模型 → 可视树"的单向渲染，因此本面板不持有任何图元的副本，  -->
    <!--  画面属性也一律直绑 SelectedPage.*，中转一次就要多订阅一次、多一处漏摘。  -->
    <!--  ==========================================  -->

    <!--  Ctrl+Z / Ctrl+Y 挂在这一层：只要焦点还在编辑器里（画布、画面下拉）就生效。  -->
    <!--  刻意不挂到窗口级：属性面板里还有一堆文本框，窗口级热键会把它们的文本撤销抢走。  -->
    <!--  InputBindings 不在可视树上，但 WPF 会给它一个继承上下文，所以这里的 Binding 能取到 DataContext。  -->
    <UserControl.InputBindings>
        <KeyBinding
            Key="Z"
            Command="{Binding UndoCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="Y"
            Command="{Binding RedoCommand}"
            Modifiers="Ctrl" />
        <!--  复制 / 粘贴 / 再制也挂这一层：它们读的是"选中集合"、写的是当前画面，  -->
        <!--  是编辑器级语义，和 Delete / 方向键那种"画布级"（挂在 ScadaCanvas 上）不同域。  -->
        <KeyBinding
            Key="C"
            Command="{Binding CopyCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="V"
            Command="{Binding PasteCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="D"
            Command="{Binding DuplicateCommand}"
            Modifiers="Ctrl" />
    </UserControl.InputBindings>

    <Grid Background="#FFF7F8FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ====================  顶栏：画面选择 + 取景工具  ====================  -->
        <Border
            Grid.Row="0"
            Background="#FFF5F7FA"
            BorderBrush="#FFDCE0E6"
            BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">

                <!--  左侧：当前编辑哪一页  -->
                <StackPanel
                    Margin="8,0"
                    HorizontalAlignment="Left"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FF606266"
                        Text="画面" />
                    <!--  IsSynchronizedWithCurrentItem=False：选中项只由 SelectedPage 这条绑定决定。  -->
                    <!--  默认值在 ObservableCollection 上会被共享的 CollectionView 当前项牵着走，  -->
                    <!--  换方案时"谁覆盖谁"变得不确定，这里显式关掉，路径只剩一条。  -->
                    <ComboBox
                        x:Name="PageSelector"
                        Width="160"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Name"
                        Selector.IsSynchronizedWithCurrentItem="False"
                        ItemsSource="{Binding Pages}"
                        SelectedItem="{Binding SelectedPage, Mode=TwoWay}" />
                    <Button
                        Margin="6,0,0,0"
                        Padding="8,2"
                        Command="{Binding AddPageCommand}"
                        Content="新建"
                        ToolTip="在当前方案里新建一个画面" />
                    <Button
                        Margin="4,0,0,0"
                        Padding="8,2"
                        Command="{Binding RemovePageCommand}"
                        Content="删除"
                        ToolTip="删除当前画面" />

                    <!--  撤销/重做与"画面"并排而不是挤进取景组：它覆盖的不只是画布上的改动，
                          还包括新建/删除画面、改图元属性——是"文档级"的操作，不是取景工具。
                          图标走 App.xaml 的图标字体（Font Awesome 6 Pro Solid 的旋转箭头），
                          文字单独一个 TextBlock：图标字体里没有中文字形，混在一个 TextBlock 里会掉字。  -->
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="12,0"
                        Fill="#FFDCE0E6" />
                    <Button
                        Padding="8,2"
                        Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Text="&#xF0E2;" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Text="撤销" />
                        </StackPanel>
                    </Button>
                    <Button
                        Margin="4,0,0,0"
                        Padding="8,2"
                        Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Text="&#xF01E;" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Text="重做" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  右侧：设计辅助与取景  -->
                <StackPanel
                    Margin="8,0"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <!--  网格与吸附是画面属性（落盘），所以绑到 SelectedPage 上双向写回模型  -->
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="网格"
                        IsChecked="{Binding SelectedPage.ShowGrid, Mode=TwoWay}" />
                    <CheckBox
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="吸附"
                        IsChecked="{Binding SelectedPage.SnapToGrid, Mode=TwoWay}" />
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="12,0"
                        Fill="#FFDCE0E6" />
                    <Button
                        Padding="6,2"
                        Click="OnZoomOut"
                        Content="－"
                        ToolTip="缩小" />
                    <!--  缩放倍率只是取景器状态，绑画布自己的 DP，不进视图模型  -->
                    <TextBlock
                        Width="46"
                        Margin="4,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FF606266"
                        Text="{Binding Zoom, ElementName=Canvas, StringFormat=P0, FallbackValue=100%}"
                        TextAlignment="Center" />
                    <Button
                        Padding="6,2"
                        Click="OnZoomIn"
                        Content="＋"
                        ToolTip="放大" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="6,2"
                        Click="OnFitToScreen"
                        Content="适应"
                        ToolTip="整页缩放到可视范围" />
                    <Button
                        Margin="4,0,0,0"
                        Padding="6,2"
                        Click="OnActualSize"
                        Content="1:1"
                        ToolTip="按 100% 显示" />

                    <!--  运行入口与"设计辅助"隔开：前者是交付动作，后者是编辑动作，不该看着像一类  -->
                    <Rectangle
                        Width="1"
                        Height="16"
                        Margin="12,0"
                        Fill="#FFDCE0E6" />
                    <!--  绿色实心三角是组态软件的通用语：跑起来。走命令而不走 code-behind，  -->
                    <!--  因为置灰条件（有没有可跑的画面）只有视图模型知道  -->
                    <Button
                        Padding="8,2"
                        Command="{Binding RunPageCommand}"
                        Content="▶ 运行画面"
                        Foreground="#FF1B7F3B"
                        ToolTip="按启动画面全屏运行当前方案（不存盘，跑的是内存里这份）" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  ====================  格式工具栏（r5）  ====================  -->
        <!--  排列类动作从右键菜单搬上来：在菜单里用一次要走"选中图元 → 右键 → 展开子菜单"三步，  -->
        <!--  而对齐 / 等尺寸 / 等间距是编辑时反复来回用的动作，摆成一行才够手快。  -->
        <!--  这里只搬<b>排列类</b>（对齐分布 / 等尺寸 / 等间距 / 对齐网格 / 叠放次序）：  -->
        <!--  复制粘贴删除那几项属于"改画面内容"，留在右键菜单与快捷键上，不与"换个摆法"挤一排。  -->
        <!--  每条命令都带 CanExecute（见 ScadaEditorViewModel.RefreshSelectionCommands），  -->
        <!--  所以"没选中 / 选得不够多"时按钮自己会灰掉，这里不写任何可用性判断。  -->
        <Border
            Grid.Row="1"
            Background="#FFFAFBFC"
            BorderBrush="#FFDCE0E6"
            BorderThickness="0,0,0,1">
            <!--  横向可滚：面板被 AvalonDock 拖窄时，宁可出现一条滚动条，  -->
            <!--  也不要让右边那几颗按钮被裁掉——被裁掉的按钮，用户根本不知道它存在过。  -->
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,4" Orientation="Horizontal">

                    <!--  对齐与分布：六种对齐 + 两种分布，顺序与右键菜单的 AlignOrder 一致。  -->
                    <!--  CommandParameter 传枚举常量（与 FlowListView 传 FlowAction 同一写法）：  -->
                    <!--  8 颗按钮共用一条 AlignCommand，靠参数分流，不必在视图模型里开 8 个属性。  -->
                    <Button
                        Command="{Binding AlignCommand}"
                        CommandParameter="{x:Static enums:ScadaAlign.Left}"
                        Content="&#xF036;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="左对齐" />
                    <Button
                        Command="{Binding AlignCommand}"
                        CommandParameter="{x:Static enums:ScadaAlign.HorizontalCenter}"
                        Content="&#xF037;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="水平居中" />
                    <Button
                        Command="{Binding AlignCommand}"
                        CommandParameter="{x:Static enums:ScadaAlign.Right}"
                        Content="&#xF038;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="右对齐" />
                    <Button
                        Command="{Binding AlignCommand}"
                        CommandParameter="{x:Static enums:ScadaAlign.Top}"
                        Content="&#xF341;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="顶对齐" />
                    <Button
                        Command="{Binding AlignCommand}"
                        CommandParameter="{x:Static enums:ScadaAlign.VerticalCenter}"
                        Content="&#xF034;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="垂直居中" />
                    <Button
                        Command="{Binding AlignCommand}"
                        CommandParameter="{x:Static enums:ScadaAlign.Bottom}"
                        Content="&#xF33D;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="底对齐" />
                    <Button
                        Command="{Binding AlignCommand}"
                        CommandParameter="{x:Static enums:ScadaAlign.DistributeHorizontal}"
                        Content="&#xF337;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="水平等分（两端不动，把间隙摊匀）" />
                    <Button
                        Command="{Binding AlignCommand}"
                        CommandParameter="{x:Static enums:ScadaAlign.DistributeVertical}"
                        Content="&#xF338;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="垂直等分（两端不动，把间隙摊匀）" />

                    <Rectangle Style="{StaticResource ToolSeparator}" />

                    <!--  等尺寸：基准一律取选中集合里最大的那个（宽高各自取最大），见 ScadaSizeMatch。  -->
                    <Button
                        Command="{Binding MatchSizeCommand}"
                        CommandParameter="{x:Static enums:ScadaSizeMatch.Width}"
                        Content="&#xE4BA;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="等宽（以最宽的那个为准）" />
                    <Button
                        Command="{Binding MatchSizeCommand}"
                        CommandParameter="{x:Static enums:ScadaSizeMatch.Height}"
                        Content="&#xF07D;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="等高（以最高的那个为准）" />
                    <Button
                        Command="{Binding MatchSizeCommand}"
                        CommandParameter="{x:Static enums:ScadaSizeMatch.Both}"
                        Content="&#xF424;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="等大小（宽高各自取最大，等价于先等宽再等高）" />

                    <Rectangle Style="{StaticResource ToolSeparator}" />

                    <!--  等间距：数值框在前、两颗方向按钮在后，读起来就是"按这个间距，水平排 / 垂直排"。  -->
                    <!--  绑定的 UpdateSourceTrigger 用默认的 LostFocus（这里显式写出来，因为它是要紧事）：  -->
                    <!--  点按钮时文本框先失焦、值先写回视图模型，命令才执行——所以"改完数字直接点按钮"一定带上新值。  -->
                    <!--  若改成 PropertyChanged，用户想输 "20" 时敲下 "2" 那一刻就会按 2 像素排一次，画面乱跳。  -->
                    <TextBlock
                        Margin="2,0,2,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FF606266"
                        Text="间距" />
                    <TextBox
                        Width="46"
                        Height="22"
                        Margin="0,0,2,0"
                        VerticalContentAlignment="Center"
                        Text="{Binding SpacingGap, UpdateSourceTrigger=LostFocus}"
                        TextAlignment="Center"
                        ToolTip="等间距时，相邻两个图元之间留多少像素（可填 0 让它们边贴边）" />
                    <Button
                        Command="{Binding SpaceCommand}"
                        CommandParameter="{x:Static enums:ScadaSpacing.Horizontal}"
                        Content="&#xF7A5;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="水平等间距（第一个不动，其余按上面的像素值往右排）" />
                    <Button
                        Command="{Binding SpaceCommand}"
                        CommandParameter="{x:Static enums:ScadaSpacing.Vertical}"
                        Content="&#xF7A4;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="垂直等间距（第一个不动，其余按上面的像素值往下排）" />

                    <Rectangle Style="{StaticResource ToolSeparator}" />

                    <!--  对齐网格：把左上角吸到最近的格点。刻意不看顶栏那个"吸附"开关——  -->
                    <!--  那个开关管的是"拖动时吸不吸"，而这是一次显式命令（见 TrySnapElementsToGrid）。  -->
                    <Button
                        Command="{Binding SnapElementsToGridCommand}"
                        Content="&#xF84C;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="对齐网格（左上角吸到最近格点，与「吸附」开关无关）" />

                    <Rectangle Style="{StaticResource ToolSeparator}" />

                    <!--  叠放次序：四颗按钮与右键菜单的 ZMoveOrder 同序（从最前到最底）。  -->
                    <!--  已到端点的那一颗由 CanMoveSelectedZ 判灰，所以"置顶"按到最上会自己灰掉。  -->
                    <Button
                        Command="{Binding MoveZCommand}"
                        CommandParameter="{x:Static enums:ScadaZMove.ToFront}"
                        Content="&#xF102;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="置于顶层" />
                    <Button
                        Command="{Binding MoveZCommand}"
                        CommandParameter="{x:Static enums:ScadaZMove.Forward}"
                        Content="&#xF062;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="上移一层" />
                    <Button
                        Command="{Binding MoveZCommand}"
                        CommandParameter="{x:Static enums:ScadaZMove.Backward}"
                        Content="&#xF063;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="下移一层" />
                    <Button
                        Command="{Binding MoveZCommand}"
                        CommandParameter="{x:Static enums:ScadaZMove.ToBack}"
                        Content="&#xF103;"
                        Style="{StaticResource FormatToolButton}"
                        ToolTip="置于底层" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  ====================  画布宿主  ====================  -->
        <!--  画面底色是落盘的 #AARRGGBB 文本，绑到 Brush 依赖属性上由 WPF 按目标类型的  -->
        <!--  TypeConverter（BrushConverter）自动换算，无需自写转换器：领域层也因此不必引用 WPF。  -->
        <!--  Page 是图层上下文：画布只有 ItemsSource 时只知道"一堆图元"，不知道它们属于哪一页，  -->
        <!--  图层的可见/锁定规则在渲染侧就无从落地。不接这一行，图层开关等于没生效。  -->
        <controls:ScadaCanvas
            x:Name="Canvas"
            Grid.Row="2"
            AllowDrop="True"
            ContextMenuOpening="OnCanvasContextMenuOpening"
            DragOver="OnCanvasDragOver"
            Drop="OnCanvasDrop"
            GridSize="{Binding SelectedPage.GridSize}"
            ItemsSource="{Binding SelectedPage.Elements}"
            Page="{Binding SelectedPage}"
            PageBackground="{Binding SelectedPage.Background}"
            PageHeight="{Binding SelectedPage.Height}"
            PageWidth="{Binding SelectedPage.Width}"
            SelectedElement="{Binding SelectedElement, Mode=TwoWay}"
            SelectedElements="{Binding SelectedElements, Mode=TwoWay}"
            ShowGrid="{Binding SelectedPage.ShowGrid}"
            SnapToGrid="{Binding SelectedPage.SnapToGrid}">

            <!--  Delete / 方向键挂在画布上：画布在鼠标按下时抢焦点（见 ScadaCanvas.OnPreviewMouseLeftButtonDown），  -->
            <!--  所以"焦点在画面下拉里按方向键"仍然是在切画面，不会被微调抢走——这条只有挂在画布上才成立。  -->
            <!--  CanExecute 为假时 WPF 不消费按键，事件照常往下走，不会把别的控件的方向键吞掉。  -->
            <controls:ScadaCanvas.InputBindings>
                <KeyBinding Command="{Binding RemoveElementCommand}" Key="Delete" />
                <KeyBinding
                    Command="{Binding NudgeCommand}"
                    CommandParameter="Left"
                    Key="Left" />
                <KeyBinding
                    Command="{Binding NudgeCommand}"
                    CommandParameter="Right"
                    Key="Right" />
                <KeyBinding
                    Command="{Binding NudgeCommand}"
                    CommandParameter="Up"
                    Key="Up" />
                <KeyBinding
                    Command="{Binding NudgeCommand}"
                    CommandParameter="Down"
                    Key="Down" />
            </controls:ScadaCanvas.InputBindings>

            <!--  图元右键菜单：图层归属 + 叠放次序 + 对齐与分布。  -->
            <!--  这里只放一个空壳，菜单项每次弹出时由代码后台按当前选中图元现装（见 OnCanvasContextMenuOpening）——  -->
            <!--  图层候选、勾选态、端点判灰都随用户操作在变，预先建好就得逐个订阅刷新，而"弹出即重建"天然不会过期。  -->
            <!--  FontFamily 用 App.xaml 里的图标字体：菜单项的文字是 Font Awesome 码点，  -->
            <!--  字形从 ContextMenu 往下继承到各 MenuItem（与 FlowListView 的右键菜单同一套写法）。  -->
            <controls:ScadaCanvas.ContextMenu>
                <ContextMenu FontFamily="{StaticResource Icon}" />
            </controls:ScadaCanvas.ContextMenu>
        </controls:ScadaCanvas>
    </Grid>
</UserControl>
