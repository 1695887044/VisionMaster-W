<Window
    x:Class="VisionMaster.Views.DebugHitWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:enums="clr-namespace:VisionMaster;assembly=VM.Core"
    Title="{Binding Header}"
    Width="430"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Background="#FFFFFF"
    FontFamily="Microsoft YaHei">

    <!--  ==========================================
          DWV 第 1 期：调试命中窗（非模态）。
          三个运行按钮直接绑 Shell 的 ExecutionCommand（CommandParameter 区分动作）——
          CanExecute 与主界面按钮共用同一条互锁矩阵，本窗口不写任何执行逻辑。
          ==========================================  -->
    <Window.Resources>
        <!--  主按钮（继续 = 建议的下一步）  -->
        <Style x:Key="HitPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#409EFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  次按钮（单步 / 停止 / 打开模块参数）  -->
        <Style x:Key="HitSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="BorderBrush" Value="#DCDFE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECF5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题：「断点命中」/「单步暂停」  -->
        <StackPanel Orientation="Horizontal">
            <TextBlock
                FontFamily="{StaticResource Icon}"
                FontSize="15"
                Foreground="#E6A23C"
                Text="&#xf111;" />
            <TextBlock
                Margin="8,0,0,0"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#303133"
                Text="{Binding Header}" />
        </StackPanel>

        <!--  命中上下文：流程 / 步骤  -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock
                FontSize="12.5"
                Foreground="#606266"
                Text="{Binding FlowName, StringFormat='流程：{0}'}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding FlowName}" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="12.5"
                Foreground="#606266"
                Text="{Binding StepName, StringFormat='步骤：{0}'}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding StepName}" />
        </StackPanel>

        <!--  动作行：继续 / 单步 / 停止 / 打开模块参数（全部复用 Shell 既有命令）  -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static enums:ExecutionAction.Resume}"
                    Content="继续"
                    Style="{StaticResource HitPrimaryButton}"
                    ToolTip="放行全部暂停中的调试会话（快捷键 F5）" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static enums:ExecutionAction.StepOnce}"
                    Content="单步"
                    Style="{StaticResource HitSecondaryButton}"
                    ToolTip="执行一个节点后再次停住（快捷键 F10；仅当恰好一个会话暂停时可用）" />
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static enums:ExecutionAction.Stop}"
                    Content="停止"
                    Style="{StaticResource HitSecondaryButton}" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Command="{Binding OpenParametersCommand}"
                Content="打开模块参数"
                Style="{StaticResource HitSecondaryButton}"
                ToolTip="查看命中步骤的参数（与流程栏「模块参数」同一入口）" />
        </Grid>

        <!--  「本次运行不再提示」：断点/单步照常停，只是不再弹本窗；随新一轮运行自动复位  -->
        <CheckBox
            Grid.Row="3"
            Margin="0,12,0,0"
            Content="本次运行不再提示"
            FontSize="12"
            Foreground="#909399"
            IsChecked="{Binding SuppressThisRun, Mode=TwoWay}" />
    </Grid>
</Window>
