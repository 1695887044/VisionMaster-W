<UserControl
    x:Class="VisionMaster.Views.ModuleOutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:VisionMaster.Helpers"
    xmlns:local="clr-namespace:VisionMaster.Views"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:VisionMaster.ViewModels"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="10,12,10,8"
            Background="#F8F9FA"
            BorderBrush="#EBEEF5"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="12,0,8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="#909399"
                    Text="添加监视:" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox
                        x:Name="SearchTextBox"
                        Width="250"
                        Height="34"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        Foreground="#303133"
                        Tag="{Binding}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="输入算子名或变量名进行搜索，按Enter添加监视">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddWatchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Popup
                        x:Name="SuggestionPopup"
                        Width="{Binding ElementName=SearchTextBox, Path=ActualWidth}"
                        IsOpen="{Binding IsDropDownOpen}"
                        Placement="Bottom"
                        PopupAnimation="Fade"
                        StaysOpen="False">
                        <Border
                            MaxHeight="200"
                            Background="White"
                            BorderBrush="#EBEEF5"
                            BorderThickness="1">
                            <ListView
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding SuggestedItems}"
                                SelectedItem="{Binding SelectedSuggestion}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,8" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#ECF5FF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#606266"
                                            Text="{Binding DisplayText}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Popup>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Width="80"
                    Height="28"
                    Margin="8,3,12,3"
                    Background="#F56C6C"
                    BorderThickness="0"
                    Command="{Binding ClearAllCommand}"
                    Content="清空全部"
                    Foreground="White"
                    ToolTip="清空所有监视项">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            Padding="8,4"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E85D5D" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <StackPanel
            Grid.Row="1"
            Margin="10,0,10,8"
            Orientation="Horizontal">
            <Button
                Height="28"
                Margin="0,0,8,0"
                Padding="12,0"
                Background="#67C23A"
                BorderThickness="0"
                Command="{Binding QuickAddCommand}"
                CommandParameter="Global.All"
                Content="全局变量"
                Foreground="White"
                ToolTip="快速添加所有全局变量">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Padding="12,4"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#5EB83A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button
                Height="28"
                Margin="0,0,8,0"
                Padding="12,0"
                Background="#409EFF"
                BorderThickness="0"
                Content="全部输入"
                Foreground="White"
                ToolTip="添加所有输入端口">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Padding="12,4"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3690E6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button
                Height="28"
                Padding="12,0"
                Background="#E6A23C"
                BorderThickness="0"
                Content="全部输出"
                Foreground="White"
                ToolTip="添加所有输出端口">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Padding="12,4"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D99332" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <ListBox
            Grid.Row="2"
            Margin="10"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding DisplayPorts}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F7FA" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#409EFF"
                                Text="{Binding DisplayName}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#909399"
                                Text="类型: " />
                            <TextBlock
                                FontSize="11"
                                Foreground="#909399"
                                Text="{Binding TypeName}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#E6A23C"
                            Text="{Binding DisplayValue}" />

                        <Border
                            Grid.Column="2"
                            Padding="6,2"
                            HorizontalAlignment="Center"
                            Background="#F4F4F5"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="11"
                                Foreground="#909399"
                                Text="{Binding Direction}" />
                        </Border>

                        <Button
                            Grid.Column="3"
                            Width="20"
                            Height="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            ToolTip="移除监视">
                            <TextBlock
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="#F56C6C"
                                Text="&#xf1f8;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
            Grid.Row="3"
            Margin="10,8,10,12"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="#909399"
                Text="监视项:" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="#409EFF"
                Text="{Binding DisplayPorts.Count}" />
        </StackPanel>
    </Grid>
</UserControl>