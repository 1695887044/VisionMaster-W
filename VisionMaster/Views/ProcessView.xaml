<UserControl
    x:Class="VisionMaster.Views.ProcessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VisionMaster.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:helpers="clr-namespace:VisionMaster.Helpers"
    xmlns:local="clr-namespace:VisionMaster.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:enums="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:models="clr-namespace:VisionMaster.Models;assembly=VM.Core"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ui:BindingProxy x:Key="ModuleData" Data="{Binding}" />

        <!--  分类名 → 分类专属色画刷（ToolboxCategoryVisuals.BrushFor）：算子行图标按分类上色；
              分类为 null / 未知时该转换器已回落中性灰（老方案或程序创建的步骤可能没带 Category）。  -->
        <helpers:CategoryAccentBrushConverter x:Key="CategoryAccentBrushConverter" />
        <helpers:CategorySoftBrushConverter x:Key="CategorySoftBrushConverter" />
        <helpers:CategoryBorderBrushConverter x:Key="CategoryBorderBrushConverter" />

        <!--  ==========================================  -->
        <!--  🎯 拖拽浮层：流程栏内部拖动（步骤 / 分支卡片）  -->
        <!--  视觉与工具箱共用 VisionMaster\Controls\DragGhostCard.xaml（设计基线 v2）。  -->
        <!--  树里混着 StepModel 与 StepCollection 两种条目，gong 的 DragAdornerTemplate  -->
        <!--  是"一个源一份模板"——用选择器按数据类型分派，否则分支卡片会显示成空卡片。  -->
        <!--  ==========================================  -->
        <DataTemplate x:Key="StepDragGhostTemplate">
            <controls:DragGhostCard
                Category="{Binding Category}"
                Icon="{Binding Icon}"
                Title="{Binding StepName}" />
        </DataTemplate>

        <DataTemplate x:Key="BranchDragGhostTemplate">
            <controls:DragGhostCard
                Category="分支"
                Icon="&#xf126;"
                Title="{Binding DisplayName}" />
        </DataTemplate>

        <helpers:DragGhostTemplateSelector
            x:Key="StepDragGhostSelector"
            BranchTemplate="{StaticResource BranchDragGhostTemplate}"
            StepTemplate="{StaticResource StepDragGhostTemplate}" />

        <!--  ==========================================  -->
        <!--  🎨 流程栏行容器（v2：整行铺满，悬停/选中用底色表达）  -->
        <!--  ==========================================  -->
        <Style x:Key="ModernStepContainerStyle" TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  ZIndex=2：分组/分支的整行色条会向左延伸到展开箭头下方（v2 的 section bar），
                                          箭头必须压在色条之上，否则被数据模板的不透明底色盖住。  -->
                                    <ToggleButton
                                        x:Name="Expander"
                                        Panel.ZIndex="2"
                                        ClickMode="Press"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{StaticResource ExpandCollapseToggleStyle}" />

                                    <!--  不再 Left 对齐：v2 的行要铺满整行（底色/色条横贯）。  -->
                                    <ContentPresenter
                                        x:Name="PART_Header"
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        ContentSource="Header" />

                                    <!--  选中指示竖条  -->
                                    <Border
                                        x:Name="SelBar"
                                        Width="3"
                                        Height="22"
                                        Margin="1,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource FlowCanvasNodeSelectedBorderBrush}"
                                        CornerRadius="1.5"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <!--  子项区：16px 缩进 + 左缘 1px 层级引导线（v2 把颜色提到 #E2E8F0，原 #EEF2F7 对白底仅 1.12:1）。
                                  线不占内容位：缩进 15 + 线宽 1 = 子项仍停在原来的 16px 上。  -->
                            <Border
                                Grid.Row="1"
                                Margin="15,0,0,0"
                                BorderBrush="{StaticResource DialogBorderBrush}"
                                BorderThickness="1,0,0,0">
                                <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LogicSelectionSoftBrush}" />
                                <Setter TargetName="SelBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                <Setter TargetName="SelBar" Property="Background" Value="{StaticResource ScadaSwatchBorderBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ==========================================  -->
        <!--  🏷 容器组头（v2）：整行 section bar  -->
        <!--  ==========================================  -->
        <Style x:Key="ContainerHeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <!--  负左边距：把色条延伸到展开箭头下方（箭头由模板的 ZIndex=2 压在色条之上）；
                  内容 Grid 再用 19 的左内边距把文字拉回与算子行同一条竖线（8 + 3 + 19 = 30）。  -->
            <Setter Property="Margin" Value="-22,4,2,0" />
            <Setter Property="MinHeight" Value="36" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource LogicSelectionSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  组头左侧 3px 身份色条（上下内缩 9px、右端圆角）。  -->
        <Style x:Key="ContainerAccentBarStyle" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Margin" Value="0,9" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="0,2,2,0" />
            <Setter Property="Background" Value="{StaticResource ScadaAccentBrush}" />
        </Style>

        <Style x:Key="ContainerTypeIconStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <!--  flow-logic 容器类型徽标：IF / WHILE / FOR / PAR / CASE  -->
        <Style x:Key="ContainerTypeBadgeStyle" TargetType="Border">
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="ContainerTypeBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource FlowCanvasOnTypeBadgeTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="ContainerTypeTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="ContainerMetaTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!--  运行/成功/失败状态位（组头右侧，State 驱动）。  -->
        <Style x:Key="ContainerStatusIconStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Text" Value="&#xf1ce;" />
                    <Setter Property="Foreground" Value="{StaticResource FlowCanvasSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Success">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Text" Value="&#xf00c;" />
                    <Setter Property="Foreground" Value="{StaticResource FlowCanvasSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Text" Value="&#xf06a;" />
                    <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  算子行状态列：正常态圆点 / 失败态感叹号（同一列，名字不再被 × 顶偏）。  -->
        <Style x:Key="StepStatusGlyphStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <!--  耗时：纯文字 + 小钟表，右对齐，等宽数字（v2 去掉灰底胶囊）。  -->
        <Style x:Key="StepTimeTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <!--  ==========================================  -->
        <!--  🖱 步骤右键菜单（方案 C：双行说明 + 图标底片）  -->
        <!--  只服务 TreeView.ContextMenu；其它菜单仍走 Navigation.xaml 的隐式样式。  -->
        <!--  可见宽 320 = Width 340 - 模板 Border 左右各 10 的阴影留白。  -->
        <!--  ==========================================  -->
        <Style x:Key="StepContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Width" Value="340" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="{StaticResource ScadaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border
                            Margin="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="28"
                                    Direction="270"
                                    Opacity="0.18"
                                    ShadowDepth="6"
                                    Color="Black" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer
                                    Grid.Row="0"
                                    SnapsToDevicePixels="True"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Margin="{TemplateBinding Padding}" />
                                </ScrollViewer>
                                <!--  页脚：命令提示 / 作用范围。文字为空时整条收起。  -->
                                <Border
                                    x:Name="Footer"
                                    Grid.Row="1"
                                    Margin="6,0"
                                    Padding="9,7,9,7"
                                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                                    BorderThickness="0,1,0,0">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                        Text="{Binding Path=(ui:MenuItemEx.Footer), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ui:MenuItemEx.Footer" Value="{x:Null}">
                                <Setter TargetName="Footer" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  菜单项：28px 图标底片 + 标题/说明双行 + 右侧快捷键与勾选。
              本样式只覆盖叶子项（本菜单没有二级菜单）；语气色由 ui:MenuItemEx.Tone 驱动。  -->
        <Style x:Key="StepMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border
                            x:Name="Row"
                            MinHeight="44"
                            Margin="0,1"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="Chip"
                                    Width="28"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource ScadaBadgeBackgroundBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        x:Name="Glyph"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="15"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{TemplateBinding Icon}" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,10,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="13"
                                        Text="{TemplateBinding Header}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="Desc"
                                        Margin="0,1,0,0"
                                        FontSize="11"
                                        Opacity="0.72"
                                        Text="{Binding Path=(ui:MenuItemEx.Description), RelativeSource={RelativeSource TemplatedParent}}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                        Text="{TemplateBinding InputGestureText}" />
                                    <TextBlock
                                        x:Name="CheckMark"
                                        Margin="6,0,0,0"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogAccentBrush}"
                                        Text="&#xf00c;"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource ScadaToolbarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="ui:MenuItemEx.Tone" Value="Indigo">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource LogicIfSoftBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource LogicIfTextBrush}" />
                            </Trigger>
                            <Trigger Property="ui:MenuItemEx.Tone" Value="Slate">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ScadaBadgeBackgroundBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="ui:MenuItemEx.Tone" Value="Amber">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                            </Trigger>
                            <Trigger Property="ui:MenuItemEx.Tone" Value="Gray">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ScadaBadgeBackgroundBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                            </Trigger>
                            <Trigger Property="ui:MenuItemEx.Tone" Value="Danger">
                                <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="ui:MenuItemEx.Tone" Value="Danger" />
                                    <Condition Property="IsHighlighted" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                                <Setter TargetName="Chip" Property="Opacity" Value="0.55" />
                                <Setter TargetName="Desc" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  流程栏 = 步骤树（大纲树观感）+ 底部执行统计。
          Delete 快捷键挂在 TreeView 元素级而不是 UserControl 级：焦点在别处敲 Delete
          是在改别的东西，不能误删当前选中的模块（元素级绑定只在其子树持焦点时触发）  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  v2：程序面板合并进流程导航。FlowListView 自带 VM（AutoWire），
              这里只负责把它放在当前流程树上方；不再单独占用一个 AvalonDock 窗格。  -->
        <local:FlowListView Grid.Row="0" Height="112" />

        <TreeView
            x:Name="StepTree"
            Grid.Row="1"
            dd:DragDrop.DragAdornerTemplateSelector="{StaticResource StepDragGhostSelector}"
            dd:DragDrop.DragAdornerTranslation="16,12"
            dd:DragDrop.DragHandler="{Binding}"
            dd:DragDrop.DropHandler="{Binding}"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            dd:DragDrop.UseDefaultDragAdorner="False"
            dd:DragDrop.UseDefaultEffectDataTemplate="True"
            ui:TreeViewBehavior.BindableSelectedItem="{Binding SelectStep}"
            ui:TreeViewBehavior.DoubleClickCommand="{Binding ModuleActionCommand}"
            ui:TreeViewBehavior.DoubleClickCommandParameter="{x:Static enums:ModuleCommandAction.ModuleParameters}"
            ItemContainerStyle="{StaticResource ModernStepContainerStyle}"
            ItemsSource="{Binding Workspace.CurrentFlow.Steps}"
            PreviewMouseRightButtonUp="moduleTree_PreviewMouseRightButtonDown">
            <TreeView.InputBindings>
                <KeyBinding
                    Command="{Binding ModuleActionCommand}"
                    CommandParameter="{x:Static enums:ModuleCommandAction.Delete}"
                    Key="Delete" />
            </TreeView.InputBindings>
            <TreeView.Resources>

                <!--  ==========================================  -->
                <!--  🖱 并行分支胶囊的分支级右键菜单（每实例一份）  -->
                <!--  ==========================================  -->
                <ContextMenu
                    x:Key="ParallelBranchMenu"
                    x:Shared="False"
                    DataContext="{Binding Data, Source={StaticResource ModuleData}}"
                    FontFamily="{StaticResource Icon}">
                    <MenuItem
                        Command="{Binding RenameParallelBranchCommand}"
                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                        Header="重命名本条分支"
                        Icon="pen-to-square" />
                    <MenuItem
                        Command="{Binding RemoveParallelBranchCommand}"
                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                        Foreground="{StaticResource DialogDangerBrush}"
                        Header="删除本条分支"
                        Icon="trash" />
                </ContextMenu>

                <!--  ==========================================  -->
                <!--  🟣 分支匹配（Case）分支级右键菜单（每实例一份）  -->
                <!--  ==========================================  -->
                <ContextMenu
                    x:Key="CaseBranchMenu"
                    x:Shared="False"
                    DataContext="{Binding Data, Source={StaticResource ModuleData}}"
                    FontFamily="{StaticResource Icon}">
                    <MenuItem
                        Command="{Binding RenameCaseBranchCommand}"
                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                        Header="重命名本条分支"
                        Icon="pen-to-square" />
                    <MenuItem
                        Command="{Binding RemoveCaseBranchCommand}"
                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                        Foreground="{StaticResource DialogDangerBrush}"
                        Header="删除本条分支"
                        Icon="trash" />
                </ContextMenu>

                <!--  ==========================================  -->
                <!--  🧩 普通视觉算子（ActionStep）—— v2 行  -->
                <!--  [状态列] [分类色图标块] [实例名 / 类型名] [耗时]  -->
                <!--  ==========================================  -->
                <DataTemplate DataType="{x:Type models:ActionStep}">
                    <Border
                        x:Name="RootBorder"
                        Margin="-22,1,2,1"
                        Padding="22,4,4,4"
                        Background="Transparent"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  状态列：圆点 / 运行脉冲环 / 失败感叹号（三者同一 16px 列）  -->
                            <Grid
                                Grid.Column="0"
                                Width="16"
                                VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="PulseRing"
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource ScadaAccentBrush}"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource ScadaDisabledTextBrush}" />
                                <TextBlock
                                    x:Name="ErrorGlyph"
                                    Style="{StaticResource StepStatusGlyphStyle}"
                                    Text="&#xf06a;" />
                            </Grid>

                            <!--  分类色图标块（26px / 圆角 7）+ 断点小红点  -->
                            <Grid
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                Margin="0,0,7,0">
                                <Border
                                    x:Name="IconChip"
                                    Background="{Binding Category, Converter={StaticResource CategorySoftBrushConverter}}"
                                    BorderBrush="{Binding Category, Converter={StaticResource CategoryBorderBrushConverter}}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <TextBlock
                                        x:Name="IconText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="12.5"
                                        Foreground="{Binding Category, Converter={StaticResource CategoryAccentBrushConverter}}"
                                        Text="{Binding Icon}"
                                        TextOptions.TextFormattingMode="Display" />
                                </Border>
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Margin="0,-2,-2,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Fill="{StaticResource FlowCanvasBreakpointBrush}"
                                    Stroke="{StaticResource ScadaSurfaceBrush}"
                                    StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBreakpoint}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <!--  实例名 + 类型名（两行；v2 不再有名字前的 ×，失败标记在状态列）  -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="NameText"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding StepName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding StepName}" />
                                <TextBlock
                                    x:Name="TypeText"
                                    Margin="0,1,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="{Binding PluginName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding PluginName}" />
                            </StackPanel>

                            <!--  耗时（纯文字，右对齐）  -->
                            <StackPanel
                                x:Name="TimeBadge"
                                Grid.Column="3"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TimeIcon"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="10"
                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                    Text="&#xf017;" />
                                <TextBlock
                                    x:Name="TimeText"
                                    Margin="3,0,0,0"
                                    Style="{StaticResource StepTimeTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding LastRunTimeMs, Converter={ui:GreaterThanZeroConverter}}" Value="True">
                            <Setter TargetName="TimeText" Property="Text" Value="{Binding LastRunTimeMs, StringFormat='{}{0:0.#} ms'}" />
                            <Setter TargetName="TimeBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!--  正在执行本步：柔和绿底 + 白底图标块 + 脉冲状态点（v2）  -->
                        <DataTrigger Binding="{Binding IsRunningFocus}" Value="True">
                            <Setter TargetName="TimeText" Property="Text" Value="{Binding CurrentRunTimeMs, StringFormat='{}{0:0.#} ms'}" />
                            <Setter TargetName="TimeBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                            <Setter TargetName="IconChip" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="TypeText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="TimeText" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource FlowCanvasRunningBrush}" />
                        </DataTrigger>

                        <!--  分支步骤运行中（真并行）：只认 State==Running（分支线程不设 IsRunningFocus）。
                              脉冲只在 State==Running 上启动一次，避免两个触发器抢同一个动画。  -->
                        <DataTrigger Binding="{Binding State}" Value="Running">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PulseStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PulseRing"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.45"
                                            To="0"
                                            Duration="0:0:1.6"
                                            RepeatBehavior="Forever" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PulseRing"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            From="1"
                                            To="2.6"
                                            Duration="0:0:1.6"
                                            RepeatBehavior="Forever" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PulseRing"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            From="1"
                                            To="2.6"
                                            Duration="0:0:1.6"
                                            RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                            </DataTrigger.ExitActions>
                            <Setter TargetName="TimeText" Property="Text" Value="{Binding CurrentRunTimeMs, StringFormat='{}{0:0.#} ms'}" />
                            <Setter TargetName="TimeBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                            <Setter TargetName="IconChip" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="TypeText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="TimeText" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource FlowCanvasRunningBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding State}" Value="Success">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource FlowCanvasSuccessBrush}" />
                        </DataTrigger>

                        <!--  失败：柔和红底 + 白底图标块 + 红字 + 状态列感叹号（不再用名字前的 ×、不再描红边）  -->
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                            <Setter TargetName="IconChip" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="TypeText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorGlyph" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding State}" Value="Skipped">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.62" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource FlowCanvasSkippedBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsDisEnable}" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.42" />
                            <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                            <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TimeBadge" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <!--  ==========================================  -->
                <!--  🔀 If 条件节点（身份色=灰）  -->
                <!--  ==========================================  -->
                <HierarchicalDataTemplate DataType="{x:Type models:ConditionStep}" ItemsSource="{Binding Children}">
                    <Border Style="{StaticResource ContainerHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Style="{StaticResource ContainerAccentBarStyle}" Background="{StaticResource LogicIfBrush}" />
                            <Grid Grid.Column="1" Margin="19,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ContainerTypeBadgeStyle}" Background="{StaticResource LogicIfBrush}" ToolTip="点击配置分支输入变量">
                                    <TextBlock Style="{StaticResource ContainerTypeBadgeTextStyle}" Text="IF" />
                                </Border>
                                <TextBlock
                                    x:Name="HeaderName"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding StepName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding StepName}" />
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        MaxWidth="150"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource ContainerMetaTextStyle}"
                                        Text="{Binding ContainerSummary}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ContainerSummary}"
                                        Visibility="{Binding ContainerSummaryVisibility}" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="{Binding Children.Count, StringFormat='{}{0} 分支'}" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="{Binding TotalStepCount, StringFormat=' · {0} 算子'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Style="{StaticResource ContainerStatusIconStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Running">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogSuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogDangerBrush}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>

                <!--  ==========================================  -->
                <!--  🔄 While 循环（身份色=橙）  -->
                <!--  ==========================================  -->
                <HierarchicalDataTemplate DataType="{x:Type models:WhileStep}" ItemsSource="{Binding Children}">
                    <Border Style="{StaticResource ContainerHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Style="{StaticResource ContainerAccentBarStyle}" Background="{StaticResource LogicWhileBrush}" />
                            <Grid Grid.Column="1" Margin="19,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ContainerTypeBadgeStyle}" Background="{StaticResource LogicWhileBrush}" ToolTip="点击配置循环条件">
                                    <TextBlock Style="{StaticResource ContainerTypeBadgeTextStyle}" Text="WHILE" />
                                </Border>
                                <TextBlock
                                    x:Name="HeaderName"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding StepName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding StepName}" />
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        MaxWidth="150"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource ContainerMetaTextStyle}"
                                        Text="{Binding ContainerSummary}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ContainerSummary}"
                                        Visibility="{Binding ContainerSummaryVisibility}" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="循环体" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="{Binding TotalStepCount, StringFormat=' · {0} 算子'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Style="{StaticResource ContainerStatusIconStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Running">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogSuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogDangerBrush}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>

                <!--  ==========================================  -->
                <!--  ⏳ 等待节点（BuiltIn_Wait，非容器，与算子行同构）  -->
                <!--  R23 守门：新增 StepModel 子类必须在这里补 DataType 模板。  -->
                <!--  ==========================================  -->
                <DataTemplate DataType="{x:Type models:WaitStep}">
                    <Border
                        x:Name="RootBorder"
                        Margin="-22,1,2,1"
                        Padding="22,4,4,4"
                        Background="Transparent"
                        CornerRadius="8"
                        ToolTip="{Binding ConditionExpression}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Grid.Column="0"
                                Width="16"
                                VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="PulseRing"
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource ScadaAccentBrush}"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource ScadaDisabledTextBrush}" />
                                <TextBlock
                                    x:Name="ErrorGlyph"
                                    Style="{StaticResource StepStatusGlyphStyle}"
                                    Text="&#xf06a;" />
                            </Grid>

                            <Grid
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                Margin="0,0,7,0">
                                <Border
                                    x:Name="IconChip"
                                    Background="{Binding Category, Converter={StaticResource CategorySoftBrushConverter}}"
                                    BorderBrush="{Binding Category, Converter={StaticResource CategoryBorderBrushConverter}}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <TextBlock
                                        x:Name="IconText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="12.5"
                                        Foreground="{StaticResource DialogAccentBrush}"
                                        Text="{Binding Icon}"
                                        TextOptions.TextFormattingMode="Display" />
                                </Border>
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Margin="0,-2,-2,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Fill="{StaticResource FlowCanvasBreakpointBrush}"
                                    Stroke="{StaticResource ScadaSurfaceBrush}"
                                    StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBreakpoint}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <!--  实例名 + 「等待 · 条件」：类型不再单独占一个 chip，名称与算子行对齐  -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="NameText"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding StepName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding StepName}" />
                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogAccentBrush}"
                                        Text="等待" />
                                    <TextBlock
                                        x:Name="ConditionText"
                                        Grid.Column="1"
                                        Margin="4,0,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding ConditionExpression}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ConditionExpression}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Running">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="WaitPulseStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PulseRing"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0.45"
                                            To="0"
                                            Duration="0:0:1.6"
                                            RepeatBehavior="Forever" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PulseRing"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            From="1"
                                            To="2.6"
                                            Duration="0:0:1.6"
                                            RepeatBehavior="Forever" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PulseRing"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            From="1"
                                            To="2.6"
                                            Duration="0:0:1.6"
                                            RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="WaitPulseStoryboard" />
                            </DataTrigger.ExitActions>
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                            <Setter TargetName="IconChip" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="ConditionText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource FlowCanvasRunningBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding State}" Value="Success">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource FlowCanvasSuccessBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                            <Setter TargetName="IconChip" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="ConditionText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorGlyph" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding State}" Value="Skipped">
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource FlowCanvasSkippedBrush}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.62" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsDisEnable}" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.42" />
                            <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                            <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>

                <!--  ==========================================  -->
                <!--  🔢 For 计次循环（身份色=绿）  -->
                <!--  ==========================================  -->
                <HierarchicalDataTemplate DataType="{x:Type models:ForStep}" ItemsSource="{Binding Children}">
                    <Border Style="{StaticResource ContainerHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Style="{StaticResource ContainerAccentBarStyle}" Background="{StaticResource LogicForBrush}" />
                            <Grid Grid.Column="1" Margin="19,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ContainerTypeBadgeStyle}" Background="{StaticResource LogicForBrush}" ToolTip="计次循环容器">
                                    <TextBlock Style="{StaticResource ContainerTypeBadgeTextStyle}" Text="FOR" />
                                </Border>
                                <TextBlock
                                    x:Name="HeaderName"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding StepName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding StepName}" />
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        MaxWidth="150"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource ContainerMetaTextStyle}"
                                        Text="{Binding ContainerSummary}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ContainerSummary}"
                                        Visibility="{Binding ContainerSummaryVisibility}" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="循环体" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="{Binding TotalStepCount, StringFormat=' · {0} 算子'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Style="{StaticResource ContainerStatusIconStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Running">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogSuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogDangerBrush}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>

                <!--  ==========================================  -->
                <!--  ⑂ 并行分组（身份色=蓝）  -->
                <!--  R23 事故回归：缺这份模板 → 整行回退 ToString()，分支全丢。  -->
                <!--  ==========================================  -->
                <HierarchicalDataTemplate DataType="{x:Type models:ParallelStep}" ItemsSource="{Binding Children}">
                    <Border Style="{StaticResource ContainerHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Style="{StaticResource ContainerAccentBarStyle}" Background="{StaticResource LogicParallelBrush}" />
                            <Grid Grid.Column="1" Margin="19,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ContainerTypeBadgeStyle}" Background="{StaticResource LogicParallelBrush}" ToolTip="并行分组容器（分支并列执行：顺序模式逐分支跑完汇合，并行模式真并发）">
                                    <TextBlock Style="{StaticResource ContainerTypeBadgeTextStyle}" Text="PAR" />
                                </Border>
                                <TextBlock
                                    x:Name="HeaderName"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding StepName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding StepName}" />
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        MaxWidth="150"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource ContainerMetaTextStyle}"
                                        Text="{Binding ContainerSummary}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ContainerSummary}"
                                        Visibility="{Binding ContainerSummaryVisibility}" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="{Binding Children.Count, StringFormat='{}{0} 分支'}" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="{Binding TotalStepCount, StringFormat=' · {0} 算子'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Style="{StaticResource ContainerStatusIconStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Running">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogSuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogDangerBrush}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>

                <!--  ==========================================  -->
                <!--  🔀 分支匹配（Case，身份色=青蓝）  -->
                <!--  ==========================================  -->
                <HierarchicalDataTemplate DataType="{x:Type models:CaseStep}" ItemsSource="{Binding Children}">
                    <Border Style="{StaticResource ContainerHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AccentBar" Style="{StaticResource ContainerAccentBarStyle}" Background="{StaticResource LogicCaseBrush}" />
                            <Grid Grid.Column="1" Margin="19,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ContainerTypeBadgeStyle}" Background="{StaticResource LogicCaseBrush}" ToolTip="分支匹配容器（按判据的匹配值选择分支；未命中走默认分支）">
                                    <TextBlock Style="{StaticResource ContainerTypeBadgeTextStyle}" Text="CASE" />
                                </Border>
                                <TextBlock
                                    x:Name="HeaderName"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding StepName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding StepName}" />
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        MaxWidth="150"
                                        Margin="0,0,6,0"
                                        Style="{StaticResource ContainerMetaTextStyle}"
                                        Text="{Binding ContainerSummary}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ContainerSummary}"
                                        Visibility="{Binding ContainerSummaryVisibility}" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="{Binding Children.Count, StringFormat='{}{0} 分支'}" />
                                    <TextBlock Style="{StaticResource ContainerMetaTextStyle}" Text="{Binding TotalStepCount, StringFormat=' · {0} 算子'}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Style="{StaticResource ContainerStatusIconStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Running">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogSuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter TargetName="HeaderName" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource DialogDangerBrush}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>

                <!--  ==========================================  -->
                <!--  📦 分支 / 循环体（StepCollection）—— v2 整行子标题  -->
                <!--  ==========================================  -->
                <HierarchicalDataTemplate DataType="{x:Type models:StepCollection}" ItemsSource="{Binding Steps}">
                    <Grid>
                        <Border
                            x:Name="BranchContainer"
                            MinHeight="28"
                            Margin="-22,2,2,2"
                            Padding="0"
                            Background="{StaticResource LogicIfSoftBrush}"
                            BorderBrush="{StaticResource LogicIfBorderBrush}"
                            BorderThickness="2,0,0,0"
                            CornerRadius="8"
                            ToolTip="将算子拖入此分支内部">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!--  并行分组的分支（父容器 ExecutionMode 两档）  -->
                                        <DataTrigger Binding="{Binding DataContext.ExecutionMode, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}, AncestorLevel=2}}" Value="Sequential">
                                            <Setter Property="ContextMenu" Value="{StaticResource ParallelBranchMenu}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.ExecutionMode, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}, AncestorLevel=2}}" Value="Parallel">
                                            <Setter Property="ContextMenu" Value="{StaticResource ParallelBranchMenu}" />
                                        </DataTrigger>
                                        <!--  Case 分支自带菜单；Else 默认分支不挂（不可删）  -->
                                        <DataTrigger Binding="{Binding BranchType}" Value="Case">
                                            <Setter Property="ContextMenu" Value="{StaticResource CaseBranchMenu}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="22,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  悬停叠层：保住身份色，只加一层很浅的灰（v2 不用换底色，避免 Else/循环的身份色被冲掉）  -->
                                <Border
                                    x:Name="HoverLayer"
                                    Grid.ColumnSpan="3"
                                    Margin="-22,0,0,0"
                                    Background="{StaticResource DialogRowHoverBrush}"
                                    CornerRadius="7"
                                    IsHitTestVisible="False"
                                    Opacity="0" />

                                <Ellipse
                                    x:Name="StatusDot"
                                    Width="7"
                                    Height="7"
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource ScadaAccentBrush}" />

                                <!--  分支文本只认 StepCollection.DisplayName（R24：不要另挂 Expression）  -->
                                <TextBlock
                                    x:Name="BranchText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    x:Name="BranchCountText"
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="{Binding Steps.Count, StringFormat='{}{0} 个算子'}"
                                    Typography.NumeralAlignment="Tabular" />
                                <TextBlock
                                    x:Name="BranchEmptyText"
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="拖入算子"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!--  空分支：虚线框（Border 不支持虚线，用叠加 Rectangle 表达）  -->
                        <Rectangle
                            x:Name="EmptyOutline"
                            Margin="-22,2,2,2"
                            IsHitTestVisible="False"
                            RadiusX="8"
                            RadiusY="8"
                            Stroke="{StaticResource ScadaSwatchBorderBrush}"
                            StrokeDashArray="3,3"
                            StrokeThickness="1"
                            Visibility="Collapsed" />
                    </Grid>

                    <HierarchicalDataTemplate.Triggers>
                        <!--  悬停：叠层提亮 + 描边强调  -->
                        <Trigger SourceName="BranchContainer" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.6" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                        </Trigger>

                        <!--  计数 / 空态：同一槽位二选一  -->
                        <DataTrigger Binding="{Binding Steps.Count, Converter={ui:GreaterThanZeroConverter}}" Value="True">
                            <Setter TargetName="BranchCountText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BranchEmptyText" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Steps.Count, Converter={ui:GreaterThanZeroConverter}}" Value="False">
                            <Setter TargetName="BranchCountText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="BranchEmptyText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BranchContainer" Property="BorderThickness" Value="0" />
                            <Setter TargetName="EmptyOutline" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!--  Else 分支（灰身份）  -->
                        <DataTrigger Binding="{Binding BranchType}" Value="Else">
                            <Setter TargetName="BranchContainer" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource DialogBorderLightBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource ScadaFaintTextBrush}" />
                            <Setter TargetName="BranchText" Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                        </DataTrigger>

                        <!--  循环体：Default(For) 与 WhileLoop(While)  -->
                        <DataTrigger Binding="{Binding BranchType}" Value="Default">
                            <Setter TargetName="BranchContainer" Property="Background" Value="{StaticResource LogicForSoftBrush}" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource LogicForBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource LogicForBrush}" />
                            <Setter TargetName="BranchText" Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BranchType}" Value="WhileLoop">
                            <Setter TargetName="BranchContainer" Property="Background" Value="{StaticResource LogicWhileSoftBrush}" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource LogicWhileBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource LogicWhileBrush}" />
                            <Setter TargetName="BranchText" Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                        </DataTrigger>

                        <!--  Case 分支（紫身份）  -->
                        <DataTrigger Binding="{Binding BranchType}" Value="Case">
                            <Setter TargetName="BranchContainer" Property="Background" Value="{StaticResource LogicCaseSoftBrush}" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource LogicCaseBorderBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource LogicCaseBrush}" />
                            <Setter TargetName="BranchText" Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                        </DataTrigger>

                        <!--  并行分组的分支（天蓝身份；AncestorLevel=2 即父容器项）  -->
                        <DataTrigger Binding="{Binding DataContext.ExecutionMode, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}, AncestorLevel=2}}" Value="Sequential">
                            <Setter TargetName="BranchContainer" Property="Background" Value="{StaticResource LogicParallelSoftBrush}" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource LogicParallelBorderBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource LogicParallelBrush}" />
                            <Setter TargetName="BranchText" Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.ExecutionMode, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}, AncestorLevel=2}}" Value="Parallel">
                            <Setter TargetName="BranchContainer" Property="Background" Value="{StaticResource LogicParallelSoftBrush}" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource LogicParallelBorderBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource LogicParallelBrush}" />
                            <Setter TargetName="BranchText" Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                        </DataTrigger>

                        <!--  并行分支运行中（真并发）：蓝身份  -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="BranchContainer" Property="Background" Value="{StaticResource LogicSelectionSoftBrush}" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource FlowCanvasRunningBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource FlowCanvasRunningBrush}" />
                            <Setter TargetName="BranchText" Property="Foreground" Value="{StaticResource FlowCanvasRunningBrush}" />
                        </DataTrigger>

                        <!--  缺条件统一红灯（放在最后：红压绿/压身份色）  -->
                        <DataTrigger Binding="{Binding IsConditionMissing}" Value="True">
                            <Setter TargetName="BranchContainer" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                            <Setter TargetName="BranchContainer" Property="BorderBrush" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                            <Setter TargetName="BranchText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>

            </TreeView.Resources>

            <TreeView.ContextMenu>
                <ContextMenu
                    DataContext="{Binding Data, Source={StaticResource ModuleData}}"
                    Style="{StaticResource StepContextMenuStyle}"
                    ui:MenuItemEx.Footer="右键菜单 · 仅作用于当前选中步骤">
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.AddElseIf}"
                        Header="添加 ElseIf 分支"
                        Icon="code-branch"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="在 If 容器内追加一条 ElseIf 分支"
                        ui:MenuItemEx.Tone="Indigo"
                        Visibility="{Binding IsIfNodeSelected, Converter={ui:BooleanToVisibilityConverter}}" />
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.AddElse}"
                        Header="添加 Else 分支"
                        Icon="code-branch"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="为 If 补一条兜底分支"
                        ui:MenuItemEx.Tone="Indigo"
                        Visibility="{Binding IsIfNodeSelected, Converter={ui:BooleanToVisibilityConverter}}" />
                    <Separator
                        Style="{StaticResource StepMenuSeparatorStyle}"
                        Visibility="{Binding IsIfNodeSelected, Converter={ui:BooleanToVisibilityConverter}}" />
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.AddCase}"
                        Header="添加 Case 分支"
                        Icon="code-branch"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="为分支匹配容器追加一条 Case"
                        ui:MenuItemEx.Tone="Indigo"
                        Visibility="{Binding IsCaseNodeSelected, Converter={ui:BooleanToVisibilityConverter}}" />
                    <Separator
                        Style="{StaticResource StepMenuSeparatorStyle}"
                        Visibility="{Binding IsCaseNodeSelected, Converter={ui:BooleanToVisibilityConverter}}" />
                    <MenuItem
                        Command="{Binding AddParallelBranchCommand}"
                        CommandParameter="{Binding SelectStep}"
                        Header="添加分支"
                        Icon="code-branch"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="为并行分组追加一条并行分支"
                        ui:MenuItemEx.Tone="Indigo"
                        Visibility="{Binding IsParallelNodeSelected, Converter={ui:BooleanToVisibilityConverter}}" />
                    <MenuItem
                        Command="{Binding RenameParallelGroupCommand}"
                        CommandParameter="{Binding SelectStep}"
                        Header="重命名分组"
                        Icon="pen-to-square"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="修改并行分组的显示名"
                        ui:MenuItemEx.Tone="Indigo"
                        Visibility="{Binding IsParallelNodeSelected, Converter={ui:BooleanToVisibilityConverter}}" />
                    <Separator
                        Style="{StaticResource StepMenuSeparatorStyle}"
                        Visibility="{Binding IsParallelNodeSelected, Converter={ui:BooleanToVisibilityConverter}}" />
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.Rename}"
                        Header="重命名"
                        Icon="pen-to-square"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="修改显示名，不改变算子类型"
                        ui:MenuItemEx.Tone="Slate" />
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.EditComment}"
                        Header="编辑注释"
                        Icon="comment-lines"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="为这一步补充说明文字"
                        ui:MenuItemEx.Tone="Slate" />
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.ModuleParameters}"
                        Header="步骤参数"
                        Icon="sliders"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="打开算子参数面板"
                        ui:MenuItemEx.Tone="Slate" />
                    <Separator Style="{StaticResource StepMenuSeparatorStyle}" />
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.ToggleBreakpoint}"
                        Header="{Binding BreakpointToggleHeader}"
                        Icon="circle-dot"
                        IsChecked="{Binding IsBreakpointSet, Mode=OneWay}"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="断点开关：运行到这一步前暂停"
                        ui:MenuItemEx.Tone="Amber" />
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.ToggleDisable}"
                        Header="{Binding DisableToggleHeader}"
                        Icon="ban"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="启用开关：禁用后跳过这一步"
                        ui:MenuItemEx.Tone="Amber" />
                    <MenuItem
                        Command="{Binding ModuleActionCommand}"
                        CommandParameter="{x:Static enums:ModuleCommandAction.Delete}"
                        Header="删除"
                        Icon="trash"
                        InputGestureText="Del"
                        Style="{StaticResource StepMenuItemStyle}"
                        ToolTip="连同子步骤一并移出图纸（Delete 键删除当前选中算子）"
                        ui:MenuItemEx.Description="连同子步骤移出图纸"
                        ui:MenuItemEx.Tone="Danger" />
                    <Separator Style="{StaticResource StepMenuSeparatorStyle}" />
                    <MenuItem
                        Click="OnExpandTreeAllClick"
                        Header="展开全部"
                        Icon="expand"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="展开整棵流程树"
                        ui:MenuItemEx.Tone="Gray" />
                    <MenuItem
                        Click="OnCollapseTreeFirstLevelClick"
                        Header="折叠到第一层"
                        Icon="compress"
                        Style="{StaticResource StepMenuItemStyle}"
                        ui:MenuItemEx.Description="只保留根层展开"
                        ui:MenuItemEx.Tone="Gray" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>

        <!--  执行统计两行（v2：次要色 + 等宽数字，不再压透明度）  -->
        <Border
            Grid.Row="2"
            Margin="8,2,8,4"
            Padding="0,6,0,0"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="{Binding StepCountText}"
                        Typography.NumeralAlignment="Tabular" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="{Binding RunTimeText}"
                        Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <CheckBox
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Content="失败自动跳转"
                    IsChecked="{Binding AutoJumpToFailure}"
                    ToolTip="运行失败时自动把流程栏选中切到失败的步骤；取消勾选则只报警、不切选中" />
            </Grid>
        </Border>
    </Grid>

</UserControl>
