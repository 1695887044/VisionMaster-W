<UserControl
    x:Class="VisionMaster.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:VisionMaster.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <UserControl.Resources>
        <vm:GroupKeyToLabelConverter x:Key="GroupKeyToLabelConverter" />

        <!--  工具条按钮统一模板  -->
        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具条：搜索联想 + 快捷添加 + 清空  -->
        <Border
            Grid.Row="0"
            Margin="10,10,10,8"
            Padding="10,6"
            Background="#F8F9FA"
            BorderBrush="#EBEEF5"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#909399"
                        Text="添加监视:" />
                    <TextBox
                        x:Name="SearchTextBox"
                        Height="30"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        Foreground="#303133"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="算子名 / 算子.端口 / Global.变量名，Enter 添加首个联想项">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddWatchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <Popup
                    Width="{Binding ElementName=SearchTextBox, Path=ActualWidth}"
                    IsOpen="{Binding IsDropDownOpen}"
                    Placement="Bottom"
                    PopupAnimation="Fade"
                    StaysOpen="False">
                    <Border
                        MaxHeight="220"
                        Background="White"
                        BorderBrush="#EBEEF5"
                        BorderThickness="1">
                        <ListView
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding SuggestedItems}"
                            SelectedItem="{Binding SelectedSuggestion}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="12,7" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#ECF5FF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="13" Foreground="#606266" Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Popup>

                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Background="#67C23A"
                        Command="{Binding QuickAddCommand}"
                        CommandParameter="Global.All"
                        Content="全局变量"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="添加所有全局变量" />
                    <Button
                        Background="#F56C6C"
                        Command="{Binding ClearAllCommand}"
                        Content="清空"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="清空所有监视项" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  监视列表：按方向三分组（全局变量/算子输入/算子输出），组可折叠  -->
        <ListBox
            Grid.Row="1"
            Margin="10,0"
            Background="Transparent"
            BorderThickness="0"
            HorizontalContentAlignment="Stretch"
            ItemsSource="{Binding GroupedPorts}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander IsExpanded="True">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="#303133"
                                                        Text="{Binding Name, Converter={StaticResource GroupKeyToLabelConverter}}" />
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        Foreground="#909399"
                                                        Text="{Binding ItemCount, StringFormat='({0})'}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F5F7FA" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--  失效项整行变色提示（红 + 删除线），ToolTip 说明原因  -->
                    <Grid
                        Background="Transparent"
                        ToolTip="{Binding StatusTooltip}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Opacity" Value="0.75" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#409EFF"
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding DisplayName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter Property="Foreground" Value="#F56C6C" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#909399"
                            Text="{Binding TypeName}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#67C23A"
                            Text="{Binding DisplayValue}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding DisplayValue}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter Property="Foreground" Value="#F56C6C" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border
                            Grid.Column="3"
                            Padding="6,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#F4F4F5"
                            CornerRadius="4">
                            <TextBlock FontSize="11" Foreground="#909399" Text="{Binding Direction}" />
                        </Border>

                        <Button
                            Grid.Column="4"
                            Width="20"
                            Height="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            ToolTip="移除监视">
                            <TextBlock
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="#F56C6C"
                                Text="&#xf1f8;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--  底部计数  -->
        <StackPanel
            Grid.Row="2"
            Margin="10,6,10,10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Foreground="#909399" Text="监视项:" />
            <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="#409EFF"
                Text="{Binding DisplayPorts.Count}" />
        </StackPanel>
    </Grid>
</UserControl>
