<UserControl
    x:Class="VisionMaster.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:VisionMaster.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!--
            设计基线：docs/UI设计基线/watch-panel/ v1（2026-10-22 复刻）。
            本文件零硬编码色值（R140）。

            就地合并 Colors.xaml：断言宿主没有应用级资源，不合并会在解析期抛"找不到资源"（R22）。
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <vm:GroupKeyToLabelConverter x:Key="GroupKeyToLabelConverter" />

            <!--  输入框：白底 + 1px 描边 + 6px 圆角（Fluent 隐式样式那条底线在浅色条上看不见）  -->
            <Style x:Key="MonitorSearchBoxStyle" TargetType="TextBox">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="SelectionBrush" Value="{StaticResource DialogAccentLightBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Focusable="False"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogTextMutedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  工具条按钮：白底描边（次要）/ 实底（主）/ 白底红字（破坏性）  -->
            <Style x:Key="ToolBarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogTextMutedBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  主操作按钮：实底强调色  -->
            <Style
                x:Key="PrimaryToolBarButtonStyle"
                BasedOn="{StaticResource ToolBarButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DialogAccentDarkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogAccentDarkBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DialogSurfaceBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!--  破坏性但可恢复：白底红字（不用红色实底——"最危险的动作最显眼"是反的）  -->
            <Style
                x:Key="DangerToolBarButtonStyle"
                BasedOn="{StaticResource ToolBarButtonStyle}"
                TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
            </Style>

            <!--  方向徽标：全局暖 / 输入冷蓝 / 输出冷绿（不占用状态语义色）  -->
            <Style x:Key="DirectionTagStyle" TargetType="Border">
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Background" Value="{StaticResource DialogBorderLightBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource DialogSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            添加监视工具条：标签 + 输入框 + 三个按钮。
            三个按钮的语义分层：添加（主）/ 全部变量（次要）/ 清空（破坏性但可恢复，白底红字）。
        -->
        <Border
            Grid.Row="0"
            Padding="12,10"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                    Text="添加监视" />

                <Grid
                    x:Name="SearchTextBoxHost"
                    Grid.Column="1"
                    MinWidth="120"
                    VerticalAlignment="Center">
                    <!--  输入框：白底 + 1px 描边 + 6px 圆角（Fluent 隐式样式那条底线在浅色条上看不见）  -->
                    <TextBox
                        x:Name="SearchTextBox"
                        Style="{StaticResource MonitorSearchBoxStyle}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="算子名 / 算子.端口 / Global.变量名，Enter 添加首个联想项">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddWatchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <!--  占位提示  -->
                    <TextBlock
                        Margin="11,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        IsHitTestVisible="False"
                        Text="算子名 / 算子.端口 / Global.变量名">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Orientation="Horizontal">
                    <Button
                        Height="32"
                        Margin="0,0,6,0"
                        Command="{Binding AddWatchCommand}"
                        Content="添加"
                        Style="{StaticResource PrimaryToolBarButtonStyle}"
                        ToolTip="添加输入框里的第一个联想项" />
                    <Button
                        Height="32"
                        Margin="0,0,6,0"
                        Command="{Binding QuickAddCommand}"
                        CommandParameter="Global.All"
                        Content="全部变量"
                        Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="添加所有全局变量" />
                    <Button
                        Height="32"
                        Command="{Binding ClearAllCommand}"
                        Content="清空"
                        Style="{StaticResource DangerToolBarButtonStyle}"
                        ToolTip="清空所有监视项" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            联想下拉：按来源分组（算子端口 / 全局变量），每项 = 类型徽标 + 名称。
            空态单独给一句"没有匹配项"，不留白板。
        -->
        <Popup
            Width="{Binding ElementName=SearchTextBox, Path=ActualWidth}"
            IsOpen="{Binding IsDropDownOpen}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=SearchTextBox}"
            PopupAnimation="Fade"
            StaysOpen="False">
            <Border
                MaxHeight="260"
                Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <ListView
                        x:Name="SuggestionList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding SuggestedItems}"
                        SelectedItem="{Binding SelectedSuggestion}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--  类型徽标：out / in / gv / all（等宽 10px）  -->
                                    <Border
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Padding="5,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource DialogBorderLightBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                                            Text="{Binding KindLabel}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  无匹配态：只在列表为空时显示  -->
                    <TextBlock
                        Margin="10,18"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="没有匹配项&#10;试试输入算子名，或 Global. 前缀"
                        TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SuggestedItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Popup>

        <!--  监视列表：按方向三分组（全局变量/算子输入/算子输出），组可折叠  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  列头：与行共用同一套列宽，保证跨行对齐  -->
            <Grid
                Grid.Row="0"
                Height="28"
                Margin="12,0"
                Background="{StaticResource DialogSurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="名称" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="类型" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="当前值" />
                <TextBlock
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="方向" />
            </Grid>

            <ListBox
                Grid.Row="1"
                Margin="12,0"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding GroupedPorts}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel
                                                        Height="34"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                            Text="{Binding Name, Converter={StaticResource GroupKeyToLabelConverter}}" />
                                                        <Border
                                                            Margin="6,0,0,0"
                                                            Padding="6,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource DialogBorderLightBrush}"
                                                            CornerRadius="9">
                                                            <TextBlock
                                                                FontFamily="Consolas"
                                                                FontSize="11"
                                                                Foreground="{StaticResource DialogTextTertiaryBrush}"
                                                                Text="{Binding ItemCount}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!--
                            失效行：整行红底 + 名称删除线 + 值换占位符。
                            为什么不用"透明度 0.75"：密集列表里几乎看不出来（设计基线 §2.1）。
                        -->
                        <Grid
                            Height="36"
                            Background="Transparent"
                            ToolTip="{Binding StatusTooltip}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogAccentTextBrush}"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DisplayName}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="11"
                                Foreground="{StaticResource DialogTextTertiaryBrush}"
                                Text="{Binding TypeName}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  值列：等宽 + 右对齐，数值纵向成列  -->
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogSuccessTextBrush}"
                                Text="{Binding DisplayValue}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding DisplayValue}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="FontFamily" Value="Microsoft YaHei" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--  方向徽标：全局暖 / 输入冷蓝 / 输出冷绿  -->
                            <Border Grid.Column="3">
                                <Border.Style>
                                    <Style
                                        BasedOn="{StaticResource DirectionTagStyle}"
                                        TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Direction}" Value="全局">
                                                <Setter Property="Background" Value="{StaticResource LogicWhileSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="输入">
                                                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="输出">
                                                <Setter Property="Background" Value="{StaticResource LogicForSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                                    Text="{Binding Direction}" />
                            </Border>

                            <!--  移除：24×24，Padding=0（R68），悬停/聚焦才显形  -->
                            <Button
                                Grid.Column="4"
                                Width="24"
                                Height="24"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                ToolTip="移除监视">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="✕" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  空态：三行"怎么加第一个监视项"的引导（比"暂无数据"有用）  -->
            <StackPanel
                Grid.Row="1"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayPorts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="30"
                    Foreground="{StaticResource DialogBorderStrongBrush}"
                    Text="▤" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                    Text="还没有监视项" />
                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="添加一个端口或变量，运行时就地观察它的值。" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="· 输入 匹配 找算子，选 算子.端口&#10;· 输入 Global. 列出全部全局变量&#10;· 回车添加第一个联想项"
                    TextAlignment="Left" />
            </StackPanel>
        </Grid>

        <!--  底栏：左失效计数（无失效则整段隐藏），右监视项总数  -->
        <Border
            Grid.Row="2"
            Padding="12,6"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <!-- 默认显示；失效数为 0（或绑不上，如探针无 VM）时整段隐藏 -->
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MissingCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MissingCount}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse
                        Width="6"
                        Height="6"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource DialogDangerBrush}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogDangerTextBrush}"
                        Text="{Binding MissingCount}" />
                    <TextBlock
                        Margin="3,0,0,0"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="项失效" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="监视项 " />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="{Binding DisplayPorts.Count}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
