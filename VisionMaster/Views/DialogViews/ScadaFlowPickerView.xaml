<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaFlowPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="520"
    Height="460"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  组态「选择流程」弹窗  -->
    <!--  由属性面板/变量事件弹窗的「启动/停止/执行一次流程」动作打开，回传 (流程 Id, 流程名)。  -->
    <!--  清单口径：只列当前方案里的流程（IWorkspaceManager.CurrentSolution.Flows）——  -->
    <!--  这正是运行态出口能寻址到的那一份，选得到就一定跑得到。  -->
    <!--  刻意用 ListBox 而不是 ListView+GridView：三个展示列用一行模板就够，  -->
    <!--  不去踩 Fluent 隐式样式顶掉 GridView 的那片坑（GridListViewStyle 那套契约面）。  -->
    <!--  ==========================================  -->

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  行容器：整行可点，选中态与画面选择弹窗同一套配色（#ECF5FF + #409EFF）  -->
            <Style x:Key="FlowRowItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="RowBorder"
                                Padding="10,8"
                                Background="Transparent"
                                BorderBrush="#F2F3F5"
                                BorderThickness="0,0,0,1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#F5F7FA" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#ECF5FF" />
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="#409EFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  「已停用」徽标：空串（启用中）时整块收起，不引外部转换器  -->
            <Style x:Key="StateBadgeStyle" TargetType="Border">
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#FDF6EC" />
                <Setter Property="BorderBrush" Value="#F5DAB1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StateBadge}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="15">
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Direction="270"
                    Opacity="0.15"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <!--  标题栏（无系统边框的弹窗靠它拖动）  -->
                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Background="#F8F9FA"
                    BorderBrush="#EBEEF5"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                    <TextBlock
                        Margin="20,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#303133"
                        Text="选择流程" />
                </Border>

                <!--  内容区：流程清单  -->
                <Grid Grid.Row="1" Margin="20,16,20,0">
                    <Border
                        Background="#FFFFFF"
                        BorderBrush="#E4E7ED"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <ListBox
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource FlowRowItemStyle}"
                                ItemsSource="{Binding Flows}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedFlow}"
                                SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!--  双击即确认：商业软件的清单都是这个手感  -->
                                        <Grid Background="Transparent">
                                            <Grid.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    MouseAction="LeftDoubleClick" />
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Foreground="#303133"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Description}" />
                                            <!--  角色列：回原 / 主任务 / 收尾 / 普通  -->
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#909399"
                                                Text="{Binding RoleText}" />
                                            <!--  「已停用」徽标：只在停用的那一行出现（仍可选，运行侧会照实拒绝）  -->
                                            <Border Grid.Column="2" Style="{StaticResource StateBadgeStyle}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#E6A23C"
                                                    Text="{Binding StateBadge}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--  空态提示：方案里一条流程都没有  -->
                            <TextBlock
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#909399"
                                Text="{Binding EmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasFlows, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                        </Grid>
                    </Border>

                    <!--  口径说明：让配置者明白"这里选的就是运行时跑到的那一条"  -->
                    <TextBlock
                        Margin="0,8,0,0"
                        VerticalAlignment="Bottom"
                        FontSize="11"
                        Foreground="#C0C4CC"
                        Text="* 确认后按流程身份（Id）记录，之后改名不会让这条动作断链。" />
                </Grid>

                <!--  底部按钮  -->
                <StackPanel
                    Grid.Row="2"
                    Margin="20,10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,12,0"
                        Padding="28,8"
                        Background="#FFFFFF"
                        BorderBrush="#DCDFE6"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button
                        Padding="28,8"
                        Background="#409EFF"
                        BorderThickness="0"
                        Command="{Binding ConfirmCommand}"
                        Content="确定"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
