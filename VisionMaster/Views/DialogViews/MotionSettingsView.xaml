<UserControl
    x:Class="VisionMaster.Views.DialogViews.MotionSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    MinWidth="1000"
    MinHeight="700"
    Background="{StaticResource DialogBackgroundBrush}"
    FontFamily="Microsoft YaHei"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1180" />
            <Setter Property="Height" Value="720" />
            <Setter Property="MinWidth" Value="1000" />
            <!--
                下限从 620 提到 700：轴映射表 + 运行状态 + 提示三块都要在**默认尺寸下可见**。
                620 时"，"右侧"卡信息 + 运动参数"两个 Auto 行就把空间吃完，
                轴映射只剩表头高度（用户反馈：必须手动拉大窗口才看得到轴）。
            -->
            <Setter Property="MinHeight" Value="700" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--
        ============================================================================
        运动卡设置（方案级运动卡资源管理）
        ============================================================================

        与「相机设置」同一范式：左边选卡、右边调参数与轴映射，配置写进 SolutionModel.MotionCards
        （随 .vms 落盘），运行态设备由 MotionProvider 另存。

        界面刻意的三处设计：
          1) 轴映射表里"逻辑名"是流程唯一引用的东西（物理轴号可随接线变化），
             所以它排在第一位，并且脉冲当量/软限位就放在它旁边 —— 这三样配错都直接导致撞机。
          2) 增量式编码器的卡连上后会明确提示"必须回零"：位置不可信时若直接运动，
             卡会按错误的当前坐标算行程，这是最危险的一类静默错误。
          3) 参数区与轴映射表共用一个"应用"按钮：两者都属于"改了要标脏 + 重新对齐"的配置，
             分成两个按钮只会让人漏点一个。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏（自绘）：整条可拖，右侧 × 关闭  -->
        <Border
            Grid.Row="0"
            ui:WindowDragBehavior.IsWindowDraggable="True"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    FontSize="15"
                    Foreground="{StaticResource DialogAccentBrush}"
                    Text="&#xf085;" />

                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="方案级运动卡资源：驱动 / 地址 / 轴映射 / 运动参数" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭">
                    <TextBlock
                        FontFamily="{StaticResource Icon}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <!--
                    左栏从 340 收到 264：它只放"卡名 + 地址 + 状态"三行字，
                    340 里有近一半是空白，看起来"内容散在两边"（用户反馈"整体过于稀疏"）。
                    省下的宽度给右侧的轴映射表 —— 那张表有 6 列，本来就嫌窄。
                -->
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左：运动卡列表 + 添加表单  ============  -->
            <Border Grid.Column="0" Style="{StaticResource DialogColumnCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource DialogColumnHeader}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Style="{StaticResource DialogColumnTitleIcon}"
                                    Text="&#xf0ce;" />
                                <TextBlock Style="{StaticResource DialogColumnTitle}" Text="运动卡" />
                            </StackPanel>
                            <Button
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding AddCommand}"
                                Content="+ 添加"
                                Style="{StaticResource DialogTagButton}"
                                ToolTip="添加一张运动卡（驱动类型 + 连接地址）" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox
                            Margin="4"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource DialogOptionItem}"
                            ItemsSource="{Binding Cards}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedCard}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  状态点：在线绿 / 报警红 / 其它灰  -->
                                        <Ellipse
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="0"
                                            Width="8"
                                            Height="8"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Online">
                                                            <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Alarm">
                                                            <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="SafeStopped">
                                                            <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding Caption}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="{Binding Address}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="{Binding StateText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  空状态  -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={ui:BooleanToVisibilityConverter}}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="22"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="&#xf085;" />
                            <TextBlock
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource DialogHintText}"
                                Text="还没有配置运动卡&#x0a;点右上「+ 添加」开始" />
                        </StackPanel>

                        <!--  添加表单  -->
                        <Border
                            Margin="10"
                            Padding="14"
                            VerticalAlignment="Center"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogAccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsAdding, Converter={ui:BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="驱动类型" />
                                <ComboBox
                                    Margin="0,0,0,10"
                                    ItemTemplate="{StaticResource DialogDisplayNameTemplate}"
                                    ItemsSource="{Binding AvailableDrivers}"
                                    SelectedItem="{Binding NewDriver}"
                                    Style="{StaticResource DialogCombo}" />

                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="连接地址" />
                                <TextBox
                                    Margin="0,0,0,4"
                                    Style="{StaticResource DialogInput}"
                                    Tag="正运动为卡 IP，如 192.168.0.11"
                                    Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0,0,0,10"
                                    Style="{StaticResource DialogHintText}"
                                    Text="地址是流程引用这张卡的键，必须唯一" />

                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="显示名（可留空）" />
                                <TextBox
                                    Margin="0,0,0,10"
                                    Style="{StaticResource DialogInput}"
                                    Tag="如：上料轴卡"
                                    Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="机型（可留空）" />
                                <TextBox
                                    Margin="0,0,0,10"
                                    Style="{StaticResource DialogInput}"
                                    Tag="如 ECI3428；留空则由驱动询问卡"
                                    Text="{Binding NewCardModel, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        MinWidth="80"
                                        Command="{Binding CancelAddCommand}"
                                        Content="取消"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                    <Button
                                        MinWidth="90"
                                        Margin="10,0,0,0"
                                        Command="{Binding ConfirmAddCommand}"
                                        Content="确定添加"
                                        Style="{StaticResource DialogPrimaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="12,10"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock
                            Style="{StaticResource DialogHintText}"
                            Text="配置随方案保存（.vms）；勾了「自动连接」的卡在软件启动时自动连。" />
                    </Border>
                </Grid>
            </Border>

            <!--  ============ 右：选中卡的详情  ============  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  提示：未选中  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource Icon}"
                        FontSize="26"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="&#xf0a0;" />
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource DialogHintText}"
                        Text="从左侧选择一张运动卡，或点「+ 添加」新建一张" />
                </StackPanel>

                <!--  卡信息 + 操作  -->
                <Border
                    Grid.Row="0"
                    Style="{StaticResource DialogColumnCard}"
                    Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}}">
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding SelectedCard.Caption}" />
                                <Border
                                    Margin="10,0,0,0"
                                    Background="{StaticResource DialogAccentLightBrush}"
                                    Style="{StaticResource DialogChip}">
                                    <TextBlock
                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                        Style="{StaticResource DialogChipText}"
                                        Text="{Binding SelectedCard.StateText}" />
                                </Border>
                                <Border
                                    Margin="6,0,0,0"
                                    Background="{StaticResource DialogRowHoverBrush}"
                                    Style="{StaticResource DialogChip}">
                                    <TextBlock
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Style="{StaticResource DialogChipText}"
                                        Text="{Binding SelectedCard.DriverDisplayName}" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource DialogHintText}"
                                Text="{Binding SelectedCard.StateDetail}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                MinWidth="90"
                                Command="{Binding ClearAlarmCommand}"
                                Content="清除报警"
                                Style="{StaticResource DialogSecondaryButton}"
                                ToolTip="清除伺服/驱动器报警（人工确认的动作，不会自动重试）" />
                            <Button
                                MinWidth="90"
                                Margin="10,0,0,0"
                                Command="{Binding ToggleConnectCommand}"
                                Content="连接 / 断开"
                                Style="{StaticResource DialogPrimaryButton}" />
                            <Button
                                MinWidth="70"
                                Margin="10,0,0,0"
                                Command="{Binding DeleteCommand}"
                                CommandParameter="{Binding SelectedCard}"
                                Content="删除"
                                Style="{StaticResource DialogSecondaryButton}"
                                ToolTip="从方案中删除该卡（会立即断开物理连接）" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  参数  -->
                <Border
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    Style="{StaticResource DialogColumnCard}"
                    Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}}">
                    <StackPanel Margin="16,14">
                        <TextBlock Style="{StaticResource DialogCardTitle}" Text="设备标识" />

                        <!--
                            设备名：一张卡时无所谓，两张卡以上就必需 ——
                            列表里只显示 IP 的话（127.0.0.1 / 192.168.0.11）根本认不出哪个是上料、哪个是下料。

                            这里是**已添加的卡**改名的地方：新增对话框里能填，但加完就没入口了，
                            而"现场接线接完才发现该改个名字"是常态。
                            改名不影响流程 —— 流程引用设备用的是地址（见 MotionDescriptor 的注释），
                            所以下面对应候选下拉显示的也是「设备名（地址）」这种"显示归显示、值归值"的形式。
                        -->
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource DialogFormLabel}" Text="设备名（可留空；留空则显示地址）" />
                            <TextBox
                                Style="{StaticResource DialogInput}"
                                Tag="如：上料轴卡"
                                Text="{Binding SelectedCard.DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,16,0,0"
                            Style="{StaticResource DialogCardTitle}"
                            Text="运动参数" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="默认速度 (mm/s)" />
                                <TextBox Style="{StaticResource DialogInput}" Text="{Binding DefaultVelocity, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="默认加速度 (mm/s²)" />
                                <TextBox Style="{StaticResource DialogInput}" Text="{Binding DefaultAccel, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="命令超时 (ms)" />
                                <TextBox Style="{StaticResource DialogInput}" Text="{Binding CommandTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="状态轮询周期 (ms)" />
                                <TextBox Style="{StaticResource DialogInput}" Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="看门狗超时 (ms)" />
                                <TextBox Style="{StaticResource DialogInput}" Text="{Binding WatchdogTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <CheckBox
                                    Content="随方案启动自动连接"
                                    IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                                    Style="{StaticResource DialogCheckBox}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource DialogHintText}"
                            Text="轮询周期决定报警/限位多久被发现（越小越灵敏，但网口卡通信压力越大）；看门狗超时后卡会被判失联并安全停机。" />

                        <Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            MinWidth="120"
                            Command="{Binding ApplyParamsCommand}"
                            Content="应用参数与轴映射"
                            Style="{StaticResource DialogPrimaryButton}" />
                    </StackPanel>
                </Border>

                <!--  轴映射表：逻辑名是流程引用轴的方式；脉冲当量与软限位直接决定会不会撞机  -->
                <Border
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Style="{StaticResource DialogColumnCard}"
                    Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DialogColumnHeader}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Style="{StaticResource DialogColumnTitleIcon}"
                                    Text="&#xf0d1;" />
                                <TextBlock Style="{StaticResource DialogColumnTitle}" Text="轴映射" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="流程按「逻辑名」引用轴；脉冲当量与软限位请按机械标定填写" />
                            </StackPanel>
                        </Border>

                        <!--
                            ★ MinHeight 是必需的，不是"好看一点"：
                            DataGrid 所在行是 *（吃剩余空间），而上方"卡信息 + 运动参数"两个 Auto 行
                            在默认窗口高度下会把空间吃光 —— 表格只剩表头高，
                            用户看到的就是"轴映射是空的，必须手动拉大窗口才行"。
                            给一个下限之后，它至少能露出表头 + 两行数据，
                            同时整窗 MinHeight 也提到了 700 给它留位置。
                        -->
                        <DataGrid
                            Grid.Row="1"
                            MinHeight="180"
                            Margin="10,8,10,10"
                            CanUserAddRows="False"
                            ItemsSource="{Binding SelectedCard.Axes}"
                            RowHeaderWidth="0"
                            Style="{StaticResource DialogDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding LogicalName, UpdateSourceTrigger=PropertyChanged}"
                                    Header="逻辑名" />
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding PhysicalIndex}"
                                    Header="物理轴号"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding UnitsPerMm, UpdateSourceTrigger=PropertyChanged}"
                                    Header="脉冲当量/毫米" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding SoftLimitMinMm, UpdateSourceTrigger=PropertyChanged}"
                                    Header="软限位下限(mm)" />
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding SoftLimitMaxMm, UpdateSourceTrigger=PropertyChanged}"
                                    Header="软限位上限(mm)" />
                                <DataGridTemplateColumn Width="80" Header="启用">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                Style="{StaticResource DialogCheckBox}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!--  运行状态 / 提示  -->
                <StackPanel
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource DialogInfoPanel}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="命令：" />
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding SelectedCard.ExecutedCommandCount, StringFormat='已执行 {0}'}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding SelectedCard.RejectedCommandCount, StringFormat='已拒绝 {0}'}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding SelectedCard.FaultCount, StringFormat='故障 {0}'}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="需要回零后才能运动"
                                    Visibility="{Binding SelectedCard.RequiresHoming, Converter={ui:BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource DialogHintText}"
                                Text="{Binding SelectedCard.LastFaultText}" />

                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource DialogHintText}"
                                Text="{Binding StatusHint}" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="0,10,0,0"
