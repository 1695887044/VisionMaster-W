<UserControl
    x:Class="VisionMaster.Views.DialogViews.IoConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource DialogBackgroundBrush}">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1180" />
            <Setter Property="Height" Value="720" />
            <Setter Property="MinWidth" Value="980" />
            <Setter Property="MinHeight" Value="560" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            ui:WindowDragBehavior.IsWindowDraggable="True"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    FontSize="15"
                    Foreground="{StaticResource DialogAccentBrush}"
                    Text="&#xf0e8;" />

                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="方案级 IO 总线 / 设备 / 点位配置" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭">
                    <TextBlock
                        FontFamily="{StaticResource Icon}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                <Button Content="添加总线" Command="{Binding AddBusCommand}" Margin="0,0,8,0" />
                <Button Content="添加设备" Command="{Binding AddDeviceCommand}" Margin="0,0,8,0" />
                <Button Content="添加点位" Command="{Binding AddPointCommand}" Margin="0,0,8,0" />
                <Button Content="删除选中" Command="{Binding RemoveCommand}" Margin="0,0,20,0" />
                <Button Content="应用配置" Command="{Binding ApplyCommand}" Margin="0,0,8,0" />
                <Button Content="测试连接" Command="{Binding TestCommand}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="总线">
                    <ListBox
                        ItemsSource="{Binding Buses}"
                        SelectedItem="{Binding SelectedBus}"
                        DisplayMemberPath="BusId"
                        Margin="4" />
                </GroupBox>

                <GroupBox Grid.Column="2" Header="设备">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ComboBox
                            Grid.Row="0"
                            Margin="0,0,0,6"
                            ItemsSource="{Binding DriverOptions}"
                            DisplayMemberPath="DisplayName"
                            SelectedValuePath="DriverId"
                            SelectedValue="{Binding SelectedDevice.DriverId, Mode=TwoWay}" />
                        <ListBox
                            Grid.Row="1"
                            ItemsSource="{Binding Devices}"
                            SelectedItem="{Binding SelectedDevice}"
                            DisplayMemberPath="DeviceId" />
                    </Grid>
                </GroupBox>

                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="点位">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    VerticalContentAlignment="Center"
                                    ToolTip="按点位标识 / 显示名 / 地址 / 说明过滤（大小写不敏感）"
                                    Text="{Binding PointSearch, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding PointsSummary}" />
                            </Grid>

                            <!--
                                虚拟化显式声明：点位上百时 ListBox 默认的 VirtualizingStackPanel
                                在套了 GroupBox/自定义模板后可能被替换成普通 StackPanel，
                                那时所有行都会被实例化（切设备明显卡顿）。
                                Recycling 让滚动时复用容器，而不是每次重建。
                            -->
                            <ListBox
                                Grid.Row="1"
                                ItemsSource="{Binding FilteredPoints}"
                                SelectedItem="{Binding SelectedPoint}"
                                DisplayMemberPath="PointId"
                                ScrollViewer.CanContentScroll="True"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="属性">
                        <ui:FlatPropertyGrid BindingObject="{Binding SelectedObject}" Margin="4" />
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
