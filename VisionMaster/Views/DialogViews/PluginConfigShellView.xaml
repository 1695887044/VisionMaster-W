<UserControl
    x:Class="VisionMaster.Views.DialogViews.PluginConfigShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VisionMaster.Views.DialogViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--  窗口：固定初始尺寸 + 允许调整大小（不用 SizeToContent，否则手动放大后内容不会重新布局填满）  -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="Width" Value="880" />
            <Setter Property="Height" Value="600" />
            <Setter Property="MinWidth" Value="640" />
            <Setter Property="MinHeight" Value="420" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <Style x:Key="HeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA" />
            <Setter Property="BorderBrush" Value="#EBEEF5" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
        </Style>

        <Style x:Key="FooterBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA" />
            <Setter Property="BorderBrush" Value="#EBEEF5" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>

        <Style x:Key="StatusSuccessStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#67C23A" />
        </Style>

        <Style x:Key="StatusFailStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F56C6C" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Direction="270"
                    Opacity="0.15"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <!--  顶部：插件图标 + 名称  -->
                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Style="{StaticResource HeaderBorderStyle}">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  插件图标  -->
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="22"
                            Foreground="#409EFF"
                            Text="{Binding PluginIcon}" />

                        <!--  插件名称 + 描述  -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#303133"
                                Text="{Binding PluginName}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="#909399"
                                Text="{Binding PluginDescription}" />
                        </StackPanel>

                        <!--  执行中指示  -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                FontSize="12"
                                Foreground="#E6A23C"
                                Text="⏳ 执行中"
                                Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  中间：插件自定义视图注入区  -->
                <ContentPresenter
                    Grid.Row="1"
                    Margin="8"
                    Content="{Binding PluginViewContent}" />

                <!--  底部：状态 + 耗时 + 按钮  -->
                <Border Grid.Row="2" Style="{StaticResource FooterBorderStyle}">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  左侧状态信息  -->
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="12"
                                Foreground="#606266"
                                Text="{Binding StatusText}" />
                            <TextBlock
                                Margin="16,0,0,0"
                                FontSize="12"
                                Foreground="#909399"
                                Text="{Binding ElapsedText}" />
                        </StackPanel>

                        <!--  右侧按钮  -->
                        <StackPanel
                            Grid.Column="1"
                            Background="Transparent"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,10,0"
                                Padding="24,6"
                                Background="#FFFFFF"
                                BorderBrush="#DCDFE6"
                                Command="{Binding ExecuteCommand}"
                                Content="执行"
                                Cursor="Hand"
                                IsEnabled="{Binding CanExecute}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button
                                Margin="0,0,10,0"
                                Padding="24,6"
                                Background="#FFFFFF"
                                BorderBrush="#DCDFE6"
                                Command="{Binding CancelCommand}"
                                Content="取消"
                                Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button
                                Padding="24,6"
                                Background="#409EFF"
                                BorderThickness="0"
                                Command="{Binding ConfirmCommand}"
                                Content="确认"
                                Cursor="Hand"
                                FontWeight="SemiBold"
                                Foreground="White">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
