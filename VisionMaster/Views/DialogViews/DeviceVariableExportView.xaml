<UserControl
    x:Class="VisionMaster.Views.DialogViews.DeviceVariableExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Background="{StaticResource DialogSurfaceBrush}"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        ============================================================================
        单设备变量表导出（xlsx）
        ============================================================================
        范围二选一（全部 / 当前显示分组），选项控制说明页与地址预览列，路径可浏览。
        地址是结构化列（存储区 / 偏移 / 位偏移 / 站号 / DB号 …），不是复合地址串；
        地址预览列只读，导入端明确忽略。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="620" />
            <Setter Property="Height" Value="560" />
            <Setter Property="MinWidth" Value="580" />
            <Setter Property="MinHeight" Value="520" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Height="66"
            Padding="18,0"
            Background="Transparent"
            Style="{StaticResource DialogCardHeader}"
            ui:WindowDragBehavior.IsWindowDraggable="True">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{StaticResource DialogAccentLightBrush}"
                        CornerRadius="9">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="15"
                            Foreground="{StaticResource DialogAccentTextBrush}"
                            Text="&#xf019;" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="{Binding Title}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Button
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭">
                    <TextBlock
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="13"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <!--  正文  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,16,18,8">

                <!--  导出范围  -->
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="导出范围" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  全部变量  -->
                    <RadioButton
                        Grid.Column="0"
                        GroupName="ExportScope"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsChecked="{Binding IsAllScope, Mode=TwoWay}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border
                                    x:Name="Card"
                                    MinHeight="78"
                                    Padding="12,10"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource DialogSurfaceBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="15"
                                Foreground="{StaticResource DialogAccentTextBrush}"
                                Text="&#xf0ca;" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="9,0,6,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="全部变量" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="该设备的全部网络变量" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogAccentTextBrush}"
                                Text="{Binding AllCount}" />
                        </Grid>
                    </RadioButton>

                    <!--  当前分组  -->
                    <RadioButton
                        Grid.Column="2"
                        GroupName="ExportScope"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsChecked="{Binding IsCurrentGroupScope, Mode=TwoWay}"
                        IsEnabled="{Binding HasCurrentGroup}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border
                                    x:Name="Card"
                                    MinHeight="78"
                                    Padding="12,10"
                                    HorizontalAlignment="Stretch"
                                    Background="{StaticResource DialogSurfaceBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="15"
                                Foreground="{StaticResource DialogAccentTextBrush}"
                                Text="&#xf02b;" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="9,0,6,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="当前分组"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="{Binding CurrentGroupName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="先在左栏选中一个分组"
                                    Visibility="{Binding HasCurrentGroup, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogAccentTextBrush}"
                                Text="{Binding CurrentGroupCount}" />
                        </Grid>
                    </RadioButton>
                </Grid>

                <!--  选项  -->
                <TextBlock
                    Margin="0,16,0,8"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="选项" />
                <StackPanel>
                    <CheckBox
                        Content="附带「说明」页（协议 / 存储区 / 数据类型 / 扫描组候选）"
                        IsChecked="{Binding IncludeGuideSheet, Mode=TwoWay}"
                        Style="{StaticResource DialogCheckBox}" />
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="附带「地址预览」列（只读，导入时忽略）"
                        IsChecked="{Binding IncludeAddressPreview, Mode=TwoWay}"
                        Style="{StaticResource DialogCheckBox}" />
                </StackPanel>

                <!--  保存位置  -->
                <TextBlock
                    Margin="0,16,0,8"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="保存到" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Height="34"
                        Padding="9,0"
                        VerticalContentAlignment="Center"
                        IsReadOnly="True"
                        Style="{StaticResource DialogInput}"
                        Text="{Binding ExportPath}"
                        ToolTip="{Binding ExportPath}" />
                    <Button
                        Grid.Column="1"
                        Height="34"
                        Margin="8,0,0,0"
                        Padding="14,0"
                        Command="{Binding BrowseCommand}"
                        Content="浏览…"
                        Style="{StaticResource DialogSecondaryButton}" />
                </Grid>

                <!--  汇总  -->
                <Border
                    Margin="0,14,0,0"
                    Padding="12,10"
                    Background="{StaticResource DialogAccentLightBrush}"
                    BorderBrush="{StaticResource DialogAccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Top"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="12"
                            Foreground="{StaticResource DialogAccentTextBrush}"
                            Text="&#xf05a;" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogAccentTextBrush}"
                            Text="{Binding Summary}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  底栏  -->
        <Grid
            Grid.Row="2"
            Margin="18,8,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource DialogTextMutedBrush}"
                Text="导入按变量名匹配；地址预览列不会被回读。"
                TextWrapping="Wrap" />
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="96"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Style="{StaticResource DialogSecondaryButton}" />
                <Button
                    Width="110"
                    Margin="10,0,0,0"
                    Command="{Binding ExportCommand}"
                    Content="导 出"
                    Style="{StaticResource DialogPrimaryButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
