<UserControl
    x:Class="VisionMaster.Views.DialogViews.ArrayEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Background="{StaticResource DialogSurfaceBrush}"
    mc:Ignorable="d">

    <!--
        ============================================================================
        编辑数组（变量管理 → 数组根「编辑数组…」）
        ============================================================================
        设计基线：docs\UI设计基线\global-variables\design.html（v3 数组编辑弹窗专项优化）

        语义（与旧「强制覆盖集合...」的区别）：
          ① 装填的是**当前值**，不是 DefaultValue；
          ② 写入范围默认「只写当前值」；选「同时写初始值」才写基准；
          ③ 校验在弹窗内完成——出错项标红 + 底部「第 N 项：…」，弹窗不关、编辑不丢。

        v3 信息层级：
          · 写入范围是分段选择，下方一句话随选择说明后果；
          · 每行显示「基准：…」与行尾 ↺（仅改过的行）；
          · 底部汇总「N 项已修改」+「恢复全部为基准」。

        样式纪律：本视图属于 CollectedDialogViews——禁止本地 keyed Style；
        颜色一律 Dialog* 令牌，视图零十六进制。
    -->

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="640" />
            <Setter Property="Height" Value="660" />
            <Setter Property="MinWidth" Value="540" />
            <Setter Property="MinHeight" Value="540" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="20,18,20,16">
        <Border Style="{StaticResource DialogCardShadow}" />
        <Border Style="{StaticResource DialogCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题栏（无系统边框的弹窗靠它拖动）  -->
                <Border
                    Grid.Row="0"
                    Background="Transparent"
                    Style="{StaticResource DialogCardHeader}"
                    ui:WindowDragBehavior.IsWindowDraggable="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="34"
                            Height="34"
                            VerticalAlignment="Center"
                            Background="{StaticResource DialogTypeArraySoftBrush}"
                            CornerRadius="9">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="15"
                                Foreground="{StaticResource DialogTypeArrayTextBrush}"
                                Text="&#xf0cb;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14.5"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="{Binding Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{Binding CancelCommand}"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            Style="{StaticResource DialogIconButton}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="关闭（Esc）" />
                            </Button.ToolTip>
                            <TextBlock
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="13"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="&#xf00d;" />
                        </Button>
                    </Grid>
                </Border>

                <!--  内容区：写入范围 / 列头 / 列表 / 错误条  -->
                <Grid Grid.Row="1" Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  写入范围：分段选择 + 后果说明（网络数组没有基准，整块隐藏）  -->
                    <Border
                        Grid.Row="0"
                        Padding="12,10"
                        Background="{StaticResource DialogSurfaceBrush}"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding ShowBaselineControls, Converter={ui:BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="写入范围" />

                                <Border
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Padding="2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DialogRowHoverBrush}"
                                    CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <!--
                                            用 Button + DataTrigger 而不是 ToggleButton：
                                            ToggleButton 会先在本地翻转 IsChecked，命令再写回同一个值时
                                            （OneWay 绑定）模型不发通知，段会停在"两段都没选中"。
                                        -->
                                        <Button
                                            Height="26"
                                            Padding="10,0"
                                            Command="{Binding WriteCurrentOnlyCommand}"
                                            Content="只写当前值"
                                            Cursor="Hand"
                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                            FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentOnly}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button
                                            Height="26"
                                            Padding="10,0"
                                            Command="{Binding WriteBothCommand}"
                                            Content="同时写初始值"
                                            Cursor="Hand"
                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                            FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border
                                                                    Padding="{TemplateBinding Padding}"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SyncBaseline}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="{Binding BaselineHint}" />
                            </Grid>

                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="{Binding ScopeHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  列头  -->
                    <Grid Grid.Row="1" Height="26" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="108" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="序号" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="元素值" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="操作" />
                    </Grid>

                    <!--  列表 + 空态  -->
                    <Border
                        Grid.Row="2"
                        Background="{StaticResource DialogRowAlternateBrush}"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <ScrollViewer
                                Padding="6"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Elements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="108" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding IndexText}" />

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">
                                                    <TextBox
                                                        Height="30"
                                                        Padding="9,0"
                                                        VerticalContentAlignment="Center"
                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                        FontSize="11.5"
                                                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource DialogCellInput}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBrush}" />
                                                                        <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>

                                                    <!--  基准行：只在"改过"的行出现  -->
                                                    <StackPanel
                                                        Margin="0,2,0,0"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding IsChanged, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <Ellipse
                                                            Width="4"
                                                            Height="4"
                                                            Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            Fill="{StaticResource DialogWarningBrush}" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="10"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="基准：" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="10"
                                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                            Text="{Binding BaselineText}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        Width="24"
                                                        Height="24"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.ResetRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                        Style="{StaticResource DialogIconButton}"
                                                        Visibility="{Binding IsChanged, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="恢复为基准值" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                                            Text="&#xf0e2;" />
                                                    </Button>
                                                    <Button
                                                        Width="24"
                                                        Height="24"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Margin="2,0,0,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        Style="{StaticResource DialogIconButton}"
                                                        Visibility="{Binding DataContext.CanEditStructure, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="上移" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf077;" />
                                                    </Button>
                                                    <Button
                                                        Width="24"
                                                        Height="24"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Margin="2,0,0,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Style="{StaticResource DialogIconButton}"
                                                        Visibility="{Binding DataContext.CanEditStructure, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="下移" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf078;" />
                                                    </Button>
                                                    <Button
                                                        Width="24"
                                                        Height="24"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Margin="2,0,0,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                        Style="{StaticResource DialogIconButton}"
                                                        Visibility="{Binding DataContext.CanEditStructure, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="删除该元素" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogDangerBrush}"
                                                            Text="&#xf2ed;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!--  空态：新建数组是 0 项，必须明确告诉用户怎么开始  -->
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Elements.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="22"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="&#xf0cb;" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="还没有元素，点下方「添加元素」开始" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  校验失败：出错项已在行内标红，这里给完整原因  -->
                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="10,8"
                        Background="{StaticResource DialogDangerSubtleBrush}"
                        BorderBrush="{StaticResource DialogDangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding HasError, Converter={ui:BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,1,6,0"
                                VerticalAlignment="Top"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="11"
                                Foreground="{StaticResource DialogDangerTextBrush}"
                                Text="&#xf071;" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="11"
                                Foreground="{StaticResource DialogDangerTextBrush}"
                                Text="{Binding ErrorText}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>

                <!--  底部：添加 / 计数 / 修改汇总 / 恢复全部 / 取消 + 确定  -->
                <Border
                    Grid.Row="2"
                    Height="56"
                    Padding="18,0"
                    Background="{StaticResource DialogRowAlternateBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Button
                                Height="32"
                                Padding="12,0"
                                Command="{Binding AddCommand}"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                Style="{StaticResource DialogSecondaryButton}"
                                Visibility="{Binding CanEditStructure, Converter={ui:BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="11"
                                        Text="&#xf067;" />
                                    <TextBlock VerticalAlignment="Center" Text="添加元素" />
                                </StackPanel>
                            </Button>

                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}">
                                <Run Text="共" />
                                <Run Text="{Binding Elements.Count, Mode=OneWay}" />
                                <Run Text="个元素" />
                            </TextBlock>

                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Text="{Binding FooterSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button
                                Height="30"
                                Margin="10,0,0,0"
                                Padding="10,0"
                                Command="{Binding ResetAllCommand}"
                                Content="恢复全部为基准"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                FontSize="11"
                                IsEnabled="{Binding HasChanges}"
                                Style="{StaticResource DialogSecondaryButton}"
                                Visibility="{Binding ShowBaselineControls, Converter={ui:BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Height="32"
                                MinWidth="80"
                                Command="{Binding CancelCommand}"
                                Content="取消"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                Style="{StaticResource DialogSecondaryButton}" />
                            <Button
                                Height="32"
                                MinWidth="88"
                                Margin="8,0,0,0"
                                Command="{Binding ConfirmCommand}"
                                Content="确定"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                IsEnabled="{Binding CanConfirm}"
                                Style="{StaticResource DialogPrimaryButton}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
