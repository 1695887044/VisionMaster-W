<UserControl
    x:Class="VisionMaster.Views.DialogViews.GlobalVariableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisionMaster.Views.DialogViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="1240"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F1F5F9"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  ============ 颜色 Token（设计图主色：青蓝 #0EA5E9）  ============ -->
        <Color x:Key="PrimaryColor">#0EA5E9</Color>
        <Color x:Key="PrimaryDarkColor">#0284C7</Color>
        <Color x:Key="PrimaryLightColor">#E0F2FE</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0EA5E9" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0284C7" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#E0F2FE" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0369A1" />

        <SolidColorBrush x:Key="BgBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="CardBgBrush" Color="White" />
        <SolidColorBrush x:Key="InputBgBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#EEF2F7" />

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />

        <!--  ============ 卡片容器  ============ -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <!--  ============ 表单标签  ============ -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  ============ 输入控件（浅灰背景 + 聚焦青蓝边框）  ============ -->
        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectedItem}"
                                    ContentTemplate="{TemplateBinding ItemTemplate}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <Path
                                    Grid.Column="1"
                                    Width="10"
                                    Height="10"
                                    Margin="0,0,12,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0,0 L5,5 L10,0"
                                    Stretch="Uniform"
                                    Stroke="#94A3B8"
                                    StrokeThickness="1.5" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ============ 主操作按钮（青蓝渐变 + 按压反馈）  ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#38BDF8" Offset="0" />
                                    <GradientStop Color="#0EA5E9" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ============ 行内图标按钮（操作列，hover 圆形底色）  ============ -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2F4F7" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ============ 在线状态圆点  ============ -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  ============ DataGrid 系列  ============ -->
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="48" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderLightBrush}" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />
            <Setter Property="AlternationCount" Value="2" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <!--  ============ 来源树节点项（选中左侧色条 + 浅蓝底）  ============ -->
        <DataTemplate x:Key="SourceNodeTemplate">
            <Border
                x:Name="NodeBorder"
                Height="40"
                Margin="6,2"
                Padding="10,0"
                Background="Transparent"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  选中态左侧色条  -->
                    <Border
                        x:Name="Indicator"
                        Width="3"
                        Margin="-10,6,8,6"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />

                    <TextBlock
                        Grid.Column="0"
                        Width="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Icon}"
                        FontSize="13"
                        Text="{Binding Icon}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{Binding DisplayName}" />

                    <!--  在线圆点（仅网络来源）  -->
                    <Ellipse
                        Grid.Column="2"
                        Width="7"
                        Height="7"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource SuccessBrush}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNetwork}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!--  计数徽标  -->
                    <Border
                        Grid.Column="3"
                        MinWidth="20"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="#F1F5F9"
                        CornerRadius="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{Binding Count}" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NodeBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="NodeBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="NodeBorder" Property="Background" Value="#F8FAFC" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="285" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左栏：变量来源树  ============ -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="8,8,8,10"
                    Orientation="Horizontal">
                    <TextBlock
                        FontFamily="{StaticResource Icon}"
                        FontSize="14"
                        Foreground="#409EFF"
                        Text="&#xf0c9;" />
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#303133"
                        Text="变量来源" />
                </StackPanel>

                <ListBox
                    Grid.Row="1"
                    Margin="0,0,0,4"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemTemplate="{StaticResource SourceNodeTemplate}"
                    ItemsSource="{Binding SourceNodes}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedSource}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!--  ============ 中栏：新建变量  ============ -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <Grid Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="2,2,0,0">

                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#303133"
                        Text="新建变量" />

                    <!--  本地/网络 胶囊切换  -->
                    <Border
                        Height="36"
                        Margin="0,0,0,14"
                        Padding="3"
                        Background="#EEF0F3"
                        CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton
                                Grid.Column="0"
                                GroupName="SourceCapsule"
                                IsChecked="{Binding IsLocalSource, Mode=TwoWay}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border
                                            x:Name="Bg"
                                            Background="Transparent"
                                            CornerRadius="6">
                                            <TextBlock
                                                x:Name="Text"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="#6B7280"
                                                Text="本地变量" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#E2E8F0" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="Text" Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <RadioButton
                                Grid.Column="1"
                                GroupName="SourceCapsule"
                                IsChecked="{Binding IsNetworkSource, Mode=TwoWay}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border
                                            x:Name="Bg"
                                            Background="Transparent"
                                            CornerRadius="6">
                                            <TextBlock
                                                x:Name="Text"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="#6B7280"
                                                Text="网络变量" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#E2E8F0" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="Text" Property="Foreground" Value="White" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <!--  变量名称  -->
                    <TextBlock Style="{StaticResource FormLabel}" Text="变量名称" />
                    <TextBox
                        Margin="0,0,0,12"
                        Style="{StaticResource ModernInput}"
                        Text="{Binding NewVarName, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  数据类型  -->
                    <TextBlock Style="{StaticResource FormLabel}" Text="数据类型" />
                    <ComboBox
                        Margin="0,0,0,12"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding FilteredTypes}"
                        SelectedItem="{Binding SelectedType}"
                        Style="{StaticResource ModernCombo}" />

                    <!--  变量描述  -->
                    <TextBlock Style="{StaticResource FormLabel}" Text="变量描述 (选填)" />
                    <TextBox
                        Height="42"
                        Margin="0,0,0,12"
                        AcceptsReturn="True"
                        Style="{StaticResource ModernInput}"
                        Text="{Binding NewVarDescription, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <!--  ============ 网络专属配置区（浅底分组）  ============ -->
                    <Border
                        Padding="12,12"
                        Background="#F0F9FF"
                        BorderBrush="#BAE6FD"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNetworkSource}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FormLabel}" Text="所属连接" />
                            <ComboBox
                                Margin="0,0,0,10"
                                DisplayMemberPath="ConnectionName"
                                ItemsSource="{Binding Connections}"
                                SelectedItem="{Binding SelectedConnection}"
                                Style="{StaticResource ModernCombo}" />

                            <TextBlock Style="{StaticResource FormLabel}" Text="存储区" />
                            <ComboBox
                                Margin="0,0,0,10"
                                ItemsSource="{Binding AreaOptions}"
                                SelectedItem="{Binding SelectedAreaType}"
                                Style="{StaticResource ModernCombo}" />

                            <UniformGrid Margin="0,0,0,10" Columns="3">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="偏移量" />
                                    <TextBox
                                        Style="{StaticResource ModernInput}"
                                        Text="{Binding NewOffset, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="位偏移" />
                                    <TextBox
                                        Style="{StaticResource ModernInput}"
                                        Text="{Binding NewBitOffset, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="轮询(ms)" />
                                    <TextBox
                                        Style="{StaticResource ModernInput}"
                                        Text="{Binding NewPollIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="地址：" />
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding NewOffset}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    FontSize="11.5"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="协议：" />
                                <TextBlock
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding SelectedConnection.Protocol}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  网络模式提示（线圈区布尔说明）  -->
                    <TextBlock
                        Margin="2,8,0,0"
                        FontSize="11"
                        Foreground="#E6A23C"
                        Text="线圈/离散输入区仅支持布尔类型，且不使用位偏移"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsNetworkSource}" Value="True" />
                                            <Condition Binding="{Binding IsCoilOrDiscrete}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button
                    Grid.Row="2"
                    Command="{Binding AddCommand}"
                    Content="＋ 创建变量"
                    Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>

        <!--  ============ 右栏：变量明细  ============ -->
        <Border Grid.Column="4" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题 + 搜索  -->
                <Border
                    Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="变量明细" />
                            <!--  变量数徽标  -->
                            <Border
                                Margin="8,0,0,0"
                                MinWidth="22"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="11">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding SelectedSource.Count, FallbackValue=0}" />
                            </Border>
                        </StackPanel>

                        <!--  搜索框  -->
                        <Border
                            Width="220"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{StaticResource InputBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="10,0,4,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="12"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="&#xf002;" />
                                <TextBox
                                    Grid.Column="1"
                                    Padding="0,0,10,0"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12.5"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <DataGrid
                    Grid.Row="1"
                    Margin="1"
                    HorizontalScrollBarVisibility="Disabled"
                    ItemsSource="{Binding FilteredDisplayNodes}">
                    <DataGrid.Columns>
                        <!--  变量名（树形缩进 + 展开按钮）  -->
                        <DataGridTemplateColumn Width="165" Header="变量名">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Margin="5,0,0,0"
                                        Background="Transparent"
                                        Orientation="Horizontal">
                                        <Border Width="{Binding Level, Converter={ui:LevelToIndentConverter}}" />
                                        <ToggleButton
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                            Template="{StaticResource ExpandToggleButtonTemplate}"
                                            Visibility="{Binding IsContainer, Converter={ui:BooleanToVisibilityConverter}}" />
                                        <Border Width="{Binding IsContainer, Converter={ui:BooleanToWidthConverter}, ConverterParameter=22}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="Foreground" Value="#303133" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="1">
                                                            <Setter Property="Foreground" Value="#909399" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  类型  -->
                        <DataGridTextColumn
                            Width="58"
                            Binding="{Binding TypeName}"
                            Header="类型"
                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="5,0" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="#909399" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!--  来源徽标（本地/连接名 + 在线圆点）  -->
                        <DataGridTemplateColumn Width="95" Header="来源">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsRootNode, Converter={ui:BooleanToVisibilityConverter}}">
                                        <Ellipse Style="{StaticResource StatusDot}" />
                                        <Border
                                            Margin="6,0,0,0"
                                            MaxWidth="70"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="#F4F4F5"
                                            CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F4F4F5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                            <Setter Property="Background" Value="#ECF5FF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                FontSize="11"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#67C23A" />
                                                        <Setter Property="Text" Value="{Binding SourceLabel}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                                <Setter Property="Foreground" Value="#409EFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  设备地址  -->
                        <DataGridTemplateColumn Width="78" Header="地址">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="#E6A23C"
                                        Text="{Binding Address}"
                                        ToolTip="{Binding Address}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  初始值  -->
                        <DataGridTemplateColumn Width="100" Header="初始值">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,0">
                                        <Border
                                            Height="26"
                                            Background="#FAFAFA"
                                            BorderBrush="#DCDFE6"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBox
                                                Padding="8,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="12"
                                                Foreground="#606266"
                                                Style="{x:Null}"
                                                Text="{Binding OriginalModel.DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding IsEditableNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                        </Border>
                                        <Button
                                            Command="{Binding DataContext.EditArrayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="编辑集合..."
                                            Style="{StaticResource LinkButtonStyle}"
                                            Visibility="{Binding IsArrayRootNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            Padding="2,0"
                                            VerticalAlignment="Center"
                                            Foreground="#606266"
                                            Text="{Binding ChildDefaultValue}"
                                            Visibility="{Binding IsChildNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  当前值（青蓝胶囊样式）  -->
                        <DataGridTemplateColumn Width="*" Header="当前值">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,0">
                                        <Border
                                            Height="26"
                                            MinWidth="40"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource PrimaryLightBrush}"
                                            CornerRadius="13"
                                            Visibility="{Binding IsRootNode, Converter={ui:BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <TextBlock
                                                    Padding="10,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource PrimaryTextBrush}"
                                                    Text="{Binding OriginalModel.Value, Mode=OneWay}"
                                                    Visibility="{Binding IsEditableNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                                <Button
                                                    Command="{Binding DataContext.EditArrayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="强制覆盖集合..."
                                                    Foreground="{StaticResource PrimaryTextBrush}"
                                                    Style="{StaticResource LinkButtonStyle}"
                                                    Visibility="{Binding IsArrayRootNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Padding="2,0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryTextBrush}"
                                            Text="{Binding ChildValue}"
                                            Visibility="{Binding IsChildNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  操作  -->
                        <DataGridTemplateColumn Width="132" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsRootNode, Converter={ui:BooleanToVisibilityConverter}}">
                                        <!--  复制变量名（HMI 组态预留入口）  -->
                                        <Button
                                            Command="{Binding DataContext.CopyNameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="复制变量名（供画布组态绑定）">
                                            <TextBlock
                                                FontFamily="{StaticResource Icon}"
                                                FontSize="13"
                                                Foreground="#909399"
                                                Text="&#xf0c5;" />
                                        </Button>
                                        <!--  写值到设备（仅网络变量）  -->
                                        <Button
                                            Command="{Binding DataContext.WriteValueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="写值到设备">
                                            <Button.Visibility>
                                                <Binding Path="IsNetwork" Converter="{ui:BooleanToVisibilityConverter}" />
                                            </Button.Visibility>
                                            <TextBlock
                                                FontFamily="{StaticResource Icon}"
                                                FontSize="13"
                                                Foreground="#409EFF"
                                                Text="&#xf093;" />
                                        </Button>
                                        <!--  恢复初始值  -->
                                        <Button
                                            Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="恢复初始值">
                                            <TextBlock
                                                FontFamily="{StaticResource Icon}"
                                                FontSize="13"
                                                Foreground="#E6A23C"
                                                Text="&#xf0e2;" />
                                        </Button>
                                        <!--  删除  -->
                                        <Button
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="删除">
                                            <TextBlock
                                                FontFamily="{StaticResource Icon}"
                                                FontSize="13"
                                                Foreground="#F56C6C"
                                                Text="&#xf1f8;" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  底部提示  -->
                <TextBlock
                    Grid.Row="2"
                    Margin="16,10"
                    FontSize="11"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="* 当前值反映运行时实时采集结果，支持手动写入覆盖。" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
