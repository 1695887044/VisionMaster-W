<UserControl
    x:Class="VisionMaster.Views.DialogViews.GlobalVariableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:VisionMaster.Helpers"
    xmlns:local="clr-namespace:VisionMaster.Views.DialogViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.UI.com/ui"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource DialogSurfaceBrush}"
    mc:Ignorable="d">

    <!--
        ============================================================================
        变量管理（Web 设计基线 v1：来源导航 + 变量明细）
        ============================================================================
        结构：左栏 232 来源导航（按 IsNetwork 分「本地与系统 / 通信连接」两组）；
              右栏 60 卡片头 + DataGrid + 34 状态条（设计 64/40，按一屏行数取舍）。
        纪律：本视图属于 VariableBindingCheck 的 CollectedDialogViews——
              禁止本地 <Style x:Key=...>；只用无 key 内联 Style / DataTemplate / ControlTemplate。
              颜色一律 Dialog* / Logic* / DialogTypeArray* 令牌，视图零十六进制。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1300" />
            <Setter Property="Height" Value="700" />
            <Setter Property="MinWidth" Value="1200" />
            <Setter Property="MinHeight" Value="580" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <local:TypeAbbreviationConverter x:Key="TypeAbbreviationConverter" />
        <local:DataTypeBrushConverter x:Key="DataTypeBrushConverter" />
        <local:GlobalVariableValueModeConverter x:Key="GlobalVariableValueModeConverter" />
        <local:EmptyStateVisibilityConverter x:Key="EmptyStateVisibilityConverter" />
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />

        <!--
            来源卡片：48px，图标块 + 名称 + 副行 + 计数。
            选中 = 白卡 + 主色左条；悬停 = 白卡；键盘焦点 = 主色描边；禁用 = 半透明。
        -->
        <DataTemplate x:Key="GvSourceNodeTemplate">
            <Grid>
                <Border
                    x:Name="NodeBorder"
                    Height="48"
                    Margin="0,2"
                    Padding="10,6,8,6"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="IconTile"
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            Margin="0,0,9,0"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Key}" Value="System">
                                            <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="13"
                                Text="{Binding Icon}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Key}" Value="System">
                                                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <TextBlock
                                x:Name="SourceName"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel
                                Margin="0,2,0,0"
                                Orientation="Horizontal">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="System">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="{Binding Subtitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            x:Name="CountBadge"
                            Grid.Column="2"
                            MinWidth="20"
                            Height="20"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Style>
                            </Border.Style>
                            <TextBlock
                                x:Name="CountText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding Count}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="10.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <Border
                    x:Name="Indicator"
                    Width="3"
                    Margin="0,10,0,10"
                    HorizontalAlignment="Left"
                    Background="{StaticResource DialogAccentBrush}"
                    CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NodeBorder" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SourceName" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    <Setter TargetName="CountBadge" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                    <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                </DataTrigger>
                <Trigger SourceName="NodeBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="NodeBorder" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                    <Setter TargetName="NodeBorder" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自绘标题栏（无系统窗框：拖动 + 关闭都在这里）  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1"
            ui:WindowDragBehavior.IsWindowDraggable="True">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Background="{StaticResource DialogAccentLightBrush}"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="18"
                        Foreground="{StaticResource DialogAccentTextBrush}"
                        Text="&#xf1c0;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="15.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="本地变量与设备变量统一维护 · 新建 / 监视 / 写值" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                    Style="{StaticResource DialogIconButton}">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="关闭" />
                    </Button.ToolTip>
                    <TextBlock
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左栏：来源导航  ============  -->
            <Border
                Grid.Column="0"
                Background="{StaticResource DialogRowAlternateBrush}"
                BorderBrush="{StaticResource DialogBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="32">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="变量来源" />
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{StaticResource DialogSuccessSubtleBrush}"
                            BorderBrush="{StaticResource DialogSuccessBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="7,1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="5"
                                    Height="5"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource DialogSuccessBrush}" />
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogSuccessTextBrush}"
                                    Text="实时" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ListBox
                        x:Name="SourceList"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsSynchronizedWithCurrentItem="False"
                        ItemTemplate="{StaticResource GvSourceNodeTemplate}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,10,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="GroupTitle"
                                                VerticalAlignment="Center"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="本地与系统" />
                                            <Border
                                                Grid.Column="1"
                                                Height="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource DialogBorderBrush}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="True">
                                                <Setter TargetName="GroupTitle" Property="Text" Value="通信连接" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <Border
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Padding="10"
                        Background="{StaticResource DialogSurfaceBrush}"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="轮询镜像" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="网络变量当前值来自轮询镜像；本地变量直接写内存；系统变量只读。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        Grid.Row="3"
                        Margin="4,10,4,0"
                        Visibility="{Binding IsNetworkSource, Converter={ui:BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="采集质量" />
                        <StackPanel
                            Margin="0,2,0,0"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource DialogSuccessBrush}" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="正常" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2,0,0"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource DialogWarningBrush}" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="读取失败（显示上次值）" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2,0,0"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource DialogTextMutedBrush}" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="断线 / 从未读到" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ============ 右栏：变量明细  ============  -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource DialogCardShadow}" />
                <Border Style="{StaticResource DialogCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <!--  卡片头：标题 / 数量 / 来源 + 搜索 / 管理扫描组 / 添加变量  -->
                        <Border Grid.Row="0" Style="{StaticResource DialogCardHeader}" Height="60">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DialogCardTitleIcon}" Text="&#xf0ce;" />
                                        <TextBlock Style="{StaticResource DialogCardTitle}" Text="变量明细" />
                                        <Border
                                            MinWidth="22"
                                            Height="20"
                                            Margin="8,0,0,0"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogChipAccent}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DialogChipTextAccent}"
                                                Text="{Binding SelectedSource.Count, FallbackValue=0}" />
                                        </Border>
                                        <Border
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogTag}">
                                            <TextBlock Style="{StaticResource DialogTagText}" Text="{Binding SelectedSource.DisplayName}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding SelectedSource.Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        Width="238"
                                        Height="32"
                                        Style="{StaticResource DialogSearchChrome}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Style="{StaticResource DialogSearchIcon}"
                                                Text="&#xf002;" />
                                            <TextBox
                                                Grid.Column="1"
                                                Height="30"
                                                VerticalContentAlignment="Center"
                                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                Style="{StaticResource DialogSearchInput}"
                                                Tag="搜索变量名 / 描述 / 地址"
                                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>

                                    <Button
                                        x:Name="ManageGroupsButton"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ManageScanGroupsCommand}"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        Style="{StaticResource DialogIconButton}"
                                        Visibility="{Binding IsNetworkSource, Converter={ui:BooleanToVisibilityConverter}}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="管理扫描组：新增 / 改名 / 删除组、改周期（作用对象 = 左栏选中的连接）" />
                                        </Button.ToolTip>
                                        <TextBlock
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource DialogAccentBrush}"
                                            Text="&#xf5fd;" />
                                    </Button>

                                    <Button
                                        x:Name="AddButton"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        Padding="12,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddCommand}"
                                        Content="＋ 添加变量"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        FontSize="12"
                                        Style="{StaticResource DialogPrimaryButton}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="按左栏当前选中的来源新建变量：选中「本地变量」建本地变量，选中某条连接建该连接的网络变量" />
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  系统变量只读横幅  -->
                        <Border
                            x:Name="SystemBanner"
                            Grid.Row="1"
                            Height="34"
                            Padding="16,0"
                            Background="{StaticResource DialogWarningSubtleBrush}"
                            BorderBrush="{StaticResource DialogWarningBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSource.Key}" Value="System">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,7,0"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="&#xf023;" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="系统变量由宿主维护（运动 / IO），此处只读展示；重命名 / 删除不可用。新建请使用右上角「添加变量」（会切到本地变量）。"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="系统变量由宿主维护（运动 / IO），此处只读展示；重命名 / 删除不可用。新建请使用右上角「添加变量」（会切到本地变量）。" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!--  明细表 + 空态覆盖层  -->
                        <Grid Grid.Row="2">
                            <DataGrid
                                x:Name="DetailGrid"
                                AlternationCount="1"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="False"
                                CanUserSortColumns="False"
                                HorizontalScrollBarVisibility="Auto"
                                ItemsSource="{Binding FilteredDisplayNodes}"
                                MinRowHeight="40"
                                RowHeight="{x:Static sys:Double.NaN}"
                                Style="{StaticResource DialogDataGrid}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DialogDataGridRow}">
                                        <!--
                                            共享皮肤给的是 Margin="0,1"（上下各 1px）。本表根行 54 / 子行 40 是硬指标，
                                            再叠 2px 会让默认 9 行（6 根 + 3 子）超出视口、末行被状态条裁掉。
                                            行分隔已由 GridLinesVisibility=Horizontal 画，这里把 Margin 归零。
                                        -->
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Height" Value="54" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChildNode}" Value="True">
                                                <Setter Property="Height" Value="40" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DialogDataGridColumnHeader}">
                                        <Setter Property="Height" Value="34" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <!--  变量名：缩进 + 展开箭头 + 类型图标块 + 名称/描述 + N 项  -->
                                    <DataGridTemplateColumn Width="220" MinWidth="220" Header="变量名">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="{Binding Level, Converter={ui:LevelToIndentConverter}}" />

                                                    <ToggleButton
                                                        Grid.Column="1"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,6,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                        IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                        Visibility="{Binding IsContainer, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <ToggleButton.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="展开 / 折叠数组元素" />
                                                        </ToggleButton.ToolTip>
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Width="16" Height="16">
                                                                    <TextBlock
                                                                        x:Name="Chevron"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource DialogIconFont}"
                                                                        FontSize="9"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        Text="&#xf054;">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                        <TextBlock.RenderTransform>
                                                                            <RotateTransform Angle="0" />
                                                                        </TextBlock.RenderTransform>
                                                                    </TextBlock>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="90" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>

                                                    <Border
                                                        Grid.Column="2"
                                                        Width="{Binding IsContainer, Converter={ui:BooleanToWidthConverter}, ConverterParameter=22}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChildNode}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <Border
                                                        Grid.Column="3"
                                                        Width="28"
                                                        Height="28"
                                                        Margin="0,0,8,0"
                                                        CornerRadius="8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Background" Value="{Binding TypeName, Converter={StaticResource DataTypeBrushConverter}, ConverterParameter=Soft}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChildNode}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="9.5"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding TypeName, Converter={StaticResource DataTypeBrushConverter}, ConverterParameter=Text}"
                                                            Text="{Binding TypeName, Converter={StaticResource TypeAbbreviationConverter}}" />
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="12.5" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChildNode}" Value="True">
                                                                            <Setter Property="FontSize" Value="11" />
                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                            <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding Name}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                        <TextBlock
                                                            Margin="0,1,0,0"
                                                            FontSize="10.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="{Binding Description}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="5"
                                                        Height="18"
                                                        Padding="6,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource DialogTypeArraySoftBrush}"
                                                        CornerRadius="5"
                                                        Visibility="{Binding IsArrayRootNode, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="9.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource DialogTypeArrayTextBrush}"
                                                            Text="{Binding Children.Count, StringFormat={}{0} 项}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  类型：中性 chip + 类型色点  -->
                                    <DataGridTemplateColumn Width="104" MinWidth="104" Header="类型">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border
                                                    MaxWidth="92"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource DialogTag}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding TypeName, Converter={StaticResource DataTypeBrushConverter}, ConverterParameter=Strong}" />
                                                        <!--  Grid 的 * 列才能让 TextTrimming 生效：横向 StackPanel 给的是无限宽，数组后缀 [] 会被直接裁掉  -->
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Style="{StaticResource DialogTagText}"
                                                            Text="{Binding TypeName}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding TypeName}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  来源：仅网络来源显示  -->
                                    <DataGridTemplateColumn
                                        x:Name="SourceColumn"
                                        Width="120"
                                        MinWidth="120"
                                        Header="来源">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border
                                                    MaxWidth="108"
                                                    HorizontalAlignment="Left">
                                                    <Border.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding SourceLabel}" />
                                                    </Border.ToolTip>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource DialogTag}">
                                                            <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                    <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogAccentBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding SourceLabel}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DialogTagText}">
                                                                    <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                                            <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  扫描组：仅网络来源根节点显示  -->
                                    <DataGridTemplateColumn
                                        x:Name="ScanGroupColumn"
                                        Width="104"
                                        MinWidth="104"
                                        Header="扫描组">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DialogDataGridCell}">
                                                <Setter Property="Padding" Value="6,0,0,0" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    Width="92"
                                                    Height="30"
                                                    Padding="8,0,20,0"
                                                    VerticalContentAlignment="Center"
                                                    FontSize="11.5"
                                                    ItemsSource="{Binding ScanGroupOptions}"
                                                    SelectedItem="{Binding ScanGroupText, UpdateSourceTrigger=PropertyChanged}"
                                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                    Style="{StaticResource DialogCombo}"
                                                    Visibility="{Binding ShowScanGroup, Converter={ui:BooleanToVisibilityConverter}}">
                                                    <ComboBox.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding ScanGroupText}" />
                                                    </ComboBox.ToolTip>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  地址：仅网络来源显示  -->
                                    <DataGridTemplateColumn
                                        x:Name="AddressColumn"
                                        Width="88"
                                        MinWidth="88"
                                        Header="地址">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                                    Text="{Binding Address}"
                                                    TextTrimming="CharacterEllipsis">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding Address}" />
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--
                                        当前值：六态互斥
                                        系统 / 图像 / 只读存储区 > 本地数组根 > 子行 > 可编辑根（含网络可写标量）
                                    -->
                                    <DataGridTemplateColumn
                                        Width="*"
                                        MinWidth="160"
                                        Header="当前值">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DialogDataGridCell}">
                                                <Setter Property="Padding" Value="8,0,0,0" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <!--  可编辑根（本地 / 网络可写标量）  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="EditableRoot">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsChildNode" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <Ellipse
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Good">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Uncertain">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Bad">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                            <Ellipse.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="采集质量：绿=正常 / 黄=最近一次读取失败（显示旧值） / 灰=断线或从未读到" />
                                                            </Ellipse.ToolTip>
                                                        </Ellipse>
                                                        <TextBox
                                                            Width="104"
                                                            Height="30"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            Background="{StaticResource DialogRowAlternateBrush}"
                                                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                            helpers:CellValueEditBehavior.Active="True"
                                                            Style="{StaticResource DialogCellInputQuiet}"
                                                            Text="{Binding CurrentValueText, Mode=OneWay}" />
                                                        <Button
                                                            Width="30"
                                                            Height="30"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DialogIconButton}"
                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                            Visibility="{Binding IsValueDeviated, Converter={ui:BooleanToVisibilityConverter}}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="当前值已偏离初始值：点击恢复为创建时设定的初始值" />
                                                            </Button.ToolTip>
                                                            <TextBlock
                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                FontSize="12"
                                                                Foreground="{StaticResource DialogWarningTextBrush}"
                                                                Text="&#xf0e2;" />
                                                        </Button>
                                                    </StackPanel>

                                                    <!--  数组子行  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="EditableChild">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsChildNode" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <TextBox
                                                            Width="104"
                                                            Height="30"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            Background="{StaticResource DialogRowAlternateBrush}"
                                                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                            helpers:CellValueEditBehavior.Active="True"
                                                            Style="{StaticResource DialogCellInputQuiet}"
                                                            Text="{Binding CurrentValueText, Mode=OneWay}" />
                                                    </StackPanel>

                                                    <!--  本地数组根：强制覆盖集合  -->
                                                    <Button
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.EditArrayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                                        Content="强制覆盖集合...">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Padding" Value="0" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="Transparent">
                                                                                <ContentPresenter />
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="ArrayRoot">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsChildNode" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </Button.Visibility>
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="增删元素、批量修改并整体覆盖当前值" />
                                                        </Button.ToolTip>
                                                    </Button>

                                                    <!--  系统 / 只读存储区：锁 + 值  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="ReadOnlyRoot">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsChildNode" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <TextBlock
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf023;" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="{Binding CurrentValueText}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="只读：系统变量或只读存储区，不可写值" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!--  图像：由流程写入  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="Image">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsChildNode" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <TextBlock
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf03e;" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="图像由流程写入" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  操作：复制保留；系统行只隐藏重命名/删除，显示只读 chip  -->
                                    <DataGridTemplateColumn
                                        Width="100"
                                        MinWidth="100"
                                        Header="操作"
                                        CellStyle="{StaticResource DialogDataGridCellFlush}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding IsRootNode, Converter={ui:BooleanToVisibilityConverter}}">
                                                    <Button
                                                        Command="{Binding DataContext.CopyNameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DialogIconButton}"
                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="复制变量名（供画布组态绑定）" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="13"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf0c5;" />
                                                    </Button>

                                                    <Button
                                                        Margin="2,0,0,0"
                                                        Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DialogIconButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystemOwned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="重命名变量" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="13"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf044;" />
                                                    </Button>

                                                    <Button
                                                        Margin="2,0,0,0"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DialogIconButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystemOwned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="删除" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="13"
                                                            Foreground="{StaticResource DialogDangerBrush}"
                                                            Text="&#xf1f8;" />
                                                    </Button>

                                                    <Border
                                                        Margin="2,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource DialogTag}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystemOwned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                Margin="0,0,4,0"
                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                FontSize="9"
                                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                                Text="&#xf023;" />
                                                            <TextBlock
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                                Text="只读" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!--  空来源覆盖层  -->
                            <Grid
                                x:Name="EmptySourceOverlay"
                                Margin="0,34,0,0"
                                Panel.ZIndex="2"
                                Background="{StaticResource DialogSurfaceBrush}">
                                <Grid.Visibility>
                                    <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}" ConverterParameter="Empty">
                                        <Binding Path="FilteredDisplayNodes.Count" />
                                        <Binding Path="SearchText" />
                                    </MultiBinding>
                                </Grid.Visibility>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="46"
                                        Height="46"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource DialogRowAlternateBrush}"
                                        BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="20"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="&#xf1c0;" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="还没有变量" />
                                    <TextBlock
                                        MaxWidth="420"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="点击右上角「＋ 添加变量」创建第一个变量。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Height="32"
                                        Margin="0,10,0,0"
                                        Padding="12,0"
                                        HorizontalAlignment="Center"
                                        Command="{Binding AddCommand}"
                                        Content="＋ 添加变量"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        FontSize="12"
                                        Style="{StaticResource DialogPrimaryButton}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="打开「添加变量」属性网格弹窗" />
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  搜索无结果覆盖层  -->
                            <Grid
                                x:Name="SearchEmptyOverlay"
                                Margin="0,34,0,0"
                                Panel.ZIndex="3"
                                Background="{StaticResource DialogSurfaceBrush}">
                                <Grid.Visibility>
                                    <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}" ConverterParameter="Search">
                                        <Binding Path="FilteredDisplayNodes.Count" />
                                        <Binding Path="SearchText" />
                                    </MultiBinding>
                                </Grid.Visibility>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="46"
                                        Height="46"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource DialogRowAlternateBrush}"
                                        BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="18"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="&#xf002;" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="没有匹配的变量" />
                                    <TextBlock
                                        MaxWidth="420"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="按名称 / 描述 / 地址搜索，或清空搜索框查看全部。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!--  底部状态条  -->
                        <Border
                            Grid.Row="3"
                            Background="{StaticResource DialogRowAlternateBrush}"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding SelectedSource.Count, FallbackValue=0}" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text=" 个变量 · " />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding SelectedSource.DisplayName}" />
                                    <Border
                                        Width="1"
                                        Height="12"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource DialogBorderBrush}" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="当前值写入内存" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetworkSource}" Value="True">
                                                        <Setter Property="Text" Value="轮询镜像实时刷新" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedSource.Key}" Value="System">
                                                        <Setter Property="Text" Value="只读 · 不参与新建 / 删除" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        Height="18"
                                        MinWidth="18"
                                        Padding="5,0"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1,1,1,2"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="9.5"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="Enter" />
                                    </Border>
                                    <TextBlock
                                        Margin="4,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="提交" />
                                    <Border
                                        Height="18"
                                        MinWidth="18"
                                        Padding="5,0"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1,1,1,2"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="9.5"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="Esc" />
                                    </Border>
                                    <TextBlock
                                        Margin="4,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="取消" />
                                    <Border
                                        Height="18"
                                        MinWidth="18"
                                        Padding="5,0"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1,1,1,2"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="9"
                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                            Text="&#xf0e2;" />
                                    </Border>
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="恢复初始值" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
