<UserControl
    x:Class="VisionMaster.Views.DialogViews.GlobalVariableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:VisionMaster.Helpers"
    xmlns:local="clr-namespace:VisionMaster.Views.DialogViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.UI.com/ui"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource DialogSurfaceBrush}"
    mc:Ignorable="d">

    <!--
        ============================================================================
        变量管理（Web 设计基线 v1：来源导航 + 变量明细）
        ============================================================================
        结构：左栏 232 来源导航（按 IsNetwork 分「本地与系统 / 通信连接」两组）；
              右栏 60 卡片头 + DataGrid + 34 状态条（设计 64/40，按一屏行数取舍）。
        纪律：本视图属于 VariableBindingCheck 的 CollectedDialogViews——
              禁止本地 <Style x:Key=...>；只用无 key 内联 Style / DataTemplate / ControlTemplate。
              颜色一律 Dialog* / Logic* / DialogTypeArray* 令牌，视图零十六进制。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1300" />
            <Setter Property="Height" Value="700" />
            <Setter Property="MinWidth" Value="1200" />
            <Setter Property="MinHeight" Value="580" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <local:TypeAbbreviationConverter x:Key="TypeAbbreviationConverter" />
        <local:DataTypeBrushConverter x:Key="DataTypeBrushConverter" />
        <local:GlobalVariableValueModeConverter x:Key="GlobalVariableValueModeConverter" />
        <local:EmptyStateVisibilityConverter x:Key="EmptyStateVisibilityConverter" />
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />

        <!--
            来源卡片：48px，图标块 + 名称 + 副行 + 计数。
            选中 = 白卡 + 主色左条；悬停 = 白卡；键盘焦点 = 主色描边；禁用 = 半透明。
        -->
        <DataTemplate x:Key="GvSourceNodeTemplate">
            <Grid>
                <Border
                    x:Name="NodeBorder"
                    Height="48"
                    Margin="0,2"
                    Padding="10,6,8,6"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="IconTile"
                            Grid.Column="0"
                            Width="28"
                            Height="28"
                            Margin="0,0,9,0"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Key}" Value="System">
                                            <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="13"
                                Text="{Binding Icon}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Key}" Value="System">
                                                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <TextBlock
                                x:Name="SourceName"
                                Text="{Binding DisplayName}"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel
                                Margin="0,2,0,0"
                                Orientation="Horizontal">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Key}" Value="System">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="{Binding Subtitle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <Border
                            x:Name="CountBadge"
                            Grid.Column="2"
                            MinWidth="20"
                            Height="20"
                            Padding="6,0"
                            VerticalAlignment="Center"
                            CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Style>
                            </Border.Style>
                            <TextBlock
                                x:Name="CountText"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding Count}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="10.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!--  连接行的展开箭头：本地/系统/分组行由 ShowExpand 收起  -->
                        <Button
                            Grid.Column="3"
                            Width="24"
                            Height="24"
                            Margin="2,0,0,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.ToggleSourceExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            Style="{StaticResource DialogIconButton}"
                            Visibility="{Binding ShowExpand, Converter={ui:BooleanToVisibilityConverter}}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="展开 / 折叠该连接的显示分组" />
                            </Button.ToolTip>
                            <TextBlock
                                x:Name="ExpandChevron"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="9"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                RenderTransformOrigin="0.5,0.5"
                                Text="&#xf054;">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    x:Name="Indicator"
                    Width="3"
                    Margin="0,10,0,10"
                    HorizontalAlignment="Left"
                    Background="{StaticResource DialogAccentBrush}"
                    CornerRadius="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NodeBorder" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SourceName" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    <Setter TargetName="CountBadge" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                    <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                </DataTrigger>
                <Trigger SourceName="NodeBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="NodeBorder" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                    <Setter TargetName="NodeBorder" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="ExpandChevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            分组行：缩进在连接行下面（全部 / 自定义分组 / 未分组）。
            选中态与来源卡片同口径：主色浅底 + 主色文字；0 变量的组置灰但仍可点。
        -->
        <DataTemplate x:Key="GvGroupNodeTemplate">
            <Grid>
                <Border
                    x:Name="GroupBorder"
                    Height="30"
                    Margin="26,1,2,1"
                    Padding="8,0"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="GroupIcon"
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding Icon}" />
                        <TextBlock
                            x:Name="GroupName"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="{Binding DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="GroupCount"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding Count}" />
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="GroupBorder" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                    <Setter TargetName="GroupBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                    <Setter TargetName="GroupIcon" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    <Setter TargetName="GroupName" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                    <Setter TargetName="GroupName" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="GroupCount" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                </DataTrigger>
                <Trigger SourceName="GroupBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="GroupBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Count}" Value="0">
                    <Setter TargetName="GroupName" Property="Opacity" Value="0.65" />
                    <Setter TargetName="GroupCount" Property="Opacity" Value="0.65" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:VariableSourceNodeTemplateSelector
            x:Key="GvSourceNodeSelector"
            SourceTemplate="{StaticResource GvSourceNodeTemplate}"
            GroupTemplate="{StaticResource GvGroupNodeTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自绘标题栏（无系统窗框：拖动 + 关闭都在这里）  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1"
            ui:WindowDragBehavior.IsWindowDraggable="True">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Background="{StaticResource DialogAccentLightBrush}"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="18"
                        Foreground="{StaticResource DialogAccentTextBrush}"
                        Text="&#xf1c0;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="15.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="本地变量与设备变量统一维护 · 新建 / 监视 / 写值" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                    Style="{StaticResource DialogIconButton}">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="关闭" />
                    </Button.ToolTip>
                    <TextBlock
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左栏：来源导航  ============  -->
            <Border
                Grid.Column="0"
                Background="{StaticResource DialogRowAlternateBrush}"
                BorderBrush="{StaticResource DialogBorderLightBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="32">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="变量来源" />
                        <Border
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{StaticResource DialogSuccessSubtleBrush}"
                            BorderBrush="{StaticResource DialogSuccessBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="7,1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="5"
                                    Height="5"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource DialogSuccessBrush}" />
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogSuccessTextBrush}"
                                    Text="实时" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ListBox
                        x:Name="SourceList"
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        IsSynchronizedWithCurrentItem="False"
                        ItemTemplateSelector="{StaticResource GvSourceNodeSelector}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,10,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="GroupTitle"
                                                VerticalAlignment="Center"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="本地与系统" />
                                            <Border
                                                Grid.Column="1"
                                                Height="1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource DialogBorderBrush}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="True">
                                                <Setter TargetName="GroupTitle" Property="Text" Value="通信连接" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <Border
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Padding="10"
                        Background="{StaticResource DialogSurfaceBrush}"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="轮询镜像" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="网络变量当前值来自轮询镜像；本地变量直接写内存；系统变量只读。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="扫描组（节拍）在通讯设置中维护；此处只选择变量归属。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel
                        Grid.Row="3"
                        Margin="4,10,4,0"
                        Visibility="{Binding IsNetworkSource, Converter={ui:BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="采集质量" />
                        <StackPanel
                            Margin="0,2,0,0"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource DialogSuccessBrush}" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="正常" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2,0,0"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource DialogWarningBrush}" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="读取失败（显示上次值）" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2,0,0"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource DialogTextMutedBrush}" />
                            <TextBlock
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="断线 / 从未读到" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ============ 右栏：变量明细  ============  -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource DialogCardShadow}" />
                <Border Style="{StaticResource DialogCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <!--  卡片头：标题 / 数量 / 来源 / 分组 / 搜索 / 管理分组 / 添加变量  -->
                        <Border Grid.Row="0" Style="{StaticResource DialogCardHeader}" Height="60">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DialogCardTitleIcon}" Text="&#xf0ce;" />
                                        <TextBlock Style="{StaticResource DialogCardTitle}" Text="变量明细" />
                                        <Border
                                            MinWidth="22"
                                            Height="20"
                                            Margin="8,0,0,0"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogChipAccent}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DialogChipTextAccent}"
                                                Text="{Binding VisibleRootCount, FallbackValue=0}" />
                                        </Border>
                                        <Border
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogTag}">
                                            <TextBlock Style="{StaticResource DialogTagText}" Text="{Binding SelectedSource.DisplayName}" />
                                        </Border>
                                        <Border
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogTag}"
                                            Visibility="{Binding IsGroupScope, Converter={ui:BooleanToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource DialogTagText}" Text="{Binding SelectedGroupName}" />
                                        </Border>
                                        <Border
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogTag}"
                                            Visibility="{Binding IsSearching, Converter={ui:BooleanToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource DialogTagText}" Text="{Binding SearchScopeLabel}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding SelectedSource.Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        Width="238"
                                        Height="32"
                                        Style="{StaticResource DialogSearchChrome}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Style="{StaticResource DialogSearchIcon}"
                                                Text="&#xf002;" />
                                            <TextBox
                                                Grid.Column="1"
                                                Height="30"
                                                VerticalContentAlignment="Center"
                                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                Style="{StaticResource DialogSearchInput}"
                                                Tag="搜索变量名 / 描述 / 地址"
                                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>

                                    <!--
                                        单设备批量导入/导出：只对网络来源可见。
                                        本地/系统变量没有设备地址表可导，按钮整块收起（不是置灰）——
                                        置灰会让用户以为"权限不够"，而实际是这里根本没有这条业务。
                                    -->
                                    <Button
                                        x:Name="ExportButton"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        Padding="10,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ExportCommand}"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        Style="{StaticResource DialogTextButton}"
                                        Visibility="{Binding IsNetworkSource, Converter={ui:BooleanToVisibilityConverter}}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="导出当前设备的变量表（xlsx）：全部变量或当前显示分组，含结构化地址与说明页" />
                                        </Button.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,5,0"
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="12"
                                                Foreground="{StaticResource DialogAccentBrush}"
                                                Text="&#xf019;" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="导出" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="ImportButton"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ImportCommand}"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        Style="{StaticResource DialogTextButton}"
                                        Visibility="{Binding IsNetworkSource, Converter={ui:BooleanToVisibilityConverter}}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="从 xlsx 批量导入当前设备的变量：先预览差异（新增 / 更新 / 无变化 / 错误），确认后事务应用" />
                                        </Button.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,5,0"
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="12"
                                                Foreground="{StaticResource DialogAccentBrush}"
                                                Text="&#xf093;" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="导入" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="ManageVariableGroupsButton"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        Padding="10,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenGroupManagerCommand}"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        Style="{StaticResource DialogTextButton}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="管理显示分组：新增 / 改名 / 删除（仅用于归类与筛选，不影响采集、轮询与写入）" />
                                        </Button.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,5,0"
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="12"
                                                Foreground="{StaticResource DialogAccentBrush}"
                                                Text="&#xf02b;" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="管理分组" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="AddButton"
                                        Height="32"
                                        Margin="10,0,0,0"
                                        Padding="12,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding AddCommand}"
                                        Content="＋ 添加变量"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        FontSize="12"
                                        Style="{StaticResource DialogPrimaryButton}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="按左栏当前选中的来源新建变量：选中「本地变量」建本地变量，选中某条连接建该连接的网络变量" />
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  系统变量只读横幅  -->
                        <Border
                            x:Name="SystemBanner"
                            Grid.Row="1"
                            Height="34"
                            Padding="16,0"
                            Background="{StaticResource DialogWarningSubtleBrush}"
                            BorderBrush="{StaticResource DialogWarningBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSource.Key}" Value="System">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,7,0"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="&#xf023;" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="系统变量由宿主维护（运动 / IO），此处只读展示；重命名 / 删除不可用。新建请使用右上角「添加变量」（会切到本地变量）。"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="系统变量由宿主维护（运动 / IO），此处只读展示；重命名 / 删除不可用。新建请使用右上角「添加变量」（会切到本地变量）。" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!--  明细表 + 空态覆盖层  -->
                        <Grid Grid.Row="2">
                            <DataGrid
                                x:Name="DetailGrid"
                                AlternationCount="1"
                                CanUserReorderColumns="False"
                                CanUserResizeColumns="False"
                                CanUserSortColumns="False"
                                HorizontalScrollBarVisibility="Auto"
                                ItemsSource="{Binding FilteredDisplayNodes}"
                                MinRowHeight="40"
                                RowHeight="{x:Static sys:Double.NaN}"
                                Style="{StaticResource DialogDataGrid}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DialogDataGridRow}">
                                        <!--
                                            共享皮肤给的是 Margin="0,1"（上下各 1px）。本表根行 54 / 子行 40 是硬指标，
                                            再叠 2px 会让默认 9 行（6 根 + 3 子）超出视口、末行被状态条裁掉。
                                            行分隔已由 GridLinesVisibility=Horizontal 画，这里把 Margin 归零。
                                            用 MinHeight 而不是 Height：设计基线（design.html .gv-row.is-child）
                                            写的是 min-height，两行文字在 150% DPI / 字体回退下若超过 40，行要长高而不是把描述切掉。
                                        -->
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="54" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChildNode}" Value="True">
                                                <Setter Property="MinHeight" Value="40" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DialogDataGridColumnHeader}">
                                        <Setter Property="Height" Value="34" />
                                        <Setter Property="FontSize" Value="11" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <!--  变量名：缩进 + 展开箭头 + 类型图标块 + 名称/描述 + N 项  -->
                                    <!--
                                        变量名是唯一的内容列：固定 220 在宽窗口下把余量全让给"当前值"，
                                        系统变量的描述行 8/8 被截成省略号；改弹性 1.6* 并保留 220 下限，
                                        1200 窄档（网络来源最紧的一档）仍然只到 220，不会挤掉"当前值"。
                                    -->
                                    <DataGridTemplateColumn
                                        Width="1.6*"
                                        MinWidth="220"
                                        Header="变量名">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="{Binding Level, Converter={ui:LevelToIndentConverter}}" />

                                                    <ToggleButton
                                                        Grid.Column="1"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,6,0"
                                                        Padding="0"
                                                        Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                        IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                        Visibility="{Binding IsContainer, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <ToggleButton.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="展开 / 折叠数组元素" />
                                                        </ToggleButton.ToolTip>
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Width="16" Height="16">
                                                                    <TextBlock
                                                                        x:Name="Chevron"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource DialogIconFont}"
                                                                        FontSize="9"
                                                                        RenderTransformOrigin="0.5,0.5"
                                                                        Text="&#xf054;">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                        <TextBlock.RenderTransform>
                                                                            <RotateTransform Angle="0" />
                                                                        </TextBlock.RenderTransform>
                                                                    </TextBlock>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="90" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>

                                                    <Border
                                                        Grid.Column="2"
                                                        Width="{Binding IsContainer, Converter={ui:BooleanToWidthConverter}, ConverterParameter=22}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChildNode}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>

                                                    <Border
                                                        Grid.Column="3"
                                                        Width="28"
                                                        Height="28"
                                                        Margin="0,0,8,0"
                                                        CornerRadius="8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Background" Value="{Binding TypeName, Converter={StaticResource DataTypeBrushConverter}, ConverterParameter=Soft}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChildNode}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <!--  合成容器（按名称路径归组）没有真实类型，类型由「类型」列的 tag 表达  -->
                                                                    <DataTrigger Binding="{Binding IsSyntheticContainer}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="9.5"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding TypeName, Converter={StaticResource DataTypeBrushConverter}, ConverterParameter=Text}"
                                                            Text="{Binding TypeName, Converter={StaticResource TypeAbbreviationConverter}}" />
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="12.5" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChildNode}" Value="True">
                                                                            <Setter Property="FontSize" Value="11" />
                                                                            <Setter Property="FontWeight" Value="Normal" />
                                                                            <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding DisplayFullName}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                        <!--
                                                            名称与描述之间留 3（基线 design.html 写 1）：真机 150% DPI 下两行几乎贴在一起，
                                                            读起来像被压扁；3 仍能让两行 + 行高 40 装得下（内容 33.6 < 40）。
                                                        -->
                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="10.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="{Binding Description}"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding Description}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Border
                                                        Grid.Column="5"
                                                        Height="18"
                                                        Padding="6,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource DialogTypeArraySoftBrush}"
                                                        CornerRadius="5"
                                                        Visibility="{Binding ShowChildCountBadge, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="9.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource DialogTypeArrayTextBrush}"
                                                            Text="{Binding Children.Count, StringFormat={}{0} 项}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  类型：中性 chip + 类型色点  -->
                                    <!--
                                        类型按内容自适应：chip 原来写死 MaxWidth=92，把 FlowRuntimeSnapshot
                                        截成 "FlowRun…"；Auto + MaxWidth 220 让 19 字符的类型名整词上屏，
                                        短类型仍落在 MinWidth 104，窄档布局不变。
                                    -->
                                    <DataGridTemplateColumn
                                        Width="Auto"
                                        MinWidth="104"
                                        MaxWidth="220"
                                        Header="类型">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource DialogTag}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding TypeName, Converter={StaticResource DataTypeBrushConverter}, ConverterParameter=Strong}" />
                                                        <!--  Grid 的 * 列才能让 TextTrimming 生效：横向 StackPanel 给的是无限宽，数组后缀 [] 会被直接裁掉  -->
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Style="{StaticResource DialogTagText}"
                                                            Text="{Binding TypeName}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding TypeName}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  显示分组：仅网络来源根节点显示（归类 + 筛选，不影响采集）  -->
                                    <DataGridTemplateColumn
                                        x:Name="GroupColumn"
                                        Width="120"
                                        MinWidth="120">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="分组">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="显示分组：仅用于归类与筛选，不影响采集、轮询与写入" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    Width="104"
                                                    Height="30"
                                                    Padding="8,0,20,0"
                                                    VerticalContentAlignment="Center"
                                                    DisplayMemberPath="Name"
                                                    FontSize="11.5"
                                                    ItemsSource="{Binding GroupOptions}"
                                                    SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                    Style="{StaticResource DialogCombo}"
                                                    Visibility="{Binding ShowGroup, Converter={ui:BooleanToVisibilityConverter}}">
                                                    <ComboBox.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding SelectedGroup.Name}" />
                                                    </ComboBox.ToolTip>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  扫描组：仅网络来源根节点显示  -->
                                    <DataGridTemplateColumn
                                        x:Name="ScanGroupColumn"
                                        Width="104"
                                        MinWidth="104">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="扫描组">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="轮询节拍（在通讯设置中维护）；此处只选择变量属于哪个组" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DialogDataGridCell}">
                                                <Setter Property="Padding" Value="6,0,0,0" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    Width="92"
                                                    Height="30"
                                                    Padding="8,0,20,0"
                                                    VerticalContentAlignment="Center"
                                                    FontSize="11.5"
                                                    ItemsSource="{Binding ScanGroupOptions}"
                                                    SelectedItem="{Binding ScanGroupText, UpdateSourceTrigger=PropertyChanged}"
                                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                    Style="{StaticResource DialogCombo}"
                                                    Visibility="{Binding ShowScanGroup, Converter={ui:BooleanToVisibilityConverter}}">
                                                    <ComboBox.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding ScanGroupText}" />
                                                    </ComboBox.ToolTip>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  地址：仅网络来源显示  -->
                                    <DataGridTemplateColumn
                                        x:Name="AddressColumn"
                                        Width="88"
                                        MinWidth="88"
                                        Header="地址">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                                    Text="{Binding Address}"
                                                    TextTrimming="CharacterEllipsis">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding Address}" />
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--
                                        当前值：六态互斥
                                        系统 / 图像 / 只读存储区 > 本地数组根 > 子行 > 可编辑根（含网络可写标量）
                                    -->
                                    <DataGridTemplateColumn
                                        Width="*"
                                        MinWidth="160"
                                        Header="当前值">
                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DialogDataGridCell}">
                                                <Setter Property="Padding" Value="8,0,0,0" />
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <!--  可编辑根（本地 / 网络可写标量）  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="EditableRoot">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsArrayElementRow" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <Ellipse
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Good">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Uncertain">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Bad">
                                                                            <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                            <Ellipse.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="采集质量：绿=正常 / 黄=最近一次读取失败（显示旧值） / 灰=断线或从未读到" />
                                                            </Ellipse.ToolTip>
                                                        </Ellipse>
                                                        <TextBox
                                                            Width="104"
                                                            Height="30"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            Background="{StaticResource DialogRowAlternateBrush}"
                                                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                            helpers:CellValueEditBehavior.Active="True"
                                                            Style="{StaticResource DialogCellInputQuiet}"
                                                            Text="{Binding CurrentValueText, Mode=OneWay}" />
                                                        <Button
                                                            Width="30"
                                                            Height="30"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DialogIconButton}"
                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                            Visibility="{Binding IsValueDeviated, Converter={ui:BooleanToVisibilityConverter}}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="当前值已偏离初始值：点击恢复为创建时设定的初始值" />
                                                            </Button.ToolTip>
                                                            <TextBlock
                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                FontSize="12"
                                                                Foreground="{StaticResource DialogWarningTextBrush}"
                                                                Text="&#xf0e2;" />
                                                        </Button>
                                                    </StackPanel>

                                                    <!--  数组子行  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="EditableChild">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsArrayElementRow" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <TextBox
                                                            Width="104"
                                                            Height="30"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            Background="{StaticResource DialogRowAlternateBrush}"
                                                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                            helpers:CellValueEditBehavior.Active="True"
                                                            Style="{StaticResource DialogCellInputQuiet}"
                                                            Text="{Binding CurrentValueText, Mode=OneWay}" />

                                                        <!--  元素级 ↺：基准里有这一项且值不同才出现（只恢复这一项）  -->
                                                        <Button
                                                            Width="22"
                                                            Height="22"
                                                            MinWidth="0"
                                                            MinHeight="0"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ResetElementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                            Style="{StaticResource DialogIconButton}"
                                                            Visibility="{Binding IsElementDeviated, Converter={ui:BooleanToVisibilityConverter}}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="该元素偏离初始值：恢复为基准中的对应项" />
                                                            </Button.ToolTip>
                                                            <TextBlock
                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                FontSize="10"
                                                                Foreground="{StaticResource DialogWarningTextBrush}"
                                                                Text="&#xf0e2;" />
                                                        </Button>
                                                    </StackPanel>

                                                    <!--  网络数组元素行：设备轮询镜像，只读  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="ReadOnlyChild">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsArrayElementRow" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="11.5"
                                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                            Text="{Binding CurrentValueText}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="网络数组元素：由设备轮询提供，只读" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!--  本地数组根：摘要 + 编辑数组… + 偏离时的 ↺  -->
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="ArrayRoot">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsArrayElementRow" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </Grid.Visibility>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--  质量点占位：与其它行左缘对齐（本地数组无采集质量）  -->
                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="Hidden" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                            Text="{Binding ArraySummary}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding ArraySummaryTooltip}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>

                                                        <Button
                                                            Grid.Column="2"
                                                            Height="26"
                                                            Margin="8,0,0,0"
                                                            Padding="9,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.EditArrayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border
                                                                                    x:Name="Chrome"
                                                                                    Padding="{TemplateBinding Padding}"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    CornerRadius="6">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                                                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                                        <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="编辑当前值：增删元素、批量修改；可勾选同时写入初始值（基准）" />
                                                            </Button.ToolTip>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="{StaticResource DialogIconFont}"
                                                                    FontSize="10"
                                                                    Foreground="{StaticResource DialogAccentTextBrush}"
                                                                    Text="&#xf044;" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{StaticResource DialogAccentTextBrush}"
                                                                    Text="编辑数组…" />
                                                            </StackPanel>
                                                        </Button>

                                                        <Button
                                                            Grid.Column="3"
                                                            Width="24"
                                                            Height="24"
                                                            MinWidth="0"
                                                            MinHeight="0"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                            Style="{StaticResource DialogIconButton}"
                                                            Visibility="{Binding IsValueDeviated, Converter={ui:BooleanToVisibilityConverter}}">
                                                            <Button.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="当前值与初始值（基准）不同：恢复为基准" />
                                                            </Button.ToolTip>
                                                            <TextBlock
                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                FontSize="11"
                                                                Foreground="{StaticResource DialogWarningTextBrush}"
                                                                Text="&#xf0e2;" />
                                                        </Button>
                                                    </Grid>

                                                    <!--  网络数组根：摘要 + 只读徽标（元素由设备轮询提供）  -->
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="NetworkArrayRoot">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsArrayElementRow" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </Grid.Visibility>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--  质量点占位：与其它行左缘对齐（质量点在别列）  -->
                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="Hidden" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Consolas"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                            Text="{Binding ArraySummary}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding ArraySummaryTooltip}" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>

                                                        <StackPanel
                                                            Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <Button
                                                                Height="26"
                                                                Padding="9,0"
                                                                Command="{Binding DataContext.WriteArrayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand"
                                                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                                Style="{StaticResource DialogSecondaryButton}"
                                                                Visibility="{Binding CanWriteNetworkArray, Converter={ui:BooleanToVisibilityConverter}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock
                                                                        Margin="0,0,4,0"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource DialogIconFont}"
                                                                        FontSize="10"
                                                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                                                        Text="&#xf0c7;" />
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                                                        Text="写入数组…" />
                                                                </StackPanel>
                                                            </Button>

                                                            <Border
                                                                Padding="7,2"
                                                                VerticalAlignment="Center"
                                                                Background="{StaticResource DialogRowAlternateBrush}"
                                                                BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                Visibility="{Binding IsValueReadOnly, Converter={ui:BooleanToVisibilityConverter}}">
                                                                <TextBlock
                                                                    FontSize="10"
                                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                                    Text="只读" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!--  系统 / 只读存储区：锁 + 值  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="ReadOnlyRoot">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsArrayElementRow" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <TextBlock
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf023;" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="{Binding CurrentValueText}"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="只读：系统变量或只读存储区，不可写值" />
                                                            </TextBlock.ToolTip>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!--  图像：由流程写入  -->
                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource GlobalVariableValueModeConverter}" ConverterParameter="Image">
                                                                <Binding Path="IsRootNode" />
                                                                <Binding Path="IsArrayElementRow" />
                                                                <Binding Path="IsArrayRootNode" />
                                                                <Binding Path="IsEditableNode" />
                                                                <Binding Path="IsValueReadOnly" />
                                                                <Binding Path="IsSystemOwned" />
                                                                <Binding Path="TypeName" />
                                                                <Binding Path="OriginalModel" />
                                                            </MultiBinding>
                                                        </StackPanel.Visibility>
                                                        <TextBlock
                                                            Margin="0,0,5,0"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="11"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf03e;" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="图像由流程写入" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  操作：复制保留；系统行只隐藏重命名/删除，显示只读 chip  -->
                                    <DataGridTemplateColumn
                                        Width="100"
                                        MinWidth="100"
                                        Header="操作"
                                        CellStyle="{StaticResource DialogDataGridCellFlush}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding ShowRowActions, Converter={ui:BooleanToVisibilityConverter}}">
                                                    <Button
                                                        Command="{Binding DataContext.CopyNameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DialogIconButton}"
                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}">
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="复制变量名（供画布组态绑定）" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="13"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf0c5;" />
                                                    </Button>

                                                    <Button
                                                        Margin="2,0,0,0"
                                                        Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DialogIconButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystemOwned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="重命名变量" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="13"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="&#xf044;" />
                                                    </Button>

                                                    <Button
                                                        Margin="2,0,0,0"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DialogIconButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystemOwned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.ToolTip>
                                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="删除" />
                                                        </Button.ToolTip>
                                                        <TextBlock
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="13"
                                                            Foreground="{StaticResource DialogDangerBrush}"
                                                            Text="&#xf1f8;" />
                                                    </Button>

                                                    <Border
                                                        Margin="2,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource DialogTag}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystemOwned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                Margin="0,0,4,0"
                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                FontSize="9"
                                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                                Text="&#xf023;" />
                                                            <TextBlock
                                                                FontSize="10"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                                Text="只读" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!--  空来源覆盖层  -->
                            <Grid
                                x:Name="EmptySourceOverlay"
                                Margin="0,34,0,0"
                                Panel.ZIndex="2"
                                Background="{StaticResource DialogSurfaceBrush}">
                                <Grid.Visibility>
                                    <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}" ConverterParameter="Empty">
                                        <Binding Path="FilteredDisplayNodes.Count" />
                                        <Binding Path="SearchText" />
                                    </MultiBinding>
                                </Grid.Visibility>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="46"
                                        Height="46"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource DialogRowAlternateBrush}"
                                        BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="20"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="&#xf1c0;" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="还没有变量" />
                                    <TextBlock
                                        MaxWidth="420"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="点击右上角「＋ 添加变量」创建第一个变量。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Height="32"
                                        Margin="0,10,0,0"
                                        Padding="12,0"
                                        HorizontalAlignment="Center"
                                        Command="{Binding AddCommand}"
                                        Content="＋ 添加变量"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        FontSize="12"
                                        Style="{StaticResource DialogPrimaryButton}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="打开「添加变量」属性网格弹窗" />
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  搜索无结果覆盖层  -->
                            <Grid
                                x:Name="SearchEmptyOverlay"
                                Margin="0,34,0,0"
                                Panel.ZIndex="3"
                                Background="{StaticResource DialogSurfaceBrush}">
                                <Grid.Visibility>
                                    <MultiBinding Converter="{StaticResource EmptyStateVisibilityConverter}" ConverterParameter="Search">
                                        <Binding Path="FilteredDisplayNodes.Count" />
                                        <Binding Path="SearchText" />
                                    </MultiBinding>
                                </Grid.Visibility>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="46"
                                        Height="46"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource DialogRowAlternateBrush}"
                                        BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="18"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="&#xf002;" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="没有匹配的变量" />
                                    <TextBlock
                                        MaxWidth="420"
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="按名称 / 描述 / 地址搜索，或清空搜索框查看全部。"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!--  底部状态条  -->
                        <Border
                            Grid.Row="3"
                            Background="{StaticResource DialogRowAlternateBrush}"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding VisibleRootCount, FallbackValue=0}" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text=" 个变量 · " />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding SelectedScopeLabel}" />
                                    <Border
                                        Width="1"
                                        Height="12"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource DialogBorderBrush}" />
                                    <TextBlock
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="当前值写入内存" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetworkSource}" Value="True">
                                                        <Setter Property="Text" Value="轮询镜像实时刷新" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedSource.Key}" Value="System">
                                                        <Setter Property="Text" Value="只读 · 不参与新建 / 删除" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!--
                                        结构折叠开关（只对网络来源有意义：本地/系统变量的名字里没有 PLC 结构）。
                                        默认开：PLC 导出的变量表是一个数组元素一行，2357 行里真正的一级对象只有 88 个。
                                    -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsNetworkSource, Converter={ui:BooleanToVisibilityConverter}}">
                                        <Border
                                            Width="1"
                                            Height="12"
                                            Margin="10,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource DialogBorderBrush}" />
                                        <CheckBox
                                            x:Name="GroupByStructureToggle"
                                            VerticalAlignment="Center"
                                            Content="按数组 / 结构体折叠"
                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                            FontSize="10.5"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            IsChecked="{Binding GroupByStructure, Mode=TwoWay}"
                                            Style="{StaticResource DialogCheckBox}">
                                            <CheckBox.ToolTip>
                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="把变量名里带 [i] / .成员 的网络变量折叠成可展开的一行（Recipes → [0] → Ints → [5]）。只影响显示，不改地址、轮询与导入导出。" />
                                            </CheckBox.ToolTip>
                                        </CheckBox>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Border
                                        Height="18"
                                        MinWidth="18"
                                        Padding="5,0"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1,1,1,2"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="9.5"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="Enter" />
                                    </Border>
                                    <TextBlock
                                        Margin="4,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="提交" />
                                    <Border
                                        Height="18"
                                        MinWidth="18"
                                        Padding="5,0"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1,1,1,2"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="9.5"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="Esc" />
                                    </Border>
                                    <TextBlock
                                        Margin="4,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="取消" />
                                    <Border
                                        Height="18"
                                        MinWidth="18"
                                        Padding="5,0"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1,1,1,2"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="9"
                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                            Text="&#xf0e2;" />
                                    </Border>
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="恢复初始值" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--
            ================= 显示分组编辑器（覆盖层） =================
            方案级、纯展示分类：只做归类与筛选，不参与采集 / 轮询 / 写入。
            即时生效（与变量管理的其它动作同一事务模型），删除有二次确认。
        -->
        <Grid
            x:Name="GroupEditorOverlay"
            Grid.RowSpan="2"
            Panel.ZIndex="20"
            Visibility="{Binding GroupEditor.IsOpen, Converter={ui:BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource DialogScrimBrush}" />

            <Grid
                Width="580"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border Style="{StaticResource DialogCardShadow}" />
                <Border Style="{StaticResource DialogCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  标题  -->
                        <Border
                            Grid.Row="0"
                            Padding="18,14,14,12"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="15"
                                            Foreground="{StaticResource DialogAccentBrush}"
                                            Text="&#xf02b;" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="管理分组" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="仅用于归类与筛选，不影响采集、轮询与写入" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Command="{Binding CloseGroupManagerCommand}"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                    Style="{StaticResource DialogIconButton}">
                                    <Button.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="关闭" />
                                    </Button.ToolTip>
                                    <TextBlock
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="&#xf00d;" />
                                </Button>
                            </Grid>
                        </Border>

                        <!--  分组列表 + 新增  -->
                        <ScrollViewer
                            Grid.Row="1"
                            MaxHeight="380"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14">
                                <Border
                                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                    <StackPanel>
                                        <Border
                                            Height="30"
                                            Padding="10,0"
                                            Background="{StaticResource DialogRowAlternateBrush}"
                                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                                            BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="74" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="分组名称" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="变量数" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="操作" />
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding GroupEditor.Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border
                                                            Padding="10,6"
                                                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                                                            BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="78" />
                                                                    <ColumnDefinition Width="74" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid
                                                                    Grid.Column="0"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource DialogIconFont}"
                                                                        FontSize="12"
                                                                        Foreground="{StaticResource DialogAccentBrush}"
                                                                        Text="&#xf02b;" />
                                                                    <Grid Grid.Column="1">
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            FontSize="12.5"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                                            Text="{Binding Name}"
                                                                            TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBox
                                                                            Height="30"
                                                                            Padding="6,0"
                                                                            FontSize="12"
                                                                            Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}">
                                                                            <TextBox.Style>
                                                                                <Style TargetType="TextBox" BasedOn="{StaticResource DialogInput}">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBox.Style>
                                                                        </TextBox>
                                                                    </Grid>
                                                                    <Border
                                                                        Grid.Column="2"
                                                                        Height="18"
                                                                        Margin="6,0,0,0"
                                                                        Padding="5,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="{StaticResource DialogRowAlternateBrush}"
                                                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            FontSize="10"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                                            Text="内置" />
                                                                    </Border>
                                                                </Grid>

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11.5"
                                                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                                    Text="{Binding Count, StringFormat={}{0} 个变量}" />

                                                                <StackPanel
                                                                    Grid.Column="2"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal">
                                                                    <!--  普通操作：改名 / 删除  -->
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <Button
                                                                            Command="{Binding DataContext.GroupEditor.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                                            Style="{StaticResource DialogIconButton}">
                                                                            <Button.ToolTip>
                                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="重命名分组" />
                                                                            </Button.ToolTip>
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                                FontSize="12"
                                                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                                                Text="&#xf044;" />
                                                                        </Button>
                                                                        <Button
                                                                            Margin="2,0,0,0"
                                                                            Command="{Binding DataContext.GroupEditor.BeginDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                                            Style="{StaticResource DialogIconButton}">
                                                                            <Button.ToolTip>
                                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="删除分组（变量回落到未分组）" />
                                                                            </Button.ToolTip>
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                                FontSize="12"
                                                                                Foreground="{StaticResource DialogDangerBrush}"
                                                                                Text="&#xf1f8;" />
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <!--  行内改名：确认 / 取消  -->
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <Button
                                                                            Command="{Binding DataContext.GroupEditor.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            IsEnabled="{Binding CanCommitRename}"
                                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                                            Style="{StaticResource DialogIconButton}">
                                                                            <Button.ToolTip>
                                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="确认改名" />
                                                                            </Button.ToolTip>
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                                FontSize="12"
                                                                                Foreground="{StaticResource DialogSuccessTextBrush}"
                                                                                Text="&#xf00c;" />
                                                                        </Button>
                                                                        <Button
                                                                            Margin="2,0,0,0"
                                                                            Command="{Binding DataContext.GroupEditor.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                                            Style="{StaticResource DialogIconButton}">
                                                                            <Button.ToolTip>
                                                                                <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="取消改名" />
                                                                            </Button.ToolTip>
                                                                            <TextBlock
                                                                                FontFamily="{StaticResource DialogIconFont}"
                                                                                FontSize="12"
                                                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                                                Text="&#xf00d;" />
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <!--  内置分组：锁  -->
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="{StaticResource DialogIconFont}"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                                                        Text="&#xf023;">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>

                                                        <!--  行内重名提示  -->
                                                        <TextBlock
                                                            Margin="28,0,10,6"
                                                            FontSize="10.5"
                                                            Foreground="{StaticResource DialogDangerTextBrush}"
                                                            Text="{Binding EditError}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{Binding EditError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                                                        <!--  删除确认  -->
                                                        <Border
                                                            Padding="10,8"
                                                            Background="{StaticResource DialogDangerSubtleBrush}"
                                                            BorderBrush="{StaticResource DialogDangerBorderBrush}"
                                                            BorderThickness="0,0,0,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource DialogDangerTextBrush}"
                                                                    Text="{Binding DeleteConfirmText}"
                                                                    TextWrapping="Wrap" />
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal">
                                                                    <Button
                                                                        Height="26"
                                                                        Padding="8,0"
                                                                        Command="{Binding DataContext.GroupEditor.CancelDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="取消"
                                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                                        FontSize="11"
                                                                        Style="{StaticResource DialogTextButton}" />
                                                                    <Button
                                                                        Height="26"
                                                                        Margin="4,0,0,0"
                                                                        Padding="8,0"
                                                                        Background="{StaticResource DialogDangerBrush}"
                                                                        BorderThickness="0"
                                                                        Command="{Binding DataContext.GroupEditor.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="删除分组"
                                                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource DialogSurfaceBrush}"
                                                                        Style="{StaticResource DialogTextButton}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!--  新增分组  -->
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="新增分组" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            Height="34"
                                            MaxLength="20"
                                            Style="{StaticResource DialogInput}"
                                            Text="{Binding GroupEditor.NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Height="34"
                                            Margin="8,0,0,0"
                                            Padding="14,0"
                                            Command="{Binding GroupEditor.AddGroupCommand}"
                                            Content="添加"
                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                            FontSize="12"
                                            Style="{StaticResource DialogPrimaryButton}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogDangerTextBrush}"
                                        Text="{Binding GroupEditor.NewGroupError}"
                                        Visibility="{Binding GroupEditor.NewGroupError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="输入分组名称，如：报警分组；名称不可重复（不区分大小写），「未分组」为系统内置。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  底栏  -->
                        <Border
                            Grid.Row="2"
                            Padding="18,10"
                            Background="{StaticResource DialogRowAlternateBrush}"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="改名不改变变量归属；删除分组时变量回落到「未分组」。"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="1"
                                    Height="30"
                                    Padding="12,0"
                                    Command="{Binding CloseGroupManagerCommand}"
                                    Content="关闭"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                    FontSize="12"
                                    Style="{StaticResource DialogTextButton}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
