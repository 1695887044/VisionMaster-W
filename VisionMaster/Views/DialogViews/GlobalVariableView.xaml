<UserControl
    x:Class="VisionMaster.Views.DialogViews.GlobalVariableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="1240"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource DialogBackgroundBrush}"
    mc:Ignorable="d">

    <!--
        ============================================================================
        变量管理（三栏：来源树 / 新建变量 / 变量明细）
        ============================================================================

        本视图不再自带 UserControl.Resources：
        颜色一律取 Colors.xaml 的 Dialog* 令牌节，控件皮肤一律取 DialogStyles.xaml，
        两者都挂在 UI/Controls/Themes/Generic.xaml 的合并链上，全应用共享。
        这么做是为了消灭"三套蓝并存"：连接管理曾用 #17A2F2、本画面用 #0EA5E9、
        扫描组编辑用 #409EFF，而扫描组编辑又是从连接管理点进去的，两套蓝会直接照面。

        注意 DataGrid 四件套（DataGrid / Row / Cell / ColumnHeader）：
        以前这里写的是"不带 x:Key 的隐式样式"，作用域只在本视图内，安全。
        但共享皮肤放进全局合并字典后，隐式样式会盖掉 DefaultStyle.xaml 里那支
        全局 DataGrid 皮肤，波及全应用每个表格 —— 所以共享版一律带 Dialog 键名，
        本视图通过 Style / CellStyle / RowStyle / ColumnHeaderStyle 显式引用。
    -->

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="296" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左栏：变量来源树  ============  -->
        <Grid Grid.Column="0">
            <Border Style="{StaticResource DialogCardShadow}" />
            <Border Style="{StaticResource DialogCardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource DialogCardHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DialogCardTitleIcon}" Text="&#xf0c9;" />
                            <TextBlock Style="{StaticResource DialogCardTitle}" Text="变量来源" />
                        </StackPanel>
                    </Border>

                    <!--
                        ItemContainerStyle 用一个空 ContentPresenter 把 ListBoxItem 的
                        默认外观（选中蓝底、焦点框）整个剥掉 —— 选中态由节点模板自己画
                        （左侧色条 + 浅蓝底），否则会出现"系统蓝 + 设计蓝"两层底色。
                    -->
                    <ListBox
                        Grid.Row="1"
                        Margin="8"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemTemplate="{StaticResource DialogSourceNodeTemplate}"
                        ItemsSource="{Binding SourceNodes}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedSource}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!--  ============ 中栏：新建变量  ============  -->
        <Grid Grid.Column="2">
            <Border Style="{StaticResource DialogCardShadow}" />
            <Border Style="{StaticResource DialogCardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource DialogCardHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DialogCardTitleIcon}" Text="&#xf067;" />
                            <TextBlock Style="{StaticResource DialogCardTitle}" Text="新建变量" />
                        </StackPanel>
                    </Border>

                    <!--  表单区可滚动：窗口高度不足时不会把"创建变量"按钮顶掉  -->
                    <ScrollViewer
                        Grid.Row="1"
                        Padding="16,14,16,12"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!--  本地/网络 分段切换：两段常显，选中段填主色  -->
                            <Border
                                Height="38"
                                Margin="0,0,0,16"
                                Style="{StaticResource DialogSegmentHost}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton
                                        Grid.Column="0"
                                        Content="本地变量"
                                        GroupName="SourceCapsule"
                                        IsChecked="{Binding IsLocalSource, Mode=TwoWay}"
                                        Style="{StaticResource DialogSegmentRadio}" />

                                    <RadioButton
                                        Grid.Column="1"
                                        Content="网络变量"
                                        GroupName="SourceCapsule"
                                        IsChecked="{Binding IsNetworkSource, Mode=TwoWay}"
                                        Style="{StaticResource DialogSegmentRadio}" />
                                </Grid>
                            </Border>

                            <!--  变量名称  -->
                            <TextBlock Style="{StaticResource DialogFormLabel}" Text="变量名称" />
                            <TextBox
                                Margin="0,0,0,14"
                                Style="{StaticResource DialogInput}"
                                Tag="例如 Motor1_Speed"
                                Text="{Binding NewVarName, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  数据类型  -->
                            <TextBlock Style="{StaticResource DialogFormLabel}" Text="数据类型" />
                            <ComboBox
                                Margin="0,0,0,14"
                                ItemTemplate="{StaticResource DialogDisplayNameTemplate}"
                                ItemsSource="{Binding FilteredTypes}"
                                SelectedItem="{Binding SelectedType}"
                                Style="{StaticResource DialogCombo}" />

                            <!--  变量描述  -->
                            <TextBlock Style="{StaticResource DialogFormLabel}" Text="变量描述 (选填)" />
                            <TextBox
                                Height="42"
                                Margin="0,0,0,14"
                                AcceptsReturn="True"
                                Style="{StaticResource DialogInput}"
                                Tag="给后来接手的人留一句话"
                                Text="{Binding NewVarDescription, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />

                            <!--  ============ 网络专属配置区（浅蓝分组：分组标题 + 白底控件）  ============  -->
                            <Border
                                Padding="14"
                                Background="{StaticResource DialogAccentSoftBrush}"
                                BorderBrush="{StaticResource DialogAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkSource}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <!--  分组标题：与卡片标题形成字体阶梯  -->
                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource Icon}"
                                            FontSize="12"
                                            Foreground="{StaticResource DialogAccentBrush}"
                                            Text="&#xf0ac;" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Text="网络参数" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource DialogFormLabel}" Text="所属连接" />
                                    <ComboBox
                                        Margin="0,0,0,12"
                                        ItemTemplate="{StaticResource DialogConnectionOptionTemplate}"
                                        ItemsSource="{Binding Connections}"
                                        SelectedItem="{Binding SelectedConnection}"
                                        Style="{StaticResource DialogComboInGroup}" />

                                    <!--  扫描组：决定这个点位的采集节拍。右侧「管理」直达连接级组表编辑器
                                          （与「通讯设置 → 操作列 → 扫描组」是同一个弹窗、同一份组表）  -->
                                    <TextBlock Style="{StaticResource DialogFormLabel}" Text="扫描组" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            ItemsSource="{Binding NewScanGroupOptions}"
                                            SelectedItem="{Binding SelectedNewScanGroup}"
                                            Style="{StaticResource DialogComboInGroup}"
                                            ToolTip="决定采集节拍。选「默认组」= 跟随该连接的轮询周期；自定义组的周期在右侧「管理」里维护。建完会记住本次选择，方便连续录同节拍的点位。" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding ManageScanGroupsCommand}"
                                            Foreground="{StaticResource DialogAccentBrush}"
                                            Style="{StaticResource DialogIconButton}"
                                            ToolTip="管理扫描组：新增 / 改名 / 删除组、改周期（作用对象 = 上面选的「所属连接」）">
                                            <TextBlock
                                                FontFamily="{StaticResource Icon}"
                                                FontSize="14"
                                                Text="&#xf5fd;" />
                                        </Button>
                                    </Grid>

                                    <TextBlock Style="{StaticResource DialogFormLabel}" Text="存储区" />
                                    <ComboBox
                                        Margin="0,0,0,12"
                                        ItemTemplate="{StaticResource DialogDisplayNameTemplate}"
                                        ItemsSource="{Binding AreaOptions}"
                                        SelectedItem="{Binding SelectedAreaType}"
                                        Style="{StaticResource DialogComboInGroup}" />

                                    <UniformGrid Margin="0,0,0,12" Columns="2">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource DialogFormLabel}" Text="偏移量" />
                                            <TextBox
                                                Style="{StaticResource DialogInputInGroup}"
                                                Text="{Binding NewOffset, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DialogFormLabel}" Text="位偏移" />
                                            <TextBox
                                                Style="{StaticResource DialogInputInGroup}"
                                                Text="{Binding NewBitOffset, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>

                                    <!--  地址/协议摘要胶囊：边填边预览最终落点，避免"填完创建了才发现地址不对"  -->
                                    <Border
                                        Padding="10,7"
                                        Background="{StaticResource DialogAccentLightBrush}"
                                        CornerRadius="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{StaticResource DialogAccentTextBrush}"
                                                Text="地址" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogAccentDarkBrush}"
                                                Text="{Binding NewOffset}" />
                                            <Border
                                                Width="1"
                                                Margin="12,1"
                                                Background="{StaticResource DialogAccentBorderBrush}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{StaticResource DialogAccentTextBrush}"
                                                Text="协议" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogAccentDarkBrush}"
                                                Text="{Binding SelectedConnection.Protocol}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  网络模式提示（线圈区布尔说明）：只在"网络 + 线圈/离散区"同时成立时出现  -->
                            <TextBlock
                                Margin="2,10,0,0"
                                FontSize="11"
                                Foreground="{StaticResource DialogWarningTextBrush}"
                                Text="线圈/离散输入区仅支持布尔类型，且不使用位偏移"
                                TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNetworkSource}" Value="True" />
                                                    <Condition Binding="{Binding IsCoilOrDiscrete}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  底部操作区：与表单之间用分割线断开，按钮不再悬在空白里  -->
                    <Border
                        Grid.Row="2"
                        Padding="16,12"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,1,0,0">
                        <Button
                            Command="{Binding AddCommand}"
                            Content="＋ 创建变量"
                            Style="{StaticResource DialogPrimaryButton}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  ============ 右栏：变量明细  ============  -->
        <Grid Grid.Column="4">
            <Border Style="{StaticResource DialogCardShadow}" />
            <Border Style="{StaticResource DialogCardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题 + 搜索  -->
                    <Border Grid.Row="0" Style="{StaticResource DialogCardHeader}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DialogCardTitleIcon}" Text="&#xf0ce;" />
                                <TextBlock Style="{StaticResource DialogCardTitle}" Text="变量明细" />
                                <!--  变量数徽标  -->
                                <Border
                                    Margin="8,0,0,0"
                                    MinWidth="22"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DialogAccentLightBrush}"
                                    CornerRadius="11">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                        Text="{Binding SelectedSource.Count, FallbackValue=0}" />
                                </Border>
                            </StackPanel>

                            <!--
                                搜索框：外层 Border 画框 + 放大镜，内层 TextBox 完全透明撑满 * 列。
                                占位提示靠 Tag 传进 TextBox 自己的模板里，输入后自动消失。
                                老写法把提示做成"旁边一个常驻 TextBlock"，用户一输入就出现
                                "提示和内容并排"的鬼影，而且 TextBox 塞在横向 StackPanel 里宽度不受控。
                            -->
                            <Border
                                Width="220"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource DialogSearchChrome}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource DialogSearchIcon}"
                                        Text="&#xf002;" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource DialogSearchInput}"
                                        Tag="搜索变量名 / 地址"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <DataGrid
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding FilteredDisplayNodes}"
                        Style="{StaticResource DialogDataGrid}">
                        <DataGrid.Columns>
                            <!--  变量名（树形缩进 + 展开按钮）  -->
                            <DataGridTemplateColumn Width="146" Header="变量名">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Background="Transparent" Orientation="Horizontal">
                                            <Border Width="{Binding Level, Converter={ui:LevelToIndentConverter}}" />
                                            <ToggleButton
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.ToggleNodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                Template="{StaticResource ExpandToggleButtonTemplate}"
                                                Visibility="{Binding IsContainer, Converter={ui:BooleanToVisibilityConverter}}" />
                                            <Border Width="{Binding IsContainer, Converter={ui:BooleanToWidthConverter}, ConverterParameter=22}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <!--  子节点（数组成员）压成次要色，与父节点拉开层级  -->
                                                            <DataTrigger Binding="{Binding Level}" Value="1">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  类型  -->
                            <DataGridTextColumn
                                Width="56"
                                Binding="{Binding TypeName}"
                                Header="类型"
                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!--  来源徽标（本地/连接名 + 在线圆点）  -->
                            <DataGridTemplateColumn Width="104" Header="来源">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding IsRootNode, Converter={ui:BooleanToVisibilityConverter}}">
                                            <Ellipse Style="{StaticResource DialogStatusDot}" />
                                            <Border
                                                MaxWidth="88"
                                                Margin="6,0,0,0"
                                                Padding="7,2"
                                                VerticalAlignment="Center"
                                                CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    FontSize="11"
                                                    TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                                            <Setter Property="Text" Value="{Binding SourceLabel}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNetwork}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  扫描组（网络变量根节点才有；空组名 = 默认组，显示成"默认组"）  -->
                            <DataGridTemplateColumn Width="96" Header="扫描组">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            Height="30"
                                            Padding="8,0,24,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            ItemsSource="{Binding ScanGroupOptions}"
                                            SelectedItem="{Binding ScanGroupText, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DialogCombo}"
                                            ToolTip="该点由哪个扫描周期采集（默认组周期取连接的默认组周期）"
                                            Visibility="{Binding ShowScanGroup, Converter={ui:BooleanToVisibilityConverter}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  设备地址  -->
                            <DataGridTemplateColumn Width="74" Header="地址">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                            Text="{Binding Address}"
                                            ToolTip="{Binding Address}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  初始值  -->
                            <DataGridTemplateColumn Width="96" Header="初始值">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border
                                                Height="26"
                                                Background="{StaticResource DialogInputBackgroundBrush}"
                                                BorderBrush="{StaticResource DialogBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <!--  Style 置空：只借外层 Border 的框，不让 DialogInput 的高度/内边距压进来  -->
                                                <TextBox
                                                    Padding="8,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="12"
                                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                    Style="{x:Null}"
                                                    Text="{Binding DefaultValueText, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                    ToolTip="按变量类型校验：与类型不符的值会被拒绝（红框），不会污染模型"
                                                    Visibility="{Binding IsEditableNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                            </Border>
                                            <Button
                                                Command="{Binding DataContext.EditArrayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="编辑集合..."
                                                Style="{StaticResource LinkButtonStyle}"
                                                Visibility="{Binding IsArrayRootNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                Padding="2,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="{Binding ChildDefaultValue}"
                                                Visibility="{Binding IsChildNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  当前值（青蓝胶囊样式）  -->
                            <DataGridTemplateColumn Width="*" Header="当前值">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border
                                                Height="26"
                                                MinWidth="40"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource DialogAccentLightBrush}"
                                                CornerRadius="13"
                                                Visibility="{Binding IsRootNode, Converter={ui:BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--  质量色点：绿=采集正常 / 黄=最近一次读取失败(显示旧值) / 灰=断线或从未读到；本地变量无质量概念 → 不显示  -->
                                                    <Ellipse
                                                        Grid.Column="0"
                                                        Width="5"
                                                        Height="5"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="采集质量：绿=正常 / 黄=最近一次读取失败（显示旧值） / 灰=断线或从未读到">
                                                        <!--
                                                            色值刻意不走 Dialog* 令牌：这套绿/黄/灰是"采集质量"的
                                                            全项目统一约定，SCADA 图层面板、流程画布、属性面板都用同一组，
                                                            换肤时应整体一起动，不能只让弹窗变。
                                                        -->
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#FFC0C4CC" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Good">
                                                                        <Setter Property="Fill" Value="#FF67C23A" />
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Uncertain">
                                                                        <Setter Property="Fill" Value="#FFE6A23C" />
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Bad">
                                                                        <Setter Property="Fill" Value="#FFC0C4CC" />
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="3,0,10,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding OriginalModel.Value, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{Binding IsEditableNode, Converter={ui:BooleanToVisibilityConverter}}">
                                                        <!--  Foreground 必须放进 Style：attribute 形式的本地值优先级高于 DataTrigger，Bad 时打不灰  -->
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding OriginalModel.Quality}" Value="Bad">
                                                                        <Setter Property="Foreground" Value="#FF909399" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.EditArrayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Content="强制覆盖集合..."
                                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        Visibility="{Binding IsArrayRootNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock
                                                Padding="2,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogAccentTextBrush}"
                                                Text="{Binding ChildValue}"
                                                Visibility="{Binding IsChildNode, Converter={ui:BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  操作  -->
                            <DataGridTemplateColumn Width="162" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding IsRootNode, Converter={ui:BooleanToVisibilityConverter}}">
                                            <!--  复制变量名（HMI 组态预留入口）  -->
                                            <Button
                                                Command="{Binding DataContext.CopyNameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="复制变量名（供画布组态绑定）">
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="&#xf0c5;" />
                                            </Button>
                                            <!--  重命名（经注册表统一入口，连线/监视项/轮询注册自动跟随）  -->
                                            <Button
                                                Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="重命名变量">
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="&#xf044;" />
                                            </Button>
                                            <!--  写值到设备（仅网络变量）  -->
                                            <Button
                                                Command="{Binding DataContext.WriteValueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="写值到设备">
                                                <Button.Visibility>
                                                    <Binding Path="IsNetwork" Converter="{ui:BooleanToVisibilityConverter}" />
                                                </Button.Visibility>
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource DialogAccentBrush}"
                                                    Text="&#xf093;" />
                                            </Button>
                                            <!--  恢复初始值  -->
                                            <Button
                                                Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="恢复初始值">
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                                    Text="&#xf0e2;" />
                                            </Button>
                                            <!--  删除  -->
                                            <Button
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="删除">
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="13"
                                                    Foreground="{StaticResource DialogDangerBrush}"
                                                    Text="&#xf1f8;" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  底部提示  -->
                    <TextBlock
                        Grid.Row="2"
                        Margin="16,12"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="* 网络变量：当前值来自轮询采集，写值直达设备。本地变量：值由您在界面上维护；流程内插件创建的运行时变量（Runtime.*）不在此列，请到监视栏查看。"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
