<UserControl
    x:Class="VisionMaster.Views.DialogViews.MotionDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    MinWidth="1080"
    MinHeight="640"
    Background="{StaticResource DialogBackgroundBrush}"
    FontFamily="Microsoft YaHei"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--
                只准写依赖属性：WindowStartupLocation 是普通 CLR 属性，写进 Setter 会在加载本视图时抛
                XamlParseException（「设置属性 System.Windows.Setter.Property 时引发了异常」）。
                见 VariableBindingCheck 里的窗口样式契约断言。
            -->
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1280" />
            <Setter Property="Height" Value="800" />
            <Setter Property="MinWidth" Value="1080" />
            <Setter Property="MinHeight" Value="640" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--
        ════════════════════════════════════════════════════════════════════════
        运动卡调试面板（手动操作）
        ════════════════════════════════════════════════════════════════════════

        与「运动卡设置」分成两个弹窗：设置是配置（低频、改错影响产线），
        这里是操作（高频、现场天天用）。混在一起会导致调试时屏幕上全是配置项、
        而配置时手容易点错到旁边的急停。

        **"一带多"是本面板的组织原则**：一张卡 4/8/32 根轴，左侧把每根轴的位置与状态
        并排列出，选中哪根就在中间操作哪根。

        三条安全设计（都体现在这个视图与它的 VM 里）：
          ① 点动「按住才动」——ui:HoldCommandBehavior 负责按下/松开；
          ② 点动心跳兜底 —— VM 看门狗在界面事件丢失时自动停；
          ③ 急停按钮独立且醒目 —— 不藏在菜单里，任何时刻都能点到。

        视觉全部走 UI 库（DialogStyles.xaml / Colors.xaml）的 Dialog* 键：
        本视图只留"往格子里填什么"的 DataTemplate，不留任何本地样式与色值。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏（自绘）：整条可拖，右侧 × 关闭  -->
        <Border
            Grid.Row="0"
            ui:WindowDragBehavior.IsWindowDraggable="True"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    FontSize="15"
                    Foreground="{StaticResource DialogAccentBrush}"
                    Text="&#xf0d1;" />

                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="手动使能 / 点动 / 定位 / 回零 / IO —— 点动为按住才动、松手即停" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭（会自动停止点动）">
                    <TextBlock
                        FontFamily="{StaticResource Icon}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <!--
            操作反馈条（整宽 banner）。
            放在标题栏正下方、横贯整个窗口：手动操作是"点一下立刻要看到结果"的场景，
            提示压在右边栏底部容易漏看。样式用轻信息块（浅底 + 细描边），不抢内容。
        -->
        <Border
            Grid.Row="1"
            Margin="20,14,20,0"
            Style="{StaticResource DialogInfoPanel}">
            <TextBlock Style="{StaticResource DialogHintText}" Text="{Binding StatusHint}" />
        </Border>

        <Grid Grid.Row="2" Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  工具条：卡选择 + 信息 chips + 操作按钮  -->
            <Border Grid.Row="0" Style="{StaticResource DialogColumnCard}">
                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource DialogFormLabel}"
                        Margin="0,0,10,0"
                        Text="运动卡" />

                    <ComboBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Caption"
                        ItemsSource="{Binding Cards}"
                        SelectedItem="{Binding SelectedCard}"
                        Style="{StaticResource DialogCombo}"
                        ToolTip="一张卡带多根轴：选中卡后，左侧会列出它的全部轴" />

                    <!--  信息 chips：机型 / 状态 / 轴数 / IO 并排展示，一眼看完"连的是哪台、什么状态"  -->
                    <StackPanel
                        Grid.Column="2"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        ToolTip="{Binding CardStateText}">

                        <Border Style="{StaticResource DialogChipAccent}">
                            <TextBlock Style="{StaticResource DialogChipTextAccent}" Text="{Binding CardModelText}" />
                        </Border>

                        <Border Margin="6,0,0,0">
                            <Border.Style>
                                <!--  连接状态的配色按语义级别切换（在线=绿 / 报警=红 / 其他=中性）  -->
                                <Style TargetType="Border" BasedOn="{StaticResource DialogChipNeutral}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardStateLevel}" Value="Success">
                                            <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CardStateLevel}" Value="Danger">
                                            <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CardStateLevel}" Value="Warning">
                                            <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CardStateLevel}" Value="Accent">
                                            <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DialogChipTextNeutral}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardStateLevel}" Value="Success">
                                                <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CardStateLevel}" Value="Danger">
                                                <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CardStateLevel}" Value="Warning">
                                                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CardStateLevel}" Value="Accent">
                                                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <!--
                                    ⚠ 必须显式写 Mode=OneWay：Run.Text 的默认绑定模式是 **TwoWay**
                                      （它是 FlowDocument 元素，为 RichTextBox 场景设计的），
                                      而 VM 里的状态标签是只读属性 —— 不写的话运行时会抛
                                      InvalidOperationException「无法对只读属性进行 TwoWay 绑定」，
                                      整个面板加载失败（探针实测）。
                                      这与 TextBlock.Text（默认 OneWay）的行为不同，很容易踩。
                                -->
                                <Run Text="{Binding CardStateLabel, Mode=OneWay}" />
                            </TextBlock>
                        </Border>

                        <Border Margin="6,0,0,0" Style="{StaticResource DialogChipNeutral}">
                            <TextBlock Style="{StaticResource DialogChipTextNeutral}" Text="{Binding CardAxisText}" />
                        </Border>

                        <!--  IO 点数未核实时在同一个 chip 里带一个"约"标记，而不是另起一行解释  -->
                        <Border Margin="6,0,0,0" Style="{StaticResource DialogChipNeutral}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DialogChipTextNeutral}" Text="{Binding CardIoText}" />
                                <TextBlock
                                    Style="{StaticResource DialogChipTextWarning}"
                                    Text=" ≈"
                                    ToolTip="该机型的 IO 点数未核实（虚拟 PLC 的点位取决于组态），此处按常见值显示上限">
                                    <TextBlock.Visibility>
                                        <Binding Path="IsIoCountApproximate" Converter="{ui:BooleanToVisibilityConverter}" />
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            MinWidth="88"
                            Command="{Binding ConnectCommand}"
                            Content="连接 / 断开"
                            Style="{StaticResource DialogSecondaryButton}" />
                        <Button
                            MinWidth="88"
                            Margin="10,0,0,0"
                            Command="{Binding ClearAlarmCommand}"
                            Content="清除报警"
                            Style="{StaticResource DialogSecondaryButton}"
                            ToolTip="清除伺服报警（不会自动重新使能）" />
                        <!--  急停：独立、醒目、位置固定 —— 出事时不能靠翻菜单找  -->
                        <Button
                            MinWidth="104"
                            Margin="10,0,0,0"
                            Command="{Binding EmergencyStopCommand}"
                            Content="急停"
                            Style="{StaticResource DialogDangerButton}"
                            ToolTip="清空待执行命令并立即停止全部轴。注意：软件急停不能替代硬件安全回路" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  主体三栏：轴列表 / 手动操作 / IO  -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <!--
                        两侧栏从 300 收到 268：左栏每行是"状态点 + 轴名 + 位置"，右栏是 IO 点阵，
                        300 时右侧留白明显（用户反馈"整体过于稀疏"）；省下的宽度留给中间的手动操作区
                        （那里按钮多、文本框密，本来就最挤）。
                    -->
                    <ColumnDefinition Width="268" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="268" />
                </Grid.ColumnDefinitions>

                <!--  左：轴列表（一带多）  -->
                <Border Grid.Column="0" Style="{StaticResource DialogColumnCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DialogSectionHeader}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogAccentBrush}"
                                    Text="&#xf0ce;" />
                                <TextBlock Style="{StaticResource DialogSectionTitle}" Text="轴" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="选中后在中间操作" />
                            </StackPanel>
                        </Border>

                        <ListBox
                            Grid.Row="1"
                            Margin="2,4,2,2"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource DialogOptionItem}"
                            ItemsSource="{Binding Axes}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedAxis}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  状态点：颜色由语义级别决定（报警红 / 限位橙 / 运动中蓝 / 到位绿 / 其它灰）  -->
                                        <Ellipse
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="0"
                                            Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource DialogStatusDot}">
                                                    <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="Danger">
                                                            <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="Warning">
                                                            <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="Accent">
                                                            <Setter Property="Fill" Value="{StaticResource DialogAccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="Success">
                                                            <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding LogicalName}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource DialogMonoText}"
                                            Text="{Binding PositionText}" />

                                        <!--  状态短标签（chip）：比一整句 Describe() 更适合列表扫视  -->
                                        <Border
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,3,0,0"
                                            HorizontalAlignment="Left"
                                            ToolTip="{Binding StateText}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource DialogChipNeutral}">
                                                    <Setter Property="Padding" Value="6,1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="Danger">
                                                            <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="Warning">
                                                            <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="Accent">
                                                            <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StateLevel}" Value="Success">
                                                            <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StateLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DialogChipTextNeutral}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateLevel}" Value="Danger">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateLevel}" Value="Warning">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateLevel}" Value="Accent">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StateLevel}" Value="Success">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!--  中：手动操作  -->
                <Border Grid.Column="2" Style="{StaticResource DialogColumnCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DialogSectionHeader}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogAccentBrush}"
                                    Text="&#xf013;" />
                                <TextBlock Style="{StaticResource DialogSectionTitle}" Text="手动操作" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="{Binding SelectedAxis.LogicalName, StringFormat='当前轴：{0}'}" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer
                            Grid.Row="1"
                            Padding="14,12,14,14"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!--  使能 / 失能 / 停止  -->
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="伺服使能" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        MinWidth="92"
                                        Command="{Binding EnableCommand}"
                                        Content="使能"
                                        Style="{StaticResource DialogPrimaryButton}" />
                                    <Button
                                        MinWidth="92"
                                        Margin="10,0,0,0"
                                        Command="{Binding DisableCommand}"
                                        Content="失能"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                    <Button
                                        Margin="10,0,0,0"
                                        Command="{Binding StopCommand}"
                                        Content="停止"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        ToolTip="减速停止当前轴" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="使能会给伺服上电（有机械后果）；失能前请确认机构处于安全位置。" />

                                <!--  点动（按住才动）  -->
                                <TextBlock
                                    Margin="0,16,0,0"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="点动（按住才动，松开即停）" />
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        MinWidth="106"
                                        Height="34"
                                        Content="◀ 负向"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        ToolTip="按住向负方向连续运动，松开立即停止"
                                        ui:HoldCommandBehavior.HoldCommand="{Binding StartJogCommand}"
                                        ui:HoldCommandBehavior.HoldCommandParameter="-"
                                        ui:HoldCommandBehavior.ReleaseCommand="{Binding StopJogCommand}" />
                                    <Button
                                        MinWidth="106"
                                        Height="34"
                                        Margin="10,0,0,0"
                                        Content="正向 ▶"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        ToolTip="按住向正方向连续运动，松开立即停止"
                                        ui:HoldCommandBehavior.HoldCommand="{Binding StartJogCommand}"
                                        ui:HoldCommandBehavior.HoldCommandParameter="+"
                                        ui:HoldCommandBehavior.ReleaseCommand="{Binding StopJogCommand}" />
                                    <TextBlock
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogFormLabel}"
                                        Text="速度(mm/s)" />
                                    <TextBox
                                        Width="84"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogCellInput}"
                                        Text="{Binding JogVelocity, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="点动没有终点：界面若因失焦/卡顿漏掉「松开」，面板会在 0.5 秒内自动停止（心跳兜底）。" />

                                <!--  定位  -->
                                <TextBlock
                                    Margin="0,16,0,0"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="定位（绝对位置）" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogCellInput}"
                                        Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="目标位置（mm）" />
                                    <Button
                                        Margin="8,0,0,0"
                                        Command="{Binding UseCurrentPositionCommand}"
                                        Content="取当前位置"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        ToolTip="把目标位置填成该轴当前位置，便于在此基础上微调" />
                                    <TextBlock
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogFormLabel}"
                                        Text="速度(mm/s，0=卡内默认)" />
                                    <TextBox
                                        Width="84"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogCellInput}"
                                        Text="{Binding MoveVelocity, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                    <Button
                                        MinWidth="118"
                                        Command="{Binding GoToCommand}"
                                        Content="走到（不等待）"
                                        Style="{StaticResource DialogSecondaryButton}"
                                        ToolTip="下发后立即返回（需要多轴同时起步时用这个）" />
                                    <Button
                                        MinWidth="136"
                                        Margin="10,0,0,0"
                                        Command="{Binding GoToAndWaitCommand}"
                                        Content="走到并等待到位"
                                        Style="{StaticResource DialogPrimaryButton}"
                                        ToolTip="下发后轮询到到位或超时，调试时更常用" />
                                    <TextBlock
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogFormLabel}"
                                        Text="等待超时(ms)" />
                                    <TextBox
                                        Width="84"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogCellInput}"
                                        Text="{Binding MoveTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!--  回零  -->
                                <TextBlock
                                    Margin="0,16,0,0"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="回零方式" />
                                <StackPanel Orientation="Horizontal">
                                    <!--  DisplayMemberPath 绑中文名：枚举成员名（NegativeLimitIndex）操作员看不懂。
                                          悬停给出该方式的一句话说明。  -->
                                    <ComboBox
                                        Width="230"
                                        VerticalAlignment="Center"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding HomeModes}"
                                        SelectedItem="{Binding SelectedHomeMode}"
                                        Style="{StaticResource DialogCombo}"
                                        ToolTip="{Binding SelectedHomeMode.Hint}" />
                                    <Button
                                        MinWidth="116"
                                        Margin="10,0,0,0"
                                        Command="{Binding HomeCommand}"
                                        Content="开始回零"
                                        Style="{StaticResource DialogPrimaryButton}"
                                        ToolTip="阻塞到回零完成或超时（最长 120 秒）。未连接时列出全部方式，连上后只留该卡支持项" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,7,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="回零速度与回零偏移沿用控制器内的既有设置（驱动不擅自覆盖现场已调好的参数）。" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!--  右：IO 手动  -->
                <Border Grid.Column="4" Style="{StaticResource DialogColumnCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DialogSectionHeader}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogAccentBrush}"
                                    Text="&#xf0e7;" />
                                <TextBlock Style="{StaticResource DialogSectionTitle}" Text="卡上 IO" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="14,12,14,14" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="数字输入（只读监视）" />
                                <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding Inputs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DialogChipNeutral}">
                                                        <Setter Property="Padding" Value="7,1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Margin="0,0,5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse" BasedOn="{StaticResource DialogStatusDot}">
                                                                <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Port}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DialogChipTextNeutral}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock
                                    Margin="0,10,0,0"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="数字输出（点击切换）" />
                                <ItemsControl ItemsSource="{Binding Outputs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="50"
                                                Height="26"
                                                Margin="0,0,6,6"
                                                Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Port}"
                                                ToolTip="点击切换该输出的通断">
                                                <Button.Style>
                                                    <!--
                                                        底色按语义成对给（DialogChipButton 只管形状）：
                                                        OFF = 中性灰底灰字，ON = 强调色实底白字。
                                                        一眼能扫出哪些输出是通的 —— 调试时最常问的就是这个。
                                                    -->
                                                    <Style TargetType="Button" BasedOn="{StaticResource DialogChipButton}">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter Property="Background" Value="{StaticResource DialogAccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,12,0,0" Style="{StaticResource DialogInfoPanel}">
                                    <TextBlock
                                        Style="{StaticResource DialogHintText}"
                                        Text="输入点每 200ms 刷新（读驱动轮询快照，不额外占用通信）。写输出与轴命令走同一条队列，因此「先动轴再夹紧」这类顺序天然成立。" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock
                Grid.Row="2"
                Margin="2,10,0,0"
                Style="{StaticResource DialogHintText}"
                Text="提示：手动操作只影响当前设备状态，不会修改流程或方案。做完对位后请把位置参数记进流程步骤，否则下次运行不会复现。" />
        </Grid>
    </Grid>

</UserControl>
