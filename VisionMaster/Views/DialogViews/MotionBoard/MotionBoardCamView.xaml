<UserControl
    x:Class="VisionMaster.Views.DialogViews.MotionBoard.MotionBoardCamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Core.Interfaces;assembly=Core.Interfaces">

    <!--
        页签四「电子凸轮」（规格第 6 章）：
        ① 表栏（表名 chips + 新建 + 重命名输入 + 删除本表）
        ② 同步运行卡（主/从轴下拉 + 主轴速度 + 启动/停止/复位 + 读数条 + 周期进度 + 状态胶囊 + 轮廓预览）
        ③ 拐点表（# | 主轴位置 | 从轴位置 | 到下一点插补 | 删除；≤2 行禁删）
        ④ 贴底保存条。
        凸轮表为全局实体（跨卡任意主从组合），同步为纯软件仿真（不依赖卡连接）。
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VisionMaster;component/Views/DialogViews/MotionBoard/MotionBoardTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <x:Array x:Key="CamInterpOptions" Type="sys:String"
                     xmlns:sys="clr-namespace:System;assembly=mscorlib">
                <sys:String>直线</sys:String>
                <sys:String>三次曲线</sys:String>
            </x:Array>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--  空态  -->
        <Border
            Background="{StaticResource MbCardBrush}"
            BorderBrush="{StaticResource MbBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="40"
            Visibility="{Binding HasTable, Converter={StaticResource MbInverseBoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border
                    Width="48"
                    Height="48"
                    Background="{StaticResource MbPrimarySoftBrush}"
                    CornerRadius="12">
                    <TextBlock
                        FontFamily="{StaticResource Icon}"
                        FontSize="20"
                        Foreground="{StaticResource MbPrimaryBrush}"
                        Text="&#xf02e;"
                        TextAlignment="Center" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource MbTextSecondaryBrush}"
                    Text="当前还没有凸轮表" />
                <Button
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    Command="{Binding AddTableCommand}"
                    Style="{StaticResource MbPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="12"
                            Text="&#xf067;" />
                        <TextBlock Margin="7,0,0,0" Text="新建凸轮表" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!--  主体  -->
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding HasTable, Converter={StaticResource MbBoolToVis}}">
            <Grid Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ① 表栏  -->
                <Border Grid.Row="0" Style="{StaticResource MbCard}" Padding="20,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource MbPrimarySoftBrush}"
                                CornerRadius="8">
                                <TextBlock
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="14"
                                    Foreground="{StaticResource MbPrimaryBrush}"
                                    Text="&#xf02e;"
                                    TextAlignment="Center" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
                            </Border>
                            <Border
                                Margin="10,0,0,0"
                                Padding="4"
                                Background="{StaticResource MbSecondaryBrush}"
                                CornerRadius="8"
                                VerticalAlignment="Center">
                                <ListBox
                                    Background="Transparent"
                                    BorderThickness="0"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Tables}"
                                    SelectedItem="{Binding SelectedTable}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border
                                                            x:Name="Root"
                                                            Margin="2,0"
                                                            Padding="12,6"
                                                            Background="Transparent"
                                                            CornerRadius="6">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{StaticResource MbPrimaryBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                            <Button
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding AddTableCommand}"
                                Style="{StaticResource MbOutlineButton}"
                                Padding="10,6"
                                FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="10"
                                        Text="&#xf067;" />
                                    <TextBlock Margin="5,0,0,0" Text="新建" />
                                </StackPanel>
                            </Button>
                            <TextBox
                                Width="140"
                                Height="38"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource MbTextBox}"
                                Text="{Binding SelectedTable.Name, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="重命名（改动即生效）" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding DeleteTableCommand}"
                            Style="{StaticResource MbDangerOutlineButton}"
                            Padding="10,6"
                            FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="10"
                                    Text="&#xf014;" />
                                <TextBlock Margin="5,0,0,0" Text="删除本表" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  ② 同步运行卡  -->
                <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource MbCard}" Padding="20">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MbFieldLabel}" Text="主轴（发报）" />
                                    <ComboBox
                                        Width="180"
                                        Height="36"
                                        FontFamily="{StaticResource MbMonoFontFamily}"
                                        ItemsSource="{Binding AxisOptions}"
                                        SelectedItem="{Binding SelectedTable.MasterAxis, Mode=TwoWay}"
                                        Style="{StaticResource MbComboBox}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Style="{StaticResource MbFieldLabel}" Text="从轴（跟随）" />
                                    <ComboBox
                                        Width="180"
                                        Height="36"
                                        FontFamily="{StaticResource MbMonoFontFamily}"
                                        ItemsSource="{Binding AxisOptions}"
                                        SelectedItem="{Binding SelectedTable.SlaveAxis, Mode=TwoWay}"
                                        Style="{StaticResource MbComboBox}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Style="{StaticResource MbFieldLabel}" Text="主轴速度 (mm/s)" />
                                    <TextBox
                                        Width="110"
                                        Height="38"
                                        FontFamily="{StaticResource MbMonoFontFamily}"
                                        Style="{StaticResource MbTextBox}"
                                        Text="{Binding CamSpeedText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Button Command="{Binding StartSyncCommand}" Style="{StaticResource MbPrimaryButton}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource MbInverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource Icon}"
                                            FontSize="11"
                                            Text="&#xf04b;" />
                                        <TextBlock Margin="7,0,0,0" Text="启动同步" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StopSyncCommand}" Style="{StaticResource MbDangerOutlineButton}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource MbBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource Icon}"
                                            FontSize="11"
                                            Text="&#xf04d;" />
                                        <TextBlock Margin="7,0,0,0" Text="停止同步" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding ResetSyncCommand}"
                                    Content="复位"
                                    Style="{StaticResource MbOutlineButton}" />
                            </StackPanel>
                        </Grid>

                        <!--  读数条  -->
                        <Border
                            Margin="0,14,0,0"
                            Padding="16,10"
                            BorderBrush="{StaticResource MbBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#1A0DA2E7" />
                                    <GradientStop Offset="0.55" Color="#66F1F5F9" />
                                    <GradientStop Offset="1" Color="#00F1F5F9" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MbEyebrow}" Text="{Binding MasterCaption}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="{StaticResource MbMonoFontFamily}"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource MbTextBrush}"
                                            Text="{Binding MasterPosText}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Bottom"
                                            FontSize="11"
                                            Foreground="{StaticResource MbTextSecondaryBrush}"
                                            Text="mm" />
                                    </StackPanel>
                                </StackPanel>
                                <Border
                                    Width="1"
                                    Height="32"
                                    Margin="16,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource MbBorderBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MbEyebrow}" Text="{Binding SlaveCaption}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="{StaticResource MbMonoFontFamily}"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource MbPrimaryBrush}"
                                            Text="{Binding SlavePosText}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Bottom"
                                            FontSize="11"
                                            Foreground="{StaticResource MbTextSecondaryBrush}"
                                            Text="mm" />
                                    </StackPanel>
                                </StackPanel>
                                <!--  本周期进度  -->
                                <StackPanel
                                    Margin="24,0,0,0"
                                    VerticalAlignment="Center"
                                    Width="220">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock FontSize="11" Foreground="{StaticResource MbTextSecondaryBrush}" Text="本周期进度" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontFamily="{StaticResource MbMonoFontFamily}"
                                            FontSize="11"
                                            Foreground="{StaticResource MbTextSecondaryBrush}"
                                            Text="{Binding ProgressText}" />
                                    </Grid>
                                    <Border
                                        Height="8"
                                        Background="{StaticResource MbBorderBrush}"
                                        CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource MbPrimaryBrush}"
                                                CornerRadius="4"
                                                Width="{Binding ProgressWidth}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <!--  状态胶囊  -->
                                <Border
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource MbSecondaryBrush}"
                                    CornerRadius="999"
                                    Padding="10,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource MbSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MbPrimarySoftBrush15}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{StaticResource MbOfflineDotBrush}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource MbInverseBoolToVis}}" />
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            VerticalAlignment="Center"
                                            Fill="{StaticResource MbPrimaryBrush}"
                                            Style="{StaticResource MbBreathDot}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource MbBoolToVis}}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding StateText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MbTextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource MbPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  轮廓预览（每段 24 细分采样 + 游标）  -->
                        <Grid Margin="0,14,0,0">
                            <!--  无表/拐点不足的占位  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,40"
                                FontSize="12"
                                Foreground="{StaticResource MbTextSecondaryBrush}"
                                Text="至少填写 2 个不同主位置的拐点后才能预览凸轮曲线"
                                Visibility="{Binding CanPreview, Converter={StaticResource MbInverseBoolToVis}}" />

                            <Viewbox
                                MaxHeight="210"
                                Stretch="Uniform"
                                StretchDirection="DownOnly"
                                Visibility="{Binding CanPreview, Converter={StaticResource MbBoolToVis}}">
                                <Canvas Width="640" Height="200">
                                    <!--  横向虚线网格（25/50/75%）  -->
                                    <Line X1="24" X2="616" Y1="62" Y2="62" Stroke="{StaticResource MbBorderBrush}" StrokeDashArray="4 6" StrokeThickness="1" />
                                    <Line X1="24" X2="616" Y1="100" Y2="100" Stroke="{StaticResource MbBorderBrush}" StrokeDashArray="4 6" StrokeThickness="1" />
                                    <Line X1="24" X2="616" Y1="138" Y2="138" Stroke="{StaticResource MbBorderBrush}" StrokeDashArray="4 6" StrokeThickness="1" />
                                    <!--  曲线  -->
                                    <Polyline
                                        Points="{Binding PolylinePoints}"
                                        Stroke="{StaticResource MbPrimaryBrush}"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="2.5" />
                                    <!--  拐点圆点  -->
                                    <ItemsControl ItemsSource="{Binding MarkerPoints}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Fill="{StaticResource MbCardBrush}"
                                                    Stroke="{StaticResource MbPrimaryBrush}"
                                                    StrokeThickness="2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!--  运行游标（竖线 + 实心点，呼吸）  -->
                                    <Line
                                        X1="{Binding CursorX}"
                                        X2="{Binding CursorX}"
                                        Y1="18"
                                        Y2="182"
                                        Stroke="{StaticResource MbPrimaryBorderBrush}"
                                        StrokeThickness="1"
                                        Visibility="{Binding HasCursor, Converter={StaticResource MbBoolToVis}}" />
                                    <Ellipse
                                        Canvas.Left="{Binding CursorDotLeft}"
                                        Canvas.Top="{Binding CursorDotTop}"
                                        Width="11"
                                        Height="11"
                                        Fill="{StaticResource MbPrimaryBrush}"
                                        Style="{StaticResource MbBreathDot}"
                                        Visibility="{Binding HasCursor, Converter={StaticResource MbBoolToVis}}" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <TextBlock
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource MbTextSecondaryBrush}"
                            Text="{Binding PreviewCaption}" />
                    </StackPanel>
                </Border>

                <!--  ③ 拐点表  -->
                <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource MbCard}" Padding="16">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MbSectionTitle}" Text="凸轮拐点" />
                            <TextBlock Style="{StaticResource MbSectionHint}" Text="主轴位置递增排列 · 插补决定本段（该点到下一点）的形状 · 末段回接首点形成周期" />
                        </StackPanel>
                        <Border
                            Background="{StaticResource MbCardBrush}"
                            BorderBrush="{StaticResource MbPrimaryBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Margin="1,1,1,0"
                                    Background="{StaticResource MbSecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Margin="12,8" FontSize="12" Foreground="{StaticResource MbTextSecondaryBrush}" Text="#" />
                                    <TextBlock Grid.Column="1" Margin="8,8" FontSize="12" Foreground="{StaticResource MbTextSecondaryBrush}" Text="主轴位置 (mm)" />
                                    <TextBlock Grid.Column="2" Margin="8,8" FontSize="12" Foreground="{StaticResource MbTextSecondaryBrush}" Text="从轴位置 (mm)" />
                                    <TextBlock Grid.Column="3" Margin="8,8" FontSize="12" Foreground="{StaticResource MbTextSecondaryBrush}" Text="到下一点插补" />
                                </Grid>
                                <ItemsControl
                                    Grid.Row="1"
                                    AlternationCount="2"
                                    ItemsSource="{Binding PointRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource MbBorderLightBrush}" BorderThickness="0,0,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlternationIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="1">
                                                                <Setter Property="Background" Value="#14F1F5F9" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="52" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Margin="12,5"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource MbMonoFontFamily}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource MbTextSecondaryBrush}"
                                                        Text="{Binding Index}" />
                                                    <TextBox
                                                        Grid.Column="1"
                                                        Margin="8,4"
                                                        Style="{StaticResource MbCellInput}"
                                                        Text="{Binding M, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox
                                                        Grid.Column="2"
                                                        Margin="4,4"
                                                        Style="{StaticResource MbCellInput}"
                                                        Text="{Binding S, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox
                                                        Grid.Column="3"
                                                        Height="28"
                                                        Margin="4,4"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        ItemsSource="{StaticResource CamInterpOptions}"
                                                        SelectedItem="{Binding Interp}"
                                                        Style="{StaticResource MbComboBox}" />
                                                    <Button
                                                        Grid.Column="4"
                                                        Width="28"
                                                        Height="28"
                                                        Margin="0,0,8,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemovePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xf014;"
                                                        IsEnabled="{Binding DataContext.CanRemovePoint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource MbIconMiniButton}"
                                                        ToolTip="删除拐点" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        <Button Command="{Binding AddPointCommand}" Style="{StaticResource MbDashedRowButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="11"
                                    Text="&#xf067;" />
                                <TextBlock Margin="6,0,0,0" Text="添加拐点" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!--  ④ 保存条  -->
                <Border
                    Grid.Row="3"
                    Margin="0,14,0,0"
                    Style="{StaticResource MbCard}"
                    Padding="20,10">
                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource MbTextSecondaryBrush}"
                            Text="改完点「保存凸轮表」落库；同步运行用的是当前表（仿真）" />
                        <Button
                            HorizontalAlignment="Right"
                            Command="{Binding SaveTableCommand}"
                            Style="{StaticResource MbPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="12"
                                    Text="&#xf0c7;" />
                                <TextBlock Margin="7,0,0,0" Text="保存凸轮表" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
