<UserControl
    x:Class="VisionMaster.Views.DialogViews.IoHealthPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.UI.com/ui"
    Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <!--
                就地合并 GridView 样式：本视图用 ListView + GridView，
                缺 GridListViewStyle 时 Fluent 的隐式 ListView 样式会顶掉框架那份 → 列头整体消失（R19）。
                断言宿主（ScadaChecks 直连 new 视图）没有 Application，所以必须合并进自身 Resources，
                且用相对 pack 写法（R22）。
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Controls/GridView.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  行容器：隐式 ListViewItem 样式会让行模板塌成一列（R20），必须自带 GridViewRowPresenter。  -->
            <Style x:Key="IoHealthRowStyle" TargetType="ListViewItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border
                                x:Name="RowBorder"
                                Padding="4,0"
                                Background="Transparent"
                                BorderBrush="{StaticResource DialogBorderLightBrush}"
                                BorderThickness="0,0,0,1">
                                <GridViewRowPresenter
                                    Columns="{TemplateBinding GridView.ColumnCollection}"
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    SnapsToDevicePixels="True"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                </Trigger>
                                <!--  键盘焦点：用描边表达，不依赖被 OverridesDefaultStyle 关掉的默认焦点框（R115）。  -->
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="RowBorder" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  列头改用共享的 GridListHeaderStyle（定义在就地合并的 GridView.xaml 里）：
                  无竖分隔线、透明底、12 号次要色、底部发丝线。  -->

            <!--  状态点基样式：只放几何，不绑字段。派生样式各写自己的触发器——
                  直接 BasedOn 带触发器的那份会让派生样式继承到不存在的绑定源（点位行没有 StateLevel）。  -->
            <Style x:Key="HealthDotBase" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
            </Style>

            <Style x:Key="StateDotStyle" TargetType="Ellipse" BasedOn="{StaticResource HealthDotBase}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StateLevel}" Value="ok">
                        <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateLevel}" Value="warn">
                        <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding StateLevel}" Value="error">
                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="QualityDotStyle" TargetType="Ellipse" BasedOn="{StaticResource HealthDotBase}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding QualityLevel}" Value="ok">
                        <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding QualityLevel}" Value="warn">
                        <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding QualityLevel}" Value="error">
                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  写入审计：成功/失败两态（审计条目没有中间态，刻意不给 warn 档）  -->
            <Style x:Key="AuditDotStyle" TargetType="Ellipse" BasedOn="{StaticResource HealthDotBase}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ResultLevel}" Value="ok">
                        <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ResultLevel}" Value="error">
                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  摘要条：一行看懂"总线几条 / 几台在线 / 有几个隔离点 / 有没有故障"  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="16,12"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="{Binding Summary}" />

                <!--  空态 / 失败原因：占满剩余宽度并截断，长异常文案不再把按钮顶出摘要条（R114）。  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogHintText}"
                    Text="{Binding Hint}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTip="{Binding Hint}" />

                <Button
                    Grid.Column="2"
                    Command="{Binding RefreshCommand}"
                    Content="立即刷新"
                    Style="{StaticResource DialogChipButton}" />
            </Grid>
        </Border>

        <TabControl
            Grid.Row="1"
            Margin="0"
            SelectedIndex="{Binding SelectedTab}"
            Style="{StaticResource DialogTabControl}">
            <!--  设备  -->
            <TabItem Header="设备" Style="{StaticResource DialogTabItem}">
                <Grid>
                <ListView
                    Margin="0,12,0,0"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource IoHealthRowStyle}"
                    ItemsSource="{Binding Devices}"
                    Style="{StaticResource GridListViewStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource GridListHeaderStyle}">
                            <GridViewColumn Header="状态灯" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Style="{StaticResource StateDotStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding DeviceId}" Header="设备" Width="110" />
                            <GridViewColumn DisplayMemberBinding="{Binding DisplayName}" Header="显示名" Width="120" />
                            <GridViewColumn DisplayMemberBinding="{Binding DriverId}" Header="驱动" Width="110" />
                            <GridViewColumn DisplayMemberBinding="{Binding StateText}" Header="状态" Width="70" />
                            <GridViewColumn Header="状态说明" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding StateDetail}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding StateDetail}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding LastSuccessText}" Header="最近成功" Width="80" />
                            <GridViewColumn DisplayMemberBinding="{Binding CountersText}" Header="写 / 拒 / 故障" Width="150" />
                            <GridViewColumn Header="隔离点" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding IsolatedText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding IsolatedText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                    <!--  空态：集合为空时覆盖列表区，避免"白板等数据"（R116）。  -->
                    <StackPanel
                        Margin="0,96,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf0e8;" />
                        <TextBlock Style="{StaticResource DialogEmptyStateTitle}" Text="暂无设备数据" />
                        <TextBlock Style="{StaticResource DialogEmptyStateHint}" Text="当前方案没有配置 IO 设备，或诊断数据尚未就绪。" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  总线  -->
            <TabItem Header="总线" Style="{StaticResource DialogTabItem}">
                <Grid>
                <ListView
                    Margin="0,12,0,0"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource IoHealthRowStyle}"
                    ItemsSource="{Binding Buses}"
                    Style="{StaticResource GridListViewStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource GridListHeaderStyle}">
                            <GridViewColumn DisplayMemberBinding="{Binding BusId}" Header="总线" Width="120" />
                            <GridViewColumn DisplayMemberBinding="{Binding DisplayName}" Header="显示名" Width="160" />
                            <GridViewColumn DisplayMemberBinding="{Binding Transport}" Header="传输" Width="80" />
                            <GridViewColumn DisplayMemberBinding="{Binding DeviceText}" Header="设备" Width="110" />
                            <GridViewColumn DisplayMemberBinding="{Binding PollText}" Header="实测周期" Width="90" />
                            <GridViewColumn DisplayMemberBinding="{Binding FaultText}" Header="故障" Width="90" />
                        </GridView>
                    </ListView.View>
                </ListView>

                    <StackPanel
                        Margin="0,96,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Buses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf0e8;" />
                        <TextBlock Style="{StaticResource DialogEmptyStateTitle}" Text="暂无总线数据" />
                        <TextBlock Style="{StaticResource DialogEmptyStateHint}" Text="当前方案没有配置 IO 总线。" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  点位  -->
            <TabItem Header="点位" Style="{StaticResource DialogTabItem}">
                <Grid>
                <ListView
                    Margin="0,12,0,0"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource IoHealthRowStyle}"
                    ItemsSource="{Binding Points}"
                    Style="{StaticResource GridListViewStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource GridListHeaderStyle}">
                            <GridViewColumn Header="质量" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Style="{StaticResource QualityDotStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn DisplayMemberBinding="{Binding DeviceId}" Header="设备" Width="110" />
                            <GridViewColumn DisplayMemberBinding="{Binding PointId}" Header="点位" Width="120" />
                            <GridViewColumn DisplayMemberBinding="{Binding DisplayName}" Header="显示名" Width="140" />
                            <GridViewColumn DisplayMemberBinding="{Binding KindText}" Header="类型" Width="60" />
                            <GridViewColumn DisplayMemberBinding="{Binding QualityText}" Header="质量" Width="80" />
                            <GridViewColumn DisplayMemberBinding="{Binding ValueText}" Header="当前值" Width="110" />
                            <GridViewColumn DisplayMemberBinding="{Binding EnabledText}" Header="启用" Width="60" />
                            <GridViewColumn DisplayMemberBinding="{Binding UpdatedText}" Header="更新于" Width="90" />
                        </GridView>
                    </ListView.View>
                </ListView>

                    <StackPanel
                        Margin="0,96,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Points.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf0e8;" />
                        <TextBlock Style="{StaticResource DialogEmptyStateTitle}" Text="暂无点位数据" />
                        <TextBlock Style="{StaticResource DialogEmptyStateHint}" Text="当前方案没有配置 IO 点位，或设备尚未上报。" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  写入审计：谁在什么时候写了哪个点位、成没成功  -->
            <TabItem Header="写入审计" Style="{StaticResource DialogTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            VerticalContentAlignment="Center"
                            ToolTip="按点位 / 操作者 / 详情过滤（大小写不敏感）"
                            Text="{Binding AuditQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="只看失败"
                            IsChecked="{Binding AuditFailuresOnly}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding AuditSummary}" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        Margin="0,8,0,0"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource IoHealthRowStyle}"
                        ItemsSource="{Binding AuditRows}"
                        Style="{StaticResource GridListViewStyle}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource GridListHeaderStyle}">
                                <GridViewColumn Header="结果灯" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Style="{StaticResource AuditDotStyle}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn DisplayMemberBinding="{Binding TimeText}" Header="时间" Width="100" />
                                <GridViewColumn DisplayMemberBinding="{Binding ResultText}" Header="结果" Width="60" />
                                <GridViewColumn DisplayMemberBinding="{Binding Operator}" Header="操作者" Width="150" />
                                <GridViewColumn DisplayMemberBinding="{Binding PointText}" Header="点位" Width="170" />
                                <GridViewColumn Header="详情" Width="420">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="{Binding Details}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Details}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,96,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AuditRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf044;" />
                        <TextBlock Style="{StaticResource DialogEmptyStateTitle}" Text="暂无写入记录" />
                        <TextBlock Style="{StaticResource DialogEmptyStateHint}" Text="IO 输出的每一次手动/流程写入都会留一条审计；更早的记录见 audit_logs 目录。" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
