<UserControl
    x:Class="VisionMaster.Views.DialogViews.HardwareManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Background="{StaticResource DialogBackgroundBrush}"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        ============================================================================
        硬件管理（批次 A：统一入口 + 只读概览 + 打开现有三个设置窗口）
        ============================================================================

        为什么这一版不把相机/通讯/运动直接嵌进来：三个窗口都是 IDialogAware，
        定时器、设备事件订阅与通讯持久化都绑在 OnDialogOpened/OnDialogClosed 上。
        嵌入需要先补 IEmbeddedDialogPage 生命周期适配与整页权限门禁（批次 C），
        否则会出现"切页停点动、关子窗空引用、操作员直写配置"三类问题。
        本版先把菜单收敛成一个入口，并用 HealthMonitor 回答"哪些设备不正常"。

        资源：全部走 Dialog* 令牌与 DialogStyles，不写颜色字面量（与相机/通讯同皮肤）。
    -->

    <UserControl.Resources>
        <ResourceDictionary>

            <!--  左栏导航项：选中态用主题蓝浅底 + 蓝字；未选中走次级文字。  -->
            <Style x:Key="HardwareNavItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Bd"
                                Padding="9,8"
                                Background="Transparent"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  域卡 / 问题行的状态点：ok / warn / error / idle 四档。  -->
            <Style x:Key="HardwareLevelDot" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LevelKey}" Value="ok">
                        <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LevelKey}" Value="warn">
                        <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LevelKey}" Value="error">
                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  概览头部的总体状态点：DataContext 是外壳 VM，字段名是 OverallLevelKey。  -->
            <Style x:Key="HardwareOverallDot" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OverallLevelKey}" Value="ok">
                        <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OverallLevelKey}" Value="warn">
                        <Setter Property="Fill" Value="{StaticResource DialogWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding OverallLevelKey}" Value="error">
                        <Setter Property="Fill" Value="{StaticResource DialogDangerBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  三张域卡共用一份模板：DataContext 是 HardwareDomainCard。  -->
            <DataTemplate x:Key="HardwareDomainCardTemplate">
                <Grid MinHeight="174">
                    <Border Style="{StaticResource DialogCardShadow}" />
                    <Border Padding="14" Style="{StaticResource DialogCardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="30"
                                        Height="30"
                                        Background="{StaticResource DialogAccentSoftBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="14"
                                            Foreground="{StaticResource DialogAccentBrush}"
                                            Text="{Binding Icon}" />
                                    </Border>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding Title}" />
                                </StackPanel>

                                <StackPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource HardwareLevelDot}" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="{Binding LevelText}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="{Binding Summary}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Row="2"
                                MaxHeight="32"
                                Margin="0,5,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="{Binding Detail}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <TextBlock VerticalAlignment="Center" FontSize="10.5" Text="{Binding IssueCountText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button
                                    Height="28"
                                    Padding="10,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding OpenCommand}"
                                    Content="打开"
                                    FontSize="11"
                                    Style="{StaticResource DialogSecondaryButton}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResize" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1100" />
            <Setter Property="Height" Value="820" />
            <Setter Property="MinWidth" Value="980" />
            <Setter Property="MinHeight" Value="700" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!--  自绘标题栏  -->
        <Border
            Grid.Row="0"
            Padding="24,0"
            ui:WindowDragBehavior.IsWindowDraggable="True"
            Style="{StaticResource DialogCardHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource DialogCardTitleIcon}" Text="&#xf2db;" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DialogCardTitle}" Text="{Binding Title}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource DialogHintText}"
                        Text="相机 / 通讯 / 运动控制 · 统一入口" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="关闭"
                    Command="{Binding CloseCommand}"
                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭">
                    <TextBlock
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左栏：域导航 + 系统健康 + 当前方案  -->
            <Border
                Grid.Column="0"
                Background="{StaticResource DialogRowAlternateBrush}"
                BorderBrush="{StaticResource DialogBorderLightBrush}"
                BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="硬件管理" />
                        <TextBlock
                            Margin="0,2,0,12"
                            Style="{StaticResource DialogHintText}"
                            Text="相机 · 通讯 · 运动控制" />
                    </StackPanel>

                    <ListBox
                        Grid.Row="1"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource HardwareNavItemStyle}"
                        ItemsSource="{Binding NavItems}"
                        SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="13"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Text="{Binding Icon}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Text="{Binding Title}" />

                                    <Border
                                        Grid.Column="2"
                                        MinWidth="20"
                                        Height="18"
                                        Padding="5,0"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Visibility="{Binding HasCount, Converter={ui:BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9.5"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="{Binding CountText}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2">
                        <Border
                            Height="1"
                            Margin="0,10"
                            Background="{StaticResource DialogBorderLightBrush}" />

                        <Button
                            Margin="0,0,0,10"
                            Padding="9,8"
                            HorizontalContentAlignment="Left"
                            Command="{Binding OpenSystemHealthCommand}"
                            Style="{StaticResource DialogGhostButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="13"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="&#xf21e;" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="系统健康" />
                            </StackPanel>
                        </Button>

                        <Border
                            Padding="12"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DialogFieldLabelSmall}" Text="当前方案" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding SolutionName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="配置随方案保存" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  右栏：四页内容；页签头由左栏导航替代，模板只渲染选中内容  -->
            <TabControl
                Grid.Column="1"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                SelectedIndex="{Binding SelectedPage, Mode=TwoWay}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>

                <!--  ============ 概览  ============  -->
                <TabItem
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Header="概览">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="硬件概览" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource DialogHintText}"
                                        Text="当前方案下所有硬件的运行状态；1 秒自动刷新。" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Height="30"
                                    Padding="10,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource DialogSecondaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="12"
                                            Text="&#xf021;" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Text="刷新" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border
                                Margin="0,12,0,0"
                                Padding="12,9"
                                Background="{StaticResource DialogWarningSubtleBrush}"
                                BorderBrush="{StaticResource DialogWarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsSolutionMissing, Converter={ui:BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="未加载方案：硬件配置不可编辑。请先在「文件」菜单打开一个解决方案。"
                                    TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Grid.Column="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding CameraCard}"
                                    ContentTemplate="{StaticResource HardwareDomainCardTemplate}" />
                                <ContentControl
                                    Grid.Column="2"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding CommunicationCard}"
                                    ContentTemplate="{StaticResource HardwareDomainCardTemplate}" />
                                <ContentControl
                                    Grid.Column="4"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding MotionCard}"
                                    ContentTemplate="{StaticResource HardwareDomainCardTemplate}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Border Style="{StaticResource DialogCardShadow}" />
                                <Border Padding="0" Style="{StaticResource DialogCardBorder}">
                                    <StackPanel>
                                        <Grid Margin="14,12,14,8">
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource HardwareOverallDot}" />
                                                <TextBlock
                                                    Margin="6,0,0,0"
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                    Text="当前异常" />
                                                <Border
                                                    Height="18"
                                                    Margin="8,0,0,0"
                                                    Padding="6,0"
                                                    Background="{StaticResource DialogDangerSubtleBrush}"
                                                    CornerRadius="5"
                                                    Visibility="{Binding HasIssues, Converter={ui:BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="9.5"
                                                        Foreground="{StaticResource DialogDangerTextBrush}"
                                                        Text="{Binding IssueCount}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DialogHintText}"
                                                Text="{Binding LastRefreshText}" />
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource DialogBorderLightBrush}" />

                                        <ItemsControl Margin="14,4,14,8" ItemsSource="{Binding Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Ellipse
                                                            Grid.Column="0"
                                                            Margin="0,4,0,0"
                                                            VerticalAlignment="Top"
                                                            Style="{StaticResource HardwareLevelDot}" />

                                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                            <TextBlock
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                                Text="{Binding Title}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="10.5"
                                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                                Text="{Binding Message}"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Margin="0,2,0,0"
                                                            VerticalAlignment="Top"
                                                            FontSize="9.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="{Binding TimeText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock
                                            Margin="14,16,14,22"
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="当前没有待处理异常"
                                            Visibility="{Binding IsHealthy, Converter={ui:BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource DialogHintText}"
                                Text="状态每 1 秒刷新；相机 / 运动配置随方案保存，通讯配置另写本机缓存。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  ============ 相机  ============  -->
                <TabItem
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Header="相机">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="24,18,24,10">
                            <StackPanel>
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="相机" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="{Binding CameraCard.Summary}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="{Binding PermissionHint}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasPermissionHint, Converter={ui:BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <ContentControl
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding CameraPageView}" />
                    </Grid>
                </TabItem>

                <!--  ============ 通讯  ============  -->
                <TabItem
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Header="通讯">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="24,18,24,10">
                            <StackPanel>
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="通讯" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="{Binding CommunicationCard.Summary}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="{Binding PermissionHint}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasPermissionHint, Converter={ui:BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>

                        <ContentControl
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding CommunicationPageView}" />
                    </Grid>
                </TabItem>

                <!--  ============ 运动控制  ============  -->
                <TabItem
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Header="运动控制">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="24,18,24,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="运动控制" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="{Binding MotionCard.Summary}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="{Binding PermissionHint}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasPermissionHint, Converter={ui:BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <!--  急停放在宿主页头：子页面整体 IsEnabled=false 时它仍可点（安全动作不受门禁）  -->
                            <Button
                                Grid.Column="1"
                                Height="30"
                                Padding="12,0"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource DialogDangerBorderBrush}"
                                Command="{Binding MotionEmergencyStopCommand}"
                                Content="急停"
                                FontSize="11"
                                Foreground="{StaticResource DialogDangerTextBrush}"
                                Style="{StaticResource DialogSecondaryButton}"
                                ToolTip="立即停止所有轴" />
                        </Grid>

                        <ContentControl
                            Grid.Row="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{Binding MotionPageView}" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!--  宿主 footer：子页面自己的关闭/确定按钮在嵌入模式隐藏，关闭统一走这里  -->
        <Border
            Grid.Row="2"
            Padding="24,0"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogHintText}"
                    Text="配置随方案保存；通讯仅在通讯页有改动时写本机缓存。" />
                <Button
                    Height="32"
                    Padding="16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Content="关闭"
                    FontSize="11"
                    Style="{StaticResource DialogSecondaryButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
