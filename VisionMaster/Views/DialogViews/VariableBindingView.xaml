<UserControl
    x:Class="VisionMaster.Views.VariableBindingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisionMaster.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    MinWidth="1000"
    MinHeight="640"
    Background="{StaticResource DialogSurfaceBrush}"
    PreviewMouseWheel="OnPreviewMouseWheel"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--
        变量绑定（Web 设计基线 v1）：标题栏 64 / 上下文条 44 / 内容三栏 / 底部 56。
        纪律：本视图属于 VariableBindingCheck.CollectedDialogViews——
              禁止本地 <Style x:Key=...>；只用无 key 内联 Style / DataTemplate / ControlTemplate。
              颜色一律 Dialog* 令牌，视图零十六进制。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ui:WindowCenteringBehavior.IsEnabled" Value="True" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1180" />
            <Setter Property="Height" Value="760" />
            <Setter Property="MinWidth" Value="1000" />
            <Setter Property="MinHeight" Value="640" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <local:BindingHeroNameConverter x:Key="BindingHeroNameConverter" />
        <local:BindingHeroHintConverter x:Key="BindingHeroHintConverter" />
        <local:BindingHeroMetaConverter x:Key="BindingHeroMetaConverter" />
        <local:ConstantPreviewConverter x:Key="ConstantPreviewConverter" />
        <local:PresetPreviewConverter x:Key="PresetPreviewConverter" />
        <local:CandidateActionLabelConverter x:Key="CandidateActionLabelConverter" />
        <local:CandidateBoundVisibilityConverter x:Key="CandidateBoundVisibilityConverter" />
        <local:CandidateBindButtonVisibilityConverter x:Key="CandidateBindButtonVisibilityConverter" />
        <local:ArrayTypeVisibilityConverter x:Key="ArrayTypeVisibilityConverter" />
        <local:HiddenNoteVisibilityConverter x:Key="HiddenNoteVisibilityConverter" />
        <local:PortGlyphConverter x:Key="PortGlyphConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource DialogRowAlternateBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!--  ================= 标题栏 64 =================  -->
        <Border
            Grid.Row="0"
            ui:WindowDragBehavior.IsWindowDraggable="True"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Background="{StaticResource DialogAccentLightBrush}"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="17"
                        Foreground="{StaticResource DialogAccentTextBrush}"
                        Text="&#xf0c1;" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="15.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="变量绑定" />
                    <TextBlock
                        x:Name="TitleSubtitleText"
                        Margin="0,2,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Padding="0"
                    VerticalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                    Style="{StaticResource DialogIconButton}">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="关闭" />
                    </Button.ToolTip>
                    <TextBlock
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <!--  ================= 上下文条 44 =================  -->
        <Border
            Grid.Row="1"
            Padding="18,0"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="当前步骤" />
                    <TextBlock
                        Margin="10,0,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding TargetStepName}" />
                    <Border
                        Margin="8,0,0,0"
                        Padding="6,0"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="{StaticResource DialogRowHoverBrush}"
                        CornerRadius="4">
                        <TextBlock
                            x:Name="ContextTypeText"
                            VerticalAlignment="Center"
                            FontSize="9.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="视觉算子" />
                    </Border>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="ContextMetaText"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}" />
                    <ProgressBar
                        x:Name="BindingProgressBar"
                        Width="108"
                        Height="5"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource DialogRowHoverBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource DialogSuccessBrush}"
                        Maximum="1"
                        Value="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    ClipToBounds="True"
                                    CornerRadius="3">
                                    <Border x:Name="PART_Track">
                                        <Border
                                            x:Name="PART_Indicator"
                                            HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}"
                                            CornerRadius="3" />
                                    </Border>
                                </Border>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ================= 内容三栏 =================  -->
        <Grid Grid.Row="2" Margin="16,14,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TargetColumn" Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition x:Name="SourceColumn" Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!--  ============ ① 输入端口 ============  -->
            <Border
                Grid.Column="0"
                CornerRadius="12"
                Style="{StaticResource DialogColumnCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <Border
                        Height="44"
                        CornerRadius="12,12,0,0"
                        Style="{StaticResource DialogColumnHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource DialogStepBadge}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Text="1" />
                                    </Border>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Style="{StaticResource DialogColumnTitle}"
                                        Text="输入端口" />
                                </StackPanel>
                                <TextBlock
                                    Margin="28,2,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="选择要绑定数据的目标端口"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                MinWidth="20"
                                Height="20"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DialogChipNeutral}">
                                <TextBlock
                                    x:Name="TargetHeaderCountText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogChipTextNeutral}"
                                    Text="0" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Height="32"
                        Margin="12,10,12,0"
                        Style="{StaticResource DialogSearchChrome}"
                        Visibility="{Binding IsSingleBindMode, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DialogSearchIcon}" Text="&#xf002;" />
                            <TextBox
                                x:Name="TargetSearchBox"
                                Grid.Column="1"
                                Height="30"
                                VerticalContentAlignment="Center"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                Style="{StaticResource DialogSearchInput}"
                                Tag="搜索端口名 / 类型"
                                TextChanged="TargetSearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <ListBox
                        x:Name="TargetFilterList"
                        Grid.Row="2"
                        Margin="12,8,12,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedIndex="0"
                        SelectionChanged="TargetFilterList_SelectionChanged"
                        Visibility="{Binding IsSingleBindMode, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FontSize" Value="10.5" />
                                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="Chip"
                                                Height="24"
                                                Padding="8,0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Tag="all">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="全部" />
                                <TextBlock
                                    x:Name="TargetFilterAllCount"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="0" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="unbound">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="未绑定" />
                                <TextBlock
                                    x:Name="TargetFilterUnboundCount"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="0" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="bound">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="已绑定" />
                                <TextBlock
                                    x:Name="TargetFilterBoundCount"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="0" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="4,6,4,0">
                        <ListBox
                            x:Name="TargetList"
                            Background="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            ItemsSource="{Binding DisplayDataPort}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedInputPort}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DialogOptionItem}">
                                    <Setter Property="MinHeight" Value="52" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="28"
                                            Height="28"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Definition.IsFunctionalEnum}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Definition.IsFunctionalEnum}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource PortGlyphConverter}">
                                                        <Binding Path="Definition.DataTypeName" />
                                                        <Binding Path="Definition.IsFunctionalEnum" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                    Text="{Binding Definition.Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Border
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource DialogTag}">
                                                    <TextBlock
                                                        Style="{StaticResource DialogTagText}"
                                                        Text="{Binding Definition.DataTypeName, Converter={ui:TypeNameToFriendlyNameConverter}}" />
                                                </Border>
                                                <Border
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource DialogChipWarning}"
                                                    Visibility="{Binding Definition.IsFunctionalEnum, Converter={ui:BooleanToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource DialogChipTextWarning}" Text="枚举" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource DialogTextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBound}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource DialogSuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogSuccessTextBrush}"
                                                    Text="已绑定 · "
                                                    Visibility="{Binding IsBound, Converter={ui:BooleanToVisibilityConverter}}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogSuccessTextBrush}"
                                                    Text="{Binding LinkedAddress}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{Binding IsBound, Converter={ui:BooleanToVisibilityConverter}}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="未绑定"
                                                    Visibility="{Binding IsBound, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="13"
                                            Foreground="{StaticResource DialogSuccessBrush}"
                                            Text="&#xf00c;"
                                            Visibility="{Binding IsBound, Converter={ui:BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border
                            x:Name="TargetEmptyOverlay"
                            Panel.ZIndex="10"
                            Background="{StaticResource DialogSurfaceBrush}"
                            Visibility="Collapsed">
                            <StackPanel
                                Margin="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf002;" />
                                <TextBlock x:Name="TargetEmptyTitle" Style="{StaticResource DialogEmptyStateTitle}" Text="没有匹配的输入端口" />
                                <TextBlock x:Name="TargetEmptyHint" MaxWidth="240" Style="{StaticResource DialogEmptyStateHint}" Text="清空搜索关键词或切换筛选条件后重试。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="4"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock
                            x:Name="TargetFootText"
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="已绑定 0 / 0" />
                    </Border>
                </Grid>
            </Border>

            <!--  ============ ② 数据来源 ============  -->
            <Border
                Grid.Column="2"
                CornerRadius="12"
                Style="{StaticResource DialogColumnCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <Border
                        Height="44"
                        CornerRadius="12,12,0,0"
                        Style="{StaticResource DialogColumnHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource DialogStepBadge}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10.5"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Text="2" />
                                    </Border>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Style="{StaticResource DialogColumnTitle}"
                                        Text="数据来源" />
                                </StackPanel>
                                <TextBlock
                                    Margin="28,2,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="全局变量 / 运行时变量 / 上游算子"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                MinWidth="20"
                                Height="20"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DialogChipNeutral}">
                                <TextBlock
                                    x:Name="SourceHeaderCountText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogChipTextNeutral}"
                                    Text="0" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Height="32"
                        Margin="12,10,12,0"
                        Style="{StaticResource DialogSearchChrome}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DialogSearchIcon}" Text="&#xf002;" />
                            <TextBox
                                x:Name="SourceSearchBox"
                                Grid.Column="1"
                                Height="30"
                                VerticalContentAlignment="Center"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                Style="{StaticResource DialogSearchInput}"
                                Tag="搜索来源名 / 描述"
                                TextChanged="SourceSearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Margin="12,8,12,0"
                        Padding="2"
                        Style="{StaticResource DialogSegmentHost}">
                        <ListBox
                            x:Name="SourceTabList"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedIndex="0"
                            SelectionChanged="SourceTabList_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FontSize" Value="10.5" />
                                    <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    x:Name="TabBg"
                                                    Height="24"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent"
                                                    CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBg" Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBoxItem Tag="all">
                                <TextBlock Text="全部" />
                            </ListBoxItem>
                            <ListBoxItem Tag="variable">
                                <TextBlock Text="变量" />
                            </ListBoxItem>
                            <ListBoxItem Tag="step">
                                <TextBlock Text="上游算子" />
                            </ListBoxItem>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="3" Margin="4,6,4,0">
                        <ListBox
                            x:Name="SourceList"
                            Background="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            ItemsSource="{Binding TreeNodes}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedNode}">
                            <ListBox.GroupStyle>
                                <GroupStyle HidesIfEmpty="True">
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,8,6,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextMutedBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="上游算子" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Name}" Value="Variable">
                                                                    <Setter Property="Text" Value="变量来源" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border
                                                    Grid.Column="1"
                                                    Height="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource DialogBorderBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource DialogOptionItem}">
                                    <Setter Property="MinHeight" Value="52" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="40">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="28"
                                            Height="28"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource DialogRowHoverBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="13"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="{Binding Icon}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="10.5"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="2"
                                            MinWidth="20"
                                            Height="20"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogChipNeutral}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DialogChipTextNeutral}"
                                                Text="{Binding OutputDefinitions.Count, FallbackValue=0, TargetNullValue=0}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border
                            x:Name="SourceEmptyOverlay"
                            Panel.ZIndex="10"
                            Background="{StaticResource DialogSurfaceBrush}"
                            Visibility="Collapsed">
                            <StackPanel
                                Margin="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf1c0;" />
                                <TextBlock x:Name="SourceEmptyTitle" Style="{StaticResource DialogEmptyStateTitle}" Text="没有可用的数据来源" />
                                <TextBlock x:Name="SourceEmptyHint" MaxWidth="240" Style="{StaticResource DialogEmptyStateHint}" Text="当前步骤之前还没有可绑定的全局变量或上游算子。请先在流程中添加算子。" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="4"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid Margin="12,0">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="仅显示当前步骤之前的上游" />
                            <TextBlock
                                x:Name="SourceFootText"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="共 0 个" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  ============ ③ 绑定设置 ============  -->
            <Border
                Grid.Column="4"
                CornerRadius="12"
                Style="{StaticResource DialogColumnCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>

                    <Border
                        Height="44"
                        CornerRadius="12,12,0,0"
                        Style="{StaticResource DialogColumnHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Border Style="{StaticResource DialogStepBadge}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                        Text="3" />
                                </Border>
                                <TextBlock
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DialogColumnTitle}"
                                    Text="绑定设置" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    MinWidth="20"
                                    Height="20"
                                    Padding="7,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource DialogChipNeutral}">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedInputPort.IsBound}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConstantMode}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasFunctionalEnumPort}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DialogChipTextNeutral}">
                                                <Setter Property="Text" Value="未绑定" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedInputPort.IsBound}" Value="True">
                                                        <Setter Property="Text" Value="已绑定" />
                                                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConstantMode}" Value="True">
                                                        <Setter Property="Text" Value="常量" />
                                                        <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasFunctionalEnumPort}" Value="True">
                                                        <Setter Property="Text" Value="功能预设" />
                                                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding UnbindCommand}"
                                    CommandParameter="{Binding SelectedInputPort}"
                                    Content="清除绑定"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                    IsEnabled="{Binding SelectedInputPort.IsBound}"
                                    Style="{StaticResource DialogTextButton}">
                                    <Button.ToolTip>
                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="清除当前端口的绑定" />
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer
                        x:Name="BindingBodyScroll"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <!--  ===== 英雄区：目标端口 → 数据来源 =====  -->
                            <Border
                                Padding="10"
                                Background="{StaticResource DialogAccentSoftBrush}"
                                BorderBrush="{StaticResource DialogAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="1.12*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Padding="8,7"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedInputPort}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="目标端口" />
                                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                    <Border
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource DialogAccentLightBrush}"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="10"
                                                            Foreground="{StaticResource DialogAccentTextBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource PortGlyphConverter}">
                                                                    <Binding Path="SelectedInputPort.Definition.DataTypeName" />
                                                                    <Binding Path="SelectedInputPort.Definition.IsFunctionalEnum" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                        Text="{Binding SelectedInputPort.Definition.Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Margin="5,0,0,0"
                                                        Style="{StaticResource DialogTag}">
                                                        <TextBlock
                                                            Style="{StaticResource DialogTagText}"
                                                            Text="{Binding SelectedInputPort.Definition.DataTypeName, Converter={ui:TypeNameToFriendlyNameConverter}}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding SelectedInputPort.Definition.Description}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedInputPort}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                    Text="先选择一个输入端口" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="从左侧列表选择目标端口" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Width="26"
                                        Height="26"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogAccentBrush}"
                                            Text="&#xf061;" />
                                    </Border>

                                    <Border
                                        Grid.Column="2"
                                        Padding="8,7"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedInputPort.IsBound}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsConstantMode}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasFunctionalEnumPort}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="9.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="数据来源" />
                                                <Border
                                                    MinWidth="20"
                                                    Height="18"
                                                    Padding="6,0"
                                                    HorizontalAlignment="Right">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource DialogChipNeutral}">
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedInputPort.IsBound}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsConstantMode}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasFunctionalEnumPort}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="9.5"
                                                        FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="未绑定" />
                                                                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedInputPort.IsBound}" Value="True">
                                                                        <Setter Property="Text" Value="已绑定" />
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsConstantMode}" Value="True">
                                                                        <Setter Property="Text" Value="待写入" />
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsConstantMode}" Value="True" />
                                                                            <Condition Binding="{Binding ConstantValue}" Value="" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Text" Value="未填写" />
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                                    </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding HasFunctionalEnumPort}" Value="True">
                                                                        <Setter Property="Text" Value="已选择" />
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding HasFunctionalEnumPort}" Value="True" />
                                                                            <Condition Binding="{Binding SelectedPresetDisplay}" Value="" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Text" Value="未选择" />
                                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource BindingHeroNameConverter}">
                                                        <Binding Path="HasFunctionalEnumPort" />
                                                        <Binding Path="IsConstantMode" />
                                                        <Binding Path="ConstantValue" />
                                                        <Binding Path="SelectedPresetDisplay" />
                                                        <Binding Path="SelectedInputPort.LinkedAddress" />
                                                        <Binding Path="SelectedInputPort.IsBound" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="10.5"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource BindingHeroHintConverter}">
                                                        <Binding Path="HasFunctionalEnumPort" />
                                                        <Binding Path="IsConstantMode" />
                                                        <Binding Path="ConstantValue" />
                                                        <Binding Path="SelectedInputPort.LinkedAddress" />
                                                        <Binding Path="SelectedInputPort.IsBound" />
                                                        <Binding Path="SelectedInputPort.Definition.DataTypeName" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Margin="2,6,2,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="10"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="&#xf05a;" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource BindingHeroMetaConverter}">
                                            <Binding Path="HasFunctionalEnumPort" />
                                            <Binding Path="IsConstantMode" />
                                            <Binding Path="ConstantValue" />
                                            <Binding Path="SelectedInputPort.IsBound" />
                                            <Binding Path="SelectedNode.DefaultLinkKind" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <!--  ===== 绑定方式：上游端口 / 常量值（枚举端口整行隐藏） =====  -->
                            <Grid Margin="0,14,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFunctionalEnumPort}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Margin="0"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="绑定方式" />
                                <Border
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DialogSegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            Height="24"
                                            MinWidth="64"
                                            Padding="10,0"
                                            Content="上游端口"
                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                            GroupName="BindingMethod"
                                            IsChecked="{Binding IsUpstreamMode, Mode=TwoWay}"
                                            Style="{StaticResource DialogSegmentRadio}" />
                                        <RadioButton
                                            Height="24"
                                            MinWidth="64"
                                            Padding="10,0"
                                            Content="常量值"
                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                            GroupName="BindingMethod"
                                            IsChecked="{Binding IsConstantMode, Mode=TwoWay}"
                                            Style="{StaticResource DialogSegmentRadio}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource DialogTextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="从上游输出端口取值" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConstantMode}" Value="True">
                                                    <Setter Property="Text" Value="常量会替换当前上游连线" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!--  ===== 上游候选面板 =====  -->
                            <StackPanel Margin="0,14,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsUpstreamMode}" Value="True" />
                                                    <Condition Binding="{Binding HasFunctionalEnumPort}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogFormLabel}"
                                            Text="候选输出端口" />
                                        <Border
                                            MinWidth="20"
                                            Height="20"
                                            Margin="6,0,0,0"
                                            Padding="6,0"
                                            Style="{StaticResource DialogChipNeutral}">
                                            <TextBlock
                                                x:Name="CandidateCountText"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource DialogChipTextNeutral}"
                                                Text="0" />
                                        </Border>
                                    </StackPanel>
                                    <CheckBox
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Content="显示全部"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        IsChecked="{Binding ShowAllPorts, Mode=TwoWay}"
                                        Style="{StaticResource DialogCheckBox}">
                                        <CheckBox.ToolTip>
                                            <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="默认只列出类型能接住的候选项；勾选后把不兼容的也列出来（置灰、不可绑定）" />
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                </Grid>

                                <Border
                                    Height="30"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource DialogSearchChrome}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DialogSearchIcon}" Text="&#xf002;" />
                                        <TextBox
                                            x:Name="CandidateSearchBox"
                                            Grid.Column="1"
                                            Height="28"
                                            VerticalContentAlignment="Center"
                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                            Style="{StaticResource DialogSearchInput}"
                                            Tag="搜索端口名 / 类型"
                                            TextChanged="CandidateSearchBox_TextChanged" />
                                    </Grid>
                                </Border>

                                <Border
                                    Margin="0,8,0,0"
                                    Padding="9,7"
                                    Background="{StaticResource DialogRowAlternateBrush}"
                                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource HiddenNoteVisibilityConverter}">
                                            <Binding Path="HiddenByTypeCount" />
                                            <Binding Path="ShowAllPorts" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="10"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                Text="&#xf05a;" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="10.5"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}还有 {0} 个端口因类型不兼容被隐藏。">
                                                        <Binding Path="HiddenByTypeCount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Click="OnShowAllClick"
                                            Content="显示全部"
                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Style="{StaticResource DialogTextButton}" />
                                    </Grid>
                                </Border>

                                <!--  数组 → 标量：行内索引面板  -->
                                <Border
                                    Margin="0,8,0,0"
                                    Padding="10"
                                    Background="{StaticResource DialogWarningSubtleBrush}"
                                    BorderBrush="{StaticResource DialogWarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding HasPendingArrayBind, Converter={ui:BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="11"
                                                Foreground="{StaticResource DialogWarningTextBrush}"
                                                Text="&#xf0ca;" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogWarningTextBrush}"
                                                Text="数组 → 标量：选择元素下标" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource DialogWarningTextBrush}"
                                                Text="{Binding PendingArrayElementTypeName}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <TextBox
                                                Width="110"
                                                Height="30"
                                                VerticalContentAlignment="Center"
                                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                Style="{StaticResource DialogInput}"
                                                Text="{Binding ArrayIndexText, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Height="30"
                                                Margin="6,0,0,0"
                                                Command="{Binding ConfirmArrayBindCommand}"
                                                Content="确认绑定"
                                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                Style="{StaticResource DialogChipPrimary}" />
                                            <Button
                                                Height="30"
                                                Margin="6,0,0,0"
                                                Command="{Binding CancelArrayBindCommand}"
                                                Content="取消"
                                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                Style="{StaticResource DialogChipButton}" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="10.5"
                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}写入连线：{0} ← {1}[{2}]">
                                                    <Binding Path="SelectedInputPort.Definition.Name" />
                                                    <Binding Path="PendingArrayPort.Name" />
                                                    <Binding Path="ArrayIndexText" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,8,0,0" MinHeight="220">
                                    <!--
                                        【虚拟化的前提：高度有界】本列表嵌在右栏 BindingBodyScroll 里，
                                        若不给高度上限，外层 ScrollViewer 会以"无穷高"量它，
                                        VirtualizingStackPanel 于是逐行实例化、一行都不回收 ——
                                        全局变量两三千条时打开弹窗/改搜索词都要把几千行重造一遍（实测
                                        1501 条 ≈ 6.2 s），表现就是"变量一多就卡"。
                                        上限由 code-behind 的 UpdateCandidateMaxHeight 按"视口剩余高度"算，
                                        且只有内容超过 3 屏才真的封顶：十几行以内保持自然高度
                                        （与设计基线逐像素一致、不出现内层滚动条），长列表才在自己的
                                        高度内滚动、虚拟化只保留可见的十来个容器。
                                    -->
                                    <ListBox
                                        x:Name="CandidateList"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        ItemsSource="{Binding DisplayPorts}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectedItem="{Binding SelectedOutputPort}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource DialogOptionItem}">
                                                <Setter Property="MinHeight" Value="52" />
                                                <Setter Property="Padding" Value="8,6" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                                                <Setter Property="IsEnabled" Value="{Binding IsBindable}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Background="Transparent"
                                                    ToolTipService.ShowOnDisabled="True">
                                                    <Grid.InputBindings>
                                                        <MouseBinding
                                                            Command="{Binding DataContext.DoublockClickBindCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            MouseAction="LeftDoubleClick" />
                                                    </Grid.InputBindings>
                                                    <Grid.ToolTip>
                                                        <ToolTip Style="{StaticResource DialogToolTipStyle}" Content="{Binding IncompatibleReason}" />
                                                    </Grid.ToolTip>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Width="26"
                                                        Height="26"
                                                        Margin="0,0,9,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource DialogRowHoverBrush}"
                                                        CornerRadius="7">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="{StaticResource DialogIconFont}"
                                                            FontSize="12"
                                                            Foreground="{StaticResource DialogTextSecondaryBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource PortGlyphConverter}">
                                                                    <Binding Path="DataTypeName" />
                                                                    <Binding Path="IsFunctionalEnum" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <Border
                                                                Margin="5,0,0,0"
                                                                Style="{StaticResource DialogTag}">
                                                                <TextBlock
                                                                    Style="{StaticResource DialogTagText}"
                                                                    Text="{Binding DataTypeName, Converter={ui:TypeNameToFriendlyNameConverter}}" />
                                                            </Border>
                                                            <Border
                                                                Margin="5,0,0,0"
                                                                Style="{StaticResource DialogChipWarning}"
                                                                Visibility="{Binding DataTypeName, Converter={StaticResource ArrayTypeVisibilityConverter}}">
                                                                <TextBlock Style="{StaticResource DialogChipTextWarning}" Text="数组" />
                                                            </Border>
                                                            <Border
                                                                Margin="5,0,0,0"
                                                                Style="{StaticResource DialogChipSuccess}">
                                                                <Border.Visibility>
                                                                    <MultiBinding Converter="{StaticResource CandidateBoundVisibilityConverter}">
                                                                        <Binding Path="DataContext.SelectedInputPort.BoundVariableId" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                        <Binding Path="VariableId" />
                                                                        <Binding Path="DataContext.SelectedInputPort.LinkedAddress" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                        <Binding Path="DataContext.SelectedNode.Name" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                        <Binding Path="Name" />
                                                                    </MultiBinding>
                                                                </Border.Visibility>
                                                                <TextBlock Style="{StaticResource DialogChipTextSuccess}" Text="已绑定" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="10.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="{Binding Description}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <TextBlock
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="9.5"
                                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                                            Text="类型不匹配"
                                                            Visibility="{Binding IsBindable, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                                        <Button
                                                            Height="26"
                                                            Padding="9,0"
                                                            Command="{Binding DataContext.DoublockClickBindCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding DataTypeName, Converter={StaticResource CandidateActionLabelConverter}}"
                                                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                            Style="{StaticResource DialogChipButton}">
                                                            <Button.Visibility>
                                                                <MultiBinding Converter="{StaticResource CandidateBindButtonVisibilityConverter}">
                                                                    <Binding Path="IsBindable" />
                                                                    <Binding Path="DataContext.SelectedInputPort.BoundVariableId" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                    <Binding Path="VariableId" />
                                                                    <Binding Path="DataContext.SelectedInputPort.LinkedAddress" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                    <Binding Path="DataContext.SelectedNode.Name" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                    <Binding Path="Name" />
                                                                </MultiBinding>
                                                            </Button.Visibility>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border
                                        x:Name="CandidateEmptyOverlay"
                                        Panel.ZIndex="10"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        Visibility="Collapsed">
                                        <StackPanel
                                            Margin="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf0c1;" />
                                            <TextBlock x:Name="CandidateEmptyTitle" Style="{StaticResource DialogEmptyStateTitle}" Text="先选择一个数据来源" />
                                            <TextBlock x:Name="CandidateEmptyHint" MaxWidth="300" Style="{StaticResource DialogEmptyStateHint}" Text="从中间的「数据来源」列表中选择全局变量、运行时变量或上游算子。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="双击候选端口直接绑定；也可单击选中后点「绑定」。" />
                            </StackPanel>

                            <!--  ===== 常量值面板 =====  -->
                            <StackPanel Margin="0,14,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsConstantMode}" Value="True" />
                                                    <Condition Binding="{Binding HasFunctionalEnumPort}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogFormLabel}"
                                        Text="常量值" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource DialogTextMutedBrush}">
                                        <Run Text="目标类型 " />
                                        <Run Text="{Binding SelectedInputPort.Definition.DataTypeName, Converter={ui:TypeNameToFriendlyNameConverter}}" />
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,6,0,0">
                                    <TextBox
                                        Height="34"
                                        Padding="10,0,58,0"
                                        VerticalContentAlignment="Center"
                                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                        Style="{StaticResource DialogInput}"
                                        Tag="数值 / 字符串 / true|false"
                                        Text="{Binding ConstantValue, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogTag}">
                                        <TextBlock
                                            Style="{StaticResource DialogTagText}"
                                            Text="{Binding SelectedInputPort.Definition.DataTypeName, Converter={ui:TypeNameToFriendlyNameConverter}}" />
                                    </Border>
                                </Grid>

                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="支持数值、字符串与 true / false；留空表示保持当前上游连线不变。" />

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="9,8"
                                    Background="{StaticResource DialogWarningSubtleBrush}"
                                    BorderBrush="{StaticResource DialogWarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Top"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="12"
                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                            Text="&#xf071;" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="10.5"
                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                            Text="填写常量并点「确定」会用常量替换当前上游连线。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="0,12,0,0"
                                    Padding="10,9"
                                    Background="{StaticResource DialogAccentSoftBrush}"
                                    BorderBrush="{StaticResource DialogAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Text="写入预览" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontFamily="Consolas, Cascadia Mono, Courier New"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ConstantPreviewConverter}">
                                                    <Binding Path="SelectedInputPort.Definition.Name" />
                                                    <Binding Path="ConstantValue" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ===== 功能预设面板 =====  -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasFunctionalEnumPort, Converter={ui:BooleanToVisibilityConverter}}">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogFormLabel}"
                                            Text="功能预设" />
                                        <Border
                                            Margin="6,0,0,0"
                                            Style="{StaticResource DialogChipWarning}">
                                            <TextBlock Style="{StaticResource DialogChipTextWarning}" Text="封闭候选" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="无需连接上游输出" />
                                </Grid>

                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource DialogHintText}"
                                    Text="该端口的合法值是一个固定集合（枚举成员或当前方案里的名字），直接从下面选一项即可，无需连接上游输出。" />

                                <!--
                                    预设卡片：显示 Display、写入 Option（值与显示分离）。
                                    旧下拉的 SelectedValuePath="Option" 口径不变，只是入口从 ComboBox 换成卡片。
                                -->
                                <ItemsControl
                                    Margin="0,8,0,0"
                                    ItemsSource="{Binding PresetOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton
                                                Margin="0,0,6,6"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding Option}"
                                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                GroupName="PresetOptions"
                                                IsChecked="{Binding IsSelected, Mode=OneWay}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border
                                                            x:Name="Card"
                                                            MinHeight="46"
                                                            Padding="9,7"
                                                            Background="{StaticResource DialogSurfaceBrush}"
                                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border
                                                                    x:Name="Ring"
                                                                    Width="14"
                                                                    Height="14"
                                                                    VerticalAlignment="Center"
                                                                    Background="{StaticResource DialogSurfaceBrush}"
                                                                    BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="7" />
                                                                <ContentPresenter
                                                                    Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    VerticalAlignment="Center" />
                                                                <TextBlock
                                                                    x:Name="Check"
                                                                    Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    FontFamily="{StaticResource DialogIconFont}"
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource DialogAccentBrush}"
                                                                    Text="&#xf00c;"
                                                                    Visibility="Collapsed" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Card" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                                                <Setter TargetName="Ring" Property="BorderThickness" Value="4" />
                                                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                                <StackPanel>
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                        Text="{Binding Display}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,1,0,0"
                                                        FontFamily="Consolas, Cascadia Mono, Courier New"
                                                        FontSize="9.5"
                                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                                        Text="{Binding Option}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--
                                    候选为空（方案里还没有可选项）：**不再允许手填**（2026-10-24 起）。
                                    名字类字段的合法值只能来自方案里已有的卡/轴/变量/流程名，
                                    凭空手打的名字运行期一定解析不到，所以这里改成"说明原因 + 不被堵死"：
                                    上方预设列表保持可见（空），提示语走 VM 的 OptionEmptyReason，
                                    与 LinkableValueEditor 的 IsOptionEmpty 同一口径。
                                -->
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOptionEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border
                                        Height="34"
                                        Padding="10,0"
                                        Background="{StaticResource DialogRowAlternateBrush}"
                                        BorderBrush="{StaticResource DialogBorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="当前没有可选值"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Style="{StaticResource DialogHintText}"
                                        Text="{Binding OptionEmptyReason}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Border
                                    Margin="0,12,0,0"
                                    Padding="10,9"
                                    Background="{StaticResource DialogAccentSoftBrush}"
                                    BorderBrush="{StaticResource DialogAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Text="写入预览" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontFamily="Consolas, Cascadia Mono, Courier New"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PresetPreviewConverter}">
                                                    <Binding Path="SelectedInputPort.Definition.Name" />
                                                    <Binding Path="ConstantValue" />
                                                    <Binding Path="SelectedPresetDisplay" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="2"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock
                            Margin="14,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="单击选中候选端口 · 双击直接绑定"
                            TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  ================= 底部 56 =================  -->
        <Border
            Grid.Row="3"
            Height="56"
            Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock
                    x:Name="FooterSummaryText"
                    Margin="0,0,160,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="未选择输入端口"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="{StaticResource DialogRowAlternateBrush}"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Consolas, Cascadia Mono, Courier New"
                            FontSize="9.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="Esc" />
                    </Border>
                    <TextBlock
                        Margin="4,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="取消" />
                    <Button
                        Height="32"
                        MinWidth="64"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                        Style="{StaticResource DialogFooterSecondaryButton}" />
                    <Button
                        Height="32"
                        MinWidth="88"
                        Margin="10,0,0,0"
                        Command="{Binding ConfirmCommand}"
                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                        Style="{StaticResource DialogFooterPrimaryButton}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="确定" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSingleBindMode}" Value="True">
                                                <Setter Property="Text" Value="绑定并返回" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
