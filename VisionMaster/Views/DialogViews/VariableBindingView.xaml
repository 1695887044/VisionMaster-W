<UserControl
    x:Class="VisionMaster.Views.VariableBindingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VisionMaster.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    MinWidth="1000"
    MinHeight="640"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--
        弹窗尺寸与可缩放性。

        改这里之前是什么样：视图上写死 Width=900 Height=580，宿主窗口又设
        SizeToContent="WidthAndHeight" + ResizeMode="NoResize" —— 后果是三栏挤在 900 里，
        右侧候选列表的长描述被截成"ROI 'ROI_0' 的裁剪…"，而且**用户拉不大**（无边可拖）。
        三栏选择型弹窗天生需要横向空间，所以这里改成：给一个舒适的默认尺寸（1180×760）
        + 允许缩放（CanResize）+ 下限兜住三栏的最小可用宽度（1000×640）。
        SizeToContent 必须显式设回 Manual：留着 WidthAndHeight 的话窗口会一直贴着内容，
        用户拖动边框看不到任何变化（看起来像"不能缩放"，实际是被 SizeToContent 拽回去了）。

        ⚠ 这里只准写「依赖属性」。Style 的 Setter 只能设 DP，而 WindowStartupLocation
        是个普通 CLR 属性（没有 WindowStartupLocationProperty），写进 Setter 会在
        加载本视图 BAML 时直接抛 XamlParseException：
            "设置属性 System.Windows.Setter.Property 时引发了异常"
            内层 ArgumentNullException('property')
        而且行号指向那一行，看着像"这行写法不对"，实际是"这个属性压根不能出现在 Style 里"。
        居中位置由宿主（Prism DialogService）决定，与仓库里其它弹窗保持一致即可。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <!--  ResizeMode 用 CanResizeWithGrip（与 PluginConfigShellView 同款）：右下角出抓手，
                  用户一眼就知道这窗口能拉 —— CanResize 只能靠把鼠标移到边框碰运气  -->
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1180" />
            <Setter Property="Height" Value="760" />
            <Setter Property="MinWidth" Value="1000" />
            <Setter Property="MinHeight" Value="640" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <!--
            本视图只留"绑定本视图 VM 契约"的数据模板（InputPortTemplate 绑 Definition.*），
            行容器 / 列卡片 / 标题栏 / 勾选框 / 底部栏一律用 UI 库 Themes/DialogStyles.xaml 的
            Dialog* 公共键 —— 早先这四个样式（NoWarningItemStyle / InputPortItemStyle /
            PresetOptionButtonStyle / SelectedPresetOptionButtonStyle）是本视图自己抄的，
            抄的还是 Element UI 那套蓝灰橙配色，与弹窗族令牌的青蓝体系不是一套；
            其中后两个从来没有被引用过（死样式）。

            注意：下面这些说明里刻意不写具体色值 —— 样式收编断言会扫本文件全文，
            注释里出现颜色字面量一样会被判成"硬编码颜色"（本轮就是这么被自己抓了一次）。
        -->
        <DataTemplate x:Key="InputPortTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Orientation="Horizontal">
                    <TextBlock
                        FontFamily="{StaticResource Icon}"
                        FontSize="13"
                        Foreground="{StaticResource DialogAccentBrush}"
                        Text="&#xf090;" />
                    <TextBlock
                        Margin="5,0,0,0"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Definition.Name}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="{Binding Definition.DataTypeName, Converter={ui:TypeNameToFriendlyNameConverter}}"
                    TextTrimming="CharacterEllipsis" />

                <!--  「枚举」角标：该端口自带功能预设，不需要连上游  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Background="{StaticResource DialogAccentSoftBrush}"
                    BorderBrush="{StaticResource DialogAccentBorderBrush}"
                    Style="{StaticResource DialogChip}"
                    Visibility="{Binding Definition.IsFunctionalEnum, Converter={ui:BooleanToVisibilityConverter}}">
                    <TextBlock
                        Foreground="{StaticResource DialogWarningTextBrush}"
                        Style="{StaticResource DialogChipText}"
                        Text="枚举" />
                </Border>

                <!--  「变量」角标：该端口是一个全局变量身份（VariableId），绑定走变量而不是连线  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Background="{StaticResource DialogAccentLightBrush}"
                    BorderBrush="{StaticResource DialogAccentBorderBrush}"
                    Style="{StaticResource DialogChip}"
                    Visibility="{Binding Definition.IsFunctionalEnum, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock
                        Foreground="{StaticResource DialogAccentTextBrush}"
                        Style="{StaticResource DialogChipText}"
                        Text="变量" />
                </Border>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="18,3,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding IsBound, Converter={ui:BooleanToVisibilityConverter}}">
                    <TextBlock
                        FontSize="10.5"
                        Foreground="{StaticResource DialogSuccessBrush}"
                        Text="已绑定:" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogSuccessBrush}"
                        Text="{Binding LinkedAddress}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Border Background="{StaticResource DialogSurfaceBrush}" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="0.12"
                    ShadowDepth="3"
                    Color="{StaticResource DialogShadowColor}" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题栏：整条可拖动（无边框窗口只能靠它移动）  -->
                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Background="{StaticResource DialogRowAlternateBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0">
                    <StackPanel
                        Margin="20,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            FontFamily="{StaticResource Icon}"
                            FontSize="15"
                            Foreground="{StaticResource DialogAccentBrush}"
                            Text="&#xf08b;" />
                        <TextBlock
                            Margin="9,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="变量绑定" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="选中左侧输入端口 → 选中上游算子 → 双击右侧候选端口完成绑定" />
                    </StackPanel>
                </Border>

                <!--
                    三栏等比例自适应（原来是 280 / 280 / *，拉大窗口只有第三栏变宽）。
                    MinWidth 是"三栏都得能用"的下限：低于它宁可让窗口卡住不缩，
                    也不要出现挤成一条缝的列表（这正是改前最难看的样子）。
                -->
                <Grid Grid.Row="1" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="240" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" MinWidth="240" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1.3*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!--  ① 当前算子输入  -->
                    <Border Grid.Column="0" Style="{StaticResource DialogColumnCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource DialogColumnHeader}">
                                <TextBlock Style="{StaticResource DialogColumnTitle}" Text="① 当前算子输入" />
                            </Border>
                            <ListBox
                                Grid.Row="1"
                                Margin="2"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource DialogOptionItem}"
                                ItemTemplate="{StaticResource InputPortTemplate}"
                                ItemsSource="{Binding DisplayDataPort}"
                                SelectedItem="{Binding SelectedInputPort}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Column="1"
                        Width="10"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        ResizeBehavior="PreviousAndNext" />

                    <!--  ② 选择上游算子  -->
                    <Border Grid.Column="2" Style="{StaticResource DialogColumnCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource DialogColumnHeader}">
                                <TextBlock Style="{StaticResource DialogColumnTitle}" Text="② 选择上游算子" />
                            </Border>
                            <ListBox
                                Grid.Row="1"
                                Margin="2"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource DialogOptionItem}"
                                ItemsSource="{Binding TreeNodes}"
                                SelectedItem="{Binding SelectedNode}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Icon}"
                                                FontSize="15"
                                                Foreground="{StaticResource DialogAccentBrush}"
                                                Text="{Binding Icon}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                    Text="{Binding ModuleGroup}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding Description}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Column="3"
                        Width="10"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        ResizeBehavior="PreviousAndNext" />

                    <!--  ③ 绑定选项（当前操作区，用强调色标题栏）  -->
                    <Border Grid.Column="4" Style="{StaticResource DialogColumnCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource DialogColumnHeaderAccent}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        Style="{StaticResource DialogColumnTitleIcon}"
                                        Text="&#xf0c1;" />
                                    <TextBlock
                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                        Style="{StaticResource DialogColumnTitle}"
                                        Text="③ 绑定选项" />
                                </StackPanel>
                            </Border>

                            <!--  非枚举端口：常量值 / 上游端口绑定 二选一  -->
                            <Grid Grid.Row="1" Visibility="{Binding HasFunctionalEnumPort, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="14,14,14,0">
                                    <TextBlock Style="{StaticResource DialogFormLabel}" Text="常量值输入" />
                                    <TextBox
                                        Height="34"
                                        Style="{StaticResource DialogInput}"
                                        Tag="数值 / 字符串 / true|false"
                                        Text="{Binding ConstantValue}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        TextWrapping="Wrap"
                                        Text="若留空，请在下方双击一个上游输出端口来建立连线。" />
                                </StackPanel>

                                <!--
                                    "显示全部"必须有自己的位置。
                                    早先它被塞进标题那一行的横向 StackPanel，这一栏只有 400 出头宽，
                                    结果文案被截成"显示全部（不看"——看不出这是个开关，也点不到。
                                    改成两列栅格：标题占 *、开关靠右 Auto，两边都不再抢宽度。
                                -->
                                <Grid Grid.Row="1" Margin="14,16,14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogFormLabel}"
                                        Text="或 绑定上游输出端口" />
                                    <CheckBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="显示全部"
                                        IsChecked="{Binding ShowAllPorts, Mode=TwoWay}"
                                        Style="{StaticResource DialogCheckBox}"
                                        ToolTip="默认只列出类型能接住当前输入端口的候选项。勾选后把不兼容的也列出来（置灰、双击不生效，悬停看原因）"
                                        ToolTipService.ShowDuration="20000" />
                                </Grid>

                                <Border
                                    Grid.Row="2"
                                    Margin="14,0,14,14"
                                    Background="{StaticResource DialogInputBackgroundBrush}"
                                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ListBox
                                        Margin="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemContainerStyle="{StaticResource DialogOptionItem}"
                                        ItemsSource="{Binding DisplayPorts}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!--
                                                    类型不兼容的项：置灰 + 双击不生效 + 悬停看原因。
                                                    IsEnabled=false 会连带禁掉 InputBindings（双击自然失效），
                                                    但也会让 ToolTip 不显示 —— 所以必须再开 ShowOnDisabled。

                                                    名称与描述改成上下两行：原来是同行横排，
                                                    名称长的项把描述挤到只剩几个字（"ROI 'ROI_0' 的裁剪…"），
                                                    而描述恰恰是"这个端口是什么"的唯一线索。
                                                -->
                                                <Grid
                                                    Background="Transparent"
                                                    IsEnabled="{Binding IsBindable}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTipService.ToolTip="{Binding IncompatibleReason}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBindable}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.45" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.InputBindings>
                                                        <MouseBinding
                                                            Command="{Binding DataContext.DoublockClickBindCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                            CommandParameter="{Binding}"
                                                            MouseAction="LeftDoubleClick" />
                                                    </Grid.InputBindings>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.RowSpan="2"
                                                        Grid.Column="0"
                                                        Margin="0,0,9,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource Icon}"
                                                        FontSize="13"
                                                        Foreground="{StaticResource DialogSuccessBrush}"
                                                        Text="&#xf08b;" />
                                                    <TextBlock
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        FontWeight="SemiBold"
                                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Grid.Column="1"
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <!--  枚举端口：功能预设选项（不需要连上游）  -->
                            <Grid Grid.Row="1" Visibility="{Binding HasFunctionalEnumPort, Converter={ui:BooleanToVisibilityConverter}}">
                                <StackPanel Margin="14,14,14,0">
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            Foreground="{StaticResource DialogWarningBrush}"
                                            Style="{StaticResource DialogColumnTitleIcon}"
                                            Text="&#xf0ca;" />
                                        <TextBlock
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                            Text="功能预设选项" />
                                    </StackPanel>

                                    <TextBlock
                                        Margin="0,0,0,12"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        TextWrapping="Wrap"
                                        Text="该端口自带系统内置预设，直接从下面选一项即可，无需连接上游输出。" />

                                    <ComboBox
                                        ItemsSource="{Binding PresetOptions}"
                                        SelectedValue="{Binding ConstantValue, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Option"
                                        Style="{StaticResource DialogCombo}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Option}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding CancelCommand}"
                            Content="取消"
                            Style="{StaticResource DialogFooterSecondaryButton}" />
                        <Button
                            Margin="10,0,0,0"
                            Command="{Binding ConfirmCommand}"
                            Content="确定"
                            Style="{StaticResource DialogFooterPrimaryButton}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
