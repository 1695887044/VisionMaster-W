<UserControl
    x:Class="VisionMaster.Views.DialogViews.SolutionListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="900"
    Height="560"
    Background="#1E1E22">

    <UserControl.Resources>
        <!--  右侧操作按钮（蓝紫圆角，对照方案列表原型）  -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#6B6BEF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7F7FF5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5757D6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A3A44" />
                                <Setter Property="Foreground" Value="#777" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  确认按钮（红色）  -->
        <Style
            x:Key="ConfirmButton"
            BasedOn="{StaticResource ActionButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#E23B3B" />
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F05252" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C42F2F" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  方案清单 + 操作按钮区  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="SolutionItems"
                Grid.Column="0"
                Background="#252529"
                BorderBrush="#3A3A44"
                BorderThickness="1"
                ItemsSource="{Binding Solutions}"
                SelectedItem="{Binding SelectedSolution}"
                SelectionMode="Single">

                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="#32323A" />
                                <Setter Property="Foreground" Value="#DDD" />
                                <Setter Property="BorderBrush" Value="#3A3A44" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>
                        <GridViewColumn DisplayMemberBinding="{Binding Index}" Header="序号" Width="50" />
                        <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="名称" Width="150" />
                        <GridViewColumn Header="注释" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#CCC"
                                        Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn DisplayMemberBinding="{Binding Path}" Header="路径" Width="330" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Button
                    Command="{Binding OpenCommand}"
                    Content="打开"
                    Style="{StaticResource ActionButton}" />
                <Button
                    Command="{Binding SetStartupCommand}"
                    Content="设置默认启动"
                    Style="{StaticResource ActionButton}" />
                <Button
                    Command="{Binding AddCurrentCommand}"
                    Content="添加当前方案"
                    Style="{StaticResource ActionButton}" />
                <Button
                    Command="{Binding AddCommand}"
                    Content="添加"
                    Style="{StaticResource ActionButton}" />
                <Button
                    Command="{Binding DeleteCommand}"
                    Content="删除"
                    Style="{StaticResource ActionButton}" />
                <Button
                    Command="{Binding MoveUpCommand}"
                    Content="上移"
                    Style="{StaticResource ActionButton}" />
                <Button
                    Command="{Binding MoveDownCommand}"
                    Content="下移"
                    Style="{StaticResource ActionButton}" />
            </StackPanel>
        </Grid>

        <!--  底部：自动加载路径 + 取消/确认  -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Foreground="#BBB" Text="自动加载路径: " />
                <TextBlock Foreground="#DDD" Text="{Binding StartupSolutionPath}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button
                Grid.Column="1"
                Width="110"
                Margin="0,0,12,0"
                Command="{Binding CancelCommand}"
                Content="取 消"
                Style="{StaticResource ActionButton}" />
            <Button
                Grid.Column="2"
                Width="110"
                Command="{Binding ConfirmCommand}"
                Content="确 认"
                Style="{StaticResource ConfirmButton}" />
        </Grid>
    </Grid>
</UserControl>
