<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaGroupEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="820"
    Height="620"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width" Value="820" />
            <Setter Property="Height" Value="620" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="GroupRowStyle" TargetType="ListBoxItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="RowBorder"
                                Padding="8,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,6,0,4" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="HintStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{DynamicResource DialogSurfaceBrush}"
        CornerRadius="12">
        <Border
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogCardBorderBrush}"
            BorderThickness="0"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <!--  ================= 标题 =================  -->
                <Grid
                    Grid.Row="0"
                    Margin="20,0"
                    ui:WindowDragBehavior.IsWindowDraggable="True">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="用户组编辑" />
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding CloseCommand}"
                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                        Style="{StaticResource DialogQuietButton}">
                        <Viewbox Width="12" Height="12">
                            <Path
                                Data="M2,2 L10,10 M10,2 L2,10"
                                Stroke="{StaticResource DialogTextTertiaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.4" />
                        </Viewbox>
                        <Button.ToolTip>
                            <ToolTip Content="关闭" Style="{StaticResource DialogToolTipStyle}" />
                        </Button.ToolTip>
                    </Button>
                </Grid>

                <!--  ================= 主体 =================  -->
                <Grid Grid.Row="1" Margin="20,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  左：模板（只读）/ 自定义  -->
                    <Border
                        Grid.Column="0"
                        Padding="0,0,12,0"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="模板（只读）" />
                                <ListBox
                                    x:Name="TemplateGroupList"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource GroupRowStyle}"
                                    ItemsSource="{Binding TemplateGroups}"
                                    SelectedItem="{Binding SelectedGroup, Mode=OneWay}"
                                    SelectionChanged="GroupList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding PermissionCountText}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource DialogIconFont}"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="&#xf023;" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="自定义" />
                                <ListBox
                                    x:Name="CustomGroupList"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource GroupRowStyle}"
                                    ItemsSource="{Binding CustomGroups}"
                                    SelectedItem="{Binding SelectedGroup, Mode=OneWay}"
                                    SelectionChanged="GroupList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding PermissionCountText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button
                                    Height="30"
                                    Margin="0,10,0,0"
                                    Padding="12,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding NewCommand}"
                                    Content="＋ 新建组"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                    Style="{StaticResource DialogSecondaryButton}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!--  右：组名 + 权限 + 警告  -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="组名" />
                            <TextBox
                                Height="36"
                                Margin="0,6,0,0"
                                VerticalContentAlignment="Center"
                                IsEnabled="{Binding CanEditName}"
                                Style="{StaticResource DialogInput}"
                                Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource HintStyle}"
                            Text="组名可改；改名不影响已登录用户，下次登录生效。" />

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding PermissionCountText}" />
                                <Button
                                    Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding CatalogCommand}"
                                    Content="管理权限目录…"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                    Style="{StaticResource DialogLinkButton}" />
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Permissions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Height="30"
                                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                IsEnabled="{Binding CanEdit}"
                                                Style="{StaticResource DialogCheckBox}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                                        FontSize="10"
                                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                                        Text="{Binding Key}" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!--  Stop 警告：始终在列（基线要求固定一行），勾掉 Stop 时加红框强调  -->
                        <Border
                            Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="9,10"
                            Background="{StaticResource DialogWarningSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsStopWarning}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Top"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="&#xf071;" />
                                <TextBlock
                                    MaxWidth="470"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogWarningTextBrush}"
                                    Text="{Binding StopWarningText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Grid.Row="4"
                            Margin="0,8,0,0"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="内置模板不可改名 / 改权限 / 删除"
                            Visibility="{Binding IsBuiltIn, Converter={ui:BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>

                <!--  ================= 底栏 =================  -->
                <Border
                    Grid.Row="2"
                    Padding="20,0"
                    Background="{StaticResource DialogRowAlternateBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Button
                                Command="{Binding DeleteCommand}"
                                Content="删除组"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                IsEnabled="{Binding CanDeleteGroup}"
                                Style="{StaticResource DialogDangerOutlineButton}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="{Binding DeleteReason}" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Height="34"
                                Margin="0,0,10,0"
                                Padding="14,0"
                                Command="{Binding CloseCommand}"
                                Content="取消"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                Style="{StaticResource DialogSecondaryButton}" />
                            <Button
                                Height="34"
                                Padding="18,0"
                                Command="{Binding SaveCommand}"
                                Content="保存组"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                Style="{StaticResource DialogPrimaryButton}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
