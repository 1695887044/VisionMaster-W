<UserControl
    x:Class="VisionMaster.Views.DialogViews.DeviceVariableImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:services="clr-namespace:VisionMaster.Services"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.UI.com/ui"
    Background="{StaticResource DialogSurfaceBrush}"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True">

    <!--
        ============================================================================
        单设备变量表导入（xlsx）：选择文件 → 差异预览 → 事务应用 → 结果
        ============================================================================
        预览表按文件顺序列出 新增/更新/无变化/错误；错误行在「说明」列给出原因。
        默认全有或全无（有错误行时应用置灰）；勾选「跳过错误行」才允许只应用合法行。
        「删除文件中没有的变量」默认关闭，勾选后列出将删的变量名。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1060" />
            <Setter Property="Height" Value="800" />
            <Setter Property="MinWidth" Value="960" />
            <Setter Property="MinHeight" Value="700" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Height="66"
            Padding="18,0"
            Background="Transparent"
            Style="{StaticResource DialogCardHeader}"
            ui:WindowDragBehavior.IsWindowDraggable="True">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{StaticResource DialogAccentLightBrush}"
                        CornerRadius="9">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="15"
                            Foreground="{StaticResource DialogAccentTextBrush}"
                            Text="&#xf093;" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="{Binding Title}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding TargetText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Button
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭">
                    <TextBlock
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="13"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <!--  ================================================================  -->
        <!--  预览步骤                                                        -->
        <!--  ================================================================  -->
        <Grid
            Grid.Row="1"
            Margin="18,14,18,0"
            Visibility="{Binding IsPreviewStep, Converter={ui:BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  文件与目标  -->
            <Border
                Grid.Row="0"
                Padding="12,10"
                Style="{StaticResource DialogInfoPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="30"
                        Height="30"
                        Background="{StaticResource DialogAccentLightBrush}"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="14"
                            Foreground="{StaticResource DialogAccentTextBrush}"
                            Text="&#xf1c3;" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="9,0,8,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="{Binding FileName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding FilePath}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="{Binding FileSummary}" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Height="30"
                        Padding="10,0"
                        Command="{Binding ReselectFileCommand}"
                        Content="重新选择"
                        Style="{StaticResource DialogSecondaryButton}" />
                    <Button
                        Grid.Column="3"
                        Height="30"
                        Margin="8,0,0,0"
                        Padding="10,0"
                        Command="{Binding DownloadTemplateCommand}"
                        Content="下载模板"
                        Style="{StaticResource DialogGhostButton}" />
                </Grid>
            </Border>

            <!--  步骤  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,10,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="11.5"
                    Foreground="{StaticResource DialogSuccessBrush}"
                    Text="① 选择文件" />
                <TextBlock
                    Margin="8,0"
                    FontSize="11.5"
                    Foreground="{StaticResource DialogBorderBrush}"
                    Text="──" />
                <TextBlock
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogAccentTextBrush}"
                    Text="② 预览与确认" />
                <TextBlock
                    Margin="8,0"
                    FontSize="11.5"
                    Foreground="{StaticResource DialogBorderBrush}"
                    Text="──" />
                <TextBlock
                    FontSize="11.5"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="③ 完成" />
            </StackPanel>

            <!--  计数  -->
            <StackPanel
                Grid.Row="2"
                Margin="0,10,0,0"
                Orientation="Horizontal">
                <Border
                    Margin="0,0,8,0"
                    Padding="8,3"
                    Background="Transparent"
                    BorderBrush="{StaticResource DialogSuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource DialogSuccessBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource DialogSuccessBrush}">
                            <Run Text="新增 " /><Run FontWeight="SemiBold" Text="{Binding NewCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,0,8,0"
                    Padding="8,3"
                    Background="Transparent"
                    BorderBrush="{StaticResource DialogAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource DialogAccentBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource DialogAccentTextBrush}">
                            <Run Text="更新 " /><Run FontWeight="SemiBold" Text="{Binding UpdateCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,0,8,0"
                    Padding="8,3"
                    Background="Transparent"
                    BorderBrush="{StaticResource DialogBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource DialogTextMutedBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource DialogTextSecondaryBrush}">
                            <Run Text="无变化 " /><Run FontWeight="SemiBold" Text="{Binding UnchangedCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border
                    Padding="8,3"
                    Background="Transparent"
                    BorderBrush="{StaticResource DialogDangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="7"
                            Height="7"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource DialogDangerBrush}" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource DialogDangerBrush}">
                            <Run Text="错误 " /><Run FontWeight="SemiBold" Text="{Binding ErrorCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  文件级错误  -->
            <Border
                Grid.Row="3"
                Margin="0,8,0,0"
                Padding="10,8"
                Background="Transparent"
                BorderBrush="{StaticResource DialogDangerBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasGlobalError, Converter={ui:BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Top"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="12"
                        Foreground="{StaticResource DialogDangerBrush}"
                        Text="&#xf071;" />
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogDangerBrush}"
                        Text="{Binding GlobalError}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  差异表  -->
            <DataGrid
                x:Name="ImportPreviewGrid"
                Grid.Row="4"
                MinHeight="180"
                Margin="0,10,0,0"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Items}"
                MinRowHeight="42"
                RowHeight="{x:Static sys:Double.NaN}"
                Style="{StaticResource DialogDataGrid}"
                VerticalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource DialogDataGridRow}" TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="48"
                        Binding="{Binding RowNumber}"
                        ElementStyle="{StaticResource DialogGridNumber}"
                        Header="行" />

                    <DataGridTemplateColumn Width="150" Header="变量名">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="105"
                        Binding="{Binding TypeText}"
                        Header="类型" />

                    <DataGridTemplateColumn Width="185" Header="地址">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="11.5"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding AddressText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding AddressText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="95"
                        Binding="{Binding ScanGroupText}"
                        Header="扫描组" />

                    <DataGridTextColumn
                        Width="105"
                        Binding="{Binding DisplayGroupText}"
                        Header="显示分组" />

                    <DataGridTemplateColumn Width="86" Header="状态">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="Chip"
                                    Padding="7,2"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource DialogTextMutedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <TextBlock
                                        x:Name="ChipText"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding StatusText}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:DeviceVariableImportStatus.New}">
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogSuccessBrush}" />
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource DialogSuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:DeviceVariableImportStatus.Update}">
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:DeviceVariableImportStatus.Error}">
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource DialogDangerBrush}" />
                                        <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="*" Header="说明">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    FontSize="11.5"
                                    Text="{Binding Note}"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static services:DeviceVariableImportStatus.Error}">
                                                    <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!--  选项  -->
            <Border
                Grid.Row="5"
                Margin="0,10,0,0"
                Padding="12,10"
                Style="{StaticResource DialogInfoPanel}">
                <StackPanel>
                    <CheckBox
                        Content="跳过错误行（其余行照常应用）"
                        IsChecked="{Binding SkipErrors, Mode=TwoWay}"
                        IsEnabled="{Binding CanSkipErrors}"
                        Style="{StaticResource DialogCheckBox}" />
                    <CheckBox
                        Margin="0,8,0,0"
                        IsChecked="{Binding DeleteMissing, Mode=TwoWay}"
                        Style="{StaticResource DialogCheckBox}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="删除文件中没有的变量" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource DialogDangerBrush}">
                                <Run Text="(" /><Run Text="{Binding MissingCount, Mode=OneWay}" /><Run Text=" 个)" />
                            </TextBlock>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="自动创建未知显示分组"
                        IsChecked="{Binding AutoCreateDisplayGroups, Mode=TwoWay}"
                        Style="{StaticResource DialogCheckBox}" />
                </StackPanel>
            </Border>

            <!--  选项后果提示  -->
            <StackPanel Grid.Row="6" Margin="0,8,0,0">
                <TextBlock
                    FontSize="11"
                    Foreground="{StaticResource DialogDangerBrush}"
                    Text="{Binding DeleteWarning}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasDeleteWarning, Converter={ui:BooleanToVisibilityConverter}}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="{Binding UnknownScanGroupNote}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasUnknownScanGroupNote, Converter={ui:BooleanToVisibilityConverter}}" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="{Binding DisplayGroupNote}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasDisplayGroupNote, Converter={ui:BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <!--  ================================================================  -->
        <!--  结果步骤                                                        -->
        <!--  ================================================================  -->
        <Grid
            Grid.Row="1"
            Margin="18"
            Visibility="{Binding IsResultStep, Converter={ui:BooleanToVisibilityConverter}}">
            <Border
                Width="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Margin="30,32">
                    <Border
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{StaticResource DialogAccentLightBrush}"
                        CornerRadius="28">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="22"
                            Foreground="{StaticResource DialogSuccessBrush}"
                            Text="&#xf00c;" />
                    </Border>
                    <TextBlock
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="导入完成" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="{Binding ResultSummary}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="关闭后变量管理会自动刷新；新增变量已接入轮询。"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Width="120"
                        Height="34"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding DoneCommand}"
                        Content="完 成"
                        Style="{StaticResource DialogPrimaryButton}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  底栏（仅预览步骤）  -->
        <Border
            Grid.Row="2"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{Binding IsPreviewStep, Converter={ui:BooleanToVisibilityConverter}}">
            <Grid Margin="18,10,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    MaxWidth="640"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding ApplyHint}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasErrors}" Value="True" />
                                        <Condition Binding="{Binding SkipErrors}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="96"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        Style="{StaticResource DialogSecondaryButton}" />
                    <Button
                        Width="132"
                        Margin="10,0,0,0"
                        Command="{Binding ApplyCommand}"
                        Content="{Binding ApplyLabel}"
                        Style="{StaticResource DialogPrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
