<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaLoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="440"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  组态「用户登录」弹窗  -->
    <!--  只做两件事：把身份装进会话（登录）、把密码换掉（改密）。  -->
    <!--  「用户管理」（增删账号、改角色）是另一个弹窗 —— 它是管理员专属，  -->
    <!--  而且"未登录也能看到全部账号名"本身就不该出现在登录框里。  -->
    <!--  ==========================================  -->

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--  回车 = 提交当前页签（登录页回车即登录、改密页回车即改密）。
          挂在整窗上：子控件里的回车都会冒泡到这里，不必给每个输入框各挂一遍。
          主键盘回车与小键盘回车是两个不同的 Key，两个都要写。  -->
    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding SubmitCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="15">
        <Border Style="{StaticResource DialogCardShadow}" />
        <Border
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <!--  标题栏（无系统边框的弹窗靠它拖动；关闭键与相机/通讯弹窗同位置）  -->
                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Background="{StaticResource DialogRowAlternateBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                    <Grid>
                        <TextBlock
                            Margin="20,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="{Binding Title}" />
                        <Button
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="关闭"
                            Command="{Binding CloseCommand}"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            Style="{StaticResource DialogIconButton}"
                            ToolTip="关闭">
                            <TextBlock
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="13"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="&#xf00d;" />
                        </Button>
                    </Grid>
                </Border>

                <!--  内容区  -->
                <StackPanel Grid.Row="1" Margin="20,14,20,0">

                    <!--  未登录：一行身份 + 当前角色能做什么（不是"没权限"，是"这档就这么多"）  -->
                    <Border
                        Padding="12,8"
                        Background="{StaticResource DialogRowAlternateBrush}"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsLoggedOut, Converter={ui:BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{StaticResource DialogTextSecondaryBrush}">
                                <Run Text="当前身份：" />
                                <Run
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding LoginStateText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="{Binding RolePermissionText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  已登录：账号卡。身份、能做什么、空闲多久退出，一眼看完。  -->
                    <Border
                        Padding="12,10"
                        Background="{StaticResource DialogAccentSoftBrush}"
                        BorderBrush="{StaticResource DialogAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsLoggedIn, Converter={ui:BooleanToVisibilityConverter}}">
                        <Grid>
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DialogTextPrimaryBrush}">
                                    <Run Text="当前身份：" />
                                    <Run Text="{Binding LoginStateText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="10.5"
                                    Foreground="{StaticResource DialogAccentTextBrush}"
                                    Text="{Binding RolePermissionText}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="10"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="{Binding IdleTimeoutText}" />
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Height="26"
                                    Margin="0,0,6,0"
                                    Padding="9,0"
                                    Command="{Binding OpenChangePasswordCommand}"
                                    Content="修改密码"
                                    FontSize="10.5"
                                    Style="{StaticResource DialogSecondaryButton}" />
                                <Button
                                    Height="26"
                                    Padding="9,0"
                                    Command="{Binding LogoutCommand}"
                                    Content="退出登录"
                                    FontSize="10.5"
                                    Style="{StaticResource DialogSecondaryButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  出厂密码提示：只在真用得上时出现；「立即修改」直接送到改密页。  -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="10,7"
                        Background="{StaticResource DialogWarningSubtleBrush}"
                        BorderBrush="{StaticResource DialogWarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding ShowDefaultPasswordHint, Converter={ui:BooleanToVisibilityConverter}}">
                        <Grid>
                            <TextBlock
                                Margin="0,0,58,0"
                                FontSize="11"
                                Foreground="{StaticResource DialogWarningTextBrush}"
                                Text="出厂管理员 admin 仍在使用默认密码，登录后请立即改掉。"
                                TextWrapping="Wrap" />
                            <Button
                                Height="24"
                                Padding="8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Command="{Binding OpenChangePasswordCommand}"
                                Content="立即修改"
                                FontSize="10"
                                Style="{StaticResource DialogSecondaryButton}" />
                        </Grid>
                    </Border>

                    <TabControl Margin="0,12,0,0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                        <!--  ============ 登录页 ============  -->
                        <TabItem Header="登录">
                            <!--  固定高度 + 按钮钉在底部：两个页签的内容高度不同，
                                  不钉住的话切页签时整个弹窗会跟着长高变矮（SizeToContent），
                                  而且"主操作按钮"会在屏幕上跳位置。  -->
                            <Grid MinHeight="240">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="用户名" />
                                    <TextBox
                                        x:Name="UserNameBox"
                                        Margin="0,4,0,0"
                                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="密码" />
                                    <!--  密码框的观感（圆角 / 聚焦下划线 / 眼睛图标切明文）全部来自
                                          DefaultStyle 里的 PasswordBox 默认样式，这里只负责把值绑给 VM。  -->
                                    <PasswordBox
                                        x:Name="PasswordInput"
                                        Margin="0,4,0,0"
                                        ui:PasswordBoxHelper.BindablePassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--  失败原因。固定 18px 占位：出错时不再把下面的按钮顶下去  -->
                                    <TextBlock
                                        MinHeight="18"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogDangerTextBrush}"
                                        Text="{Binding LoginMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Button
                                    Grid.Row="1"
                                    Height="38"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding LoginCommand}"
                                    Content="登 录"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource DialogPrimaryButton}" />
                            </Grid>
                        </TabItem>

                        <!--  ============ 修改密码页 ============  -->
                        <TabItem Header="修改密码">
                            <Grid MinHeight="240">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="用户名" />
                                    <TextBox
                                        Margin="0,4,0,0"
                                        Text="{Binding ChangeUserName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="当前密码" />
                                    <PasswordBox
                                        Margin="0,4,0,0"
                                        ui:PasswordBoxHelper.BindablePassword="{Binding OldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--  新密码与确认并排：它们是同一次输入的两半，摆在一行比上下两行更省地方，
                                          也让人一眼看出"这两格要一样"。  -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="新密码" />
                                            <PasswordBox
                                                Margin="0,4,0,0"
                                                ui:PasswordBoxHelper.BindablePassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="确认新密码" />
                                            <PasswordBox
                                                Margin="0,4,0,0"
                                                ui:PasswordBoxHelper.BindablePassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  结果提示：成功绿、失败红，同一块地方，固定 18px 占位  -->
                                    <TextBlock
                                        MinHeight="18"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Text="{Binding ChangeMessage}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChangeSucceeded}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Button
                                    Grid.Row="1"
                                    Height="38"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ChangePasswordCommand}"
                                    Content="修改密码"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource DialogPrimaryButton}" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </StackPanel>

                <!--  底栏：主操作（登录 / 修改密码）在页签里，这里只放两个"出去"的口子，
                      所以两个都用次级样式，不跟页签里的蓝色按钮抢注意力。  -->
                <Grid Grid.Row="2" Margin="20,8">
                    <Button
                        Padding="14,6"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenUserManagerCommand}"
                        Content="用户管理"
                        FontSize="12"
                        Style="{StaticResource DialogSecondaryButton}"
                        Visibility="{Binding CanManageUsers, Converter={ui:BooleanToVisibilityConverter}}" />
                    <Button
                        Padding="14,6"
                        HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}"
                        Content="关闭"
                        FontSize="12"
                        Style="{StaticResource DialogSecondaryButton}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
