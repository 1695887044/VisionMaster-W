<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaLoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="440"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  组态「用户登录」弹窗  -->
    <!--  只做两件事：把身份装进会话（登录）、把密码换掉（改密）。  -->
    <!--  「用户管理」（增删账号、改角色）是另一个弹窗 —— 它是管理员专属，  -->
    <!--  而且"未登录也能看到全部账号名"本身就不该出现在登录框里。  -->
    <!--  ==========================================  -->

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--  回车 = 提交当前页签（登录页回车即登录、改密页回车即改密）。
          挂在整窗上：子控件里的回车都会冒泡到这里，不必给每个输入框各挂一遍。
          主键盘回车与小键盘回车是两个不同的 Key，两个都要写。  -->
    <UserControl.InputBindings>
        <KeyBinding Key="Return" Command="{Binding SubmitCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SubmitCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="15">
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Direction="270"
                    Opacity="0.15"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="52" />
                </Grid.RowDefinitions>

                <!--  标题栏（无系统边框的弹窗靠它拖动）  -->
                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Background="#F8F9FA"
                    BorderBrush="#EBEEF5"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                    <TextBlock
                        Margin="20,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#303133"
                        Text="{Binding Title}" />
                </Border>

                <!--  内容区  -->
                <StackPanel Grid.Row="1" Margin="20,14,20,0">

                    <!--  状态行：此刻是谁在操作。已登录时右侧多一个「退出登录」。
                          未登录也把"（操作员）"写出来，是为了让操作员明白不是软件坏了、是权限就这么多。  -->
                    <Border
                        Padding="12,8"
                        Background="#F5F7FA"
                        CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#606266">
                                <Run Text="当前身份：" />
                                <!-- Run.Text 默认 BindsTwoWayByDefault，绑定只读表达式属性必须显式 Mode=OneWay，
                                     否则 XAML 解析期即抛 InvalidOperationException（对照 ScadaUserManagerView 的写法） -->
                                <Run
                                    FontWeight="SemiBold"
                                    Foreground="#303133"
                                    Text="{Binding LoginStateText, Mode=OneWay}" />
                            </TextBlock>
                            <Button
                                Grid.Column="1"
                                Padding="10,3"
                                Background="#FFFFFF"
                                BorderBrush="#DCDFE6"
                                BorderThickness="1"
                                Command="{Binding LogoutCommand}"
                                Content="退出登录"
                                Cursor="Hand"
                                FontSize="11"
                                Foreground="#409EFF"
                                Visibility="{Binding IsLoggedIn, Converter={ui:BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <!--  出厂密码提示：只在真用得上时出现，不占常态界面的位置。
                          等登录成功再说就晚了 —— 那时候弹窗已经关了。  -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="10,7"
                        Background="#FDF6EC"
                        BorderBrush="#F5DAB1"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding ShowDefaultPasswordHint, Converter={ui:BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontSize="11"
                            Foreground="#E6A23C"
                            Text="出厂管理员 admin 仍在使用默认密码，登录后请立即在「修改密码」页改掉。"
                            TextWrapping="Wrap" />
                    </Border>

                    <TabControl Margin="0,12,0,0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                        <!--  ============ 登录页 ============  -->
                        <TabItem Header="登录">
                            <!--  固定高度 + 按钮钉在底部：两个页签的内容高度不同，
                                  不钉住的话切页签时整个弹窗会跟着长高变矮（SizeToContent），
                                  而且"主操作按钮"会在屏幕上跳位置。  -->
                            <Grid MinHeight="240">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#606266"
                                        Text="用户名" />
                                    <TextBox
                                        x:Name="UserNameBox"
                                        Margin="0,4,0,0"
                                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="#606266"
                                        Text="密码" />
                                    <!--  密码框的观感（圆角 / 聚焦下划线 / 眼睛图标切明文）全部来自
                                          DefaultStyle 里的 PasswordBox 默认样式，这里只负责把值绑给 VM。  -->
                                    <PasswordBox
                                        x:Name="PasswordInput"
                                        Margin="0,4,0,0"
                                        ui:PasswordBoxHelper.BindablePassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--  失败原因。固定 18px 占位：出错时不再把下面的按钮顶下去  -->
                                    <TextBlock
                                        MinHeight="18"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="#F56C6C"
                                        Text="{Binding LoginMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Button
                                    Grid.Row="1"
                                    Margin="0,6,0,0"
                                    Padding="0,9"
                                    Background="#409EFF"
                                    BorderThickness="0"
                                    Command="{Binding LoginCommand}"
                                    Content="登 录"
                                    Cursor="Hand"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    HorizontalAlignment="Stretch" />
                            </Grid>
                        </TabItem>

                        <!--  ============ 修改密码页 ============  -->
                        <TabItem Header="修改密码">
                            <Grid MinHeight="240">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#606266"
                                        Text="用户名" />
                                    <TextBox
                                        Margin="0,4,0,0"
                                        Text="{Binding ChangeUserName, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="#606266"
                                        Text="当前密码" />
                                    <PasswordBox
                                        Margin="0,4,0,0"
                                        ui:PasswordBoxHelper.BindablePassword="{Binding OldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--  新密码与确认并排：它们是同一次输入的两半，摆在一行比上下两行更省地方，
                                          也让人一眼看出"这两格要一样"。  -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#606266"
                                                Text="新密码" />
                                            <PasswordBox
                                                Margin="0,4,0,0"
                                                ui:PasswordBoxHelper.BindablePassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="#606266"
                                                Text="确认新密码" />
                                            <PasswordBox
                                                Margin="0,4,0,0"
                                                ui:PasswordBoxHelper.BindablePassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  结果提示：成功绿、失败红，同一块地方，固定 18px 占位  -->
                                    <TextBlock
                                        MinHeight="18"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Text="{Binding ChangeMessage}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F56C6C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ChangeSucceeded}" Value="True">
                                                        <Setter Property="Foreground" Value="#67C23A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Button
                                    Grid.Row="1"
                                    Margin="0,6,0,0"
                                    Padding="0,9"
                                    Background="#409EFF"
                                    BorderThickness="0"
                                    Command="{Binding ChangePasswordCommand}"
                                    Content="修改密码"
                                    Cursor="Hand"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    HorizontalAlignment="Stretch" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </StackPanel>

                <!--  底栏：主操作（登录 / 修改密码）在页签里，这里只放两个"出去"的口子，
                      所以两个都用次级样式，不跟页签里的蓝色按钮抢注意力。  -->
                <Grid Grid.Row="2" Margin="20,8">
                    <Button
                        Padding="14,6"
                        HorizontalAlignment="Left"
                        Background="#FFFFFF"
                        BorderBrush="#DCDFE6"
                        BorderThickness="1"
                        Command="{Binding OpenUserManagerCommand}"
                        Content="用户管理"
                        Cursor="Hand"
                        FontSize="12"
                        Visibility="{Binding CanManageUsers, Converter={ui:BooleanToVisibilityConverter}}" />
                    <Button
                        Padding="14,6"
                        HorizontalAlignment="Right"
                        Background="#FFFFFF"
                        BorderBrush="#DCDFE6"
                        BorderThickness="1"
                        Command="{Binding CloseCommand}"
                        Content="关闭"
                        Cursor="Hand"
                        FontSize="12" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
