<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScanGroupEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="920"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource DialogBackgroundBrush}"
    mc:Ignorable="d">

    <!--
        ============================================================================
        扫描组编辑器（对标 KEPServerEX 的 Scan Class / Ignition 的 Tag Group）
        ============================================================================

        上卡 = 可编辑的组表；下卡 = 只读的运行诊断（1s 自动刷新）。
        两区拆成两张表而不是合并：编辑区由手工输入驱动，
        若每秒被刷新一次，正在输入的单元格会不断被抢走焦点。

        本视图不自带任何颜色字面量与本地样式：皮肤全部来自
        UI/Controls/Themes/DialogStyles.xaml（青蓝设计系统），
        色值全部来自 Colors.xaml 的 Dialog* 令牌 —— 与「连接管理」「变量管理」
        两个弹窗同屏切换时不再跳色。

        ★ 本弹窗是三个弹窗里唯一带 prism:Dialog.WindowStyle 的（无系统边框、
          不可缩放、按内容定尺寸），所以自绘标题栏必须保留
          ui:WindowDragBehavior.IsWindowDraggable，否则弹窗拖不动。
    -->

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="216" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ================================================================  -->
        <!--  上卡：工具栏 + 扫描组表                                          -->
        <!--  ================================================================  -->
        <Grid Grid.Row="0">
            <!--  投影层与内容层分离：投影不挂在承载文字的 Border 上，否则文字会失去 ClearType 变糊  -->
            <Border Style="{StaticResource DialogCardShadow}" />
            <Border Style="{StaticResource DialogCardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        标题栏（无系统边框的弹窗靠它拖动）。
                        Background="Transparent" 不能省：Border 的 Background 为 null 时
                        整块区域不参与命中测试，鼠标按在空白处根本传不到拖动行为上，
                        弹窗就只能在文字上拖得动。
                    -->
                    <Border
                        Grid.Row="0"
                        ui:WindowDragBehavior.IsWindowDraggable="True"
                        Background="Transparent"
                        Style="{StaticResource DialogCardHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DialogCardTitleIcon}" Text="&#xf5fd;" />
                                <TextBlock Style="{StaticResource DialogCardTitle}" Text="{Binding Title}" />
                            </StackPanel>

                            <!--  组数上限提示：放在标题栏右侧，工具栏那行就腾出来给按钮了  -->
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="{Binding GroupCountHint}" />
                        </Grid>
                    </Border>

                    <!--  ============ 工具栏 ============  -->
                    <Grid Grid.Row="1" Margin="16,14,16,10">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Height="34"
                                MinWidth="92"
                                Command="{Binding AddGroupCommand}"
                                Style="{StaticResource DialogPrimaryButton}"
                                ToolTip="新增一个自定义扫描组（默认周期 1000 ms）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="12"
                                        Text="&#xf067;" />
                                    <TextBlock VerticalAlignment="Center" Text="新增组" />
                                </StackPanel>
                            </Button>

                            <!--
                                一键预设：Button + ContextMenu 做出"下拉菜单"的效果。
                                ContextMenu 挂在独立的 Popup 里，不在可视树上，无法继承 DataContext，
                                所以必须显式把 PlacementTarget（= 这个按钮）的 DataContext 接过来，
                                否则菜单项里的 Command 全部绑不上、点了没反应。
                            -->
                            <Button
                                x:Name="PresetButton"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="14,0"
                                Click="PresetButton_Click"
                                Content="一键预设 ▾"
                                Style="{StaticResource DialogSecondaryButton}"
                                ToolTip="按行业典型档位快速追加扫描组">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Command="{Binding ApplyPresetCommand}" CommandParameter="100" Header="100 ms（联锁）" />
                                        <MenuItem Command="{Binding ApplyPresetCommand}" CommandParameter="500" Header="500 ms（快速）" />
                                        <MenuItem Command="{Binding ApplyPresetCommand}" CommandParameter="1000" Header="1000 ms（常规）" />
                                        <MenuItem Command="{Binding ApplyPresetCommand}" CommandParameter="5000" Header="5000 ms（工艺）" />
                                        <MenuItem Command="{Binding ApplyPresetCommand}" CommandParameter="10000" Header="10000 ms（统计）" />
                                        <MenuItem Command="{Binding ApplyPresetCommand}" CommandParameter="60000" Header="60000 ms（归档）" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!--
                                危险动作走"红图标 + 中性文字"：与连接管理弹窗的「断开选中」同一手法。
                                文字保留次级色，悬停时按钮模板把它转成主色，而图标被显式设成红色、
                                不跟随按钮 Foreground ⇒ 悬停后依然是"这是删除"的视觉提示。
                            -->
                            <Button
                                Height="34"
                                Margin="8,0,0,0"
                                Command="{Binding DeleteGroupCommand}"
                                Style="{StaticResource DialogGhostButton}"
                                ToolTip="删除选中的扫描组（该组变量回落到默认组，变量本身不删）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogDangerBrush}"
                                        Text="&#xf1f8;" />
                                    <TextBlock VerticalAlignment="Center" Text="删除" />
                                </StackPanel>
                            </Button>

                            <Border
                                Width="1"
                                Height="20"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource DialogBorderBrush}" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="复制到：" />
                            <ComboBox
                                Width="170"
                                Height="34"
                                Margin="6,0,8,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding CopyTargets}"
                                SelectedItem="{Binding CopyTarget}"
                                Style="{StaticResource DialogCombo}"
                                ToolTip="把本连接的自定义组表覆盖到另一条连接（不影响对方的默认组周期）" />
                            <Button
                                Height="34"
                                Command="{Binding CopyToConnectionCommand}"
                                Style="{StaticResource DialogGhostButton}"
                                ToolTip="执行复制">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogAccentBrush}"
                                        Text="&#xf0c5;" />
                                    <TextBlock VerticalAlignment="Center" Text="复制" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  ============ 口径提示 ============  -->
                    <!--  用两列 Grid 而不是横向 StackPanel：StackPanel 不给子项宽度约束，TextWrapping 会失效  -->
                    <Grid Grid.Row="2" Margin="16,0,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="&#xf05a;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="优先级由周期升序决定，与列表顺序无关（拖动仅调整显示顺序）。变量数为 0 的组不参与轮询。"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!--  ============ 编辑区 ============  -->
                    <Grid Grid.Row="3" Margin="1,0,1,1">
                        <DataGrid
                            x:Name="GroupsGrid"
                            AllowDrop="True"
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            ColumnHeaderHeight="42"
                            Drop="GroupsGrid_Drop"
                            ItemsSource="{Binding Groups}"
                            RowHeight="40"
                            SelectedItem="{Binding SelectedGroup}"
                            Style="{StaticResource DialogDataGrid}"
                            VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>

                                <!--
                                    组名 / 周期两列的内联输入框自带内边距，
                                    所以单元格改用 DialogDataGridCellFlush（Padding=0），
                                    缩进交给输入框自己撑满 —— 否则两层内边距叠加，
                                    文字会比表头多缩进一格。
                                -->
                                <DataGridTemplateColumn
                                    Width="220"
                                    CellStyle="{StaticResource DialogDataGridCellFlush}"
                                    Header="组名">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                IsReadOnly="{Binding IsDefault}"
                                                Style="{StaticResource DialogGridInput}"
                                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="默认组是虚拟组：组名不可改，它的周期就是这条连接的「默认组周期」" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn
                                    Width="130"
                                    CellStyle="{StaticResource DialogDataGridCellFlush}"
                                    Header="周期 (ms)">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  周期用 LostFocus 回写（不是 PropertyChanged）：
                                                  整数绑定在"清空重填"的中途会解析失败，
                                                  逐字符回写只会把旧值反复刷回去、光标乱跳。  -->
                                            <TextBox
                                                Style="{StaticResource DialogGridInput}"
                                                Text="{Binding IntervalMs, UpdateSourceTrigger=LostFocus}"
                                                ToolTip="合法区间 50 ~ 3600000 ms。改这一列就改了该组的采集节拍" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="110" Header="变量数">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource DialogGridNumber}"
                                                Text="{Binding VariableCount}"
                                                ToolTip="按当前组表试算的结果（未点确定也实时更新）" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="110" Header="段数">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource DialogGridNumber}"
                                                Text="{Binding SegmentCount}"
                                                ToolTip="该组每轮的设备往返次数（地址合并后的段读数）。同变量数下段数越少，合并率越高" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="排序">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  拖动手柄：只改显示顺序。默认组首行固定，故不给手柄  -->
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Cursor="SizeAll"
                                                FontSize="14"
                                                Foreground="{StaticResource DialogTextMutedBrush}"
                                                MouseMove="DragHandle_MouseMove"
                                                PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                Text="⠿"
                                                ToolTip="按住上下拖动，仅调整显示顺序（优先级仍由周期决定）"
                                                Visibility="{Binding IsDefault, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  ================================================================  -->
        <!--  下卡：运行诊断（只读）                                           -->
        <!--  ================================================================  -->
        <Grid Grid.Row="2">
            <Border Style="{StaticResource DialogCardShadow}" />
            <Border Style="{StaticResource DialogCardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource DialogCardHeader}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DialogCardTitleIcon}" Text="&#xf201;" />
                                <TextBlock Style="{StaticResource DialogCardTitle}" Text="运行诊断" />
                            </StackPanel>

                            <!--  "1s 自动刷新"从标题里拆出来靠右放：标题只留名词，刷新频率是次要信息  -->
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="每秒自动刷新" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="1,0,1,1">
                        <DataGrid
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            ColumnHeaderHeight="42"
                            IsReadOnly="True"
                            ItemsSource="{Binding Stats}"
                            RowHeight="38"
                            Style="{StaticResource DialogDataGrid}"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding HasLiveStats, Converter={ui:BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Width="200" Header="组名">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                Text="{Binding GroupName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="目标周期">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource DialogGridNumber}" Text="{Binding TargetText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="130" Header="实测周期">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource DialogGridNumber}" Text="{Binding ActualText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="达成率">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <!--
                                                    进度条：轨道宽度必须与 VM 里的 BarTrackWidth 一致（都是 90），
                                                    否则填充会溢出轨道。
                                                -->
                                                <Border
                                                    Width="90"
                                                    Height="6"
                                                    Background="{StaticResource DialogBorderLightBrush}"
                                                    CornerRadius="3">
                                                    <Border
                                                        Width="{Binding BarWidth}"
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding StatusColor}"
                                                        CornerRadius="3" />
                                                </Border>
                                                <TextBlock
                                                    Width="42"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12.5"
                                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                    Text="{Binding AchieveText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--
                                    状态色由 VM 的 StatusColor 给出（未测 #909399 / ≥90% #12B76A /
                                    70~90% #F79009 / <70% #E5484D）。这是"分档阈值"语义，
                                    不是主题色，刻意不走 Dialog 令牌，换肤时不要动它。
                                -->
                                <DataGridTemplateColumn Width="110" Header="状态">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding StatusColor}"
                                                Text="{Binding StatusText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!--
                            空态：离线 / 无变量 / 连接不存在，原因由 VM 的 StatsHint 给出，
                            避免空表被误读成"扫描组坏了"。
                        -->
                        <StackPanel
                            VerticalAlignment="Center"
                            Visibility="{Binding HasLiveStats, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf0e4;" />
                            <TextBlock Style="{StaticResource DialogEmptyStateTitle}" Text="暂无运行诊断数据" />
                            <TextBlock
                                MaxWidth="440"
                                Style="{StaticResource DialogEmptyStateHint}"
                                Text="{Binding StatsHint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  ============ 底栏 ============  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,14,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="104"
                Command="{Binding CancelCommand}"
                Content="取消"
                Style="{StaticResource DialogSecondaryButton}" />
            <Button
                Width="104"
                Margin="12,0,0,0"
                Command="{Binding ConfirmCommand}"
                Content="确 定"
                Style="{StaticResource DialogPrimaryButton}" />
        </StackPanel>
    </Grid>
</UserControl>
