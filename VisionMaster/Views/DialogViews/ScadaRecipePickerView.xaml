<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaRecipePickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="600"
    Height="520"
    Background="{StaticResource DialogBackgroundBrush}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--
        组态「选择配方」弹窗：从当前方案的配方表里挑一条，回传 (配方 Id, 配方名)。
        清单口径与运行态一致——RecipeService.Recipes 就是 ScadaActionDispatcher
        经 IRecipeCommandSink 应用的那一份，选得到就一定应用得到。
        颜色与字号只引令牌（R140），不写十六进制。
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource DialogCardTitle}" Text="选择配方" />
            <TextBlock
                Margin="0,4,0,0"
                Foreground="{StaticResource DialogTextSecondaryBrush}"
                Text="选择这条动作要应用的方案级配方。"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogCardBorder}">
            <Grid>
                <ListBox
                    Margin="8"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Recipes}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedRecipe}"
                    SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DialogOptionItem}" TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="{Binding Version}" />
                                        <Border
                                            Margin="8,0,0,0"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource DialogAccentSoftBrush}"
                                            CornerRadius="4"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource DialogAccentTextBrush}"
                                                Text="生效中" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                    Text="当前方案还没有配方。请先在标题栏的配方入口里捕获一份配方，再回来配置这条动作。"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Recipes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="2"
            Margin="0,8,0,0"
            Foreground="{StaticResource DialogTextSecondaryBrush}"
            Text="* 确认后按配方身份（Id）记录；之后改名不会让这条动作断链。"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="3"
            Margin="0,12,0,0"
            Padding="0,12,0,0"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Style="{StaticResource DialogSecondaryButton}" />
                <Button
                    MinWidth="88"
                    Command="{Binding PickCommand}"
                    Content="确定"
                    IsDefault="True"
                    Style="{StaticResource DialogPrimaryButton}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
