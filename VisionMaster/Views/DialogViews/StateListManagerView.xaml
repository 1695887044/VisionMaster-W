<UserControl
    x:Class="VisionMaster.Views.DialogViews.StateListManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="460"
    d:DesignWidth="820"
    mc:Ignorable="d">

    <!--
        P1-1 文本列表管理器（设计基线 docs/UI设计基线/scada-state-list/）。
        由 EasyDialog.ShowSync 承载；这里只有内容区。
        编辑的是文档副本，确认后由 Commit() 原地写回（见 StateListManagerViewModel）。
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  本视图自带口粮（R22）：脱离 App 单独渲染时也能取到令牌  -->
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                「最小」「最大」两列的显隐：只在「范围」模式下出现（见 StateListManagerViewModel.IsRangeMode）。
                bool → Visibility 用框架自带的 BooleanToVisibilityConverter，就地声明（R30-R32：跨册取不到）。
            -->
            <BooleanToVisibilityConverter x:Key="RangeVisibility" />

            <Style x:Key="CellBox" TargetType="TextBox">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="TinyButton" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="9,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{StaticResource ScadaSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ScadaPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource TinyButton}">
                <Setter Property="Foreground" Value="{StaticResource ScadaDangerBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ScadaDangerBrush}" />
            </Style>

            <Style x:Key="ListRow" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border
                                x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="5">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaAccentSoftBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="EntryRow">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="写入值（整数）；精确值模式按它匹配，位号模式填位号 0~31" />

                    <!--  范围模式才出现；列宽用固定值，列头与行两处必须一致（两张 Grid 各自算 Auto）  -->
                    <TextBox
                        Grid.Column="1"
                        Width="66"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="范围下界（含）；只有「范围」模式看它"
                        Visibility="{Binding DataContext.IsRangeMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource RangeVisibility}}" />

                    <TextBox
                        Grid.Column="2"
                        Width="66"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="范围上界（含）；只有「范围」模式看它"
                        Visibility="{Binding DataContext.IsRangeMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource RangeVisibility}}" />

                    <TextBox
                        Grid.Column="3"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="显示文字；改文案不会改变已经配好的值" />

                    <TextBox
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Image, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="状态图片（方案内相对路径，如 Image\pump-run.png）；留空 = 这一档不显示图" />

                    <TextBox
                        Grid.Column="5"
                        Margin="0,0,6,0"
                        Style="{StaticResource CellBox}"
                        Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="状态色（#AARRGGBB 文本，例如绿色 22C55E 前补 #）；留空 = 用中性文字色" />

                    <Button
                        Grid.Column="6"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnRemoveEntryClick"
                        Content="×"
                        Cursor="Hand"
                        FontSize="13"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        ToolTip="删除这一条" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：列表  -->
        <Border
            Grid.Column="0"
            Padding="10"
            Background="{StaticResource ScadaPanelBackgroundBrush}"
            BorderBrush="{StaticResource ScadaPanelBorderBrush}"
            BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaTextBrush}"
                        Text="文本列表" />
                    <Button
                        Grid.Column="1"
                        Padding="8,0"
                        Click="OnAddListClick"
                        Content="＋ 新建"
                        Style="{StaticResource TinyButton}"
                        ToolTip="新建一张共享文本列表" />
                </Grid>

                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource ListRow}"
                    ItemsSource="{Binding Lists}"
                    SelectedItem="{Binding SelectedList, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource ScadaTextBrush}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                    Text="{Binding Entries.Count, StringFormat='{}{0} 条'}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!--  右：条目编辑  -->
        <Grid Grid.Column="1" Margin="16,14,16,14">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                Text="左侧还没有文本列表。点「＋ 新建」开始。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedList}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedList}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ScadaTextBrush}"
                            Text="列表名称" />
                        <TextBox
                            Margin="0,5,0,0"
                            Style="{StaticResource CellBox}"
                            Text="{Binding SelectedList.Name, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="改名不影响已引用它的控件（控件存稳定 Id）" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="10.5"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="{Binding ReferenceText}" />
                        <Button
                            Click="OnRemoveListClick"
                            Content="删除列表"
                            Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Grid>

                <!--
                    匹配模式：决定条目怎么和变量值对上。
                    切换模式不改任何条目（值/最小/最大都留在原地），所以列只做显隐、不做清空。
                -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaTextBrush}"
                        Text="匹配模式" />
                    <ComboBox
                        Width="240"
                        Height="26"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Left"
                        Padding="6,2"
                        DisplayMemberPath="Name"
                        FontSize="11.5"
                        ItemsSource="{Binding ModeOptions}"
                        SelectedValue="{Binding Mode, Mode=TwoWay}"
                        SelectedValuePath="Value"
                        ToolTip="精确值 = 与旧版本一致；范围/位/位号见下方说明" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="10.5"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="{Binding ModeHint}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    BorderBrush="{StaticResource ScadaHairlineBrush}"
                    BorderThickness="0,0,0,1" />

                <Grid Grid.Row="3" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  「值」列在范围模式下仍然显示（切回精确值时旧值还在），只是不参与匹配  -->
                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="值">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                <Setter Property="ToolTip" Value="精确值模式：变量值等于这一列即命中" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRangeMode}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                                        <Setter Property="ToolTip" Value="范围模式：这一列不参与匹配（保留旧值，切回精确值/位/位号时继续生效）" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBitIndexMode}" Value="True">
                                        <Setter Property="ToolTip" Value="位号模式：这里填位号 0~31，该位为 1 时命中" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExactMode}" Value="True">
                                        <Setter Property="ToolTip" Value="精确值模式：变量值等于这一列即命中（与 v5 一致）" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock
                        Grid.Column="1"
                        Width="66"
                        Margin="6,0,0,0"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="最小"
                        Visibility="{Binding IsRangeMode, Converter={StaticResource RangeVisibility}}" />
                    <TextBlock
                        Grid.Column="2"
                        Width="66"
                        Margin="6,0,0,0"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="最大"
                        Visibility="{Binding IsRangeMode, Converter={StaticResource RangeVisibility}}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="6,0,0,0"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="显示文字" />
                    <TextBlock
                        Grid.Column="4"
                        Margin="6,0,0,0"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="状态图片（相对路径）" />
                    <TextBlock
                        Grid.Column="5"
                        Margin="6,0,0,0"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                        Text="状态色" />
                </Grid>

                <ScrollViewer
                    Grid.Row="4"
                    Margin="0,2,0,8"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        ItemTemplate="{StaticResource EntryRow}"
                        ItemsSource="{Binding SelectedList.Entries}" />
                </ScrollViewer>

                <StackPanel Grid.Row="5">
                    <Button
                        HorizontalAlignment="Left"
                        Click="OnAddEntryClick"
                        Content="＋ 添加条目"
                        Style="{StaticResource TinyButton}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="10.5"
                        Foreground="{StaticResource ScadaFaintTextBrush}"
                        Text="文本列表只服务于“同一个变量的一组状态”；按钮标题、静态标签仍然手填。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
