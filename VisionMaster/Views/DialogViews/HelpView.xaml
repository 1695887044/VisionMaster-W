<UserControl
    x:Class="VisionMaster.Views.DialogViews.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:help="clr-namespace:VisionMaster.Services.Help"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--
        「帮助手册」弹窗：左目录 / 右正文（CHM 观感，但正文是 WPF 原生的 FlowDocument）。
        构成：宿主自带手册 + 各插件自带手册 + 未写手册插件的自动生成页（见 HelpCatalogService）。
        窗口按"能读长文"给尺寸（1120×740）——手册正文里的表格与端口表都比较宽，
        默认再窄一点就要横向滚动。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="Width" Value="1120" />
            <Setter Property="Height" Value="740" />
            <Setter Property="MinWidth" Value="760" />
            <Setter Property="MinHeight" Value="460" />
            <!--  居中：WindowStartupLocation 不是依赖属性，只能靠行为设（对照 PluginConfigShellView）  -->
            <Setter Property="ui:WindowCenteringBehavior.IsEnabled" Value="True" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.InputBindings>
        <KeyBinding
            Key="P"
            Modifiers="Control"
            Command="{Binding PrintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>

        <!--  工具栏按钮：图标 + 文字，无边框；悬停浅灰底（对照 CHM 顶部那排）  -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#303133" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F2F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E7ED" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            目录树行容器：必须自带模板（OverridesDefaultStyle）。
            理由与 ListView 那条同源（2026-10-06 事故）：App 合并了 Fluent 主题，
            它给 TreeViewItem 也留了隐式样式；行容器模板一旦被顶掉，
            缩进/展开箭头/选中态就都不受本视图控制，观感随主题版本漂移。
            自带模板后，外观只由这份 XAML 决定。
        -->
        <Style x:Key="HelpTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Padding" Value="3,3" />
            <Setter Property="Foreground" Value="#303133" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border
                                x:Name="RowBorder"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  展开箭头：无子项时隐藏  -->
                                    <ToggleButton
                                        x:Name="Expander"
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        ClickMode="Press"
                                        Focusable="False"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path
                                                        x:Name="Arrow"
                                                        Width="8"
                                                        Height="8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M 0,0 L 0,8 L 6,4 Z"
                                                        Fill="#909399"
                                                        RenderTransformOrigin="0.5,0.5" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter
                                        Grid.Column="1"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        ContentSource="Header" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F0F2F5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E8F2FE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  目录节点：图标（插件自带 FA 码点）+ 标题 + 角标（"自动生成"）  -->
        <HierarchicalDataTemplate
            x:Key="HelpNodeTemplate"
            DataType="{x:Type help:HelpNode}"
            ItemsSource="{Binding Children}">
            <StackPanel Margin="2,1" Orientation="Horizontal">
                <TextBlock
                    Width="18"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    FontSize="12"
                    Foreground="#5B8FF9"
                    Text="{Binding Icon}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="{Binding Title}" />
                <Border
                    Margin="6,0,0,0"
                    Padding="5,1"
                    VerticalAlignment="Center"
                    Background="#FFF4E5"
                    CornerRadius="7"
                    Visibility="{Binding HasBadge, Converter={ui:BooleanToVisibilityConverter}}">
                    <TextBlock
                        FontSize="10"
                        Foreground="#B26A00"
                        Text="{Binding Badge}" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Border Background="White" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="0.16"
                    ShadowDepth="3"
                    Color="{StaticResource DialogShadowColor}" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="26" />
                </Grid.RowDefinitions>

                <!--  标题栏（无系统边框的弹窗靠它拖动）  -->
                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="{StaticResource DialogAccentLightBrush}"
                            CornerRadius="9">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="14"
                                Foreground="{StaticResource DialogAccentBrush}"
                                Text="&#xf02d;" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="帮助手册" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="11"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding StatusText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding CloseCommand}"
                            Cursor="Hand"
                            ToolTip="关闭（Esc）">
                            <TextBlock
                                FontSize="14"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="✕" />
                        </Button>
                    </Grid>
                </Border>

                <!--  工具栏：隐藏目录 / 上一步 / 打印 / 选项  -->
                <Border
                    Grid.Row="1"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button Command="{Binding ToggleTocCommand}" Style="{StaticResource ToolButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="11"
                                        Text="&#xf03a;" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding ToggleTocLabel}" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{Binding BackCommand}"
                                Style="{StaticResource ToolButtonStyle}"
                                ToolTip="回到上一页">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="11"
                                        Text="&#xf060;" />
                                    <TextBlock VerticalAlignment="Center" Text="上一步" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{Binding PrintCommand}"
                                Style="{StaticResource ToolButtonStyle}"
                                ToolTip="打印当前页（Ctrl+P）">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="11"
                                        Text="&#xf02f;" />
                                    <TextBlock VerticalAlignment="Center" Text="打印" />
                                </StackPanel>
                            </Button>

                            <!--
                                「选项」= 正文字号三档。
                                为什么做成常驻下拉而不是 CHM 那样的"选项(O)"下拉菜单：
                                Fluent 主题下 Menu 的隐式样式在本窗里没渲染出表头（实测截图为空），
                                而字号是唯一选项——做成常驻下拉既看得见当前档位，也不依赖菜单样式。
                            -->
                            <TextBlock
                                Margin="10,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="正文字号" />
                            <ComboBox
                                Width="78"
                                Height="26"
                                VerticalAlignment="Center"
                                FontSize="12"
                                ItemsSource="{Binding FontSizeOptions}"
                                SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="Ctrl+P 打印当前页" />
                    </Grid>
                </Border>

                <!--  内容区：左目录 / 分隔条 / 右正文  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding TocColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Background="#FBFCFD"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="目录(C)" />

                            <TreeView
                                x:Name="TocTree"
                                Grid.Row="1"
                                Padding="6,0,6,10"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource HelpTreeItemStyle}"
                                ItemTemplate="{StaticResource HelpNodeTemplate}"
                                ItemsSource="{Binding Nodes}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ui:TreeViewBehavior.BindableSelectedItem="{Binding SelectedNode}" />
                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Column="1"
                        Width="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#EFF2F6"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Columns"
                        Visibility="{Binding IsTocVisible, Converter={ui:BooleanToVisibilityConverter}}" />

                    <Grid Grid.Column="2" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  正文页眉：当前页标题 + 来源  -->
                        <Border
                            Grid.Row="0"
                            Background="{StaticResource DialogBackgroundBrush}"
                            BorderBrush="{StaticResource DialogBorderLightBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#303133"
                                    Text="{Binding PageTitle}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Grid.Column="1"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource DialogAccentLightBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource DialogAccentBrush}"
                                        Text="{Binding PageSource}" />
                                </Border>
                            </Grid>
                        </Border>

                        <FlowDocumentScrollViewer
                            Grid.Row="1"
                            Background="White"
                            BorderThickness="0"
                            Document="{Binding Document}"
                            IsToolBarVisible="False"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>

                <!--  状态栏  -->
                <Border
                    Grid.Row="3"
                    Background="{StaticResource DialogBackgroundBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="手册由软件在启动时合并：软件内置 + 各插件自带；标「自动生成」的节点尚未提供手册。"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="Esc 关闭" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
