<UserControl
    x:Class="VisionMaster.Views.DialogViews.OperationsLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="1280"
    Height="850">

    <!--  Esc = 关窗（设计稿 §6：Esc / ✕ / 关闭 三出口；与其它弹窗同一手法）  -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <Border
        Background="{StaticResource DialogSurfaceBrush}"
        BorderBrush="{StaticResource DialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!--  标题栏  -->
            <Grid Grid.Row="0" Margin="20,0,16,0">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="28"
                        Height="28"
                        Background="{StaticResource DialogAccentSoftBrush}"
                        BorderBrush="{StaticResource DialogAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="13"
                            Foreground="{StaticResource DialogAccentBrush}"
                            Text="&#xf1da;" />
                    </Border>
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="操作记录" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="软件级 · 跟机器走，不随方案切换" />
                </StackPanel>
                <Button
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Content="✕"
                    Style="{StaticResource DialogGhostButton}" />
            </Grid>

            <!--  筛选条  -->
            <Grid Grid.Row="1" Margin="20,0" Visibility="{Binding HasAccess, Converter={ui:BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="分类" />
                    <ComboBox
                        Width="130"
                        Height="30"
                        Margin="6,0,14,0"
                        Padding="8,0"
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        Style="{StaticResource DialogCombo}" />
                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="操作者" />
                    <ComboBox
                        Width="130"
                        Height="30"
                        Margin="6,0,14,0"
                        Padding="8,0"
                        ItemsSource="{Binding ActorOptions}"
                        SelectedItem="{Binding SelectedActor, Mode=TwoWay}"
                        Style="{StaticResource DialogCombo}" />
                    <TextBlock VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="时间" />
                    <ComboBox
                        Width="120"
                        Height="30"
                        Margin="6,0,14,0"
                        Padding="8,0"
                        ItemsSource="{Binding RangeOptions}"
                        SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                        Style="{StaticResource DialogCombo}" />
                    <!--  搜索：放大镜 + 占位（DialogInput 模板用 Tag 做占位，Tag 为空时显示）  -->
                    <Border
                        Width="260"
                        Height="30"
                        Style="{StaticResource DialogSearchChrome}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DialogSearchIcon}" Text="&#xf002;" />
                            <TextBox
                                Grid.Column="1"
                                Height="30"
                                VerticalContentAlignment="Center"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                Style="{StaticResource DialogSearchInput}"
                                Tag="搜索…"
                                Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="对象 / 动作 / 明细关键字" />
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空筛选"
                        Style="{StaticResource DialogGhostButton}" />
                    <Button
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding ExportCommand}"
                        Content="导出 CSV"
                        Style="{StaticResource DialogSecondaryButton}" />
                    <Button
                        Height="32"
                        Padding="14,0"
                        Command="{Binding RefreshCommand}"
                        Content="刷新"
                        Style="{StaticResource DialogPrimaryButton}" />
                </StackPanel>
            </Grid>

            <!--  表头 + 行  -->
            <Grid Grid.Row="2" Visibility="{Binding HasAccess, Converter={ui:BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="96" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,0" Background="{StaticResource DialogRowAlternateBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="156" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="时间" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="分类" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="动作" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="结果" />
                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="操作者" />
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="对象" />
                    <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="明细" />
                </Grid>

                <ListBox
                    x:Name="RowsList"
                    Grid.Row="1"
                    AlternationCount="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    MouseDoubleClick="RowsList_MouseDoubleClick"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBd" Height="44" BorderBrush="{StaticResource DialogBorderBrush}" BorderThickness="0,0,0,1" Background="{TemplateBinding Background}">
                                            <Grid>
                                                <!--  选中态左侧 3px 强调竖条（设计稿 §5）  -->
                                                <Border x:Name="SelBar" Width="3" HorizontalAlignment="Left" Background="Transparent" />
                                                <ContentPresenter Margin="20,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelBar" Property="Background" Value="{StaticResource DialogAccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!--  斑马行：AlternationIndex=1 的行浅底（设计稿 §5 默认态）；悬停/选中在其后声明以覆盖它  -->
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="156" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource DialogTextSecondaryBrush}" Text="{Binding Time}" Typography.NumeralAlignment="Tabular" />
                                <Border
                                    Grid.Column="1"
                                    Height="22"
                                    Padding="8,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <!--  设计稿 §3：分类徽标三色（身份=蓝 / 安全动作=红 / 权限=紫）  -->
                                                <DataTrigger Binding="{Binding Category}" Value="Safety">
                                                    <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="Permission">
                                                    <Setter Property="Background" Value="{StaticResource DialogPermissionSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogPermissionBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Text="{Binding CategoryLabel}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="Safety">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Permission">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogPermissionTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DialogTextPrimaryBrush}" Text="{Binding Action}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" FontSize="11" Text="{Binding Outcome}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeniedOutcome}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DialogWarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" FontSize="12" Foreground="{StaticResource DialogTextSecondaryBrush}" Text="{Binding Actor}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" FontSize="12" Foreground="{StaticResource DialogTextSecondaryBrush}" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="6" FontSize="12" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  加载态骨架（设计稿 §5）：查询超过 300ms 才显示，快查询不闪  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="20,14"
                    Visibility="{Binding IsLoading, Converter={ui:BooleanToVisibilityConverter}}">
                    <Border Height="12" Width="520" HorizontalAlignment="Left" CornerRadius="6" Background="{StaticResource DialogBorderBrush}" />
                    <Border Height="12" Width="460" HorizontalAlignment="Left" Margin="0,10,0,0" CornerRadius="6" Background="{StaticResource DialogBorderBrush}" />
                    <Border Height="12" Width="380" HorizontalAlignment="Left" Margin="0,10,0,0" CornerRadius="6" Background="{StaticResource DialogBorderBrush}" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="正在读取操作记录…" />
                </StackPanel>

                <!--  空态：图标 + 文案 + 「清空筛选」出路（设计稿 §5：不是空白页）  -->
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={ui:BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf002;" />
                    <TextBlock
                        MaxWidth="460"
                        Style="{StaticResource DialogEmptyStateTitle}"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />
                    <Button
                        Height="32"
                        Margin="0,12,0,0"
                        Padding="12,0"
                        HorizontalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}"
                        Content="清空筛选"
                        Style="{StaticResource DialogSecondaryButton}" />
                </StackPanel>

                <!--  明细区  -->
                <Border
                    Grid.Row="2"
                    Background="{StaticResource DialogRowAlternateBrush}"
                    BorderBrush="{StaticResource DialogBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel Margin="20,12">
                        <TextBlock FontSize="12" Foreground="{StaticResource DialogTextSecondaryBrush}" Text="{Binding DetailText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource DialogTextTertiaryBrush}" Text="{Binding DetailMeta}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  无权限  -->
            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsDenied, Converter={ui:BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" FontSize="26" Foreground="{StaticResource DialogTextMutedBrush}" Text="🔒" />
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="需要「用户管理」权限" />
                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                    Text="操作记录包含登录失败与权限变更，仅管理员可查看" />
            </StackPanel>

            <!--  页脚  -->
            <Grid Grid.Row="3" Margin="20,0">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding HasAccess, Converter={ui:BooleanToVisibilityConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="{Binding PageText}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="{Binding Feedback}"
                        Visibility="{Binding HasFeedback, Converter={ui:BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding PrevPageCommand}"
                        Content="上一页"
                        Style="{StaticResource DialogSecondaryButton}" />
                    <Button
                        Height="32"
                        Margin="0,0,8,0"
                        Padding="12,0"
                        Command="{Binding NextPageCommand}"
                        Content="下一页"
                        Style="{StaticResource DialogSecondaryButton}" />
                    <Button
                        Height="32"
                        Padding="14,0"
                        Command="{Binding CloseCommand}"
                        Content="关闭"
                        Style="{StaticResource DialogPrimaryButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
