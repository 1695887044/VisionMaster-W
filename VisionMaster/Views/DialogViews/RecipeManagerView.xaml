<UserControl
    x:Class="VisionMaster.Views.DialogViews.RecipeManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Background="Transparent"
    MinWidth="1000"
    MinHeight="640">

    <!--
        固定初始尺寸：Prism 的 DialogWindow 默认按内容自适应，而右侧 DataGrid 的星号列
        在"无行"时会跟着窗口一起撑开——不钉死就出现"打开即近全屏、大片空白"。
        给显式宽高 + SizeToContent=Manual，用户仍可拖拽放大（ResizeMode=CanResizeWithGrip）。
        窗框走全仓统一的"无系统标题栏 + 自绘可拖动标题栏"（FlowCanvasChecks 的【窗框】两条）。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1100" />
            <Setter Property="Height" Value="720" />
            <Setter Property="MinWidth" Value="1000" />
            <Setter Property="MinHeight" Value="640" />
            <Setter Property="AllowsTransparency" Value="True" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="15">
        <Border Style="{StaticResource DialogCardShadow}" />

        <Border Style="{StaticResource DialogCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  自绘标题栏：无边框窗口靠它拖动（WindowStyle=None 后没有系统拖动区）  -->
                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Background="{StaticResource DialogRowAlternateBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0">
                    <TextBlock
                        Margin="16,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource DialogCardTitle}"
                        Text="配方管理" />
                </Border>

                <Grid Grid.Row="1" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左：配方列表 + 从当前值捕获  -->
        <Border Grid.Column="0" Style="{StaticResource DialogCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="16,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DialogCardTitle}" Text="配方" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="同一方案下按产品切换参数" />
                </StackPanel>

                <ListBox
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding RecipeItems}"
                    SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="{Binding Version}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Foreground="{StaticResource DialogAccentTextBrush}"
                                        Text="{Binding ActiveText}" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding SubText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="12,0,12,12">
                    <TextBlock
                        Margin="0,0,0,6"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="从当前已确认参数捕获一份新配方" />
                    <TextBlock
                        Margin="0,0,0,3"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="配方名称" />
                    <TextBox
                        Height="30"
                        Margin="0,0,0,6"
                        Style="{StaticResource DialogInput}"
                        Text="{Binding NewRecipeName, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="配方名称（方案内唯一）" />
                    <TextBlock
                        Margin="0,0,0,3"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="产品编码（可空）" />
                    <TextBox
                        Height="30"
                        Margin="0,0,0,6"
                        Style="{StaticResource DialogInput}"
                        Text="{Binding NewRecipeCode, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="产品编码 / 工单号（可空）" />
                    <TextBlock
                        Margin="0,0,0,3"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="备注（可空）" />
                    <TextBox
                        Height="30"
                        Margin="0,0,0,8"
                        Style="{StaticResource DialogInput}"
                        Text="{Binding NewRecipeNotes, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="备注（可空）" />
                    <Button
                        Height="34"
                        Command="{Binding CaptureCommand}"
                        Content="捕获当前值"
                        Style="{StaticResource DialogPrimaryButton}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Height="30"
                            Command="{Binding ImportCommand}"
                            Content="导入"
                            Style="{StaticResource DialogSecondaryButton}" />
                        <Button
                            Grid.Column="2"
                            Height="30"
                            Command="{Binding ExportCommand}"
                            Content="导出"
                            Style="{StaticResource DialogGhostButton}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!--  右：参数对照 + 动作  -->
        <Border Grid.Column="2" Style="{StaticResource DialogCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <!--  行 1 = 参数工具栏（候选 + 添加/删除），行 2 = 表格本体。
                          高度必须与 Grid.Row 同步：工具栏吃 Auto，表格吃 *；
                          写反的症状是"工具栏被拉成一整屏、表格挤到底部"。  -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="16,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DialogCardTitle}" Text="{Binding SelectedTitle}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="{Binding SelectedSubTitle}" />
                </StackPanel>

                <DataGrid
                    Grid.Row="2"
                    Margin="12,8,12,8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Parameters}"
                    SelectedItem="{Binding SelectedParameter}"
                    SelectionMode="Single"
                    Style="{StaticResource DialogDataGrid}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource DialogDataGridColumnHeader}" TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="38" />
                            <Setter Property="Padding" Value="10,0,0,0" />
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource DialogDataGridRow}" TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource DialogDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0,0,0" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="1.1*"
                            Binding="{Binding Target}"
                            Header="目标" />
                        <DataGridTextColumn
                            Width="1.1*"
                            Binding="{Binding Key}"
                            Header="参数" />
                        <DataGridTextColumn
                            Width="1.3*"
                            Binding="{Binding DeclaredType}"
                            Header="类型" />
                        <DataGridTextColumn
                            Width="1.1*"
                            Binding="{Binding RecipeValue}"
                            Header="配方值" />
                        <DataGridTextColumn
                            Width="1.1*"
                            Binding="{Binding CurrentValue}"
                            Header="当前值" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Status}"
                            Header="状态" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="16,8,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Height="30"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Candidates}"
                        SelectedItem="{Binding SelectedCandidate}"
                        Style="{StaticResource DialogCombo}" />
                    <Button
                        Grid.Column="1"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding AddCandidateCommand}"
                        Content="添加参数"
                        Style="{StaticResource DialogSecondaryButton}" />
                    <Button
                        Grid.Column="2"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding RemoveParameterCommand}"
                        Content="删除参数"
                        Style="{StaticResource DialogDangerButton}" />
                </Grid>

                <Grid Grid.Row="3" Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Height="30"
                        Style="{StaticResource DialogInput}"
                        Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="选中配方的新名称" />
                    <Button
                        Grid.Column="1"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding RenameCommand}"
                        Content="重命名"
                        Style="{StaticResource DialogSecondaryButton}" />
                    <Button
                        Grid.Column="2"
                        Height="30"
                        Margin="8,0,0,0"
                        Command="{Binding ClearActiveCommand}"
                        Content="清除生效"
                        Style="{StaticResource DialogGhostButton}" />
                </Grid>

                <StackPanel Grid.Row="4" Margin="16,0,16,6">
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="{Binding RunLockText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{Binding StatusBrush}"
                        Text="{Binding StatusText}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="5" Margin="16,0">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button
                            Height="34"
                            Margin="0,0,8,0"
                            Command="{Binding ApplyCommand}"
                            Content="应用"
                            IsDefault="True"
                            Style="{StaticResource DialogPrimaryButton}" />
                        <Button
                            Height="34"
                            Command="{Binding ApplyAndSaveCommand}"
                            Content="应用并保存"
                            Style="{StaticResource DialogSecondaryButton}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Height="34"
                            Margin="0,0,8,0"
                            Command="{Binding DeleteCommand}"
                            Content="删除"
                            Style="{StaticResource DialogDangerButton}" />
                        <Button
                            Height="34"
                            Command="{Binding CloseCommand}"
                            Content="关闭"
                            IsCancel="True"
                            Style="{StaticResource DialogGhostButton}" />
                    </StackPanel>
                </Grid>

                <!--  应用确认：差异摘要 + 逐条对照，确认前不写任何值  -->
                <Border
                    Grid.RowSpan="6"
                    Background="{StaticResource DialogScrimBrush}"
                    Visibility="{Binding IsConfirmingApply, Converter={StaticResource BoolToVisibility}}">
                    <Border
                        MaxWidth="780"
                        MaxHeight="560"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource DialogCardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Style="{StaticResource DialogCardTitle}"
                                Text="确认应用配方" />
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,6,0,8"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                Text="{Binding PreviewSummary}"
                                TextWrapping="Wrap" />
                            <DataGrid
                                Grid.Row="2"
                                MaxHeight="320"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserReorderColumns="False"
                                GridLinesVisibility="None"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding PreviewItems}"
                                SelectionMode="Single"
                                Style="{StaticResource DialogDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="1.1*"
                                        Binding="{Binding Target}"
                                        Header="目标" />
                                    <DataGridTextColumn
                                        Width="1.1*"
                                        Binding="{Binding Key}"
                                        Header="参数" />
                                    <DataGridTextColumn
                                        Width="1.2*"
                                        Binding="{Binding Current}"
                                        Header="当前值" />
                                    <DataGridTextColumn
                                        Width="1.2*"
                                        Binding="{Binding Recipe}"
                                        Header="配方值" />
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding StatusText}"
                                        Header="状态" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel
                                Grid.Row="3"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Command="{Binding ConfirmApplyCommand}"
                                    Content="确认应用"
                                    IsDefault="True"
                                    Style="{StaticResource DialogPrimaryButton}" />
                                <Button
                                    Height="34"
                                    Command="{Binding CancelPreviewCommand}"
                                    Content="取消"
                                    IsCancel="True"
                                    Style="{StaticResource DialogGhostButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
                </Grid>
            </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
