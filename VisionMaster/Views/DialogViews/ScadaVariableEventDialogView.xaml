<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaVariableEventDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VisionMaster.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="920"
    Height="640"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  组态「变量事件」弹窗  -->
    <!--  值驱动规则的集中配置处：更改数值 / 值为真 / 值为假 / 上限 / 下限。  -->
    <!--  左栏是变量清单（变量 + 已失效两段），右栏是当前选中变量的详情。  -->
    <!--  两栏各自滚动，弹窗尺寸固定：清单长度与右栏卡片高度都会长，  -->
    <!--  交给 SizeToContent 的结果是窗口一边用一边变，比滚动难用得多。  -->
    <!--  ==========================================  -->

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--  只有「关闭」这一个提交语义之外的动作，所以只挂 Esc。  -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!--  字段名  -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#303133" />
        </Style>

        <!--  数值输入框：右对齐。数字右对齐才看得出位数。  -->
        <Style x:Key="LimitBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!--  字段说明  -->
        <Style x:Key="FieldHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#909399" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  分组卡片：浅底细边，与白底弹窗拉开一层  -->
        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="#EBEEF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  分组标题：3px 蓝条 + 标题字  -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#303133" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Direction="270"
                    Opacity="0.15"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <!--  标题栏（无系统边框的弹窗靠它拖动）  -->
                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Background="#F8F9FA"
                    BorderBrush="#EBEEF5"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                    <TextBlock
                        Margin="20,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#303133"
                        Text="{Binding Title}" />
                </Border>

                <!--  内容区：左清单 + 右详情  -->
                <Grid Grid.Row="1" Margin="20,14,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  ============ 左栏：变量清单 ============  -->
                    <Border
                        Grid.Column="0"
                        Background="#FFFFFF"
                        BorderBrush="#E4E7ED"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel
                                Grid.Row="0"
                                Margin="12,10,12,8"
                                Orientation="Horizontal">
                                <Border
                                    Width="3"
                                    Height="13"
                                    VerticalAlignment="Center"
                                    Background="#409EFF"
                                    CornerRadius="2" />
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="变量清单" />
                            </StackPanel>

                            <ListBox
                                Grid.Row="1"
                                Margin="8,0,8,8"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                ItemsSource="{Binding Rows}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedRow}"
                                SelectionMode="Single">

                                <!--  分组：组键就是行上的中文串（变量 / 已失效），所以不必再引值转换器  -->
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Expander IsExpanded="True">
                                                                <Expander.Header>
                                                                    <StackPanel Margin="0,4,0,2" Orientation="Horizontal">
                                                                        <Border
                                                                            Width="3"
                                                                            Height="11"
                                                                            VerticalAlignment="Center"
                                                                            Background="#909399"
                                                                            CornerRadius="2" />
                                                                        <TextBlock
                                                                            Margin="6,0,0,0"
                                                                            FontSize="12"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="#606266"
                                                                            Text="{Binding Name}" />
                                                                        <TextBlock
                                                                            Margin="6,0,0,0"
                                                                            FontSize="11"
                                                                            Foreground="#C0C4CC"
                                                                            Text="{Binding ItemCount, StringFormat='({0})'}" />
                                                                    </StackPanel>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ListBox.GroupStyle>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,4" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border
                                                        x:Name="RowBorder"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="Transparent"
                                                        BorderBrush="#F2F3F5"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#F5F7FA" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#ECF5FF" />
                                                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#409EFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" ToolTip="{Binding ConditionText}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!--  变量名  -->
                                            <TextBlock
                                                Grid.Row="0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#303133" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                                <Setter Property="Foreground" Value="#F56C6C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--  变量还在：类型 · 来源 · 当前值  -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#909399"
                                                        Text="{Binding DataType, Converter={ui:TypeNameToFriendlyNameConverter}}" />
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        FontSize="11"
                                                        Foreground="#C0C4CC"
                                                        Text="·" />
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        FontSize="11"
                                                        Foreground="#909399"
                                                        Text="{Binding SourceLabel}" />
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        FontSize="11"
                                                        Foreground="#C0C4CC"
                                                        Text="·" />
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        FontSize="11"
                                                        Foreground="#606266"
                                                        Text="{Binding ValueText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!--  变量已不存在：这条记录运行态永远不会触发，只能删  -->
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontSize="11"
                                                    Foreground="#F56C6C"
                                                    Text="变量已不存在（这条配置只能删除）">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!--  配置状态字  -->
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding SummaryText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#67C23A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SummaryText}" Value="未配置">
                                                                    <Setter Property="Foreground" Value="#C0C4CC" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SummaryText}" Value="已停用">
                                                                    <Setter Property="Foreground" Value="#E6A23C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--  空态：工程里一个变量都没有  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#909399"
                                Text="当前方案里还没有工程变量。请先在变量管理里添加变量，再回到这里配置事件。"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasAnyRows, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                        </Grid>
                    </Border>

                    <!--  ============ 右栏：事件详情 ============  -->
                    <Grid Grid.Column="1" Margin="14,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  详情头：选中对象的身份 + 删除入口  -->
                        <Border
                            Grid.Row="0"
                            Padding="12,10"
                            Background="#F5F7FA"
                            BorderBrush="#EBEEF5"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#303133"
                                        Text="{Binding SelectedRow.Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRow.HasVariable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#909399"
                                            Text="{Binding SelectedRow.DataType, Converter={ui:TypeNameToFriendlyNameConverter}}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="11"
                                            Foreground="#C0C4CC"
                                            Text="·" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="11"
                                            Foreground="#909399"
                                            Text="{Binding SelectedRow.SourceLabel}" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="11"
                                            Foreground="#C0C4CC"
                                            Text="·" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            FontSize="11"
                                            Foreground="#606266"
                                            Text="{Binding SelectedRow.ValueText}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Padding="14,6"
                                    VerticalAlignment="Center"
                                    Background="#FFFFFF"
                                    BorderBrush="#FBC4C4"
                                    Command="{Binding RemoveCommand}"
                                    Content="删除该配置"
                                    Cursor="Hand"
                                    FontSize="12"
                                    Foreground="#F56C6C"
                                    ToolTip="删掉这条变量事件（连同它下面的所有事件与动作）">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!--  右栏滚动区  -->
                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <!--  一个都没选中  -->
                                <TextBlock
                                    Margin="0,40,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    FontSize="12"
                                    Foreground="#909399"
                                    Text="请从左侧选择一个变量，查看或配置它的事件。"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                <!--  选中了变量但还没配：显式点按钮才建记录  -->
                                <Border
                                    Padding="16,14"
                                    VerticalAlignment="Top"
                                    Background="#FAFBFC"
                                    BorderBrush="#DCDFE6"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="{Binding ShowCreatePrompt, Converter={ui:BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#303133"
                                            Text="这个变量还没有事件配置" />
                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="点下面的按钮为它建一条配置，之后才能设置阈值与五类值事件。不建配置就不会跟着方案保存，也不会进撤销栈。" />
                                        <Button
                                            Margin="0,12,0,0"
                                            Padding="18,7"
                                            HorizontalAlignment="Left"
                                            Background="#409EFF"
                                            BorderThickness="0"
                                            Command="{Binding CreateCommand}"
                                            Content="新建事件配置"
                                            Cursor="Hand"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!--  有记录：阈值卡片 + 五类值事件卡片  -->
                                <StackPanel Visibility="{Binding HasRecord, Converter={ui:BooleanToVisibilityConverter}}">

                                    <!--  阈值  -->
                                    <Border Style="{StaticResource GroupCardStyle}" Margin="0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="3"
                                                    Height="13"
                                                    VerticalAlignment="Center"
                                                    Background="#409EFF"
                                                    CornerRadius="2" />
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="阈值判定" />
                                            </StackPanel>

                                            <CheckBox
                                                Margin="0,10,0,0"
                                                Content="启用这条变量事件的监视"
                                                FontSize="12"
                                                IsChecked="{Binding IsRecordEnabled}"
                                                ToolTip="停用后运行态连变量都不订阅（配置保留），可以先配好、上线再开" />

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Content="上限"
                                                    FontSize="13"
                                                    IsChecked="{Binding UpperLimitEnabled}" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    IsEnabled="{Binding UpperLimitEnabled}"
                                                    Style="{StaticResource LimitBoxStyle}"
                                                    Text="{Binding UpperLimitText, UpdateSourceTrigger=LostFocus}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="#909399"
                                                    Text="值越过上限时触发「上限」事件" />
                                            </Grid>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Content="下限"
                                                    FontSize="13"
                                                    IsChecked="{Binding LowerLimitEnabled}" />
                                                <TextBox
                                                    Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    IsEnabled="{Binding LowerLimitEnabled}"
                                                    Style="{StaticResource LimitBoxStyle}"
                                                    Text="{Binding LowerLimitText, UpdateSourceTrigger=LostFocus}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="#909399"
                                                    Text="值低于下限时触发「下限」事件" />
                                            </Grid>

                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="不勾选 = 不判这条限值。勾上之后请填数字；清空输入框同样等于不判。" />
                                        </StackPanel>
                                    </Border>

                                    <!--  五类值事件  -->
                                    <Border Style="{StaticResource GroupCardStyle}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border
                                                    Width="3"
                                                    Height="13"
                                                    VerticalAlignment="Center"
                                                    Background="#409EFF"
                                                    CornerRadius="2" />
                                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="值事件与动作" />
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="勾上某一类事件，再往下给它配动作（记录日志 / 写变量 / 切换画面等）；同一个变量可以同时配多类。" />

                                            <ItemsControl ItemsSource="{Binding Editors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            Margin="0,6,0,0"
                                                            Padding="8,6"
                                                            Background="#FFFFFF"
                                                            BorderBrush="#EBEEF5"
                                                            BorderThickness="1"
                                                            CornerRadius="4">
                                                            <controls:ScadaEventEditor />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!--  校验 / 删除失败：红底红字，说清是哪一格、当前填的是什么  -->
                        <Border
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="#FEF0F0"
                            BorderBrush="#FDE2E2"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding HasError, Converter={ui:BooleanToVisibilityConverter}}">
                            <TextBlock
                                FontSize="12"
                                Foreground="#F56C6C"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Grid>

                <!--  底部按钮：写回是即时的，所以这里只有「关闭」  -->
                <StackPanel
                    Grid.Row="2"
                    Margin="20,10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Padding="28,8"
                        Background="#409EFF"
                        BorderThickness="0"
                        Command="{Binding CloseCommand}"
                        Content="关闭"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
