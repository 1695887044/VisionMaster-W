<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaPermissionCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="820"
    Height="620"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width" Value="820" />
            <Setter Property="Height" Value="620" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResize" />
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Controls/GridView.xaml" />
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="CatalogHeaderStyle"
                BasedOn="{StaticResource GridListHeaderStyle}"
                TargetType="GridViewColumnHeader">
                <Setter Property="Height" Value="28" />
                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
            </Style>

            <Style x:Key="CatalogRowStyle" TargetType="ListViewItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Height" Value="26" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border
                                x:Name="RowBorder"
                                Padding="4,0"
                                Background="Transparent"
                                BorderBrush="{StaticResource DialogBorderLightBrush}"
                                BorderThickness="0,0,0,1">
                                <GridViewRowPresenter
                                    Columns="{TemplateBinding GridView.ColumnCollection}"
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    SnapsToDevicePixels="True"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CatalogNameStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CatalogKeyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextTertiaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CatalogCellStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Background="{DynamicResource DialogSurfaceBrush}"
        CornerRadius="12">
        <Border
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogCardBorderBrush}"
            BorderThickness="0"
            CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ================= 标题 =================  -->
                <Grid
                    Grid.Row="0"
                    Margin="20,0"
                    ui:WindowDragBehavior.IsWindowDraggable="True">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="权限目录" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="9,2"
                            VerticalAlignment="Center"
                            CornerRadius="11">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFull}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding CountText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding CloseCommand}"
                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                        Style="{StaticResource DialogQuietButton}">
                        <Viewbox Width="12" Height="12">
                            <Path
                                Data="M2,2 L10,10 M10,2 L2,10"
                                Stroke="{StaticResource DialogTextTertiaryBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.4" />
                        </Viewbox>
                        <Button.ToolTip>
                            <ToolTip Content="关闭" Style="{StaticResource DialogToolTipStyle}" />
                        </Button.ToolTip>
                    </Button>
                </Grid>

                <!--  ================= 工具条 =================  -->
                <Grid Grid.Row="1" Margin="20,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="{Binding CountHint}" />
                    <Button
                        Height="30"
                        Padding="12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding BeginCreateCommand}"
                        Content="＋ 新建权限"
                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                        Style="{StaticResource DialogPrimaryButton}" />
                </Grid>

                <!--  ================= 行内新建表单 =================  -->
                <Border
                    Grid.Row="2"
                    Margin="20,0,20,10"
                    Padding="10"
                    Background="{StaticResource DialogAccentSoftBrush}"
                    BorderBrush="{StaticResource DialogAccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsCreating, Converter={ui:BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Height="36"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource DialogInput}"
                            Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="权限显示名" />

                        <Grid
                            Grid.Column="1"
                            Width="180"
                            Height="36"
                            Margin="10,0,0,0">
                            <Rectangle
                                RadiusX="6"
                                RadiusY="6"
                                Stroke="{StaticResource DialogBorderStrongBrush}"
                                StrokeDashArray="3 3"
                                StrokeThickness="1" />
                            <TextBlock
                                Margin="10,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                                FontSize="12"
                                Foreground="{StaticResource DialogTextTertiaryBrush}"
                                Text="{Binding NewKeyPreview}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <TextBlock
                            Grid.Column="2"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                            Text="Key 由显示名生成，创建后不可修改" />

                        <Button
                            Grid.Column="3"
                            Height="30"
                            Margin="0,0,8,0"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Command="{Binding CancelCreateCommand}"
                            Content="取消"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            Style="{StaticResource DialogSecondaryButton}" />
                        <Button
                            Grid.Column="4"
                            Height="30"
                            Padding="14,0"
                            VerticalAlignment="Center"
                            Command="{Binding CreateCommand}"
                            Content="创建"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            Style="{StaticResource DialogPrimaryButton}" />
                    </Grid>
                </Border>

                <!--  ================= 列表 =================  -->
                <ListView
                    Grid.Row="3"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource CatalogRowStyle}"
                    ItemsSource="{Binding Rows}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedRow}"
                    SelectionMode="Single"
                    Style="{StaticResource GridListViewStyle}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource CatalogHeaderStyle}">
                            <GridViewColumn Width="229" Header="名称">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                ToolTip="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource CatalogNameStyle}" TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox
                                                Height="24"
                                                VerticalContentAlignment="Center"
                                                Text="{Binding RenameName, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBox.Style>
                                                    <Style BasedOn="{StaticResource DialogInput}" TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="198" Header="Key">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Style="{StaticResource CatalogKeyStyle}"
                                            Text="{Binding Key}"
                                            ToolTip="{Binding Key}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="84" Header="使用组">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Width="64"
                                            TextAlignment="Center"
                                            Style="{StaticResource CatalogCellStyle}"
                                            Text="{Binding UsedGroupCount}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="92" Header="类型">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" Text="{Binding TypeText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogTextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="160" Header="操作">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button
                                                    Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="改名"
                                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                    Style="{StaticResource DialogLinkButton}" />
                                                <Button
                                                    Margin="10,0,0,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="删除"
                                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                    Style="{StaticResource DialogLinkButtonDanger}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button
                                                    Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="保存"
                                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                    Style="{StaticResource DialogLinkButton}" />
                                                <Button
                                                    Margin="10,0,0,0"
                                                    Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="取消"
                                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                                    Style="{StaticResource DialogLinkButton}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!--  ================= 底栏说明 / 满额提示 =================  -->
                <Border
                    Grid.Row="4"
                    MinHeight="62"
                    Padding="20,8,20,20"
                    Background="{StaticResource DialogRowAlternateBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFull}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" Text="{Binding NoteText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DialogTextTertiaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border
                    Grid.Row="5"
                    Padding="20,10"
                    Background="{StaticResource DialogWarningSubtleBrush}"
                    BorderBrush="{StaticResource DialogWarningBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Visibility="{Binding IsFull, Converter={ui:BooleanToVisibilityConverter}}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource DialogWarningTextBrush}"
                        Text="已达上限 32 条，删除或合并后再建。" />
                </Border>
            </Grid>
        </Border>
    </Border>
</UserControl>
