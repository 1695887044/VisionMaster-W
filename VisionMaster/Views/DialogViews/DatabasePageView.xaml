<UserControl
    x:Class="VisionMaster.Views.DialogViews.DatabasePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:db="clr-namespace:Core.Interfaces.Database;assembly=Core.Interfaces"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource DialogBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============================ 页头 ============================  -->
        <Grid Grid.Row="0" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="数据库" />
                <TextBlock
                    Margin="0,3,0,0"
                    Style="{StaticResource DialogHintText}"
                    Text="在这里添加数据库、封装命名语句；流程步骤只能选择这里封装好的语句与参数" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <Button
                    Height="30"
                    Margin="0,0,8,0"
                    Padding="12,0"
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    FontSize="11"
                    Style="{StaticResource DialogSecondaryButton}" />
                <Button
                    Height="30"
                    Padding="12,0"
                    Command="{Binding AddProfileCommand}"
                    Content="添加数据库"
                    FontSize="11"
                    Style="{StaticResource DialogPrimaryButton}" />
            </StackPanel>
        </Grid>

        <!--  ============================ 主体 ============================  -->
        <Grid Grid.Row="1" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  左：数据库列表  -->
            <Border
                Grid.Column="0"
                Margin="0,0,14,0"
                Padding="8"
                Background="{StaticResource DialogSurfaceBrush}"
                BorderBrush="{StaticResource DialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="4,2,4,8"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="{Binding Profiles.Count, StringFormat='数据库（{0}）'}" />

                    <ListBox
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                        SelectionChanged="OnProfileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="10"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Orientation="Horizontal">
                        <Button
                            Height="28"
                            Padding="10,0"
                            Command="{Binding SaveProfileCommand}"
                            Content="保存数据库"
                            FontSize="11"
                            Style="{StaticResource DialogPrimaryButton}" />
                        <Button
                            Height="28"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            Command="{Binding DeleteProfileCommand}"
                            Content="删除"
                            FontSize="11"
                            Style="{StaticResource DialogSecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  右：详情  -->
            <ScrollViewer
                Grid.Column="1"
                Padding="0,0,8,0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!--  连接卡  -->
                    <Border
                        Margin="0,0,0,12"
                        Padding="14"
                        Background="{StaticResource DialogSurfaceBrush}"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="连接" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button
                                        Height="28"
                                        Padding="10,0"
                                        Command="{Binding TestConnectionCommand}"
                                        Content="测试连接"
                                        FontSize="11"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                </StackPanel>
                            </Grid>

                            <Grid IsEnabled="{Binding CanEdit}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="名称" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Height="32"
                                    Margin="0,0,0,8"
                                    Padding="8,0"
                                    Background="{StaticResource DialogSurfaceBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="类型" />
                                <ComboBox Style="{StaticResource DialogComboCompact}"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Height="32"
                                    Margin="0,0,0,8"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{Binding ProviderOptions}"
                                    SelectedValue="{Binding SelectedProfile.Provider, Mode=TwoWay}"
                                    SelectedValuePath="Value" />

                                <!--  SQLite：文件库  -->
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="文件"
                                    Visibility="{Binding SelectedProfile.IsSqlite, Converter={ui:BooleanToVisibilityConverter}}" />
                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding SelectedProfile.IsSqlite, Converter={ui:BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Height="32"
                                        Padding="8,0"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedProfile.FilePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Command="{Binding BrowseDatabaseFileCommand}"
                                        Content="浏览…"
                                        FontSize="11"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                    <Button
                                        Grid.Column="2"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Command="{Binding CreateDatabaseFileCommand}"
                                        Content="新建…"
                                        FontSize="11"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                </Grid>

                                <!--  MySQL / MariaDB：服务器  -->
                                <TextBlock
                                    Grid.Row="3"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="服务器"
                                    Visibility="{Binding SelectedProfile.IsMySql, Converter={ui:BooleanToVisibilityConverter}}" />
                                <StackPanel
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal"
                                    Visibility="{Binding SelectedProfile.IsMySql, Converter={ui:BooleanToVisibilityConverter}}">
                                    <TextBox
                                        Width="240"
                                        Height="32"
                                        Padding="8,0"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedProfile.Server, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="12,0,6,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogFormLabel}"
                                        Text="端口" />
                                    <TextBox
                                        Width="80"
                                        Height="32"
                                        Padding="8,0"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedProfile.Port, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!--  MySQL / MariaDB：数据库 / 用户  -->
                                <TextBlock
                                    Grid.Row="4"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="数据库 / 用户"
                                    Visibility="{Binding SelectedProfile.IsMySql, Converter={ui:BooleanToVisibilityConverter}}" />
                                <StackPanel
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal"
                                    Visibility="{Binding SelectedProfile.IsMySql, Converter={ui:BooleanToVisibilityConverter}}">
                                    <TextBox
                                        Width="200"
                                        Height="32"
                                        Padding="8,0"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedProfile.DatabaseName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="12,0,6,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DialogFormLabel}"
                                        Text="用户" />
                                    <TextBox
                                        Width="160"
                                        Height="32"
                                        Padding="8,0"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedProfile.UserId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!--  MySQL / MariaDB：密码（PasswordBox，明文不进绑定）  -->
                                <TextBlock
                                    Grid.Row="5"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="密码"
                                    Visibility="{Binding SelectedProfile.IsMySql, Converter={ui:BooleanToVisibilityConverter}}" />
                                <StackPanel
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal"
                                    Visibility="{Binding SelectedProfile.IsMySql, Converter={ui:BooleanToVisibilityConverter}}">
                                    <PasswordBox
                                        x:Name="ProfilePasswordBox"
                                        Width="200"
                                        Height="32"
                                        Padding="8,0"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        PasswordChanged="OnPasswordChanged" />
                                    <Button
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Command="{Binding ClearPasswordCommand}"
                                        Content="清除"
                                        FontSize="11"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding SelectedProfile.PasswordHint}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="6"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="打开方式" />
                                <StackPanel
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        Content="以只读方式打开（只允许查询语句）"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        IsChecked="{Binding SelectedProfile.IsReadOnly, Mode=TwoWay}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="7"
                                    Margin="0,0,8,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="超时 / 行数" />
                                <StackPanel
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                                    <TextBox
                                        Width="70"
                                        Height="32"
                                        Padding="8,0"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedProfile.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="6,0,16,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="秒" />
                                    <TextBox
                                        Width="90"
                                        Height="32"
                                        Padding="8,0"
                                        VerticalContentAlignment="Center"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedProfile.MaxRows, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="最大返回行数" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="8"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="启用" />
                                <CheckBox
                                    Grid.Row="8"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="启用该数据库（禁用后流程步骤会明确失败）"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    IsChecked="{Binding SelectedProfile.IsEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Border
                                Margin="0,10,0,0"
                                Padding="10,8"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding HasProfileTestMessage, Converter={ui:BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProfileTestLevelKey}" Value="ok">
                                                <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProfileTestLevelKey}" Value="fail">
                                                <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding ProfileTestMessage}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  命名语句卡  -->
                    <Border
                        Padding="14"
                        Background="{StaticResource DialogSurfaceBrush}"
                        BorderBrush="{StaticResource DialogBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding Statements.Count, StringFormat='命名语句（{0}）'}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button
                                        Height="28"
                                        Padding="10,0"
                                        Command="{Binding AddStatementCommand}"
                                        Content="新建语句"
                                        FontSize="11"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                    <Button
                                        Height="28"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Command="{Binding TestStatementCommand}"
                                        Content="测试语句"
                                        FontSize="11"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                    <Button
                                        Height="28"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Command="{Binding SaveStatementCommand}"
                                        Content="保存语句"
                                        FontSize="11"
                                        Style="{StaticResource DialogPrimaryButton}" />
                                    <Button
                                        Height="28"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        Command="{Binding DeleteStatementCommand}"
                                        Content="删除"
                                        FontSize="11"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ListBox
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                                    BorderThickness="1"
                                    ItemsSource="{Binding Statements}"
                                    SelectedItem="{Binding SelectedStatement, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="9.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding KindText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid
                                    Grid.Column="1"
                                    IsEnabled="{Binding CanEdit}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogFormLabel}"
                                            Text="名称" />
                                        <TextBox
                                            Grid.Column="1"
                                            Height="32"
                                            Padding="8,0"
                                            VerticalContentAlignment="Center"
                                            Background="{StaticResource DialogSurfaceBrush}"
                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding SelectedStatement.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogFormLabel}"
                                            Text="类型" />
                                        <ComboBox Style="{StaticResource DialogComboCompact}"
                                            Grid.Column="3"
                                            Height="32"
                                            DisplayMemberPath="Text"
                                            ItemsSource="{Binding KindOptions}"
                                            SelectedValue="{Binding SelectedStatement.Kind, Mode=TwoWay}"
                                            SelectedValuePath="Value" />
                                    </Grid>

                                    <TextBox
                                        Grid.Row="1"
                                        Height="140"
                                        Margin="0,0,0,8"
                                        Padding="8,6"
                                        AcceptsReturn="True"
                                        AcceptsTab="True"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        HorizontalScrollBarVisibility="Auto"
                                        Text="{Binding SelectedStatement.Sql, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalScrollBarVisibility="Auto" />

                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="{Binding SelectedStatement.Parameters.Count, StringFormat='参数（{0}）'}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button
                                                Height="26"
                                                Padding="10,0"
                                                Command="{Binding AddParameterCommand}"
                                                Content="添加参数"
                                                FontSize="10.5"
                                                Style="{StaticResource DialogSecondaryButton}" />
                                            <Button
                                                Height="26"
                                                Margin="8,0,0,0"
                                                Padding="10,0"
                                                Command="{Binding RemoveParameterCommand}"
                                                Content="移除最后一个参数"
                                                FontSize="10.5"
                                                Style="{StaticResource DialogSecondaryButton}" />
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid
                                        Grid.Row="3"
                                        Height="150"
                                        Margin="0,0,0,8"
                                        AutoGenerateColumns="False"
                                        Background="{StaticResource DialogSurfaceBrush}"
                                        BorderBrush="{StaticResource DialogBorderBrush}"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        GridLinesVisibility="Horizontal"
                                        HeadersVisibility="Column"
                                        ItemsSource="{Binding SelectedStatement.Parameters}"
                                        SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="110"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Header="名称" />
                                            <DataGridComboBoxColumn
                                                Width="90"
                                                Header="类型"
                                                ItemsSource="{Binding Source={x:Static db:DbTypeNames.All}}"
                                                SelectedItemBinding="{Binding DbType, UpdateSourceTrigger=PropertyChanged}" />
                                            <DataGridCheckBoxColumn
                                                Width="48"
                                                Binding="{Binding IsRequired}"
                                                Header="必填" />
                                            <DataGridTextColumn
                                                Width="100"
                                                Binding="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                                Header="默认值" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                Header="说明" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogFormLabel}"
                                            Text="超时" />
                                        <TextBox
                                            Grid.Column="1"
                                            Width="60"
                                            Height="30"
                                            Margin="6,0,12,0"
                                            Padding="6,0"
                                            VerticalContentAlignment="Center"
                                            Background="{StaticResource DialogSurfaceBrush}"
                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding SelectedStatement.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="0 = 用数据库默认值" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogFormLabel}"
                                            Text="最大行数" />
                                        <TextBox
                                            Grid.Column="3"
                                            Width="70"
                                            Height="30"
                                            Margin="6,0,12,0"
                                            Padding="6,0"
                                            VerticalContentAlignment="Center"
                                            Background="{StaticResource DialogSurfaceBrush}"
                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding SelectedStatement.MaxRows, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="0 = 用数据库默认值" />
                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource DialogFormLabel}"
                                            Text="最大影响行数" />
                                        <TextBox
                                            Grid.Column="5"
                                            Width="70"
                                            Height="30"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Left"
                                            Padding="6,0"
                                            VerticalContentAlignment="Center"
                                            Background="{StaticResource DialogSurfaceBrush}"
                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding SelectedStatement.MaxAffectedRows, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="0 = 不限制；超限会在事务内回滚" />
                                        <CheckBox
                                            Grid.Column="6"
                                            VerticalAlignment="Center"
                                            Content="启用"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            IsChecked="{Binding SelectedStatement.IsEnabled, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Border
                                Margin="0,10,0,0"
                                Padding="10,8"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding HasStatementTestMessage, Converter={ui:BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DialogBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatementTestLevelKey}" Value="ok">
                                                <Setter Property="Background" Value="{StaticResource DialogSuccessSubtleBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DialogSuccessBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatementTestLevelKey}" Value="fail">
                                                <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DialogDangerBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding StatementTestMessage}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <TextBox
                                Height="110"
                                Margin="0,8,0,0"
                                Padding="8,6"
                                AcceptsReturn="True"
                                Background="{StaticResource DialogRowAlternateBrush}"
                                BorderBrush="{StaticResource DialogBorderLightBrush}"
                                FontFamily="Consolas"
                                FontSize="10.5"
                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                IsReadOnly="True"
                                Text="{Binding PreviewText, Mode=OneWay}"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding HasPreview, Converter={ui:BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  ============================ 页脚 ============================  -->
        <Grid Grid.Row="2" Margin="24,10,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock
                    FontSize="10.5"
                    Foreground="{StaticResource DialogWarningTextBrush}"
                    Text="{Binding GateReason}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasGateReason, Converter={ui:BooleanToVisibilityConverter}}" />
                <TextBlock
                    FontSize="10.5"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="{Binding StatusText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="10.5"
                Foreground="{StaticResource DialogTextMutedBrush}"
                Text="{Binding DirtyText}" />
        </Grid>
    </Grid>
</UserControl>
