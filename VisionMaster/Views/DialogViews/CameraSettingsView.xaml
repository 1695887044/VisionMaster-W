<UserControl
    x:Class="VisionMaster.Views.DialogViews.CameraSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource DialogBackgroundBrush}">

    <!--
        窗口尺寸挂在 Window 上，不写在 UserControl 根节点上。
        UserControl 一旦显式写了 Width，默认的 Stretch 就退化成"居中"——窗口拉大后
        内容缩在中间、四周留白，且永远不跟着窗口变宽。搬到 Window 后内容自然撑满，
        内部的 * 行 / * 列才能吸收多余空间。（与 CommunicationSettingsView 同一范式）
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1180" />
            <Setter Property="Height" Value="720" />
            <Setter Property="MinWidth" Value="1040" />
            <Setter Property="MinHeight" Value="620" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--
        ============================================================================
        相机设置（方案级相机资源管理）
        ============================================================================

        布局：左侧相机列表（增删） + 右侧选中相机的详情与操作，一屏放下。
        皮肤全部来自 UI/Controls/Themes/DialogStyles.xaml（青蓝设计系统），
        本视图不写任何颜色字面量，色值一律走 Colors.xaml 的 Dialog* 令牌。

        一条硬要求：溢出必须看得见。丢帧 = 漏检工件，所以"溢出丢帧"与"其它丢弃"
        分成两个数字显示，且溢出 > 0 时右侧弹出整块红色告警（见下方 Overflow 区）。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,20,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ 左：相机列表 + 添加表单  ============  -->
            <Grid Grid.Column="0">
                <Border Style="{StaticResource DialogCardShadow}" />
                <Border Style="{StaticResource DialogCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  卡片标题 + 添加按钮  -->
                        <Grid Grid.Row="0" Margin="14,12,14,8">
                            <TextBlock
                                HorizontalAlignment="Left"
                                Style="{StaticResource DialogCardTitle}"
                                Text="相机列表" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource DialogGhostButton}"
                                ToolTip="选择驱动类型并填写序列号，新建一台相机">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource DialogIconFont}"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogAccentBrush}"
                                        Text="&#xf067;" />
                                    <TextBlock VerticalAlignment="Center" Text="添加相机" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--
                            内联添加表单：驱动类型 + 序列号 + 显示名。
                            序列号的校验（非空 + 唯一）放在 ViewModel 里，校验不过阻止添加并给中文原因——
                            序列号是客户端寻址键，重复会让"A 相机的图跑到 B 流程"，界面必须提前拦。
                        -->
                        <Border
                            Grid.Row="1"
                            Margin="12,0,12,10"
                            Padding="12"
                            Background="{StaticResource DialogAccentSoftBrush}"
                            CornerRadius="10"
                            Visibility="{Binding IsAdding, Converter={ui:BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DialogFormLabel}" Text="驱动类型" />
                                <ComboBox
                                    ItemsSource="{Binding AvailableDrivers}"
                                    SelectedItem="{Binding NewDriver}"
                                    Style="{StaticResource DialogComboInGroup}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding Description}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock
                                    Margin="0,10,0,6"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="序列号（客户端寻址键，必须唯一）" />
                                <TextBox
                                    Style="{StaticResource DialogInputInGroup}"
                                    Text="{Binding NewSerial, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Margin="0,10,0,6"
                                    Style="{StaticResource DialogFormLabel}"
                                    Text="显示名（留空则用序列号）" />
                                <TextBox
                                    Style="{StaticResource DialogInputInGroup}"
                                    Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <Button
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Command="{Binding CancelAddCommand}"
                                        Content="取消"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                    <Button
                                        Height="34"
                                        MinWidth="88"
                                        Command="{Binding ConfirmAddCommand}"
                                        Content="添加"
                                        Style="{StaticResource DialogPrimaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  相机列表：一行显示 显示名 / 序列号 / 驱动 / 状态胶囊  -->
                        <Grid Grid.Row="2" Margin="1">
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                ItemsSource="{Binding Cameras}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedCamera}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="6,2" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border
                                                        x:Name="Bg"
                                                        Padding="10,8"
                                                        Background="Transparent"
                                                        CornerRadius="8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock
                                                    FontSize="13.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding SerialNo, StringFormat='序列号 {0}'}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                                    Text="{Binding DriverDisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource DialogRowHoverBrush}"
                                                CornerRadius="10">
                                                <TextBlock FontSize="11" Text="{Binding StateText}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--  空状态：一台相机都没有 → 引导添加  -->
                            <StackPanel
                                MaxWidth="300"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={ui:BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf030;" />
                                <TextBlock Style="{StaticResource DialogEmptyStateTitle}" Text="还没有添加相机" />
                                <TextBlock Style="{StaticResource DialogEmptyStateHint}" Text="点击上方「添加相机」，选择驱动并填写序列号。相机会随当前方案一起保存。" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!--  ============ 右：选中相机的详情与操作  ============  -->
            <Grid Grid.Column="2">
                <!--  未选中时的占位提示  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogEmptyStateTitle}"
                    Text="请从左侧选择一台相机查看详情与操作"
                    Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}}">
                    <StackPanel Margin="0,0,4,0">

                        <!--  标题 + 操作按钮  -->
                        <Border Padding="16" Style="{StaticResource DialogCardBorder}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding SelectedCamera.DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="序列号：" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12.5"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedCamera.SerialNo}" />
                                    <TextBlock
                                        Margin="16,0,0,0"
                                        FontSize="12.5"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="驱动：" />
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedCamera.DriverDisplayName}" />
                                </StackPanel>

                                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                    <!--  连接 / 断开：文案随状态切换  -->
                                    <Button
                                        Height="36"
                                        MinWidth="96"
                                        Command="{Binding ToggleConnectCommand}"
                                        Style="{StaticResource DialogSecondaryButton}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="连接" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCamera.State}" Value="Connecting">
                                                            <Setter Property="Text" Value="断开" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedCamera.State}" Value="Online">
                                                            <Setter Property="Text" Value="断开" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedCamera.State}" Value="Streaming">
                                                            <Setter Property="Text" Value="断开" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!--  开始 / 停止采流：文案随状态切换  -->
                                    <Button
                                        Height="36"
                                        MinWidth="110"
                                        Margin="8,0,0,0"
                                        Command="{Binding ToggleStreamCommand}"
                                        Style="{StaticResource DialogSecondaryButton}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="开始采流" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCamera.State}" Value="Streaming">
                                                            <Setter Property="Text" Value="停止采流" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <Button
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Command="{Binding ResetCountersCommand}"
                                        Content="清零计数"
                                        Style="{StaticResource DialogSecondaryButton}" />

                                    <Button
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Command="{Binding DeleteCommand}"
                                        CommandParameter="{Binding SelectedCamera}"
                                        Content="删除相机"
                                        Foreground="{StaticResource DialogDangerBrush}"
                                        Style="{StaticResource DialogSecondaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  运行状态与计数  -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="16"
                            Style="{StaticResource DialogCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DialogCardTitle}" Text="运行状态" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,10,8"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="状态" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="0,0,20,8"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedCamera.StateText}" />

                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="0,0,10,8"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="已收帧" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Margin="0,0,0,8"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedCamera.ReceivedFrameCount}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,10,8"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="待消费" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,0,20,8"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedCamera.PendingFrameCount}" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,10,8"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="溢出丢帧" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="3"
                                        Margin="0,0,0,8"
                                        FontFamily="Consolas"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DialogDangerBrush}"
                                        Text="{Binding SelectedCamera.OverflowCount}" />

                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="4"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="{Binding SelectedCamera.StateDetail}"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <!--  其它丢弃：与"溢出丢帧"分开显示（掉线清空队列 vs 队列满丢最旧，根因不同）  -->
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="其它丢弃（掉线清空队列等）：" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedCamera.DroppedFrameCount}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  溢出告警（丢帧 = 漏检工件）  -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="14,12"
                            Background="#FDECEC"
                            BorderBrush="{StaticResource DialogDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding SelectedCamera.HasOverflow, Converter={ui:BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Top"
                                    FontFamily="{StaticResource DialogIconFont}"
                                    FontSize="16"
                                    Foreground="{StaticResource DialogDangerBrush}"
                                    Text="&#xf071;" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock
                                        FontSize="13.5"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource DialogDangerBrush}"
                                        Text="丢帧 = 漏检工件" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12.5"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding SelectedCamera.OverflowWarning}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  网络相机提示  -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="16"
                            Style="{StaticResource DialogCardBorder}"
                            Visibility="{Binding IsNetworkCamera, Converter={ui:BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DialogCardTitle}" Text="网络相机接入说明" />

                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12.5"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="客户端应把帧推送到下面的地址（Authorization: Bearer 令牌），并每秒发一次心跳；心跳停 3 秒会被判掉线。"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="推帧地址" />
                                <TextBox
                                    IsReadOnly="True"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding NetworkFrameUrl, Mode=OneWay}" />

                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="心跳地址（POST，无 body）" />
                                <TextBox
                                    IsReadOnly="True"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding NetworkHeartbeatUrl, Mode=OneWay}" />

                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                                        Text="访问令牌：" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding NetworkTokenText}" />
                                </StackPanel>

                                <Border
                                    Margin="0,10,0,0"
                                    Padding="10,8"
                                    Background="{StaticResource DialogRowHoverBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                                        Text="{Binding NetworkListeningText}"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!--  采集参数  -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="16"
                            Style="{StaticResource DialogCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DialogCardTitle}" Text="采集参数" />

                                <!--
                                    网络相机的曝光 / 增益 / 触发模式由客户端决定，软件侧设了不生效。
                                    这一行必须写在参数区顶部，否则用户会以为设了就有用，白查半天。
                                -->
                                <Border
                                    Margin="0,10,0,0"
                                    Padding="10,8"
                                    Background="#FFF4E5"
                                    CornerRadius="8"
                                    Visibility="{Binding IsNetworkCamera, Converter={ui:BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{StaticResource DialogWarningTextBrush}"
                                        Text="注意：网络相机的曝光 / 增益 / 触发模式由客户端决定，在此设置不会生效（仅记录在配置里）。下面三项 FrameTimeoutMs / BufferCapacity / HeartbeatTimeoutMs 是真实生效的。"
                                        TextWrapping="Wrap" />
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  曝光  -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{StaticResource DialogFormLabel}" Text="曝光时间（微秒）" />
                                        <TextBox Style="{StaticResource DialogInput}" Text="{Binding ExposureTimeUs}" />
                                    </StackPanel>

                                    <!--  增益  -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Style="{StaticResource DialogFormLabel}" Text="增益" />
                                        <TextBox Style="{StaticResource DialogInput}" Text="{Binding Gain}" />
                                    </StackPanel>

                                    <!--  触发模式  -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource DialogFormLabel}" Text="触发模式" />
                                        <ComboBox
                                            ItemsSource="{Binding TriggerModeOptions}"
                                            SelectedValue="{Binding TriggerMode}"
                                            SelectedValuePath="Value"
                                            Style="{StaticResource DialogCombo}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Display}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!--  取图超时  -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource DialogFormLabel}" Text="取图超时（毫秒）" />
                                        <TextBox Style="{StaticResource DialogInput}" Text="{Binding FrameTimeoutMs}" />
                                    </StackPanel>

                                    <!--  队列容量  -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource DialogFormLabel}" Text="队列容量（帧）" />
                                        <TextBox Style="{StaticResource DialogInput}" Text="{Binding BufferCapacity}" />
                                    </StackPanel>

                                    <!--  心跳超时  -->
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource DialogFormLabel}" Text="心跳超时（毫秒）" />
                                        <TextBox Style="{StaticResource DialogInput}" Text="{Binding HeartbeatTimeoutMs}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel
                                    Margin="0,14,0,0"
                                    Orientation="Horizontal">
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        Content="方案加载后自动连接该相机"
                                        IsChecked="{Binding AutoConnect}" />
                                    <Button
                                        Height="36"
                                        MinWidth="110"
                                        Margin="16,0,0,0"
                                        Command="{Binding ApplySettingsCommand}"
                                        Content="应用参数"
                                        Style="{StaticResource DialogPrimaryButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  预览  -->
                        <Border
                            Margin="0,12,0,0"
                            Padding="16"
                            Style="{StaticResource DialogCardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource DialogCardTitle}" Text="预览（只读最新帧，不消费生产帧）" />

                                <Border
                                    Margin="0,10,0,0"
                                    MinHeight="200"
                                    Background="{StaticResource DialogInputBackgroundBrush}"
                                    CornerRadius="8">
                                    <Grid>
                                        <Image
                                            MaxHeight="260"
                                            Margin="4"
                                            Source="{Binding PreviewImage}"
                                            Stretch="Uniform" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12.5"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="等待图像（连接并开始采流后，客户端推来的最新一帧会显示在这里）"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasPreviewImage, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Height="4" Background="Transparent" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  ============ 底栏  ============  -->
        <Border
            Grid.Row="1"
            Margin="0,14,0,0"
            Padding="24,12"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{StaticResource DialogTextMutedBrush}"
                    Text="相机配置属于当前方案，增删改后请保存方案（文件 → 保存）以长期生效。" />

                <Button
                    Grid.Column="1"
                    Width="96"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Content="关 闭"
                    Style="{StaticResource DialogPrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
