<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaUserManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.UI.com/ui"
    mc:Ignorable="d">

    <!--  ==========================================  -->
    <!--  「用户管理 · 账号与用户组」页签内容（v4）  -->
    <!--  左：搜索 + 账号清单 + 新建；右：账号表单 + 安全策略摘要。  -->
    <!--  外壳（标题栏 / 页签 / 底栏 / 关闭）归 UserManagementView，本视图只是页签内容。  -->
    <!--  界面灰掉只是"界面门"，真正的拒绝在 ViewModel 的 EnsureAdmin。  -->
    <!--  ==========================================  -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!--  就地合并：断言宿主用真实例化证明令牌与样式可解析（R22）  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Controls/GridView.xaml" />
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
            </Style>

            <Style x:Key="FieldHintStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource DialogTextTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ReadOnlyFieldStyle" TargetType="Border">
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="{StaticResource DialogRowAlternateBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DialogCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <!--  账号行：52 高、整行可点；选中态与表格行同一套浅蓝  -->
            <Style x:Key="AccountRowStyle" TargetType="ListViewItem">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border
                                x:Name="RowBorder"
                                Padding="8,0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ================= 左：账号清单 =================  -->
        <Border Grid.Column="0" Style="{StaticResource DialogColumnCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="14,0">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                            Text="账号" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                            Text="{Binding UserCountText}" />
                    </StackPanel>
                    <Button
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding NewUserCommand}"
                        Content="＋ 新建"
                        FocusVisualStyle="{StaticResource DialogFocusVisual}"
                        Style="{StaticResource DialogLinkButton}" />
                </Grid>

                <!--  搜索：外框 + 放大镜 + 无边框输入 + 占位文字（IsHitTestVisible=False）  -->
                <Border
                    Grid.Row="1"
                    Height="34"
                    Margin="14,0,14,10"
                    Style="{StaticResource DialogSearchChrome}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DialogSearchIcon}" Text="&#xf002;" />
                        <TextBox
                            Grid.Column="1"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource DialogSearchInput}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            IsHitTestVisible="False"
                            Text="搜索账号名">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="8,0,8,8">
                    <ListView
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource AccountRowStyle}"
                        ItemsSource="{Binding Users}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem="{Binding SelectedUser}"
                        SelectionMode="Single"
                        Style="{StaticResource GridListViewStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="30"
                                        Height="30"
                                        Background="{StaticResource DialogAccentLightBrush}"
                                        CornerRadius="15">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Text="{Binding Initial}" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="10,0,8,0"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Name}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                                            Text="{Binding GroupText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding GroupText}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource DialogAccentSoftBrush}"
                                        BorderBrush="{StaticResource DialogAccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{Binding IsCurrent, Converter={ui:BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource DialogAccentTextBrush}"
                                            Text="当前" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="{Binding EmptyText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasUsers, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                </Grid>

                <Border
                    Grid.Row="3"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        Margin="14,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding StorePath}">
                        <Run Text="账号文件：" /><Run Text="{Binding StoreFileName, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!--  ================= 右：账号表单 =================  -->
        <Border
            Grid.Column="2"
            Padding="20,20,20,0"
            Style="{StaticResource DialogColumnCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding HeaderText}" />
                    <Border
                        Margin="10,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{StaticResource DialogAccentSoftBrush}"
                        BorderBrush="{StaticResource DialogAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource DialogAccentTextBrush}"
                            Text="{Binding SelectedGroupName}" />
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  用户名  -->
                    <StackPanel Grid.Row="0" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                        <TextBox
                            Height="36"
                            Margin="0,6,0,0"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource DialogInput}"
                            Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IsNewMode, Converter={ui:BooleanToVisibilityConverter}}" />
                        <Border
                            Margin="0,6,0,0"
                            Style="{StaticResource ReadOnlyFieldStyle}"
                            ToolTip="账号名不可修改。要改名请先删除该账号，再新建一个。"
                            Visibility="{Binding IsNewMode, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource DialogTextTertiaryBrush}"
                                Text="{Binding EditName}"
                                TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="账号名不可修改。要改名请先删除该账号，再新建一个。" />
                    </StackPanel>

                    <!--  用户组 + 管理用户组…  -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="用户组" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Height="36"
                                DisplayMemberPath="Text"
                                ItemsSource="{Binding GroupOptions}"
                                SelectedValue="{Binding EditGroupId, Mode=TwoWay}"
                                SelectedValuePath="GroupId"
                                Style="{StaticResource DialogCombo}" />
                            <Button
                                Grid.Column="1"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="12,0"
                                Command="{Binding OpenGroupEditorCommand}"
                                Content="管理用户组…"
                                FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                Style="{StaticResource DialogSecondaryButton}" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="权限按组分配：组内勾选的权限决定该组用户能做什么。" />
                    </StackPanel>

                    <!--  新密码 / 确认密码  -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="新密码" />
                                <PasswordBox
                                    Height="36"
                                    Margin="0,6,0,0"
                                    ui:PasswordBoxHelper.BindablePassword="{Binding EditPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="确认密码" />
                                <PasswordBox
                                    Height="36"
                                    Margin="0,6,0,0"
                                    ui:PasswordBoxHelper.BindablePassword="{Binding EditPasswordConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding PasswordHint}" />
                    </StackPanel>

                    <!--  只读策略提示  -->
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                            Text="当前登录账号与最后一个管理员不可删除；删除需二次确认。" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                            Text="保存失败会整体回滚，并给出具体原因。" />
                    </StackPanel>

                    <!--  结果提示：固定高度，长句不会把按钮顶下去  -->
                    <TextBlock
                        Grid.Row="4"
                        Margin="0,12,0,0"
                        VerticalAlignment="Bottom"
                        FontSize="11"
                        Text="{Binding Message}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource DialogDangerTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  操作行：左删除、右放弃修改 / 保存  -->
                    <Border
                        Grid.Row="5"
                        Margin="0,0,0,14"
                        Padding="0,14,0,0"
                        BorderBrush="{StaticResource DialogBorderLightBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid HorizontalAlignment="Left" IsEnabled="{Binding IsAdmin}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Button
                                    Command="{Binding DeleteCommand}"
                                    Content="删除账号"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource DialogDangerOutlineButton}" TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfirmingDelete}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Command="{Binding DeleteCommand}"
                                    Content="确认删除"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource DialogDangerButton}" TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfirmingDelete}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <StackPanel
                                HorizontalAlignment="Right"
                                IsEnabled="{Binding IsAdmin}"
                                Orientation="Horizontal">
                                <Button
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Padding="14,0"
                                    Command="{Binding CancelNewCommand}"
                                    Content="放弃修改"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                    Style="{StaticResource DialogSecondaryButton}"
                                    ToolTip="放弃未保存的修改，恢复成当前选中账号的内容" />
                                <Button
                                    Height="34"
                                    Padding="20,0"
                                    Command="{Binding SaveCommand}"
                                    Content="保存用户组"
                                    FocusVisualStyle="{StaticResource DialogFocusVisual}"
                                    Style="{StaticResource DialogPrimaryButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  安全策略摘要：只读，数字来自当前配置  -->
                <Border
                    Grid.Row="2"
                    Margin="0,0,-20,0"
                    Padding="20,11"
                    Background="{StaticResource DialogRowAlternateBrush}"
                    BorderBrush="{StaticResource DialogBorderLightBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                            Text="{Binding PolicySummary}" />
                        <Button
                            Height="22"
                            Margin="8,0,0,0"
                            Command="{Binding OpenSecuritySettingsCommand}"
                            Content="在系统设置中修改"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            Style="{StaticResource DialogLinkButton}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
