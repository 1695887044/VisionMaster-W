<UserControl
    x:Class="VisionMaster.Views.DialogViews.CommunicationSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prism="http://prismlibrary.com/"
    Width="1080"
    Height="620"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F7F9FC">

    <UserControl.Resources>
        <!--  工具栏搜索框  -->
        <Style x:Key="SearchBoxBorder" TargetType="Border">
            <Setter Property="Background" Value="#F2F5FA" />
            <Setter Property="BorderBrush" Value="#E2E8F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--  添加设备按钮  -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Background" Value="#17A2F2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Padding="20,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Icon}"
                                    FontSize="13"
                                    Text="&#xf067;" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  行内图标按钮  -->
        <Style x:Key="RowIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Width="28"
                            Height="28"
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Background" Value="#F0F4FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  状态胶囊  -->
        <DataTemplate x:Key="StatusPillTemplate">
            <Border
                Padding="10,3"
                HorizontalAlignment="Left"
                Background="#E8F5E9"
                CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EDF1F7" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Connected">
                                <Setter Property="Background" Value="#E8F5E9" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Error">
                                <Setter Property="Background" Value="#FDECEC" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Connecting">
                                <Setter Property="Background" Value="#FFF4E5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#98A2B3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Connected">
                                        <Setter Property="Fill" Value="#2FBF71" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Fill" Value="#E5484D" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Connecting">
                                        <Setter Property="Fill" Value="#F5A524" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="离线" />
                                <Setter Property="Foreground" Value="#667085" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Connected">
                                        <Setter Property="Text" Value="在线" />
                                        <Setter Property="Foreground" Value="#2FBF71" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Text" Value="错误" />
                                        <Setter Property="Foreground" Value="#E5484D" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Connecting">
                                        <Setter Property="Text" Value="连接中" />
                                        <Setter Property="Foreground" Value="#F5A524" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  DataGrid 系列  -->
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFD" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0F6FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="56" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F3F8" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#8A94A6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#EEF1F6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ 工具栏：搜索 + 状态筛选 + 添加  ============ -->
        <Border
            Grid.Row="0"
            Margin="24,20,24,12"
            Background="White"
            BorderBrush="#E9EEF5"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.05"
                    ShadowDepth="2" />
            </Border.Effect>
            <Grid Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  搜索框  -->
                <Border Grid.Column="0" Style="{StaticResource SearchBoxBorder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="13"
                            Foreground="#9AA5B5"
                            Text="&#xf002;" />
                        <TextBox
                            Height="38"
                            Padding="10,0"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="13"
                            Foreground="#303133"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="CaretBrush" Value="#17A2F2" />
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock
                            Margin="4,0,12,0"
                            VerticalAlignment="Center"
                            FontSize="12.5"
                            Foreground="#9AA5B5"
                            Text="按设备名称 / IP / 通讯类型搜索" />
                    </StackPanel>
                </Border>

                <!--  状态筛选  -->
                <ComboBox
                    Grid.Column="2"
                    Height="40"
                    Padding="12,0"
                    VerticalContentAlignment="Center"
                    Background="#F2F5FA"
                    BorderBrush="#E2E8F2"
                    FontSize="13"
                    Foreground="#303133"
                    ItemsSource="{Binding StatusFilters}"
                    SelectedItem="{Binding StatusFilter}" />

                <!--  添加按钮  -->
                <Button
                    Grid.Column="3"
                    MinWidth="130"
                    Height="40"
                    Command="{Binding AddCommand}"
                    Content="添加设备"
                    Style="{StaticResource AddButton}" />
            </Grid>
        </Border>

        <!--  ============ 设备表格  ============ -->
        <Border
            Grid.Row="1"
            Margin="24,0,24,0"
            Background="White"
            BorderBrush="#E9EEF5"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.05"
                    ShadowDepth="2" />
            </Border.Effect>
            <DataGrid
                Margin="1"
                ItemsSource="{Binding Configs}"
                SelectedItem="{Binding SelectedConfig}">
                <DataGrid.Columns>
                    <!--  设备名称  -->
                    <DataGridTemplateColumn Width="1.2*" Header="设备名称">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#1D2939"
                                    Text="{Binding ConnectionName}"
                                    ToolTip="{Binding Description}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  通讯类型  -->
                    <DataGridTemplateColumn Width="110" Header="通讯类型">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#475467"
                                    Text="{Binding Protocol}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  IP : 端口（串口协议显示 COM 口）  -->
                    <DataGridTemplateColumn Width="1.3*" Header="IP : 端口">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="#475467"
                                    Text="{Binding Config}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  轮询周期  -->
                    <DataGridTemplateColumn Width="90" Header="轮询">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="12.5"
                                    Foreground="#475467"
                                    Text="{Binding ReadCycleMs, StringFormat={}{0} ms}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  状态胶囊  -->
                    <DataGridTemplateColumn
                        Width="110"
                        Header="状态"
                        IsReadOnly="True"
                        CellTemplate="{StaticResource StatusPillTemplate}" />

                    <!--  最后更新  -->
                    <DataGridTemplateColumn Width="1.1*" Header="最后连接">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="#8A94A6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding LastConnectedTime, StringFormat='yyyy/M/d HH:mm:ss'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastConnectedTime}" Value="{x:Static sys:DateTime.MinValue}">
                                                    <Setter Property="Text" Value="—" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  操作：连接/断开 + 测试 + 删除（图标化）  -->
                    <DataGridTemplateColumn Width="150" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!--  连接 / 断开  -->
                                    <Button Command="{Binding DataContext.ToggleConnectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RowIconButton}" TargetType="Button">
                                                <Setter Property="ToolTip" Value="连接" />
                                                <Setter Property="Foreground" Value="#17A2F2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Connected">
                                                        <Setter Property="ToolTip" Value="断开" />
                                                        <Setter Property="Foreground" Value="#E5484D" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock FontFamily="{StaticResource Icon}" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xf0c1;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Connected">
                                                            <Setter Property="Text" Value="&#xf127;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!--  连通测试  -->
                                    <Button
                                        Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Foreground="#12B76A"
                                        Style="{StaticResource RowIconButton}"
                                        ToolTip="连通测试">
                                        <TextBlock
                                            FontFamily="{StaticResource Icon}"
                                            FontSize="14"
                                            Text="&#xf012;" />
                                    </Button>

                                    <!--  编辑参数  -->
                                    <Button
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Foreground="#667085"
                                        Style="{StaticResource RowIconButton}"
                                        ToolTip="编辑参数">
                                        <TextBlock
                                            FontFamily="{StaticResource Icon}"
                                            FontSize="14"
                                            Text="&#xf044;" />
                                    </Button>

                                    <!--  删除  -->
                                    <Button
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Foreground="#E5484D"
                                        Style="{StaticResource RowIconButton}"
                                        ToolTip="删除">
                                        <TextBlock
                                            FontFamily="{StaticResource Icon}"
                                            FontSize="14"
                                            Text="&#xf1f8;" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!--  ============ 底部  ============ -->
        <Border
            Grid.Row="2"
            Padding="24,14"
            BorderBrush="#E9EEF5"
            BorderThickness="0,1,0,0">
            <Button
                Width="96"
                Height="36"
                HorizontalAlignment="Right"
                Background="#17A2F2"
                BorderThickness="0"
                Command="{Binding CloseCommand}"
                Content="确 定"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</UserControl>
