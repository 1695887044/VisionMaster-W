<UserControl
    x:Class="VisionMaster.Views.DialogViews.CommunicationSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource DialogBackgroundBrush}">

    <!--
        窗口尺寸挂在 Window 上，不写在 UserControl 根节点上。
        UserControl 的 HorizontalAlignment 默认是 Stretch（撑满父容器），
        但一旦显式写了 Width，Stretch 就退化成"居中"——窗口一拉大/最大化，
        内容块就居中缩在中间、四周一圈留白，而且永远不跟着窗口变宽。
        搬到 Window 后 UserControl 自然撑满，内部 * 行 / * 列才能吸收多余空间。
        刻意不用 SizeToContent：它会让窗口随内容自己改大小，且手动放大后内容不重排。
        （与 PluginConfigShellView 同一范式；区别是这里保留系统标题栏，不设 WindowStyle=None）
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1080" />
            <Setter Property="Height" Value="620" />
            <Setter Property="MinWidth" Value="960" />
            <Setter Property="MinHeight" Value="520" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--
        ============================================================================
        通讯设置（连接管理）
        ============================================================================

        本视图不再自带任何颜色字面量与本地样式：皮肤全部来自
        UI/Controls/Themes/DialogStyles.xaml（青蓝设计系统），
        色值全部来自 Colors.xaml 的 Dialog* 令牌。
        老版本这里硬编码了 26 处颜色（#17A2F2 / #8A94A6 / #E9EEF5 …），
        其中 #17A2F2 与变量管理弹窗的 #0EA5E9 并不是同一个蓝 —— 同屏切换会明显"跳色"。

        三段式布局：工具栏（搜索 / 状态筛选 / 添加）→ 设备表格 → 底栏（批量操作 + 确定）。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ 工具栏：搜索 + 状态筛选 + 添加设备  ============  -->
        <Grid Grid.Row="0" Margin="24,20,24,14">
            <!--  投影层与内容层分离：投影不挂在承载文字的 Border 上，否则文字会失去 ClearType 变糊  -->
            <Border Style="{StaticResource DialogCardShadow}" />
            <Border Style="{StaticResource DialogCardBorder}">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        搜索框：外层 Border 画框 + 放大镜，内层 TextBox 完全透明撑满 * 列。
                        占位提示靠 Tag 传进 TextBox 自己的模板里，输入后自动消失。
                        老写法把提示做成"旁边一个常驻 TextBlock"，用户一输入就出现
                        "提示和内容并排"的鬼影，而且 TextBox 塞在横向 StackPanel 里宽度不受控。
                    -->
                    <Border
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource DialogSearchChrome}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource DialogSearchIcon}"
                                Text="&#xf002;" />
                            <TextBox
                                Grid.Column="1"
                                Style="{StaticResource DialogSearchInput}"
                                Tag="按设备名称 / IP / 通讯类型搜索"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <!--  状态筛选：DialogCombo 把整框做成热区，点框内任意位置都能展开  -->
                    <ComboBox
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding StatusFilters}"
                        SelectedItem="{Binding StatusFilter}"
                        Style="{StaticResource DialogCombo}" />

                    <Button
                        Grid.Column="4"
                        Height="38"
                        MinWidth="128"
                        VerticalAlignment="Center"
                        Command="{Binding AddCommand}"
                        Style="{StaticResource DialogPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="13"
                                Text="&#xf067;" />
                            <TextBlock VerticalAlignment="Center" Text="添加设备" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!--  ============ 设备表格  ============  -->
        <Grid Grid.Row="1" Margin="24,0,24,0">
            <Border Style="{StaticResource DialogCardShadow}" />
            <Border Style="{StaticResource DialogCardBorder}">
                <Grid Margin="1">
                    <DataGrid
                        ItemsSource="{Binding Configs}"
                        RowHeight="48"
                        SelectedItem="{Binding SelectedConfig}"
                        SelectionMode="Extended"
                        Style="{StaticResource DialogDataGrid}"
                        ui:DataGridSelectionBehavior.BindableSelectedItems="{Binding SelectedConfigs, Mode=OneWay}">
                        <!--
                            Mode=OneWay 是刻意写死的，不要删：
                            SelectedConfigs 在 VM 里是只读属性（{ get; } = new()），
                            该附加属性只把绑定当"入口"读一次，回写走的是集合自身的事件，
                            写成双向会被 WPF 判为"对只读属性做 TwoWay 绑定"而抛 XamlParseException，
                            导致整张弹窗解析失败打不开。
                        -->
                        <DataGrid.Columns>
                            <!--  设备名称  -->
                            <DataGridTemplateColumn Width="1.2*" Header="设备名称">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="13.5"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding ConnectionName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Description}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  通讯类型  -->
                            <DataGridTemplateColumn Width="110" Header="通讯类型">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12.5"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="{Binding Protocol}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  IP : 端口（串口协议显示 COM 口）  -->
                            <DataGridTemplateColumn Width="1.3*" Header="IP : 端口">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="12.5"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="{Binding Config}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  轮询周期：默认组周期，有自定义扫描组时追加「+N 组」  -->
                            <DataGridTemplateColumn Width="140" Header="轮询">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="{Binding PollHint}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--
                                状态胶囊：模板在 DialogStyles.xaml。
                                颜色对齐全项目语义色；最近一次错误不为空时胶囊右侧追加 ⚠ 并把
                                错误详情挂在 ToolTip 上（状态列只有 110px，塞不下一整列错误详情）。
                            -->
                            <DataGridTemplateColumn
                                Width="110"
                                Header="状态"
                                IsReadOnly="True"
                                CellTemplate="{StaticResource DialogStatusPillTemplate}" />

                            <!--  最后连接  -->
                            <DataGridTemplateColumn Width="1.1*" Header="最后连接">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource DialogTextMutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding LastConnectedTime, StringFormat='yyyy/M/d HH:mm:ss'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LastConnectedTime}" Value="{x:Static sys:DateTime.MinValue}">
                                                            <Setter Property="Text" Value="—" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  操作：连接/断开 + 测试 + 扫描组 + 编辑 + 删除（图标化）  -->
                            <DataGridTemplateColumn Width="190" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Margin="0,0,12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <!--  连接 / 断开  -->
                                            <Button Command="{Binding DataContext.ToggleConnectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource DialogIconButton}" TargetType="Button">
                                                        <Setter Property="ToolTip" Value="连接" />
                                                        <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Connected">
                                                                <Setter Property="ToolTip" Value="断开" />
                                                                <Setter Property="Foreground" Value="{StaticResource DialogDangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock FontFamily="{StaticResource Icon}" FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xf0c1;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Connected">
                                                                    <Setter Property="Text" Value="&#xf127;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>

                                            <!--  连通测试  -->
                                            <Button
                                                Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource DialogSuccessBrush}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="连通测试">
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="14"
                                                    Text="&#xf012;" />
                                            </Button>

                                            <!--  编辑参数  -->
                                            <Button
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="编辑参数">
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="14"
                                                    Text="&#xf044;" />
                                            </Button>

                                            <!--  扫描组：编辑这条连接的周期分组表  -->
                                            <Button
                                                Command="{Binding DataContext.EditScanGroupsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource DialogAccentBrush}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="扫描组">
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="14"
                                                    Text="&#xf5fd;" />
                                            </Button>

                                            <!--  删除  -->
                                            <Button
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource DialogDangerBrush}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="删除">
                                                <TextBlock
                                                    FontFamily="{StaticResource Icon}"
                                                    FontSize="14"
                                                    Text="&#xf1f8;" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--
                        ============ 空状态 ============
                        两种空状态必须分开，语义完全不同：
                          IsEmpty         真的一条连接都没有 → 引导"添加设备"
                          IsFilteredEmpty 有连接但被搜索/状态筛选挡光了 → 引导"换个条件"
                        若混成一句"还没有添加设备"，明明有 20 条连接的用户会以为数据丢了，
                        转头重新录一遍。
                        遮罩从表头下方开始（Margin 0,42,0,0），保留列名可见 —— 用户能看出
                        "表还在，只是这次没筛出东西"。
                    -->
                    <Border
                        Margin="0,42,0,0"
                        Background="{StaticResource DialogSurfaceBrush}"
                        CornerRadius="0,0,11,11"
                        Visibility="{Binding IsEmpty, Converter={ui:BooleanToVisibilityConverter}}">
                        <StackPanel
                            MaxWidth="420"
                            VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf0c1;" />
                            <TextBlock Style="{StaticResource DialogEmptyStateTitle}" Text="还没有添加任何设备" />
                            <TextBlock Style="{StaticResource DialogEmptyStateHint}" Text="点击右上角「添加设备」建立第一条连接，之后就能往这条连接里添加要采集的变量了。" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,42,0,0"
                        Background="{StaticResource DialogSurfaceBrush}"
                        CornerRadius="0,0,11,11"
                        Visibility="{Binding IsFilteredEmpty, Converter={ui:BooleanToVisibilityConverter}}">
                        <StackPanel
                            MaxWidth="460"
                            VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf002;" />
                            <TextBlock Style="{StaticResource DialogEmptyStateTitle}" Text="没有符合条件的连接" />
                            <TextBlock
                                Style="{StaticResource DialogEmptyStateHint}"
                                Text="{Binding Configs.Count, StringFormat='当前共有 {0} 条连接，只是被搜索或状态筛选挡住了。换个关键词，或把状态切回「全部状态」。'}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  ============ 底栏：批量操作 + 确定  ============  -->
        <Border
            Grid.Row="2"
            Margin="0,14,0,0"
            Padding="24,12"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  选中态文案：有选中显示计数，没选中显示多选操作提示，两者互斥  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogAccentTextBrush}"
                        Text="{Binding SelectedCount, StringFormat='已选 {0} 项'}"
                        Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="按住 Ctrl / Shift 可多选，再批量操作"
                        Visibility="{Binding HasSelection, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <Border
                        Width="1"
                        Height="16"
                        Margin="12,0"
                        Background="{StaticResource DialogBorderBrush}" />

                    <!--  选择类：全选 / 清空（作用于当前筛选结果）  -->
                    <Button Command="{Binding SelectAllCommand}" Style="{StaticResource DialogGhostButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="&#xf14a;" />
                            <TextBlock VerticalAlignment="Center" Text="全选" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding ClearSelectionCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Style="{StaticResource DialogGhostButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="&#xf00d;" />
                            <TextBlock VerticalAlignment="Center" Text="清空" />
                        </StackPanel>
                    </Button>

                    <Border
                        Width="1"
                        Height="16"
                        Margin="12,0"
                        Background="{StaticResource DialogBorderBrush}" />

                    <!--  作用于"选中行"：没选就置灰，点不动  -->
                    <Button
                        Command="{Binding ConnectSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Style="{StaticResource DialogGhostButton}"
                        ToolTip="建立所选连接的常驻连接">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="{StaticResource DialogAccentBrush}"
                                Text="&#xf0c1;" />
                            <TextBlock VerticalAlignment="Center" Text="连接选中" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding DisconnectSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Style="{StaticResource DialogGhostButton}"
                        ToolTip="断开所选连接">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="{StaticResource DialogDangerBrush}"
                                Text="&#xf127;" />
                            <TextBlock VerticalAlignment="Center" Text="断开选中" />
                        </StackPanel>
                    </Button>

                    <Border
                        Width="1"
                        Height="16"
                        Margin="12,0"
                        Background="{StaticResource DialogBorderBrush}" />

                    <!--
                        作用于"当前筛选结果"（不是全部连接）：
                        用户先筛出「离线」再点「全部连接」，意图就是"把这些都连上"；
                        若作用于全部连接，会静默改动表格里根本没显示的连接。
                    -->
                    <Button
                        Command="{Binding ConnectAllCommand}"
                        Style="{StaticResource DialogGhostButton}"
                        ToolTip="连接当前筛选结果里的全部连接">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="{StaticResource DialogAccentBrush}"
                                Text="&#xf0e7;" />
                            <TextBlock VerticalAlignment="Center" Text="全部连接" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding DisconnectAllCommand}"
                        Style="{StaticResource DialogGhostButton}"
                        ToolTip="断开当前筛选结果里的全部连接">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Icon}"
                                FontSize="12"
                                Foreground="{StaticResource DialogDangerBrush}"
                                Text="&#xf011;" />
                            <TextBlock VerticalAlignment="Center" Text="全部断开" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Width="96"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Content="确 定"
                    Style="{StaticResource DialogPrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
