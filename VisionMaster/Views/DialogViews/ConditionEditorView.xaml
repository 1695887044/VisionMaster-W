<UserControl
    x:Class="VisionMaster.Views.DialogViews.ConditionEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    MinWidth="960"
    MinHeight="640"
    Background="{StaticResource DialogBackgroundBrush}"
    FontFamily="Microsoft YaHei"
    mc:Ignorable="d">

    <!--
        窗口尺寸挂在 Window 上，不写在 UserControl 根节点上（写在根上会因 Stretch 退化而居中留白）。
        刻意不用 SizeToContent：它会让窗口随内容改大小，且手动放大后内容不重排。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--
                WindowStyle=None：去掉系统原生标题栏，改由视图自绘（见下方标题栏）。
                与变量管理 / 相机设置 / 通讯设置 / 流程管理一致。
            -->
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1120" />
            <Setter Property="Height" Value="760" />
            <Setter Property="MinWidth" Value="960" />
            <Setter Property="MinHeight" Value="640" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--
        ============================================================================
        条件逻辑 / 计次循环 配置中心
        ============================================================================

        本轮是**按设计稿纯换皮**，不是重写逻辑。改动只落在视觉结构上：
          · 外框从"两行（标题 / 主体，底栏挤在右列里）"改成**三行**
            （标题 52 / 主体 * / 底栏 Auto）—— 底栏跨整宽、独立成行；
          · 分区标题由灰底横条（DialogColumnHeader）改扁平白底（DialogSectionHeader，仅下边线）；
          · 左栏分支卡 232 → 208；
          · 变量卡头部「+ 新增变量」改主色按钮，行内「重新绑定 / 删除」改图标按钮，
            变量为空时显示虚线空态框（DataTrigger 切 Visibility，无转换器）；
          · 快捷插入面板由"单条 WrapPanel + 竖分隔线"改为**按组分行的 5 组**。

        一行不动的（改动必须避开的地方）：
          · 所有命令与属性名（AddVariable / BindVariable / RemoveVariable /
            LinkLoopCount / UnlinkLoopCount / Cancel / Save、IsForMode、IsCaseMode、
            Branches、SelectedBranch、SelectedBranchNeedsExpression、Variables、
            LoopCountText、LoopCountSourceText、HasLoopCountLink、JudgeExpressionDraft…）；
          · AvalonEdit 的 x:Name="txtExpression" 与 TextChanged 事件（code-behind 靠它取文本）；
          · 每个快捷插入按钮的 Click="QuickInsert_Click" 与 Tag 的精确内容
            （Tag 就是要插进表达式的片段，写错一个字符等于插入一段错代码）。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            标题栏（自绘）。无边框窗口没有系统拖动区与关闭按钮：
            整条挂 ui:WindowDragBehavior 负责拖，右侧 × 绑 CancelCommand ——
            本弹窗是"草稿 → 校验 → 写回"事务，关闭即丢弃草稿，语义上就是取消，
            所以不另加 CloseCommand（加了反而两个入口语义分不清）。
            标题文字绑 VM.Title：它在 For / 条件两种模式下不同（For 循环配置 / 条件逻辑配置中心）。
        -->
        <Border
            Grid.Row="0"
            ui:WindowDragBehavior.IsWindowDraggable="True"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    FontSize="15"
                    Foreground="{StaticResource DialogAccentBrush}"
                    Text="&#xf121;" />

                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="编辑后点「保存并应用」才写回流程，取消或关闭即丢弃" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭（不保存本次修改）">
                    <TextBlock
                        FontFamily="{StaticResource Icon}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <!--  主体（两列：左分支卡 / 右变量 + 表达式）  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                左：分支列表（For 模式无分支可选 → 整栏收起）。
                条目样式改用公共的 DialogOptionItem（hover 浅灰 / 选中浅蓝 + 左侧指示条），
                不再本地写一套 ListBoxItem 模板。
                SelectedIndex="-1" 保留：进弹窗时不要自动选中第一项，
                否则用户还没操作就被带进某个分支的表达式。
            -->
            <Border
                Grid.Column="0"
                Width="208"
                Margin="20,16,0,16"
                Style="{StaticResource DialogColumnCard}"
                Visibility="{Binding IsForMode, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  分区标题：扁平白底 + 下边线（DialogSectionHeader），不再是灰底横条  -->
                    <Border Padding="12,0" Style="{StaticResource DialogSectionHeader}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource DialogColumnTitleIcon}"
                                Text="&#xf126;" />
                            <TextBlock Style="{StaticResource DialogColumnTitle}" Text="逻辑分支" />
                        </StackPanel>
                    </Border>

                    <ListBox
                        Grid.Row="1"
                        Margin="4"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource DialogOptionItem}"
                        ItemsSource="{Binding Branches}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedIndex="-1"
                        SelectedItem="{Binding SelectedBranch}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="6"
                                        Height="6"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center"
                                        Fill="{StaticResource DialogAccentBrush}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding StepName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!--  右：主控区  -->
            <Grid Grid.Column="1" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="1.2*"
                        MinHeight="150"
                        MaxHeight="400" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="2*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!--  1. 变量引脚定义区（For 模式隐藏）  -->
                <Border
                    Grid.Row="0"
                    Style="{StaticResource DialogColumnCard}"
                    Visibility="{Binding IsForMode, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="12,0" Style="{StaticResource DialogSectionHeader}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock
                                        Style="{StaticResource DialogColumnTitleIcon}"
                                        Text="&#xf0cb;" />
                                    <TextBlock Style="{StaticResource DialogColumnTitle}" Text="输入变量配置" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="表达式中用别名引用上游数据" />
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding AddVariableCommand}"
                                    Content="+ 新增变量"
                                    Style="{StaticResource DialogPrimaryButton}"
                                    ToolTip="新增一个引脚变量（别名 + 绑定的上游端口）" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <!--
                                表格与空态框叠在同一格，按 Variables.Count 互斥显示。
                                DataTrigger 直接判 Count（ObservableCollection 的 Count 会随增删通知），
                                不需要 BooleanToVisibilityConverter。
                            -->
                            <DataGrid
                                Margin="12"
                                CanUserAddRows="False"
                                ItemsSource="{Binding Variables}"
                                MinRowHeight="46"
                                RowHeaderWidth="0"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Style>
                                    <Style BasedOn="{StaticResource DialogDataGrid}" TargetType="DataGrid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Variables.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="150" Header="别名">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!--  ValidatesOnDataErrors 接通 VariableItem 的 IDataErrorInfo：打字即红框 + 悬停看原因  -->
                                                <TextBox
                                                    Style="{StaticResource DialogCellInput}"
                                                    Text="{Binding AliasName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                    ToolTip="表达式中引用它用的名字" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="*" Header="绑定的上游数据源">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                                        Text="{Binding SourceAddress, TargetNullValue='尚未绑定上游端口'}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <!--  重新绑定：文字按钮 → 图标按钮（链接图标），命令 / 参数 / 提示原样保留  -->
                                                    <Button
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Command="{Binding DataContext.BindVariableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DialogIconButton}"
                                                        ToolTip="重新选择这个别名绑定的上游输出端口">
                                                        <TextBlock
                                                            FontFamily="{StaticResource Icon}"
                                                            FontSize="12"
                                                            Foreground="{StaticResource DialogAccentBrush}"
                                                            Text="&#xf0c1;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="90" Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!--  删除：文字按钮 → 图标按钮（垃圾桶），命令 / 参数 / 提示原样保留  -->
                                                <Button
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.RemoveVariableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DialogIconButton}"
                                                    ToolTip="删除这个引脚变量">
                                                    <TextBlock
                                                        FontFamily="{StaticResource Icon}"
                                                        FontSize="12"
                                                        Foreground="{StaticResource DialogDangerBrush}"
                                                        Text="&#xf1f8;" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!--  空态：虚线框 + 居中提示（Variables.Count == 0 时出现）  -->
                            <Grid Margin="12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Variables.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle
                                    Fill="Transparent"
                                    RadiusX="8"
                                    RadiusY="8"
                                    Stroke="{StaticResource DialogBorderBrush}"
                                    StrokeDashArray="3 2"
                                    StrokeThickness="1" />
                                <TextBlock
                                    MaxWidth="360"
                                    Margin="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DialogHintText}"
                                    Text="还没有变量 · 点「新增变量」，把上游节点的输出端口绑成别名，表达式里就能直接引用"
                                    TextAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!--  动态比例分割线（For 模式隐藏）  -->
                <GridSplitter
                    Grid.Row="1"
                    Height="3"
                    Margin="10,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{StaticResource DialogBorderBrush}"
                    Cursor="SizeNS"
                    ShowsPreview="True"
                    Visibility="{Binding IsForMode, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                <!--  2. 表达式编辑器（For 模式隐藏）  -->
                <Border
                    Grid.Row="2"
                    Style="{StaticResource DialogColumnCard}"
                    Visibility="{Binding IsForMode, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="12,0" Style="{StaticResource DialogSectionHeader}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Style="{StaticResource DialogColumnTitleIcon}"
                                    Text="&#xf121;" />
                                <!--  标题随模式切换：普通=“为分支 [ X ] 编写逻辑判断表达式”；分支匹配=“填写匹配值”
                                      （拼装收在 VM 的 EditorTitle 一处，XAML 不再并列两块文本各写各的）  -->
                                <TextBlock Style="{StaticResource DialogColumnTitle}" Text="{Binding EditorTitle}" />
                            </StackPanel>
                        </Border>

                        <!--  分支匹配（Case）模式：判据输入（容器级，只写一次；分支上写匹配值）  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="12,12,12,0"
                            Orientation="Horizontal"
                            Visibility="{Binding IsCaseMode, Converter={ui:BooleanToVisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DialogFormLabel}"
                                Text="判据" />
                            <TextBox
                                Width="220"
                                Style="{StaticResource DialogInput}"
                                Text="{Binding JudgeExpressionDraft, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="要拿哪个变量去比对：填变量表里的别名，或运行时变量名" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource DialogTextMutedBrush}"
                                Text="按顺序比对：命中第一条匹配值即执行该分支；都不命中走默认分支" />
                        </StackPanel>

                        <!--
                            快捷插入面板：点一下就把片段插进表达式（按钮的 Tag 即插入内容）。
                            按组分五行：引用变量 / 逻辑比较 / 数字运算 / 数学函数 / 字符串；
                            每行 = 固定宽度的组名标签 + 一个可换行的 WrapPanel。
                        -->
                        <ScrollViewer
                            Grid.Row="2"
                            MaxHeight="200"
                            Margin="12,12,12,0"
                            Padding="0,0,4,0"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding ShowBooleanEditor, Converter={ui:BooleanToVisibilityConverter}}">
                            <StackPanel>

                                <!--  组：引用变量（别名，主色胶囊）  -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="引用变量" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Variables}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Margin="0,0,6,6"
                                                    Click="QuickInsert_Click"
                                                    Content="{Binding AliasName}"
                                                    Style="{StaticResource DialogTagButton}"
                                                    Background="{StaticResource DialogAccentSoftBrush}"
                                                    Foreground="{StaticResource DialogAccentBrush}"
                                                    ToolTip="插入该引脚变量的别名" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!--  组：逻辑比较  -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="逻辑比较" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="&gt;"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="&gt;"
                                            ToolTip="大于" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="&lt;"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="&lt;"
                                            ToolTip="小于" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="=="
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="=="
                                            ToolTip="等于" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="!="
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="!="
                                            ToolTip="不等于" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="&amp;&amp;"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="&amp;&amp;"
                                            ToolTip="并且 (And)" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="||"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="||"
                                            ToolTip="或者 (Or)" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="!"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="!"
                                            ToolTip="取反 (Not)" />
                                    </WrapPanel>
                                </Grid>

                                <!--  组：数字运算  -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="数字运算" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="( )"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="()"
                                            ToolTip="括号 (提高优先级)" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="+"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="+" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="-"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="-" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="*"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="*" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="/"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="/" />
                                    </WrapPanel>
                                </Grid>

                                <!--  组：数学函数  -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="数学函数" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="Math.Abs()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="Math.Abs()"
                                            ToolTip="绝对值 (常用于公差判断)" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="Math.Round()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="Math.Round()"
                                            ToolTip="四舍五入" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="Math.Sqrt()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="Math.Sqrt()"
                                            ToolTip="开平方 (常用于算距离)" />
                                    </WrapPanel>
                                </Grid>

                                <!--  组：字符串  -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,6,0,0"
                                        VerticalAlignment="Top"
                                        FontSize="11.5"
                                        Foreground="{StaticResource DialogTextMutedBrush}"
                                        Text="字符串" />
                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="Contains()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag=".Contains()"
                                            ToolTip="包含某个字符" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="StartsWith()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag=".StartsWith()"
                                            ToolTip="以...开头" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="IsNullOrEmpty()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag="string.IsNullOrEmpty()"
                                            ToolTip="是否为空" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="Length"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag=".Length"
                                            ToolTip="获取字符串长度" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="Trim()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag=".Trim()"
                                            ToolTip="去除首尾空格" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="ToUpper()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag=".ToUpper()"
                                            ToolTip="转大写" />
                                        <Button
                                            Margin="0,0,6,6"
                                            Click="QuickInsert_Click"
                                            Content="ToLower()"
                                            Style="{StaticResource DialogTagButton}"
                                            Tag=".ToLower()"
                                            ToolTip="转小写" />
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!--
                            AvalonEdit 表达式编辑器。
                            x:Name 与 TextChanged 事件必须原样保留 —— code-behind 靠它们
                            读写编辑内容并触发实时校验，改名等于把这个弹窗的输入通道切断。
                            ShowLineNumbers 保留（设计稿的实时校验状态条不在本次范围，去掉行号只白丢信息）。
                        -->
                        <Border
                            Grid.Row="3"
                            Margin="12"
                            Background="{StaticResource DialogInputBackgroundBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="8"
                            Visibility="{Binding ShowBooleanEditor, Converter={ui:BooleanToVisibilityConverter}}">
                            <avalonEdit:TextEditor
                                x:Name="txtExpression"
                                Padding="10"
                                Background="Transparent"
                                FontFamily="Consolas"
                                FontSize="14"
                                ShowLineNumbers="True"
                                SyntaxHighlighting="C#"
                                TextChanged="TxtExpression_TextChanged" />
                        </Border>

                        <!--
                            分支匹配（Case）：匹配值输入框（替代布尔表达式编辑器）。
                            单行常量，按判据声明类型转换（CaseValueHelper，与编译器同一判据）；
                            快捷插入面板刻意不出现 —— 匹配值里没有变量和运算符可插。
                        -->
                        <Border
                            Grid.Row="3"
                            Margin="12"
                            Background="{StaticResource DialogInputBackgroundBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding ShowCaseValueEditor, Converter={ui:BooleanToVisibilityConverter}}">
                            <StackPanel Margin="16" VerticalAlignment="Top">
                                <TextBlock
                                    Style="{StaticResource DialogHintText}"
                                    Text="匹配值：判据等于该值时执行本分支（数值 / 布尔 / 字符串等值类型；字符串无需加引号）" />
                                <TextBox
                                    Width="260"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource DialogInput}"
                                    Text="{Binding SelectedBranch.Expression, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="例如：1 / 2.5 / true / OK" />
                            </StackPanel>
                        </Border>

                        <!--
                            Else / Default 分支：编译器把它的条件强制当作“真”，
                            留一个写了也白写的编辑器只会误导人（也就那句 ToolTip 的来历）。
                            分支匹配模式下这段文案换成“默认分支”措辞（NoConditionTitle / NoConditionHintText）。
                        -->
                        <Border
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Margin="12"
                            Padding="20"
                            Background="{StaticResource DialogRowAlternateBrush}"
                            CornerRadius="8"
                            Visibility="{Binding SelectedBranchNeedsExpression, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding NoConditionTitle}" />
                                <TextBlock
                                    MaxWidth="480"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource DialogHintText}"
                                    TextAlignment="Center"
                                    ToolTip="编译器会把这个分支的条件强制替换为恒真表达式，写了也不会执行"
                                    Text="{Binding NoConditionHintText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  3. For 计次循环卡片（并入本弹窗：同一套草稿→校验→写回事务管线）  -->
                <Border
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Style="{StaticResource DialogColumnCard}"
                    Visibility="{Binding IsForMode, Converter={ui:BooleanToVisibilityConverter}}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <StackPanel
                            Margin="0,0,0,22"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Style="{StaticResource DialogColumnTitleIcon}"
                                FontSize="14"
                                Text="&#xf01e;" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{StaticResource DialogTextPrimaryBrush}"
                                Text="计次循环设置 (For)" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DialogFormLabel}"
                                Text="循环次数" />
                            <TextBox
                                Width="160"
                                Style="{StaticResource DialogInput}"
                                Text="{Binding LoopCountText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="1 ~ 99999" />
                        </StackPanel>

                        <!--
                            LoopCount 连线入口：与画布拖线写同一条 LinkedSources["LoopCount"]。
                            这里读写的都是弹窗草稿，点"保存并应用"才落到活模型（取消即丢弃）。
                        -->
                        <StackPanel
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DialogFormLabel}"
                                Text="数据源" />
                            <Border
                                Width="260"
                                Height="30"
                                Padding="10,0"
                                Background="{StaticResource DialogSurfaceBrush}"
                                BorderBrush="{StaticResource DialogBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                                    Text="{Binding LoopCountSourceText, TargetNullValue='未连线（用左侧默认次数）'}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding LinkLoopCountCommand}"
                                Style="{StaticResource DialogTagButton}"
                                ToolTip="把循环次数改为由上游输出端口驱动">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="11"
                                        Text="&#xf0c1;" />
                                    <TextBlock VerticalAlignment="Center" Text="选择数据源" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource DialogDangerSubtleBrush}"
                                Command="{Binding UnlinkLoopCountCommand}"
                                Foreground="{StaticResource DialogDangerBrush}"
                                Style="{StaticResource DialogTagButton}"
                                ToolTip="解除连线，改回用左侧默认次数"
                                Visibility="{Binding HasLoopCountLink, Converter={ui:BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Icon}"
                                        FontSize="11"
                                        Text="&#xf00d;" />
                                    <TextBlock VerticalAlignment="Center" Text="解除" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            MaxWidth="480"
                            Margin="0,20,0,0"
                            Style="{StaticResource DialogHintText}"
                            TextAlignment="Center"
                            Text="取值范围 1 ~ 99999。若该节点的循环次数输入端口连接了上游变量，运行时以连线值为准，此处仅作未连线时的默认次数。" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  4. 底栏：跨整宽，右对齐「取消 / 保存并应用」  -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    MinWidth="96"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    Style="{StaticResource DialogSecondaryButton}" />
                <Button
                    MinWidth="130"
                    Margin="12,0,0,0"
                    Command="{Binding SaveCommand}"
                    Content="保存并应用"
                    Style="{StaticResource DialogPrimaryButton}" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
