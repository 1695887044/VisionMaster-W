<UserControl
    x:Class="VisionMaster.Views.DialogViews.ScadaAxisPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    Width="560"
    Height="520"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <!--
        组态「选择轴」弹窗：从工程里已启用的轴中多选。
        与「选择变量」同一套外壳（无系统边框、吸顶标题、底部按钮），
        内容区换成勾选清单——多选 + 顺序即下拉顺序。
    -->

    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
        </Style>
    </prism:Dialog.WindowStyle>

    <Grid Margin="15">
        <Border Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Direction="270"
                    Opacity="0.15"
                    ShadowDepth="3"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    ui:WindowDragBehavior.IsWindowDraggable="True"
                    Background="#F8F9FA"
                    BorderBrush="#EBEEF5"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0">
                    <TextBlock
                        Margin="20,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#303133"
                        Text="选择轴" />
                </Border>

                <Grid Grid.Row="1" Margin="20,16,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Height="32"
                        Background="#FFFFFF"
                        BorderBrush="#DCDFE6"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <TextBox
                                Padding="8,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Foreground="#303133"
                                Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#C0C4CC"
                                IsHitTestVisible="False"
                                Text="按轴名 / 卡名筛选">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Keyword}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Background="#FFFFFF"
                        BorderBrush="#E4E7ED"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <ScrollViewer
                                Padding="10,8"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Axes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Margin="0,3"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                ToolTip="{Binding CardCaption}">
                                                <Grid Margin="4,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#303133"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        FontSize="11"
                                                        Foreground="#909399"
                                                        Text="{Binding CardCaption}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#909399"
                                Text="{Binding EmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasAxes, Converter={ui:BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                        </Grid>
                    </Border>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        FontSize="11"
                        Foreground="#C0C4CC"
                        Text="* 只能从工程里已启用的轴中选；顺序即运行期下拉框顺序，默认选中第一根。" />
                </Grid>

                <StackPanel
                    Grid.Row="2"
                    Margin="20,10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,12,0"
                        Padding="28,8"
                        Background="#FFFFFF"
                        BorderBrush="#DCDFE6"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button
                        Padding="28,8"
                        Background="#409EFF"
                        BorderThickness="0"
                        Command="{Binding ConfirmCommand}"
                        Content="确定"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
