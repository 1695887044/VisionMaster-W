<UserControl
    x:Class="VisionMaster.Views.DialogViews.FlowManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    MinWidth="820"
    MinHeight="480"
    Background="{StaticResource DialogBackgroundBrush}"
    FontFamily="Microsoft YaHei"
    mc:Ignorable="d">

    <!--
        窗口尺寸挂在 Window 上，不写在 UserControl 根节点上。
        写成 UserControl 的 Width/Height 有两个后果：一是默认的 Stretch 退化成"居中"——
        窗口拉大后内容缩在中间、四周留白；二是内容永远不跟着窗口变宽。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--
                WindowStyle=None：去掉系统原生标题栏，改由视图自绘（见下方标题栏）。
                与变量管理 / 相机设置 / 通讯设置 / 插件配置壳一致。
            -->
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <!--
                尺寸（2026-10-28 复核，随 v1.1 基线重算）：
                列宽改为 名称 *（下限 180）+ 调用方式 330 + 描述 1.3*（下限 150）+ 状态 120 + 操作 200
                = 固定 650 + 星号 478（1180 内容区 1168 − 左右边距 40 − 固定列）。
                MinWidth=1060：内容区 1048，表格可用 1008，星号列退到各自下限 180 / 150 仍放得下
                （180+330+150+120+200 = 980 ≤ 1008）。再窄才出横向滚动条。
                高度 620 不变：行高 96→56、说明区 160→62 之后，7 条流程一次看全
                （36 表头 + 7×56 = 428 ≤ 438），不需要滚动。
            -->
            <Setter Property="Width" Value="1180" />
            <Setter Property="Height" Value="620" />
            <Setter Property="MinWidth" Value="1060" />
            <Setter Property="MinHeight" Value="480" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--
        ============================================================================
        流程管理 —— 设计基线 docs/UI设计基线/flow-manager/ v1.1
        ============================================================================

        【这一版改的是信息密度，不是换皮】
        旧版每行 96px：5 个 DialogCheckBox 在 300px 列里折成两排（各约 56px + 间距），
        再加 InvokeSummary 与 PendingNote 两行 11px 文本。620 高的弹窗只装得下 3.7 行，
        第 4 行沿行底被裁（用户真机截图）。
        新版：5 个复选框 → 5 个可点胶囊（单排约 280px），行高 56，7 条一次看全。

        【删掉的「调用关系」列】它的 4 种取值（循环/外部/子/手动）完全由 InvokeType 位集派生
        （FlowModel.CallBadgeText），是同一份数据的第二个投影；列宽 150 装不下
        「子程序 · 由主流程调用」（约 142px + 单元格 padding 24），一直被 CharacterEllipsis 截断。
        信息并入：胶囊颜色（整线=绿 / 外部=青蓝）+ 名称旁角色徽标 + 极少数行的派生小字。

        【颜色】一律走 Colors.xaml 的 Dialog* 与逻辑容器族令牌，本视图零颜色字面量（R140）。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            标题栏（自绘）。无边框窗口没有系统拖动区与关闭按钮，两者都在这里补齐：
            整条挂 ui:WindowDragBehavior 负责拖，右侧 × 绑 VM 的 CloseCommand。
            标题文字绑 VM.Title，不写死 —— 系统标题栏去掉后这里是唯一的标题来源。
        -->
        <Border
            Grid.Row="0"
            ui:WindowDragBehavior.IsWindowDraggable="True"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource DialogIconFont}"
                    FontSize="15"
                    Foreground="{StaticResource DialogAccentBrush}"
                    Text="&#xf0e8;" />

                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="流程的锁定、解锁、启停与调用方式" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭">
                    <TextBlock
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <!--  工具栏：左标题 + 计数，右搜索（外框 + 放大镜 + 输入 + 清除）  -->
        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Style="{StaticResource DialogCardTitleIcon}"
                    Text="&#xf0ca;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="流程列表" />
                <!--  计数：搜索过滤后是"命中数"，用户才知道自己筛掉了多少  -->
                <Border
                    Margin="8,0,0,0"
                    Padding="6,0"
                    Height="18"
                    VerticalAlignment="Center"
                    Background="{StaticResource DialogSurfaceBrush}"
                    BorderBrush="{StaticResource DialogBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="{Binding FlowCountText}" />
                </Border>
            </StackPanel>

            <Border
                Grid.Column="1"
                Width="240"
                Style="{StaticResource DialogSearchChrome}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource DialogSearchIcon}"
                        Text="&#xf002;" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource DialogSearchInput}"
                        Tag="搜索流程名 / 描述"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <!--
                        清除键：空串时收起。搜索无结果时唯一的出路是"把关键词删掉"，
                        而输入框里的内容只能一个个退格删——空态里那句提示再清楚，也得多花一次操作。
                    -->
                    <Button
                        Grid.Column="2"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource DialogIconButton}"
                        ToolTip="清除搜索"
                        Visibility="{Binding HasSearchText, Converter={ui:BooleanToVisibilityConverter}}">
                        <TextBlock
                            FontFamily="{StaticResource DialogIconFont}"
                            FontSize="9"
                            Foreground="{StaticResource DialogTextMutedBrush}"
                            Text="&#xf00d;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!--
            流程列表。
            表头/行/单元格皮肤统一走 DialogDataGrid（它内部已串好 CellStyle / RowStyle /
            ColumnHeaderStyle）—— 不再本地写隐式样式：隐式样式一旦进全局字典会波及全应用每个表格。
            本视图只覆盖两处密度：RowHeight=56（皮肤给 46）与 ColumnHeaderStyle=紧凑版（42→36）。
        -->
        <Border
            Grid.Row="2"
            Margin="20,0"
            Background="{StaticResource DialogSurfaceBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <DataGrid
                    ItemsSource="{Binding Flows}"
                    RowHeight="56"
                    SelectedItem="{Binding SelectedFlow}"
                    Style="{StaticResource DialogDataGrid}"
                    ColumnHeaderStyle="{StaticResource DialogDataGridColumnHeaderCompact}">
                    <DataGrid.Columns>
                        <!--  ① 流程名称：角色徽标 + 名称 + 锁定图标  -->
                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="180"
                            Header="流程名称">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <!--
                                            角色徽标：Home/Main/End 三条骨架流程每个方案都必须保留（可改名不可删），
                                            旧版视图完全没用 FlowModel.Role，用户只能靠记名字。文案来自
                                            FlowRole 的 [Display(ShortName)]，不在视图里写死中文（R40）。
                                        -->
                                        <Border
                                            x:Name="RoleBadge"
                                            Margin="0,0,7,0"
                                            Padding="5,0"
                                            Height="17"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource DialogSurfaceBrush}"
                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            ToolTip="{Binding RoleBadgeToolTip}">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="9.5"
                                                FontWeight="Bold"
                                                Text="{Binding RoleBadgeText}" />
                                        </Border>

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogTextPrimaryBrush}"
                                            Text="{Binding Flow.FlowName}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            x:Name="LockIcon"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource DialogIconFont}"
                                            FontSize="11"
                                            Foreground="{StaticResource DialogDangerTextBrush}"
                                            Text="&#xf023;"
                                            ToolTip="已锁定：禁止运行（HTTP / 定时 / 变量 / 子程序 / 界面五条入口统一拦）"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RoleBadgeText}" Value="">
                                            <Setter TargetName="RoleBadge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RoleBadgeKey}" Value="home">
                                            <Setter TargetName="RoleBadge" Property="Background" Value="{StaticResource LogicCaseSoftBrush}" />
                                            <Setter TargetName="RoleBadge" Property="BorderBrush" Value="{StaticResource LogicCaseBorderBrush}" />
                                            <Setter TargetName="RoleBadge" Property="TextElement.Foreground" Value="{StaticResource LogicCaseTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RoleBadgeKey}" Value="main">
                                            <Setter TargetName="RoleBadge" Property="Background" Value="{StaticResource LogicIfSoftBrush}" />
                                            <Setter TargetName="RoleBadge" Property="BorderBrush" Value="{StaticResource LogicIfBorderBrush}" />
                                            <Setter TargetName="RoleBadge" Property="TextElement.Foreground" Value="{StaticResource LogicIfTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RoleBadgeKey}" Value="end">
                                            <Setter TargetName="RoleBadge" Property="Background" Value="{StaticResource LogicWhileSoftBrush}" />
                                            <Setter TargetName="RoleBadge" Property="BorderBrush" Value="{StaticResource LogicWhileBorderBrush}" />
                                            <Setter TargetName="RoleBadge" Property="TextElement.Foreground" Value="{StaticResource LogicWhileTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                            <Setter TargetName="LockIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--
                            ② 调用方式：五个可点胶囊（基线 §1.1）
                            位集是 FlowInvokeType [Flags]，五位互相独立；同一时刻勾多位是常态
                            （工位流程常同时勾「子程序」+「整线」）。
                            多选不会让同一条流程并发跑两遍——所有入口收口到会话锁：
                            定时/变量在跑就跳过（FlowAutoRunner），HTTP 在跑返回 409。
                            整线档用成功色：它不是"外部触发"，而是"随工具栏启动整线"。
                        -->
                        <DataGridTemplateColumn Width="330">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="调用方式" />
                                    <Border
                                        Margin="6,0,0,0"
                                        Padding="5,0"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource DialogRowHoverBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="9.5"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogTextMutedBrush}"
                                            Text="多选" />
                                    </Border>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox
                                                Content="定时"
                                                IsChecked="{Binding IsTimerInvoke}"
                                                Style="{StaticResource DialogInvokeChip}"
                                                ToolTip="按「定时间隔」周期自动执行（下限 20ms；拍精度取决于生效的节拍源，启动日志会写明）。间隔为 0 = 未配置，不会触发——点右侧齿轮设置" />
                                            <CheckBox
                                                Margin="6,0,0,0"
                                                Content="变量"
                                                IsChecked="{Binding IsVariableInvoke}"
                                                Style="{StaticResource DialogInvokeChip}"
                                                ToolTip="指定变量由假变真时触发一次。变量名为空 = 未配置，不会触发——点右侧齿轮设置" />
                                            <CheckBox
                                                Margin="6,0,0,0"
                                                Content="子程序"
                                                IsChecked="{Binding IsSubroutineInvoke}"
                                                Style="{StaticResource DialogInvokeChip}"
                                                ToolTip="允许被其它流程的「调用流程」步骤调用（勾了才放行）" />
                                            <CheckBox
                                                Margin="6,0,0,0"
                                                Content="HTTP"
                                                IsChecked="{Binding IsHttpInvoke}"
                                                Style="{StaticResource DialogInvokeChip}"
                                                ToolTip="勾选后才允许经 /flow/{流程名} 接口触发（唯一门禁位）" />
                                            <CheckBox
                                                Margin="6,0,0,0"
                                                Content="整线"
                                                IsChecked="{Binding IsLineStartInvoke}"
                                                Style="{StaticResource DialogInvokeChipLine}"
                                                ToolTip="随整线启动：工具栏「启动整线 / 整线循环」把它与其它勾了本位的流程各起各的会话一起启动；一条出问题只停它自己" />

                                            <!--
                                                配置入口（A 方案）：勾了定时或变量才出现。
                                                没有它，这两个位就是"勾了也不生效"——TimerIntervalMs 与
                                                TriggerVariable 在全仓没有第二个界面入口（基线 §1.8）。
                                            -->
                                            <Button
                                                Width="22"
                                                Height="22"
                                                MinWidth="22"
                                                MinHeight="22"
                                                Margin="6,0,0,0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ConfigureInvokeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DialogIconButton}"
                                                ToolTip="调用参数：定时间隔 / 触发变量（未配置时勾了也不会触发）"
                                                Visibility="{Binding NeedsInvokeParams, Converter={ui:BooleanToVisibilityConverter}}">
                                                <TextBlock
                                                    FontFamily="{StaticResource DialogIconFont}"
                                                    FontSize="10"
                                                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                                                    Text="&#xf013;" />
                                            </Button>
                                        </StackPanel>

                                        <!--
                                            调用方式警告行（琥珀）：两类"配了但不生效"共用一行，矛盾配置优先。
                                              · 整线 + 子程序同时勾（历史 .vms）→ 两个入口抢同一会话，必须二选一；
                                              · 勾了定时/变量却没配参数 → 与运行侧同源判据（ShouldFire 的
                                                TimerIntervalMs<=0、EvaluateCore 的 TriggerVariable 空串比较）。
                                            与下面的"待接通"分工：那个管"这一位有没有接通运行侧"，
                                            这个管"这一条流程的配置本身站不站得住"。
                                        -->
                                        <TextBlock
                                            x:Name="ConfigNote"
                                            Margin="0,4,0,0"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DialogWarningTextBrush}"
                                            Text="{Binding InvokeWarningText}"
                                            TextWrapping="Wrap" />

                                        <!--  派生小字（中性色）：仅子程序 / 手动——删掉「调用关系」列后它们没有别的表达  -->
                                        <TextBlock
                                            x:Name="DerivedNote"
                                            Margin="0,4,0,0"
                                            FontSize="10"
                                            Foreground="{StaticResource DialogTextTertiaryBrush}"
                                            Text="{Binding DerivedNote}"
                                            TextWrapping="Wrap" />

                                        <!--  待接通：领域层 PendingReason（当前五位全接通 → 恒为空串，整行收起）  -->
                                        <TextBlock
                                            x:Name="PendingNote"
                                            Margin="0,2,0,0"
                                            FontSize="10"
                                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                                            Text="{Binding PendingReasonText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!--  仓库实测：DataTemplate.Triggers 里的 DataTrigger 可靠；空串时收起提示行  -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding InvokeWarningText}" Value="">
                                            <Setter TargetName="ConfigNote" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DerivedNote}" Value="">
                                            <Setter TargetName="DerivedNote" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PendingReasonText}" Value="">
                                            <Setter TargetName="PendingNote" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="1.3*"
                            MinWidth="150"
                            Binding="{Binding Flow.Description}"
                            Header="描述"
                            IsReadOnly="True" />

                        <!--  ③ 状态：四态，只有异常态（运行中 / 已锁定）给底色（基线 §1.3）  -->
                        <DataGridTemplateColumn Width="120" Header="状态">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <StackPanel
                                            x:Name="DotState"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Grid
                                                Width="12"
                                                Height="12"
                                                VerticalAlignment="Center">
                                                <Ellipse
                                                    x:Name="Halo"
                                                    Width="12"
                                                    Height="12"
                                                    Fill="{StaticResource DialogSuccessBrush}"
                                                    Opacity="0" />
                                                <Ellipse
                                                    x:Name="Dot"
                                                    Width="6"
                                                    Height="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Fill="{StaticResource DialogSuccessBrush}" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="DotText"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{StaticResource DialogTextSecondaryBrush}"
                                                Text="{Binding StatusText}" />
                                        </StackPanel>

                                        <Border
                                            x:Name="LockChip"
                                            Padding="7,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource DialogDangerSubtleBrush}"
                                            BorderBrush="{StaticResource DialogDangerBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DialogDangerTextBrush}"
                                                Text="{Binding StatusText}" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="off">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DialogBorderStrongBrush}" />
                                            <Setter TargetName="DotText" Property="Foreground" Value="{StaticResource DialogTextMutedBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="run">
                                            <Setter TargetName="DotText" Property="Foreground" Value="{StaticResource DialogSuccessTextBrush}" />
                                            <Setter TargetName="DotText" Property="FontWeight" Value="SemiBold" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="RunPulse">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            AutoReverse="True"
                                                            Duration="0:0:0.7"
                                                            From="0.28"
                                                            RepeatBehavior="Forever"
                                                            Storyboard.TargetName="Halo"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0.06" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="RunPulse" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="lock">
                                            <Setter TargetName="DotState" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="LockChip" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--
                            ④ 操作：按状态收敛（基线 §1.4 + Q1）
                            旧版「锁定」「解锁」并排常驻，两者各自只判自己的前置条件，点错必报错；
                            新版合成一个图标键（锁 ↔ 开锁），同一时刻只出现一个。
                            运行中两个键都置灰：旧版 ExecuteEncryptFlow / ExecuteToggleEnabled 都不判
                            RunState，运行中照样能改——Q1 裁定要补上，VM 里"按下前判 + 执行前判"各一次。
                        -->
                        <DataGridTemplateColumn Width="200" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding OpsToolTip}">

                                        <Button
                                            Height="24"
                                            Padding="9,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding EnabledText}"
                                            FontSize="11.5"
                                            IsEnabled="{Binding CanToggle}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource DialogChipButton}" TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource DialogSurfaceBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource DialogTextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <!--  "启用"是恢复动作，用主色；"禁用"是常规动作，保持中性  -->
                                                        <DataTrigger Binding="{Binding IsEnableAction}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!--  未锁定：显示锁形，点击 = 锁定  -->
                                        <Button
                                            Width="24"
                                            Height="24"
                                            MinWidth="24"
                                            MinHeight="24"
                                            Margin="6,0,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.EncryptFlowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanLock}"
                                            ToolTip="锁定：该流程禁止运行（HTTP / 定时 / 变量 / 子程序 / 界面五条入口统一拦）。不改变文件内容，不是机密性保护">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource DialogIconButton}" TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="11"
                                                Foreground="{StaticResource DialogTextTertiaryBrush}"
                                                Text="&#xf023;" />
                                        </Button>

                                        <!--  已锁定：显示开锁形（danger 语义），点击 = 解锁  -->
                                        <Button
                                            Width="24"
                                            Height="24"
                                            MinWidth="24"
                                            MinHeight="24"
                                            Margin="6,0,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.DecryptFlowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanLock}"
                                            ToolTip="解除锁定，恢复可运行">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource DialogIconButton}" TargetType="Button">
                                                    <Setter Property="Background" Value="{StaticResource DialogDangerSubtleBrush}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock
                                                FontFamily="{StaticResource DialogIconFont}"
                                                FontSize="11"
                                                Foreground="{StaticResource DialogDangerTextBrush}"
                                                Text="&#xf09c;" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--
                    空态（基线 §1.6）：FilterFlows() 是 Flows.Clear() 后按关键词回填，
                    关键词打错就是一张空白表。旧版没有任何反馈，用户会以为列表加载失败。
                    无流程态不可达（SolutionModel 预置 Home/Main/End 且 MandatoryFlows 加载时补齐），
                    这里的标题分支只是兜底，见基线 §6。
                -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={ui:BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource DialogEmptyStateIcon}" Text="&#xf002;" />
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Text="{Binding EmptyStateTitle}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        HorizontalAlignment="Center"
                        Text="搜索范围是流程名与描述；清空关键词即恢复全部流程" />
                    <Button
                        Margin="0,10,0,0"
                        Padding="11,0"
                        Height="26"
                        HorizontalAlignment="Center"
                        Command="{Binding ClearSearchCommand}"
                        Content="清除搜索"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Background="{StaticResource DialogAccentSoftBrush}"
                        Foreground="{StaticResource DialogAccentTextBrush}"
                        Style="{StaticResource DialogChipButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            说明面板（基线 §1.5，Q2 裁定"默认收起"）
            旧版 5 条常驻 = 130px，占弹窗高度 21%，其中第 3 条就是在逐字复述表格里的 5 个勾选框。
            新版默认收起成 32px 一行目录，展开是两列三行（128px，仍比旧版少 32px）——信息一条没丢。
        -->
        <Border
            Grid.Row="3"
            Margin="20,14,20,16"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource DialogIconFont}"
                        FontSize="11"
                        Foreground="{StaticResource DialogAccentBrush}"
                        Text="&#xf05a;" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="调用方式 5 位含义" />
                        <TextBlock
                            Margin="8,0"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogBorderStrongBrush}"
                            Text="·" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="锁定与启用的区别" />
                        <TextBlock
                            Margin="8,0"
                            FontSize="11.5"
                            Foreground="{StaticResource DialogBorderStrongBrush}"
                            Text="·" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource DialogTextSecondaryBrush}"
                            Text="骨架流程约束" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Height="22"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleLegendCommand}"
                        FontSize="11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{Binding LegendToggleText}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource DialogIconFont}"
                                FontSize="9"
                                Text="&#xf078;" />
                        </StackPanel>
                        <Button.Style>
                            <Style BasedOn="{StaticResource DialogChipButton}" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="12,0,12,10"
                    Visibility="{Binding IsLegendExpanded, Converter={ui:BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,8,5"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="启用 / 禁用" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,22,5"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="控制流程是否参与自动调用；禁用后界面手动运行同样被拦。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,8,5"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="锁定 / 解锁" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="0,0,0,5"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="锁定后 HTTP / 定时 / 变量 / 子程序 / 界面五条入口统一拦；不改变文件内容，不是机密性保护。"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,8,5"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="调用方式" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,22,5"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="HTTP = 允许经 /flow/{流程名} 触发；定时 = 按间隔周期跑（下限 20ms）；变量 = 指定变量由假变真时跑一次。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,8,5"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="子程序 / 整线" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,0,0,5"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="子程序 = 允许被其它流程的「调用流程」步骤调用；整线 = 随工具栏「启动整线」与其它勾选本位的流程各起各的会话，一条出问题只停它自己。"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="状态色" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,22,0"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="绿点 = 已启用；灰点 = 已禁用；脉冲绿点 = 运行中；红锁 = 已锁定（禁止运行）。"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="骨架流程" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="3"
                        Margin="0,0,0,0"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="Home / Main / End 三条每个方案都必须保留，不允许删除（可改名）。"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>
    </Grid>

</UserControl>
