<UserControl
    x:Class="VisionMaster.Views.DialogViews.FlowManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    MinWidth="820"
    MinHeight="480"
    Background="{StaticResource DialogBackgroundBrush}"
    FontFamily="Microsoft YaHei"
    mc:Ignorable="d">

    <!--
        窗口尺寸挂在 Window 上，不写在 UserControl 根节点上。
        写成 UserControl 的 Width/Height 有两个后果：一是默认的 Stretch 退化成"居中"——
        窗口拉大后内容缩在中间、四周留白；二是内容永远不跟着窗口变宽。
    -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <!--
                WindowStyle=None：去掉系统原生标题栏，改由视图自绘（见下方标题栏）。
                与变量管理 / 相机设置 / 通讯设置 / 插件配置壳一致。
            -->
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
            <Setter Property="SizeToContent" Value="Manual" />
            <Setter Property="Width" Value="1000" />
            <Setter Property="Height" Value="620" />
            <Setter Property="MinWidth" Value="820" />
            <Setter Property="MinHeight" Value="480" />
        </Style>
    </prism:Dialog.WindowStyle>

    <!--
        ============================================================================
        流程管理
        ============================================================================

        本次是**整体收编**，不是只换皮：
        改前这张视图自带四支按钮样式（ActionButton / EncryptButton / DecryptButton /
        DisableButton）与三支**隐式** DataGrid 皮肤，颜色是硬编码的 Bootstrap 老配色
        （#34495e 深蓝表头 / #3498db / #27ae60 / #e74c3c / #ecf0f1），
        和这套界面的青蓝令牌（Dialog*）不是一套；隐式样式还会盖掉全局表格皮肤
        （见 DialogStyles.xaml 开头的说明）。
        现在：颜色一律走 Colors.xaml 的 Dialog* 令牌，形状一律取 DialogStyles.xaml，
        本视图不再定义任何样式，也不再出现颜色字面量。
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            标题栏（自绘）。无边框窗口没有系统拖动区与关闭按钮，两者都在这里补齐：
            整条挂 ui:WindowDragBehavior 负责拖，右侧 × 绑 VM 的 CloseCommand。
            标题文字绑 VM.Title，不写死 —— 系统标题栏去掉后这里是唯一的标题来源。
        -->
        <Border
            Grid.Row="0"
            ui:WindowDragBehavior.IsWindowDraggable="True"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderLightBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    FontSize="15"
                    Foreground="{StaticResource DialogAccentBrush}"
                    Text="&#xf0e8;" />

                <StackPanel
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="{StaticResource DialogTextPrimaryBrush}"
                        Text="{Binding Title}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource DialogTextMutedBrush}"
                        Text="流程的加密、解密、启停与调用方式" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource DialogIconButton}"
                    ToolTip="关闭">
                    <TextBlock
                        FontFamily="{StaticResource Icon}"
                        FontSize="13"
                        Foreground="{StaticResource DialogTextSecondaryBrush}"
                        Text="&#xf00d;" />
                </Button>
            </Grid>
        </Border>

        <!--  工具栏：左标题 + 右搜索（搜索框三段一体：外框 + 放大镜 + 透明输入框）  -->
        <Grid Grid.Row="1" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Style="{StaticResource DialogCardTitleIcon}"
                    Text="&#xf0ca;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="流程列表" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Width="240"
                Style="{StaticResource DialogSearchChrome}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource DialogSearchIcon}"
                        Text="&#xf002;" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource DialogSearchInput}"
                        Tag="搜索流程名 / 描述"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
        </Grid>

        <!--
            流程列表。
            表头/行/单元格皮肤统一走 DialogDataGrid（它内部已串好 CellStyle / RowStyle /
            ColumnHeaderStyle）—— 不再本地写隐式样式：隐式样式一旦进全局字典会波及全应用每个表格，
            而留在本地又会与本视图其它部分各说各话。
        -->
        <DataGrid
            Grid.Row="2"
            Margin="20,0"
            ItemsSource="{Binding Flows}"
            SelectedItem="{Binding SelectedFlow}"
            Style="{StaticResource DialogDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Flow.FlowName}"
                    Header="流程名称"
                    IsReadOnly="True" />

                <!--
                    调用方式 = 多选位集（FlowInvokeType [Flags]），四位全部接通：
                    「HTTP」= 允许 /flow/{流程名} 触发（会话获取前门禁）；
                    「定时」= FlowTimerScheduler 按 TimerIntervalMs 周期跑（下限 100ms）；
                    「变量」= 指定变量由假变真时跑（上升沿）；「子程序」= 允许被「调用流程」步骤调用。
                    行尾的"待接通"提示来自领域层（FlowInvokeTypeExtensions.PendingReason）：
                    现在四位都返回 null → 该行自动收起；将来加位没接通时它会把原因显示出来。
                -->
                <DataGridTemplateColumn Width="320" Header="调用方式（多选）">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox
                                        Margin="0,0,10,0"
                                        Content="定时"
                                        FontSize="12"
                                        IsChecked="{Binding IsTimerInvoke}"
                                        ToolTip="按「定时间隔」周期自动执行（下限 20ms；拍精度取决于生效的节拍源，启动日志会写明）" />
                                    <CheckBox
                                        Margin="0,0,10,0"
                                        Content="变量"
                                        FontSize="12"
                                        IsChecked="{Binding IsVariableInvoke}"
                                        ToolTip="指定变量由假变真时触发一次（变量名见流程模型 TriggerVariable）" />
                                    <CheckBox
                                        Margin="0,0,10,0"
                                        Content="子程序"
                                        FontSize="12"
                                        IsChecked="{Binding IsSubroutineInvoke}"
                                        ToolTip="允许被其它流程的「调用流程」步骤调用（勾了才放行）" />
                                    <CheckBox
                                        Content="HTTP"
                                        FontSize="12"
                                        IsChecked="{Binding IsHttpInvoke}"
                                        ToolTip="勾选后才允许经 /flow/{流程名} 接口触发（唯一门禁位）" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="InvokeSummary"
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextMutedBrush}"
                                    Text="{Binding InvokeTypeText}" />
                                <TextBlock
                                    x:Name="PendingNote"
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    Text="{Binding PendingReasonText}" />
                            </StackPanel>
                            <!--  仓库实测：DataTemplate.Triggers 里的 DataTrigger 可靠；空串时收起"待接通"行  -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding PendingReasonText}" Value="">
                                    <Setter TargetName="PendingNote" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding Flow.Description}"
                    Header="描述"
                    IsReadOnly="True" />

                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding StatusText}"
                    Header="状态"
                    IsReadOnly="True" />

                <DataGridTemplateColumn Width="230" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--
                                行内动作做成胶囊软色块（DialogChipButton）：
                                文字留着（纯图标分不清加密与解密），但不像普通按钮那样抢视线。
                                底色与字色按语义成对给 —— 危险动作（解密）走浅红底 + 红字。
                            -->
                            <StackPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Command="{Binding DataContext.EncryptFlowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="加密"
                                    Style="{StaticResource DialogChipButton}"
                                    Background="{StaticResource DialogAccentLightBrush}"
                                    Foreground="{StaticResource DialogAccentTextBrush}"
                                    ToolTip="加密流程内容，未授权者无法查看" />

                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding DataContext.DecryptFlowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="解密"
                                    Style="{StaticResource DialogChipButton}"
                                    Background="{StaticResource DialogDangerSubtleBrush}"
                                    Foreground="{StaticResource DialogDangerBrush}"
                                    ToolTip="解除加密，恢复为可编辑状态" />

                                <Button
                                    Margin="8,0,0,0"
                                    Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding EnabledText}"
                                    Style="{StaticResource DialogChipButton}"
                                    Background="{StaticResource DialogRowHoverBrush}"
                                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                                    ToolTip="启用/禁用：控制流程是否参与自动调用" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--  底部说明：三条口径写清楚，省得使用者去翻文档  -->
        <Border
            Grid.Row="3"
            Margin="20,14,20,16"
            Style="{StaticResource DialogInfoPanel}">
            <StackPanel>
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextSecondaryBrush}"
                    Text="说明" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource DialogHintText}"
                    Text="· 启用/禁用：控制流程是否参与自动调用" />
                <TextBlock
                    Margin="0,3,0,0"
                    Style="{StaticResource DialogHintText}"
                    Text="· 加密/解密：保护流程内容不被未授权访问" />
                <TextBlock
                    Margin="0,3,0,0"
                    Style="{StaticResource DialogHintText}"
                    Text="· 调用方式（多选）：HTTP = 允许经 /flow/{流程名} 触发；定时 = 按间隔周期跑（下限 20ms）；变量 = 指定变量由假变真时跑；子程序 = 允许被其它流程的「调用流程」步骤调用" />
                <TextBlock
                    Margin="0,3,0,0"
                    Style="{StaticResource DialogHintText}"
                    Text="· 强制流程：Home / Main / End 三条骨架流程每个方案都必须保留，不允许删除（可改名）" />
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
