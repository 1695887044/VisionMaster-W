<Window
    x:Class="VisionMaster.Views.ScadaRuntimeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VisionMaster.Scada.Controls;assembly=VM.Scada.Controls"
    Title="{Binding CurrentPage.Name, StringFormat=组态运行 - {0}}"
    Width="1280"
    Height="800"
    Background="#FF16191D"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <!--  ============================================================  -->
    <!--  组态运行态窗口（S4）  -->
    <!--  DataContext 是一个 ScadaRuntime，本窗口只读它的 CurrentPage 去摆画布。  -->
    <!--  -->
    <!--  这里刻意没有视图模型：窗口全部可见状态都来自运行会话本身（哪一页、多大、  -->
    <!--  什么底色），再造一层 VM 只是把绑定抄一遍，还会多出一个"谁负责同步"的问题。  -->
    <!--  运行策略（单实例、什么时候停、日志写什么）全在 ScadaRuntimeHost，  -->
    <!--  本窗口连"我在运行"这件事都不判断——它只是被 Show 出来的一块壳。  -->
    <!--  -->
    <!--  窗口形态（无边框最大化 / 带系统标题栏的独立窗口）刻意不写在这里：它由软件配置  -->
    <!--  RunWindowMode 决定，见代码里的 ApplyRunWindowMode——"盖不盖住主界面"和"单实例、  -->
    <!--  什么时候停"一样属于运行策略，写死在 XAML 里就等于把它钉回了编译期。  -->
    <!--  这里不写 WindowStyle/WindowState/ResizeMode：WPF 的默认值本身就是独立窗口形态，  -->
    <!--  万一哪条路径漏调了 ApplyRunWindowMode，退化的也是一个正常窗口，而不是全屏覆盖。  -->
    <!--  ============================================================  -->

    <Window.Resources>
        <SolidColorBrush x:Key="BarBrush" Color="#FF22262C" />
        <SolidColorBrush x:Key="BarLineBrush" Color="#FF33383F" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFD6DAE0" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF8A929E" />
        <SolidColorBrush x:Key="StopBrush" Color="#FFC0392B" />

        <!--  顶/底条上的普通文字：统一字号与颜色，省得每处写一遍  -->
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>

        <!--  停止运行：唯一出口，所以做成实心红色块，一眼能看到  -->
        <Style TargetType="Button" x:Key="StopButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource StopBrush}" />
            <Setter Property="BorderBrush" Value="#FFE05A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFD9453A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFA5342A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ====================  顶部条：当前画面 + 唯一出口  ====================  -->
        <!--  没有关闭按钮、也刻意不给 Esc 绑命令：运行态退出必须是一个看得见的动作，  -->
        <!--  操作员在触摸屏上按键盘是退不掉的，但鼠标永远能点到"停止运行"。  -->
        <!--  （Alt+F4 之类的系统关闭路径不拦：它同样会走 Closed，宿主在那里收尾，状态不会脏。）  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource BarBrush}"
            BorderBrush="{StaticResource BarLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    FontSize="12"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="运行画面"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"
                    Text="{Binding CurrentPage.Name}"
                    VerticalAlignment="Center" />

                <Button
                    Grid.Column="3"
                    Click="OnStopClick"
                    Content="■ 停止运行"
                    Style="{StaticResource StopButton}"
                    ToolTip="结束运行并回到组态编辑器" />
            </Grid>
        </Border>

        <!--  ====================  画面区  ====================  -->
        <!--  IsReadOnly=True 是这个窗口与编辑器唯一的区别：不吃选中、不能拖动改尺寸，  -->
        <!--  图元自己的交互（按钮按下、值变化）照常工作。运行态不复写一套交互状态机，  -->
        <!--  否则"设计时看到的"和"运行时跑出来的"迟早对不上。  -->
        <!--  网格与吸附都是"设计辅助"，运行态一律关掉：操作员不该看见画格子。  -->
        <Grid Grid.Row="1" Margin="16">
            <controls:ScadaCanvas
                x:Name="Canvas"
                IsReadOnly="True"
                ItemsSource="{Binding CurrentPage.Elements}"
                Page="{Binding CurrentPage}"
                PageBackground="{Binding CurrentPage.Background}"
                PageHeight="{Binding CurrentPage.Height}"
                PageWidth="{Binding CurrentPage.Width}"
                ShowGrid="False"
                SizeChanged="OnCanvasSizeChanged"
                SnapToGrid="False" />
        </Grid>

        <!--  ====================  底部状态条  ====================  -->
        <Border
            Grid.Row="2"
            Height="26"
            Background="{StaticResource BarBrush}"
            BorderBrush="{StaticResource BarLineBrush}"
            BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="{Binding CurrentPage.Width, StringFormat=设计 {0:0}}" />
                    <TextBlock
                        Margin="2,0,0,0"
                        Style="{StaticResource MutedText}"
                        Text="{Binding CurrentPage.Height, StringFormat=× {0:0}}" />
                    <TextBlock
                        x:Name="ViewportText"
                        Margin="16,0,0,0"
                        Style="{StaticResource MutedText}"
                        Text="视口 —" />
                    <TextBlock
                        x:Name="FitText"
                        Margin="16,0,0,0"
                        Style="{StaticResource MutedText}"
                        Text="适配 —" />
                </StackPanel>

                <!--  耗时由宿主在首帧渲染完成后回填：真正的"加载完成"发生在渲染之后，  -->
                <!--  领域层拿不到那一帧，所以这个数字只能由窗口这一侧报出来。  -->
                <TextBlock
                    x:Name="ElapsedText"
                    HorizontalAlignment="Right"
                    Foreground="{StaticResource MutedTextBrush}"
                    FontSize="12"
                    FontFamily="Consolas, Microsoft YaHei UI"
                    VerticalAlignment="Center"
                    Text="加载耗时 —" />
            </Grid>
        </Border>
    </Grid>
</Window>
