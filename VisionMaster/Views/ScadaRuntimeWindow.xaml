<Window
    x:Class="VisionMaster.Views.ScadaRuntimeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VisionMaster.Scada.Controls;assembly=VM.Scada.Controls"
    xmlns:views="clr-namespace:VisionMaster.Views"
    Title="{Binding CurrentPage.Name, StringFormat=组态运行 - {0}}"
    Width="1280"
    Height="800"
    PreviewKeyDown="OnWindowPreviewKeyDown"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <!--  ============================================================  -->
    <!--  组态运行态窗口（S4）  -->
    <!--  DataContext 是一个 ScadaRuntime，本窗口只读它的 CurrentPage 去摆画布。  -->
    <!--  -->
    <!--  这里刻意没有视图模型：窗口全部可见状态都来自运行会话本身（哪一页、多大、  -->
    <!--  什么底色），再造一层 VM 只是把绑定抄一遍，还会多出一个"谁负责同步"的问题。  -->
    <!--  运行策略（单实例、什么时候停、日志写什么）全在 ScadaRuntimeHost，  -->
    <!--  本窗口连"我在运行"这件事都不判断——它只是被 Show 出来的一块壳。  -->
    <!--  -->
    <!--  窗口形态（无边框最大化 / 带系统标题栏的独立窗口）刻意不写在这里：它由软件配置  -->
    <!--  RunWindowMode 决定，见代码里的 ApplyRunWindowMode——"盖不盖住主界面"和"单实例、  -->
    <!--  什么时候停"一样属于运行策略，写死在 XAML 里就等于把它钉回了编译期。  -->
    <!--  这里不写 WindowStyle/WindowState/ResizeMode：WPF 的默认值本身就是独立窗口形态，  -->
    <!--  万一哪条路径漏调了 ApplyRunWindowMode，退化的也是一个正常窗口，而不是全屏覆盖。  -->
    <!--  ============================================================  -->

    <Window.Resources>
        <ResourceDictionary>
            <!--
                就地合并 Colors.xaml：本窗口在断言宿主里也会被 new 出来（ScadaChecks 多处），
                那些宿主没有 Application、没有应用级资源字典，不合并会在解析期抛「找不到资源」（R22/R94）。
                深色配色令牌全部在 UI/Controls/Themes/Colors.xaml 的「组态运行态窗口」一节（R140）。
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  顶条「报警历史」徽标的显隐转换器：有未确认报警时才亮出来  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  顶/底条上的普通文字：统一字号与颜色，省得每处写一遍  -->
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaRunTextBrush}" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaRunMutedTextBrush}" />
        </Style>

        <!--  底条上的取景入口：运行态滚轮不缩放（见 ScadaCanvas.OnMouseWheel），
              画面被中键平移挪开之后，这里是唯一的"一键回到整幅"入口。
              做成按钮而不是纯文字：现场没人会去点一行看起来只是状态的字。  -->
        <Style x:Key="FitButton" TargetType="Button">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaRunMutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ScadaRunControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ScadaRunTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunControlBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  停止运行：唯一出口，所以做成实心红色块，一眼能看到  -->
        <Style TargetType="Button" x:Key="StopButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{StaticResource ScadaRunStopBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ScadaRunStopBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunStopHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunStopPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  「报警历史」开关：按下去 = 抽屉开着。
              用 ToggleButton 而不是 Button：这个按钮有<b>两个状态</b>（面板开 / 关），
              用普通按钮就得靠代码去改文字或底色来告诉用户"现在是开的"，而 ToggleButton
              自带 IsChecked，选中态直接写在模板触发器里。
              底色刻意用中性灰（不用红色）：红色在这个顶条上已经被"停止运行"占住了，
              两个红块并排会让操作员在最需要找出口的时候分神。  -->
        <Style x:Key="AlarmToggleButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaRunTextBrush}" />
            <Setter Property="Background" Value="{StaticResource ScadaRunControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ScadaRunControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunToggleOnBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScadaRunAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  顶条「页面」下拉：Button + ContextMenu。
             为什么不用 ComboBox：Fluent 主题的 ComboBox 弹层是浅色的，和这条深色运行顶栏对不上；
             页面切换也不需要“可编辑/可输入”，一个按钮 + 菜单就够，且样式完全可控。  -->
        <Style x:Key="PageMenuButton" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ScadaRunTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunControlBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ScadaRunControlBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            页面菜单的深色外观：显式 key，只作用于页面菜单，不污染窗口里其它右键菜单。
            为什么不用隐式样式：隐式 MenuItem 样式会整条顶掉应用级模板，悬停项会落回
            浅底浅字的默认模板（2026-10-21 评审实测）。这里给一份完整的深色模板。
        -->
        <Style x:Key="PageMenuContextStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource ScadaRunBarBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ScadaRunTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ScadaRunBarLineBrush}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="PageMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource ScadaRunTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="Check"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{StaticResource ScadaRunAccentBrush}"
                                    Text="✓"
                                    Visibility="Collapsed" />
                                <!--  RecognizesAccessKey=False：页名里的 "_" 原样显示，不当访问键  -->
                                <ContentPresenter
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScadaRunControlBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!--
        底色挂在根 Grid 上，不写在 <Window Background=...>：Window 自身的属性在解析期先于
        Window.Resources 求值，StaticResource 看不见同一元素后面定义的键（实测抛
        「无法找到名为 ScadaRunWindowBrush 的资源」并带崩 5 段断言）。根 Grid 是子元素，
        资源此时已就绪。无边框最大化时 Grid 铺满客户区，观感与挂在 Window 上一致。
    -->
    <Grid Background="{StaticResource ScadaRunWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ====================  顶部条：当前画面 + 唯一出口  ====================  -->
        <!--  没有关闭按钮、也刻意不给 Esc 绑命令：运行态退出必须是一个看得见的动作，  -->
        <!--  操作员在触摸屏上按键盘是退不掉的，但鼠标永远能点到"停止运行"。  -->
        <!--  （Alt+F4 之类的系统关闭路径不拦：它同样会走 Closed，宿主在那里收尾，状态不会脏。）  -->
        <Border
            Grid.Row="0"
            Background="{StaticResource ScadaRunBarBrush}"
            BorderBrush="{StaticResource ScadaRunBarLineBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    FontSize="12"
                    Foreground="{StaticResource ScadaRunMutedTextBrush}"
                    Text="运行画面"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="PageMenuButton"
                        Click="OnPageMenuClick"
                        Style="{StaticResource PageMenuButton}"
                        ToolTip="切换画面">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="PageMenuText"
                                MaxWidth="220"
                                VerticalAlignment="Center"
                                Text="{Binding CurrentPage.Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding CurrentPage.Name}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource ScadaRunMutedTextBrush}"
                                Text="▾" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PageBackButton"
                        Margin="4,0,0,0"
                        Click="OnPageBackClick"
                        Content="← 返回"
                        FontSize="12"
                        FontWeight="Normal"
                        Foreground="{StaticResource ScadaRunTextBrush}"
                        IsEnabled="{Binding CanGoBack}"
                        Style="{StaticResource PageMenuButton}"
                        ToolTip="回到进入当前页之前的那一页" />
                </StackPanel>

                <!--  ====================  报警历史入口 + 声音  ====================  -->
                <!--  放在"停止运行"左边：顶条右侧是动作区，左侧是"我在看哪一页"的读数区，
                      两者不混。徽标只在有未确认报警时亮出来（数到 0 就整块收掉）——
                      一个永远挂着的"0"会让操作员很快学会无视它。  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <!--  声音开关：左键开关，右键试听/静音。
                          用 ToggleButton 而不是 Button：它有"开/关"两个状态，选中态直接写在模板触发器里，
                          不必靠代码去改底色告诉用户现在是什么状态。  -->
                    <ToggleButton
                        x:Name="SoundToggle"
                        Margin="0,0,8,0"
                        Click="OnSoundToggleClick"
                        Style="{StaticResource AlarmToggleButton}"
                        ToolTip="报警声音（右键：试听 / 静音）">
                        <ToggleButton.ContextMenu>
                            <ContextMenu Opened="OnSoundMenuOpened">
                                <MenuItem x:Name="SoundTestMenuItem" Click="OnSoundTestClick" Header="试听" />
                                <MenuItem x:Name="SoundMuteMenuItem" Click="OnSoundMuteClick" Header="静音 5 分钟" />
                            </ContextMenu>
                        </ToggleButton.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="SoundGlyph"
                                VerticalAlignment="Center"
                                Text="♪" />
                            <TextBlock
                                x:Name="SoundStateText"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Text="声音" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="AlarmHistoryToggle"
                        Click="OnAlarmHistoryClick"
                        Style="{StaticResource AlarmToggleButton}"
                        ToolTip="查看本次运行的报警记录：可搜索、可筛选、可逐条确认、可导出 CSV">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="报警历史" />
                            <Border
                                MinWidth="16"
                                Height="16"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource ScadaRunStopBrush}"
                                CornerRadius="8"
                                Visibility="{Binding DataContext.HasUnacknowledged, ElementName=AlarmHistory, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    Margin="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding DataContext.UnacknowledgedText, ElementName=AlarmHistory}" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <Button
                    Grid.Column="3"
                    Click="OnStopClick"
                    Content="■ 停止运行"
                    Style="{StaticResource StopButton}"
                    ToolTip="结束运行并回到组态编辑器" />
            </Grid>
        </Border>

        <!--  ====================  画面区  ====================  -->
        <!--  IsReadOnly=True 是这个窗口与编辑器唯一的区别：不吃选中、不能拖动改尺寸，  -->
        <!--  图元自己的交互（按钮按下、值变化）照常工作。运行态不复写一套交互状态机，  -->
        <!--  否则"设计时看到的"和"运行时跑出来的"迟早对不上。  -->
        <!--  网格与吸附都是"设计辅助"，运行态一律关掉：操作员不该看见画格子。  -->
        <Grid Grid.Row="1" Margin="16">
            <controls:ScadaCanvas
                x:Name="Canvas"
                BasePages="{Binding CurrentBasePages}"
                IsReadOnly="True"
                ItemsSource="{Binding CurrentPage.Elements}"
                Page="{Binding CurrentPage}"
                PageBackground="{Binding CurrentPage.Background}"
                PageHeight="{Binding CurrentPage.Height}"
                PageWidth="{Binding CurrentPage.Width}"
                ShowGrid="False"
                SizeChanged="OnCanvasSizeChanged"
                SnapToGrid="False" />

            <!--  ====================  弹窗层（特殊画面）  ====================  -->
            <!--  盖在画布之上、但不参与画布的测量（与报警历史抽屉同一条纪律：覆盖层不动画布一寸）。  -->
            <!--  弹窗页仍是普通 ScadaPage，只是 IsPopup=true；关闭后回到原页，CurrentPage 从未变过。  -->
            <Grid
                x:Name="PopupLayer"
                Panel.ZIndex="20"
                SizeChanged="OnPopupLayerSizeChanged"
                Visibility="{Binding IsPopupOpen, Converter={StaticResource BoolToVisibility}}">
                <!--  模态遮罩：挡住背景控件的命中；非模态时收起，主画面仍可操作。  -->
                <Border
                    x:Name="PopupBackdrop"
                    Background="{StaticResource ScadaRunBackdropBrush}"
                    Visibility="{Binding CurrentPopup.PopupModal, Converter={StaticResource BoolToVisibility}}" />

                <Border
                    x:Name="PopupFrame"
                    HorizontalAlignment="Center"
                    MaxHeight="{Binding ActualHeight, ElementName=PopupLayer}"
                    MaxWidth="{Binding ActualWidth, ElementName=PopupLayer}"
                    VerticalAlignment="Center"
                    Background="{StaticResource ScadaRunPopupBrush}"
                    BorderBrush="{StaticResource ScadaRunPopupBorderBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Background="{StaticResource ScadaRunBarBrush}"
                            BorderBrush="{StaticResource ScadaRunBarLineBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid Margin="12,0">
                                <TextBlock
                                    Margin="0,0,36,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaRunTextBrush}"
                                    Text="{Binding CurrentPopup.Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding CurrentPopup.Name}" />
                                <Button
                                    x:Name="PopupCloseButton"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Click="OnPopupCloseClick"
                                    Content="✕"
                                    FontSize="14"
                                    Padding="0"
                                    Style="{StaticResource PageMenuButton}"
                                    ToolTip="关闭弹窗（Esc）" />
                            </Grid>
                        </Border>

                        <Viewbox
                            Grid.Row="1"
                            Stretch="Uniform"
                            StretchDirection="DownOnly">
                            <controls:ScadaCanvas
                                x:Name="PopupCanvas"
                                Width="{Binding CurrentPopup.Width}"
                                Height="{Binding CurrentPopup.Height}"
                                BasePages="{Binding CurrentPopupBasePages}"
                                IsReadOnly="True"
                                ItemsSource="{Binding CurrentPopup.Elements}"
                                Page="{Binding CurrentPopup}"
                                PageBackground="{Binding CurrentPopup.Background}"
                                PageHeight="{Binding CurrentPopup.Height}"
                                PageWidth="{Binding CurrentPopup.Width}"
                                ShowGrid="False"
                                SnapToGrid="False" />
                        </Viewbox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  ====================  报警历史抽屉（覆盖层）  ====================  -->
        <!--  只占第 1 行：顶条与底条都留在外面。
              顶条必须留着——"停止运行"是唯一出口，被抽屉盖住就等于运行态出不去；
              底条的视口/适配读数也留着，抽屉里的东西与它们不冲突。  -->
        <!--  声明在画布之后 = 画在画布之上（同一 Grid 里后声明的在上），但<b>不参与</b>画布的测量：
              加列或改 Margin 都会让画布 SizeChanged → FitToScreen → 整个画面重新缩放，
              操作员打开报警历史时画面"跳一下"。覆盖层不动画布一寸。  -->
        <views:ScadaAlarmHistoryView x:Name="AlarmHistory" Grid.Row="1" />

        <!--  ====================  底部状态条  ====================  -->
        <Border
            Grid.Row="2"
            Height="26"
            Background="{StaticResource ScadaRunBarBrush}"
            BorderBrush="{StaticResource ScadaRunBarLineBrush}"
            BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <TextBlock
                        Style="{StaticResource MutedText}"
                        Text="{Binding CurrentPage.Width, StringFormat=设计 {0:0}}" />
                    <TextBlock
                        Margin="2,0,0,0"
                        Style="{StaticResource MutedText}"
                        Text="{Binding CurrentPage.Height, StringFormat=× {0:0}}" />
                    <TextBlock
                        x:Name="ViewportText"
                        Margin="16,0,0,0"
                        Style="{StaticResource MutedText}"
                        Text="视口 —" />
                    <Button
                        x:Name="FitButton"
                        Click="OnFitClick"
                        Content="适配 —"
                        Style="{StaticResource FitButton}"
                        ToolTip="适应窗口：整幅画面等比放进视口（运行态滚轮不缩放，用中键可平移）" />
                    <!--  当前操作者 + 角色（S12）。  -->
                    <!--  运行窗口有无边框最大化形态，那时主界面状态栏整条都被盖住——  -->
                    <!--  权限不够被拦下时（"需要「工程师」权限，当前是「操作员」"），  -->
                    <!--  操作员至少要在这一条上看到自己现在是哪一档，才知道该去找谁。  -->
                    <!--  读的是会话自己那份策略（ScadaRuntime.AccessPolicy），  -->
                    <!--  与判定权限用的必然是同一样东西。  -->
                    <TextBlock
                        Margin="16,0,0,0"
                        Style="{StaticResource MutedText}"
                        Text="{Binding AccessPolicy.LoginStateText, StringFormat=操作者 {0}}" />
                </StackPanel>

                <!--  耗时由宿主在首帧渲染完成后回填：真正的"加载完成"发生在渲染之后，  -->
                <!--  领域层拿不到那一帧，所以这个数字只能由窗口这一侧报出来。  -->
                <TextBlock
                    x:Name="ElapsedText"
                    HorizontalAlignment="Right"
                    Foreground="{StaticResource ScadaRunMutedTextBrush}"
                    FontSize="12"
                    FontFamily="Consolas, Microsoft YaHei UI"
                    VerticalAlignment="Center"
                    Text="加载耗时 —" />
            </Grid>
        </Border>

        <!--  ====================  软键盘层（数字 / 字符）  ====================  -->
        <!--  放在根 Grid、跨三行、ZIndex 40：必须压住报警历史抽屉（它是根 Grid 的兄弟）， -->
        <!--  也必须覆盖顶/底栏——点顶栏同样算“点键盘外”，先取消本次编辑，不能把半截输入提交掉。  -->
        <Grid
            x:Name="KeyboardLayer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="40"
            SizeChanged="OnKeyboardLayerSizeChanged"
            Visibility="Collapsed">
            <Border
                x:Name="KeyboardBackdrop"
                Background="Transparent"
                MouseLeftButtonDown="OnKeyboardBackdropClick" />
            <Canvas>
                <controls:ScadaSoftKeyboard
                    x:Name="SoftKeyboard"
                    SizeChanged="OnSoftKeyboardSizeChanged" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
