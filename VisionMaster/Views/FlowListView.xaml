<UserControl
    x:Class="VisionMaster.Views.FlowListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    d:DesignHeight="600"
    d:DesignWidth="250"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ui:BindingProxy x:Key="MyViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Background="{StaticResource DialogSurfaceBrush}">
        <ListBox
            x:Name="FlowList"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Workspace.CurrentSolution.Flows}"
            PreviewMouseRightButtonUp="FlowList_PreviewMouseRightButtonUp"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectFlow}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,6,6" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="ItemBorder"
                                    MinHeight="40"
                                    Padding="8,0"
                                    Background="{StaticResource DialogSurfaceBrush}"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource LogicIfSoftBrush}" />
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource LogicIfBorderBrush}" />
                                        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--  flow-logic 流程胶囊：状态点 + 名称 + 步数；描述/完整信息进 Tooltip  -->
                    <Grid Background="Transparent" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="FlowDot"
                            Grid.Column="0"
                            Width="7"
                            Height="7"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource FlowCanvasSuccessBrush}" />
                        <TextBlock
                            x:Name="NameText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{StaticResource ScadaTextBrush}"
                            Text="{Binding FlowName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CountText"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="9.5"
                            Foreground="{StaticResource ScadaSecondaryTextBrush}"
                            Text="{Binding Steps.Count}" />
                        <TextBlock
                            x:Name="DisabledTag"
                            Grid.Column="3"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="9"
                            Foreground="{StaticResource DialogDangerBrush}"
                            Text="禁用"
                            Visibility="Collapsed" />
                        <!--  运行标记：与「禁用」同格（禁用流程不可能在跑，两者互斥）。
                              真值来自 FlowModel.RunState——ShellViewModel 按会话状态镜像它，
                              涵盖界面运行 / 单流程运行 / HTTP / 定时触发，所以这里不必认识会话。  -->
                        <TextBlock
                            x:Name="RunningTag"
                            Grid.Column="3"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource FlowCanvasSuccessBrush}"
                            Text="运行中"
                            Visibility="Collapsed" />
                        <Grid.ContextMenu>
                            <ContextMenu FontFamily="{StaticResource Icon}">
                                <MenuItem Header="流程" Icon="&#xf0e8;">
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Create}"
                                        Header="添加"
                                        Icon="&#xf56f;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Delete}"
                                        Header="删除"
                                        Icon="&#xf2ed;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Rename}"
                                        Header="重命名"
                                        Icon="&#xf044;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.EditComment}"
                                        Header="编辑注释"
                                        Icon="&#xf075;" />
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.ToggleEnabled}"
                                        Header="{Binding Data.FlowToggleHeader, Source={StaticResource MyViewModelProxy}}"
                                        Icon="ban" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Compile}"
                                        Header="编译本流程"
                                        Icon="&#xf0e7;" />
                                    <Separator />
                                    <!--
                                        单流程运行/停止（非调试路径：与 HTTP 触发同口径，断点不生效）。
                                        停止放在运行下面：先跑后停的阅读顺序，与主界面停机键的位置无关，
                                        这里只服务于"我就想单独把这条流程跑起来看看"的场景。
                                    -->
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.RunOnce}"
                                        Header="运行一次"
                                        Icon="&#xf04b;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.RunContinuous}"
                                        Header="循环运行"
                                        Icon="&#xf021;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Stop}"
                                        Header="停止本流程"
                                        Icon="&#xf04d;" />
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                    CommandParameter="{x:Static enums:FlowAction.Manager}"
                                    Header="流程管理"
                                    Icon="&#xf09c;" />
                                <MenuItem
                                    Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                    CommandParameter="{x:Static enums:FlowAction.VariableEvents}"
                                    Header="变量事件（方案级）"
                                    Icon="&#xf0f3;" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                    <!--  禁用态放 DataTemplate.Triggers：本仓库实测 ControlTemplate.Triggers 里的 DataTrigger 对模板内元素静默失效  -->
                    <DataTemplate.Triggers>
                        <!--  运行中：名称加粗 + 右侧「运行中」标记。
                              状态点表达的是"启用 / 禁用"（绿点 / 灰点 + 禁用标签），不再兼任运行态——
                              两者语义不同：一个说"这条流程能不能跑"，一个说"它现在是不是在跑"。  -->
                        <DataTrigger Binding="{Binding RunState}" Value="Running">
                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="RunningTag" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!--  已暂停：同位置换「已暂停」，点与文字转主色（与运行条的暂停色一致）  -->
                        <DataTrigger Binding="{Binding RunState}" Value="Paused">
                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="FlowDot" Property="Fill" Value="{StaticResource DialogAccentBrush}" />
                            <Setter TargetName="RunningTag" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RunningTag" Property="Text" Value="已暂停" />
                            <Setter TargetName="RunningTag" Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="FlowDot" Property="Fill" Value="{StaticResource ScadaDisabledTextBrush}" />
                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                            <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                            <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                            <Setter TargetName="DisabledTag" Property="Visibility" Value="Visible" />
                            <!--  禁用流程不可能在跑；万一模型里留着旧的 Running 镜像，也不许和「禁用」挤在同一格  -->
                            <Setter TargetName="RunningTag" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
