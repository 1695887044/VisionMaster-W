<UserControl
    x:Class="VisionMaster.Views.FlowListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:VisionMaster"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    d:DesignHeight="600"
    d:DesignWidth="250"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ui:BindingProxy x:Key="MyViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Background="#FFFFFF">
        <ListBox
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Workspace.CurrentSolution.Flows}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectFlow}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2,0,2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="ItemBorder"
                                    Padding="10,8"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F0F4F8" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#E5F1FB" />
                                        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--  精简两列：图标 + 名称（描述与完整信息进 Tooltip）  -->
                    <Grid Background="Transparent" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="16"
                            Foreground="#007ACC"
                            Text="&#xf1c9;" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#333333"
                            Text="{Binding FlowName}"
                            TextTrimming="CharacterEllipsis" />
                        <Grid.ContextMenu>
                            <ContextMenu FontFamily="{StaticResource Icon}">
                                <MenuItem Header="流程" Icon="&#xf0e8;">
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Create}"
                                        Header="添加"
                                        Icon="&#xf56f;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Delete}"
                                        Header="删除"
                                        Icon="&#xf2ed;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Rename}"
                                        Header="重命名"
                                        Icon="&#xf044;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.EditComment}"
                                        Header="编辑注释"
                                        Icon="&#xf075;" />
                                </MenuItem>
                                <MenuItem Header="流程加密" Icon="&#xf132;">
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Encrypt}"
                                        Header="加密流程"
                                        Icon="&#xf023;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Decrypt}"
                                        Header="解密流程"
                                        Icon="&#xf09c;" />
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                    CommandParameter="{x:Static enums:FlowAction.Manager}"
                                    Header="流程管理"
                                    Icon="&#xf09c;" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
