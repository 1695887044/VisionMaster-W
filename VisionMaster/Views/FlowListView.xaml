<UserControl
    x:Class="VisionMaster.Views.FlowListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    d:DesignHeight="600"
    d:DesignWidth="250"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ui:BindingProxy x:Key="MyViewModelProxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Background="#FFFFFF">
        <ListBox
            x:Name="FlowList"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding Workspace.CurrentSolution.Flows}"
            PreviewMouseRightButtonUp="FlowList_PreviewMouseRightButtonUp"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectFlow}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,2,0,2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="ItemBorder"
                                    Padding="10,8"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#F0F4F8" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#E5F1FB" />
                                        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--  精简三列：图标 + 名称 + 禁用小标签（描述与完整信息进 Tooltip）  -->
                    <Grid Background="Transparent" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="FlowIcon"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Icon}"
                            FontSize="16"
                            Foreground="#007ACC"
                            Text="&#xf1c9;" />
                        <TextBlock
                            x:Name="NameText"
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#333333"
                            Text="{Binding FlowName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="DisabledTag"
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#F56C6C"
                            Text="已禁用"
                            Visibility="Collapsed" />
                        <Grid.ContextMenu>
                            <ContextMenu FontFamily="{StaticResource Icon}">
                                <MenuItem Header="流程" Icon="&#xf0e8;">
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Create}"
                                        Header="添加"
                                        Icon="&#xf56f;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Delete}"
                                        Header="删除"
                                        Icon="&#xf2ed;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Rename}"
                                        Header="重命名"
                                        Icon="&#xf044;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.EditComment}"
                                        Header="编辑注释"
                                        Icon="&#xf075;" />
                                    <Separator />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.ToggleEnabled}"
                                        Header="{Binding Data.FlowToggleHeader, Source={StaticResource MyViewModelProxy}}"
                                        Icon="ban" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Compile}"
                                        Header="编译本流程"
                                        Icon="&#xf0e7;" />
                                    <Separator />
                                    <!--
                                        单流程运行/停止（非调试路径：与 HTTP 触发同口径，断点不生效）。
                                        停止放在运行下面：先跑后停的阅读顺序，与主界面停机键的位置无关，
                                        这里只服务于"我就想单独把这条流程跑起来看看"的场景。
                                    -->
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.RunOnce}"
                                        Header="运行一次"
                                        Icon="&#xf04b;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.RunContinuous}"
                                        Header="循环运行"
                                        Icon="&#xf021;" />
                                    <MenuItem
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Stop}"
                                        Header="停止本流程"
                                        Icon="&#xf04d;" />
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                    CommandParameter="{x:Static enums:FlowAction.Manager}"
                                    Header="流程管理"
                                    Icon="&#xf09c;" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                    <!--  禁用态放 DataTemplate.Triggers：本仓库实测 ControlTemplate.Triggers 里的 DataTrigger 对模板内元素静默失效  -->
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter TargetName="FlowIcon" Property="Foreground" Value="#C0C4CC" />
                            <Setter TargetName="NameText" Property="Foreground" Value="#909399" />
                            <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                            <Setter TargetName="DisabledTag" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
