<UserControl
    x:Class="VisionMaster.Views.FlowListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    d:DesignHeight="600"
    d:DesignWidth="250"
    mc:Ignorable="d"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!--
            设计基线：docs/UI设计基线/flow-list/ v2（2026-10-22 复刻）。

            高度是硬约束：ProcessView.xaml:290 把本控件固定为 Height="112"，
            左栏宽度 340（Shell.xaml:1052）。所以胶囊必须是**单行 22px**：
            6(上内距) + 22×3 + 4×2 + 26(底栏) = 106 ≤ 110（扣掉上下边框）。
            v1 的两行式（46px）装不下，已作废。
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI;component/Themes/Colors.xaml" />
                <!--  右键菜单样式（设计基线 flow-context-menu v1）：就地合并而不是靠应用级，
                      无 Application 的断言宿主里也能解析（R22 同一手法）。  -->
                <ResourceDictionary Source="/UI;component/Themes/Controls/StepContextMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:BindingProxy x:Key="MyViewModelProxy" Data="{Binding}" />

            <!--  底栏「全部 ›」文字链接：本视图不引 Dialog 分册（断言宿主无 App 级字典）  -->
            <Style x:Key="FlowFootLink" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource DialogSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox
                x:Name="FlowList"
                Grid.Row="0"
                Margin="6,6,6,0"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Workspace.CurrentSolution.Flows}"
                PreviewMouseRightButtonUp="FlowList_PreviewMouseRightButtonUp"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectFlow}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,4,4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border
                                            x:Name="ItemBorder"
                                            Height="24"
                                            Padding="7,0"
                                            Background="{StaticResource DialogSurfaceBrush}"
                                            BorderBrush="{StaticResource DialogBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <!--  选中左条：2px，上下内缩 3px，贴着圆角内侧  -->
                                        <Border
                                            x:Name="SelBar"
                                            Width="2"
                                            Margin="1,3,0,3"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource DialogAccentBrush}"
                                            CornerRadius="1"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource DialogBorderStrongBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                            <Setter TargetName="SelBar" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <!--  键盘焦点必须可见（R115）  -->
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource DialogAccentBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!--  单行：状态点 + 名称 + 角色徽标 + 运行脉冲点 + 步数  -->
                        <Grid x:Name="PillRoot" Background="Transparent" ToolTip="{Binding Description}">
                            <Grid.ContextMenu>
                                <!--
                                    设计基线：docs/UI设计基线/flow-context-menu/ v1（2026-10-27）。
                                    320 宽 / 32 行 / 20px 图标底片 / 四组平铺（流程 · 配置 · 运行 · 方案）。
                                    12 项与 FlowAction 一一对应；禁用态与徽标由 FlowListViewModel 的只读属性驱动。
                                -->
                                <ContextMenu
                                    Style="{StaticResource FlowContextMenuStyle}"
                                    ui:MenuItemEx.Footer="{Binding Data.FlowMenuFooter, Source={StaticResource MyViewModelProxy}}">

                                    <Separator Style="{StaticResource FlowMenuGroupHeaderStyle}" Tag="流程" />

                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Create}"
                                        Header="添加流程"
                                        Icon="&#xf067;"
                                        ToolTip="在当前流程之后插入一条新流程"
                                        ui:MenuItemEx.Tone="Accent" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Rename}"
                                        Header="重命名"
                                        Icon="&#xf044;"
                                        ToolTip="修改流程名（运行标识，必须唯一）"
                                        ui:MenuItemEx.Tone="Slate" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.EditComment}"
                                        Header="编辑注释"
                                        Icon="&#xf075;"
                                        ToolTip="补充这条流程的用途说明"
                                        ui:MenuItemEx.Tone="Slate" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Delete}"
                                        Header="删除"
                                        Icon="&#xf2ed;"
                                        IsEnabled="{Binding Data.CanDeleteFlow, Source={StaticResource MyViewModelProxy}}"
                                        ToolTip="{Binding Data.DeleteFlowToolTip, Source={StaticResource MyViewModelProxy}}"
                                        ui:MenuItemEx.Tone="Danger" />

                                    <Separator Style="{StaticResource FlowMenuGroupHeaderStyle}" Tag="配置" />

                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.ToggleEnabled}"
                                        Header="{Binding Data.FlowToggleHeader, Source={StaticResource MyViewModelProxy}}"
                                        Icon="{Binding Data.FlowToggleIcon, Source={StaticResource MyViewModelProxy}}"
                                        ToolTip="启用 / 禁用这条流程（禁用后不参与自动触发，手动运行也会被拦截）"
                                        ui:MenuItemEx.Badge="{Binding Data.FlowStateBadge, Source={StaticResource MyViewModelProxy}}"
                                        ui:MenuItemEx.Tone="Amber" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Compile}"
                                        Header="编译本流程"
                                        Icon="&#xf0e7;"
                                        IsEnabled="{Binding Data.CanCompileFlow, Source={StaticResource MyViewModelProxy}}"
                                        ToolTip="{Binding Data.CompileFlowToolTip, Source={StaticResource MyViewModelProxy}}"
                                        ui:MenuItemEx.Tone="Slate" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.BatchDisplayWindow}"
                                        Header="批量设置显示窗口"
                                        Icon="&#xf2d0;"
                                        IsEnabled="{Binding Data.CanBatchDisplayWindow, Source={StaticResource MyViewModelProxy}}"
                                        ToolTip="{Binding Data.BatchDisplayWindowToolTip, Source={StaticResource MyViewModelProxy}}"
                                        ui:MenuItemEx.Tone="Indigo" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.ResultSource}"
                                        Header="运行统计…"
                                        Icon="&#xf201;"
                                        ToolTip="配置本轮 OK/NG 的判定来源（结果输出步骤 / 变量 / 步骤端口）；下一轮生效"
                                        ui:MenuItemEx.Tone="Slate" />

                                    <Separator Style="{StaticResource FlowMenuGroupHeaderStyle}" Tag="运行" />

                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.RunOnce}"
                                        Header="运行一次"
                                        Icon="&#xf04b;"
                                        IsEnabled="{Binding Data.CanRunFlow, Source={StaticResource MyViewModelProxy}}"
                                        ToolTip="{Binding Data.RunFlowToolTip, Source={StaticResource MyViewModelProxy}}"
                                        ui:MenuItemEx.Tone="Green" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.RunContinuous}"
                                        Header="循环运行"
                                        Icon="&#xf021;"
                                        IsEnabled="{Binding Data.CanRunFlow, Source={StaticResource MyViewModelProxy}}"
                                        ToolTip="{Binding Data.RunFlowToolTip, Source={StaticResource MyViewModelProxy}}"
                                        ui:MenuItemEx.Tone="Green" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Stop}"
                                        Header="停止本流程"
                                        Icon="&#xf04d;"
                                        IsEnabled="{Binding Data.CanStopFlow, Source={StaticResource MyViewModelProxy}}"
                                        ToolTip="{Binding Data.StopFlowToolTip, Source={StaticResource MyViewModelProxy}}"
                                        ui:MenuItemEx.Tone="Danger" />

                                    <Separator Style="{StaticResource FlowMenuGroupHeaderStyle}" Tag="方案" />

                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.Manager}"
                                        Header="流程管理"
                                        Icon="&#xf09c;"
                                        ToolTip="批量查看与管理方案内所有流程"
                                        ui:MenuItemEx.Tone="Slate" />
                                    <MenuItem
                                        Style="{StaticResource FlowMenuItemStyle}"
                                        Command="{Binding Data.FlowCommand, Source={StaticResource MyViewModelProxy}}"
                                        CommandParameter="{x:Static enums:FlowAction.VariableEvents}"
                                        Header="变量事件（方案级）"
                                        Icon="&#xf0f3;"
                                        ToolTip="配置方案级变量变化触发的动作"
                                        ui:MenuItemEx.Tone="Slate" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  角色/调用徽标合一：零 / 主 / 尾 / 外部 / 子 / 循环（角色优先）  -->
                            <Border
                                x:Name="KindBadge"
                                Grid.Column="0"
                                Height="14"
                                Margin="0,0,5,0"
                                Padding="3,0"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                CornerRadius="3"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="KindText"
                                    FontSize="9"
                                    Text="" />
                            </Border>

                            <TextBlock
                                x:Name="NameText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource ScadaTextBrush}"
                                Text="{Binding FlowName}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  运行/暂停标记：5px；失败点需要运行期失败数据，本轮不实现  -->
                            <Ellipse
                                x:Name="RunDot"
                                Grid.Column="2"
                                Width="5"
                                Height="5"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource FlowCanvasSuccessBrush}"
                                Visibility="Collapsed" />

                            <TextBlock
                                x:Name="CountText"
                                Grid.Column="3"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                Text="{Binding Steps.Count}" />
                        </Grid>
                        <!--  禁用态放 DataTemplate.Triggers：本仓库实测 ControlTemplate.Triggers 里的 DataTrigger 对模板内元素静默失效  -->
                        <DataTemplate.Triggers>
                            <!--  调用徽标先写，角色徽标后写：两者同时命中时角色优先（主 > 外部 > 子 > 循环）  -->
                            <DataTrigger Binding="{Binding CallBadgeText}" Value="循环">
                                <Setter TargetName="KindBadge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource LogicIfSoftBrush}" />
                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="{StaticResource LogicIfBorderBrush}" />
                                <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource LogicIfTextBrush}" />
                                <Setter TargetName="KindText" Property="Text" Value="循环" />
                                <Setter TargetName="KindBadge" Property="ToolTip" Value="{Binding CallBadgeToolTip}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CallBadgeText}" Value="外部">
                                <Setter TargetName="KindBadge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource DialogAccentLightBrush}" />
                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="{StaticResource DialogAccentBorderBrush}" />
                                <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource DialogAccentTextBrush}" />
                                <Setter TargetName="KindText" Property="Text" Value="外部" />
                                <Setter TargetName="KindBadge" Property="ToolTip" Value="{Binding CallBadgeToolTip}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CallBadgeText}" Value="子">
                                <Setter TargetName="KindBadge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource DialogWarningSubtleBrush}" />
                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="{StaticResource DialogWarningBorderBrush}" />
                                <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                <Setter TargetName="KindText" Property="Text" Value="子" />
                                <Setter TargetName="KindBadge" Property="ToolTip" Value="{Binding CallBadgeToolTip}" />
                            </DataTrigger>

                            <!--  角色徽标：Home/End 两条骨架流程各一个字；排在调用徽标之后，命中即覆盖  -->
                            <DataTrigger Binding="{Binding Role}" Value="Home">
                                <Setter TargetName="KindBadge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource LogicCaseSoftBrush}" />
                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="{StaticResource LogicCaseBorderBrush}" />
                                <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource LogicCaseTextBrush}" />
                                <Setter TargetName="KindText" Property="Text" Value="零" />
                                <Setter TargetName="KindBadge" Property="ToolTip" Value="回零（Home）" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="End">
                                <Setter TargetName="KindBadge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource LogicWhileSoftBrush}" />
                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="{StaticResource LogicWhileBorderBrush}" />
                                <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource LogicWhileTextBrush}" />
                                <Setter TargetName="KindText" Property="Text" Value="尾" />
                                <Setter TargetName="KindBadge" Property="ToolTip" Value="收尾（End）" />
                            </DataTrigger>

                            <!--  选中：名称半粗（底色/左条在 ItemContainerStyle 里）  -->
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>

                            <!--  运行中：名称加粗 + 绿点  -->
                            <DataTrigger Binding="{Binding RunState}" Value="Running">
                                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="RunDot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="RunDot" Property="ToolTip" Value="运行中" />
                            </DataTrigger>
                            <!--  已暂停：点转主色  -->
                            <DataTrigger Binding="{Binding RunState}" Value="Paused">
                                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="RunDot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="RunDot" Property="Fill" Value="{StaticResource DialogAccentBrush}" />
                                <Setter TargetName="RunDot" Property="ToolTip" Value="已暂停" />
                            </DataTrigger>

                            <!--  禁用：整枚 55% + 删除线；运行标记强制隐藏（禁用流程不可能在跑）  -->
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter TargetName="PillRoot" Property="Opacity" Value="0.55" />
                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource ScadaDisabledTextBrush}" />
                                <Setter TargetName="RunDot" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                禁用提示条：只在选中一条禁用流程时出现。
                文案必须与代码行为一致——FlowListViewModel.cs:278-282 对禁用流程是**直接拦截**
                （"已禁用，请先启用再运行"），所以不能写"手动运行仍可用"。
            -->
            <Border
                Grid.Row="1"
                Margin="6,4,6,0"
                Padding="6,2"
                Background="{StaticResource DialogDangerSubtleBrush}"
                BorderBrush="{StaticResource DialogDangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                ToolTip="已禁用：不参与自动触发，右键「启用」后才能运行">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectFlow.IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    FontSize="10"
                    Foreground="{StaticResource DialogDangerTextBrush}"
                    Text="⚠ 已禁用：右键「启用」后才能运行"
                    TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <!--  底栏：流程条数 + 全部入口 + 当前选中（22px：与胶囊 24px 一起凑出 112/224 的高度账）  -->
        <Border
            Grid.Row="1"
            Height="22"
            Padding="8,0"
            Background="{StaticResource DialogRowAlternateBrush}"
            BorderBrush="{StaticResource DialogBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource ScadaTextBrush}"
                        Text="{Binding Workspace.CurrentSolution.Flows.Count}" />
                    <TextBlock
                        Margin="3,0,0,0"
                        FontSize="10.5"
                        Foreground="{StaticResource DialogTextTertiaryBrush}"
                        Text="条流程" />
                    <Button
                        Height="18"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding FlowCommand}"
                        CommandParameter="{x:Static enums:FlowAction.Manager}"
                        Content="全部 ›"
                        Style="{StaticResource FlowFootLink}"
                        ToolTip="打开流程管理" />
                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="10.5"
                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                    Text="{Binding SelectFlow.FlowName, StringFormat=选中：{0}}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
