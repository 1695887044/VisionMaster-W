<UserControl
    x:Class="VisionMaster.Views.ScadaAlarmHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="640"
    HorizontalAlignment="Right"
    Visibility="Collapsed"
    mc:Ignorable="d">

    <!--  ============================================================  -->
    <!--  报警历史抽屉（S11-c3）  -->
    <!--  运行窗口右侧拉出的一块面板：把本次运行的报警流水摆成能搜、能筛、能确认、能导出的表。  -->
    <!--  -->
    <!--  为什么是「覆盖层」而不是窗口根 Grid 里的一列  -->
    <!--  加一列会让画布跟着变窄 → 画布的 SizeChanged 触发 FitToScreen → 整个画面重新缩放。  -->
    <!--  操作员打开报警历史时画面「跳一下」，是比面板本身更糟的体验。覆盖层不参与画布的测量，  -->
    <!--  画面纹丝不动，面板收起来时也不留任何痕迹。  -->
    <!--  -->
    <!--  为什么不给抽屉加投影（DropShadowEffect）  -->
    <!--  投影会让整个子树（含两千行的虚拟化列表）走一遍离屏渲染，滚动时掉帧。  -->
    <!--  靠 1px 左边线 + 与画布底色的色差把层次说清楚就够了，代价是零。  -->
    <!--  -->
    <!--  DataContext 由代码后置在构造期设为 ScadaAlarmHistoryViewModel（见 .xaml.cs）：  -->
    <!--  这里不写 prism:ViewModelLocator.AutoWireViewModel——本面板的视图模型要注入  -->
    <!--  「二次确认」这个口，而自动装配只能调无参构造。  -->
    <!--  ============================================================  -->

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1B1F24" />
        <SolidColorBrush x:Key="PanelBarBrush" Color="#FF22262C" />
        <SolidColorBrush x:Key="PanelLineBrush" Color="#FF33383F" />
        <SolidColorBrush x:Key="PanelTextBrush" Color="#FFD6DAE0" />
        <SolidColorBrush x:Key="PanelMutedBrush" Color="#FF8A929E" />

        <!--  行内「确认」按钮的显隐转换器：CanAcknowledge 为假时按钮整块收起  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  行容器：整行可点，选中态与悬停态都只动背景，不动布局  -->
        <Style x:Key="AlarmRowStyle" TargetType="ListViewItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="RowBorder"
                            Padding="4,3"
                            Background="Transparent"
                            BorderBrush="#FF272C33"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                            <!--  ★ 必须是 GridViewRowPresenter ★
                                  七列的摆位全靠它按 Columns 排；换成裸 ContentPresenter
                                  列布局整体丢失，ListView 会退化成一行行的类型全名。  -->
                            <GridViewRowPresenter
                                Columns="{TemplateBinding GridView.ColumnCollection}"
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                SnapsToDevicePixels="True"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FF252A31" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#FF2A3442" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#FF3E5A7A" />
                            </Trigger>
                            <!--  已确认的整行淡化：一眼扫过去，剩下的深色行就是「还没人管」的那些  -->
                            <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  列头：自写模板而不是改默认样式。
              默认 Aero2 模板自带「悬停变浅灰」的触发器和一根列宽拖拽手柄，
              在深色面板上悬停会闪出一块浅色，而本表列宽是按面板宽度算死的，
              本来也不需要让用户拖。自写之后两点一起解决，还省掉一次主题依赖。  -->
        <Style x:Key="AlarmHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PanelMutedBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{StaticResource PanelBarBrush}"
                            BorderBrush="{StaticResource PanelLineBrush}"
                            BorderThickness="0,0,0,1"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  单元格正文：统一「放不下就省略号 + 悬停看全值」。
              列宽是死的、报警名与条件是活的，硬裁之后屏幕上没人看得出少了字。  -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  时间与时长用等宽字体：一列数字对齐之后，扫「哪个时段报得多」才成立  -->
        <Style x:Key="MonoCellText" BasedOn="{StaticResource CellText}" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!--  行内的「确认」小按钮：只在这一行还能确认时出现（见下面的 DataTrigger）  -->
        <Style x:Key="AckButton" TargetType="Button">
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF2B6CB0" />
            <Setter Property="BorderBrush" Value="#FF3E86D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A82CB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1F558F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  底部按钮（全部确认 / 导出 CSV）：中性灰块，与行内的蓝色「确认」区分开——
              一个是「处理这一条」，一个是「处理一整批」，长得一样会点错。  -->
        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
            <Setter Property="Background" Value="#FF2A2F36" />
            <Setter Property="BorderBrush" Value="#FF3A4048" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF323841" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF23282E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  筛选项做成一排「筹码」而不是两个下拉框：
              一次点击就能切档（下拉要点两下），而且当前档位一直亮着——
              筛选是「我筛过了」这件事本身，藏进下拉里最容易忘。  -->
        <Style x:Key="FilterChip" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource PanelMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Chip"
                            Padding="{TemplateBinding Padding}"
                            Background="#FF23282E"
                            BorderBrush="#FF3A4048"
                            BorderThickness="1"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#FF2C323A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#FF2B4C7E" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#FF4A8FE0" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  筹码条：ListBox 天生就是单选互斥，比一排 RadioButton 再自己接命令干净  -->
        <Style x:Key="FilterStrip" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FilterChip}" />
            <Setter Property="DisplayMemberPath" Value="Text" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <!--  WrapPanel 而不是 StackPanel：筹码宽度跟着字号/语言变，
                              放不下时换行，不会把最后一个档位顶出面板外  -->
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  搜索框外框：WPF 原生 TextBox 无圆角无边框色，包一层 Border 才像输入框  -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PanelTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Border
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource PanelLineBrush}"
        BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ====================  标题栏  ====================  -->
            <Border
                Grid.Row="0"
                Height="38"
                Background="{StaticResource PanelBarBrush}"
                BorderBrush="{StaticResource PanelLineBrush}"
                BorderThickness="0,0,0,1">
                <Grid Margin="12,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PanelTextBrush}"
                        Text="报警历史" />
                    <TextBlock
                        Margin="8,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PanelMutedBrush}"
                        Text="本次运行" />

                    <Button
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCloseClick"
                        Content="×"
                        Cursor="Hand"
                        FontSize="16"
                        Foreground="{StaticResource PanelMutedBrush}"
                        ToolTip="收起面板（报警照常记录，不受影响）" />
                </Grid>
            </Border>

            <!--  ====================  筛选区  ====================  -->
            <Grid Grid.Row="1" Margin="12,10,12,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  关键字：一次搜四样（报警名 / 报警文本 / 变量名 / 条件描述），见 ScadaAlarmHistoryRow.Matches  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Height="28"
                        Background="#FF16191D"
                        BorderBrush="#FF3A4048"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <TextBox Style="{StaticResource SearchBox}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                            <!--  占位提示：只在没输入时显示（WPF 原生 TextBox 无 Placeholder）  -->
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FF5A626D"
                                IsHitTestVisible="False"
                                Text="搜索 报警名 / 报警文本 / 变量名 / 条件">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Keyword}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource FooterButton}"
                        Command="{Binding ResetFilterCommand}"
                        Content="重置"
                        ToolTip="清空关键字，状态与级别都回到「全部」" />
                </Grid>

                <ListBox
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Style="{StaticResource FilterStrip}"
                    ItemsSource="{Binding StateFilters}"
                    SelectedItem="{Binding StateFilter}"
                    ToolTip="按状态筛：未确认 = 报警中或已恢复但还没人确认过" />

                <ListBox
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Style="{StaticResource FilterStrip}"
                    ItemsSource="{Binding SeverityFilters}"
                    SelectedItem="{Binding SeverityFilter}"
                    ToolTip="按严重度筛" />
            </Grid>

            <!--  ====================  表格  ====================  -->
            <!--  列宽预算（面板总宽 640）：
                    640 − 1（左边线）− 17（竖滚动条）= 622 的行区；
                    行两侧还要让出 4×2（行容器内距）+ 7×6（GridViewRowPresenter 给每个
                    单元格内置的 6px）= 50，真正能摆列的只剩 572。
                    六列定宽之和取 456，「详情」列吃掉剩下的约 116。
                    超宽的后果不是「多出横向滚动条」（已关），而是最后一列被硬裁。  -->
            <Border
                Grid.Row="2"
                Margin="12,0,12,0"
                Background="#FF16191D"
                BorderBrush="#FF33383F"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <ListView
                        BorderThickness="0"
                        Background="Transparent"
                        ItemContainerStyle="{StaticResource AlarmRowStyle}"
                        ItemsSource="{Binding Rows}"
                        SelectedItem="{Binding SelectedRow}"
                        SelectionMode="Single"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource AlarmHeaderStyle}">
                                <GridViewColumn Header="激活时间" Width="96">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource MonoCellText}"
                                                Text="{Binding TimeText}"
                                                ToolTip="{Binding FullTimeText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="级别" Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  色条 + 同色文字：色条给「一眼扫」，文字给「确定是哪个级别」。
                                                  只给色条的话，红绿色觉差异的人就丢了这一列信息。  -->
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="3"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding SeverityBrush}"
                                                    CornerRadius="1.5" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{Binding SeverityBrush}"
                                                    Text="{Binding SeverityText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="报警名称" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  悬停给报警文本：名字列窄，而「到底怎么了」那句话（如
                                                  「温度超过 80℃ 持续 5 秒」）正是操作员要看的下一句  -->
                                            <TextBlock
                                                Style="{StaticResource CellText}"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                ToolTip="{Binding Message}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="条件 / 触发值" Width="116">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource CellText}"
                                                Foreground="{StaticResource PanelMutedBrush}"
                                                Text="{Binding Detail}"
                                                ToolTip="{Binding Detail}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="状态" Width="78">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  还没确认的加粗提亮：这是整张表里唯一「需要人动手」的状态  -->
                                            <TextBlock Text="{Binding StateText}">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource CellText}" TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PanelMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanAcknowledge}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="持续" Width="56">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Style="{StaticResource MonoCellText}"
                                                Foreground="{StaticResource PanelMutedBrush}"
                                                Text="{Binding DurationText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  确认按钮只在这一行还能确认时出现。
                                                  已确认、已清除的行不给按钮：点了没反应比没有按钮更让人怀疑软件。  -->
                                            <Button
                                                Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="确认"
                                                Style="{StaticResource AckButton}"
                                                ToolTip="确认这条报警（已确认的报警会从「未确认」里消失）"
                                                Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisibility}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!--  空态：没有记录 / 筛不出结果，两种原因分开说清楚  -->
                    <TextBlock
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FF6B7280"
                        Text="{Binding EmptyHint}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRows}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!--  ====================  提示语（导出结果 / 确认反馈）  ====================  -->
            <!--  空串时整行收起，不留一条空白占位  -->
            <TextBlock
                Grid.Row="3"
                Margin="12,6,12,0"
                FontSize="11"
                Foreground="#FF7FB2E5"
                Text="{Binding NoticeText}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoticeText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  ====================  底部条：计数 + 批量动作  ====================  -->
            <Border
                Grid.Row="4"
                Margin="0,10,0,0"
                Height="40"
                Background="{StaticResource PanelBarBrush}"
                BorderBrush="{StaticResource PanelLineBrush}"
                BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource PanelMutedBrush}"
                        Text="{Binding SummaryText}" />

                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  按钮的可用性由命令自己判（当前列表里一条待确认的都没有时自动置灰），
                              这里不再写一遍 IsEnabled 绑定——两处判定迟早会不一致  -->
                        <Button
                            Margin="0,0,8,0"
                            Style="{StaticResource FooterButton}"
                            Command="{Binding AcknowledgeAllCommand}"
                            Content="全部确认"
                            ToolTip="确认当前列表里所有待确认的报警（会先问一句）" />
                        <Button
                            Style="{StaticResource FooterButton}"
                            Click="OnExportClick"
                            Content="导出 CSV"
                            ToolTip="把当前列表（已筛选的那些）导出成 CSV，编码带 BOM，Excel 直接打开不乱码" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
