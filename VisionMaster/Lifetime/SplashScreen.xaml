<Window
    x:Class="VisionMaster.Lifetime.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowsTransparency="False"
    Background="#1E1E1E"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Height="360"
    Width="520">
    <Border BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题区  -->
            <StackPanel
                Grid.Row="0"
                Margin="28,26,28,10">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Text="VisionMaster" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#888888"
                    Text="机器视觉流程平台 · 正在启动" />
            </StackPanel>

            <!--  自检项列表  -->
            <ItemsControl
                x:Name="CheckList"
                Grid.Row="1"
                Margin="28,10,28,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel
                            Margin="0,6"
                            Orientation="Horizontal">
                            <TextBlock
                                Width="26"
                                FontSize="13"
                                Foreground="{Binding MarkBrush}"
                                Text="{Binding Mark}" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#CCCCCC"
                                Text="{Binding Name}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                FontSize="12"
                                Foreground="#888888"
                                Text="{Binding Detail}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  进度条  -->
            <ProgressBar
                x:Name="Progress"
                Grid.Row="2"
                Height="4"
                Margin="28,4,28,14"
                Background="#333333"
                BorderThickness="0"
                Foreground="#4C9AFF"
                Maximum="1" />

            <!--  结果区  -->
            <TextBlock
                x:Name="ResultText"
                Grid.Row="3"
                Margin="28,0,28,8"
                FontSize="12"
                Foreground="#FFB900"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!--  底部状态  -->
            <TextBlock
                x:Name="StatusText"
                Grid.Row="4"
                Margin="28,0,28,20"
                FontSize="12"
                Foreground="#666666"
                Text="正在初始化…" />
        </Grid>
    </Border>
</Window>
