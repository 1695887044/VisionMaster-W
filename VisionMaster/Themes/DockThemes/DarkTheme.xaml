<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:keys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013">

    <!--
    ============================================================================
    DarkTheme（预留）：VS2013Dark 模板 + 深色调色板。
    与 FluentLight 同架构：合并 VS2013Dark 基础字典后覆盖画刷键。
    启用方式（Shell.xaml.cs）：替换 DictionaryTheme 的 Source 为本文件即可。
    ============================================================================
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/AvalonDock.Themes.VS2013;component/DarkTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  画布/面板基础面  -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.Background}" Color="#1E1E22" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.TabBackground}" Color="#1E1E22" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.PanelBorderBrush}" Color="#3A3A42" />

    <!--  强调色  -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ControlAccentColorKey}" Color="#4CC2FF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ControlAccentBrushKey}" Color="#4CC2FF" />

    <!--  中央文档区  -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabSelectedActiveBackground}" Color="#2A2A32" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabSelectedActiveText}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabUnselectedBackground}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabUnselectedText}" Color="#9A9AA5" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}" Color="#33333C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.DocumentWellTabUnselectedHoveredText}" Color="#F2F2F2" />

    <!--  工具窗口  -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabSelectedActiveBackground}" Color="#2A2A32" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabSelectedActiveText}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabUnselectedBackground}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabUnselectedText}" Color="#9A9AA5" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabUnselectedHoveredBackground}" Color="#33333C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowTabUnselectedHoveredText}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionActiveBackground}" Color="#26262C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionActiveText}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionInactiveBackground}" Color="#222228" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.ToolWindowCaptionInactiveText}" Color="#9A9AA5" />

    <!--  浮动窗口  -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.FloatingDocumentWindowBackground}" Color="#26262C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.FloatingDocumentWindowBorder}" Color="#4A4A55" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.FloatingToolWindowBackground}" Color="#26262C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.FloatingToolWindowBorder}" Color="#4A4A55" />

    <!--  自动隐藏标签  -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabDefaultBackground}" Color="#26262C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabDefaultBorder}" Color="#3A3A42" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabDefaultText}" Color="#9A9AA5" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabHoveredBackground}" Color="#2A2A32" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabHoveredBorder}" Color="#4CC2FF" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.AutoHideTabHoveredText}" Color="#4CC2FF" />

    <!--  Ctrl+Tab 导航  -->
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.NavigatorWindowBackground}" Color="#26262C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.NavigatorWindowForeground}" Color="#F2F2F2" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.NavigatorWindowSelectedBackground}" Color="#33333C" />
    <SolidColorBrush x:Key="{x:Static keys:ResourceKeys.NavigatorWindowSelectedText}" Color="#4CC2FF" />
</ResourceDictionary>
