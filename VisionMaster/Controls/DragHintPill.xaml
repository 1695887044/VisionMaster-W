<UserControl
    x:Class="VisionMaster.Controls.DragHintPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    IsHitTestVisible="False">

    <!--  ==========================================  -->
    <!--  拖拽落点提示条（设计基线 docs/UI设计基线/drag-drop-hint v2 §03/§05）  -->
    <!--  26 高 / 圆角 8 / 水平内边距 9 / 图标 11 + 间距 6 / 文字 11.5 Medium。  -->
    <!--  四档状态只换配色与图标，文案由放置端拼好整句（设计稿 §04 的公式）。  -->
    <!--  Hidden 时整条收起（Collapsed），不留空底色。  -->
    <!--  ==========================================  -->

    <UserControl.Resources>
        <!--  R173：图标字体在这里就地声明（换一个键名，不去引 App 级那份）。
              注意：本控件仍依赖 Colors.xaml 的 DragHint* 令牌，与 DragGhostCard 一样
              需要 Application 资源在位——离屏断言宿主不要直接 new 它（判据收在 DragHintPresenter 上）。  -->
        <FontFamily x:Key="DragHintIconFont">pack://application:,,,/UI;component/Asserts/FontFamilys/Font Awesome 6 Pro-Solid-900.otf#Font Awesome 6 Pro Solid</FontFamily>
    </UserControl.Resources>

    <Border
        x:Name="Shell"
        Height="26"
        Padding="9,0"
        VerticalAlignment="Center"
        CornerRadius="8">
        <Border.Effect>
            <!--  设计稿是双层阴影；WPF 每个元素只有一个 Effect，按 v2 卡片的同一约定用单层近似  -->
            <DropShadowEffect
                BlurRadius="16"
                Direction="270"
                Opacity="0.14"
                ShadowDepth="4"
                Color="{StaticResource DialogShadowColor}" />
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource DragHintValidBackgroundBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Hidden">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Caution">
                        <Setter Property="Background" Value="{StaticResource DragHintCautionBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Illegal">
                        <Setter Property="Background" Value="{StaticResource DragHintIllegalBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Locked">
                        <Setter Property="Background" Value="{StaticResource DragHintLockedBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <!--  图标 11px：字形随档位切换（箭头 / 三角感叹 / 圆叉 / 锁）  -->
            <TextBlock
                x:Name="Glyph"
                VerticalAlignment="Center"
                FontFamily="{StaticResource DragHintIconFont}"
                FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="&#xf061;" />
                        <Setter Property="Foreground" Value="{StaticResource DragHintValidIconBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Caution">
                                <Setter Property="Text" Value="&#xf071;" />
                                <Setter Property="Foreground" Value="{StaticResource DragHintCautionIconBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Illegal">
                                <Setter Property="Text" Value="&#xf057;" />
                                <Setter Property="Foreground" Value="{StaticResource DragHintIllegalIconBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Locked">
                                <Setter Property="Text" Value="&#xf023;" />
                                <Setter Property="Foreground" Value="{StaticResource DragHintLockedIconBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--  文案：11.5 Medium，单行省略。最大宽 300 = 340(总上限) − 18(内边距) − 11(图标) − 6(间距) − 5(余量)  -->
            <TextBlock
                MaxWidth="300"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                FontSize="11.5"
                FontWeight="Medium"
                Text="{Binding Text, ElementName=Root}"
                TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource DragHintValidTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Caution">
                                <Setter Property="Foreground" Value="{StaticResource DragHintCautionTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Illegal">
                                <Setter Property="Foreground" Value="{StaticResource DragHintIllegalTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Locked">
                                <Setter Property="Foreground" Value="{StaticResource DragHintLockedTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
