<UserControl
    x:Class="VisionMaster.Controls.DragGhostCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:VisionMaster.Helpers"
    x:Name="Root"
    IsHitTestVisible="False">

    <!--  ==========================================  -->
    <!--  拖拽浮层卡片（设计基线 docs/UI设计基线/toolbox-drag-ghost/ v2）  -->
    <!--  三处共用：工具箱拖拽源 / 流程栏内部拖动 / 画布节点拖动。  -->
    <!--  只用依赖属性（Icon / Title / Category）取数，不假设 DataContext 是哪种模型，  -->
    <!--  这样 ToolItemModel、StepModel、StepCollection 都能挂。  -->
    <!--  视觉规格与 design.html §05 一一对应：46 高 / 168~268 宽 / 圆角 12 / 发丝边 / 单层阴影近似。  -->
    <!--  ==========================================  -->

    <UserControl.Resources>
        <!--  R173：转换器必须排在所有模板/资源引用之前，模板延迟物化时按字典已有条目解析  -->
        <helpers:CategoryAccentBrushConverter x:Key="CategoryAccentBrushConverter" />
        <helpers:CategoryBorderBrushConverter x:Key="CategoryBorderBrushConverter" />
        <helpers:CategoryChipBrushConverter x:Key="CategoryChipBrushConverter" />
    </UserControl.Resources>

    <Border
        Height="46"
        MinWidth="168"
        MaxWidth="268"
        Padding="8,0,16,0"
        Background="{StaticResource ScadaSurfaceBrush}"
        BorderBrush="{StaticResource DialogBorderLightBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Opacity="0.98">
        <Border.Effect>
            <!--  设计稿是双层阴影（近景 2px + 远景 14px 30px）；WPF 每个元素只有一个 Effect，
                  这里按设计基线 §07 的约定用单层近似  -->
            <DropShadowEffect
                BlurRadius="28"
                Direction="270"
                Opacity="0.16"
                ShadowDepth="8"
                Color="{StaticResource DialogShadowColor}" />
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <!--  图标块 28×28 / 圆角 9：分类色 18%→7% 渐变底 + 分类色 30% 描边 + 分类色字形  -->
            <Grid
                Width="28"
                Height="28"
                VerticalAlignment="Center">
                <Border
                    Background="{Binding Category, ElementName=Root, Converter={StaticResource CategoryChipBrushConverter}}"
                    BorderBrush="{Binding Category, ElementName=Root, Converter={StaticResource CategoryBorderBrushConverter}}"
                    BorderThickness="1"
                    CornerRadius="9" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    FontSize="14"
                    Foreground="{Binding Category, ElementName=Root, Converter={StaticResource CategoryAccentBrushConverter}}"
                    Text="{Binding Icon, ElementName=Root}" />
            </Grid>

            <!--  两行：名称 13 SemiBold + 分类 10；各自限宽 165 省略（设计稿 §05）  -->
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    MaxWidth="165"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource DialogTextPrimaryBrush}"
                    Text="{Binding Title, ElementName=Root}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    MaxWidth="165"
                    Margin="0,1,0,0"
                    FontSize="10"
                    Foreground="{StaticResource DialogTextTertiaryBrush}"
                    Text="{Binding Category, ElementName=Root}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <!--  分类为空（未知/分支卡片未填/老图纸没带 Category）时收起第二行，
                                      标题自然垂直居中  -->
                                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
