<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cs="clr-namespace:Core.Halcon.Controls">
    <Style TargetType="cs:LabeledContentControl">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="#F5F7FA" />
        <Setter Property="BorderBrush" Value="#E1E4E8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Arial" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="cs:LabeledContentControl">
                    <Border
                        Margin="2"
                        Padding="12,8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="3"
                                Opacity="0.08"
                                RenderingBias="Quality"
                                ShadowDepth="1"
                                Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,16,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#1F2937"
                                Text="{TemplateBinding LeftText}" />
                            <ContentPresenter
                                Grid.Column="1"
                                Margin="4,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="16"
                                Foreground="#6B7280"
                                Text="{TemplateBinding RightText}"
                                ToolTip="{TemplateBinding RightText}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EBF5FF" />
                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#F9FAFB" />
                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>