<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cs="clr-namespace:Core.Halcon.Controls">

    <!--
        画布（图像列表）默认模板 —— 与 HALCON 的用法一致，刻意保持"零装饰"：

            第一栏 = 当前图（大图，复用 HALCON 窗口；对比模式下右侧并排第二张）
            第二栏 = 可拖的分隔条
            第三栏 = 缩略图条（**单行横向滚动**，一列一张；只显示图片，标题/注入信息/来源全部走悬停提示）

        没有工具条：清空 / 导出这些动作走画布空白处的右键菜单（见 ImageGallery.EnsureContextMenu）。

        配色刻意用中性灰阶（与 Core.Halcon 其它主题一致），本库不引用上层 UI 组件库，
        所以不消费 Fluent 令牌；宿主若需换肤，在应用层覆盖同一 TargetType 的隐式样式即可。
    -->

    <Style x:Key="GalleryThumbCardStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="Bd"
                        BorderBrush="Transparent"
                        BorderThickness="2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#A8C7E8" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0067C0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type cs:ImageGallery}">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cs:ImageGallery}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="#E5E5E5"
                        BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="Auto" />
                                <!--  单行缩略图条：只留"一张缩略图 + 横向滚动条"的高度，不给竖向留空带  -->
                                <RowDefinition Height="112" MinHeight="72" />
                            </Grid.RowDefinitions>

                            <!--  ============ 第一栏：当前图（对比模式下并排两张） ============  -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <!--
                                        对比列默认宽度 0：星号列即使内容折叠也照样分走一半宽度
                                        （表现就是"黑图只占半屏、右边一片空白"），所以只有对比模式才由触发器把它切成 *。
                                    -->
                                    <ColumnDefinition x:Name="CompareColumn" Width="0" MinWidth="0" />
                                </Grid.ColumnDefinitions>

                                <cs:ImageDisplay
                                    x:Name="PART_Big"
                                    Grid.Column="0"
                                    Annotations="{Binding SelectedFrame.Annotations, RelativeSource={RelativeSource TemplatedParent}}"
                                    HImage="{Binding SelectedFrame.Image, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="滚轮缩放 · 右键菜单可适应/保存原图 · 双击缩略图按原始像素显示" />

                                <!--  一张图都没有时的提示：说明"为什么空"以及去哪儿改开关  -->
                                <TextBlock
                                    x:Name="PART_Empty"
                                    Grid.Column="0"
                                    MaxWidth="460"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#9A9A9A"
                                    IsHitTestVisible="False"
                                    Text="{TemplateBinding HintText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FilteredFrames.Count, RelativeSource={RelativeSource AncestorType={x:Type cs:ImageGallery}}}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!--  对比大图（对比模式才显示）  -->
                                <GridSplitter
                                    x:Name="PART_CompareSplitter"
                                    Grid.Column="1"
                                    Width="4"
                                    HorizontalAlignment="Stretch"
                                    Background="#F0F1F3"
                                    ResizeBehavior="PreviousAndNext"
                                    ResizeDirection="Columns"
                                    Visibility="Collapsed" />

                                <cs:ImageDisplay
                                    x:Name="PART_Big2"
                                    Grid.Column="2"
                                    Annotations="{Binding PinnedFrame.Annotations, RelativeSource={RelativeSource TemplatedParent}}"
                                    HImage="{Binding PinnedFrame.Image, RelativeSource={RelativeSource TemplatedParent}}"
                                    Tag="对比"
                                    ToolTip="对比基准（钉住的那张）"
                                    Visibility="Collapsed" />
                            </Grid>

                            <!--  ============ 第二栏：分隔条（拖动调整缩略图条高度） ============  -->
                            <GridSplitter
                                Grid.Row="1"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#F0F1F3"
                                ResizeBehavior="PreviousAndNext"
                                ResizeDirection="Rows"
                                ToolTip="拖动调整下方缩略图条的高度" />

                            <!--  ============ 第三栏：缩略图条（只显示图片，信息走悬停） ============  -->
                            <ListBox
                                x:Name="PART_List"
                                Grid.Row="2"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource GalleryThumbCardStyle}"
                                ItemsSource="{Binding FilteredFrames, RelativeSource={RelativeSource AncestorType={x:Type cs:ImageGallery}}}"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding SelectedFrame, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                SelectionMode="Extended"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!--  单行横向排：一列一张，图多了横向滚动（VirtualizingStackPanel 才带虚拟化，图多不掉帧）  -->
                                        <VirtualizingStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="108"
                                            Height="80"
                                            Background="#111111"
                                            BorderBrush="#D1D1D1"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True"
                                            ToolTip="{Binding ToolTipText}"
                                            ToolTipService.InitialShowDelay="250"
                                            ToolTipService.ShowDuration="60000">
                                            <!--  悬停显示：标题 / 插件注入信息 / 来源（流程·插件·时间·尺寸），
                                                  整串文本见 ImageFrame.ToolTipText——不要在这里放带 {Binding} 的元素，
                                                  ToolTip 内容游离在可视树外，拿不到 DataContext 会是空白  -->
                                            <Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="#9A9A9A"
                                                    Text="无预览" />
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCompareMode" Value="True">
                            <Setter TargetName="CompareColumn" Property="Width" Value="*" />
                            <Setter TargetName="PART_CompareSplitter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Big2" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
