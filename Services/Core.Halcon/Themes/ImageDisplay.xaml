<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cs="clr-namespace:Core.Halcon.Controls"
    xmlns:halcon="http://schemas.mvtec.com/halcondotnet">
    <Style TargetType="cs:ImageDisplay">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="cs:ImageDisplay">
                    <Grid Background="Black">
                        <TextBlock
                            x:Name="PART_TopText"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="1"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Red"
                            Text="{TemplateBinding TopText}" />
                        <halcon:HSmartWindowControlWPF x:Name="PART_Halcon" Panel.ZIndex="0" />
                        <TextBlock
                            x:Name="PART_BottomText"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="1"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="Gray"
                            Text="{TemplateBinding BottomText}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>