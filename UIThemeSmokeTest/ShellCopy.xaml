<Window
    
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:commands="clr-namespace:VisionMaster.Commands"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VisionMaster;assembly=VM.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:ui="http://schemas.UI.com/ui"
    xmlns:views="clr-namespace:VisionMaster.Views;assembly=VisionMaster"
    Title="VisionMaster"
    Width="1280"
    Height="920"
    
    
    Background="#FFFFFF"
    FontFamily="Microsoft YaHei"
    WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="36"
            CornerRadius="1"
            GlassFrameThickness="1"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!--  标题栏图标按钮（高频操作驻留）  -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            x:Name="Bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E9EDF4" />
                                <Setter Property="Foreground" Value="#1F1F1F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DCE6F5" />
                            </Trigger>
                            <!--  禁用态（Command.CanExecute=false 自动触发）：半透明置灰 + 取消手型，让互锁"看得见"  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  标题栏分隔线  -->
        <Style x:Key="TitleSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#E0E0E0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!--  活动栏开关（VS Code 式，左侧强调条指示）  -->
        <Style x:Key="ActivityToggle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#5A5A5A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!--  左侧强调指示条  -->
                            <Border
                                x:Name="Indicator"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="#0067C0"
                                CornerRadius="0,2,2,0"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1F1F1F" />
                                <Setter TargetName="Bd" Property="Background" Value="#F0F3F8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0067C0" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  活动栏动作按钮（打开对话框类）  -->
        <Style x:Key="ActivityAction" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Icon}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="#5A5A5A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1F1F1F" />
                                <Setter TargetName="Bd" Property="Background" Value="#F0F3F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  状态栏可点项（与 Shell.xaml 同结构；R44 结构副本）  -->
        <Style x:Key="StatusBarItemButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ScadaTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBarSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Fill" Value="{StaticResource DialogBorderBrush}" />
        </Style>

        <Style x:Key="PerfBarStyle" TargetType="ProgressBar">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="2">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Fill="{TemplateBinding Foreground}"
                                    RadiusX="2"
                                    RadiusY="2" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <!--  底部控制台抽屉条（与 Shell.xaml 同步；收起态 32px）  -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <ui:OverlayHost />

        <!--  ============ 单行标题栏（VS Code 式） ============  -->
        <Grid Background="#FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <!--  ☰ 菜单（完整菜单树折叠于此）  -->
                <Menu
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Icon}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem
                        Foreground="#444444"
                        Header="&#xf0c9;">
                        <MenuItem Header="文件(F)" FontFamily="Microsoft YaHei">
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Create}"
                                Header="新建方案(N)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf15b;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.BrowseList}"
                                Header="方案列表(L)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0ca;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Open}"
                                Header="打开方案(O)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf07c;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.Save}"
                                Header="保存方案(S)"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0c7;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SolutionCommand}"
                                CommandParameter="{x:Static local:SolutionAction.SaveAs}"
                                Header="另存为"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0c5;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="视图(V)">
                            <MenuItem
                                CommandParameter="Panel_ImageView"
                                Header="视觉图像"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf030;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                CommandParameter="Panel_ProcessView"
                                Header="流程导航"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0e8;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                CommandParameter="Panel_ToolView"
                                Header="工具箱"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf552;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                CommandParameter="Panel_LogView"
                                Header="控制台"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf15c;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                CommandParameter="Panel_FlowCanvasView"
                                Header="流程画布"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf5cb;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                CommandParameter="Panel_ScadaEditorView"
                                Header="组态画面"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf1fc;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                CommandParameter="Panel_ScadaToolboxView"
                                Header="图元工具箱"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf552;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                CommandParameter="Panel_ScadaPropertyView"
                                Header="属性"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf013;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                CommandParameter="Panel_ScadaLayerView"
                                Header="图层"
                                  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf5fd;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="画布(C)">
                            <!--
                                每一格都是**一张完整的画布**（上行当前图 + 下行走马灯），不是老式"一路图钉死一个窗口"：
                                格号 ↔ 插件的"显示窗口号"，第 N 格只收窗口号 N 的图，各自维护自己的列表。
                                想一屏看全所有窗口的输出，用最后那一项（不过滤）。
                            -->
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="1"
                                Header="单画面 1×1"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf065;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="2"
                                Header="双画面 1×2"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf009;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="3"
                                Header="主从 1+2 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="4"
                                Header="四宫格 2×2"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf009;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="5"
                                Header="多视口 2+3 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="6"
                                Header="六宫格 2×3"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="7"
                                Header="矩阵 3+4 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="8"
                                Header="矩阵 4+4 分屏"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="9"
                                Header="九宫格 3×3"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SwitchCanvasCommand}"
                                CommandParameter="gallery"
                                Header="图像列表（全部输出）"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf302;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="工具(T)">
                            <MenuItem Header="截屏"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf125;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Header="保存布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf00a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Header="加载布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf07b;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Header="恢复默认布局"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2d2;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <!--  R44 结构副本：调试面板入口（原件绑 OpenDebugPanelCommand，副本只保留结构）。  -->
                            <MenuItem Header="调试面板"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf188;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem Header="报表查询"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf200;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="系统(S)">
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                Header="用户登录"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf4fe;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UserManagement}"
                                Header="用户管理"
                                 >
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xf0c0;" FontFamily="{StaticResource Icon}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.OperationsLog}"
                                Header="操作记录"
                                 >
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xf1da;" FontFamily="{StaticResource Icon}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.GlobalVariables}"
                                Header="全局变量"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf121;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding Recipe.OpenManagerCommand}"
                                Header="配方管理"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf0ca;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.HardwareSettings}"
                                Header="硬件管理"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf2db;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.SystemSettings}"
                                Header="系统设置"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf1de;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.ReturnToZero}"
                                Header="回零"
                                 >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf015;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>

                        <MenuItem Header="帮助(H)" FontFamily="Microsoft YaHei">
                            <MenuItem Header="激活"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf084;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem Header="建议及反馈"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf4ad;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <MenuItem
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.Help}"
                                Header="帮助文档"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf02d;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                            <Separator />
                            <MenuItem Header="关于"  >
                            <MenuItem.Icon>
                                <TextBlock Text="&#xf05a;" FontFamily="{StaticResource Icon}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!--  文件操作  -->
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Create}"
                    Content="&#xf15b;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="新建方案" />
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Open}"
                    Content="&#xf07c;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="打开方案" />
                <Button
                    Command="{Binding SolutionCommand}"
                    CommandParameter="{x:Static local:SolutionAction.Save}"
                    Content="&#xf0c7;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="保存方案" />

                <Rectangle Style="{StaticResource TitleSeparator}" />

                <!--  运行控制  -->
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static local:ExecutionAction.Compile}"
                    Content="&#xf0e7;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="流程编译" />
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static local:ExecutionAction.RunOnce}"
                    Content="&#xf061;"
                    Foreground="#2DA44E"
                    Style="{StaticResource TitleButton}"
                    ToolTip="单次启动整线（勾了「随整线启动」的流程各起各的会话）" />
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static local:ExecutionAction.RunContinuous}"
                    Content="&#xf021;"
                    Foreground="#2DA44E"
                    Style="{StaticResource TitleButton}"
                    ToolTip="循环启动整线（一条出问题只停它自己）" />
                <Button
                    Command="{Binding ExecutionCommand}"
                    CommandParameter="{x:Static local:ExecutionAction.Stop}"
                    Content="&#xf28d;"
                    Foreground="#D1242F"
                    Style="{StaticResource TitleButton}"
                    ToolTip="停止" />

                <Rectangle Style="{StaticResource TitleSeparator}" />

                <!--  全局命令：原来挂在左侧活动栏底部，2026-10-15 上移到顶栏（与 Shell.xaml 同步）  -->
                <Button
                    Command="{Binding SystemCommand}"
                    CommandParameter="{x:Static local:SystemAction.GlobalVariables}"
                    Content="&#xf121;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="全局变量" />
                <Button
                    Command="{Binding SystemCommand}"
                    CommandParameter="{x:Static local:SystemAction.HardwareSettings}"
                    Content="&#xf2db;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="硬件管理" />
                <!--  配方入口：与 Shell.xaml 同步，落在顶栏全局命令区  -->
                <Button
                    Command="{Binding Recipe.OpenManagerCommand}"
                    Content="&#xf0ca;"
                    Style="{StaticResource TitleButton}"
                    ToolTip="{Binding Recipe.ChipToolTip}" />
            </StackPanel>

            <!--  居中：当前方案名  -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#5A5A5A"
                    Text="&#xf07b;">
                    <TextBlock.FontFamily>
                        <StaticResource ResourceKey="Icon" />
                    </TextBlock.FontFamily>
                </TextBlock>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#333333"
                    Text="{Binding Workspace.CurrentSolution.SolutionName, TargetNullValue='未加载方案', FallbackValue='未加载方案'}"
                    ToolTip="当前正在运行的视觉解决方案" />
            </StackPanel>

            <!--  窗口控制按钮  -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Height="36"
                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                    Content="M 0 5 L 10 5"
                    Style="{StaticResource WindowControlButton}" />
                <Button
                    x:Name="BtnMaximize"
                    Height="36"
                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                    Content="M 0 0 H 10 V 10 H 0 Z"
                    Style="{StaticResource WindowControlButton}" />
                <Button
                    Height="36"
                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                    Content="M 0 0 L 10 10 M 0 10 L 10 0"
                    Style="{StaticResource WindowControlButton}"
                    Tag="Close" />
            </StackPanel>
        </Grid>

        <!--  ============ 主体：活动栏 + 停靠区 ============  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  停靠区（FluentLight 主题在代码后台应用）  -->
            <avalonDock:DockingManager
                x:Name="dockManager"
                Grid.Column="0"
                AllowMixedOrientation="True"
                AutoWindowSizeWhenOpened="True"
                IsVirtualizingAnchorable="True"
                IsVirtualizingDocument="True">
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">

                        <!--  1. 左侧栏：流程导航（流程胶囊嵌在 ProcessView 顶部，不再有独立程序窗格）  -->
                        <!--  为什么上下堆叠而不是各占一列：程序列表只有几条流程、天然矮，流程栏是长树、天然高，  -->
                        <!--  并排两列会让"矮的那个"白占一整列高度。上下堆叠后两者共享同一列宽度，  -->
                        <!--  程序固定高度（够放几条流程 + 折叠按钮），流程栏吃掉剩余全部高度。  -->
                        <!--  为什么用两层 LayoutAnchorablePane 而不是同一个 pane 里放两个 anchorable：  -->
                        <!--  同一个 pane 里的多个 anchorable 是**标签页**（互斥显示，同一时刻只见一个），  -->
                        <!--  那是"二选一"；要"同时可见、上下分"必须拆成两个 pane 再套进竖向 LayoutPanel。  -->
                        <!--  宽度 340 / 最小 320（流程栏 v2）：组头要同时放"类型标签 + 实例名 + N 分支 · M 算子 + 状态图标"，
                              低于 320 右侧统计会把实例名挤到只剩两三个字。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="340" DockMinWidth="320">
                            <avalonDock:LayoutAnchorable
                                Title="流程导航"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ProcessView">
                                <views:ProcessView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                        <!--  2. 中央工作区：流程画布 / 视觉图像 / 组态画面（文档标签，可拆分/浮动）  -->
                        <!--  流程画布为什么从左侧栏搬到这里：它是节点编辑器的主工作区，面积需求与视觉图像同级，  -->
                        <!--  而原来跟流程栏挤在 17* 宽的同一列里做标签页——同一时刻只能看见一个，  -->
                        <!--  等于"要么看树、要么看画布"，两件事本来是要对照着做的。  -->
                        <!--  默认选中仍是「视觉图像」（IsSelected=True 在它身上）：画布是编辑入口，但启动视角  -->
                        <!--  先给实时图像，避免每次开软件都先看到一张空白画布。  -->
                        <avalonDock:LayoutPanel Orientation="Vertical" DockWidth="70*">
                            <avalonDock:LayoutDocumentPane>
                                <!--  IsSelected 是必要的：一个 pane 里有多个文档时，默认激活哪一个不保证是第一个，  -->
                                <!--  不写这一行就可能让"组态画面"抢走启动时的前台标签，改变现有用户的默认视角。  -->
                                <avalonDock:LayoutDocument
                                    Title="视觉图像"
                                    CanClose="False"
                                    ContentId="Panel_ImageView"
                                    IsSelected="True">
                                    <views:ImageView />
                                </avalonDock:LayoutDocument>
                                <!--  流程节点画布：与视觉图像同为中央文档区，可拖出成分屏对照着调  -->
                                <avalonDock:LayoutDocument
                                    Title="流程画布"
                                    CanClose="False"
                                    ContentId="Panel_FlowCanvasView">
                                    <views:FlowCanvasView />
                                </avalonDock:LayoutDocument>
                                <!--  组态画面编辑器：与视觉图像同为中央文档区，可拖出成分屏对照着调画面  -->
                                <avalonDock:LayoutDocument
                                    Title="组态画面"
                                    CanClose="False"
                                    ContentId="Panel_ScadaEditorView">
                                    <views:ScadaEditorView />
                                </avalonDock:LayoutDocument>
                                <avalonDock:LayoutDocument
                                    Title="运行驾驶舱"
                                    CanClose="False"
                                    ContentId="Panel_RunCockpitView">
                                    <views:RunCockpitView />
                                </avalonDock:LayoutDocument>
                            </avalonDock:LayoutDocumentPane>

                            <!--  3. 底部面板组：控制台（日志 / 监控栏）两个标签（与 Shell.xaml 同步）  -->
                            <avalonDock:LayoutAnchorablePane DockHeight="200">
                                <avalonDock:LayoutAnchorable
                                    Title="控制台"
                                    CanClose="False"
                                    CanHide="False"
                                    CanFloat="False"
                                    ContentId="Panel_LogView">
                                    <views:LogView />
                                </avalonDock:LayoutAnchorable>
                                <avalonDock:LayoutAnchorable
                                    Title="监控栏"
                                    CanClose="False"
                                    CanHide="False"
                                    CanFloat="False"
                                    ContentId="Panel_MonitorView">
                                    <views:MonitorView />
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutPanel>

                        <!--  4. 右侧单列检查器：属性 / 图层 / 工具箱 / 图元工具箱共用一列 300。  -->
                        <avalonDock:LayoutAnchorablePane DockWidth="300" DockMinWidth="300">
                            <avalonDock:LayoutAnchorable
                                Title="属性"
                                AutoHideWidth="300"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ScadaPropertyView">
                                <views:ScadaPropertyView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="图层"
                                AutoHideWidth="300"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ScadaLayerView">
                                <views:ScadaLayerView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="工具箱"
                                AutoHideWidth="300"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ToolView">
                                <views:ToolView />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable
                                Title="图元工具箱"
                                AutoHideWidth="300"
                                CanClose="False"
                                CanHide="True"
                                CanDockAsTabbedDocument="False"
                                CanFloat="False"
                                ContentId="Panel_ScadaToolboxView">
                                <views:ScadaToolboxView />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>

                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>
        </Grid>

        <!--  ============ 底部控制台抽屉条（收起态 32px） ============  -->
        <!--  与 Shell.xaml 同步；这里也实例化真视图，让断言宿主在解析期就能抓到它的 XAML 错误。
              DataContext 为空 → IsDrawerVisible 绑定不成立 → 默认 Collapsed，不影响测量。  -->
        <views:ConsoleDrawerBar Grid.Row="2" />

        <!--  ============ 状态栏（VS Code 式） ============  -->
        <Border
            Grid.Row="3"
            Background="#F5F7FA"
            BorderBrush="#E5E5E5"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  运行状态指示灯 + 文字（唯一事实来源：ShellViewModel.RunState）  -->
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        Fill="{Binding RunStateBrush}" />
                    <TextBlock
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{Binding RunStateBrush}"
                        Text="{Binding RunStateText}" />
                    <TextBlock
                        Margin="8,0"
                        FontSize="12"
                        Foreground="#C9CEDB"
                        Text="|" />
                    <!--  当前登录者胶囊（与 Shell.xaml 同结构）：头像圆 + 「角色 · 用户名」；
                          未登录灰头像 + 「未登录」；点一下开登录弹窗。  -->
                    <Border
                        x:Name="CurrentUserText"
                        Height="24"
                        Padding="8,0"
                        CornerRadius="6"
                        Cursor="Hand"
                        ToolTip="点击切换用户（也可走 系统 → 用户登录）">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding
                                Command="{Binding SystemCommand}"
                                CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                MouseAction="LeftClick" />
                        </Border.InputBindings>
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem
                                    Command="{Binding SystemCommand}"
                                    CommandParameter="{x:Static local:SystemAction.UserLogin}"
                                    Header="用户登录" />
                                <MenuItem
                                    Command="{Binding SystemCommand}"
                                    CommandParameter="{x:Static local:SystemAction.UserManagement}"
                                    Header="用户管理"
                                    Visibility="{Binding CanManageUsers, Converter={ui:BooleanToVisibilityConverter}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="16" Height="16" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource DialogRowHoverBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccessPolicy.IsLoggedIn}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DialogAccentSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Text="{Binding UserAvatarText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ScadaFaintTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AccessPolicy.IsLoggedIn}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding UserDisplayText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ScadaLabelTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AccessPolicy.IsLoggedIn}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DialogAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <!--
                        调试模式徽标（R44 结构副本）：原件按 IsDebugModeEnabled 绑定显隐；
                        副本没有真实 VM，固定折叠——否则绑定失败会回落 Visible，把状态栏量宽。
                    -->
                    <Border
                        Height="22"
                        Margin="6,0,0,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource ScadaWarningSoftBrush}"
                        BorderBrush="{StaticResource DialogWarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ToolTip="调试模式已开启（不会自动失效）"
                        Visibility="Collapsed">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{StaticResource DialogWarningTextBrush}"
                            Text="调试模式" />
                    </Border>
                    <TextBlock
                        Margin="8,0"
                        FontSize="12"
                        Foreground="#C9CEDB"
                        Text="|" />
                    <TextBlock FontSize="12" Text="方案" />
                    <TextBlock
                        x:Name="SolutionPathText"
                        MaxWidth="320"
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Text="{Binding Workspace.CurrentSolution.SolutionName, TargetNullValue='未加载', FallbackValue='未加载'}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Workspace.CurrentSolution.SolutionFilePath, TargetNullValue='未加载方案', FallbackValue='未加载方案'}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  系统资源（与 Shell.xaml 同结构）：常驻 CPU + MEM，其余进浮窗。
                          副本没有 code-behind，Click 由 R44 的结构闸豁免；浮窗本身照样能被解析。  -->
                    <Button
                        x:Name="PerfButton"
                        Style="{StaticResource StatusBarItemButton}"
                        ToolTip="系统资源（点击查看明细）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource ScadaFaintTextBrush}"
                                Text="CPU" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding CpuUsagePercent, StringFormat={}{0:F1}%}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource ScadaFaintTextBrush}"
                                Text="MEM" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding MemoryUsageMB, StringFormat={}{0:F0}}" />
                            <TextBlock
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource ScadaFaintTextBrush}"
                                Text="MB" />
                        </StackPanel>
                    </Button>

                    <Popup
                        x:Name="PerfPopup"
                        AllowsTransparency="True"
                        Focusable="False"
                        Placement="Top"
                        PlacementTarget="{Binding ElementName=PerfButton}"
                        PopupAnimation="Fade"
                        StaysOpen="False">
                        <Border
                            Width="268"
                            Margin="10"
                            Padding="8"
                            Background="{StaticResource DialogSurfaceBrush}"
                            BorderBrush="{StaticResource DialogBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel>
                                <TextBlock
                                    Margin="4,2,4,6"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource ScadaFaintTextBrush}"
                                    Text="系统资源 · 进程" />
                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="CPU" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Style="{StaticResource PerfBarStyle}"
                                        Value="{Binding CpuUsagePercent, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Width="62"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding CpuUsagePercent, StringFormat={}{0:F1} %}" />
                                </Grid>
                                <Grid Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="内存（Working Set）" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="1024"
                                        Style="{StaticResource PerfBarStyle}"
                                        Value="{Binding MemoryUsageMB, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Width="62"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding MemoryUsageMB, StringFormat={}{0:F0} MB}" />
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="线程" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding ThreadCount}" />
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="句柄" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding HandleCount, StringFormat={}{0:N0}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHandleCountHigh}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="GC 堆" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding GcHeapMB, StringFormat={}{0:F1} MB}" />
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="LOH" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding LohSizeMB, StringFormat={}{0:F1} MB}" />
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="磁盘剩余" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding DiskFreeText}"
                                        ToolTip="{Binding DiskFreeTip}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ScadaSecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDiskFreeLow}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DialogWarningTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Height="24">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="运行时长" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaSecondaryTextBrush}"
                                        Text="{Binding UptimeText}" />
                                </Grid>
                                <Border
                                    Margin="0,4,0,0"
                                    Padding="4,6,2,2"
                                    BorderBrush="{StaticResource DialogBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource ScadaFaintTextBrush}"
                                        Text="阈值：CPU ≥ 80%、内存 ≥ 1 GB、磁盘剩余 &lt; 5% 时数字变橙；句柄 ≥ 10 000 视为异常。"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Rectangle Style="{StaticResource StatusBarSeparator}" />
                    <TextBlock
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding CurrentTimeText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
